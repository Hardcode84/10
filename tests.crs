host_source(run, "crust/stages/build/load.crs");
if !application_setup(run, "crust") {
    return 1i32;
};
host_source(run, "tools/build/setup.crs");
var backend: ApplicationBackend = uninit;
var stages: *StageSession = project_open(run, &backend);
if stages == null(*StageSession) {
    return 1i32;
};
host_source(run, "tools/build/collision.crs");
if run -> argc > 0i32 && cache_strcmp(run -> argv[0usize], "collision") == 0i32 {
    return run_collision_checks(run, backend.emit);
};
if !project_render(run, stages, &backend) {
    return 1i32;
};

host_source(run, "tools/build/demo.crs");
host_source(run, "tools/build/game.crs");
host_source(run, "tools/build/tests.crs");
host_source(run, "tools/build/ownership-tests.crs");
host_source(run, "tools/build/test-runner.crs");
if run -> argc == 1i32 && cache_strcmp(run -> argv[0usize], "ownership") == 0i32 {
    return (!check_host_ownership(run)) as i32;
};
if run -> argc == 1i32 && cache_strcmp(run -> argv[0usize], "--help") == 0i32 {
    return test_help();
};
if !build_tests(run, backend.emit) {
    return 1i32;
};
return run_tests(run);
