extern fn benchmark_environment(name: *u8) -> *u8 = "getenv";
fn main(argc: i32, argv: **u8) -> i32 {
    var room: u32 = 0u32;
    var pose: u32 = 0u32;
    if argc < 3i32 || !game_number(argv[1usize], &room) || !game_number(argv[2usize], &pose) {
        return (
            !error(
                "use course-benchmark LEVEL ROOM POSE followed by game options; pose 0 uses the recipe spawn, poses 1..99 face a portal; poses 100+ view the centre from hull face (pose - 100)"
            )
        ) as i32;
    }
    var samples: u32 = 128u32;
    var first: i32 = 2i32;
    if argc > 3i32 && strcmp(argv[3usize], "--samples") == 0i32 {
        if argc < 5i32 || !game_number(argv[4usize], &samples) || samples == 0u32 || samples > 128u32 {
            error("benchmark samples must be between 1 and 128");
            return 2i32;
        }
        first = 4i32;
    }
    argv[first as usize] = argv[0usize];
    var options: Launch = uninit;
    if !game_options_scene(argc - first, argv + first as isize, &options, true) {
        return 2i32;
    }
    options.config.headless = true;
    return (
        !course_benchmark(game_session(&options), room, pose, options.config, samples)
    ) as i32;
}
fn course_benchmark(
    session: GameSession,
    room: u32,
    pose: u32,
    config: GameConfig,
    samples: u32
) -> bool {
    var scene: CollisionScene = collision_new();
    var loop: GameLoop = make GameLoop {
        sparks: sparks_new(),
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_run_setup(mut session, mut scene, mut loop, config) {
        return false;
    }
    if room >= graph_count(read session.control.graph) {
        return error("benchmark room is outside the level");
    }
    var node: GraphNode = graph_node(read session.control.graph, room);
    var asset: RoomAsset = room_asset_new();
    var values: AssetValues = asset_values_new();
    if !course_values(node.kind, node.style, mut values) || !course_build(
        node.kind,
        read values,
        mut asset
    ) {
        return false;
    }
    loop.trial.drone.world = room;
    loop.trial.drone.position = asset.spawn.position;
    loop.trial.drone.basis = asset.spawn.basis;
    if !course_camera(
        read scene,
        read session.control.graph,
        read asset.hull,
        mut loop.trial,
        node,
        pose
    ) {
        return false;
    }
    puts("rooms / portals / source triangles");
    print_number(graph_count(read session.control.graph) as i64);
    print_number(graph_ports(read session.control.graph) as i64);
    print_number(mesh_triangle_count(read session.room_mesh) as i64);
    if benchmark_environment("SPINWARD_GEOMETRY_ONLY") != null(*u8) {
        return course_geometry_benchmark(read scene, mut session, read loop, config, samples);
    }
    if !course_profile_open(read scene, mut session, read loop, config) {
        return false;
    }
    if !course_benchmark_frames(read scene, mut session, mut loop, config, samples) {
        return false;
    }
    session.renderer.state.read_pixels = true;
    (session.renderer.state.mapped as *u32)[26usize] = 1u32;
    var ignored: [u64; 3] = make [u64; 3] {
        0u64,
        0u64,
        0u64
    };
    if benchmark_environment("SPINWARD_TASKS") == null(*u8) && !course_benchmark_frame(
        read scene,
        mut session,
        read loop,
        config,
        &ignored[0usize],
        false
    ) {
        return false;
    }
    return course_work_report(&session.renderer.state) && game_finish(mut session);
}
fn course_work_report(v: *RenderState) -> bool {
    var words: *u32 = v -> mapped as *u32;
    if words[WORK_NODES as usize] == 0xffffffffu32 || words[WORK_TRIANGLES as usize] == 0xffffffffu32 || words[
        WORK_BATCHES as usize
    ] == 0xffffffffu32 || words[WORK_EMPTY_ACTIVE as usize] == 0xffffffffu32 || words[
        WORK_EMPTY_IDLE as usize
    ] == 0xffffffffu32 {
        return error("diagnostic work counts exceed the 32-bit reporting range");
    }
    puts("diagnostic hierarchy nodes / queued triangles / nonempty batches");
    print_number(words[WORK_NODES as usize] as i64);
    print_number(words[WORK_TRIANGLES as usize] as i64);
    print_number(words[WORK_BATCHES as usize] as i64);
    puts("empty active / empty idle planner rounds");
    print_number(words[WORK_EMPTY_ACTIVE as usize] as i64);
    print_number(words[WORK_EMPTY_IDLE as usize] as i64);
    puts("dynamic triangles");
    print_number(words[DYNAMIC_COUNT as usize] as i64);
    return true;
}
fn course_geometry_benchmark(
    scene: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    samples: u32
) -> bool {
    return game_render(read scene, mut session, read loop, config) && geometry_benchmark(
        &session.renderer.state,
        samples,
        session.control.launch.capture
    );
}
fn course_sample_insert(values: *u64, index: usize, value: u64) -> unit {
    var i: usize = index;
    while i != 0usize && values[i - 1usize] > value {
        values[i] = values[i - 1usize];
        i = i - 1usize;
    }
    values[i] = value;
}
fn course_benchmark_frames(
    scene: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    samples: u32
) -> bool {
    var graph: TaskGraph = task_graph_new();
    var pool: TaskPool = task_pool_new();
    if !game_frame_graph(mut graph) || !task_pool_open(mut pool, config.workers, 1u32) {
        return false;
    }
    var context: PredictionContext = prediction_context(read pool, read scene);
    if !prediction_context_ready(read context) {
        return false;
    }
    var prediction: Prediction = prediction_new();
    var cpu: [u64; 3] = make [u64; 3] {
        0u64,
        0u64,
        0u64
    };
    var stages: [u64; 4] = make [u64; 4] {
        0u64,
        0u64,
        0u64,
        0u64
    };
    var batch: [u64; 4] = make [u64; 4] {
        0u64,
        0u64,
        0u64,
        0u64
    };
    var elapsed: [u64; 128] = uninit;
    var gpu: [u64; 128] = uninit;
    var query: [u64; 64] = uninit;
    var v: *RenderState = &session.renderer.state;
    if v -> query_count > 64u32 {
        return error("benchmark timestamp capacity exceeded");
    }
    v -> read_pixels = false;
    var frame: u32 = 0u32;
    while frame < samples + 8u32 {
        var start: u64 = now();
        if benchmark_environment("SPINWARD_TASKS") != null(*u8) {
            if !course_task_frame(
                mut graph,
                mut context,
                read scene,
                mut session,
                mut loop,
                config,
                mut prediction
            ) {
                return false;
            }
        } else {
            if !course_benchmark_frame(
                read scene,
                mut session,
                read loop,
                config,
                &cpu[0usize],
                frame >= 8u32
            ) {
                return false;
            }
        }
        var duration: u64 = now() - start;
        if !queries_read(v, &query[0usize]) {
            return false;
        }
        if frame >= 8u32 {
            if !batch_profile_read(v, &batch[0usize]) {
                return false;
            }
            course_stage_times(v, &query[0usize], &stages[0usize]);
            course_sample_insert(&elapsed[0usize], (frame - 8u32) as usize, duration);
            var ticks: u64 = (
                (query[(v -> query_count - 2u32) as usize] - query[0usize]) & v -> timestamp_mask
            ) - course_query_gap(v, &query[0usize]);
            course_sample_insert(
                &gpu[0usize],
                (frame - 8u32) as usize,
                (ticks as f32 * v -> timestamp_period) as u64
            );
        }
        frame = frame + 1u32;
    }
    puts("CPU prediction / scene preparation / submission+GPU mean ns (serial/split only)");
    print_number((cpu[0usize] / samples as u64) as i64);
    print_number((cpu[1usize] / samples as u64) as i64);
    print_number((cpu[2usize] / samples as u64) as i64);
    puts("GPU setup / batch projection+raster+lighting / portal expansion / compose mean ns");
    var stage: usize = 0usize;
    while stage < 4usize {
        print_number((stages[stage] as f32 * v -> timestamp_period / samples as f32) as i64);
        stage = stage + 1usize;
    }
    batch_profile_report(v, &batch[0usize], samples);
    puts("measured samples");
    print_number(samples as i64);
    puts("frame ns p50 / p95 / p99 (no pixel readback, no presentation)");
    print_number(elapsed[((samples - 1u32) / 2u32) as usize] as i64);
    print_number(elapsed[((samples * 95u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
    print_number(elapsed[((samples * 99u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
    puts("GPU ns p50 / p95 / p99");
    print_number(gpu[((samples - 1u32) / 2u32) as usize] as i64);
    print_number(gpu[((samples * 95u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
    print_number(gpu[((samples * 99u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
    puts("warm mesh upload bytes / total upload bytes / device bytes / staging bytes");
    print_number(v -> mesh_upload_bytes as i64);
    print_number(v -> frame_upload_bytes as i64);
    print_number(v -> device_bytes as i64);
    print_number(v -> staging_bytes as i64);
    if benchmark_environment("SPINWARD_TASKS") != null(*u8) {
        session.renderer.state.read_pixels = true;
        (session.renderer.state.mapped as *u32)[26usize] = 1u32;
        return course_task_frame(
            mut graph,
            mut context,
            read scene,
            mut session,
            mut loop,
            config,
            mut prediction
        );
    }
    return true;
}

fn course_face_camera(hull: read AssetHull, drone: mut Drone, index: u32) -> bool {
    if index >= asset_face_count(read hull) {
        return error("benchmark hull face is outside the room");
    }
    var face: HullFace = asset_face(read hull, index);
    var center: Vec3 = vec(0f32, 0f32, 0f32);
    var i: u32 = 0u32;
    while i < face.count {
        center = add(
            center,
            asset_vertex(read hull, asset_index(read hull, face.first + i))
        );
        i = i + 1u32;
    }
    center = scale(center, 1f32 / face.count as f32);
    var inward: Basis = hull_radial_basis(scale(center, -1f32));
    drone.position = add(
        center,
        add(scale(inward.forward, 2f32), scale(inward.right, 2f32))
    );
    drone.basis = hull_radial_basis(scale(drone.position, -1f32));
    puts("camera eye xyz");
    print_number((drone.position.x * 1000f32) as i64);
    print_number((drone.position.y * 1000f32) as i64);
    print_number((drone.position.z * 1000f32) as i64);
    return true;
}

fn course_benchmark_frame(
    scene: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    times: *u64,
    measure: bool
) -> bool {
    if benchmark_environment("SPINWARD_OVERLAP") != null(*u8) {
        return course_overlap_frame(
            read scene,
            mut session,
            read loop,
            config,
            times,
            measure
        );
    }
    var a: u64 = now();
    var prediction: Prediction = predict_paths(read scene, read loop.trial);
    var b: u64 = now();
    game_prepare(read scene, mut session, read loop, config, read prediction);
    var c: u64 = now();
    var good: bool = game_draw(mut session) && game_present(mut session);
    var d: u64 = now();
    if measure {
        times[0usize] = times[0usize] + b - a;
        times[1usize] = times[1usize] + c - b;
        times[2usize] = times[2usize] + d - c;
    }
    return good;
}

fn course_camera(
    scene: read CollisionScene,
    graph: read RoomGraph,
    hull: read AssetHull,
    trial: mut Trial,
    node: GraphNode,
    pose: u32
) -> bool {
    if pose >= 100u32 {
        if !course_face_camera(read hull, mut trial.drone, pose - 100u32) {
            return false;
        }
    } else if pose != 0u32 {
        if pose > node.count {
            return error("benchmark portal pose is outside the room");
        }
        var port: RoomPort = graph_socket(read graph, node.first + pose - 1u32).port;
        trial.drone.position = sub(port.position, scale(port.basis.forward, 1f32));
        trial.drone.basis = port.basis;
    }
    if !game_collision_spawn(read scene, read trial) {
        return false;
    }
    return true;
}

fn course_stage_times(v: *RenderState, query: *u64, times: *u64) -> unit {
    times[0usize] = times[0usize] + (
        (query[1usize] - query[0usize]) & v -> timestamp_mask
    );
    var depth: u32 = 0u32;
    while depth <= v -> crossing_limit {
        var first: usize = (1u32 + depth * 2u32) as usize;
        times[1usize] = times[1usize] + (
            (query[first + 1usize] - query[first]) & v -> timestamp_mask
        );
        times[2usize] = times[2usize] + (
            (query[first + 2usize] - query[first + 1usize]) & v -> timestamp_mask
        );
        depth = depth + 1u32;
    }
    times[1usize] = times[1usize] - course_query_gap(v, query);
    times[3usize] = times[3usize] + (
        (
            query[(v -> query_count - 2u32) as usize] - query[(1u32 + depth * 2u32) as usize]
        ) & v -> timestamp_mask
    );
}

fn course_query_gap(v: *RenderState, query: *u64) -> u64 {
    return (
        query[(v -> query_count - 3u32) as usize] - query[(v -> query_count - 4u32) as usize]
    ) & v -> timestamp_mask;
}

fn course_overlap_frame(
    scene: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    times: *u64,
    measure: bool
) -> bool {
    var a: u64 = now();
    var range: DeferredGeometry = game_deferred_scene(
        read scene,
        mut session,
        read loop,
        config
    );
    var b: u64 = now();
    var setup: FrameSetup = frame_setup(mut session.renderer, range);
    if !frame_setup_accepted(read setup) {
        return false;
    }
    var c: u64 = now();
    var prediction: Prediction = predict_paths(read scene, read loop.trial);
    var d: u64 = now();
    {
        var edit: DeferredInput = frame_setup_edit(mut setup);
        draw_prediction(deferred_inputs(mut edit), read prediction, config);
    }
    var frame: SubmittedFrame = frame_setup_submit(mut setup);
    var status: i32 = frame_poll(mut frame);
    while status == 0i32 {
        frame_idle(mut frame);
        status = frame_poll(mut frame);
    }
    if measure {
        times[0usize] = times[0usize] + d - c;
        times[1usize] = times[1usize] + b - a;
        times[2usize] = times[2usize] + c - b + now() - d;
    }
    return status > 0i32;
}

fn course_profile_open(
    scene: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> bool {
    if benchmark_environment("SPINWARD_BATCH_PROFILE") != null(*u8) {
        if !game_render(read scene, mut session, read loop, config) {
            return false;
        }
        var deferred: u32 = 0u32;
        if benchmark_environment("SPINWARD_OVERLAP") != null(*u8) {
            var range: DeferredGeometry = game_deferred_scene(
                read scene,
                mut session,
                read loop,
                config
            );
            deferred = range.capacity;
            if !renderer_prepare(&session.renderer.state, deferred) {
                return false;
            }
        }
        if !batch_profile_open(&session.renderer.state, deferred) {
            return false;
        }
    }
    return true;
}

fn game_deferred_scene(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> DeferredGeometry {
    game_prepare_begin(read collision, mut session, read loop, config);
    var range: DeferredGeometry = game_defer_prediction(mut session);
    var empty: Prediction = prediction_new();
    game_prepare_finish(read collision, mut session, read loop, config, read empty);
    return range;
}
fn game_defer_prediction(session: mut GameSession) -> DeferredGeometry {
    var input: FrameInput = renderer_inputs(mut session.renderer);
    return input_defer(mut input, PREVIEW_MARKERS * 8u32);
}

fn course_task_frame(
    graph: mut TaskGraph,
    context: mut PredictionContext,
    scene: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    prediction: mut Prediction
) -> bool {
    task_graph_start(mut graph);
    if task_next(mut graph) != 1u32 {
        trap;
    }
    task_complete(mut graph, 1u32, true);
    if task_next(mut graph) != 2u32 {
        trap;
    }
    return game_root_frame(
        mut graph,
        mut context,
        read scene,
        mut session,
        mut loop,
        config,
        mut prediction
    );
}
