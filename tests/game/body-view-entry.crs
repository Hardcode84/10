fn main(argc: i32, argv: **u8) -> i32 {
    var launch: Launch = uninit;
    if !game_options(argc, argv, &launch) {
        return 1i32;
    }
    launch.config.width = 320u32;
    launch.config.height = 240u32;
    launch.capture = "build/test-body-portal.ppm";
    launch.shader_checks = true;
    var renderer: Renderer = renderer_new();
    renderer.state.tile_lists = true;
    var mesh: Mesh = mesh_new();
    var scene: CollisionScene = collision_new();
    if !player_drone_mesh(mut mesh, DRONE_RADIUS) || !body_portals(mut scene) || !game_renderer_open(
        &renderer.state,
        &launch,
        null(*u8),
        2u32
    ) {
        return 1i32;
    }
    var mode: u32 = 0u32;
    var lit: u32 = 0u32;
    var portal_pixels: u64 = 0u64;
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !body_overlap_check(read scene, mut input, read mesh) {
            error("body overlap lost its rotated same-room placement");
            return 1i32;
        }
    }
    while mode < 6u32 {
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            body_input(read scene, mut input, read mesh, mode);
        }
        if !renderer_draw(&renderer.state) || !body_image_check(
            &renderer.state,
            mode,
            &lit,
            &portal_pixels
        ) {
            return 1i32;
        }
        mode = mode + 1u32;
    }
    puts(
        "Body first-person visibility, rotated portal view, overlap placements and cast shadows passed."
    );
    return 0i32;
}
fn body_image_check(state: *RenderState, mode: u32, lit: *u32, portal_pixels: *u64) -> bool {
    var pixels: *u32 = state -> mapped as *u32;
    var changed: u32 = 0u32;
    var hash: u64 = 14695981039346656037u64;
    var i: u32 = 0u32;
    while i < 320u32 * 240u32 {
        hash = (hash ^ pixels[(PIXELS + i) as usize] as u64) * 1099511628211u64;
        if pixels[(PIXELS + i) as usize] != 0xff123456u32 {
            changed = changed + 1u32;
        }
        i = i + 1u32;
    }
    if mode < 2u32 && (changed == 0u32) != (mode == 0u32) {
        return error("body must be hidden from its own camera and visible through the portal");
    }
    if mode == 1u32 {
        *portal_pixels = hash;
        return capture(state, "build/test-body-portal.ppm", 320u32, 240u32);
    }
    if mode == 5u32 && hash == *portal_pixels {
        return error("portal image did not change when the player body was removed");
    }
    var center: u32 = pixels[(PIXELS + 120u32 * 320u32 + 160u32) as usize];
    if mode == 2u32 {
        *lit = center;
    }
    if mode == 3u32 && center == *lit {
        return error("player body did not cast a shadow from an external room light");
    }
    if mode == 4u32 {
        return capture(state, "build/test-body-exterior.ppm", 320u32, 240u32);
    }
    return true;
}
