extern fn test_mkstemp(path: *u8) -> i32 = "mkstemp";
extern fn test_close(fd: i32) -> i32 = "close";
extern fn test_remove(path: *u8) -> i32 = "remove";
fn test_progress_store() -> bool {
    var path: [u8; 64] = uninit;
    var source: *u8 = "/tmp/spinward-save-XXXXXX";
    var i: usize = 0usize;
    while source[i] != 0u8 {
        path[i] = source[i];
        i = i + 1usize;
    }
    path[i] = 0u8;
    var fd: i32 = test_mkstemp(&path as *u8);
    if fd < 0i32 {
        return error("cannot create isolated save test");
    }
    if test_close(fd) != 0i32 {
        return error("cannot close isolated save test");
    }
    var mission: Expedition = new_expedition();
    mission.progress = 3u32;
    mission.elapsed = 14000u32;
    mission.spent = 85.5f32;
    mission.has_parked = true;
    mission.parked = vec(5f32, 10f32, 30f32);
    mission.rescues = 1u32;
    var loaded: Expedition = new_expedition();
    var good: bool = progress_write(&path as *u8, mission) && progress_read(
        &path as *u8,
        &loaded
    );
    good = good && progress_revision(mission) == progress_revision(loaded);
    if test_remove(&path as *u8) != 0i32 {
        return error("cannot remove isolated save test");
    }
    return game_check(good, "saved relights and recovery state must survive atomic replacement");
}
