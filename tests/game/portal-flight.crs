fn portal_flight_crossings(scene: read CollisionScene) -> bool {
    var i: u32 = 0u32;
    while i < collision_portal_count(read scene) {
        var portal: CollisionPortal = collision_portal(read scene, i);
        var drone: Drone = new_drone();
        drone.position = sub(portal.origin, portal.basis.forward);
        drone.basis = portal.basis;
        drone.velocity = scale(portal.basis.forward, 12f32);
        var expected: Vec3 = space_point(
            portal.transform,
            add(portal.origin, portal.basis.forward)
        );
        move_drone(read scene, mut drone, scale(portal.basis.forward, 2f32));
        if length(sub(drone.position, expected)) > 0.001f32 {
            return error("linked room crossing differs from render transform");
        }
        var reverse: Vec3 = basis_vector(
            portal.transform.basis,
            scale(portal.basis.forward, -2f32)
        );
        move_drone(read scene, mut drone, reverse);
        if length(sub(drone.position, sub(portal.origin, portal.basis.forward))) > 0.001f32 {
            return error("linked room reverse crossing differs");
        }
        i = i + 1u32;
    }
    return true;
}
fn portal_flight_capture(
    session: mut GameSession,
    scene: read CollisionScene,
    loop: mut GameLoop,
    config: GameConfig
) -> bool {
    var portal: CollisionPortal = collision_portal(read scene, 0u32);
    loop.trial.drone.position = sub(portal.origin, scale(portal.basis.forward, 0.1f32));
    loop.trial.drone.basis = portal.basis;
    if !game_render(read scene, mut session, read loop, config) {
        return false;
    }
    if !game_finish(mut session) {
        return false;
    }
    var velocity: Vec3 = scale(portal.basis.forward, 24f32);
    loop.trial.drone.velocity = velocity;
    var command: Command = idle_command();
    loop.trial.started = true;
    trial_step(read scene, mut loop.trial, command);
    var expected: Vec3 = space_point(
        portal.transform,
        add(portal.origin, scale(portal.basis.forward, 0.1f32))
    );
    if length(sub(loop.trial.drone.position, expected)) > 0.01f32 {
        return error("production simulation did not cross the portal");
    }
    return game_render(read scene, mut session, read loop, config);
}
fn portal_flight_run(session: GameSession, config: GameConfig) -> i32 {
    var scene: CollisionScene = collision_new();
    var loop: GameLoop = make GameLoop {
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_world_open(mut session, mut scene, mut loop.trial) || !portal_flight_crossings(
        read scene
    ) {
        return 1i32;
    }
    if !game_open(mut session, mut loop.input) || !game_materials_open(mut session, config) || !game_static_open(
        mut session,
        0u32
    ) {
        return 1i32;
    }
    if !hook_preview_stations(mut session, config, false) || !hook_preview_stations(
        mut session,
        config,
        true
    ) {
        return 1i32;
    }
    return (!portal_flight_capture(mut session, read scene, mut loop, config)) as i32;
}

fn hook_preview_stations(session: mut GameSession, config: GameConfig, linked: bool) -> bool {
    var scene: CollisionScene = collision_new();
    var builder: CollisionBuilder = collision_builder_new();
    var transform: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: vec(10f32, 0f32, 0f32),
        basis: make Basis {
            right: vec(0f32, 0f32, -1f32),
            up: vec(0f32, 1f32, 0f32),
            forward: vec(1f32, 0f32, 0f32)
        }
    };
    if linked && !collision_portal_append(
        mut builder,
        make CollisionPortal {
            source_scale: scale_identity(),
            target_scale: scale_identity(),
            reverse: 0xffffffffu32,
            space: 0u32,
            destination: 0u32,
            origin: vec(0f32, 1f32, 6f32),
            basis: identity_basis(),
            radius: 3f32,
            sides: 6u32,
            phase: 0f32,
            transform: transform
        }
    ) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var trial: Trial = new_trial();
    trial.auto_level = false;
    var renderer: mut Renderer = game_renderer(mut session);
    var input: FrameInput = renderer_inputs(mut renderer);
    input_frame(mut input);
    draw_hook_preview(read scene, mut input, read trial, config, 8u32);
    // The 4 m marker is hidden. The seven visible quads start at 8 m.
    if input_word(read input, 3usize) != 14u32 {
        return error("hook preview must retain its visible distance stations");
    }
    var i: u32 = 0u32;
    while i < 7u32 {
        var base: usize = (GEOMETRY + i * 30u32) as usize;
        var a: Vec3 = vec(
            input_float(read input, base),
            input_float(read input, base + 1usize),
            input_float(read input, base + 2usize)
        );
        var c: Vec3 = vec(
            input_float(read input, base + 10usize),
            input_float(read input, base + 11usize),
            input_float(read input, base + 12usize)
        );
        var expected: Vec3 = vec(0f32, 1f32, (i + 2u32) as f32 * 4f32);
        if linked {
            expected = space_point(transform, expected);
        }
        if length(sub(scale(add(a, c), 0.5f32), expected)) > 0.001f32 {
            return error("hook preview station differs from the straight hook trajectory");
        }
        i = i + 1u32;
    }
    return true;
}
