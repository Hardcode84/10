fn near(a: f32, b: f32, tolerance: f32) -> bool {
    return absf(a - b) <= tolerance;
}
fn test_forces() -> bool {
    var p: Vec3 = vec(0f32, 0f32, 0f32);
    var stopped: Vec3 = flight_acceleration(p, vec(0f32, 0f32, 0f32), false);
    var gravity: Vec3 = flight_acceleration(p, vec(0f32, 0f32, 0f32), true);
    var v: Vec3 = vec(0f32, 30f32, 0f32);
    var change: Vec3 = sub(
        flight_acceleration(p, v, true),
        flight_acceleration(p, v, false)
    );
    return game_check(
        length(stopped) == 0f32 && near(gravity.y, -1.8376875f32, 0.00001f32) && near(
            change.x,
            2.97f32,
            0.00001f32
        ),
        "force equation or Coriolis sign differs"
    );
}
fn test_collision(collision: read CollisionScene) -> bool {
    var s: Solid = solid(vec(-1f32, -1f32, -1f32), vec(1f32, 1f32, 1f32), 0u32);
    var face: Hit = sweep_box(
        vec(0f32, 0f32, -10f32),
        vec(0f32, 0f32, 20f32),
        s,
        0.35f32
    );
    var corner: Hit = sweep_box(
        vec(1.3f32, 1.3f32, -10f32),
        vec(0f32, 0f32, 20f32),
        s,
        0.35f32
    );
    var edge: Hit = sweep_box(
        vec(1.2f32, 0f32, -10f32),
        vec(0f32, 0f32, 20f32),
        s,
        0.35f32
    );
    var drone: Drone = new_drone();
    drone.position = vec(0f32, 5f32, 40f32);
    drone.velocity = vec(10f32, 0f32, 1000f32);
    move_drone(read collision, mut drone, vec(1f32, 0f32, 30f32));
    return game_check(
        near(face.time, 0.4325f32, 0.00001f32) && corner.time > 1f32 && edge.time < 0.45f32 && drone.position.z < 54.651f32 && drone.position.x > 0.99f32 && drone.velocity.z == 0f32,
        "swept sphere face/edge/corner or sliding failed"
    );
}
fn test_trial(collision: read CollisionScene) -> bool {
    var t: Trial = new_trial();
    var c: Command = idle_command();
    c.burst = true;
    trial_step(read collision, mut t, c);
    if !game_check(
        t.started && t.tick == 1u32 && t.drone.velocity.z > 14f32,
        "burst did not start trial"
    ) {
        return false;
    }
    c = idle_command();
    c.brake = true;
    trial_step(read collision, mut t, c);
    if !game_check(
        length(t.drone.velocity) < 0.0001f32 && t.drone.brake_speed > 14f32,
        "brake failed"
    ) {
        return false;
    }
    c = idle_command();
    c.spin = true;
    trial_step(read collision, mut t, c);
    if !game_check(
        t.full_spin && t.tick == 0u32 && !t.started,
        "spin selection must reset the attempt"
    ) {
        return false;
    }
    t.drone.position = vec(0f32, 4f32, 36f32);
    trial_progress(mut t, vec(0f32, 4f32, 34f32));
    if !game_check(t.gate == 1u32, "swept checkpoint crossing failed") {
        return false;
    }
    t.gate = GATE_COUNT;
    t.drone.position = add(course_finish(), vec(0f32, 0.5f32, 0f32));
    var before: Vec3 = t.drone.position;
    trial_progress(mut t, before);
    return game_check(t.finished, "finish landing failed");
}
fn test_input() -> bool {
    var input: InputState = input_new();
    input.values[6usize] = 1f32;
    input_commands(mut input, 0f32, 0f32);
    var c: Command = input_consume(mut input);
    var next: Command = input_consume(mut input);
    if !game_check(c.burst && !next.burst, "burst edge was repeated") {
        return false;
    }
    input.bindings[8usize].toggle = true;
    input.values[8usize] = 1f32;
    input_commands(mut input, 0f32, 0f32);
    c = input_consume(mut input);
    input.values[8usize] = 0f32;
    input_commands(mut input, 0f32, 0f32);
    next = input_consume(mut input);
    return game_check(c.tether && next.tether, "tether toggle did not remain active");
}
fn test_replay(collision: read CollisionScene) -> bool {
    var a: Trial = new_trial();
    var b: Trial = new_trial();
    var i: u32 = 0u32;
    while i < 1200u32 {
        var c: Command = idle_command();
        c.thrust = vec(0.3f32, 0.2f32, 0.7f32);
        c.look = vec(0.2f32, -0.1f32, 0f32);
        c.burst = i % 97u32 == 0u32;
        c.brake = i % 113u32 == 0u32;
        c.tether = i % 80u32 < 40u32;
        c.spin = i == 600u32;
        trial_step(read collision, mut a, c);
        trial_step(read collision, mut b, c);
        if trial_hash(read a) != trial_hash(read b) {
            return game_check(false, "identical input streams diverged");
        }
        i = i + 1u32;
    }
    return true;
}
fn game_tests() -> bool {
    var collision: CollisionScene = collision_new();
    if !collision_build_game(mut collision) {
        return false;
    }
    return test_collision_suite(read collision) && test_hook(read collision) && test_winch(
        read collision
    ) && test_short_press() && test_mouse_accumulation() && test_swing(read collision) && test_tether(
        read collision
    ) && test_trial(read collision) && test_input() && test_replay(read collision) && test_course_flight(
        read collision
    ) && test_prefabs(read collision) && test_expedition(read collision) && test_progress_store();
}

fn test_mouse_accumulation() -> bool {
    var input: InputState = input_new();
    input_commands(mut input, 2f32, 0f32);
    input_commands(mut input, 0f32, 0f32);
    var first: Command = input_consume(mut input);
    var second: Command = input_consume(mut input);
    return game_check(
        near(first.look.x * STEP, 0.005f32, 0.000001f32) && second.look.x == 0f32,
        "mouse motion was lost or applied twice between ticks"
    );
}
fn test_short_press() -> bool {
    var input: InputState = input_new();
    input.pulses[6usize] = 1u32;
    input_commands(mut input, 0f32, 0f32);
    var c: Command = input_consume(mut input);
    var again: Command = input_consume(mut input);
    return game_check(
        c.burst && !again.burst,
        "press and release between frames was lost or repeated"
    );
}

fn test_collision_suite(collision: read CollisionScene) -> bool {
    return test_collision_scaling() && test_collision_index(read collision) && test_forces() && test_collision_samples(
        read collision
    ) && test_collision_measure(read collision) && test_mesh_collision() && test_collision(
        read collision
    );
}
