fn body_portals(scene: mut CollisionScene) -> bool {
    var builder: CollisionBuilder = collision_builder_new();
    var portal: CollisionPortal = make CollisionPortal {
        support_bound: 0f32,
        source_scale: scale_identity(),
        target_scale: scale_identity(),
        reverse: 1u32,
        space: 0u32,
        destination: 0u32,
        origin: vec(0f32, 0f32, 1f32),
        basis: identity_basis(),
        radius: 1.2f32,
        sides: 4u32,
        phase: 0.78539816339f32,
        transform: make SpaceTransform {
            factor: 1f32,
            origin: vec(0f32, 0f32, -2f32),
            basis: make Basis {
                right: vec(0f32, 1f32, 0f32),
                up: vec(-1f32, 0f32, 0f32),
                forward: vec(0f32, 0f32, 1f32)
            }
        }
    };
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    portal.reverse = 0u32;
    portal.origin.z = -1f32;
    portal.basis.right.x = -1f32;
    portal.basis.forward.z = -1f32;
    portal.transform = space_inverse(portal.transform);
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    return collision_finish(move builder, mut scene);
}
fn body_input(
    scene: read CollisionScene,
    input: mut FrameInput,
    mesh: read Mesh,
    mode: u32
) -> unit {
    var anchors: RoomAnchors = room_anchors_new();
    game_palette(mut input);
    input_frame(mut input);
    input_set_word(mut input, BACKGROUND as usize, 0xff123456u32);
    input_set_word(mut input, SHARED_AMBIENT as usize, 1u32);
    input_set_word(mut input, 20usize, 0u32);
    input_set_word(mut input, 4usize, 0u32);
    var drone: Drone = new_drone();
    drone.position = vec(0f32, 0f32, 0f32);
    drone.world = 0u32;
    drone.basis = identity_basis();
    camera_row(mut input, 0usize, drone.basis.right, drone.position);
    camera_row(mut input, 4usize, drone.basis.up, drone.position);
    camera_row(mut input, 8usize, drone.basis.forward, drone.position);
    if mode != 2u32 && mode != 5u32 {
        draw_drone(read scene, mut input, read mesh, read drone, mut anchors);
    }
    if mode == 1u32 || mode == 5u32 {
        render_portals(mut input, read scene);
        input_set_word(mut input, 4usize, 4u32);
        quad(
            mut input,
            0u32,
            0u32,
            1u32,
            0u32,
            -0.8f32,
            -0.8f32,
            1f32,
            0.8f32,
            -0.8f32,
            1f32,
            0.8f32,
            0.8f32,
            1f32,
            -0.8f32,
            0.8f32,
            1f32
        );
    }
    if mode == 2u32 || mode == 3u32 {
        body_shadow_input(mut input);
    }
    if mode == 4u32 {
        body_exterior_input(mut input);
    }
}
fn body_shadow_input(input: mut FrameInput) -> unit {
    input_set_float(mut input, CAMERA_LIGHT as usize, 0f32);
    input_set_float(mut input, SPACE_LIGHT as usize, 0f32);
    input_set_float(mut input, (SPACE_LIGHT + 1u32) as usize, 0f32);
    input_set_float(mut input, (SPACE_LIGHT + 2u32) as usize, 0f32);
    light_object_submit(
        mut input,
        make LightObject {
            id: 0u32,
            space: 0u32,
            position: vec(0f32, 0f32, -1f32),
            radius: 8f32,
            colour: vec(4f32, 4f32, 4f32),
            mode: LIGHT_ROOM
        },
        primary_anchor(0u32, 0u32)
    );
    draw_solid(
        mut input,
        solid(vec(-4f32, -4f32, 2f32), vec(4f32, 4f32, 3f32), 0u32)
    );
}
fn body_exterior_input(input: mut FrameInput) -> unit {
    var eye: Vec3 = vec(0.8f32, 0.5f32, 1.1f32);
    var forward: Vec3 = unit_vector(scale(eye, -1f32));
    var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
    camera_row(mut input, 0usize, right, eye);
    camera_row(mut input, 4usize, cross(forward, right), eye);
    camera_row(mut input, 8usize, forward, eye);
}

fn body_overlap_check(scene: read CollisionScene, input: mut FrameInput, mesh: read Mesh) -> bool {
    var anchors: RoomAnchors = room_anchors_new();
    input_frame(mut input);
    var drone: Drone = new_drone();
    drone.world = 0u32;
    drone.position = vec(0f32, 0f32, 0.9f32);
    drone.basis = turn_basis(identity_basis(), vec(1f32, 0f32, 0f32), 0.3f32);
    draw_drone(read scene, mut input, read mesh, read drone, mut anchors);
    var count: u32 = mesh_triangle_count(read mesh);
    if input_word(read input, 3usize) != count * 2u32 {
        return false;
    }
    var transform: SpaceTransform = collision_portal(read scene, 0u32).transform;
    var vertex: u32 = 0u32;
    while vertex < count * 3u32 {
        var first: Vec3 = body_input_vertex(read input, vertex);
        var next: Vec3 = body_input_vertex(read input, vertex + count * 3u32);
        if length(sub(next, space_point(transform, first))) > 0.00001f32 {
            return false;
        }
        vertex = vertex + 1u32;
    }
    return true;
}
fn body_input_vertex(input: read FrameInput, vertex: u32) -> Vec3 {
    var address: usize = (GEOMETRY + vertex * 5u32) as usize;
    return vec(
        input_float(read input, address),
        input_float(read input, address + 1usize),
        input_float(read input, address + 2usize)
    );
}
