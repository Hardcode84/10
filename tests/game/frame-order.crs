fn check_frame_order() -> unit {
    check_prediction_visibility();
    var graph: TaskGraph = task_graph_new();
    if !game_frame_graph(mut graph) {
        trap;
    }
    var mode: u32 = 0u32;
    while mode < 4u32 {
        task_graph_start(mut graph);
        if task_next(mut graph) != 1u32 {
            trap;
        }
        task_complete(mut graph, 1u32, true);
        if task_next(mut graph) != 2u32 || task_next(mut graph) != 4u32 {
            trap;
        }
        if mode == 1u32 {
            task_complete(mut graph, 2u32, true);
        }
        task_complete(mut graph, 4u32, true);
        if task_next(mut graph) != 0u32 {
            trap;
        }
        task_submission_returned(mut graph, 0u32, true);
        if mode == 2u32 {
            task_cancel(mut graph);
        }
        if task_drained(read graph) {
            trap;
        }
        task_external_complete(mut graph, 0u32, mode != 3u32);
        if mode < 2u32 {
            check_prediction_independent_output(mut graph);
        }
        if mode != 1u32 {
            if task_drained(read graph) {
                trap;
            }
            task_complete(mut graph, 2u32, true);
        }
        if !task_drained(read graph) || task_succeeded(read graph) != (mode < 2u32) {
            trap;
        }
        mode = mode + 1u32;
    }
    puts("render and presentation complete independently of prediction; cancellation drains both");
}

fn check_prediction_independent_output(graph: mut TaskGraph) -> unit {
    if task_next(mut graph) != 3u32 {
        trap;
    }
    task_submission_returned(mut graph, 3u32, true);
    task_external_complete(mut graph, 3u32, true);
}

fn check_prediction_visibility() -> unit {
    var trial: Trial = new_trial();
    trial.preview_enabled = true;
    var prediction: Prediction = prediction_new();
    prediction.attempt = trial.attempt;
    prediction.full_spin = trial.full_spin;
    prediction.count = 2u32;
    prediction.markers[0usize].material = PREVIEW_MATERIAL;
    prediction.markers[1usize].material = HOOK_PREVIEW_MATERIAL;
    var shown: Prediction = prediction_visible(prediction, read trial);
    if shown.count != 2u32 {
        trap;
    }
    trial.drone.cable.phase = CABLE_FLYING;
    shown = prediction_visible(prediction, read trial);
    if shown.count != 1u32 || shown.markers[0usize].material != PREVIEW_MATERIAL {
        trap;
    }
    trial.preview_enabled = false;
    shown = prediction_visible(prediction, read trial);
    if shown.count != 0u32 {
        trap;
    }
    trial.preview_enabled = true;
    trial.full_spin = !trial.full_spin;
    shown = prediction_visible(prediction, read trial);
    if shown.count != 0u32 {
        trap;
    }
    trial.full_spin = !trial.full_spin;
    trial.attempt = trial.attempt + 1u32;
    shown = prediction_visible(prediction, read trial);
    if shown.count != 0u32 {
        trap;
    }
}
