fn check_frame_order() -> unit {
    check_setup_cancel();
    var graph: TaskGraph = task_graph_new();
    if !game_frame_graph(mut graph) {
        trap;
    }
    var mode: u32 = 0u32;
    while mode < 3u32 {
        task_graph_start(mut graph);
        if task_next(mut graph) != 1u32 || task_next(mut graph) != TASK_NONE {
            trap;
        }
        task_complete(mut graph, 1u32, true);
        if task_next(mut graph) != 2u32 || task_next(mut graph) != 4u32 || task_next(mut graph) != TASK_NONE {
            trap;
        }
        var first: u32 = 4u32;
        var second: u32 = 2u32;
        if mode == 1u32 {
            first = 2u32;
            second = 4u32;
        }
        task_complete(mut graph, first, true);
        if first == 4u32 {
            check_setup_completion(mut graph);
        }
        if task_next(mut graph) != TASK_NONE {
            trap;
        }
        task_complete(mut graph, second, true);
        if second == 4u32 {
            check_setup_completion(mut graph);
        }
        check_frame_output(mut graph, mode);
        mode = mode + 1u32;
    }
    puts("current simulation and prediction precede render; output drain checks passed");
}
fn check_frame_output(graph: mut TaskGraph, mode: u32) -> unit {
    if task_next(mut graph) != 0u32 {
        trap;
    }
    task_submission_returned(mut graph, 0u32, true);
    if task_next(mut graph) != TASK_NONE {
        trap;
    }
    task_external_complete(mut graph, 0u32, true);
    if task_next(mut graph) != 3u32 {
        trap;
    }
    task_submission_returned(mut graph, 3u32, true);
    if mode == 2u32 {
        task_cancel(mut graph);
    }
    if task_drained(read graph) || task_next(mut graph) != TASK_NONE {
        trap;
    }
    task_external_complete(mut graph, 3u32, mode != 1u32);
    if !task_drained(read graph) || task_succeeded(read graph) != (mode == 0u32) {
        trap;
    }
}

fn check_setup_completion(graph: mut TaskGraph) -> unit {
    if task_next(mut graph) != 5u32 {
        trap;
    }
    task_submission_returned(mut graph, 5u32, true);
    task_external_complete(mut graph, 5u32, true);
}

fn check_setup_cancel() -> unit {
    var graph: TaskGraph = task_graph_new();
    if !game_frame_graph(mut graph) {
        trap;
    }
    var mode: u32 = 0u32;
    while mode < 3u32 {
        task_graph_start(mut graph);
        if task_next(mut graph) != 1u32 {
            trap;
        }
        task_complete(mut graph, 1u32, true);
        if task_next(mut graph) != 2u32 || task_next(mut graph) != 4u32 {
            trap;
        }
        task_complete(mut graph, 4u32, true);
        if mode == 0u32 {
            task_complete(mut graph, 2u32, false);
        } else {
            if task_next(mut graph) != 5u32 {
                trap;
            }
            task_submission_returned(mut graph, 5u32, mode == 2u32);
            task_complete(mut graph, 2u32, mode == 2u32);
            if mode == 2u32 {
                task_cancel(mut graph);
                if task_drained(read graph) {
                    trap;
                }
                task_external_complete(mut graph, 5u32, true);
            }
        }
        if !task_drained(read graph) || task_succeeded(read graph) {
            trap;
        }
        mode = mode + 1u32;
    }
}
