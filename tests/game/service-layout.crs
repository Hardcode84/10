record ServiceLayoutProof {
    geometry: u32;
    anchors: u32;
    loops: u32;
}
fn layout_hash_point(hash: u32, p: Vec3) -> u32 {
    var x: u32 = (p.x * 10000f32) as i64 as u32;
    var y: u32 = (p.y * 10000f32) as i64 as u32;
    var z: u32 = (p.z * 10000f32) as i64 as u32;
    return metal_hash(hash ^ x, y, z);
}
fn layout_world_bounds(node: GraphNode) -> [f32; 6] {
    var result: [f32; 6] = make [f32; 6] {
        1e30f32,
        1e30f32,
        1e30f32,
        -1e30f32,
        -1e30f32,
        -1e30f32
    };
    var i: u32 = 0u32;
    while i < 8u32 {
        var p: Vec3 = space_point(
            node.placement,
            vec(
                node.mesh.bounds[((i & 1u32) * 3u32) as usize],
                node.mesh.bounds[(1u32 + ((i >> 1u32) & 1u32) * 3u32) as usize],
                node.mesh.bounds[(2u32 + ((i >> 2u32) & 1u32) * 3u32) as usize]
            )
        );
        result[0usize] = mask_min(result[0usize], p.x);
        result[1usize] = mask_min(result[1usize], p.y);
        result[2usize] = mask_min(result[2usize], p.z);
        result[3usize] = collision_max_scalar(result[3usize], p.x);
        result[4usize] = collision_max_scalar(result[4usize], p.y);
        result[5usize] = collision_max_scalar(result[5usize], p.z);
        i = i + 1u32;
    }
    return result;
}
fn layout_adjacent(graph: read RoomGraph, a: GraphNode, b: u32) -> bool {
    var i: u32 = 0u32;
    while i < a.count {
        var peer: u32 = graph_socket(read graph, a.first + i).peer;
        if graph_socket(read graph, peer).room == b {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}
fn layout_overlap(a: [f32; 6], b: [f32; 6]) -> bool {
    var axis: usize = 0usize;
    while axis < 3usize {
        if mask_min(a[axis + 3usize], b[axis + 3usize]) <= collision_max_scalar(
            a[axis],
            b[axis]
        ) {
            return false;
        }
        axis = axis + 1usize;
    }
    return true;
}
fn layout_clearance(graph: read RoomGraph, mesh: read Mesh) -> bool {
    var i: u32 = 0u32;
    while i < graph_count(read graph) {
        var a: GraphNode = graph_node(read graph, i);
        var bounds: [f32; 6] = layout_world_bounds(a);
        var j: u32 = i + 1u32;
        while j < graph_count(read graph) {
            if !layout_adjacent(read graph, a, j) && layout_overlap(
                bounds,
                layout_world_bounds(graph_node(read graph, j))
            ) && layout_overlap(
                layout_mesh_bounds(read mesh, a),
                layout_mesh_bounds(read mesh, graph_node(read graph, j))
            ) {
                puts("Non-neighbour room bounds overlap:");
                print_number(i as i64);
                print_number(j as i64);
                return false;
            }
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
fn layout_pig_room(mesh: read Mesh, node: GraphNode) -> bool {
    if node.kind != PREFAB_HEX_TUNNEL_10M {
        return false;
    }
    var i: u32 = node.mesh.first;
    while i < node.mesh.first + node.mesh.count {
        if mesh_triangle(read mesh, i).material == course_material_base(PREFAB_COUNT) {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}
fn layout_proof(seed: u32, proof: mut ServiceLayoutProof) -> bool {
    var asset: RoomAsset = room_asset_new();
    var scene: CollisionScene = collision_new();
    var mesh: Mesh = mesh_new();
    var graph: RoomGraph = graph_new();
    if !demo_room_build(mut asset, mut scene, mut mesh, mut graph, seed) || !layout_clearance(
        read graph,
        read mesh
    ) {
        return false;
    }
    if seed == 0u32 && !service_pipes_check(read graph, read mesh, read scene, seed) {
        return false;
    }
    if !layout_emergency_check(read graph, read mesh) {
        return false;
    }
    proof.geometry = service_pipes_hash(read mesh);
    proof.anchors = 0u32;
    proof.loops = graph_ports(read graph) / 2u32 + 1u32 - graph_count(read graph);
    var i: u32 = 0u32;
    while i < graph_count(read graph) {
        var node: GraphNode = graph_node(read graph, i);
        var bounds: [f32; 6] = layout_world_bounds(node);
        var low: Vec3 = vec(bounds[0usize], bounds[1usize], bounds[2usize]);
        var high: Vec3 = vec(bounds[3usize], bounds[4usize], bounds[5usize]);
        proof.geometry = layout_hash_point(layout_hash_point(proof.geometry, low), high);
        if node.count != 2u32 || layout_pig_room(read mesh, node) {
            proof.anchors = layout_hash_point(layout_hash_point(proof.anchors, low), high);
        }
        i = i + 1u32;
    }
    return true;
}
fn main(argc: i32, argv: **u8) -> i32 {
    var reference: ServiceLayoutProof = make ServiceLayoutProof {
        geometry: 0u32,
        anchors: 0u32,
        loops: 0u32
    };
    if !layout_proof(0u32, mut reference) {
        return 1i32;
    }
    var changed: bool = false;
    var seed: u32 = 0u32;
    while seed < 32u32 {
        var a: ServiceLayoutProof = reference;
        var b: ServiceLayoutProof = reference;
        var value: u32 = metal_hash(seed, 0u32, 0u32);
        if !layout_proof(value, mut a) || !layout_proof(value, mut b) {
            print_number(value as i64);
            return 1i32;
        }
        if a.geometry != b.geometry || a.anchors != reference.anchors || a.loops != reference.loops {
            error("Seeded paths changed anchors/topology or failed reproducibility");
            return 1i32;
        }
        changed = changed || a.geometry != reference.geometry;
        seed = seed + 1u32;
    }
    if !changed {
        error("Seeds did not change tunnel geometry");
        return 1i32;
    }
    puts(
        "Seeded layouts preserve anchors and loops, reproduce geometry, and keep rooms separate. Pipe seams, boundaries, pig exclusion and collision passed."
    );
    return 0i32;
}

fn layout_mesh_bounds(mesh: read Mesh, node: GraphNode) -> [f32; 6] {
    var result: [f32; 6] = make [f32; 6] {
        1e30f32,
        1e30f32,
        1e30f32,
        -1e30f32,
        -1e30f32,
        -1e30f32
    };
    var i: u32 = node.mesh.first;
    while i < node.mesh.first + node.mesh.count {
        var t: MeshTriangle = mesh_triangle(read mesh, i);
        var j: usize = 0usize;
        while j < 3usize {
            var v: MeshVertex = t.vertices[j];
            var p: Vec3 = space_point(node.placement, vec(v.x, v.y, v.z));
            result[0usize] = mask_min(result[0usize], p.x);
            result[1usize] = mask_min(result[1usize], p.y);
            result[2usize] = mask_min(result[2usize], p.z);
            result[3usize] = collision_max_scalar(result[3usize], p.x);
            result[4usize] = collision_max_scalar(result[4usize], p.y);
            result[5usize] = collision_max_scalar(result[5usize], p.z);
            j = j + 1usize;
        }
        i = i + 1u32;
    }
    return result;
}

fn layout_emergency_check(graph: read RoomGraph, mesh: read Mesh) -> bool {
    var lights: read FixtureLights = graph_lights(read graph);
    var room: u32 = 0u32;
    while room < graph_count(read graph) {
        var node: GraphNode = graph_node(read graph, room);
        var count: u32 = 0u32;
        var i: u32 = 0u32;
        while i < fixture_light_count(read lights) {
            var light: FixtureLight = fixture_light(read lights, i);
            if light.space == room {
                if node.kind != PREFAB_HEX_TUNNEL_10M || layout_pig_room(read mesh, node) {
                    return error("emergency light appears outside an eligible service tunnel");
                }
                var extent: f32 = graph_socket(read graph, node.first + 1u32).port.position.y;
                if light.position.y != extent * 0.5f32 || light.radius <= 0f32 || light.colour.x <= light.colour.y || light.colour.x <= light.colour.z {
                    return error("emergency fixture lost its midpoint or red light");
                }
                count = count + 1u32;
            }
            i = i + 1u32;
        }
        if count > 3u32 {
            return error("too many emergency lights in one tunnel");
        }
        room = room + 1u32;
    }
    return true;
}
