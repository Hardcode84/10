fn main(argc: i32, argv: **u8) -> i32 {
    var options: Launch = uninit;
    if !game_options(argc, argv, &options) {
        return 1i32;
    }
    options.config.width = 256u32;
    options.config.height = 192u32;
    options.capture = "build/test-hook-light.ppm";
    options.shader_checks = true;
    var renderer: Renderer = renderer_new();
    if !game_renderer_open(&renderer.state, &options, null(*u8), 0u32) {
        return 1i32;
    }
    if !dynamic_shadow_checks(mut renderer, options.config) {
        return 1i32;
    }
    var scene: CollisionScene = collision_new();
    var builder: CollisionBuilder = collision_builder_new();
    var mesh: Mesh = mesh_new();
    var wall: Solid = solid(vec(-5f32, -5f32, 6f32), vec(5f32, 5f32, 7f32), 0u32);
    if !static_solid(mut mesh, wall, 63u32) || !collision_append_solid(
        mut builder,
        read mesh,
        73u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return 1i32;
    }
    if !collision_finish(move builder, mut scene) {
        return 1i32;
    }
    var drone: Drone = new_drone();
    drone.position = vec(0f32, 0f32, 0f32);
    drone.world = 73u32;
    hook_launch(mut drone);
    drone.cable.anchor = vec(0f32, 0f32, 3f32);
    var state: u32 = 0u32;
    while state < 5u32 {
        if !hook_light_state(read scene, mut drone, state) {
            return 1i32;
        }
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            game_palette(mut input);
            input_frame(mut input);
            input_set_word(mut input, 20usize, drone.world);
            input_set_word(mut input, BACKGROUND as usize, 0xff000000u32);
            input_set_word(mut input, SHARED_AMBIENT as usize, 1u32);
            input_set_float(mut input, CAMERA_LIGHT as usize, 0f32);
            input_set_float(mut input, SPACE_LIGHT as usize, 0f32);
            input_set_float(mut input, (SPACE_LIGHT + 1u32) as usize, 0f32);
            input_set_float(mut input, (SPACE_LIGHT + 2u32) as usize, 0f32);
            camera_row(mut input, 0usize, vec(1f32, 0f32, 0f32), drone.position);
            camera_row(mut input, 4usize, vec(0f32, 1f32, 0f32), drone.position);
            camera_row(mut input, 8usize, vec(0f32, 0f32, 1f32), drone.position);
            draw_solid(mut input, wall);
            if !hook_light_transformed(read scene, mut input, drone) {
                return 1i32;
            }
            if state >= 3u32 {
                var trial: Trial = new_trial();
                trial.graph_run = true;
                trial.goal_world = 73u32;
                graph_lighting(read scene, mut input, read trial);
            }
        }
        if !renderer_draw(&renderer.state) {
            return 1i32;
        }
        if state == 1u32 && !hook_wall_capture(&renderer.state) {
            return 1i32;
        }
        var yellow: u32 = hook_light_yellow(renderer.state.mapped as *u32);
        if (yellow != 0u32) != (state != 2u32) {
            print_number(state as i64);
            error("hook and fixed room lamps did not produce the expected wall lighting");
            return 1i32;
        }
        state = state + 1u32;
    }
    puts(
        "Hook states, grazing wall lighting, transformed coordinates, and fixed start/goal lamps passed."
    );
    return (!recursive_light_capture(&options)) as i32;
}

fn hook_light_transformed(scene: read CollisionScene, input: mut FrameInput, drone: Drone) -> bool {
    var moved: Drone = drone;
    var expected: Vec3 = hook_light_position(read scene, drone);
    moved.cable.frame.origin = vec(10f32, 20f32, 30f32);
    moved.cable.frame.basis = make Basis {
        right: vec(0f32, 0f32, -1f32),
        up: vec(0f32, 1f32, 0f32),
        forward: vec(1f32, 0f32, 0f32)
    };
    moved.cable.anchor = space_point(moved.cable.frame, drone.cable.anchor);
    moved.position = vec(-2f32, 3f32, 5f32);
    moved.basis = moved.cable.frame.basis;
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    hook_light(read scene, mut input, moved);
    if drone.cable.phase != CABLE_FLYING && drone.cable.phase != CABLE_ATTACHED {
        return input_word(read input, LIGHT_COUNT as usize) == 0u32;
    }
    var p: usize = input_word(read input, LIGHT_DATA as usize) as usize;
    var actual: Vec3 = vec(
        input_float(read input, p),
        input_float(read input, p + 1usize),
        input_float(read input, p + 2usize)
    );
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    hook_light(read scene, mut input, drone);
    return length(sub(expected, actual)) < 0.00001f32 || error(
        "hook light changed room-local position across a transformed connection"
    );
}

fn hook_light_yellow(pixels: *u32) -> u32 {
    var yellow: u32 = 0u32;
    var i: u32 = 0u32;
    while i < 256u32 * 192u32 {
        var color: u32 = pixels[(PIXELS + i) as usize];
        var red: u32 = color & 255u32;
        var green: u32 = (color >> 8u32) & 255u32;
        var blue: u32 = (color >> 16u32) & 255u32;
        if red > blue + 10u32 && green > blue + 10u32 {
            yellow = yellow + 1u32;
        }
        i = i + 1u32;
    }
    return yellow;
}

fn hook_light_state(scene: read CollisionScene, drone: mut Drone, state: u32) -> bool {
    if state == 1u32 {
        drone.cable.velocity = vec(0f32, 0f32, 1000f32);
        hook_step(read scene, mut drone, false);
        if drone.cable.phase != CABLE_ATTACHED || hook_light_position(read scene, drone).z >= 6f32 {
            error("attached hook lamp must be outside the contacted wall");
            return false;
        }
    }
    if state == 3u32 {
        drone.world = 0u32;
    }
    if state == 4u32 {
        drone.world = 73u32;
    }
    if state == 2u32 {
        drone.cable = empty_cable();
    }
    return true;
}

fn prediction_shadow_flags(input: mut FrameInput, config: GameConfig) -> bool {
    input_frame(mut input);
    var drone: Drone = new_drone();
    drone.position = vec(0f32, 0f32, 0f32);
    drone.basis = identity_basis();
    var kind: u32 = 0u32;
    while kind < 2u32 {
        var material: u32 = PREVIEW_MATERIAL;
        if kind == 1u32 {
            material = HOOK_PREVIEW_MATERIAL;
        }
        var trail: PreviewTrail = preview_trail(4u32, material, 0f32);
        var first: u32 = input_word(read input, 3usize);
        var prediction: Prediction = prediction_new();
        predict_segment(
            mut prediction,
            mut trail,
            drone.position,
            vec(0f32, 0f32, 16f32),
            drone
        );
        draw_prediction(mut input, read prediction, config);
        var end: u32 = input_word(read input, 3usize);
        if first == end {
            return error("prediction fixture did not emit markers");
        }
        var i: u32 = first;
        while i < end {
            var flags: usize = (input_word(read input, META as usize) + i * 4u32 + 3u32) as usize;
            if (input_word(read input, flags) & TRIANGLE_NO_SHADOW) == 0u32 {
                return error("prediction marker casts shadows");
            }
            i = i + 1u32;
        }
        kind = kind + 1u32;
    }
    return true;
}

fn hook_wall_patch(pixels: *u32) -> u32 {
    var sum: u32 = 0u32;
    var y: u32 = 80u32;
    while y < 112u32 {
        var x: u32 = 152u32;
        while x < 184u32 {
            sum = sum + (pixels[(PIXELS + y * 256u32 + x) as usize] & 255u32);
            x = x + 1u32;
        }
        y = y + 1u32;
    }
    return sum;
}

fn hook_wall_capture(v: *RenderState) -> bool {
    if hook_wall_patch(v -> mapped as *u32) < 4096u32 {
        return error("attached hook leaves the grazing wall patch too dark");
    }
    return capture(v, "build/test-hook-attached.ppm", 256u32, 192u32);
}

fn dynamic_shadow_geometry(input: mut FrameInput, config: GameConfig) -> bool {
    return solid_shadow_faces(mut input) && solid_shadow_winding(read input) && prediction_shadow_flags(
        mut input,
        config
    );
}

fn solid_face_area(input: read FrameInput, axis: u32, plane: f32) -> f32 {
    var area: f32 = 0f32;
    var i: u32 = 0u32;
    while i < input_word(read input, 3usize) {
        var vertices: [Vec3; 3] = uninit;
        var on_plane: bool = true;
        var j: u32 = 0u32;
        while j < 3u32 {
            var p: usize = (GEOMETRY + i * 15u32 + j * 5u32) as usize;
            vertices[j as usize] = vec(
                input_float(read input, p),
                input_float(read input, p + 1usize),
                input_float(read input, p + 2usize)
            );
            on_plane = on_plane && component(vertices[j as usize], axis) == plane;
            j = j + 1u32;
        }
        if on_plane {
            area = area + length(
                cross(
                    sub(vertices[1usize], vertices[0usize]),
                    sub(vertices[2usize], vertices[0usize])
                )
            ) * 0.5f32;
        }
        i = i + 1u32;
    }
    return area;
}

fn solid_shadow_faces(input: mut FrameInput) -> bool {
    input_frame(mut input);
    draw_solid(
        mut input,
        solid(vec(-1f32, -2f32, -3f32), vec(1f32, 2f32, 3f32), 0u32)
    );
    if input_word(read input, 3usize) != 12u32 {
        return error("dynamic box must submit a closed surface for shadows");
    }
    var extent: [f32; 3] = make [f32; 3] {
        1f32,
        2f32,
        3f32
    };
    var area: [f32; 3] = make [f32; 3] {
        24f32,
        12f32,
        8f32
    };
    var axis: u32 = 0u32;
    while axis < 3u32 {
        if solid_face_area(read input, axis, extent[axis as usize]) != area[axis as usize] || solid_face_area(
            read input,
            axis,
            -extent[axis as usize]
        ) != area[axis as usize] {
            return error("dynamic box is missing a complete shadow face");
        }
        axis = axis + 1u32;
    }
    return true;
}

fn solid_shadow_winding(input: read FrameInput) -> bool {
    var i: u32 = 0u32;
    while i < input_word(read input, 3usize) {
        var vertices: [Vec3; 3] = uninit;
        var j: u32 = 0u32;
        while j < 3u32 {
            var p: usize = (GEOMETRY + i * 15u32 + j * 5u32) as usize;
            vertices[j as usize] = vec(
                input_float(read input, p),
                input_float(read input, p + 1usize),
                input_float(read input, p + 2usize)
            );
            j = j + 1u32;
        }
        var normal: Vec3 = cross(
            sub(vertices[1usize], vertices[0usize]),
            sub(vertices[2usize], vertices[0usize])
        );
        var meta: usize = (input_word(read input, META as usize) + i * 4u32) as usize;
        if (input_word(read input, meta + 3usize) & 2u32) == 0u32 || dot(
            normal,
            vertices[0usize]
        ) <= 0f32 {
            return error("solid faces must be one-sided and face away from the interior");
        }
        i = i + 1u32;
    }
    return true;
}

fn dynamic_shadow_checks(renderer: mut Renderer, config: GameConfig) -> bool {
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !dynamic_shadow_geometry(mut input, config) {
            return false;
        }
    }
    var pose: u32 = 0u32;
    while pose < 2u32 {
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            game_palette(mut input);
            input_frame(mut input);
            input_set_word(mut input, BACKGROUND as usize, 0xff123456u32);
            var eye: Vec3 = vec(0f32, 0f32, -(pose as f32) * 10f32);
            camera_row(mut input, 0usize, vec(1f32, 0f32, 0f32), eye);
            camera_row(mut input, 4usize, vec(0f32, 1f32, 0f32), eye);
            camera_row(mut input, 8usize, vec(0f32, 0f32, 1f32), eye);
            draw_solid(
                mut input,
                solid(vec(-1f32, -2f32, -3f32), vec(1f32, 2f32, 3f32), 5u32)
            );
        }
        if !renderer_draw(&renderer.state) {
            return false;
        }
        var pixels: *u32 = renderer.state.mapped as *u32;
        var center: u32 = pixels[(PIXELS + 96u32 * 256u32 + 128u32) as usize];
        if (center == 0xff123456u32) != (pose == 0u32) {
            return error("solid must be invisible from inside and visible from outside");
        }
        pose = pose + 1u32;
    }
    return true;
}

fn recursive_light_capture(options: *Launch) -> bool {
    var renderer: Renderer = renderer_new();
    var scene: CollisionScene = collision_new();
    if !light_direction_check() || !anchor_light_scene(mut scene) || !game_renderer_open(
        &renderer.state,
        options,
        null(*u8),
        2u32
    ) {
        return false;
    }
    var mode: u32 = 0u32;
    while mode < 2u32 {
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            if !anchor_light_input(read scene, mut input, mode != 0u32) {
                return false;
            }
        }
        if !renderer_draw(&renderer.state) {
            return false;
        }
        var w: *u32 = renderer.state.mapped as *u32;
        var found: u32 = 0u32;
        var i: u32 = 0u32;
        while i < 256u32 * 192u32 {
            var encoded: u32 = w[(w[DEBUG_VALUES as usize] + i * 4u32) as usize];
            if encoded != 0xffffffffu32 && encoded % w[3usize] >= 2u32 && encoded / w[3usize] < 3u32 {
                var view: u32 = encoded / w[3usize];
                var colour: u32 = w[(PIXELS + i) as usize] & 0xffffffu32;
                if (colour != 0u32) != (mode != 0u32) {
                    return error("repeated room receiver lost its physical light");
                }
                found = found | (1u32 << view);
            }
            i = i + 1u32;
        }
        if found != 7u32 {
            print_number(found as i64);
            return error("light fixture must show three views of the same room");
        }
        mode = mode + 1u32;
    }
    return capture(&renderer.state, "build/test-recursive-light.ppm", 256u32, 192u32);
}
