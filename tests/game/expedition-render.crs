fn expedition_review(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    trial.drone.position = vec(40f32, 104f32, 150f32);
    var forward: Vec3 = unit_vector(
        sub(vec(30f32, 15f32, 145f32), trial.drone.position)
    );
    var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
    trial.drone.basis = make Basis {
        forward: forward,
        right: right,
        up: cross(forward, right)
    };
    trial.drone.velocity = scale(forward, 20f32);
    if !review_frame(mut session, read trial, config, 0u32) {
        return false;
    }
    trial.expedition.progress = 3u32;
    trial.expedition.return_link = true;
    trial.expedition.relight = 2400u32;
    if !review_frame(mut session, read trial, config, 1u32) {
        return false;
    }
    trial.expedition.has_parked = true;
    trial.expedition.parked = vec(10f32, 90f32, 130f32);
    trial.drone.cable.phase = CABLE_ATTACHED;
    trial.drone.cable.anchor = vec(18f32, 112f32, 100f32);
    trial.drone.cable.extent = 30f32;
    if !review_frame(mut session, read trial, config, 2u32) {
        return false;
    }
    trial.expedition = new_expedition();
    trial.drone.charge = 0f32;
    return review_frame(mut session, read trial, config, 3u32) && review_content_views(
        mut session,
        config
    ) && review_assembly_views(mut session, config) && review_room_shells(mut session, config) && review_port_shells(
        mut session,
        config
    ) && review_material_capacity(mut session, config);
}
fn review_frame(
    session: mut GameSession,
    trial: read Trial,
    config: GameConfig,
    index: u32
) -> bool {
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        game_scene(mut input, read trial, config);
        input_set_word(mut input, OVERLAY_ENABLED as usize, 0u32);
        if !game_check(
            input_word(read input, 3usize) <= MAX_TRIS,
            "expedition render exceeds triangle budget"
        ) {
            return false;
        }
    }
    return game_draw(mut session) && review_no_void(mut session) && review_capture(
        mut session,
        index
    );
}
fn review_room_shells(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    var room: u32 = 0u32;
    while room < ROOM_COUNT {
        var instance: RoomInstance = expedition_room(room);
        trial.drone.position = add(
            instance.origin,
            scale(instance.prefab.size, 0.5f32)
        );
        var face: u32 = 0u32;
        while face < 6u32 {
            var forward: Vec3 = axis_vector(face / 2u32);
            if face % 2u32 == 0u32 {
                forward = scale(forward, -1f32);
            }
            var up: Vec3 = axis_vector((face / 2u32 + 1u32) % 3u32);
            trial.drone.basis = make Basis {
                forward: forward,
                right: cross(up, forward),
                up: up
            };
            {
                var renderer: mut Renderer = game_renderer(mut session);
                var input: FrameInput = renderer_inputs(mut renderer);
                game_scene(mut input, read trial, config);
                input_set_word(mut input, BACKGROUND as usize, 0xffe11ae3u32);
                input_set_word(mut input, OVERLAY_ENABLED as usize, 0u32);
            }
            if !game_draw(mut session) || !review_no_void(mut session) {
                return false;
            }
            face = face + 1u32;
        }
        room = room + 1u32;
    }
    return true;
}
fn review_assembly_views(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    trial.expedition.progress = 3u32;
    trial.expedition.relight = 2400u32;
    var eyes: [Vec3; 4] = make [Vec3; 4] {
        vec(-5f32, 24f32, 80f32),
        vec(112f32, 25f32, 138f32),
        vec(112f32, 138f32, 150f32),
        vec(0f32, 4f32, 56f32)
    };
    var targets: [Vec3; 4] = make [Vec3; 4] {
        vec(65f32, 24f32, 150f32),
        vec(116f32, 134f32, 150f32),
        vec(40f32, 120f32, 150f32),
        vec(0f32, 4f32, 90f32)
    };
    var i: u32 = 0u32;
    while i < 4u32 {
        trial.drone.position = eyes[i as usize];
        var forward: Vec3 = unit_vector(sub(targets[i as usize], trial.drone.position));
        var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
        trial.drone.basis = make Basis {
            forward: forward,
            right: right,
            up: cross(forward, right)
        };
        if !review_frame(mut session, read trial, config, i + 4u32) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn review_port_shells(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    var i: u32 = 0u32;
    while i < ROOM_LINK_COUNT {
        var link: RoomLink = expedition_link(i);
        var room: RoomInstance = expedition_room(link.a);
        var port: Solid = port_world(room, link.port_a);
        var axis: u32 = room.prefab.ports[link.port_a as usize].face / 2u32;
        var sample: u32 = 0u32;
        while sample < 6u32 {
            var forward: Vec3 = axis_vector(axis);
            trial.drone.position = add(
                scale(add(port.low, port.high), 0.5f32),
                scale(forward, (sample / 2u32) as f32 * 2f32 - 2f32)
            );
            if sample % 2u32 == 0u32 {
                forward = scale(forward, -1f32);
            }
            var up: Vec3 = axis_vector((axis + 1u32) % 3u32);
            trial.drone.basis = make Basis {
                forward: forward,
                right: cross(up, forward),
                up: up
            };
            if !review_shell_view(mut session, read trial, config) {
                return false;
            }
            sample = sample + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
fn review_shell_view(session: mut GameSession, trial: read Trial, config: GameConfig) -> bool {
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        game_scene(mut input, read trial, config);
        input_set_word(mut input, BACKGROUND as usize, 0xffe11ae3u32);
        input_set_word(mut input, OVERLAY_ENABLED as usize, 0u32);
    }
    return game_draw(mut session) && review_no_void(mut session);
}
fn review_content_views(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    var eyes: [Vec3; 6] = make [Vec3; 6] {
        vec(0f32, 4f32, -4f32),
        vec(0f32, 6f32, 52f32),
        vec(0f32, 4f32, -4f32),
        vec(116f32, 20f32, 140f32),
        vec(116f32, 132f32, 150f32),
        vec(116f32, 20f32, 140f32)
    };
    var targets: [Vec3; 6] = make [Vec3; 6] {
        vec(0f32, 4f32, 45f32),
        vec(0f32, 1f32, 0f32),
        vec(0f32, 4f32, 45f32),
        vec(116f32, 95f32, 152f32),
        vec(116f32, 60f32, 148f32),
        vec(116f32, 95f32, 152f32)
    };
    var i: u32 = 0u32;
    while i < 6u32 {
        trial.expedition.progress = 3u32;
        trial.expedition.relight = 2400u32;
        if i == 2u32 {
            trial.expedition.progress = 0u32;
        }
        if i == 5u32 {
            trial.expedition.progress = 1u32;
        }
        trial.drone.position = eyes[i as usize];
        var forward: Vec3 = unit_vector(sub(targets[i as usize], trial.drone.position));
        var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
        trial.drone.basis = make Basis {
            forward: forward,
            right: right,
            up: cross(forward, right)
        };
        if !review_frame(mut session, read trial, config, i + 8u32) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
