// Exercises the authored sliding leaf through scene assembly, prediction and physics.
fn test_doors() -> bool {
    var hex: RoomAsset = room_asset_new();
    var oct: RoomAsset = room_asset_new();
    if !hex_door_leaves(1f32, mut hex) || !oct_door_leaves(1f32, mut oct) {
        return false;
    }
    if !test_door_fixture(move hex) {
        return false;
    }
    return test_door_fixture(move oct) && test_door_blocked_occupancy();
}
fn test_door_fixture(asset: RoomAsset) -> bool {
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    var snapshot: CollisionScene = collision_new();
    var doors: DoorSet = doors_new();
    if !doors_asset(mut doors, read asset, mut builder, 0u32, 0u32) {
        return false;
    }
    if !test_door_portals(mut builder, scale_identity()) {
        return false;
    }
    if !collision_finish(move builder, mut scene) || !collision_snapshot(
        read scene,
        mut snapshot
    ) {
        return false;
    }
    if !test_prediction_admission(read scene, read doors) || !test_door_portal_sensor(
        read scene,
        mut doors
    ) {
        return false;
    }
    var door: DoorInstance = door_get(read doors, 0u32);
    if !test_door_forecast(read scene, mut doors, -1f32) || !test_door_forecast(
        read scene,
        mut doors,
        1f32
    ) {
        return false;
    }
    var closed: CollisionSweep = collision_local_sweep_interval(
        read scene,
        0u32,
        vec(0f32, -2f32, 0f32),
        vec(0f32, 5f32, 0f32),
        DRONE_RADIUS,
        0f32,
        STEP
    );
    if !game_check(
        closed.contact.hit.time <= 1f32,
        "closed leaves did not block the aperture"
    ) {
        return false;
    }
    return test_door_trigger_shape(door) && test_door_leaf_contacts(mut scene, read doors) && test_door_opening(
        mut scene,
        mut snapshot,
        mut doors,
        read closed
    );
}
fn test_door_opening(
    scene: mut CollisionScene,
    snapshot: mut CollisionScene,
    doors: mut DoorSet,
    closed: read CollisionSweep
) -> bool {
    var attachment: CollisionAttachment = collision_attachment_new();
    var door: DoorInstance = door_get(read doors, 0u32);
    var trial: Trial = new_trial();
    trial.drone.cable.phase = CABLE_ATTACHED;
    trial.drone.cable.instance = door.collision_first;
    trial.drone.velocity = vec(1f32, 2f32, 3f32);
    door_set_requested(mut doors, 0u32, true);
    doors_step(mut scene, mut doors, mut trial);
    if !game_check(
        trial.drone.cable.phase == CABLE_SNAPPED && length(
            sub(trial.drone.velocity, vec(1f32, 2f32, 3f32))
        ) == 0f32,
        "opening door must release the hook without changing ship velocity"
    ) {
        return false;
    }
    var held: Command = idle_command();
    held.tether = true;
    tether_input(mut trial.drone, held);
    if !game_check(
        trial.drone.cable.phase == CABLE_SNAPPED && length(
            sub(trial.drone.velocity, vec(1f32, 2f32, 3f32))
        ) == 0f32,
        "held tether relaunched after door disconnection"
    ) {
        return false;
    }
    if !game_check(
        door_state(read snapshot, door, 0f32) == DOOR_CLOSED,
        "worker snapshot changed with the live scene"
    ) {
        return false;
    }
    collision_snapshot_motion(read scene, mut snapshot);
    if !game_check(
        door_state(read snapshot, door, 0f32) == DOOR_OPENING,
        "worker did not receive door motion"
    ) {
        return false;
    }
    hook_attach(read scene, mut trial.drone, read closed, read attachment, STEP, STEP);
    if !game_check(
        trial.drone.cable.phase == CABLE_SNAPPED,
        "hook attached to a moving leaf"
    ) {
        return false;
    }
    return test_door_open(mut scene, door) && test_door_motion_boundaries(mut scene, door) && test_door_closing(
        mut scene,
        mut doors
    ) && test_door_portal_occupancy(mut scene, mut doors) && test_door_multiple();
}
fn test_door_open(scene: mut CollisionScene, door: DoorInstance) -> bool {
    var open: CollisionSweep = collision_local_sweep_interval(
        read scene,
        0u32,
        vec(0f32, -2f32, 0f32),
        vec(0f32, 5f32, 0f32),
        DRONE_RADIUS,
        DOOR_OPEN_SECONDS,
        STEP
    );
    if !game_check(
        open.status == 0u32 && open.contact.hit.time > 1f32,
        "opened leaves still block the aperture"
    ) {
        return false;
    }
    var pose: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        DOOR_OPEN_SECONDS
    );
    var later: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        DOOR_OPEN_SECONDS + 10f32
    );
    if !game_check(
        length(sub(pose.origin, later.origin)) == 0f32 && length(later.linear) == 0f32,
        "opened leaf continued moving"
    ) {
        return false;
    }
    collision_controlled_reset(mut scene);
    return game_check(
        door_state(read scene, door, 0f32) == DOOR_CLOSED,
        "run reset left the door open"
    );
}
fn test_door_forecast(scene: read CollisionScene, doors: mut DoorSet, side: f32) -> bool {
    var trial: Trial = new_trial();
    trial.full_spin = false;
    trial.preview_enabled = false;
    trial.drone.world = 0u32;
    trial.drone.position = vec(0f32, side * 60f32, 0f32);
    trial.drone.velocity = vec(0f32, -side * 45f32, 0f32);
    var scratch: Drone = new_drone();
    var prediction: Prediction = predict_scene(read scene, read trial, mut scratch, mut doors);
    var visible: Prediction = prediction_visible(prediction, read trial);
    return game_check(
        door_get(read doors, 0u32).requested && visible.count == 0u32 && scratch.clock == trial.drone.clock + PREDICTION_TICKS,
        "hidden ship forecast did not request the approached door for its full horizon"
    );
}

fn test_door_motion_boundaries(scene: mut CollisionScene, door: DoorInstance) -> bool {
    var bounds: CollisionInstance = collision_instance(read scene, door.collision_first);
    var center: Vec3 = scale(add(bounds.low, bounds.high), 0.5f32);
    collision_slide(mut scene, door.collision_first, 1f32, 1f32, vec(0f32, 2f32, 0f32));
    var hit: CollisionSweep = collision_local_sweep_interval(
        read scene,
        door.space,
        vec(center.x, -2f32, center.z),
        vec(0f32, 5f32, 0f32),
        DRONE_RADIUS,
        0f32,
        3f32
    );
    var surface: f32 = door.origin.y - DOOR_THICKNESS * 0.5f32 + 2f32;
    var expected: f32 = (surface - DRONE_RADIUS + 2f32) / 5f32;
    return game_check(
        hit.status == 0u32 && absf(hit.contact.hit.time - expected) < 0.00001f32 && absf(
            hit.contact.point.y - surface
        ) < 0.00001f32,
        "sweep across translation start and stop lost contact time or final surface"
    );
}

fn test_door_portals(builder: mut CollisionBuilder, ratio: ScaleRatio) -> bool {
    var transform: SpaceTransform = make SpaceTransform {
        factor: scale_float(ratio),
        origin: vec(0f32, -1f32, 0f32),
        basis: make Basis {
            right: vec(1f32, 0f32, 0f32),
            up: vec(0f32, 0f32, -1f32),
            forward: vec(0f32, 1f32, 0f32)
        }
    };
    var portal: CollisionPortal = make CollisionPortal {
        support_bound: 0f32,
        source_scale: scale_identity(),
        target_scale: ratio,
        reverse: 1u32,
        space: 1u32,
        destination: 0u32,
        origin: vec(0f32, 0f32, 0f32),
        basis: identity_basis(),
        radius: 3f32,
        sides: 6u32,
        phase: 0f32,
        transform: transform
    };
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    portal.source_scale = ratio;
    portal.target_scale = scale_identity();
    portal.radius = portal.radius * transform.factor;
    portal.reverse = 0u32;
    portal.space = 0u32;
    portal.destination = 1u32;
    portal.origin = transform.origin;
    portal.basis = space_basis(
        transform,
        make Basis {
            right: vec(-1f32, 0f32, 0f32),
            up: vec(0f32, 1f32, 0f32),
            forward: vec(0f32, 0f32, -1f32)
        }
    );
    portal.transform = space_inverse(transform);
    return collision_portal_append(mut builder, portal);
}
fn test_door_portal_sensor(scene: read CollisionScene, doors: mut DoorSet) -> bool {
    var prediction: Prediction = prediction_new();
    var trail: PreviewTrail = preview_trail(0u32, PREVIEW_MATERIAL, 0f32);
    var eye: PredictionEye = make PredictionEye {
        position: vec(0f32, 0f32, -1f32),
        basis: identity_basis(),
        world: 1u32,
        factor: 1f32
    };
    predict_door_portal(
        read scene,
        mut doors,
        mut prediction,
        mut trail,
        eye.position,
        vec(0f32, 0f32, 10f32),
        eye
    );
    return game_check(
        door_get(read doors, 0u32).requested,
        "translated and rotated portal lost door approach"
    );
}

fn test_door_closing(scene: mut CollisionScene, doors: mut DoorSet) -> bool {
    collision_controlled_reset(mut scene);
    doors_reset(mut doors);
    var door: DoorInstance = door_get(read doors, 0u32);
    var trial: Trial = new_trial();
    trial.drone.position = vec(0f32, -20f32, 0f32);
    door_set_requested(mut doors, 0u32, true);
    doors_step(mut scene, mut doors, mut trial);
    trial.drone.clock = (DOOR_OPEN_SECONDS / STEP) as u32 + 1u32;
    doors_step(mut scene, mut doors, mut trial);
    door_set_requested(mut doors, 0u32, false);
    var close_tick: u32 = (door_get(read doors, 0u32).hold_until / STEP) as u32 + 1u32;
    trial.drone.clock = close_tick - 2u32;
    doors_step(mut scene, mut doors, mut trial);
    if !game_check(
        door_state(read scene, door, trial.drone.clock as f32 * STEP) == DOOR_OPEN,
        "door closed before the forecast grace period"
    ) {
        return false;
    }
    trial.drone.clock = close_tick;
    trial.drone.cable.phase = CABLE_ATTACHED;
    trial.drone.cable.instance = door.collision_first;
    var before: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        trial.drone.clock as f32 * STEP
    );
    doors_step(mut scene, mut doors, mut trial);
    var after: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        trial.drone.clock as f32 * STEP
    );
    if !game_check(
        door_state(read scene, door, trial.drone.clock as f32 * STEP) == DOOR_CLOSING && length(
            sub(before.origin, after.origin)
        ) == 0f32 && trial.drone.cable.phase == CABLE_SNAPPED,
        "closing jumped the leaf or retained its hook"
    ) {
        return false;
    }
    return test_door_reverse(mut scene, mut doors, mut trial, door);
}
fn test_door_reverse(
    scene: mut CollisionScene,
    doors: mut DoorSet,
    trial: mut Trial,
    door: DoorInstance
) -> bool {
    trial.drone.clock = trial.drone.clock + (DOOR_OPEN_SECONDS * 0.5f32 / STEP) as u32;
    var time: f32 = trial.drone.clock as f32 * STEP;
    var before: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        time
    );
    door_set_requested(mut doors, 0u32, true);
    doors_step(mut scene, mut doors, mut trial);
    var after: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        time
    );
    if !game_check(
        door_state(read scene, door, time) == DOOR_OPENING && length(
            sub(before.origin, after.origin)
        ) == 0f32,
        "returning forecast did not reverse the closing leaf continuously"
    ) {
        return false;
    }
    door_set_requested(mut doors, 0u32, false);
    trial.drone.clock = (door_get(read doors, 0u32).hold_until / STEP) as u32 + 1u32;
    doors_step(mut scene, mut doors, mut trial);
    trial.drone.clock = trial.drone.clock + (DOOR_OPEN_SECONDS / STEP) as u32 + 1u32;
    time = trial.drone.clock as f32 * STEP;
    var final: CollisionInstance = collision_pose(
        collision_instance(read scene, door.collision_first),
        time
    );
    if !game_check(
        door_state(read scene, door, time) == DOOR_CLOSED && length(
            sub(final.origin, door.origin)
        ) == 0f32,
        "door did not return exactly to its closed reference pose"
    ) {
        return false;
    }
    trial.drone.position = door.origin;
    doors_step(mut scene, mut doors, mut trial);
    return game_check(
        door_state(read scene, door, time) == DOOR_OPENING,
        "occupied door ignored the ship while waiting for a forecast"
    );
}
fn test_door_multiple() -> bool {
    var first: RoomAsset = room_asset_new();
    var second: RoomAsset = room_asset_new();
    var doors: DoorSet = doors_new();
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    if !hex_door_leaves(1f32, mut first) || !oct_door_leaves(17f32, mut second) || !doors_asset(
        mut doors,
        read first,
        mut builder,
        0u32,
        0u32
    ) || !doors_asset(mut doors, read second, mut builder, 0u32, 0u32) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var trial: Trial = new_trial();
    trial.drone.position = vec(0f32, -8f32, 0f32);
    door_set_requested(mut doors, 0u32, true);
    door_set_requested(mut doors, 1u32, true);
    doors_step(mut scene, mut doors, mut trial);
    trial.drone.clock = (DOOR_OPEN_SECONDS / STEP) as u32 + 1u32;
    trial.drone.velocity = vec(0f32, 30f32, 0f32);
    trial.auto_level = false;
    var scratch: Drone = new_drone();
    var prediction: Prediction = predict_scene(read scene, read trial, mut scratch, mut doors);
    if !game_check(
        door_get(read doors, 0u32).requested && door_get(read doors, 1u32).requested,
        "one forecast did not hold all approached open doors"
    ) {
        return false;
    }
    trial.drone.velocity.y = -30f32;
    prediction = predict_scene(read scene, read trial, mut scratch, mut doors);
    return game_check(
        !door_get(read doors, 0u32).requested && !door_get(read doors, 1u32).requested,
        "doors retained requests after the forecast left both triggers"
    );
}

fn test_door_portal_occupancy(scene: mut CollisionScene, doors: mut DoorSet) -> bool {
    collision_controlled_reset(mut scene);
    doors_reset(mut doors);
    var door: DoorInstance = door_get(read doors, 0u32);
    var trial: Trial = new_trial();
    door_move(mut scene, read doors, door, mut trial, true);
    trial.drone.clock = ((DOOR_OPEN_SECONDS + DOOR_CLOSE_DELAY) / STEP) as u32 + 1u32;
    trial.drone.world = 1u32;
    trial.drone.position = vec(0f32, 0f32, -0.1f32);
    var size: Rational = rational_new(5u64, 1u64);
    rational_assign(mut trial.drone.size, read size);
    doors_step(mut scene, mut doors, mut trial);
    var time: f32 = trial.drone.clock as f32 * STEP;
    return game_check(
        door_state(read scene, door, time) == DOOR_OPEN && door_get(read doors, 0u32).hold_until > time,
        "scaled ship overlap through a rotated portal allowed the door to close"
    );
}

// Every leaf blocks its interior while closed, releases its hook, and clears the aperture.
fn test_door_leaf_contacts(scene: mut CollisionScene, doors: read DoorSet) -> bool {
    var door: DoorInstance = door_get(read doors, 0u32);
    var leaf: u32 = 0u32;
    while leaf < door.count {
        collision_controlled_reset(mut scene);
        var id: u32 = door.collision_first + leaf;
        var item: CollisionInstance = collision_instance(read scene, id);
        var center: Vec3 = scale(add(item.low, item.high), 0.5f32);
        var start: Vec3 = vec(center.x, door.origin.y - 2f32, center.z);
        var closed: CollisionSweep = collision_local_sweep_interval(
            read scene,
            door.space,
            start,
            vec(0f32, 4f32, 0f32),
            DRONE_RADIUS,
            0f32,
            STEP
        );
        if !game_check(
            closed.status == 0u32 && closed.contact.hit.time <= 1f32 && closed.contact.instance == id,
            "closed leaf interior is missing"
        ) {
            return false;
        }
        var trial: Trial = new_trial();
        trial.drone.cable.phase = CABLE_ATTACHED;
        trial.drone.cable.instance = id;
        door_move(mut scene, read doors, door, mut trial, true);
        if !game_check(
            trial.drone.cable.phase == CABLE_SNAPPED,
            "moving leaf retained the hook"
        ) {
            return false;
        }
        var open: CollisionSweep = collision_local_sweep_interval(
            read scene,
            door.space,
            start,
            vec(0f32, 4f32, 0f32),
            DRONE_RADIUS,
            DOOR_OPEN_SECONDS,
            STEP
        );
        if !game_check(
            open.status == 0u32 && open.contact.hit.time > 1f32,
            "opened leaf did not clear its aperture"
        ) {
            return false;
        }
        leaf = leaf + 1u32;
    }
    collision_controlled_reset(mut scene);
    return true;
}

fn test_door_trigger_shape(door: DoorInstance) -> bool {
    var side: u32 = 0u32;
    var step: f32 = 6.28318530718f32 / door.shape.sides as f32;
    var edge: f32 = door.radius * cosf(step * 0.5f32);
    while side < door.shape.sides {
        var angle: f32 = door.shape.phase + (side as f32 + 0.5f32) * step;
        var normal: Vec3 = vec(cosf(angle), 0f32, sinf(angle));
        var inside: Vec3 = add(door.origin, scale(normal, edge * 0.99f32));
        var outside: Vec3 = add(door.origin, scale(normal, edge * 1.01f32));
        if !game_check(
            door_approach(door, inside, inside, 0f32) && !door_approach(
                door,
                outside,
                outside,
                0f32
            ),
            "door trigger does not match its aperture"
        ) {
            return false;
        }
        side = side + 1u32;
    }
    return true;
}

fn test_door_blocked_occupancy() -> bool {
    var asset: RoomAsset = room_asset_new();
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    var doors: DoorSet = doors_new();
    if !hex_door_leaves(1f32, mut asset) || !doors_asset(
        mut doors,
        read asset,
        mut builder,
        0u32,
        0u32
    ) || !test_door_portals(mut builder, scale_ratio(1u64, 4096u64)) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var trial: Trial = new_trial();
    var door: DoorInstance = door_get(read doors, 0u32);
    door_move(mut scene, read doors, door, mut trial, true);
    trial.drone.clock = ((DOOR_OPEN_SECONDS + DOOR_CLOSE_DELAY) / STEP) as u32 + 1u32;
    trial.drone.world = 1u32;
    trial.drone.position = vec(0f32, 0f32, -0.1f32);
    doors_step(mut scene, mut doors, mut trial);
    return game_check(
        door_state(read scene, door, trial.drone.clock as f32 * STEP) == DOOR_CLOSING,
        "blocked portal placement held a remote door open"
    );
}
