fn review_capture(session: mut GameSession, index: u32) -> bool {
    var paths: [*u8; 14] = make [*u8; 14] {
        "build/expedition-dark.ppm",
        "build/expedition-lit.ppm",
        "build/expedition-recovery.ppm",
        "build/expedition-empty.ppm",
        "build/prefab-hall.ppm",
        "build/prefab-shaft.ppm",
        "build/prefab-crown.ppm",
        "build/prefab-door.ppm",
        "build/content-cradle-entry.ppm",
        "build/content-cradle-return.ppm",
        "build/content-cradle-dark.ppm",
        "build/content-riser-entry.ppm",
        "build/content-riser-return.ppm",
        "build/content-riser-dark.ppm"
    };
    return capture(
        &session.renderer.state,
        paths[index as usize],
        session.launch.config.width,
        session.launch.config.height
    );
}
fn review_no_void(session: mut GameSession) -> bool {
    var words: *u32 = session.renderer.state.mapped as *u32;
    var background: u32 = words[BACKGROUND as usize];
    var pixels: usize = (session.launch.config.width * session.launch.config.height) as usize;
    var i: usize = 0usize;
    while i < pixels {
        if words[PRESENT_PIXELS as usize + i] == background {
            print_number(i as i64);
            return error("prefab view contains an uncovered background pixel");
        }
        i = i + 1usize;
    }
    return true;
}
fn review_material_capacity(session: mut GameSession, config: GameConfig) -> bool {
    var trial: Trial = new_trial();
    start_expedition(mut trial);
    game_scene_frame(mut session, read trial, config);
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        input_set_word(mut input, OVERLAY_ENABLED as usize, 0u32);
        var material: u32 = GAME_MATERIALS - 1u32;
        var instance: u32 = 0u32;
        var instance_meta: u32 = input_word(read input, INSTANCE_META as usize);
        var instance_count: u32 = input_word(read input, INSTANCE_COUNT as usize);
        while instance < instance_count {
            input_set_word(
                mut input,
                (instance_meta + instance * 5u32 + 4u32) as usize,
                material
            );
            instance = instance + 1u32;
        }
        var texture: u32 = app_texture(read input, material);
        var palette: u32 = app_palette(read input);
        var i: u32 = 0u32;
        while i < input_word(read input, 3usize) {
            input_set_word(mut input, (META + i * 4u32 + 1u32) as usize, material);
            i = i + 1u32;
        }
        i = 0u32;
        while i < 64u32 {
            input_texel(mut input, texture + i, 255u32);
            i = i + 1u32;
        }
        i = 0u32;
        while i < 512u32 {
            input_asset_set(mut input, palette + 255u32 * LIGHT_STATES + i, 0xff5173b9u32);
            i = i + 1u32;
        }
    }
    if !review_draw(mut session) {
        return false;
    }
    var words: *u32 = session.renderer.state.mapped as *u32;
    var i: u32 = 0u32;
    while i < config.width * config.height {
        if words[(PRESENT_PIXELS + i) as usize] != 0xff5173b9u32 {
            return error("last material texture and palette must reach the GPU");
        }
        i = i + 1u32;
    }
    return true;
}

fn review_draw(session: mut GameSession) -> bool {
    return visibility_compare(&session.renderer.state, false);
}
