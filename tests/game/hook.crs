fn test_hook_launch(collision: read CollisionScene) -> bool {
    var d: Drone = new_drone();
    d.position = vec(0f32, 4f32, 35f32);
    d.velocity = vec(3f32, 2f32, 1f32);
    var before: Vec3 = d.velocity;
    hook_launch(mut d);
    var momentum: Vec3 = add(d.velocity, scale(d.cable.velocity, HOOK_MASS_RATIO));
    if !game_check(
        length(sub(momentum, scale(before, 1f32 + HOOK_MASS_RATIO))) < 0.00001f32 && near(
            d.velocity.z,
            -0.2f32,
            0.00001f32
        ) && near(d.cable.velocity.z, 61f32, 0.00001f32),
        "launch must inherit velocity and conserve momentum with recoil"
    ) {
        return false;
    }
    var command: Command = idle_command();
    command.tether = true;
    simulate(read collision, mut d, command, false, true);
    return game_check(
        d.cable.phase == CABLE_FLYING && d.cable.anchor.z > 35f32 && d.cable.anchor.z < 36f32,
        "hook must travel before it attaches"
    );
}
fn test_hook_forces(collision: read CollisionScene, full_spin: bool) -> bool {
    var d: Drone = new_drone();
    d.position = vec(20f32, 40f32, 0f32);
    d.velocity = vec(3f32, 20f32, 5f32);
    hook_launch(mut d);
    var reference: Drone = new_drone();
    reference.position = d.cable.anchor;
    reference.velocity = d.cable.velocity;
    var command: Command = idle_command();
    command.tether = true;
    var i: u32 = 0u32;
    while i < 120u32 {
        simulate(read collision, mut reference, idle_command(), full_spin, false);
        simulate(read collision, mut d, command, full_spin, false);
        if !game_check(
            d.cable.phase == CABLE_FLYING && length(
                sub(d.cable.anchor, reference.position)
            ) < 0.00001f32 && length(sub(d.cable.velocity, reference.velocity)) < 0.00001f32,
            "hook and reference player must follow the same force integration"
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn test_hook_sweep(collision: read CollisionScene) -> bool {
    var d: Drone = new_drone();
    d.position = vec(0f32, 4f32, 35f32);
    hook_launch(mut d);
    d.cable.velocity = vec(0f32, 0f32, 30000f32);
    hook_step(read collision, mut d, false);
    return game_check(
        d.cable.phase == CABLE_ATTACHED && near(d.cable.anchor.z, 55f32, 0.001f32),
        "hook must hit the first surface even when a tick exceeds maximum range"
    );
}
fn test_hook_range(collision: read CollisionScene) -> bool {
    var d: Drone = new_drone();
    d.position = vec(100f32, 100f32, 0f32);
    var c: Command = idle_command();
    c.tether = true;
    c.reel = true;
    var i: u32 = 0u32;
    while i < 1200u32 && d.cable.phase != CABLE_SNAPPED {
        simulate(read collision, mut d, c, false, false);
        if d.cable.phase == CABLE_FLYING && length(sub(d.position, d.cable.anchor)) > CABLE_REACH + 0.001f32 {
            return game_check(false, "flying hook exceeded cable reach");
        }
        i = i + 1u32;
    }
    if !game_check(
        d.cable.phase == CABLE_SNAPPED,
        "shot without a surface must snap at the range limit"
    ) {
        return false;
    }
    simulate(read collision, mut d, c, false, false);
    if !game_check(
        d.cable.phase == CABLE_SNAPPED && !d.cable.reeling,
        "holding after a snap must not fire or retain reeling"
    ) {
        return false;
    }
    simulate(read collision, mut d, idle_command(), false, false);
    c.reel = false;
    simulate(read collision, mut d, c, false, false);
    if !game_check(
        d.cable.phase == CABLE_FLYING && !d.cable.reeling,
        "release must permit a new launch with the reel off"
    ) {
        return false;
    }
    simulate(read collision, mut d, idle_command(), false, false);
    return game_check(
        d.cable.phase == CABLE_READY,
        "release during flight must recall the hook"
    );
}
fn test_hook_hash() -> bool {
    var a: Trial = new_trial();
    hook_launch(mut a.drone);
    var b: Trial = clone_trial(read a);
    b.drone.cable.velocity.x = b.drone.cable.velocity.x + 1f32;
    var c: Trial = clone_trial(read a);
    c.drone.cable.phase = CABLE_ATTACHED;
    var d: Trial = clone_trial(read a);
    d.drone.cable.reeling = true;
    return game_check(
        trial_hash(read a) != trial_hash(read b) && trial_hash(read a) != trial_hash(read c) && trial_hash(
            read a
        ) != trial_hash(read d),
        "replay hash must include projectile velocity, cable phase and latched reeling"
    );
}
fn test_hook(collision: read CollisionScene) -> bool {
    return test_hook_launch(read collision) && test_hook_forces(read collision, false) && test_hook_forces(
        read collision,
        true
    ) && test_hook_sweep(read collision) && test_hook_range(read collision) && test_hook_hash();
}

fn test_attach_surface(scene: read CollisionScene, drone: mut Drone, travel: Vec3) -> bool {
    var attachment: CollisionAttachment = collision_attachment_new();
    var time: f32 = drone.clock as f32 * STEP;
    var hit: CollisionSweep = collision_sweep_attachment_interval(
        read scene,
        drone.world,
        drone.position,
        travel,
        HOOK_RADIUS,
        time,
        0f32,
        mut attachment
    );
    if !game_check(
        hit.status == 0u32 && hit.contact.hit.time <= 1f32,
        "attachment fixture must hit a mesh surface"
    ) {
        return false;
    }
    hook_attach(read scene, mut drone, read hit, read attachment, time, time);
    return true;
}
