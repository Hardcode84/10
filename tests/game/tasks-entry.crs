record FlightTiming {
    start: u64;
    submitted: u64;
    finish: u64;
    worker: TaskRunTimes;
}
fn main(argc: i32, argv: **u8) -> i32 {
    var launch: Launch = uninit;
    if !game_options(argc, argv, &launch) {
        return 2i32;
    }
    launch.config.headless = true;
    launch.config.ticks = 80u32;
    puts("frame timing mode: scheduler");
    return task_frame_check(game_session(&launch), launch.config);
}
fn task_frame_check(session: GameSession, config: GameConfig) -> i32 {
    var collision: CollisionScene = collision_new();
    var loop: GameLoop = make GameLoop {
        sparks: sparks_new(),
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_run_setup(mut session, mut collision, mut loop, config) {
        return 1i32;
    }
    check_frame_order();
    var prediction: Prediction = prediction_new();
    var context: PredictionContext = game_prediction_context(read session, read collision);
    prediction_game_streaming(mut context, read session);
    var sound: SoundContext = game_sound_context(read session, read collision);
    if !sound_game_streaming(mut sound, read session) || !prediction_context_ready(read context) {
        return 1i32;
    }
    var previous: u64 = now();
    var samples: [u64; 80] = uninit;
    zero(&samples as *u8, sizeof([u64; 80]));
    var timings: [FlightTiming; 80] = uninit;
    zero(&timings as *u8, sizeof([FlightTiming; 80]));
    var frame: u32 = 0u32;
    while frame < 80u32 {
        var command: Command = idle_command();
        command.thrust.z = 1f32;
        command.burst = frame == 4u32;
        command.tether = frame >= 20u32 && frame < 64u32;
        command.reel = frame == 28u32;
        loop.input.pending = command;
        var displayed: Prediction = prediction;
        var start: u64 = now();
        timings[frame as usize].start = start;
        {
            if !game_task_frame(
                mut context,
                mut sound,
                mut collision,
                mut session,
                mut loop,
                config,
                mut previous,
                mut prediction
            ) {
                return 1i32;
            }
            timings[frame as usize].worker = prediction_context_times(read context);
        }
        timings[frame as usize].submitted = session.renderer.state.frame_submit_ns;
        timings[frame as usize].finish = now();
        samples[frame as usize] = now() - start;
        task_check_prediction(read collision, read loop.trial, read prediction);
        if !task_check_frame_pixels(
            read collision,
            mut session,
            read loop,
            config,
            frame + 1u32,
            displayed
        ) {
            return 1i32;
        }
        frame = frame + 1u32;
    }
    puts("measured frame ns");
    task_print_samples(read samples);
    task_print_timings(read timings);

    if !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}
fn task_print_timings(timings: read[FlightTiming; 80]) -> unit {
    puts("frame timestamps: start prediction_start prediction_finish submitted finish");
    var i: usize = 0usize;
    while i < 80usize {
        var t: FlightTiming = timings[i];
        print_number(t.start as i64);
        print_number(t.worker.start as i64);
        print_number(t.worker.finish as i64);
        print_number(t.submitted as i64);
        print_number(t.finish as i64);
        i = i + 1usize;
    }
}
fn task_print_samples(samples: read[u64; 80]) -> unit {
    var frame: u32 = 16u32;
    while frame < 80u32 {
        print_number(samples[frame as usize] as i64);
        frame = frame + 1u32;
    }
}

fn task_check_frame_pixels(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    expected_tick: u32,
    displayed: Prediction
) -> bool {
    if loop.trial.tick != expected_tick {
        return error("timing fixture requires one simulation tick per command");
    }
    var v: *RenderState = &session.renderer.state;
    if !v -> read_pixels {
        return true;
    }
    var size: usize = (
        v -> width as usize * v -> height as usize + v -> output_width as usize * v -> output_height as usize
    ) * 4usize;
    var expected: *u8 = malloc(size);
    if expected == null(*u8) {
        return error("frame comparison allocation failed");
    }
    memcpy(expected, v -> mapped + PIXELS as isize * 4isize, size);
    displayed = prediction_visible(displayed, read loop.trial);
    game_prepare(read collision, mut session, read loop, config, read displayed);
    var good: bool = game_draw(mut session) && game_present(mut session);
    v = &session.renderer.state;
    if good && memcmp(expected, v -> mapped + PIXELS as isize * 4isize, size) != 0i32 {
        good = error("previous-prediction frame differs from synchronous rendering");
        print_number(loop.trial.tick as i64);
    }
    free(expected);
    return good;
}

fn task_check_prediction(
    scene: read CollisionScene,
    trial: read Trial,
    result: read Prediction
) -> unit {
    var forecast: Drone = new_drone();
    var expected: Prediction = predict_paths(read scene, read trial, mut forecast);
    if result.source_tick != trial.tick || result.attempt != trial.attempt || result.count != expected.count {
        trap;
    }
    var i: u32 = 0u32;
    while i < result.count {
        var a: PredictionMarker = result.markers[i as usize];
        var b: PredictionMarker = expected.markers[i as usize];
        if length(sub(a.center, b.center)) != 0f32 || a.material != b.material || a.eye.world != b.eye.world || a.eye.factor != b.eye.factor {
            trap;
        }
        i = i + 1u32;
    }
}
