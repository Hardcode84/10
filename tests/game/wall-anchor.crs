fn anchor_test_floor(scene: mut CollisionScene, basis: Basis) -> bool {
    var mesh: Mesh = mesh_new();
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_test_quad(
        mut mesh,
        vec(-100f32, 0f32, -100f32),
        vec(100f32, 0f32, -100f32),
        vec(100f32, 0f32, 100f32),
        vec(-100f32, 0f32, 100f32),
        vec(0f32, 1f32, 0f32)
    ) || !collision_append_boundary(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        basis
    ) {
        return false;
    }
    return collision_finish(move builder, mut scene);
}
fn test_anchor_hover() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position = vec(0f32, WALL_ANCHOR_RANGE * 0.9f32, 0f32);
    drone.basis = make Basis {
        right: vec(1f32, 0f32, 0f32),
        up: vec(0f32, 0f32, -1f32),
        forward: vec(0f32, 1f32, 0f32)
    };
    var command: Command = idle_command();
    command.anchor = true;
    command.burst = true;
    command.thrust.z = 1f32;
    var i: u32 = 0u32;
    while i < 120u32 {
        simulate(read scene, mut drone, command, false, true);
        i = i + 1u32;
    }
    if !game_check(
        drone.wall_anchor.active && near(drone.position.y, WALL_ANCHOR_HOVER, 0.0001f32) && dot(
            drone.basis.up,
            vec(0f32, 1f32, 0f32)
        ) > 0.99f32 && drone.bursts == 0u32 && length(drone.velocity) > WALL_ANCHOR_THRUST * 0.8f32,
        "anchor hover, camera alignment or fast tangent movement failed"
    ) {
        return false;
    }
    var before: Vec3 = drone.velocity;
    command.anchor = false;
    command.thrust = vec(0f32, 0f32, 0f32);
    simulate(read scene, mut drone, command, false, false);
    return game_check(
        !drone.wall_anchor.active && dot(before, drone.velocity) > 0f32 && length(
            drone.velocity
        ) > length(before) * 0.99f32,
        "anchor release discarded momentum"
    );
}
fn test_anchor_energy() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position.y = WALL_ANCHOR_HOVER;
    var command: Command = idle_command();
    command.anchor = true;
    var i: u32 = 0u32;
    while i < WALL_ANCHOR_ACTIVE_TICKS {
        simulate(read scene, mut drone, command, false, false);
        i = i + 1u32;
    }
    if !game_check(
        !drone.wall_anchor.active && drone.wall_anchor.recovering && drone.wall_anchor.charge == 0u32,
        "anchor did not exhaust at its active duration"
    ) {
        return false;
    }
    i = 0u32;
    while i < WALL_ANCHOR_RECHARGE_TICKS {
        simulate(read scene, mut drone, command, false, false);
        i = i + 1u32;
    }
    if !game_check(
        !drone.wall_anchor.active && !drone.wall_anchor.recovering && drone.wall_anchor.charge == wall_anchor_capacity(),
        "anchor recharge did not enforce lockout"
    ) {
        return false;
    }
    simulate(read scene, mut drone, command, false, false);
    return game_check(
        drone.wall_anchor.active,
        "held anchor did not reacquire after recharge"
    );
}
fn test_anchor_boundaries() -> bool {
    var scene: CollisionScene = collision_new();
    var mesh: Mesh = mesh_new();
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_test_aperture(mut mesh, 8u32) || !collision_append_boundary(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var hit: BoundaryContact = collision_boundary_near(
        read scene,
        0u32,
        vec(0f32, 0f32, WALL_ANCHOR_HOVER),
        WALL_ANCHOR_RANGE
    );
    if !game_check(!hit.found, "anchor caught an open portal rim") {
        return false;
    }
    var prop: Mesh = mesh_new();
    builder = collision_builder_new();
    if !static_solid(
        mut prop,
        solid(vec(-1f32, -1f32, -1f32), vec(1f32, 1f32, 1f32), 0u32),
        63u32
    ) || !collision_append_solid(
        mut builder,
        read prop,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    hit = collision_boundary_near(
        read scene,
        0u32,
        vec(0f32, 0f32, WALL_ANCHOR_HOVER),
        WALL_ANCHOR_RANGE
    );
    return game_check(!hit.found, "anchor selected a solid prop");
}
fn test_anchor_scaled_frame() -> bool {
    var basis: Basis = collision_test_basis();
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, basis) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    var size: Rational = rational_new(2u64, 1u64);
    rational_swap(mut drone.size, mut size);
    drone.position = scale(basis.up, WALL_ANCHOR_HOVER * 2f32);
    var command: Command = idle_command();
    command.anchor = true;
    simulate(read scene, mut drone, command, false, false);
    return game_check(
        drone.wall_anchor.active && near(
            dot(drone.position, basis.up),
            WALL_ANCHOR_HOVER * 2f32,
            0.0001f32
        ) && dot(drone.wall_anchor.normal, basis.up) > 0.99f32,
        "anchor ignored room orientation or body scale"
    );
}
fn test_anchor_winch() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.position = vec(0f32, WALL_ANCHOR_HOVER, 0f32);
    drone.wall_anchor.enabled = true;
    wall_anchor_step(read scene, mut drone, true);
    drone.cable.phase = CABLE_ATTACHED;
    drone.cable.anchor = vec(10f32, 0f32, 0f32);
    drone.cable.extent = length(sub(drone.position, drone.cable.anchor));
    drone.cable.reeling = true;
    collision_require_complete(powered_winch(read scene, mut drone));
    if !game_check(
        near(drone.position.y, WALL_ANCHOR_HOVER, 0.0001f32) && absf(drone.velocity.y) < 0.0001f32 && drone.velocity.x > 0f32 && drone.position.x > 0f32,
        "winch did not act along anchor plane"
    ) {
        return false;
    }
    drone.cable.anchor = vec(drone.position.x, 0f32, 0f32);
    drone.cable.extent = WALL_ANCHOR_HOVER;
    collision_require_complete(powered_winch(read scene, mut drone));
    return game_check(
        near(drone.cable.extent, WALL_ANCHOR_HOVER, 0.0001f32) && near(
            drone.position.y,
            WALL_ANCHOR_HOVER,
            0.0001f32
        ),
        "perpendicular winch crossed the hover plane"
    );
}
fn test_wall_anchor() -> bool {
    return test_anchor_preview_edge() && test_anchor_surface_query() && test_anchor_tunnel_tracking() && test_anchor_camera_rate() && test_anchor_hover() && test_anchor_energy() && test_anchor_boundaries() && test_anchor_scaled_frame() && test_anchor_winch() && test_anchor_forces() && test_anchor_prediction() && test_anchor_portal() && test_anchor_occlusion();
}

fn test_anchor_forces() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) || !collision_place_room(
        mut scene,
        0u32,
        vec(800f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position.y = WALL_ANCHOR_HOVER;
    drone.velocity = vec(3f32, 0f32, 4f32);
    var acceleration: Vec3 = flight_acceleration(
        collision_room_frame(read scene, 0u32),
        drone.position,
        drone.velocity,
        true
    );
    var expected: Vec3 = add(
        drone.velocity,
        scale(wall_tangent(acceleration, vec(0f32, 1f32, 0f32)), STEP)
    );
    var command: Command = idle_command();
    command.burst = true;
    command = movement_command(command, true);
    if !game_check(
        command.anchor && !command.burst && (command_flags(command) & 128u32) != 0u32,
        "anchor input mapping or recording flag lost"
    ) {
        return false;
    }
    simulate(read scene, mut drone, command, true, false);
    return game_check(
        length(sub(drone.velocity, expected)) < 0.00001f32,
        "anchor suppressed tangential gravity or Coriolis"
    );
}
fn test_anchor_prediction() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) {
        return false;
    }
    var trial: Trial = new_trial();
    trial.drone.wall_anchor.enabled = true;
    trial.drone.position.y = WALL_ANCHOR_HOVER;
    trial.drone.velocity.z = 5f32;
    wall_anchor_step(read scene, mut trial.drone, true);
    var predicted: Drone = new_drone();
    var expected: Drone = clone_drone(read trial.drone);
    var prediction: Prediction = prediction_new();
    var doors: DoorSet = doors_new();
    predict_drone(
        read scene,
        mut prediction,
        read trial,
        mut predicted,
        PREVIEW_MARKERS,
        mut doors
    );
    var command: Command = idle_command();
    command.anchor = true;
    var i: u32 = 0u32;
    while i < PREDICTION_TICKS {
        simulate(read scene, mut expected, command, trial.full_spin, trial.auto_level);
        i = i + 1u32;
    }
    return game_check(
        prediction.admission.status == 0u32 && length(
            sub(predicted.position, expected.position)
        ) == 0f32 && predicted.wall_anchor.charge == expected.wall_anchor.charge && predicted.wall_anchor.active == expected.wall_anchor.active,
        "prediction did not retain anchor state and held input"
    );
}
fn test_anchor_portal() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_portals(mut scene) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position = vec(0f32, WALL_ANCHOR_HOVER, -0.1f32);
    drone.velocity = vec(0f32, 0f32, 8f32);
    wall_anchor_step(read scene, mut drone, true);
    if !game_check(drone.wall_anchor.active, "portal fixture did not acquire its floor") {
        return false;
    }
    var frame: SpaceTransform = collision_portal(read scene, 0u32).transform;
    move_drone_interval(read scene, mut drone, vec(0f32, 0f32, 0.2f32), STEP);
    wall_anchor_step(read scene, mut drone, true);
    return game_check(
        drone.world == 1u32 && drone.wall_anchor.active && drone.wall_anchor.held && dot(
            drone.wall_anchor.normal,
            frame.basis.up
        ) > 0.999f32 && dot(drone.wall_anchor.up, frame.basis.up) > 0.999f32 && near(
            length(drone.velocity),
            8f32,
            0.0001f32
        ),
        "portal crossing interrupted continuous wall tracking"
    );

}

fn anchor_test_portals(scene: mut CollisionScene) -> bool {
    var builder: CollisionBuilder = collision_builder_new();
    var mesh: Mesh = mesh_new();
    var frame: SpaceTransform = space_identity();
    frame.basis = collision_test_basis();
    if !collision_test_quad(
        mut mesh,
        vec(-100f32, 0f32, -100f32),
        vec(100f32, 0f32, -100f32),
        vec(100f32, 0f32, 100f32),
        vec(-100f32, 0f32, 100f32),
        vec(0f32, 1f32, 0f32)
    ) || !collision_append_boundary(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) || !collision_append_boundary(
        mut builder,
        read mesh,
        1u32,
        vec(0f32, 0f32, 0f32),
        frame.basis
    ) {
        return false;
    }
    var portal: CollisionPortal = make CollisionPortal {
        support_bound: 0f32,
        source_scale: scale_identity(),
        target_scale: scale_identity(),
        reverse: 1u32,
        space: 0u32,
        destination: 1u32,
        origin: vec(0f32, WALL_ANCHOR_HOVER, 0f32),
        basis: identity_basis(),
        radius: 6f32,
        sides: 6u32,
        phase: 0f32,
        transform: frame
    };
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    portal.reverse = 0u32;
    portal.space = 1u32;
    portal.destination = 0u32;
    portal.basis.right = vec(-1f32, 0f32, 0f32);
    portal.basis.forward = vec(0f32, 0f32, -1f32);
    portal.origin = space_point(frame, portal.origin);
    portal.basis = space_basis(frame, portal.basis);
    portal.transform = space_inverse(frame);
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    return collision_finish(move builder, mut scene);
}

fn test_anchor_occlusion() -> bool {
    var mesh: Mesh = mesh_new();
    var prop: Mesh = mesh_new();
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    if !collision_test_quad(
        mut mesh,
        vec(-10f32, 0f32, -10f32),
        vec(10f32, 0f32, -10f32),
        vec(10f32, 0f32, 10f32),
        vec(-10f32, 0f32, 10f32),
        vec(0f32, 1f32, 0f32)
    ) || !collision_append_boundary(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) || !static_solid(
        mut prop,
        solid(vec(-1f32, 1f32, -1f32), vec(1f32, 2f32, 1f32), 0u32),
        63u32
    ) || !collision_append_solid(
        mut builder,
        read prop,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position.y = WALL_ANCHOR_RANGE * 0.9f32;
    var command: Command = idle_command();
    command.anchor = true;
    simulate(read scene, mut drone, command, false, false);
    return game_check(
        !drone.wall_anchor.active,
        "anchor reached a hull wall through a solid prop"
    );
}

fn anchor_test_tube(scene: mut CollisionScene) -> bool {
    var mesh: Mesh = mesh_new();
    var builder: CollisionBuilder = collision_builder_new();
    var i: u32 = 0u32;
    while i < 6u32 {
        var a: f32 = i as f32 * PI / 3f32;
        var b: f32 = (i + 1u32) as f32 * PI / 3f32;
        var p: Vec3 = vec(WALL_ANCHOR_RANGE * cosf(a), WALL_ANCHOR_RANGE * sinf(a), 0f32);
        var q: Vec3 = vec(WALL_ANCHOR_RANGE * cosf(b), WALL_ANCHOR_RANGE * sinf(b), 0f32);
        var normal: Vec3 = unit_vector(scale(add(p, q), -1f32));
        if !collision_test_quad(
            mut mesh,
            add(p, vec(0f32, 0f32, -100f32)),
            add(q, vec(0f32, 0f32, -100f32)),
            add(q, vec(0f32, 0f32, 100f32)),
            add(p, vec(0f32, 0f32, 100f32)),
            normal
        ) {
            return false;
        }
        i = i + 1u32;
    }
    if !collision_append_boundary(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    return collision_finish(move builder, mut scene);
}
fn test_anchor_tunnel_tracking() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_tube(mut scene) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.wall_anchor.enabled = true;
    drone.position = vec(0.5f32, 0.2f32, 0f32);
    drone.velocity = vec(0f32, 1f32, 2f32);
    var command: Command = idle_command();
    command.anchor = true;
    var changes: u32 = 0u32;
    var normal: Vec3 = vec(0f32, 0f32, 0f32);
    var i: u32 = 0u32;
    while i < 180u32 {
        simulate(read scene, mut drone, command, false, false);
        if !drone.wall_anchor.active {
            return game_check(false, "anchor dropped inside a continuous tunnel");
        }
        if i > 0u32 && dot(normal, drone.wall_anchor.normal) < 0.9f32 {
            changes = changes + 1u32;
        }
        normal = drone.wall_anchor.normal;
        i = i + 1u32;
    }
    return game_check(
        changes == 0u32,
        "anchor switched tunnel walls while its surface remained reachable"
    );
}
fn test_anchor_camera_rate() -> bool {
    var drone: Drone = new_drone();
    drone.wall_anchor.active = true;
    drone.wall_anchor.normal = vec(0f32, -1f32, 0f32);
    var before: Basis = drone.basis;
    wall_anchor_orient(mut drone, vec(0f32, 0f32, 0f32));
    if !game_check(
        dot(before.up, drone.basis.up) > cosf(WALL_ANCHOR_ALIGN_RATE * STEP * 1.01f32) && dot(
            before.up,
            drone.basis.up
        ) < 1f32,
        "anchor camera snapped or did not begin to align"
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < 180u32 {
        wall_anchor_orient(mut drone, vec(0f32, 0f32, 0f32));
        i = i + 1u32;
    }
    return game_check(
        dot(drone.basis.up, drone.wall_anchor.normal) > 0.999f32,
        "anchor camera did not converge"
    );
}

fn test_anchor_surface_query() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_tube(mut scene) {
        return false;
    }
    var position: Vec3 = vec(0.1f32, 0.2f32, 0f32);
    var query: BoundaryQuery = collision_boundary_begin(
        read scene,
        0u32,
        position,
        WALL_ANCHOR_RANGE,
        vec(0f32, 0f32, 0f32)
    );
    var closest: BoundaryContact = collision_boundary_near(
        read scene,
        0u32,
        position,
        WALL_ANCHOR_RANGE
    );
    var distance: f32 = WALL_ANCHOR_RANGE;
    var count: u32 = 0u32;
    while true {
        var hit: BoundaryContact = collision_boundary_next(read scene, mut query);
        if !hit.found {
            break;
        }
        if !game_check(
            hit.distance < WALL_ANCHOR_RANGE && hit.distance >= 0f32 && near(
                length(sub(hit.point, position)),
                hit.distance,
                0.00001f32
            ),
            "boundary preview yielded an unreachable surface"
        ) {
            return false;
        }
        if hit.distance < distance {
            distance = hit.distance;
        }
        count = count + 1u32;
        if !game_check(count <= 12u32, "boundary preview failed to advance") {
            return false;
        }
    }
    return game_check(
        count > 1u32 && closest.found && distance == closest.distance,
        "boundary preview and anchor disagree on nearby surfaces"
    );
}

fn test_anchor_preview_edge() -> bool {
    var scene: CollisionScene = collision_new();
    if !anchor_test_floor(mut scene, identity_basis()) {
        return false;
    }
    var p: Vec3 = vec(100.5f32, 0.5f32, 0f32);
    var hit: BoundaryContact = collision_boundary_near(read scene, 0u32, p, 2f32);
    var query: BoundaryQuery = collision_boundary_begin(
        read scene,
        0u32,
        p,
        2f32,
        vec(0f32, 0f32, 0f32)
    );
    var nearby: BoundaryContact = collision_boundary_nearby(read scene, mut query);
    if !game_check(
        !hit.found && nearby.found,
        "preview required immediate attachment instead of sphere overlap"
    ) {
        return false;
    }
    query = collision_boundary_begin(read scene, 0u32, p, 0.25f32, vec(0f32, 0f32, 0f32));
    nearby = collision_boundary_nearby(read scene, mut query);
    return game_check(!nearby.found, "preview included a surface outside its radius");
}
