extern fn latency_push(event: *u8) -> bool = "SDL_PushEvent";
extern fn latency_pump() -> unit = "SDL_PumpEvents";
fn latency_window_ready(window: *u8) -> bool {
    var deadline: u64 = now() + 5000000000u64;
    while now() < deadline {
        latency_pump();
        if app_focused(window) {
            return true;
        }
        app_sleep(1u32);
    }
    return error("latency measurement requires keyboard focus");
}
record InputProducer {
    due: [u64; 32];
    queued: [u64; 32];
}
fn latency_wait_until(deadline: u64) -> unit {
    while now() < deadline {
        app_sleep(1u32);
    }
}
fn latency_push_key(kind: u32) -> unit {
    var event: [u64; 16] = uninit;
    zero(&event as *u8, sizeof([u64; 16]));
    (&event as *u32)[0usize] = kind;
    (&event as *u8)[36usize] = (kind == 768u32) as u8;
    (&event as *u32)[6usize] = 15u32;
    (&event as *u32)[7usize] = 108u32;
    if !latency_push(&event as *u8) {
        error(SDL_GetError());
        exit(1i32);
    }
}
fn latency_produce(data: *u8) -> bool {
    var producer: *InputProducer = data as *InputProducer;
    var start: u64 = now() + 500000000u64;
    var i: usize = 0usize;
    while i < 32usize {
        producer -> due[i] = start + i as u64 * 103700000u64;
        latency_wait_until(producer -> due[i]);
        producer -> queued[i] = now();
        latency_push_key(768u32);
        latency_push_key(769u32);
        i = i + 1usize;
    }
    latency_wait_until(now() + 500000000u64);
    var event: [u64; 16] = uninit;
    zero(&event as *u8, sizeof([u64; 16]));
    (&event as *u32)[0usize] = 256u32;
    if !latency_push(&event as *u8) {
        error(SDL_GetError());
        exit(1i32);
    }
    return true;
}
fn main(argc: i32, argv: **u8) -> i32 {
    var launch: Launch = uninit;
    if !game_options_scene(argc, argv, &launch, true) {
        return 2i32;
    }
    if launch.config.headless || launch.config.ticks != 0u32 || launch.replay_path != null(*u8) {
        error("latency measurement requires a live window and clock");
        return 2i32;
    }
    if launch.latency_path == null(*u8) {
        launch.latency_path = "build/latency-native.swlt";
    }
    return latency_run(game_session(&launch), launch.config);
}
fn latency_run(session: GameSession, config: GameConfig) -> i32 {
    var collision: CollisionScene = collision_new();
    var loop: GameLoop = make GameLoop {
        sparks: sparks_new(),
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_run_setup(mut session, mut collision, mut loop, config) {
        return 1i32;
    }
    if !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    if !latency_window_ready(session.control.window.handle) {
        return 1i32;
    }
    var producer: InputProducer = uninit;
    var service: *ExternalService = service_new();
    if service == null(*ExternalService) {
        return 1i32;
    }
    service_submit(service, latency_produce, &producer as *u8);
    var result: i32 = game_run_active(read collision, mut session, mut loop, config);
    var completed: i32 = service_poll(service);
    while completed == 0i32 {
        service_idle(service);
        completed = service_poll(service);
    }
    service_destroy(service);
    if completed < 0i32 {
        return 1i32;
    }
    if loop.ticks == 0u32 || loop.input.paused {
        error("latency measurement requires an active, unpaused simulation");
        return 1i32;
    }
    puts("input availability and timer jitter ns");
    var i: usize = 0usize;
    while i < 32usize {
        print_number(producer.queued[i] as i64);
        print_number((producer.queued[i] - producer.due[i]) as i64);
        i = i + 1usize;
    }
    return result;
}
