fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && strcmp(argv[1usize], "reel") == 0i32 {
        return (!test_reel_suite()) as i32;
    }
    if argc == 2i32 && strcmp(argv[1usize], "flight") == 0i32 {
        return (
            !(
                test_flight_pulses() && test_doors() && test_axis_attraction() && test_room_frame_bodies()
            )
        ) as i32;
    }
    if argc == 2i32 && strcmp(argv[1usize], "collision") == 0i32 {
        return (!test_reference_collision()) as i32;
    }
    if argc == 1i32 {
        return (!game_tests()) as i32;
    }
    error("game checks accept flight or reel");
    return 2i32;
}
