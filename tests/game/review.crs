fn review_run(session: GameSession, config: GameConfig) -> i32 {
    var collision: CollisionScene = collision_new();
    if !collision_build_game(mut collision) {
        return 1i32;
    }
    var input: InputState = input_new();
    if !game_open(mut session, mut input) {
        return 1i32;
    }
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        game_palette(mut inputs);
        hud_font(mut inputs);
    }
    if !game_static_open(mut session, 1u32) {
        return 1i32;
    }
    return (!expedition_review(read collision, mut session, config)) as i32;
}
