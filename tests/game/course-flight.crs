fn test_course_flight() -> bool {
    var trial: Trial = new_trial();
    var i: u32 = 0u32;
    while i < 30000u32 && !trial.finished {
        var c: Command = pilot_command(read trial);
        trial_step(mut trial, c);
        i = i + 1u32;
    }
    game_summary(read trial);
    return game_check(
        trial.finished && trial.gate == GATE_COUNT,
        "production flight did not finish the stopped course"
    ) && test_course_spin() && test_course_geometry();
}
