fn content_axis_triangles(axis: u32, position: f32) -> u32 {
    var count: u32 = 0u32;
    var room: u32 = 0u32;
    var eye: Vec3 = scale(axis_vector(axis), position);
    while room < ROOM_COUNT {
        var instance: RoomInstance = expedition_room(room);
        var side: u32 = 0u32;
        while side < 2u32 {
            var face: u32 = axis * 2u32 + side;
            if panel_faces_eye(room_face(instance, face), face, eye) {
                count = count + prefab_wall(instance, face, expedition_open_ports(room)).count * 2u32;
            }
            side = side + 1u32;
        }
        room = room + 1u32;
    }
    var i: u32 = 0u32;
    while i < expedition_solid_count() {
        var s: Solid = world_solid(1u32, i);
        var faces: u32 = world_solid_faces(1u32, i);
        if position < component(s.low, axis) && (faces & (1u32 << (axis * 2u32))) != 0u32 {
            count = count + 2u32;
        }
        if position > component(s.high, axis) && (faces & (1u32 << (axis * 2u32 + 1u32))) != 0u32 {
            count = count + 2u32;
        }
        i = i + 1u32;
    }
    return count;
}
fn content_plane(axis: u32, index: u32) -> f32 {
    var s: Solid = solid(vec(0f32, 0f32, 0f32), vec(0f32, 0f32, 0f32), 0u32);
    if index / 2u32 < ROOM_COUNT {
        var room: RoomInstance = expedition_room(index / 2u32);
        s = solid(room.origin, add(room.origin, room.prefab.size), 0u32);
    } else {
        s = world_solid(1u32, index / 2u32 - ROOM_COUNT);
    }
    if index % 2u32 == 0u32 {
        return component(s.low, axis);
    }
    return component(s.high, axis);
}
fn content_axis_bound(axis: u32) -> u32 {
    var maximum: u32 = 0u32;
    var count: u32 = (ROOM_COUNT + expedition_solid_count()) * 2u32;
    var i: u32 = 0u32;
    while i < count {
        var position: f32 = content_plane(axis, i);
        var next: f32 = position + 10000f32;
        var j: u32 = 0u32;
        while j < count {
            var plane: f32 = content_plane(axis, j);
            if plane > position && plane < next {
                next = plane;
            }
            j = j + 1u32;
        }
        var samples: [f32; 3] = make [f32; 3] {
            position,
            (position + next) * 0.5f32,
            position - 10000f32
        };
        j = 0u32;
        while j < 3u32 {
            var triangles: u32 = content_axis_triangles(axis, samples[j as usize]);
            if triangles > maximum {
                maximum = triangles;
            }
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    return maximum;
}
fn content_triangle_bound() -> u32 {
    var maximum: u32 = content_axis_bound(0u32) + content_axis_bound(1u32) + content_axis_bound(
        2u32
    );
    maximum = maximum + 10u32 + 64u32 + 24u32 + 16u32 + 6u32;
    return maximum;
}
fn test_content_hook(position: Vec3, ceiling: f32) -> bool {
    var drone: Drone = new_drone();
    drone.world = 1u32;
    drone.position = position;
    drone.basis = make Basis {
        right: vec(1f32, 0f32, 0f32),
        up: vec(0f32, 0f32, -1f32),
        forward: vec(0f32, 1f32, 0f32)
    };
    var command: Command = idle_command();
    command.tether = true;
    var i: u32 = 0u32;
    while i < 120u32 && drone.cable.phase != CABLE_ATTACHED {
        simulate(mut drone, command, false, false);
        i = i + 1u32;
    }
    return game_check(
        drone.cable.phase == CABLE_ATTACHED && near(
            drone.cable.anchor.y,
            ceiling - HOOK_RADIUS,
            0.001f32
        ),
        "room feature must stop and attach the launched hook at its visible surface"
    );
}
fn test_content_supports() -> bool {
    var i: u32 = 0u32;
    while i < expedition_solid_count() {
        var part: RoomPart = expedition_part(i);
        var room: RoomInstance = expedition_room(part.room);
        var attached: bool = false;
        var axis: u32 = 0u32;
        while axis < 3u32 {
            var low: f32 = component(part.shape.low, axis);
            var high: f32 = component(part.shape.high, axis);
            var size: f32 = component(room.prefab.size, axis);
            if !game_check(
                low >= 0f32 && high <= size && low < high,
                "room feature must fit inside its owning prefab"
            ) {
                return false;
            }
            attached = attached || low == 0f32 || high == size;
            axis = axis + 1u32;
        }
        if !game_check(attached, "room feature must attach to its shell") {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn test_room_content() -> bool {
    var berth: Hit = course_hit(
        1u32,
        vec(0f32, 4f32, -4f32),
        vec(0f32, 0f32, 65f32),
        DRONE_RADIUS
    );
    var shaft: Hit = course_hit(
        1u32,
        vec(116f32, 16f32, 150f32),
        vec(0f32, 118f32, 0f32),
        DRONE_RADIUS
    );
    return game_check(
        berth.time > 1f32 && shaft.time > 1f32,
        "authored features must preserve the central flight lanes and connected exits"
    ) && test_content_supports() && test_content_materials() && test_content_hook(
        vec(0f32, 4f32, 18f32),
        12f32
    ) && test_content_hook(vec(105f32, 32f32, 150f32), 40f32) && test_content_hook(
        vec(127f32, 76f32, 150f32),
        84f32
    );
}
fn test_content_materials() -> bool {
    if !game_check(
        GAME_MATERIALS <= MAX_MATERIALS && MATERIAL_LIGHT + MAX_MATERIALS * 4u32 <= SPACE_LIGHT && MATERIAL_TEXTURE + MAX_MATERIALS * 64u32 <= LIT_PALETTE && LIT_PALETTE + MAX_MATERIALS * 2048u32 <= OVERLAY_CELLS,
        "material tables must fit the shared buffer layout"
    ) {
        return false;
    }
    if !game_check(
        game_material_color(0x82949du32, ANCHOR_LEDGE_MATERIAL, 3u32, 0u32) == game_material_color(
            0x82949du32,
            ANCHOR_LEDGE_MATERIAL,
            3u32,
            511u32
        ),
        "anchor ledge marks must remain visible without local light"
    ) {
        return false;
    }
    var dark: u32 = game_material_color(0x9a9992u32, SERVICE_CABINET_MATERIAL, 3u32, 0u32);
    var lit: u32 = game_material_color(0x9a9992u32, SERVICE_CABINET_MATERIAL, 3u32, 511u32);
    if !game_check(
        dark == lit,
        "service indicator texels must remain full bright without lighting the surface"
    ) {
        return false;
    }
    dark = game_material_color(0x5a767eu32, STRUCTURAL_RIB_MATERIAL, 3u32, 0u32);
    lit = game_material_color(0x5a767eu32, STRUCTURAL_RIB_MATERIAL, 3u32, 511u32);
    return game_check(
        dark != lit,
        "structural edges must use lighting instead of glowing in darkness"
    );
}
