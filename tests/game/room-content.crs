fn test_content_hook(position: Vec3, ceiling: f32) -> bool {
    var drone: Drone = new_drone();
    drone.world = 1u32;
    drone.position = position;
    drone.basis = make Basis {
        right: vec(1f32, 0f32, 0f32),
        up: vec(0f32, 0f32, -1f32),
        forward: vec(0f32, 1f32, 0f32)
    };
    var command: Command = idle_command();
    command.tether = true;
    var i: u32 = 0u32;
    while i < 120u32 && drone.cable.phase != CABLE_ATTACHED {
        simulate(mut drone, command, false, false);
        i = i + 1u32;
    }
    return game_check(
        drone.cable.phase == CABLE_ATTACHED && near(
            drone.cable.anchor.y,
            ceiling - HOOK_RADIUS,
            0.001f32
        ),
        "room feature must stop and attach the launched hook at its visible surface"
    );
}
fn test_content_supports() -> bool {
    var i: u32 = 0u32;
    while i < expedition_solid_count() {
        var part: RoomPart = expedition_part(i);
        var room: RoomInstance = expedition_room(part.room);
        var attached: bool = false;
        var axis: u32 = 0u32;
        while axis < 3u32 {
            var low: f32 = component(part.shape.low, axis);
            var high: f32 = component(part.shape.high, axis);
            var size: f32 = component(room.prefab.size, axis);
            if !game_check(
                low >= 0f32 && high <= size && low < high,
                "room feature must fit inside its owning prefab"
            ) {
                return false;
            }
            attached = attached || low == 0f32 || high == size;
            axis = axis + 1u32;
        }
        if !game_check(attached, "room feature must attach to its shell") {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn test_room_content() -> bool {
    var berth: Hit = course_hit(
        1u32,
        vec(0f32, 4f32, -4f32),
        vec(0f32, 0f32, 65f32),
        DRONE_RADIUS
    );
    var shaft: Hit = course_hit(
        1u32,
        vec(116f32, 16f32, 150f32),
        vec(0f32, 118f32, 0f32),
        DRONE_RADIUS
    );
    return game_check(
        berth.time > 1f32 && shaft.time > 1f32,
        "authored features must preserve the central flight lanes and connected exits"
    ) && test_content_supports() && test_content_materials() && test_content_hook(
        vec(0f32, 4f32, 18f32),
        12f32
    ) && test_content_hook(vec(105f32, 32f32, 150f32), 40f32) && test_content_hook(
        vec(127f32, 76f32, 150f32),
        84f32
    );
}
fn test_content_materials() -> bool {
    if !game_check(
        GAME_MATERIALS * 4u32 <= PALETTE_COLORS,
        "game colour groups must fit their shared palette"
    ) {
        return false;
    }
    if !game_check(
        game_material_color(0x82949du32, ANCHOR_LEDGE_MATERIAL, 3u32, 0u32) == game_material_color(
            0x82949du32,
            ANCHOR_LEDGE_MATERIAL,
            3u32,
            511u32
        ),
        "anchor ledge marks must remain visible without local light"
    ) {
        return false;
    }
    var dark: u32 = game_material_color(0x9a9992u32, SERVICE_CABINET_MATERIAL, 3u32, 0u32);
    var lit: u32 = game_material_color(0x9a9992u32, SERVICE_CABINET_MATERIAL, 3u32, 511u32);
    if !game_check(
        dark == lit,
        "service indicator texels must remain full bright without lighting the surface"
    ) {
        return false;
    }
    dark = game_material_color(0x5a767eu32, STRUCTURAL_RIB_MATERIAL, 3u32, 0u32);
    lit = game_material_color(0x5a767eu32, STRUCTURAL_RIB_MATERIAL, 3u32, 511u32);
    return game_check(
        dark != lit,
        "structural edges must use lighting instead of glowing in darkness"
    );
}
