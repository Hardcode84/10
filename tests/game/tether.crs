fn attached_test_drone(collision: read CollisionScene) -> Drone {
    var d: Drone = new_drone();
    d.position = vec(0f32, 4f32, 35f32);
    var command: Command = idle_command();
    command.tether = true;
    var i: u32 = 0u32;
    while i < 120u32 && d.cable.phase != CABLE_ATTACHED {
        simulate(read collision, mut d, command, false, true);
        i = i + 1u32;
    }
    return d;
}
fn test_tether(collision: read CollisionScene) -> bool {
    var d: Drone = attached_test_drone(read collision);
    if !game_check(
        d.cable.phase == CABLE_ATTACHED && near(d.cable.anchor.z, 55f32, 0.001f32),
        "tether projectile did not attach to the spoke"
    ) {
        return false;
    }
    d.velocity = vec(0f32, 0f32, -100f32);
    var command: Command = idle_command();
    command.tether = true;
    simulate(read collision, mut d, command, false, true);
    if !game_check(
        d.cable.phase == CABLE_ATTACHED && length(sub(d.position, d.cable.anchor)) <= d.cable.extent + 0.001f32 && d.velocity.z >= -0.001f32,
        "fast outward motion must stop at cable length without breaking"
    ) {
        return false;
    }
    simulate(read collision, mut d, idle_command(), false, true);
    return game_check(d.cable.phase == CABLE_READY, "attached tether release failed");
}
fn test_swing(collision: read CollisionScene) -> bool {
    var drone: Drone = attached_test_drone(read collision);
    drone.velocity = vec(40f32, 0f32, 0f32);
    var c: Command = idle_command();
    c.tether = true;
    var i: u32 = 0u32;
    while i < 600u32 {
        simulate(read collision, mut drone, c, true, true);
        if drone.cable.phase != CABLE_ATTACHED || length(
            sub(drone.position, drone.cable.anchor)
        ) > drone.cable.extent + 0.001f32 {
            return game_check(false, "fast swing violated cable length or broke");
        }
        i = i + 1u32;
    }
    return true;
}
fn test_blocked_winch(collision: read CollisionScene) -> bool {
    var drone: Drone = attached_test_drone(read collision);
    drone.position = vec(0f32, 4f32, 70f32);
    drone.velocity = vec(0f32, 0f32, 0f32);
    var c: Command = idle_command();
    c.tether = true;
    c.reel = true;
    var i: u32 = 0u32;
    while i < 600u32 {
        simulate(read collision, mut drone, c, false, true);
        if drone.cable.phase != CABLE_ATTACHED || drone.position.z < 61.35f32 || length(
            sub(drone.position, drone.cable.anchor)
        ) > drone.cable.extent + 0.001f32 {
            return game_check(
                false,
                "cable through structure must remain attached and keep the player outside solids"
            );
        }
        i = i + 1u32;
    }
    return game_check(
        near(drone.position.z, 61.3501f32, 0.001f32) && absf(drone.cable.reel_speed) < 0.001f32,
        "winch must stall at contact without shortening the cable through the player"
    ) && test_reel_contact();
}
fn test_winch(collision: read CollisionScene) -> bool {
    var drone: Drone = attached_test_drone(read collision);
    var c: Command = idle_command();
    c.tether = true;
    c.reel = true;
    var old: f32 = drone.cable.extent;
    simulate(read collision, mut drone, c, false, true);
    if !game_check(
        drone.cable.reeling && near(old - drone.cable.extent, REEL_SPEED * STEP, 0.001f32) && drone.velocity.z > 39f32,
        "reel press must immediately pull at full speed"
    ) {
        return false;
    }
    c.reel = false;
    old = drone.cable.extent;
    simulate(read collision, mut drone, c, false, true);
    if !game_check(
        drone.cable.reeling && drone.cable.extent < old - 0.3f32,
        "releasing the reel button must not stop reeling"
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < 240u32 {
        simulate(read collision, mut drone, c, false, true);
        i = i + 1u32;
    }
    if !game_check(
        drone.cable.phase == CABLE_ATTACHED && drone.cable.reeling && near(
            drone.cable.extent,
            0.75f32,
            0.001f32
        ) && drone.winch_work > 0f32,
        "latched winch must keep pulling to minimum length"
    ) {
        return false;
    }
    simulate(read collision, mut drone, idle_command(), false, true);
    return game_check(
        !drone.cable.reeling && drone.cable.phase == CABLE_READY,
        "hook release must clear the reel latch"
    ) && test_blocked_winch(read collision) && test_reel_input() && test_armed_winch(
        read collision
    );
}
fn test_reel_input() -> bool {
    var input: InputState = input_new();
    input.pulses[9usize] = 1u32;
    input_commands(mut input, 0f32, 0f32);
    var c: Command = input_consume(mut input);
    var again: Command = input_consume(mut input);
    if !game_check(
        c.reel && !again.reel,
        "short reel press must survive until consumed once"
    ) {
        return false;
    }
    input.values[8usize] = 1f32;
    input.values[4usize] = 1f32;
    input.values[5usize] = 1f32;
    input_commands(mut input, 0f32, 0f32);
    c = input_consume(mut input);
    return game_check(
        c.reel && c.tether && c.thrust.y == -1f32,
        "tethered up must start reeling and down must remain thrust"
    );
}
fn test_armed_winch(collision: read CollisionScene) -> bool {
    var drone: Drone = new_drone();
    drone.position = vec(0f32, 4f32, 35f32);
    var c: Command = idle_command();
    c.tether = true;
    c.reel = true;
    simulate(read collision, mut drone, c, false, true);
    if !game_check(
        drone.cable.phase == CABLE_FLYING && drone.cable.reeling,
        "reel press during flight must arm the pull"
    ) {
        return false;
    }
    c.reel = false;
    var i: u32 = 0u32;
    while drone.cable.phase == CABLE_FLYING && i < 120u32 {
        simulate(read collision, mut drone, c, false, true);
        i = i + 1u32;
    }
    return game_check(
        drone.cable.phase == CABLE_ATTACHED && drone.cable.reeling && drone.velocity.z > 39f32,
        "armed reel must pull immediately on contact"
    );
}

fn test_reel_contact_case(frame: SpaceTransform) -> bool {
    var scene: CollisionScene = collision_new();
    var mesh: Mesh = mesh_new();
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_test_box(
        mut mesh,
        vec(-5f32, -5f32, -1f32),
        vec(5f32, 5f32, 0f32)
    ) || !collision_append_solid(mut builder, read mesh, 0u32, frame.origin, frame.basis) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var drone: Drone = new_drone();
    drone.position = space_point(frame, vec(0f32, 0f32, -2f32));
    var contact: CollisionContact = collision_sweep(
        read scene,
        0u32,
        drone.position,
        basis_vector(frame.basis, vec(0f32, 0f32, 2f32)),
        HOOK_RADIUS
    );
    if !game_check(contact.hit.time <= 1f32, "reel fixture must attach to the wall") {
        return false;
    }
    hook_attach(read scene, mut drone, contact, 0f32, 0f32);
    // A cable through a wall can request an unreachable position. Collision
    // must finish without feeding the rejected pull back into the slide.
    drone.position = space_point(frame, vec(0f32, 0f32, 0.3501f32));
    drone.velocity = vec(0f32, 0f32, 0f32);
    drone.cable.extent = 1.34f32;
    move_drone(read scene, mut drone, vec(0f32, 0f32, 0f32));
    var command: Command = idle_command();
    command.tether = true;
    command.reel = true;
    var i: u32 = 0u32;
    while i < 60u32 {
        simulate(read scene, mut drone, command, false, false);
        if !game_check(
            collision_position_valid(read scene, 0u32, drone.position, DRONE_RADIUS),
            "reeling must preserve wall separation"
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return game_check(
        drone.cable.phase == CABLE_ATTACHED && drone.cable.extent <= 1.34f32 && absf(
            drone.cable.reel_speed
        ) < 0.001f32,
        "blocked reeling must stall without extending the cable"
    );
}
fn test_reel_contact() -> bool {
    return test_reel_contact_case(space_identity()) && test_reel_contact_case(
        make SpaceTransform {
            origin: vec(-12f32, 9f32, 37f32),
            basis: collision_test_basis()
        }
    );
}
fn test_reel_suite() -> bool {
    var scene: CollisionScene = collision_new();
    if !collision_build_game(mut scene) {
        return false;
    }
    return test_winch(read scene) && test_swing(read scene);
}
