extern fn SDL_PushEvent(event: *u8) -> i32 = "SDL_PushEvent";
fn playback_key(key: u32, repeat: u8) -> bool {
    var event: [u64; 8] = uninit;
    zero(&event as *u8, sizeof([u64; 8]));
    (&event as *u32)[0usize] = 768u32;
    (&event as *u8)[12usize] = 1u8;
    (&event as *u8)[13usize] = repeat;
    (&event as *u32)[5usize] = key;
    if SDL_PushEvent(&event as *u8) != 1i32 {
        return error(SDL_GetError());
    }
    return true;
}
fn playback_checks() -> bool {
    var p: Playback = make Playback {
        frame: 504u32,
        paused: false,
        running: true
    };
    if !playback_next(mut p) || p.frame != 505u32 || p.paused {
        return error("automatic playback did not advance one frame");
    }
    if !playback_key(32u32, 0u8) || !playback_key(32u32, 1u8) || !playback_key(
        1073741904u32,
        0u8
    ) || !playback_next(mut p) || p.frame != 504u32 || !p.paused {
        return error("pause and backward step did not preserve the displayed frame");
    }
    if !playback_key(1073741903u32, 1u8) || !playback_key(1073741903u32, 0u8) || !playback_key(
        1073741903u32,
        0u8
    ) || !playback_next(mut p) || p.frame != 505u32 || !p.paused || !playback_next(mut p) || p.frame != 506u32 || !p.paused {
        return error("each forward key press must produce exactly one paused frame");
    }
    if !playback_key(32u32, 0u8) || !playback_next(mut p) || p.frame != 507u32 || p.paused {
        return error("resume did not advance one frame");
    }
    if !playback_key(1073741904u32, 0u8) || !playback_next(mut p) || p.frame != 506u32 || !p.paused {
        return error("step during playback did not pause");
    }
    p.frame = 0u32;
    if !playback_key(1073741904u32, 0u8) || !playback_key(1073741903u32, 0u8) || !playback_next(
        mut p
    ) || p.frame != 1u32 || !p.paused {
        return error("backward step at zero changed the frame");
    }
    var quit: [u64; 8] = uninit;
    zero(&quit as *u8, sizeof([u64; 8]));
    (&quit as *u32)[0usize] = 256u32;
    if SDL_PushEvent(&quit as *u8) != 1i32 {
        return error(SDL_GetError());
    }
    if !playback_next(mut p) || p.running || p.frame != 1u32 {
        return error("quit while paused failed");
    }
    return true;
}
fn playback_test() -> bool {
    if SDL_Init(16384u32) != 0i32 {
        return error(SDL_GetError());
    }
    var good: bool = playback_checks();
    SDL_Quit();
    if good {
        puts("playback event checks passed");
    }
    return good;
}
