fn scaling_render_scene(scene: mut CollisionScene, factor: ScaleRatio) -> bool {
    var builder: CollisionBuilder = collision_builder_new();
    var transform: SpaceTransform = make SpaceTransform {
        factor: scale_float(factor),
        origin: vec(7f32, 2f32, -5f32),
        basis: make Basis {
            right: vec(0f32, 0f32, 1f32),
            up: vec(0f32, 1f32, 0f32),
            forward: vec(-1f32, 0f32, 0f32)
        }
    };
    var portal: CollisionPortal = make CollisionPortal {
        support_bound: 0f32,
        source_scale: scale_identity(),
        target_scale: factor,
        reverse: 1u32,
        space: 0u32,
        destination: 1u32,
        origin: vec(0f32, 0f32, 0f32),
        basis: identity_basis(),
        radius: 3f32,
        sides: 6u32,
        phase: 0f32,
        transform: transform
    };
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    portal.reverse = 0u32;
    portal.space = 1u32;
    portal.destination = 0u32;
    portal.origin = transform.origin;
    portal.radius = portal.radius * scale_float(factor);
    portal.basis = space_basis(
        transform,
        make Basis {
            right: vec(-1f32, 0f32, 0f32),
            up: vec(0f32, 1f32, 0f32),
            forward: vec(0f32, 0f32, -1f32)
        }
    );
    portal.transform = space_inverse(transform);
    portal.target_scale = scale_inverse(factor);
    if !collision_portal_append(mut builder, portal) {
        return false;
    }
    return collision_finish(move builder, mut scene);
}
fn scaling_render_input(scene: read CollisionScene, input: mut FrameInput) -> unit {
    var anchors: RoomAnchors = room_anchors_new();
    game_palette(mut input);
    input_frame(mut input);
    render_portals(mut input, read scene);
    input_set_word(mut input, 20usize, 0u32);
    input_set_word(mut input, 4usize, 2u32);
    input_set_word(mut input, BACKGROUND as usize, 0xff123456u32);
    input_set_float(mut input, RENDER_STYLE as usize, 0.04f32);
    input_set_float(mut input, PROJECTION as usize, 1f32);
    input_set_float(mut input, CAMERA_LIGHT as usize, 0f32);
    var eye: Vec3 = vec(0f32, 0f32, -4f32);
    camera_row(mut input, 0usize, vec(1f32, 0f32, 0f32), eye);
    camera_row(mut input, 4usize, vec(0f32, 1f32, 0f32), eye);
    camera_row(mut input, 8usize, vec(0f32, 0f32, 1f32), eye);
    quad(
        mut input,
        0u32,
        0u32,
        1u32,
        0u32,
        -2f32,
        -2f32,
        0f32,
        2f32,
        -2f32,
        0f32,
        2f32,
        2f32,
        0f32,
        -2f32,
        2f32,
        0f32
    );
    scaling_render_wall(read scene, mut input);
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    var light: LightObject = make LightObject {
        id: 0u32,
        space: 0u32,
        position: vec(0f32, 0f32, -1f32),
        colour: vec(2f32, 1.6f32, 0.1f32),
        radius: 6f32,
        mode: LIGHT_UNSHADOWED
    };
    light_object_anchors(read scene, mut input, light, mut anchors);
}
fn scaling_image_hash(renderer: read Renderer) -> u64 {
    var pixels: *u32 = renderer.state.mapped as *u32;
    var hash: u64 = 14695981039346656037u64;
    var changed: u32 = 0u32;
    var i: u32 = 0u32;
    while i < 320u32 * 240u32 {
        var pixel: u32 = pixels[(PIXELS + i) as usize];
        hash = (hash ^ pixel as u64) * 1099511628211u64;
        changed = changed + (pixel != 0xff123456u32) as u32;
        i = i + 1u32;
    }
    if changed == 0u32 {
        error("scaled portal image contains no geometry");
        trap;
    }
    return hash;
}
fn main(argc: i32, argv: **u8) -> i32 {
    var launch: Launch = uninit;
    if !game_options(argc, argv, &launch) {
        return 1i32;
    }
    launch.config.width = 320u32;
    launch.config.height = 240u32;
    launch.shader_checks = true;
    launch.capture = "build/scaling-check.ppm";
    var renderer: Renderer = renderer_new();
    if !game_renderer_open(&renderer.state, &launch, null(*u8), 2u32) {
        return 1i32;
    }
    if !scaling_flight_fixture() {
        return 1i32;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !prediction_attachment(mut input, false) || !prediction_attachment(mut input, true) {
            return 1i32;
        }
    }
    if !scaling_render_checks(mut renderer) {
        return 1i32;
    }
    if !prediction_view_checks(mut renderer, launch.config) || !scaling_bounds_reject(
        mut renderer
    ) {
        return 1i32;
    }
    puts("Scaled portal geometry and propagated light images match identity.");
    return 0i32;
}

fn scaling_flight_fixture() -> bool {
    var graph: RoomGraph = graph_new();
    var mesh: Mesh = mesh_new();
    var scene: CollisionScene = collision_new();
    var trial: Trial = new_trial();
    if !scaling_graph(mut graph) || !graph_assemble(mut graph, mut scene, mut mesh, mut trial) {
        return false;
    }
    hook_launch(mut trial.drone);
    var i: u32 = 0u32;
    while i < 40u32 && trial.drone.cable.phase == CABLE_FLYING {
        hook_step(read scene, mut trial.drone, false);
        trial.drone.clock = trial.drone.clock + 1u32;
        i = i + 1u32;
    }
    if trial.drone.cable.phase != CABLE_ATTACHED || trial.drone.cable.space != 1u32 || hook_radius(
        read trial.drone
    ) != 2f32 * HOOK_RADIUS {
        return error("fixture hook must attach across the scaled opening");
    }
    var extent: f32 = trial.drone.cable.extent;
    move_drone(read scene, mut trial.drone, vec(0f32, -6f32, 0f32));
    if trial.drone.world != 1u32 || drone_size(read trial.drone) != 2f32 || trial.drone.cable.extent != extent {
        return error("fixture player crossing changed cable extent");
    }
    trial.drone.cable.reeling = true;
    tether_winch(read scene, mut trial.drone);
    if!(trial.drone.cable.extent < extent) {
        return error("scaled fixture winch did not reel");
    }
    var offset: Vec3 = sub(trial.drone.cable.anchor, trial.drone.position);
    var before: f32 = length(offset) / drone_size(read trial.drone);
    drone_portal(read scene, mut trial.drone, 1u32);
    var after: f32 = length(sub(trial.drone.cable.anchor, trial.drone.position)) / drone_size(
        read trial.drone
    );
    if absf(before - after) > 0.00001f32 || drone_size(read trial.drone) != 1f32 {
        return error("fixture reciprocal crossing changed cable metric");
    }
    return scaling_course_complete(read scene, mut trial);
}
fn scaling_bounds_reject(renderer: mut Renderer) -> bool {
    var input: FrameInput = renderer_inputs(mut renderer);
    var base: usize = input_word(read input, PORTAL_FLOAT as usize) as usize;
    input_set_float(mut input, base + 16usize, 1e20f32);
    return !render_numeric_bounds(&input.storage);
}

fn scaling_course_complete(scene: read CollisionScene, trial: mut Trial) -> bool {
    reset_trial(mut trial);
    move_drone(read scene, mut trial.drone, vec(1f32, 0f32, 1f32));
    move_drone(read scene, mut trial.drone, vec(0f32, -7f32, 0f32));
    if trial.drone.world != 1u32 {
        return error("course outbound crossing failed");
    }
    move_drone(
        read scene,
        mut trial.drone,
        sub(vec(3f32, 4f32, 0f32), trial.drone.position)
    );
    move_drone(read scene, mut trial.drone, vec(0f32, 14f32, 0f32));
    move_drone(
        read scene,
        mut trial.drone,
        sub(vec(0f32, 18f32, 0f32), trial.drone.position)
    );
    graph_progress(mut trial);
    if !trial.returning {
        return error("scaling course goal is unreachable");
    }
    move_drone(read scene, mut trial.drone, vec(-3f32, 0f32, 0f32));
    move_drone(read scene, mut trial.drone, vec(0f32, -19f32, 0f32));
    if trial.drone.world != 0u32 || drone_size(read trial.drone) != 1f32 {
        return error("course return crossing failed");
    }
    move_drone(
        read scene,
        mut trial.drone,
        sub(trial.spawn.position, trial.drone.position)
    );
    graph_progress(mut trial);
    return trial.finished || error("scaling course return beacon is unreachable");
}

fn prediction_view_pixels(renderer: read Renderer, colour: u32) -> u32 {
    var pixels: *u32 = renderer.state.mapped as *u32;
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < 320u32 * 240u32 {
        count = count + (pixels[(PIXELS + i) as usize] == colour) as u32;
        i = i + 1u32;
    }
    return count;
}
fn prediction_view_checks(renderer: mut Renderer, config: GameConfig) -> bool {
    var i: u32 = 0u32;
    var baseline: u64 = 0u64;
    while i < 3u32 {
        var size: f32 = 0.5f32 * (1u32 << i) as f32;
        var scene: CollisionScene = collision_new();
        if !prediction_view_scene(mut scene, size) {
            return false;
        }
        var mode: u32 = 0u32;
        while mode < 3u32 {
            {
                var input: FrameInput = renderer_inputs(mut renderer);
                prediction_view_input(mut input, read scene, config, size, mode);
            }
            if !renderer_draw(&renderer.state) {
                return false;
            }
            var cyan: u32 = prediction_view_pixels(read renderer, 0xfff0d444u32);
            var pink: u32 = prediction_view_pixels(read renderer, 0xffe880ffu32);
            if (cyan == 0u32) != (mode == 1u32) || (pink == 0u32) != (mode == 1u32) {
                return error("near markers must hide while distant recursive copies stay visible");
            }
            if !prediction_deferred_check(mut renderer, read scene, config, size, mode) {
                return false;
            }
            mode = mode + 1u32;
        }
        var hash: u64 = scaling_image_hash(read renderer);
        if i == 0u32 {
            baseline = hash;
        }
        if hash != baseline {
            return error("scaled prediction markers changed apparent size");
        }
        i = i + 1u32;
    }
    puts("Prediction copies: near hidden, recursive visible, 0.5x/1x/2x images equal.");
    return true;
}

fn prediction_deferred_check(
    renderer: mut Renderer,
    scene: read CollisionScene,
    config: GameConfig,
    size: f32,
    mode: u32
) -> bool {
    var pixels: [u32; 76800] = uninit;
    memcpy(
        &pixels[0usize] as *u8,
        renderer.state.mapped + PIXELS as isize * 4isize,
        sizeof([u32; 76800])
    );
    var range: DeferredGeometry = uninit;
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        prediction_view_base(mut input, read scene, config, size, mode);
        input_batch_limit(mut input, 3u32);
        range = input_defer(mut input, PREVIEW_MARKERS * 8u32);
    }
    {
        var setup: FrameSetup = frame_setup(mut renderer, range);
        if !frame_setup_accepted(read setup) {
            return false;
        }
        {
            var edit: DeferredInput = frame_setup_edit(mut setup);
            prediction_view_markers(deferred_inputs(mut edit), config, size);
        }
        var frame: SubmittedFrame = frame_setup_submit(mut setup);
        var status: i32 = frame_poll(mut frame);
        while status == 0i32 {
            frame_idle(mut frame);
            status = frame_poll(mut frame);
        }
        if status < 0i32 {
            return false;
        }
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        input_batch_limit(mut input, 0u32);
    }
    return memcmp(
        &pixels[0usize] as *u8,
        renderer.state.mapped + PIXELS as isize * 4isize,
        sizeof([u32; 76800])
    ) == 0i32 || error("late marker batches changed a scaled or recursive image");
}

fn scaling_render_wall(scene: read CollisionScene, input: mut FrameInput) -> unit {
    var first: u32 = input_word(read input, 3usize);
    draw_solid(
        mut input,
        solid(vec(-3f32, -3f32, 4f32), vec(3f32, 3f32, 5f32), 4u32)
    );
    var anchor: RoomAnchor = primary_anchor(1u32, 1u32);
    anchor.transform = collision_portal(read scene, 0u32).transform;
    game_dynamic_anchor(mut input, first, anchor);
    game_dynamic_no_shadow(mut input, first);
}

fn scaling_deferred_wall(renderer: mut Renderer, scene: read CollisionScene, expected: u64) -> bool {
    var pass: u32 = 0u32;
    while pass < 2u32 {
        var range: DeferredGeometry = uninit;
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            var count: u32 = 0u32;
            if pass == 0u32 {
                scaling_render_input(read scene, mut input);
                input_set_word(mut input, 3usize, 2u32);
                count = 12u32;
            }
            input_batch_limit(mut input, 3u32);
            range = input_defer(mut input, count);
        }
        {
            var setup: FrameSetup = frame_setup(mut renderer, range);
            if !frame_setup_accepted(read setup) {
                return false;
            }
            {
                var edit: DeferredInput = frame_setup_edit(mut setup);
                if pass == 0u32 {
                    scaling_render_wall(read scene, deferred_inputs(mut edit));
                }
            }
            var frame: SubmittedFrame = frame_setup_submit(mut setup);
            var status: i32 = frame_poll(mut frame);
            while status == 0i32 {
                frame_idle(mut frame);
                status = frame_poll(mut frame);
            }
            if status < 0i32 {
                return false;
            }
        }
        if scaling_image_hash(read renderer) != expected {
            return error("late geometry or an empty reservation changed the scaled portal image");
        }
        pass = pass + 1u32;
    }
    var input: FrameInput = renderer_inputs(mut renderer);
    input_batch_limit(mut input, 0u32);
    return true;
}

fn scaling_render_checks(renderer: mut Renderer) -> bool {
    var baseline: u64 = 0u64;
    var i: u32 = 0u32;
    while i < 3u32 {
        var factor: ScaleRatio = scale_identity();
        if i == 1u32 {
            factor = scale_ratio(2u64, 1u64);
        }
        if i == 2u32 {
            factor = scale_ratio(1u64, 2u64);
        }
        var scene: CollisionScene = collision_new();
        if !scaling_render_scene(mut scene, factor) {
            return false;
        }
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            scaling_render_input(read scene, mut input);
        }
        if !renderer_draw(&renderer.state) {
            return false;
        }
        var hash: u64 = scaling_image_hash(read renderer);
        if i == 0u32 {
            baseline = hash;
        }
        if hash != baseline {
            return error("scaled room geometry and lights changed their portal image");
        }
        if !scaling_deferred_wall(mut renderer, read scene, hash) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
