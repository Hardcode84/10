fn box_face_hit(p: Vec3, d: Vec3, s: Solid, axis: u32, side: f32, radius: f32) -> Hit {
    var normal: Vec3 = scale(axis_vector(axis), side);
    var speed: f32 = dot(d, normal);
    if speed >= -0.0000001f32 {
        return miss();
    }
    var plane: f32 = component(s.low, axis);
    if side > 0f32 {
        plane = component(s.high, axis);
    }
    var t: f32 = (plane + side * radius - component(p, axis)) / component(d, axis);
    if t < -0.00001f32 || t > 1f32 {
        return miss();
    }
    t = clamp(t, 0f32, 1f32);
    var at: Vec3 = add(p, scale(d, t));
    var j: u32 = 1u32;
    while j < 3u32 {
        var k: u32 = (axis + j) % 3u32;
        if component(at, k) < component(s.low, k) || component(at, k) > component(s.high, k) {
            return miss();
        }
        j = j + 1u32;
    }
    return make Hit {
        time: t,
        normal: normal
    };
}
fn sweep_box(p: Vec3, d: Vec3, s: Solid, radius: f32) -> Hit {
    var hit: Hit = miss();
    var axis: u32 = 0u32;
    while axis < 3u32 {
        hit = nearest(hit, box_face_hit(p, d, s, axis, -1f32, radius));
        hit = nearest(hit, box_face_hit(p, d, s, axis, 1f32, radius));
        if radius > 0f32 {
            var edge: u32 = 0u32;
            while edge < 4u32 {
                var a: Vec3 = box_edge(s, axis, edge);
                var b: Vec3 = add(
                    a,
                    scale(axis_vector(axis), component(sub(s.high, s.low), axis))
                );
                hit = nearest(hit, edge_hit(p, d, a, b, radius));
                edge = edge + 1u32;
            }
        }
        axis = axis + 1u32;
    }
    return hit;
}
fn pipe_side_hit(p: Vec3, d: Vec3, pipe: CoursePipe, index: u32, radius: f32) -> Hit {
    var a: Vec3 = pipe_vertex(pipe, index, 0f32);
    var edge: Vec3 = sub(pipe_vertex(pipe, index + 1u32, 0f32), a);
    var normal: Vec3 = unit_vector(
        add(pipe_radial(pipe, index), pipe_radial(pipe, index + 1u32))
    );
    var speed: f32 = dot(d, normal);
    if speed >= -0.0000001f32 {
        return miss();
    }
    var t: f32 = (dot(sub(a, p), normal) + radius) / speed;
    if t < -0.00001f32 || t > 1f32 {
        return miss();
    }
    t = clamp(t, 0f32, 1f32);
    var at: Vec3 = sub(sub(add(p, scale(d, t)), scale(normal, radius)), a);
    var along: f32 = component(at, pipe.axis);
    var across: f32 = dot(at, edge);
    if along < 0f32 || along > pipe.extent || across < 0f32 || across > dot(edge, edge) {
        return miss();
    }
    return make Hit {
        time: t,
        normal: normal
    };
}
fn pipe_cap_hit(p: Vec3, d: Vec3, pipe: CoursePipe, end: f32, radius: f32) -> Hit {
    var normal: Vec3 = scale(axis_vector(pipe.axis), end * 2f32 - 1f32);
    var speed: f32 = dot(d, normal);
    if speed >= -0.0000001f32 {
        return miss();
    }
    var center: Vec3 = add(
        pipe.start,
        scale(axis_vector(pipe.axis), end * pipe.extent)
    );
    var t: f32 = (dot(sub(center, p), normal) + radius) / speed;
    if t < -0.00001f32 || t > 1f32 {
        return miss();
    }
    t = clamp(t, 0f32, 1f32);
    var at: Vec3 = sub(add(p, scale(d, t)), center);
    var i: u32 = 0u32;
    while i < 6u32 {
        var side: Vec3 = unit_vector(
            add(pipe_radial(pipe, i), pipe_radial(pipe, i + 1u32))
        );
        if dot(at, side) > pipe.radius * 0.866025404f32 {
            return miss();
        }
        i = i + 1u32;
    }
    return make Hit {
        time: t,
        normal: normal
    };
}
fn sweep_pipe(p: Vec3, d: Vec3, pipe: CoursePipe, radius: f32) -> Hit {
    var hit: Hit = nearest(
        pipe_cap_hit(p, d, pipe, 0f32, radius),
        pipe_cap_hit(p, d, pipe, 1f32, radius)
    );
    var i: u32 = 0u32;
    while i < 6u32 {
        hit = nearest(hit, pipe_side_hit(p, d, pipe, i, radius));
        var a: Vec3 = pipe_vertex(pipe, i, 0f32);
        var b: Vec3 = pipe_vertex(pipe, i, 1f32);
        hit = nearest(hit, edge_hit(p, d, a, b, radius));
        hit = nearest(
            hit,
            edge_hit(p, d, a, pipe_vertex(pipe, i + 1u32, 0f32), radius)
        );
        hit = nearest(
            hit,
            edge_hit(p, d, b, pipe_vertex(pipe, i + 1u32, 1f32), radius)
        );
        i = i + 1u32;
    }
    return hit;
}
fn panel_hit(p: Vec3, d: Vec3, panel: Solid, axis: u32, radius: f32) -> Hit {
    var hit: Hit = nearest(
        box_face_hit(p, d, panel, axis, -1f32, radius),
        box_face_hit(p, d, panel, axis, 1f32, radius)
    );
    if radius <= 0f32 {
        return hit;
    }
    var a: Vec3 = box_edge(panel, axis, 0u32);
    var b: Vec3 = box_edge(panel, axis, 1u32);
    var c: Vec3 = box_edge(panel, axis, 3u32);
    var e: Vec3 = box_edge(panel, axis, 2u32);
    hit = nearest(hit, edge_hit(p, d, a, b, radius));
    hit = nearest(hit, edge_hit(p, d, b, c, radius));
    hit = nearest(hit, edge_hit(p, d, c, e, radius));
    return nearest(hit, edge_hit(p, d, e, a, radius));
}
fn expedition_shell_hit(p: Vec3, d: Vec3, radius: f32) -> Hit {
    var hit: Hit = miss();
    var room: u32 = 0u32;
    while room < ROOM_COUNT {
        var instance: RoomInstance = expedition_room(room);
        var mask: u32 = expedition_open_ports(room);
        var face: u32 = 0u32;
        while face < 6u32 {
            var walls: WallPanels = prefab_wall(instance, face, mask);
            var i: u32 = 0u32;
            while i < walls.count {
                hit = nearest(
                    hit,
                    panel_hit(p, d, walls.panels[i as usize], face / 2u32, radius)
                );
                i = i + 1u32;
            }
            face = face + 1u32;
        }
        room = room + 1u32;
    }
    return hit;
}
fn collision_reference_course(world: u32, p: Vec3, d: Vec3, radius: f32) -> Hit {
    var hit: Hit = miss();
    if world == 1u32 {
        hit = expedition_shell_hit(p, d, radius);
    }
    var i: u32 = 0u32;
    while i < world_solid_count(world) {
        hit = nearest(hit, sweep_box(p, d, world_solid(world, i), radius));
        i = i + 1u32;
    }
    i = 0u32;
    while i < world_pipe_count(world) {
        hit = nearest(hit, sweep_pipe(p, d, world_pipe(world, i), radius));
        i = i + 1u32;
    }
    return hit;
}
fn collision_measure_sample(collision: read CollisionScene, i: u32, reference: bool) -> f32 {
    var world: u32 = i % 2u32;
    var p: Vec3 = course_gate((i / 2u32) % GATE_COUNT).center;
    if world == 1u32 {
        var room: RoomInstance = expedition_room((i / 2u32) % ROOM_COUNT);
        p = add(room.origin, scale(room.prefab.size, 0.5f32));
    }
    var d: Vec3 = vec(sinf(i as f32) * 4f32, cosf(i as f32) * 4f32, 4f32);
    if reference {
        return collision_reference_course(world, p, d, DRONE_RADIUS).time;
    }
    return collision_sweep(read collision, world, p, d, DRONE_RADIUS).hit.time;
}
fn test_collision_measure(collision: read CollisionScene) -> bool {
    var reference_sum: f32 = 0f32;
    var mesh_sum: f32 = 0f32;
    var start: u64 = now();
    var i: u32 = 0u32;
    while i < 2048u32 {
        reference_sum = reference_sum + collision_measure_sample(read collision, i, true);
        i = i + 1u32;
    }
    var reference_time: u64 = now() - start;
    start = now();
    i = 0u32;
    while i < 2048u32 {
        mesh_sum = mesh_sum + collision_measure_sample(read collision, i, false);
        i = i + 1u32;
    }
    collision_measure_report(read collision, reference_time, now() - start);
    return game_check(
        near(reference_sum, mesh_sum, 0.01f32),
        "production mesh and analytic collision samples differ"
    );
}
fn test_collision_samples(collision: read CollisionScene) -> bool {
    var i: u32 = 0u32;
    while i < 2048u32 {
        if !game_check(
            near(
                collision_measure_sample(read collision, i, true),
                collision_measure_sample(read collision, i, false),
                0.00001f32
            ),
            "individual production collision sample differs from the analytic result"
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}

fn collision_exhaustive_instance(
    scene: read CollisionScene,
    index: u32,
    p: Vec3,
    d: Vec3,
    radius: f32
) -> CollisionContact {
    var item: CollisionInstance = collision_instance(read scene, index);
    var local_p: Vec3 = collision_local(item.basis, sub(p, item.origin));
    var local_d: Vec3 = collision_local(item.basis, d);
    var result: CollisionContact = collision_miss(item.space);
    var i: u32 = 0u32;
    while i < item.count {
        var next: CollisionContact = collision_surface(
            local_p,
            local_d,
            collision_face(read scene, item.first + i),
            radius
        );
        if next.hit.time < result.hit.time || (
            next.hit.time == result.hit.time && next.penetration > result.penetration
        ) {
            result = next;
            result.instance = index;
            result.surface = i;
        }
        i = i + 1u32;
    }
    result.space = item.space;
    result.point = add(item.origin, basis_vector(item.basis, result.local_point));
    result.hit.normal = basis_vector(item.basis, result.hit.normal);
    return result;
}
// Returns the earliest surface contact in one space, including initial surface overlap.
// Instances use proper rigid transforms. The query does not cross a portal plane.
fn collision_exhaustive(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    radius: f32
) -> CollisionContact {
    var result: CollisionContact = collision_miss(space);
    var i: u32 = 0u32;
    while i < collision_instances(read scene) {
        if collision_instance(read scene, i).space == space && !collision_moving(
            collision_instance(read scene, i)
        ) {
            var next: CollisionContact = collision_exhaustive_instance(
                read scene,
                i,
                p,
                d,
                radius
            );
            if next.hit.time < result.hit.time || (
                next.hit.time == result.hit.time && next.penetration > result.penetration
            ) {
                result = next;
            }
        }
        i = i + 1u32;
    }
    return result;
}
