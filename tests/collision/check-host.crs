fn game_check(good: bool, message: *u8) -> bool {
    if !good {
        return error(message);
    }
    return true;
}
fn collision_measure_report(scene: read CollisionScene, reference: u64, mesh: u64) -> unit {
    puts("collision: instances / faces / bytes / analytic ns / mesh ns (2048 queries)");
    print_number(scene.data.instance_count as i64);
    print_number(scene.data.face_count as i64);
    print_number(collision_bytes(read scene) as i64);
    print_number(reference as i64);
    print_number(mesh as i64);
}
fn collision_scale_report(
    scene: read CollisionScene,
    build: u64,
    active: u64,
    prediction: u64
) -> unit {
    puts(
        "C2: instances / faces / bytes / build ns / 256 active ticks ns / 16 predictions of 240 ticks ns"
    );
    print_number(scene.data.instance_count as i64);
    print_number(scene.data.face_count as i64);
    print_number(collision_bytes(read scene) as i64);
    print_number(build as i64);
    print_number(active as i64);
    print_number(prediction as i64);
}
