fn graphics_snapshot(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped as *f32) + (v -> words + 1u32) as isize;
    v -> crossing_limit = 0u32;
    v -> read_pixels = false;
    w[4usize] = 0u32;
    w[26usize] = 0u32;
    w[LIGHT_COUNT as usize] = 0u32;
    w[LIGHT_MODEL as usize] = 0u32;
    w[OVERLAY_ENABLED as usize] = 0u32;
    f[(RENDER_STYLE + 1u32) as usize] = 63f32;
    f[(RENDER_STYLE + 2u32) as usize] = 63f32;
    f[(RENDER_STYLE + 3u32) as usize] = 0f32;
    var i: u32 = 0u32;
    while i < w[MATERIAL_COUNT as usize] {
        var material: u32 = w[ASSET_OFFSET as usize] + i * MATERIAL_WORDS;
        w[(material + 5u32) as usize] = 0u32;
        var palette: u32 = w[ASSET_OFFSET as usize] + w[(material + 4u32) as usize];
        var color: u32 = 0u32;
        // The distance-light slot and the RGB full-bright slot have equal colours.
        while color < PALETTE_COLORS {
            var p: u32 = palette + color * LIGHT_STATES;
            w[(p + 63u32) as usize] = w[(p + LIGHT_STATES - 1u32) as usize];
            color = color + 1u32;
        }
        i = i + 1u32;
    }
    v -> asset_dirty_begin = 0u32;
    v -> asset_dirty_end = w[ASSET_WORDS as usize];
    i = 0u32;
    while i < w[DYNAMIC_COUNT as usize] {
        var p: u32 = w[META as usize] + i * 4u32 + 3u32;
        w[p as usize] = w[p as usize] | TRIANGLE_INACTIVE;
        i = i + 1u32;
    }
}
fn graphics_barrier(
    v: *RenderState,
    src: u32,
    dst: u32,
    access_src: u32,
    access_dst: u32
) -> unit {
    var barrier: VkMemoryBarrier = uninit;
    zero(&barrier as *u8, sizeof(VkMemoryBarrier));
    barrier.sType = 46u32;
    barrier.srcAccessMask = access_src;
    barrier.dstAccessMask = access_dst;
    vkCmdPipelineBarrier(
        v -> gpu.commands,
        src,
        dst,
        0u32,
        1u32,
        &barrier,
        0u32,
        null(*u8),
        0u32,
        null(*VkImageMemoryBarrier)
    );
}
fn graphics_draw(v: *RenderState, g: *GraphicsProof) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var clear: [f32; 8] = make [f32; 8] {
        0f32,
        0f32,
        0f32,
        1f32,
        0f32,
        0f32,
        0f32,
        0f32
    };
    var color: u32 = w[BACKGROUND as usize];
    clear[0usize] = (color & 255u32) as f32 / 255f32;
    clear[1usize] = ((color >> 8u32) & 255u32) as f32 / 255f32;
    clear[2usize] = ((color >> 16u32) & 255u32) as f32 / 255f32;
    var info: VkRenderPassBeginInfo = uninit;
    zero(&info as *u8, sizeof(VkRenderPassBeginInfo));
    info.sType = 43u32;
    info.renderPass = g -> pass;
    info.framebuffer = g -> framebuffer;
    info.renderArea.width = v -> width;
    info.renderArea.height = v -> height;
    info.clearValueCount = 2u32;
    info.pClearValues = &clear as *u8;
    vkCmdBeginRenderPass(v -> gpu.commands, &info, 0u32);
    vkCmdBindPipeline(v -> gpu.commands, 0u32, g -> pipeline);
    vkCmdBindDescriptorSets(
        v -> gpu.commands,
        0u32,
        g -> pipeline_layout,
        0u32,
        1u32,
        &g -> set,
        0u32,
        null(*u32)
    );
    var i: u32 = 0u32;
    while i < w[INSTANCE_COUNT as usize] {
        var p: u32 = w[INSTANCE_META as usize] + i * 5u32;
        if w[(p + 3u32) as usize] == w[20usize] {
            vkCmdDraw(
                v -> gpu.commands,
                w[(p + 1u32) as usize] * 3u32,
                1u32,
                w[(p + 2u32) as usize] * 3u32,
                0u32
            );
        }
        i = i + 1u32;
    }
    vkCmdEndRenderPass(v -> gpu.commands);
}
fn graphics_record(v: *RenderState, g: *GraphicsProof, read_pixels: bool) -> bool {
    if !command_begin(v) {
        return false;
    }
    command_stamp(v, 0u32);
    graphics_barrier(v, 65536u32, 136u32, 0x10040u32, 32u32);
    graphics_draw(v, g);
    command_stamp(v, 1u32);
    if read_pixels {
        var region: VkBufferImageCopy = uninit;
        zero(&region as *u8, sizeof(VkBufferImageCopy));
        region.bufferOffset = ((v -> mapped as *u32)[PRESENT_PIXELS as usize] as u64 + 1u64) * 4u64;
        region.imageSubresource.aspectMask = 1u32;
        region.imageSubresource.layerCount = 1u32;
        region.imageExtent = make VkExtent3D {
            width: v -> width,
            height: v -> height,
            depth: 1u32
        };
        vkCmdCopyImageToBuffer(
            v -> gpu.commands,
            g -> images[0usize],
            6u32,
            v -> staging,
            1u32,
            &region
        );
        graphics_barrier(v, 4096u32, 16384u32, 4096u32, 8192u32);
    }
    return command_end(v);
}
fn graphics_time(v: *RenderState, index: u32, value: *u64) -> bool {
    return vk_ok(
        vkGetQueryPoolResults(
            v -> gpu.device,
            v -> gpu.query_pool,
            index,
            1u32,
            8usize,
            value as *u8,
            8u64,
            3u32
        ),
        "read benchmark timestamp"
    );
}
fn graphics_samples(v: *RenderState, g: *GraphicsProof, samples: u32, mode: u32) -> bool {
    var times: [u64; 128] = uninit;
    var frames: [u64; 128] = uninit;
    var geometry: [u64; 128] = uninit;
    var i: u32 = 0u32;
    while i < samples + 8u32 {
        var start: u64 = now();
        var good: bool = false;
        var end: u32 = 1u32;
        if mode == 2u32 {
            good = command_reset(v) && graphics_record(v, g, false) && dispatch(v);
        } else {
            v -> projected_tree = mode == 1u32;
            good = renderer_draw(v);
            end = v -> query_count - 2u32;
        }
        if !good {
            return false;
        }
        var elapsed: u64 = now() - start;
        var a: u64 = 0u64;
        var b: u64 = 0u64;
        if !graphics_time(v, 0u32, &a) || !graphics_time(v, end, &b) {
            return false;
        }
        var span: u64 = 0u64;
        if !graphics_span(v, mode, &span) {
            return false;
        }
        if i >= 8u32 {
            course_sample_insert(
                &times[0usize],
                (i - 8u32) as usize,
                (((b - a) & v -> timestamp_mask) as f32 * v -> timestamp_period) as u64
            );
            course_sample_insert(&frames[0usize], (i - 8u32) as usize, elapsed);
            course_sample_insert(&geometry[0usize], (i - 8u32) as usize, span);
        }
        i = i + 1u32;
    }
    puts("GPU ns p50 / p95 / p99");
    graphics_percentiles(&times[0usize], samples);
    puts("geometry GPU ns p50 / p95 / p99");
    graphics_percentiles(&geometry[0usize], samples);
    puts("submission frame ns p50 / p95 / p99");
    graphics_percentiles(&frames[0usize], samples);
    return true;
}
fn graphics_span(v: *RenderState, mode: u32, span: *u64) -> bool {
    var first: u32 = 1u32;
    var last: u32 = 2u32;
    if mode == 2u32 {
        first = 0u32;
        last = 1u32;
    }
    var a: u64 = 0u64;
    var b: u64 = 0u64;
    if !graphics_time(v, first, &a) || !graphics_time(v, last, &b) {
        return false;
    }
    * span = (((b - a) & v -> timestamp_mask) as f32 * v -> timestamp_period) as u64;
    return true;
}
fn graphics_percentiles(values: *u64, samples: u32) -> unit {
    print_number(values[((samples - 1u32) / 2u32) as usize] as i64);
    print_number(values[((samples * 95u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
    print_number(values[((samples * 99u32 + 99u32) / 100u32 - 1u32) as usize] as i64);
}
fn graphics_compare(v: *RenderState, samples: u32) -> bool {
    if v -> width != v -> output_width || v -> height != v -> output_height || v -> shader_checks {
        return error(
            "geometry comparison requires equal render/output extents and production shaders"
        );
    }
    graphics_snapshot(v);
    if !renderer_draw(v) {
        return false;
    }
    var g: GraphicsProof = uninit;
    zero(&g as *u8, sizeof(GraphicsProof));
    var good: bool = graphics_open(v, &g);
    if good {
        good = graphics_compare_run(v, &g, samples);
    }
    graphics_close(v, &g);
    return good;
}
fn graphics_compare_run(v: *RenderState, g: *GraphicsProof, samples: u32) -> bool {
    puts("isolated root room; static geometry; full-bright textures; perspective UVs");
    puts("width / height / measured samples");
    print_number(v -> width as i64);
    print_number(v -> height as i64);
    print_number(samples as i64);
    puts("normal compute");
    if !graphics_samples(v, g, samples, 0u32) {
        return false;
    }
    if !graphics_capture_compute(v, "build/geometry-compute.ppm") {
        return false;
    }
    puts("projected compute");
    if !graphics_samples(v, g, samples, 1u32) {
        return false;
    }
    if !graphics_capture_compute(v, "build/geometry-projected.ppm") {
        return false;
    }
    puts("hardware graphics");
    if !graphics_samples(v, g, samples, 2u32) {
        return false;
    }
    return command_reset(v) && graphics_record(v, g, true) && dispatch(v) && capture(
        v,
        "build/geometry-graphics.ppm",
        v -> width,
        v -> height
    );
}
fn graphics_capture_compute(v: *RenderState, path: *u8) -> bool {
    v -> read_pixels = true;
    var good: bool = renderer_draw(v) && capture(v, path, v -> width, v -> height);
    v -> read_pixels = false;
    return good;
}
