record GraphicsProof {
    images: [*u8; 2];
    memory: [*u8; 2];
    views: [*u8; 2];
    modules: [*u8; 2];
    pass: *u8;
    framebuffer: *u8;
    layout: *u8;
    pipeline_layout: *u8;
    pool: *u8;
    set: *u8;
    pipeline: *u8;
}
opaque;
fn graphics_image(v: *RenderState, g: *GraphicsProof, i: usize) -> bool {
    var format: u32 = 37u32;
    var usage: u32 = 17u32;
    var aspect: u32 = 1u32;
    if i == 1usize {
        format = 126u32;
        usage = 32u32;
        aspect = 2u32;
    }
    var info: VkImageCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkImageCreateInfo));
    info.sType = 14u32;
    info.imageType = 1u32;
    info.format = format;
    info.extent = make VkExtent3D {
        width: v -> width,
        height: v -> height,
        depth: 1u32
    };
    info.mipLevels = 1u32;
    info.arrayLayers = 1u32;
    info.samples = 1u32;
    info.usage = usage;
    if !vk_ok(
        vkCreateImage(v -> gpu.device, &info, null(*u8), &g -> images[i]),
        "create benchmark image"
    ) {
        return false;
    }
    var requirements: VkMemoryRequirements = uninit;
    vkGetImageMemoryRequirements(v -> gpu.device, g -> images[i], &requirements);
    if !memory_allocate(v, &requirements, 1u32, &g -> memory[i]) || !vk_ok(
        vkBindImageMemory(v -> gpu.device, g -> images[i], g -> memory[i], 0u64),
        "bind benchmark image"
    ) {
        return false;
    }
    var view: VkImageViewCreateInfo = uninit;
    zero(&view as *u8, sizeof(VkImageViewCreateInfo));
    view.sType = 15u32;
    view.image = g -> images[i];
    view.viewType = 1u32;
    view.format = format;
    view.subresourceRange.aspectMask = aspect;
    view.subresourceRange.levelCount = 1u32;
    view.subresourceRange.layerCount = 1u32;
    return vk_ok(
        vkCreateImageView(v -> gpu.device, &view, null(*u8), &g -> views[i]),
        "create benchmark image view"
    );
}
fn graphics_pass(v: *RenderState, g: *GraphicsProof) -> bool {
    var attachments: [VkAttachmentDescription; 2] = uninit;
    zero(&attachments as *u8, sizeof([VkAttachmentDescription; 2]));
    attachments[0usize].format = 37u32;
    attachments[0usize].samples = 1u32;
    attachments[0usize].loadOp = 1u32;
    attachments[0usize].storeOp = 0u32;
    attachments[0usize].stencilLoadOp = 2u32;
    attachments[0usize].stencilStoreOp = 1u32;
    attachments[0usize].finalLayout = 6u32;
    attachments[1usize] = attachments[0usize];
    attachments[1usize].format = 126u32;
    attachments[1usize].storeOp = 1u32;
    attachments[1usize].finalLayout = 3u32;
    var color: VkAttachmentReference = make VkAttachmentReference {
        attachment: 0u32,
        layout: 2u32
    };
    var depth: VkAttachmentReference = make VkAttachmentReference {
        attachment: 1u32,
        layout: 3u32
    };
    var subpass: VkSubpassDescription = uninit;
    zero(&subpass as *u8, sizeof(VkSubpassDescription));
    subpass.colorAttachmentCount = 1u32;
    subpass.pColorAttachments = &color;
    subpass.pDepthStencilAttachment = &depth;
    var info: VkRenderPassCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkRenderPassCreateInfo));
    info.sType = 38u32;
    info.attachmentCount = 2u32;
    info.pAttachments = &attachments[0usize];
    info.subpassCount = 1u32;
    info.pSubpasses = &subpass;
    var dependency: VkSubpassDependency = make VkSubpassDependency {
        srcSubpass: 0u32,
        dstSubpass: 0xffffffffu32,
        srcStageMask: 1024u32,
        dstStageMask: 4096u32,
        srcAccessMask: 256u32,
        dstAccessMask: 2048u32,
        dependencyFlags: 0u32
    };
    info.dependencyCount = 1u32;
    info.pDependencies = &dependency as *u8;
    if !vk_ok(
        vkCreateRenderPass(v -> gpu.device, &info, null(*u8), &g -> pass),
        "create benchmark render pass"
    ) {
        return false;
    }
    var framebuffer: VkFramebufferCreateInfo = uninit;
    zero(&framebuffer as *u8, sizeof(VkFramebufferCreateInfo));
    framebuffer.sType = 37u32;
    framebuffer.renderPass = g -> pass;
    framebuffer.attachmentCount = 2u32;
    framebuffer.pAttachments = &g -> views[0usize];
    framebuffer.width = v -> width;
    framebuffer.height = v -> height;
    framebuffer.layers = 1u32;
    return vk_ok(
        vkCreateFramebuffer(
            v -> gpu.device,
            &framebuffer,
            null(*u8),
            &g -> framebuffer
        ),
        "create benchmark framebuffer"
    );
}
fn graphics_layout(v: *RenderState, g: *GraphicsProof) -> bool {
    var bindings: [VkDescriptorSetLayoutBinding; 2] = uninit;
    zero(&bindings as *u8, sizeof([VkDescriptorSetLayoutBinding; 2]));
    var i: usize = 0usize;
    while i < 2usize {
        bindings[i].binding = i as u32;
        bindings[i].descriptorType = 7u32;
        bindings[i].descriptorCount = 1u32;
        bindings[i].stageFlags = 17u32;
        i = i + 1usize;
    }
    var info: VkDescriptorSetLayoutCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkDescriptorSetLayoutCreateInfo));
    info.sType = 32u32;
    info.bindingCount = 2u32;
    info.pBindings = &bindings[0usize];
    if !vk_ok(
        vkCreateDescriptorSetLayout(v -> gpu.device, &info, null(*u8), &g -> layout),
        "create benchmark descriptor layout"
    ) {
        return false;
    }
    var pi: VkPipelineLayoutCreateInfo = uninit;
    zero(&pi as *u8, sizeof(VkPipelineLayoutCreateInfo));
    pi.sType = 30u32;
    pi.setLayoutCount = 1u32;
    pi.pSetLayouts = &g -> layout;
    return vk_ok(
        vkCreatePipelineLayout(v -> gpu.device, &pi, null(*u8), &g -> pipeline_layout),
        "create benchmark pipeline layout"
    );
}
fn graphics_descriptors(v: *RenderState, g: *GraphicsProof) -> bool {
    var state: RenderState = *v;
    state.gpu.layout = g -> layout;
    state.gpu.pool = null(*u8);
    state.gpu.set = null(*u8);
    state.shader_checks = false;
    var good: bool = descriptors_create(&state);
    g -> pool = state.gpu.pool;
    g -> set = state.gpu.set;
    return good;
}
fn graphics_module(v: *RenderState, g: *GraphicsProof, index: usize, path: *u8) -> bool {
    var code: ShaderCode = uninit;
    if !read_input(path, &code) {
        return false;
    }
    var info: VkShaderModuleCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkShaderModuleCreateInfo));
    info.sType = 16u32;
    info.codeSize = code.size;
    info.pCode = code.bytes as *u32;
    var good: bool = vk_ok(
        vkCreateShaderModule(
            v -> gpu.device,
            &info,
            null(*u8),
            &g -> modules[index]
        ),
        "create benchmark shader"
    );
    free(code.bytes);
    return good;
}
fn graphics_close(v: *RenderState, g: *GraphicsProof) -> unit {
    var device: *u8 = v -> gpu.device;
    vkDestroyPipeline(device, g -> pipeline, null(*u8));
    vkDestroyFramebuffer(device, g -> framebuffer, null(*u8));
    vkDestroyRenderPass(device, g -> pass, null(*u8));
    vkDestroyDescriptorPool(device, g -> pool, null(*u8));
    vkDestroyPipelineLayout(device, g -> pipeline_layout, null(*u8));
    vkDestroyDescriptorSetLayout(device, g -> layout, null(*u8));
    var i: usize = 0usize;
    while i < 2usize {
        vkDestroyShaderModule(device, g -> modules[i], null(*u8));
        vkDestroyImageView(device, g -> views[i], null(*u8));
        vkDestroyImage(device, g -> images[i], null(*u8));
        vkFreeMemory(device, g -> memory[i], null(*u8));
        i = i + 1usize;
    }
}
fn graphics_open(v: *RenderState, g: *GraphicsProof) -> bool {
    var count: u32 = 0u32;
    vkGetPhysicalDeviceQueueFamilyProperties(
        v -> gpu.physical,
        &count,
        null(*VkQueueFamilyProperties)
    );
    var families: *VkQueueFamilyProperties = malloc(
        count as usize * sizeof(VkQueueFamilyProperties)
    ) as *VkQueueFamilyProperties;
    if families == null(*VkQueueFamilyProperties) {
        return error("cannot allocate queue properties");
    }
    vkGetPhysicalDeviceQueueFamilyProperties(v -> gpu.physical, &count, families);
    var supported: bool = (families[v -> gpu.family as usize].queueFlags & 1u32) != 0u32;
    free(families as *u8);
    if !supported {
        return error("geometry benchmark requires a graphics-capable queue");
    }
    return graphics_image(v, g, 0usize) && graphics_image(v, g, 1usize) && graphics_pass(v, g) && graphics_layout(
        v,
        g
    ) && graphics_descriptors(v, g) && graphics_module(v, g, 0usize, "build/geometry.vert.spv") && graphics_module(
        v,
        g,
        1usize,
        "build/geometry.frag.spv"
    ) && graphics_pipeline(v, g);
}
