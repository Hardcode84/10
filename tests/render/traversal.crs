fn traversal_assets(v: mut FrameInput) -> unit {
    var texture: u32 = 8u32 * MATERIAL_WORDS;
    var palette: u32 = texture + 64u32;
    if !input_assets(mut v, 8u32, 64u32 + PALETTE_COLORS * LIGHT_STATES) {
        scene_overflow();
        return;
    }
    var i: u32 = 0u32;
    while i < PALETTE_COLORS * LIGHT_STATES {
        var color: u32 = 0xff172b31u32;
        if i / LIGHT_STATES != 0u32 {
            color = 0xff57a9d3u32;
        }
        input_asset_set(mut v, palette + i, color);
        i = i + 1u32;
    }
    i = 0u32;
    while i < 64u32 {
        var texel: u32 = 0u32;
        if i % 8u32 == i / 8u32 {
            texel = 1u32;
        }
        input_texel(mut v, texture + i, texel);
        i = i + 1u32;
    }
    i = 0u32;
    while i < 8u32 {
        var m: Material = make Material {
            texture: texture + i * 8u32,
            width: 8u32,
            height: 1u32,
            stride: 8u32,
            palette: palette,
            style: 0u32,
            unlit: 0u32,
            address_u: ADDRESS_REPEAT,
            address_v: ADDRESS_REPEAT,
            transparent_index: 0u32
        };
        if !input_material(mut v, i, m) {
            scene_overflow();
            return;
        }
        i = i + 1u32;
    }
}
fn traversal_aperture(
    v: mut FrameInput,
    id: u32,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    masked: bool
) -> unit {
    var material: u32 = 0u32;
    if masked {
        material = id;
    }
    quad(
        mut v,
        0u32,
        material,
        id + 1u32,
        masked as u32,
        x,
        y,
        2f32,
        x + w,
        y,
        2f32,
        x + w,
        y + h,
        2f32,
        x,
        y + h,
        2f32
    );
    if masked {
        var count: u32 = input_word(read v, 3usize);
        var i: u32 = 0u32;
        while i < 6u32 {
            var p: usize = (GEOMETRY + (count - 2u32) * 15u32 + i * 5u32) as usize;
            var u: f32 = (input_float(read v, p) + 4f32) * 16f32;
            input_set_float(mut v, p + 3usize, u);
            i = i + 1u32;
        }
    }
}
fn traversal_scene(v: mut FrameInput, index: u32) -> unit {
    input_frame(mut v);
    traversal_assets(mut v);
    input_set_word(mut v, BACKGROUND as usize, 0xff172b31u32);
    input_set_word(mut v, LIGHT_MODEL as usize, 0u32);
    input_set_float(mut v, RENDER_STYLE as usize, 0.01f32);
    input_set_float(mut v, (RENDER_STYLE + 2u32) as usize, 32f32);
    input_set_float(mut v, 0usize, 1f32);
    input_set_float(mut v, 5usize, 1f32);
    input_set_float(mut v, 10usize, 1f32);
    if index >= 10u32 {
        traversal_extended(mut v, index);
        return;
    }
    if index == 1u32 || index == 2u32 {
        tour_portal(mut v, 80u32, 0u32, 0u32, 1f32, 0f32, 0f32, 2f32, 0f32, 1f32, 0f32);
        traversal_aperture(mut v, 80u32, -1000f32, -1000f32, 2000f32, 2000f32, false);
        return;
    }
    if index == 9u32 {
        traversal_pixel_portals(mut v);
        return;
    }
    if index == 7u32 {
        traversal_aperture(mut v, 96u32, -4f32, -2f32, 8f32, 4f32, false);
        return;
    }
    var count: u32 = 80u32;
    if index == 3u32 || index == 4u32 {
        count = 8u32;
    }
    var i: u32 = 0u32;
    while i < count {
        tour_portal(mut v, i, 0u32, 1u32, 1f32, 0f32, i as f32, 2f32, 0f32, 1f32, 0f32);
        if count == 8u32 {
            traversal_aperture(mut v, i, -4f32, -2f32, 8f32, 4f32, true);
        } else {
            traversal_aperture(
                mut v,
                i,
                -3.2f32 + (i % 10u32) as f32 * 0.64f32,
                -2f32 + (i / 10u32) as f32 * 0.5f32,
                0.64f32,
                0.5f32,
                false
            );
        }
        i = i + 1u32;
    }
    var layers: u32 = 0u32;
    if index == 0u32 {
        layers = 65u32;
    }
    traversal_destination(mut v, layers);
}

fn traversal_destination(v: mut FrameInput, layers: u32) -> unit {
    var first: u32 = input_word(read v, 3usize);
    quad(
        mut v,
        1u32,
        0u32,
        0u32,
        0u32,
        -100f32,
        -100f32,
        2f32,
        100f32,
        -100f32,
        2f32,
        100f32,
        100f32,
        2f32,
        -100f32,
        100f32,
        2f32
    );
    var i: u32 = 0u32;
    while i < 6u32 {
        var p: usize = (GEOMETRY + first * 15u32 + i * 5u32) as usize;
        var u: f32 = input_float(read v, p) / 8f32;
        input_set_float(mut v, p + 3usize, u);
        i = i + 1u32;
    }
    // Occluded panels make recursive destinations cross geometry batch boundaries.
    i = 0u32;
    while i < layers {
        var z: f32 = 4f32 + i as f32;
        quad(
            mut v,
            1u32,
            0u32,
            0u32,
            0u32,
            -90f32,
            -90f32,
            z,
            90f32,
            -90f32,
            z,
            90f32,
            90f32,
            z,
            -90f32,
            90f32,
            z
        );
        i = i + 1u32;
    }
}

fn traversal_pixel_portals(v: mut FrameInput) -> unit {
    var i: u32 = 0u32;
    while i < 64u32 {
        tour_portal(mut v, i, 0u32, 1u32, 1f32, 0f32, i as f32, 2f32, 0f32, 1f32, 0f32);
        traversal_aperture(
            mut v,
            i,
            -2f32 + (i % 8u32) as f32 * 0.5f32,
            -2f32 + (i / 8u32) as f32 * 0.5f32,
            0.5f32,
            0.5f32,
            false
        );
        i = i + 1u32;
    }
    traversal_destination(mut v, 65u32);
}

fn traversal_chain(v: mut FrameInput, links: u32) -> unit {
    var i: u32 = 0u32;
    while i < links {
        tour_portal(mut v, i, i, i + 1u32, 1f32, 0f32, 0f32, 2f32, 0f32, 1f32, 0f32);
        var first: u32 = input_word(read v, 3usize);
        traversal_aperture(mut v, i, -1000f32, -1000f32, 2000f32, 2000f32, false);
        var meta: u32 = input_word(read v, META as usize);
        input_set_word(mut v, (meta + first * 4u32) as usize, i);
        input_set_word(mut v, (meta + (first + 1u32) * 4u32) as usize, i);
        i = i + 1u32;
    }
    var first: u32 = input_word(read v, 3usize);
    traversal_destination(mut v, 0u32);
    var meta: u32 = input_word(read v, META as usize);
    input_set_word(mut v, (meta + first * 4u32) as usize, links);
    input_set_word(mut v, (meta + (first + 1u32) * 4u32) as usize, links);
}
fn traversal_cube(v: mut FrameInput, factor: f32) -> unit {
    var face: u32 = 0u32;
    while face < 6u32 {
        var meta: u32 = input_word(read v, PORTAL_META as usize);
        var axis: u32 = face / 2u32;
        var side: f32 = 1f32 - 2f32 * (face % 2u32) as f32;
        tour_portal(mut v, face, 0u32, 0u32, factor, 0f32, 0f32, 0f32, 0f32, 0f32, 2f32);
        var p: usize = (
            input_word(read v, PORTAL_FLOAT as usize) + face * PORTAL_TRANSFORM_WORDS
        ) as usize;
        input_set_float(mut v, p + 5usize, factor);
        input_set_float(
            mut v,
            p + (axis * 4u32 + 3u32) as usize,
            side * (2f32 + 2f32 * factor)
        );
        input_set_float(mut v, p + 12usize + axis as usize, side);
        input_set_float(mut v, p + 16usize, factor);
        input_set_word(mut v, (meta + face * 4u32 + 2u32) as usize, (face ^ 1u32) + 1u32);
        var first: u32 = input_word(read v, 3usize);
        traversal_aperture(mut v, face, -2f32, -2f32, 4f32, 4f32, false);
        var corner: u32 = 0u32;
        while corner < 6u32 {
            var point: usize = (GEOMETRY + first * 15u32 + corner * 5u32) as usize;
            var x: f32 = input_float(read v, point);
            var y: f32 = input_float(read v, point + 1usize);
            input_set_float(mut v, point + axis as usize, side * 2f32);
            input_set_float(mut v, point + ((axis + 1u32) % 3u32) as usize, x);
            input_set_float(mut v, point + ((axis + 2u32) % 3u32) as usize, y);
            corner = corner + 1u32;
        }
        face = face + 1u32;
    }
}
fn traversal_extended(v: mut FrameInput, index: u32) -> unit {
    if index == 10u32 || index == 11u32 || index == 14u32 || index == 15u32 || index == 16u32 || index == 18u32 {
        traversal_chain(mut v, 64u32);
        if index == 18u32 {
            var i: u32 = 0u32;
            while i < 64u32 {
                traversal_factor(mut v, i, 2f32);
                i = i + 1u32;
            }
        }
    } else if index == 17u32 {
        tour_portal(mut v, 0u32, 0u32, 0u32, 1f32, 0f32, 0f32, 2f32, 0f32, 1f32, 0f32);
        traversal_factor(mut v, 0u32, 0.5f32);
        traversal_aperture(mut v, 0u32, -1e8f32, -1e8f32, 2e8f32, 2e8f32, false);
    } else {
        var factor: f32 = 1f32;
        if index == 13u32 {
            factor = 0.5f32;
        }
        traversal_cube(mut v, factor);
    }
}

fn traversal_factor(v: mut FrameInput, portal: u32, factor: f32) -> unit {
    var p: usize = (
        input_word(read v, PORTAL_FLOAT as usize) + portal * PORTAL_TRANSFORM_WORDS
    ) as usize;
    input_set_float(mut v, p, factor);
    input_set_float(mut v, p + 5usize, factor);
    input_set_float(mut v, p + 10usize, factor);
    input_set_float(mut v, p + 16usize, factor);
}
