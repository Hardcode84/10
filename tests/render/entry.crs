fn regression_open(session: mut DemoSession, test: u32) -> bool {
    if test != 5u32 && test != 6u32 {
        var good: bool = session_open(mut session);
        if good && test == 7u32 {
            var v: *RenderState = &session.renderer.state;
            if v -> storage_limit > 67108864u32 {
                v -> storage_limit = 67108864u32;
            }
        }
        return good;
    }
    var config: RenderConfig = demo_render_config(&session.options);
    // These scenes have no portal crossings: one task per screen tile is sufficient.
    config.task_budget = ((config.width + 7u32) / 8u32) * ((config.height + 7u32) / 8u32);
    return demo_renderer_configured(&session.renderer.state, &config, null(*u8));
}
fn main(argc: i32, argv: **u8) -> i32 {
    var test: u32 = 0u32;
    if argc < 2i32 || !parse_number(argv[1usize], &test) || test > 12u32 {
        error("render tests require a case number from 0 through 12");
        return 2i32;
    }
    var o: Options = uninit;
    if !options(argc - 1i32, &argv[1usize], &o) {
        return 2i32;
    }
    if o.mapping != 0u32 || o.snap != 0u32 {
        error("reference checks require perspective mapping and no vertex snapping");
        return 2i32;
    }
    o.debug_pixels = 1u32;
    return render_test(&o, test);
}
fn render_test(o: *Options, test: u32) -> i32 {
    if test == 12u32 {
        return (!transfer_test(o)) as i32;
    }
    if test == 11u32 {
        return (!lighting_test(o)) as i32;
    }
    if test >= 9u32 {
        return (!image_test(o, test == 10u32)) as i32;
    }
    if test == 8u32 {
        return (!traversal_test(o)) as i32;
    }
    if test == 1u32 {
        return (!palette_test()) as i32;
    }
    if test == 3u32 {
        return (!playback_test()) as i32;
    }
    if test == 2u32 || test == 7u32 {
        o -> capture = "build/test-scene.ppm";
        o -> width = 320u32;
        o -> height = 180u32;
        o -> window_width = 640u32;
        o -> window_height = 360u32;
        o -> frames = 25u32;
        o -> debug_pixels = 1u32;
    }
    if test == 4u32 {
        o -> capture = "build/test-tour.ppm";
        o -> width = 320u32;
        o -> height = 180u32;
        o -> window_width = 640u32;
        o -> window_height = 360u32;
        o -> frames = 50u32;
        o -> debug_pixels = 1u32;
    }
    if test == 5u32 || test == 6u32 {
        o -> capture = "build/test-capacity.ppm";
        o -> width = 64u32;
        o -> height = 48u32;
        o -> window_width = 64u32;
        o -> window_height = 48u32;
        o -> frames = 8u32;
        o -> view_budget = 1u32;
        o -> debug_pixels = 1u32;
    }
    if test == 6u32 {
        o -> capture = "build/test-textures.ppm";
        o -> frames = 20u32;
    }
    var session: DemoSession = session_new(o);
    var config: DemoConfig = config_from_options(o);
    return regression_run(move session, config, test);
}
