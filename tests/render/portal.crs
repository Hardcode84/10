fn distant_cube_check(v: *RenderState, frame: u32) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var front: f32 = 8.5f32 + 2f32 * sinf(frame as f32 / 60f32) - 0.8f32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var hit: u32 = w[(w[DEBUG_VALUES as usize] + pixel * 4u32) as usize];
        var tri: u32 = hit % w[3usize];
        if hit >= w[3usize] && tri < w[3usize] && w[(w[META as usize] + tri * 4u32) as usize] == 0u32 && w[
            (w[META as usize] + tri * 4u32 + 1u32) as usize
        ] == 2u32 {
            var g: usize = (GEOMETRY + tri * 15u32) as usize;
            if f[g + 2usize] == front && f[g + 7usize] == front && f[g + 12usize] == front {
                puts("distant crossing cube front face passed");
                return true;
            }
        }
        pixel = pixel + 1u32;
    }
    return error(
        "recursive portal must show the moving cube front face before and after frame 368"
    );
}
fn portal_plane_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var tri: u32 = 0u32;
    while tri < w[3usize] {
        var portal: u32 = w[(w[META as usize] + tri * 4u32 + 2u32) as usize];
        if portal != 0u32 {
            var p: usize = (w[PORTAL_FLOAT as usize] + (portal - 1u32) * 16u32) as usize;
            var vertex: u32 = 0u32;
            while vertex < 3u32 {
                var g: usize = (GEOMETRY + tri * 15u32 + vertex * 5u32) as usize;
                var x: f32 = f[g] - f[p + 3usize];
                var y: f32 = f[g + 1usize] - f[p + 7usize];
                var z: f32 = f[g + 2usize] - f[p + 11usize];
                var distance: f32 = f[p + 15usize];
                var axis: usize = 0usize;
                while axis < 3usize {
                    distance = distance + f[p + 12usize + axis] * (
                        f[p + axis] * x + f[p + 4usize + axis] * y + f[p + 8usize + axis] * z
                    );
                    axis = axis + 1usize;
                }
                if distance != 0f32 {
                    return error(
                        "destination clip plane does not contain the transformed aperture"
                    );
                }
                vertex = vertex + 1u32;
            }
        }
        tri = tri + 1u32;
    }
    return true;
}
fn crossing_face_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var hit: u32 = w[
        (w[DEBUG_VALUES as usize] + (125u32 * 320u32 + 100u32) * 4u32) as usize
    ];
    var tri: u32 = hit % w[3usize];
    if tri >= w[3usize] || w[(w[META as usize] + tri * 4u32) as usize] != 1u32 || w[
        (w[META as usize] + tri * 4u32 + 1u32) as usize
    ] != 2u32 {
        return error("frame 523: portal must show the crossing cube front face");
    }
    var front: f32 = (8.5f32 + 2f32 * sinf(523f32 / 60f32) - 9f32) - 0.8f32;
    var vertex: u32 = 0u32;
    while vertex < 3u32 {
        if f[(GEOMETRY + tri * 15u32 + vertex * 5u32 + 2u32) as usize] != front {
            return error("frame 523: crossing cube front face is missing");
        }
        vertex = vertex + 1u32;
    }
    puts("frame 523 crossing cube front face passed");
    return true;
}

fn tour_visibility_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var mask: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var tri: u32 = w[(w[DEBUG_VALUES as usize] + pixel * 4u32) as usize] % w[3usize];
        if tri < w[3usize] {
            mask = mask | (1u32 << w[(w[META as usize] + tri * 4u32) as usize]);
        }
        pixel = pixel + 1u32;
    }
    if mask != 3u32 || w[11usize] != 2u32 {
        return error("tour entrance must show both rooms with the yard hidden by the bend");
    }
    puts("tour entrance: two visible spaces with the yard hidden passed");
    puts("tour source triangles:");
    print_number(w[3usize] as i64);
    return true;
}

fn full_bright_palette_check(w: *u32) -> bool {
    var state: u32 = 0u32;
    while state < 512u32 {
        if w[
            (
                (
                    w[ASSET_OFFSET as usize] + w[(w[ASSET_OFFSET as usize] + 4u32) as usize]
                ) + (7u32 * 4u32 + 3u32) * 512u32 + state
            ) as usize
        ] != 0xffe8ba32u32 || w[
            (
                (
                    w[ASSET_OFFSET as usize] + w[(w[ASSET_OFFSET as usize] + 4u32) as usize]
                ) + (12u32 * 4u32 + 3u32) * 512u32 + state
            ) as usize
        ] != 0xffe8ba32u32 {
            return error("full-bright pipe colour must be constant across all light states");
        }
        state = state + 1u32;
    }
    return true;
}
fn full_bright_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    if !full_bright_palette_check(w) {
        return false;
    }
    var bright: u32 = 0u32;
    var dark: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var tri: u32 = w[(w[DEBUG_VALUES as usize] + pixel * 4u32) as usize] % w[3usize];
        if tri < w[3usize] {
            var mat: u32 = w[(w[META as usize] + tri * 4u32 + 1u32) as usize];
            if mat == 7u32 || mat == 12u32 {
                var color: u32 = w[(PIXELS + pixel) as usize];
                if color == 0xffe8ba32u32 {
                    bright = bright + 1u32;
                } else if color == 0xff000000u32 {
                    dark = dark + 1u32;
                } else {
                    return error(
                        "unlit pipe must contain only full-bright stripes and black metal"
                    );
                }
            }
        }
        pixel = pixel + 1u32;
    }
    if bright == 0u32 || dark == 0u32 {
        return error("unlit pipe must show both full-bright and normally shaded texels");
    }
    puts("full-bright stripes and dark pipe texels with all point lights disabled passed");
    return true;
}

fn tour_turn_check(v: *RenderState, index: u32) -> bool {
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var direction: f32 = f[8usize];
    if index == 45u32 {
        direction = -direction;
    }
    if direction <= 0.25f32 || f[10usize] <= 0.5f32 {
        return error("interior camera must face forward and into the turn");
    }
    puts("camera faces into the interior turn passed");
    return true;
}

fn camera_light_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var mask: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var tri: u32 = w[(w[DEBUG_VALUES as usize] + pixel * 4u32) as usize] % w[3usize];
        if tri < w[3usize] {
            var mat: u32 = w[(w[META as usize] + tri * 4u32 + 1u32) as usize];
            if mat < 5u32 && w[(PIXELS + pixel) as usize] != 0xff000000u32 {
                mask = mask | (1u32 << w[(w[META as usize] + tri * 4u32) as usize]);
            }
        }
        pixel = pixel + 1u32;
    }
    if mask != 3u32 {
        print_number(mask as i64);
        return error(
            "camera light alone must illuminate ordinary surfaces on both sides of the portal"
        );
    }
    puts("camera light illuminates both sides of the portal passed");
    return true;
}

fn light_band_check(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var mask: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var color: u32 = w[(PIXELS + pixel) as usize];
        var level: u32 = 0u32;
        while level < 8u32 {
            if color == w[
                (
                    (
                        w[ASSET_OFFSET as usize] + w[
                            (w[ASSET_OFFSET as usize] + 4u32) as usize
                        ]
                    ) + level * 73u32
                ) as usize
            ] {
                mask = mask | (1u32 << level);
            }
            level = level + 1u32;
        }
        pixel = pixel + 1u32;
    }
    if (mask & 1u32) == 0u32 || mask <= 1u32 || w[PIXELS as usize] != 0xff000000u32 {
        return error("flat light fixture must show lit grid samples and a black outer region");
    }
    puts("grid-sampled light bands and black outer region passed");
    return w[2usize] != 0u32 || light_grid_check(w);
}

fn light_grid_check(w: *u32) -> bool {
    var different: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        var x: u32 = pixel % w[0usize];
        var y: u32 = pixel / w[0usize];
        var anchor: u32 = (y / 16u32 * 16u32 + y % 2u32) * w[0usize] + x / 16u32 * 16u32 + x % 2u32;
        if w[(PIXELS + pixel) as usize] != w[(PIXELS + anchor) as usize] {
            puts("grid mismatch pixel / anchor / colour / anchor colour:");
            print_number(pixel as i64);
            print_number(anchor as i64);
            print_number(w[(PIXELS + pixel) as usize] as i64);
            print_number(w[(PIXELS + anchor) as usize] as i64);
            return error(
                "flat surface lighting must repeat the same checker inside each 16 by 16 cell"
            );
        }
        if x % 16u32 == 0u32 && w[(PIXELS + pixel) as usize] != w[
            (PIXELS + pixel + 1u32) as usize
        ] {
            different = different + 1u32;
        }
        pixel = pixel + 1u32;
    }
    if different == 0u32 {
        return error("light grid must mix different neighbouring samples");
    }
    puts("16 by 16 light cells with alternating neighbouring samples passed");
    return true;
}
fn capacity_failure_check(v: *RenderState) -> bool {
    var before: *u8 = v -> mapped;
    var capacity: u32 = v -> triangle_capacity;
    var limit: u32 = geometry_limit(v);
    var trial: RenderState = *v;
    if !geometry_layout(&trial, limit) || geometry_layout(&trial, limit + 1u32) || geometry_reserve(
        v,
        0xffffffffu32
    ) {
        return error("geometry range limit must match device storage bounds");
    }
    return (v -> mapped == before && v -> triangle_capacity == capacity) || error(
        "failed geometry reservation changed the live allocation"
    );
}
fn texture_constant_check(v: *RenderState, index: u32) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var expected: u32 = 0xff000000u32;
    if index == 7u32 {
        expected = 0xffb7dbffu32;
    }
    if index == 10u32 {
        expected = 0xffb55e16u32;
    }
    var covered: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < w[0usize] * w[1usize] {
        if w[(w[DEBUG_VALUES as usize] + pixel * 4u32) as usize] != 0xffffffffu32 {
            if w[(PIXELS + pixel) as usize] != expected {
                print_number(index as i64);
                print_number(pixel as i64);
                print_number(w[(PIXELS + pixel) as usize] as i64);
                print_number(expected as i64);
                print_number(
                    w[(w[DEBUG_VALUES as usize] + pixel * 4u32 + 1u32) as usize] as i64
                );
                return error("constant UV sample must match the exact palette colour");
            }
            covered = covered + 1u32;
        }
        pixel = pixel + 1u32;
    }
    return covered > 1000u32 || error("texture test must cover the output");
}
