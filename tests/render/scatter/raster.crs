fn scatter_pixel() -> unit {
    var tile: u32 = shader_global_x() / 64u32;
    var lane: u32 = shader_local_x();
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    if x >= width || y >= words_load(1u32) || words_load(5u32) != 0u32 {
        return;
    }
    var pixel: u32 = y * width + x;
    var hit: u32 = words_load(HIT_FLOAT) + pixel;
    var identity: u32 = words_load(DEBUG_VALUES) + pixel;
    var best: f32 = 0f32;
    var winner: u32 = 0xffffffffu32;
    var selected: u32 = 0xffffffffu32;
    var px: f32 = x as f32 + 0.5f32;
    var py: f32 = y as f32 + 0.5f32;
    var count: u32 = words_load(words_load(TILE_STATS) + tile * 4u32);
    var next: u32 = words_load(words_load(TILE_STATS) + tile * 4u32 + 1u32);
    var capacity: u32 = words_load(words_load(BATCH_WALKERS) + 3u32);
    var nodes: u32 = words_load(words_load(BATCH_WALKERS) + 4u32);
    var i: u32 = 0u32;
    while i < count {
        var id: u32 = 0u32;
        if i < capacity {
            id = words_load(words_load(TILE_BITS) + tile * capacity + i);
        } else {
            id = words_load(nodes + next * 2u32);
            next = words_load(nodes + next * 2u32 + 1u32);
        }
        var p: u32 = words_load(PROJECTED_OFFSET) + id * 20u32;
        var tri: u32 = words_load(words_load(BATCH_PRIMITIVES) + id / MAX_FAN);
        var key: u32 = tri * MAX_FAN + id % MAX_FAN;
        var depth: f32 = candidate_depth(p, px, py);
        if nearer(depth, best, key, winner) && scatter_opaque(id, p, px, py) {
            best = depth;
            winner = key;
            selected = id;
        }
        i = i + 1u32;
    }
    var color: u32 = words_load(BACKGROUND);
    if selected != 0xffffffffu32 {
        var mat: u32 = words_load(words_load(COMPACT_OFFSET) + selected / MAX_FAN * 2u32);
        selected = words_load(PROJECTED_OFFSET) + selected * 20u32;
        var texel: u32 = material_texel(
            mat,
            perspective_sample(selected, px, py, 3u32),
            perspective_sample(selected, px, py, 4u32)
        );
        color = words_load(material_palette(mat) + texel * LIGHT_STATES + LIGHT_STATES - 1u32);
    }
    words_store(words_load(PRESENT_PIXELS) + pixel, color);
    floats_store(hit, best);
    words_store(identity, winner);
}
fn compute() -> unit {
    scatter_pixel();
}
fn scatter_opaque(id: u32, p: u32, px: f32, py: f32) -> bool {
    var slot: u32 = words_load(COMPACT_OFFSET) + id / MAX_FAN * 2u32;
    if (words_load(slot + 1u32) & 1u32) == 0u32 {
        return true;
    }
    var mat: u32 = words_load(slot);
    return material_texel(
        mat,
        perspective_sample(p, px, py, 3u32),
        perspective_sample(p, px, py, 4u32)
    ) != material_field(mat, 9u32);
}
