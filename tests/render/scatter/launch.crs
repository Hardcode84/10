fn compute() -> unit {
    if shader_global_x() == 0u32 {
        var count: u32 = words_load(words_load(BATCH_WALKERS) + 1u32);
        if words_load(5u32) != 0u32 {
            count = 0u32;
        }
        if count > MAX_INVOCATIONS / LOCAL_SIZE {
            count = MAX_INVOCATIONS / LOCAL_SIZE;
        }
        words_store(16u32, count);
        words_store(17u32, 1u32);
        words_store(18u32, 1u32);
    }
}
