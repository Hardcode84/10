fn scatter_open(v: *RenderState) -> bool {
    if ((v -> width + 7u32) / 8u32) * ((v -> height + 7u32) / 8u32) > MAX_INVOCATIONS / LOCAL_SIZE {
        return error("scatter experiment image exceeds dispatch capacity");
    }
    var paths: [*u8; 7] = make [*u8; 7] {
        "build/scatter-init.spv",
        "build/scatter-project.spv",
        "build/scatter-bin.spv",
        "build/scatter-raster.spv",
        "build/scatter-clip.spv",
        "build/scatter-cull.spv",
        "build/scatter-launch.spv"
    };
    var i: usize = 0usize;
    while i < 7usize {
        vkDestroyPipeline(v -> gpu.device, v -> gpu.pipelines[i], null(*u8));
        vkDestroyShaderModule(v -> gpu.device, v -> gpu.modules[i], null(*u8));
        v -> gpu.pipelines[i] = null(*u8);
        v -> gpu.modules[i] = null(*u8);
        if !load_pipeline(v, paths[i], i) {
            return false;
        }
        i = i + 1usize;
    }
    return scatter_ranges(v);
}
fn scatter_batch(v: *RenderState, count: u32, detail: bool) -> unit {
    var tiles: u32 = ((v -> width + 7u32) / 8u32) * ((v -> height + 7u32) / 8u32);
    var init: u32 = tiles;
    retained_dispatch(v, 0usize, (init + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    if detail {
        command_stamp(v, 2u32);
    }
    retained_dispatch(v, 5usize, (count + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    retained_dispatch(v, 1usize, (count * 3u32 + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    retained_dispatch(v, 4usize, (count + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    if detail {
        command_stamp(v, 3u32);
    }
    retained_dispatch(v, 6usize, 1u32);
    command_barrier(v, BARRIER_INDIRECT);
    command_bind(v, 2usize);
    command_indirect(v, 68u64);
    command_barrier(v, BARRIER_COMPUTE);
    if detail {
        command_stamp(v, 4u32);
    }
    retained_dispatch(v, 3usize, tiles);
    command_barrier(v, BARRIER_COMPUTE);
    if detail {
        command_stamp(v, 5u32);
    }
}
fn scatter_record(v: *RenderState, capture_pixels: bool) -> bool {
    if !command_begin(v) {
        return false;
    }
    command_stamp(v, 0u32);
    var w: *u32 = v -> mapped as *u32;
    scatter_batch(v, w[BATCH_COUNT as usize], capture_pixels);
    command_stamp(v, 1u32);
    command_barrier(v, BARRIER_READBACK);
    copy_region(v, v -> buffer, v -> staging, 24u64, 4u64);
    if capture_pixels {
        copy_region(
            v,
            v -> buffer,
            v -> staging,
            (w[PRESENT_PIXELS as usize] as u64 + 1u64) * 4u64,
            v -> width as u64 * v -> height as u64 * 4u64
        );
    }
    command_barrier(v, BARRIER_HOST);
    return command_end(v);
}
fn scatter_draw(v: *RenderState, capture_pixels: bool) -> bool {
    if !command_reset(v) || !scatter_record(v, capture_pixels) || !dispatch(v) {
        return false;
    }
    var status: u32 = (v -> mapped as *u32)[5usize];
    if status == 1u32 {
        return error("scatter experiment projection capacity exceeded");
    }
    if status == 2u32 {
        return error("scatter experiment assignment queue capacity exceeded");
    }
    if status == 3u32 {
        return error("scatter experiment reference pool capacity exceeded");
    }
    return true;
}
fn scatter_report(v: *RenderState) -> bool {
    puts("capture frame GPU ns: clear / cull-project-clip / assign / raster");
    var a: u64 = 0u64;
    if !graphics_time(v, 0u32, &a) {
        return false;
    }
    var order: [u32; 4] = make [u32; 4] {
        2u32,
        3u32,
        4u32,
        5u32
    };
    var i: u32 = 0u32;
    while i < 4u32 {
        var b: u64 = 0u64;
        if !graphics_time(v, order[i as usize], &b) {
            return false;
        }
        print_number(
            (((b - a) & v -> timestamp_mask) as f32 * v -> timestamp_period) as i64
        );
        a = b;
        i = i + 1u32;
    }
    return true;
}
fn scatter_ranges(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var first: u32 = w[BATCH_IDS as usize];
    var count: u32 = 0u32;
    var total: u32 = 0u32;
    var i: u32 = 0u32;
    while i < w[INSTANCE_COUNT as usize] {
        var p: u32 = w[INSTANCE_META as usize] + i * 5u32;
        if w[(p + 3u32) as usize] == w[20usize] && w[(p + 1u32) as usize] != 0u32 {
            if w[(p + 1u32) as usize] > MAX_INVOCATIONS / 3u32 - total || count >= w[
                PROJECTION_CAPACITY as usize
            ] {
                return error("scatter experiment source ranges exceed scratch capacity");
            }
            total = total + w[(p + 1u32) as usize];
            w[(first + count * 2u32) as usize] = total;
            w[(first + count * 2u32 + 1u32) as usize] = w[(p + 2u32) as usize];
            count = count + 1u32;
        }
        i = i + 1u32;
    }
    w[BATCH_COUNT as usize] = total;
    return scatter_upload_ranges(v, first, count, total);
}
fn scatter_upload_ranges(v: *RenderState, first: u32, count: u32, total: u32) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var inline: u32 = 32u32;
    var option: *u8 = benchmark_environment("SPINWARD_SCATTER_INLINE");
    if option != null(*u8) && (
        !game_number(option, &inline) || inline == 0u32 || inline > 128u32
    ) {
        return error("scatter inline capacity must be 1..128");
    }
    var tiles: u32 = ((v -> width + 7u32) / 8u32) * ((v -> height + 7u32) / 8u32);
    if tiles * inline > w[TILE_STATS as usize] - w[TILE_BITS as usize] {
        return error("scatter tile prefixes exceed scratch capacity");
    }
    var nodes: u32 = w[TILE_BITS as usize] + tiles * inline;
    var capacity: u32 = (w[TILE_STATS as usize] - nodes) / 2u32;
    if !scatter_node_limit(&capacity) {
        return false;
    }
    if !command_reset(v) || !command_begin(v) {
        return false;
    }
    command_barrier(v, BARRIER_BEFORE_UPDATE);
    command_word(v, w[BATCH_WALKERS as usize] + 4u32, inline);
    command_word(v, w[BATCH_WALKERS as usize] + 5u32, nodes);
    command_word(v, w[BATCH_WALKERS as usize] + 6u32, capacity);
    command_word(v, BATCH_COUNT + 1u32, total);
    command_word(v, BATCH_CLUSTERS + 1u32, count);
    if count != 0u32 {
        copy_region(
            v,
            v -> staging,
            v -> buffer,
            (first as u64 + 1u64) * 4u64,
            count as u64 * 8u64
        );
    }
    command_barrier(v, BARRIER_UPDATED_COMPUTE);
    return command_end(v) && dispatch(v);
}

fn scatter_node_limit(capacity: *u32) -> bool {
    var option: *u8 = benchmark_environment("SPINWARD_SCATTER_NODES");
    if option == null(*u8) {
        return true;
    }
    var limit: u32 = 0u32;
    if !game_number(option, &limit) || limit > *capacity {
        return error("scatter node limit exceeds scratch capacity");
    }
    * capacity = limit;
    return true;
}
