fn traversal_config(config: *RenderConfig, index: u32) -> unit {
    config -> portal_budget = 96u32;
    config -> view_budget = 128u32;
    config -> task_budget = 1000u32;
    config -> crossing_limit = 1u32;
    if index == 1u32 {
        config -> crossing_limit = 80u32;
    }
    if index == 2u32 {
        config -> crossing_limit = 0u32;
    }
    if index == 3u32 || index == 4u32 {
        config -> portal_budget = 8u32;
        config -> task_budget = 65536u32;
    }
    if index == 4u32 {
        config -> task_budget = 32768u32;
    }
    if index == 5u32 {
        config -> view_budget = 32u32;
    }
    if index == 8u32 {
        config -> portal_budget = 0xffffffffu32;
    }
    if index == 6u32 {
        config -> task_budget = 1u32;
    }
}
fn traversal_result(v: *RenderState, index: u32, drawn: bool) -> bool {
    var w: *u32 = v -> mapped as *u32;
    if index == 7u32 {
        return !drawn && w[5usize] == 0u32 && w[STATUS_REPORT as usize] == 0u32 && w[
            (STATUS_REPORT + 1u32) as usize
        ] == 1u32;
    }
    if index == 9u32 {
        return traversal_tile_result(v, drawn);
    }
    if index >= 4u32 {
        var expected: u32 = 1u32;
        if index == 5u32 {
            expected = 2u32;
        }
        return !drawn && w[5usize] == expected;
    }
    if !drawn {
        return false;
    }
    return traversal_success(v, index);
}
fn traversal_success(v: *RenderState, index: u32) -> bool {
    var w: *u32 = v -> mapped as *u32;
    if index == 0u32 && v -> projection_capacity > GEOMETRY_BATCH_TRIANGLES {
        return error("projection scratch must remain bounded when visible views multiply");
    }
    var views: u32 = 81u32;
    if index == 2u32 {
        views = 1u32;
    }
    if index == 3u32 {
        views = 9u32;
        if w[PEAK_TASKS as usize] != 65536u32 {
            return error("portal split must create 65536 masked tasks");
        }
    }
    if w[11usize] != views {
        print_number(w[11usize] as i64);
        return error("portal path count differs from expected traversal");
    }
    return reference_check(v -> mapped) && presentation_check(v);
}
fn traversal_case(base_options: *Options, index: u32) -> bool {
    var o: Options = *base_options;
    o.frame = index;
    o.width = 128u32;
    o.height = 80u32;
    if index == 3u32 || index == 4u32 {
        o.width = 1024u32;
        o.height = 512u32;
    }
    if index == 9u32 {
        o.width = 8u32;
        o.height = 8u32;
    }
    o.window_width = o.width;
    o.window_height = o.height;
    o.debug_pixels = 1u32;
    o.capture = "build/test-traversal.ppm";
    var renderer: Renderer = renderer_new();
    renderer.state.tile_lists = true;
    var config: RenderConfig = demo_render_config(&o);
    config.shader_checks = index == 7u32 || index == 9u32;
    traversal_config(&config, index);
    var opened: bool = demo_renderer_configured(&renderer.state, &config, null(*u8));
    if index == 8u32 {
        return !opened && renderer.state.buffer == null(*u8) && renderer.state.storage_limit != 0u32;
    }
    if !opened {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        traversal_scene(mut input, index);
    }
    if index == 0u32 {
        traversal_sparse_spaces(&renderer.state);
    }
    var drawn: bool = renderer_draw(&renderer.state);
    if !traversal_result(&renderer.state, index, drawn) {
        return error("portal traversal case failed");
    }
    if index == 4u32 || index == 5u32 {
        (renderer.state.mapped as *u32)[4usize] = 0u32;
        if !renderer_draw(&renderer.state) || !reference_check(renderer.state.mapped) {
            return error("renderer did not recover after rejected portal frame");
        }
    }
    print_number(index as i64);
    return true;
}

fn traversal_sparse_spaces(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    w[20usize] = 0xffffffffu32;
    var i: u32 = 0u32;
    while i < w[3usize] {
        var p: usize = (w[META as usize] + i * 4u32) as usize;
        w[p] = 0xffffffffu32 - w[p] * 314159u32;
        i = i + 1u32;
    }
    i = 0u32;
    while i < v -> portal_capacity {
        var p: usize = (w[PORTAL_META as usize] + i * 4u32) as usize;
        w[p] = 0xffffffffu32 - w[p] * 314159u32;
        w[p + 1usize] = 0xffffffffu32 - w[p + 1usize] * 314159u32;
        i = i + 1u32;
    }
}
fn traversal_test(base_options: *Options) -> bool {
    var i: u32 = 0u32;
    while i < 10u32 {
        if !traversal_case(base_options, i) {
            return false;
        }
        i = i + 1u32;
    }
    puts("portal capacity, cyclic depth, split tasks and overflow checks passed");
    return true;
}

fn traversal_tile_result(v: *RenderState, drawn: bool) -> bool {
    var w: *u32 = v -> mapped as *u32;
    if !drawn || w[PEAK_TASKS as usize] != 64u32 || w[11usize] != 65u32 {
        return error("one tile must produce 64 distinct child masks and views");
    }
    return reference_check(v -> mapped) && presentation_check(v);
}
