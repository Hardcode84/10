extern fn SDL_SetWindowSize(window: *u8, width: i32, height: i32) -> unit = "SDL_SetWindowSize";
extern fn SDL_PumpEvents() -> unit = "SDL_PumpEvents";
extern fn image_delay(ms: u32) -> unit = "SDL_Delay";
fn image_test(base: *Options, windowed: bool) -> bool {
    var o: Options = *base;
    o.width = 257u32;
    o.height = 131u32;
    o.window_width = 257u32;
    o.window_height = 131u32;
    o.capture = "build/test-image.ppm";
    var window: *u8 = null(*u8);
    if windowed && !window_open(&window, o.window_width, o.window_height) {
        return false;
    }
    var good: bool = image_run(&o, window);
    window_close(window);
    if good {
        puts("image capacity, aspect, resize, retained assets and rejection checks passed");
    }
    return good;
}
fn image_run(o: *Options, window: *u8) -> bool {
    var renderer: Renderer = renderer_new();
    var config: RenderConfig = demo_render_config(o);
    config.view_budget = 1u32;
    config.portal_budget = 0u32;
    config.crossing_limit = 0u32;
    config.task_budget = 561u32;
    if !demo_renderer_configured(&renderer.state, &config, window) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        texture_scene(mut input, 0u32);
        retain_scene(mut input);
    }
    if window != null(*u8) {
        return image_window_cases(&renderer.state, window);
    }
    var sizes: [u32; 28] = make [u32; 28] {
        257u32,
        131u32,
        773u32,
        509u32,
        4097u32,
        513u32,
        4097u32,
        513u32,
        3840u32,
        2160u32,
        3840u32,
        2160u32,
        131u32,
        257u32,
        3840u32,
        2160u32,
        1u32,
        4097u32,
        7u32,
        4101u32,
        70001u32,
        2u32,
        90001u32,
        3u32,
        257u32,
        131u32,
        257u32,
        131u32
    };
    var i: usize = 0usize;
    while i < 28usize {
        if !image_resize_case(&renderer.state, &sizes[i]) {
            return false;
        }
        i = i + 4usize;
    }
    return image_rejections(&renderer.state);
}
fn image_resize_case(v: *RenderState, sizes: *u32) -> bool {
    var before: RenderState = *v;
    var pixels: u64 = sizes[0usize] as u64 * sizes[1usize] as u64;
    var output: u64 = sizes[2usize] as u64 * sizes[3usize] as u64;
    var exceeds_range: bool = (PIXELS as u64 + pixels * 5u64 + output) * 4u64 > v -> storage_limit as u64;
    var accepted: bool = renderer_resize(
        v,
        sizes[0usize],
        sizes[1usize],
        sizes[2usize],
        sizes[3usize]
    );
    if exceeds_range {
        if accepted || v -> buffer != before.buffer || v -> words != before.words || v -> width != before.width || v -> height != before.height || v -> output_width != before.output_width || v -> output_height != before.output_height {
            return error("device range rejection changed active image storage");
        }
        puts("image exceeds device storage range: rejection and retained image checked");
    } else if !accepted {
        return false;
    }
    return image_check(v);
}
fn image_check(v: *RenderState) -> bool {
    if !renderer_draw(v) || !reference_check(v -> mapped) || !presentation_check(v) {
        return false;
    }
    var w: *u32 = v -> mapped as *u32;
    if w[INSTANCE_COUNT as usize] == 0u32 || v -> mesh_count == 0u32 || w[MATERIAL_COUNT as usize] == 0u32 {
        return error("resize lost retained scene data");
    }
    return image_pattern(v);
}
fn image_rejections(v: *RenderState) -> bool {
    var saved: *u8 = v -> buffer;
    var words: u32 = v -> words;
    if renderer_resize(v, 0u32, 1u32, 1u32, 1u32) || renderer_resize(
        v,
        0xffffffffu32,
        0xffffffffu32,
        1u32,
        1u32
    ) || renderer_resize(v, 100000u32, 100000u32, 1u32, 1u32) {
        return error("invalid image dimensions were accepted");
    }
    var limit: u32 = v -> storage_limit;
    v -> storage_limit = 65536u32;
    var accepted: bool = renderer_resize(v, 3840u32, 2160u32, 3840u32, 2160u32);
    v -> storage_limit = limit;
    if accepted || v -> buffer != saved || v -> words != words || v -> width != 257u32 || v -> height != 131u32 {
        return error("rejected resize changed active storage");
    }
    return image_check(v);
}
fn image_window_size(window: *u8, width: u32, height: u32) -> bool {
    SDL_SetWindowSize(window, width as i32, height as i32);
    var attempt: u32 = 0u32;
    while attempt < 100u32 {
        SDL_PumpEvents();
        var w: i32 = 0i32;
        var h: i32 = 0i32;
        window_extent(window, &w, &h);
        if w == width as i32 && h == height as i32 {
            return true;
        }
        image_delay(10u32);
        attempt = attempt + 1u32;
    }
    return error("window did not reach the requested test size");
}
fn image_window_cases(v: *RenderState, window: *u8) -> bool {
    var sizes: [u32; 8] = make [u32; 8] {
        773u32,
        509u32,
        301u32,
        701u32,
        2049u32,
        1153u32,
        257u32,
        131u32
    };
    var i: usize = 0usize;
    while i < 8usize {
        if !image_window_frame(v, window, sizes[i], sizes[i + 1usize]) {
            return false;
        }
        if v -> width != 257u32 || v -> height != 131u32 || v -> output_width != sizes[i] || v -> output_height != sizes[
            i + 1usize
        ] {
            return error("window resize changed the internal resolution");
        }
        v -> swapchain_dirty = true;
        if !window_draw(v, window) || !present(v) {
            return false;
        }
        i = i + 2usize;
    }
    return true;
}

fn image_pattern(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var count: u32 = v -> width * v -> height;
    var i: u32 = 0u32;
    while i < count {
        w[(PIXELS + i) as usize] = 0xff000000u32 | ((i * 13u32) & 0xffffffu32);
        i = i + 1u32;
    }
    i = 0u32;
    while i < v -> output_width * v -> output_height {
        w[(w[PRESENT_PIXELS as usize] + i) as usize] = 0x12345678u32;
        i = i + 1u32;
    }
    if !vk_ok(
        vkResetCommandBuffer(v -> gpu.commands, 0u32),
        "reset image pattern commands"
    ) {
        return false;
    }
    var begin: VkCommandBufferBeginInfo = uninit;
    zero(&begin as *u8, sizeof(VkCommandBufferBeginInfo));
    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    if !vk_ok(
        vkBeginCommandBuffer(v -> gpu.commands, &begin),
        "begin image pattern commands"
    ) {
        return false;
    }
    copy_region(
        v,
        v -> staging,
        v -> buffer,
        (PIXELS as u64 + 1u64) * 4u64,
        (count as u64 + v -> output_width as u64 * v -> output_height as u64) * 4u64
    );
    frame_barrier(v, 4096u32, 4096u32, 2048u32, 96u32);
    vkCmdBindDescriptorSets(
        v -> gpu.commands,
        VK_PIPELINE_BIND_POINT_COMPUTE,
        v -> gpu.pipeline_layout,
        0u32,
        1u32,
        &v -> gpu.set,
        0u32,
        null(*u32)
    );
    retained_dispatch(v, 4usize, (v -> output_width * v -> output_height + 63u32) / 64u32);
    frame_barrier(v, 2048u32, 64u32, 4096u32, 2048u32);
    readback(v);
    return vk_ok(vkEndCommandBuffer(v -> gpu.commands), "end image pattern commands") && dispatch(
        v
    ) && frame_valid(v) && presentation_check(v);
}

fn image_window_frame(v: *RenderState, window: *u8, width: u32, height: u32) -> bool {
    return renderer_draw(v) && image_window_size(window, width, height) && present(v) && window_draw(
        v,
        window
    ) && presentation_check(v) && reference_check(v -> mapped) && present(v);
}
