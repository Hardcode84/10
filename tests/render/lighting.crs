fn lighting_wall(v: mut FrameInput, index: u32) -> unit {
    if index == 0u32 || index == 5u32 || index == 6u32 || index == 8u32 {
        return;
    }
    var space: u32 = 0u32;
    if index == 3u32 {
        space = 1u32;
    }
    var flags: u32 = 2u32;
    if index == 7u32 {
        flags = 6u32;
    }
    if index == 2u32 {
        flags = 3u32;
    }
    var y: f32 = 20f32;
    if index >= 9u32 {
        y = -20f32;
    }
    if index == 10u32 {
        flags = 0u32;
    }
    quad(
        mut v,
        space,
        1u32,
        0u32,
        flags,
        2f32,
        -y,
        -20f32,
        2f32,
        y,
        -20f32,
        2f32,
        y,
        20f32,
        2f32,
        -y,
        20f32
    );
}
fn lighting_scene(v: mut FrameInput, index: u32) -> unit {
    texture_scene(mut v, 0u32);
    input_set_word(mut v, INSTANCE_COUNT as usize, 0u32);
    input_set_word(mut v, 3usize, 0u32);
    var material: u32 = 0u32;
    while material < 2u32 {
        input_asset_set(mut v, material * MATERIAL_WORDS + 1u32, 1u32);
        input_asset_set(mut v, material * MATERIAL_WORDS + 2u32, 1u32);
        input_asset_set(mut v, material * MATERIAL_WORDS, 320u32 + material);
        material = material + 1u32;
    }
    input_texel(mut v, 320u32, 100u32);
    input_texel(mut v, 321u32, 0u32);
    if index == 6u32 {
        input_texel(mut v, 320u32, 255u32);
    }
    var channel: u32 = 0u32;
    while channel < 3u32 {
        input_set_float(mut v, (SPACE_LIGHT + channel) as usize, 0f32);
        channel = channel + 1u32;
    }
    if !input_lights(mut v, 17u32) {
        trap;
    }
    var i: u32 = 0u32;
    while i < 17u32 {
        var strength: f32 = 0f32;
        if i == 16u32 && index != 6u32 {
            strength = 2f32;
        }
        var x: f32 = 4f32;
        if index == 5u32 {
            x = 100000f32;
        }
        tour_light(mut v, i, 0u32, x, 0f32, 3f32, 100f32, strength, strength, strength);
        i = i + 1u32;
    }
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -20f32,
        -20f32,
        6f32,
        20f32,
        -20f32,
        6f32,
        20f32,
        20f32,
        6f32,
        -20f32,
        20f32,
        6f32
    );
    lighting_shadow_tree(mut v);
    lighting_wall(mut v, index);
    if index == 8u32 {
        lighting_large_space(mut v);
    }
    if index == 4u32 || index == 11u32 {
        retain_scene(mut v);
    }
}
fn lighting_test(base: *Options) -> bool {
    var o: Options = *base;
    o.width = 64u32;
    o.height = 48u32;
    o.window_width = 64u32;
    o.window_height = 48u32;
    o.capture = "build/test-lighting.ppm";
    var renderer: Renderer = renderer_new();
    var config: RenderConfig = demo_render_config(&o);
    config.view_budget = 1u32;
    config.portal_budget = 0u32;
    config.crossing_limit = 0u32;
    config.task_budget = 64u32;
    if !demo_renderer_configured(&renderer.state, &config, null(*u8)) {
        return false;
    }
    var index: u32 = 0u32;
    while index < 12u32 {
        {
            var input: FrameInput = renderer_inputs(mut renderer);
            lighting_scene(mut input, index);
        }
        if !renderer_draw(&renderer.state) || !reference_check(renderer.state.mapped) {
            return false;
        }
        var w: *u32 = renderer.state.mapped as *u32;
        var color: u32 = w[(PIXELS + 24u32 * 64u32 + 24u32) as usize] & 0xffffffu32;
        var dark: bool = index == 1u32 || index == 4u32 || index == 5u32 || index == 10u32;
        if (color == 0u32) != dark {
            print_number(index as i64);
            return error("bulkhead lighting differs from expected visibility");
        }
        if (index == 0u32 || index == 8u32) && !lighting_resize(mut renderer) {
            return false;
        }
        index = index + 1u32;
    }
    if !portable_lights_test(base) || !lighting_cache_test(mut renderer) || !lighting_shared_ambient(
        mut renderer
    ) {
        return false;
    }
    puts(
        "light occlusion, cutouts, space isolation, retained blockers, distant lights and 17 lights passed"
    );
    return lighting_capacity_reuse(mut renderer);
}
fn lighting_rejections(renderer: mut Renderer) -> bool {
    var capacity: u32 = renderer.state.light_capacity;
    var words: u32 = renderer.state.words;
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if input_lights(mut input, 0xffffffffu32) {
            return error("unaddressable light storage was accepted");
        }
    }
    if renderer.state.light_capacity != capacity || renderer.state.words != words {
        return error("rejected light growth changed active storage");
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        input_set_word(mut input, LIGHT_COUNT as usize, capacity + 1u32);
    }
    if renderer_draw(&renderer.state) {
        return error("unreserved light count was accepted");
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !input_lights(mut input, 1u32) {
            return false;
        }
        var p: usize = input_word(read input, LIGHT_DATA as usize) as usize;
        input_set_float(mut input, p + 3usize, -1f32);
    }
    if renderer_draw(&renderer.state) {
        return error("negative light radius was accepted");
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !input_lights(mut input, 0u32) {
            return false;
        }
    }
    return renderer_draw(&renderer.state) && reference_check(renderer.state.mapped);
}
fn lighting_resize(renderer: mut Renderer) -> bool {
    if !renderer_resize(&renderer.state, 65u32, 48u32, 65u32, 48u32) || !renderer_draw(
        &renderer.state
    ) || !reference_check(renderer.state.mapped) {
        return false;
    }
    var w: *u32 = renderer.state.mapped as *u32;
    if (w[(PIXELS + 24u32 * 65u32 + 32u32) as usize] & 0xffffffu32) == 0u32 {
        return error("resize lost the contributing light");
    }
    return renderer_resize(&renderer.state, 64u32, 48u32, 64u32, 48u32);
}
fn lighting_shared_ambient(renderer: mut Renderer) -> bool {
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_scene(mut input, 0u32);
        input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
        input_set_word(mut input, SHARED_AMBIENT as usize, 0u32);
        input_set_float(mut input, CAMERA_LIGHT as usize, 0f32);
        input_set_float(mut input, SPACE_LIGHT as usize, 0.4f32);
        input_set_float(mut input, (SPACE_LIGHT + 1u32) as usize, 0.6f32);
        input_set_float(mut input, (SPACE_LIGHT + 2u32) as usize, 0.8f32);
    }
    if !renderer_draw(&renderer.state) {
        return false;
    }
    var pixels: [u32; 3072] = uninit;
    memcpy(
        &pixels as *u8,
        renderer.state.mapped + PIXELS as isize * 4isize,
        sizeof([u32; 3072])
    );
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        input_set_word(mut input, SHARED_AMBIENT as usize, 1u32);
        input_set_word(mut input, 20usize, 73u32);
        var i: u32 = 0u32;
        while i < input_word(read input, 3usize) {
            var offset: usize = (input_word(read input, META as usize) + i * 4u32) as usize;
            input_set_word(mut input, offset, 73u32);
            i = i + 1u32;
        }
    }
    if !renderer_draw(&renderer.state) {
        return false;
    }
    return memcmp(
        &pixels as *u8,
        renderer.state.mapped + PIXELS as isize * 4isize,
        sizeof([u32; 3072])
    ) == 0i32 || error("shared ambient changed when the room ID exceeded the ambient table");
}

fn lighting_large_space(input: mut FrameInput) -> unit {
    input_set_word(mut input, SHARED_AMBIENT as usize, 1u32);
    input_set_word(mut input, 20usize, 0xfffffffeu32);
    var i: u32 = 0u32;
    while i < input_word(read input, LIGHT_COUNT as usize) {
        input_light_space(mut input, i, 0xfffffffeu32);
        i = i + 1u32;
    }
    i = 0u32;
    while i < input_word(read input, 3usize) {
        var meta: usize = (input_word(read input, META as usize) + i * 4u32) as usize;
        input_set_word(mut input, meta, 0xfffffffeu32);
        i = i + 1u32;
    }
}

fn lighting_shadow_tree(input: mut FrameInput) -> unit {
    var i: u32 = 0u32;
    while i < 16u32 {
        var x: f32 = 40f32 + i as f32 * 3f32;
        quad(
            mut input,
            0u32,
            0u32,
            0u32,
            0u32,
            x,
            -1f32,
            3f32,
            x + 1f32,
            -1f32,
            3f32,
            x + 1f32,
            1f32,
            3f32,
            x,
            1f32,
            3f32
        );
        i = i + 1u32;
    }
}

fn lighting_cache_shift(input: mut FrameInput, dynamic: bool) -> unit {
    var instances: u32 = input_word(read input, INSTANCE_COUNT as usize);
    var total: u32 = input_word(read input, 3usize);
    var previous: u32 = input_word(read input, DYNAMIC_COUNT as usize);
    var count: u32 = (dynamic as u32) * 2u32;
    input_frame(mut input);
    if dynamic {
        quad(
            mut input,
            0u32,
            0u32,
            0u32,
            4u32,
            100f32,
            0f32,
            3f32,
            101f32,
            0f32,
            3f32,
            101f32,
            1f32,
            3f32,
            100f32,
            1f32,
            3f32
        );
    }
    input_set_word(mut input, DYNAMIC_COUNT as usize, count);
    input_set_word(mut input, INSTANCE_COUNT as usize, instances);
    input_set_word(mut input, 3usize, total - previous + count);
    var i: u32 = 0u32;
    while i < instances {
        var p: usize = (input_word(read input, INSTANCE_META as usize) + i * 5u32 + 2u32) as usize;
        var first: u32 = input_word(read input, p);
        input_set_word(mut input, p, first - previous + count);
        i = i + 1u32;
    }
}
fn lighting_cache_move(input: mut FrameInput) -> unit {
    var count: u32 = input_word(read input, INSTANCE_COUNT as usize);
    var i: u32 = count - 2u32;
    while i < count {
        var p: usize = (input_word(read input, INSTANCE_FLOAT as usize) + i * 18u32) as usize;
        var x: f32 = input_float(read input, p + 3usize);
        input_set_float(mut input, p + 3usize, x + 100f32);
        var low: f32 = input_float(read input, p + 12usize);
        var high: f32 = input_float(read input, p + 15usize);
        input_set_float(mut input, p + 12usize, low + 100f32);
        input_set_float(mut input, p + 15usize, high + 100f32);
        i = i + 1u32;
    }
}
fn lighting_cache_check(renderer: mut Renderer, rebuild: bool) -> bool {
    if !renderer_draw(&renderer.state) || !reference_check(renderer.state.mapped) {
        return false;
    }
    var w: *u32 = renderer.state.mapped as *u32;
    return (w[SHADOW_RESET as usize] != 0u32) == rebuild || error(
        "shadow tree reuse differs from the submission contract"
    );
}
fn lighting_cache_test(renderer: mut Renderer) -> bool {
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_scene(mut input, 4u32);
    }
    if !lighting_cache_check(mut renderer, true) || !lighting_cache_check(mut renderer, false) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_shift(mut input, true);
    }
    // Force replacement; index shifts can now fit in spare capacity.
    if !lighting_cache_growth(mut renderer) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_shift(mut input, false);
    }
    if !lighting_cache_check(mut renderer, false) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_shift(mut input, true);
    }
    if !lighting_cache_check(mut renderer, false) || !lighting_cache_source(mut renderer) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_move(mut input);
    }
    if !lighting_cache_check(mut renderer, true) || !lighting_cache_check(mut renderer, false) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        var count: u32 = input_word(read input, INSTANCE_COUNT as usize);
        input_set_word(mut input, INSTANCE_COUNT as usize, count - 2u32);
        var total: u32 = input_word(read input, 3usize);
        input_set_word(mut input, 3usize, total - 2u32);
    }
    if !lighting_cache_check(mut renderer, true) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        var count: u32 = input_word(read input, INSTANCE_COUNT as usize);
        input_set_word(mut input, INSTANCE_COUNT as usize, count + 2u32);
        var total: u32 = input_word(read input, 3usize);
        input_set_word(mut input, 3usize, total + 2u32);
    }
    if !lighting_cache_check(mut renderer, true) {
        return false;
    }
    if !renderer_resize(&renderer.state, 65u32, 48u32, 65u32, 48u32) || !lighting_cache_check(
        mut renderer,
        true
    ) {
        return false;
    }
    return renderer_resize(&renderer.state, 64u32, 48u32, 64u32, 48u32);
}

fn lighting_cache_flags(input: mut FrameInput, flags: u32) -> unit {
    var count: u32 = input_word(read input, INSTANCE_COUNT as usize);
    var i: u32 = count - 2u32;
    while i < count {
        var p: usize = (input_word(read input, INSTANCE_META as usize) + i * 5u32) as usize;
        var mesh: u32 = input_word(read input, p);
        var meta: usize = (input_word(read input, MESH_META as usize) + mesh * 4u32 + 2u32) as usize;
        input_set_word(mut input, meta, flags);
        i = i + 1u32;
    }
}
fn lighting_cache_source(renderer: mut Renderer) -> bool {
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_flags(mut input, 6u32);
    }
    if !lighting_cache_check(mut renderer, true) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        lighting_cache_flags(mut input, 2u32);
    }
    return lighting_cache_check(mut renderer, true);
}

fn lighting_capacity_reuse(renderer: mut Renderer) -> bool {
    var count: u32 = (renderer.state.mapped as *u32)[LIGHT_COUNT as usize];
    var requested: u32 = renderer.state.light_capacity + 1u32;
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !input_lights(mut input, requested) {
            return false;
        }
    }
    var allocation: *u8 = renderer.state.mapped;
    {
        var input: FrameInput = renderer_inputs(mut renderer);
        if !input_lights(mut input, requested + 1u32) {
            return false;
        }
        input_set_word(mut input, LIGHT_COUNT as usize, count);
    }
    if renderer.state.mapped != allocation {
        return error("one additional light replaced the scene allocation after growth");
    }
    var triangles: u32 = renderer.state.triangle_capacity + 17u32;
    if !geometry_reserve(&renderer.state, triangles) {
        return false;
    }
    allocation = renderer.state.mapped;
    if !geometry_reserve(&renderer.state, triangles + 1u32) {
        return false;
    }
    return renderer.state.mapped == allocation || error(
        "one additional triangle replaced the scene allocation after growth"
    );
}

fn lighting_cache_growth(renderer: mut Renderer) -> bool {
    return geometry_reserve(&renderer.state, renderer.state.triangle_capacity + 1u32) && lighting_cache_check(
        mut renderer,
        true
    );
}
