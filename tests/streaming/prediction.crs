fn stream_prediction_equal(a: read Prediction, b: read Prediction) -> bool {
    if a.admission.status != b.admission.status || a.admission.space != b.admission.space || a.count != b.count || a.attempt != b.attempt || a.source_tick != b.source_tick || a.full_spin != b.full_spin {
        return false;
    }
    var i: u32 = 0u32;
    while i < a.count {
        var x: PredictionMarker = a.markers[i as usize];
        var y: PredictionMarker = b.markers[i as usize];
        if x.eye.world != y.eye.world || x.eye.factor != y.eye.factor || x.material != y.material || length(
            sub(x.center, y.center)
        ) != 0f32 || length(sub(x.eye.position, y.eye.position)) != 0f32 {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
// Worker and display snapshots retain geometry while the source room unloads.
fn stream_prediction(
    scene: mut CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    selected: mut GenerationWords
) -> bool {
    loop.trial.drone.velocity = scale(loop.trial.drone.basis.forward, 10f32);
    hook_launch(mut loop.trial.drone);
    var pool: TaskPool = task_pool_new();
    if !task_pool_open(mut pool, 1u32, 2u32) {
        return false;
    }
    var context: PredictionContext = prediction_context(
        read pool,
        read scene,
        graph_doors(read session.control.graph)
    );
    if !prediction_context_ready(read context) {
        return false;
    }
    var scratch: Drone = new_drone();
    var doors: DoorSet = doors_new();
    if !doors_copy(graph_doors(read session.control.graph), mut doors) {
        return false;
    }
    var expected: Prediction = predict_scene(
        read scene,
        read loop.trial,
        mut scratch,
        mut doors
    );
    stream_visibility(
        read session.control.graph,
        loop.trial.drone.world,
        loop.trial.drone.position,
        2u32,
        mut selected
    );
    return stream_prediction_unload(
        mut scene,
        mut session,
        read loop,
        config,
        read selected,
        mut context,
        read expected
    );
}
fn stream_prediction_complete(work: mut PredictionTask, expected: read Prediction) -> bool {
    while prediction_task_poll(read work) == 0i32 {
        prediction_task_idle(read work);
    }
    if prediction_task_poll(read work) != 1i32 {
        return error("streaming forecast task failed");
    }
    var actual: Prediction = prediction_task_result(mut work);
    if expected.count == 0u32 || !stream_prediction_equal(read expected, read actual) {
        return error("streaming forecast changed across room unload");
    }
    puts("forecast_markers");
    stream_number(actual.count as u64, true);
    return true;
}

fn stream_prediction_unload(
    scene: mut CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    selected: read GenerationWords,
    context: mut PredictionContext,
    expected: read Prediction
) -> bool {
    var pixels: GenerationWords = generation_words_new();
    if !generation_words_allocate(mut pixels, config.width * config.height) || !stream_upload(
        mut session,
        read selected
    ) || !stream_draw(read scene, mut session, read loop, config) {
        return false;
    }
    stream_pixels(
        &session.renderer.state,
        mut pixels,
        config.width * config.height,
        true
    );
    var display: CollisionScene = collision_new();
    var start: u64 = now();
    if !collision_snapshot(read scene, mut display) {
        return false;
    }
    var elapsed: u64 = now() - start;
    var pin: CollisionRoom = collision_room_pin(read scene, loop.trial.drone.world);
    var bytes: u64 = collision_bytes(read scene);
    collision_room_unload(mut scene, loop.trial.drone.world);
    if collision_room_resident(read scene, loop.trial.drone.world) {
        return error("forecast source room did not unload");
    }
    var released: u64 = bytes - collision_bytes(read scene);
    var work: PredictionTask = prediction_start(mut context, read scene, read loop.trial);
    var good: bool = stream_draw(read display, mut session, read loop, config);
    var predicted: bool = stream_prediction_complete(mut work, read expected);
    collision_room_restore(mut scene, read pin);
    if !good || !predicted {
        return false;
    }
    var changed: u32 = stream_pixels(
        &session.renderer.state,
        mut pixels,
        config.width * config.height,
        false
    );
    puts(
        "snapshot_ns,snapshot_private_bytes,referenced_geometry_bytes,unloaded_room_bytes,pixel_changes"
    );
    var geometry: u64 = collision_chunks_bytes(read display) - display.chunk_count as u64 * sizeof(
        *CollisionChunk
    ) as u64;
    stream_number(elapsed, false);
    stream_number(collision_bytes(read display) - geometry, false);
    stream_number(geometry, false);
    stream_number(released, false);
    stream_number(changed as u64, true);
    return changed == 0u32 || error("room unload changed a retained display snapshot");
}
