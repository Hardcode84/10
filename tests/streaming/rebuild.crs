// Bounded worker witness for unchanged shaft-region recipes.
resource StreamRebuild {
    plan: CollisionRebuild;
    mesh: Mesh;
    room: CollisionRoom;
    recipe: RoomRecipe;
    space: u32;
    first_portal: u32;
    elapsed: u64;
    revision: u64;
}
opaque drop stream_rebuild_drop;
fn stream_rebuild_drop(work: mut StreamRebuild) -> unit {}
record RebuildWork {
    value: *StreamRebuild;
}
opaque send;
fn stream_rebuild_step(state: mut RebuildWork, context: read Context) -> Step {
    return game_step(stream_rebuild_execute(state.value));
}
fn stream_rebuild_execute(work: *StreamRebuild) -> bool {
    var start: u64 = now();
    var replay: RoomReplay = room_replay_new();
    var builder: CollisionBuilder = collision_builder_new();
    if !room_recipe_build(
        read work -> recipe,
        work -> space,
        work -> first_portal,
        mut builder,
        mut replay
    ) {
        return false;
    }
    mesh_swap(mut work -> mesh, mut replay.mesh);
    return stream_rebuild_finish(work, move builder, start);
}
fn stream_rebuild_finish(work: *StreamRebuild, builder: CollisionBuilder, start: u64) -> bool {
    if !collision_rebuild_finish(read work -> plan, move builder, mut work -> room) {
        return false;
    }
    work -> elapsed = now() - start;
    return true;
}
fn stream_rebuild_select(scene: read CollisionScene, graph: read RoomGraph, drone: mut Drone) -> u32 {
    var i: u32 = 0u32;
    while i < graph_count(read graph) {
        var node: GraphNode = graph_node(read graph, i);
        if node.kind == PREFAB_SHAFT_STATION && stream_camera(
            read scene,
            read graph,
            node.first,
            mut drone
        ) {
            drone.basis.forward = scale(drone.basis.forward, -1f32);
            drone.basis.right = scale(drone.basis.right, -1f32);
            return i;
        }
        i = i + 1u32;
    }
    error("reload witness requires a shaft-region station");
    trap;
}
fn stream_rebuild_upload(session: mut GameSession, target: u32, mesh: read Mesh) -> bool {
    instances_clear(mut session.world);
    var input: FrameInput = renderer_inputs(mut session.renderer);
    input_clear_meshes(mut input);
    var i: u32 = 0u32;
    while i < graph_count(read session.control.graph) {
        var range: MeshRange = mesh_empty_range();
        var source: MeshRange = graph_node(read session.control.graph, i).mesh;
        var good: bool = false;
        if i == target {
            good = input_mesh_slice(
                mut input,
                read mesh,
                0u32,
                mesh_triangle_count(read mesh),
                mut range
            );
        } else {
            good = input_mesh_slice(
                mut input,
                read session.room_mesh,
                source.first,
                source.count,
                mut range
            );
        }
        if !good || !instances_append(mut session.world, mesh_identity(range, i)) {
            return false;
        }
        i = i + 1u32;
    }
    return graph_doors_upload(mut session.control.graph, mut input);
}
fn stream_rebuild_hook(scene: read CollisionScene, drone: mut Drone) -> bool {
    var axis: u32 = 0u32;
    while axis < 6u32 {
        var direction: Vec3 = axis_vector(axis / 2u32);
        if axis % 2u32 != 0u32 {
            direction = scale(direction, -1f32);
        }
        var hit: CollisionSweep = collision_local_sweep_interval(
            read scene,
            drone.world,
            drone.position,
            scale(direction, 1000f32),
            HOOK_RADIUS,
            0f32,
            STEP
        );
        if hit.status == 0u32 && hit.contact.hit.time <= 1f32 {
            hook_attach(read scene, mut drone, read hit, 0f32, 0f32);
            return true;
        }
        axis = axis + 1u32;
    }
    return error("reload witness could not attach a hook");
}
fn stream_rebuild_worker(
    scene: mut CollisionScene,
    loop: read GameLoop,
    work: mut StreamRebuild,
    session: mut GameSession,
    config: GameConfig,
    pixels: mut GenerationWords
) -> bool {
    var pool: Scheduler = scheduler_new();
    var display: CollisionScene = collision_new();
    var rooms: CollisionRooms = collision_rooms_new();
    if !scheduler_open(mut pool, 2u32) || !collision_snapshot(read scene, mut display) || !stream_rebuild_required(
        read scene,
        mut rooms
    ) {
        return false;
    }
    var context: PredictionContext = prediction_context(
        read pool,
        read scene,
        read session.control.graph.doors
    );
    if !prediction_context_ready(read context) {
        return false;
    }
    var scratch: Drone = new_drone();
    var expected: Prediction = predict_paths(read scene, read loop.trial, mut scratch);
    collision_room_unload(mut scene, work.space);
    if !stream_rebuild_blocked(read scene, mut display, read rooms, work.space) || !stream_rebuild_paused(
        read scene,
        read loop.trial.drone
    ) {
        return false;
    }
    work.revision = 1u64;
    var scope: Scope = scope_new();
    if !scope_open(mut scope, read pool) {
        return false;
    }
    var submit: Context = scope_context(read scope);
    var build: Task!(RebuildWork) = spawn!(RebuildWork)(
        read submit,
        make RebuildWork {
            value: &work
        },
        stream_rebuild_step,
        deps_new()
    );
    var revision: u64 = work.revision + 1u64;
    var forecast: PredictionTask = prediction_start(mut context, read scene, read loop.trial);
    if !stream_rebuild_display(read display, mut session, read loop, config, mut pixels) || !stream_rebuild_wait(
        read build,
        read forecast
    ) {
        return false;
    }
    var actual: Prediction = prediction_task_result(mut forecast);
    if !stream_prediction_equal(read actual, read expected) {
        return error("room reload changed pinned prediction");
    }
    drop forecast;
    drop build;
    if !stream_rebuild_obsolete(mut scene, mut display, read rooms, mut work, revision) {
        return false;
    }
    work.revision = revision;
    return stream_rebuild_retry(
        mut scene,
        mut display,
        read rooms,
        read pool,
        mut work,
        read loop,
        read expected,
        revision
    );
}
fn stream_rebuild_wait(build: read Task!(RebuildWork), forecast: read PredictionTask) -> bool {
    while rebuild_status(read build) == 0i32 || prediction_task_poll(read forecast) == 0i32 {
        rebuild_pause(read build);
    }
    return (
        rebuild_status(read build) == 1i32 && prediction_task_poll(read forecast) == 1i32
    ) || error("room reload worker failed");
}
fn stream_rebuild_retry(
    scene: mut CollisionScene,
    display: mut CollisionScene,
    rooms: read CollisionRooms,
    pool: read Scheduler,
    work: mut StreamRebuild,
    loop: read GameLoop,
    expected: read Prediction,
    revision: u64
) -> bool {
    var scope: Scope = scope_new();
    if !scope_open(mut scope, read pool) {
        return false;
    }
    var submit: Context = scope_context(read scope);
    var build: Task!(RebuildWork) = spawn!(RebuildWork)(
        read submit,
        make RebuildWork {
            value: &work
        },
        stream_rebuild_step,
        deps_new()
    );
    while rebuild_status(read build) == 0i32 {
        rebuild_pause(read build);
    }
    if rebuild_status(read build) != 1i32 {
        return error("room retry worker failed");
    }
    drop build;
    var bytes: u64 = collision_chunk_bytes(work.room.chunk);
    if work.room.chunk -> references != 1i32 || !stream_rebuild_publish(
        mut scene,
        read work,
        revision
    ) {
        return error("fresh room result could not publish");
    }
    var admitted: CollisionAdmission = collision_snapshot_admit(
        read scene,
        mut display,
        read rooms
    );
    if admitted.status != 0u32 {
        return error("fresh room result did not unblock admission");
    }
    var scratch: Drone = new_drone();
    var actual: Prediction = predict_paths(read display, read loop.trial, mut scratch);
    puts("rejected_results,worker_build_ns,new_chunk_bytes");
    stream_number(1u64, false);
    stream_number(work.elapsed, false);
    stream_number(bytes, true);
    return stream_prediction_equal(read actual, read expected) || error(
        "admitted rebuilt collision changed prediction"
    );
}
fn rebuild_status(task: read Task!(RebuildWork)) -> i32 {
    var event: Event = task_event!(RebuildWork)(read task);
    return game_event_status(read event);
}
fn rebuild_pause(task: read Task!(RebuildWork)) -> unit {
    var event: Event = task_event!(RebuildWork)(read task);
    event_pause(read event);
}
