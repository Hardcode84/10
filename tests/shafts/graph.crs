fn shaft_test_arc(
    adjacency: mut GenerationWords,
    degree: mut GenerationWords,
    a: u32,
    b: u32
) -> unit {
    var count: u32 = generation_word(read degree, a);
    generation_word_set(mut adjacency, a * 6u32 + count, b);
    generation_word_set(mut degree, a, count + 1u32);
}
fn shaft_test_unit(
    adjacency: mut GenerationWords,
    degree: mut GenerationWords,
    a: u32,
    b: u32
) -> unit {
    shaft_test_arc(mut adjacency, mut degree, a, b);
    shaft_test_arc(mut adjacency, mut degree, b, a);
}
// Build a separate unit-edge adjacency list from passage records.
fn shaft_test_distances(grid: read ShaftGrid, source: u32, distances: mut GenerationWords) -> bool {
    var adjacency: GenerationWords = generation_words_new();
    var degree: GenerationWords = generation_words_new();
    var queue: GenerationWords = generation_words_new();
    if !generation_words_allocate(mut adjacency, shaft_grid_nodes() * 6u32) || !generation_words_allocate(
        mut degree,
        shaft_grid_nodes()
    ) || !generation_words_allocate(mut queue, shaft_grid_nodes()) {
        return false;
    }
    generation_words_fill(mut degree, 0u32);
    generation_words_fill(mut distances, SHAFT_GRID_NONE);
    var i: u32 = 0u32;
    while i < shaft_grid_edges() {
        var edge: ShaftPassage = shaft_passage(read grid, i);
        if edge.open {
            var previous: u32 = edge.a;
            var part: u32 = 1u32;
            while part < edge.cost {
                var next: u32 = shaft_grid_stations() + i * (SHAFT_GRID_SUBDIVISIONS - 1u32) + part - 1u32;
                shaft_test_unit(mut adjacency, mut degree, previous, next);
                previous = next;
                part = part + 1u32;
            }
            shaft_test_unit(mut adjacency, mut degree, previous, edge.b);
        }
        i = i + 1u32;
    }
    generation_word_set(mut distances, source, 0u32);
    generation_word_set(mut queue, 0u32, source);
    var head: u32 = 0u32;
    var tail: u32 = 1u32;
    while head < tail {
        var node: u32 = generation_word(read queue, head);
        head = head + 1u32;
        var distance: u32 = generation_word(read distances, node) + 1u32;
        i = 0u32;
        while i < generation_word(read degree, node) {
            var next: u32 = generation_word(read adjacency, node * 6u32 + i);
            if generation_word(read distances, next) == SHAFT_GRID_NONE {
                generation_word_set(mut distances, next, distance);
                generation_word_set(mut queue, tail, next);
                tail = tail + 1u32;
            }
            i = i + 1u32;
        }
    }
    return true;
}
fn shaft_test_reached(grid: read ShaftGrid, distances: read GenerationWords) -> bool {
    var i: u32 = 0u32;
    while i < shaft_grid_stations() {
        if shaft_station(read grid, i).reached != (
            generation_word(read distances, i) != SHAFT_GRID_NONE
        ) {
            return error("selected station reachability");
        }
        i = i + 1u32;
    }
    return true;
}
fn shaft_test_path(grid: read ShaftGrid, length: u32) -> bool {
    var visited: GenerationWords = generation_words_new();
    if !generation_words_allocate(mut visited, shaft_grid_stations()) {
        return false;
    }
    generation_words_fill(mut visited, 0u32);
    var cost: u32 = 0u32;
    var i: u32 = 0u32;
    while i < shaft_grid_path_count(read grid) {
        var node: u32 = shaft_grid_path(read grid, i);
        if generation_word(read visited, node) != 0u32 {
            return error("main route repeats a station");
        }
        generation_word_set(mut visited, node, 1u32);
        if i != 0u32 {
            var previous: u32 = shaft_grid_path(read grid, i - 1u32);
            var edge: ShaftPassage = shaft_passage(
                read grid,
                shaft_grid_between(previous, node)
            );
            if !edge.open || !edge.required {
                return error("main route misses a passage");
            }
            cost = cost + edge.cost;
        }
        i = i + 1u32;
    }
    return cost == length || error("main route length is not exact");
}
fn shaft_test_branch(grid: read ShaftGrid, root: u32, first: u32, limit: u32) -> bool {
    var previous: u32 = root;
    var current: u32 = first;
    var length: u32 = 0u32;
    while current != SHAFT_GRID_NONE {
        length = length + 1u32;
        if length > limit {
            return error("dead end exceeds length limit");
        }
        var next: u32 = SHAFT_GRID_NONE;
        var incident: [u32; 6] = shaft_grid_incident(current);
        var slot: u32 = 0u32;
        while slot < 6u32 {
            var id: u32 = incident[slot as usize];
            if id != SHAFT_GRID_NONE {
                var edge: ShaftPassage = shaft_passage(read grid, id);
                var other: u32 = edge.a;
                if other == current {
                    other = edge.b;
                }
                if edge.open && other != previous {
                    if edge.required || next != SHAFT_GRID_NONE || edge.cost != 1u32 {
                        return error("dead end forks or joins the main route");
                    }
                    next = other;
                }
            }
            slot = slot + 1u32;
        }
        previous = current;
        current = next;
    }
    return true;
}
fn shaft_test_branches(grid: read ShaftGrid, options: ShaftGridOptions) -> bool {
    var branches: u32 = 0u32;
    var i: u32 = 1u32;
    while i + 1u32 < shaft_grid_path_count(read grid) {
        var root: u32 = shaft_grid_path(read grid, i);
        var incident: [u32; 6] = shaft_grid_incident(root);
        var count: u32 = 0u32;
        var slot: u32 = 0u32;
        while slot < 6u32 {
            var id: u32 = incident[slot as usize];
            if id != SHAFT_GRID_NONE {
                var edge: ShaftPassage = shaft_passage(read grid, id);
                if edge.open && !edge.required {
                    var next: u32 = edge.a;
                    if next == root {
                        next = edge.b;
                    }
                    if edge.cost != 1u32 || !shaft_test_branch(
                        read grid,
                        root,
                        next,
                        options.branch_length
                    ) {
                        return false;
                    }
                    count = count + 1u32;
                }
            }
            slot = slot + 1u32;
        }
        if count > 1u32 {
            return error("multiple branches at one route station");
        }
        branches = branches + count;
        i = i + 1u32;
    }
    return branches <= options.branches || error("too many dead ends");
}
fn shaft_test_tree(grid: read ShaftGrid) -> bool {
    var reached: u32 = 0u32;
    var open: u32 = 0u32;
    var i: u32 = 0u32;
    while i < shaft_grid_stations() {
        if shaft_station(read grid, i).reached {
            reached = reached + 1u32;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < shaft_grid_edges() {
        var edge: ShaftPassage = shaft_passage(read grid, i);
        if edge.open {
            open = open + 1u32;
            if !shaft_grid_internal(edge.a) && edge.a != shaft_grid_entrance(read grid) {
                return error("unused entrance is connected");
            }
            if !shaft_grid_internal(edge.b) && edge.b != shaft_grid_exit(read grid) {
                return error("unused exit is connected");
            }
        }
        i = i + 1u32;
    }
    return open + 1u32 == reached || error("selected graph has a cycle");
}
fn shaft_test_seed(seed: u32, options: ShaftGridOptions) -> bool {
    var grid: ShaftGrid = shaft_grid_new();
    var replay: ShaftGrid = shaft_grid_new();
    var distances: GenerationWords = generation_words_new();
    if !shaft_grid_generate(mut grid, seed, options) || !shaft_grid_generate(
        mut replay,
        seed,
        options
    ) || !generation_words_allocate(mut distances, shaft_grid_nodes()) {
        return false;
    }
    if !shaft_test_distances(read grid, shaft_grid_entrance(read grid), mut distances) || !shaft_test_reached(
        read grid,
        read distances
    ) || !shaft_test_path(read grid, options.length) || !shaft_test_tree(read grid) || !shaft_test_branches(
        read grid,
        options
    ) {
        return false;
    }
    if generation_word(read distances, shaft_grid_exit(read grid)) != options.length || shaft_grid_distance(
        read grid
    ) != options.length || shaft_grid_entrance(read grid) % shaft_grid_columns() == shaft_grid_exit(
        read grid
    ) % shaft_grid_columns() {
        return error("exact route or distinct endpoints violated");
    }
    var i: u32 = 0u32;
    while i < shaft_grid_edges() {
        var a: ShaftPassage = shaft_passage(read grid, i);
        var b: ShaftPassage = shaft_passage(read replay, i);
        if a.open != b.open || a.required != b.required {
            return error("seed replay differs");
        }
        i = i + 1u32;
    }
    return true;
}
fn shaft_test_invalid() -> bool {
    var grid: ShaftGrid = shaft_grid_new();
    var options: ShaftGridOptions = shaft_grid_defaults();
    options.length = shaft_grid_length_min() - 1u32;
    if shaft_grid_generate(mut grid, 1u32, options) {
        return error("too short route accepted");
    }
    options.length = shaft_grid_length_max() + 1u32;
    if shaft_grid_generate(mut grid, 1u32, options) {
        return error("too long route accepted");
    }
    options = shaft_grid_defaults();
    options.branch_length = 0u32;
    return !shaft_grid_generate(mut grid, 1u32, options) || error("zero branch length accepted");
}
fn main(argc: i32, argv: **u8) -> i32 {
    if !shaft_test_invalid() {
        return 1i32;
    }
    var seed: u32 = 0u32;
    while seed < 16u32 {
        var options: ShaftGridOptions = shaft_grid_defaults();
        if !shaft_test_seed(seed, options) {
            return 1i32;
        }
        options.length = shaft_grid_length_min();
        while options.length <= shaft_grid_length_max() {
            if !shaft_test_seed(seed, options) {
                return 1i32;
            }
            options.length = options.length + 1u32;
        }
        options = shaft_grid_defaults();
        options.branches = 0u32;
        if !shaft_test_seed(seed, options) {
            return 1i32;
        }
        seed = seed + 1u32;
    }
    puts(
        "shaft graph: all supported lengths, exact paths, short dead ends, reachability and replay passed"
    );
    return 0i32;
}
