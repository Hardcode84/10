fn shaft_layout_cross(scene: read CollisionScene, portal: CollisionPortal) -> bool {
    var i: u32 = 0u32;
    while i < 16u32 {
        var point: Vec3 = portal.origin;
        if portal.radius > service_oct_profile().radius {
            var angle: f32 = 6.28318530718f32 * i as f32 / 16f32;
            point = add(
                point,
                add(
                    scale(portal.basis.right, 4f32 * cosf(angle)),
                    scale(portal.basis.up, 4f32 * sinf(angle))
                )
            );
        }
        var start: Vec3 = sub(point, scale(portal.basis.forward, 0.6f32));
        var finish: Vec3 = add(point, scale(portal.basis.forward, 0.6f32));
        var expected: Vec3 = space_point(portal.transform, finish);
        if collision_position_valid(read scene, portal.space, start, DRONE_RADIUS) && collision_position_valid(
            read scene,
            portal.destination,
            expected,
            DRONE_RADIUS
        ) {
            var hit: CollisionSweep = collision_sweep_interval(
                read scene,
                portal.space,
                start,
                sub(finish, start),
                DRONE_RADIUS,
                shaft_layout_clock() as f32 * STEP,
                0f32
            );
            if hit.contact.hit.time > 1f32 {
                var drone: Drone = new_drone();
                drone.clock = shaft_layout_clock();
                drone.world = portal.space;
                drone.position = start;
                move_drone(read scene, mut drone, sub(finish, start));
                if drone.world != portal.destination || length(
                    sub(drone.position, expected)
                ) > 0.001f32 {
                    return error("shaft portal crossing disagrees with rigid placement");
                }
                return true;
            }
        }
        i = i + 1u32;
    }
    return error("shaft portal has no clear drone crossing");
}
fn shaft_layout_edge(grid: mut ShaftGrid, a: u32, b: u32) -> unit {
    var id: u32 = shaft_grid_between(a, b);
    var edge: ShaftPassage = shaft_passage(read grid, id);
    edge.open = true;
    shaft_passage_set(mut grid, id, edge);
    shaft_grid_reach(mut grid, a);
    shaft_grid_reach(mut grid, b);
}
fn shaft_layout_fixture(grid: mut ShaftGrid) -> bool {
    if !shaft_grid_allocate(mut grid, 1u32) {
        return false;
    }
    shaft_grid_candidates(mut grid);
    var a: u32 = shaft_grid_station(0u32, 0u32, 1u32);
    var b: u32 = a + 1u32;
    var c: u32 = a + SHAFT_GRID_WIDTH;
    var d: u32 = c + 1u32;
    shaft_layout_edge(mut grid, a, b);
    shaft_layout_edge(mut grid, b, d);
    shaft_layout_edge(mut grid, a, c);
    shaft_layout_edge(mut grid, c, d);
    var next: u32 = a + shaft_grid_columns();
    var last: u32 = next + shaft_grid_columns();
    shaft_layout_edge(mut grid, a, next);
    shaft_layout_edge(mut grid, next, last);
    shaft_layout_edge(mut grid, last, last + 1u32);
    var entrance: u32 = a - shaft_grid_columns();
    var destination: u32 = last + 1u32 + shaft_grid_columns();
    shaft_layout_edge(mut grid, entrance, a);
    shaft_layout_edge(mut grid, last + 1u32, destination);
    shaft_grid_set_endpoints(mut grid, entrance, destination);
    return true;
}
fn shaft_layout_side_connection(portal: CollisionPortal, from: u32, to: u32) -> bool {
    if from == PREFAB_OCT_TUNNEL_10M {
        return to == PREFAB_OCT_STOPPER_OPEN || error(
            "shaft side tunnel bypasses an open stopper"
        );
    }
    if from == PREFAB_SHAFT_STATION && portal.sides == service_oct_profile().shape.sides {
        return to == PREFAB_OCT_STOPPER || to == PREFAB_OCT_STOPPER_OPEN || error(
            "shaft side port lacks a stopper"
        );
    }
    if from == PREFAB_SHAFT_FAN {
        return to == PREFAB_SHAFT_COLLAR || error("fan end lacks its connection collar");
    }
    if from == PREFAB_SHAFT_COLLAR && portal.sides == service_hex_profile().shape.sides {
        return to == PREFAB_HEX_STOPPER_OPEN || error("fan bypass port lacks an open stopper");
    }
    return true;
}
fn shaft_layout_closed(kind: u32) -> bool {
    return kind == PREFAB_OCT_STOPPER || kind == PREFAB_HEX_STOPPER;
}
fn shaft_layout_crossings(scene: read CollisionScene, graph: read RoomGraph) -> bool {
    var i: u32 = 0u32;
    while i < collision_portal_count(read scene) {
        var portal: CollisionPortal = collision_portal(read scene, i);
        var from: u32 = graph_node(read graph, portal.space).kind;
        var to: u32 = graph_node(read graph, portal.destination).kind;
        if !shaft_layout_side_connection(portal, from, to) {
            return false;
        }
        if !shaft_layout_closed(from) && !shaft_layout_closed(to) {
            if !shaft_layout_cross(read scene, portal) {
                print_number(i as i64);
                return false;
            }
        } else if shaft_layout_closed(to) {
            var drone: Drone = new_drone();
            drone.clock = shaft_layout_clock();
            drone.world = portal.space;
            drone.position = sub(portal.origin, portal.basis.forward);
            move_drone(read scene, mut drone, scale(portal.basis.forward, 2f32));
            var pose: SpaceTransform = graph_node(read graph, drone.world).placement;
            var origin: Vec3 = space_point(
                graph_node(read graph, portal.space).placement,
                portal.origin
            );
            if length(sub(space_point(pose, drone.position), origin)) > 0.5f32 {
                return error("closed tunnel connection leaks into void");
            }
        }
        i = i + 1u32;
    }
    return true;
}
fn shaft_layout_bypass_exit(graph: read RoomGraph, room: u32, incoming: u32) -> u32 {
    var node: GraphNode = graph_node(read graph, room);
    var next: u32 = SHAFT_GRID_NONE;
    var caps: u32 = 0u32;
    var i: u32 = 0u32;
    while i < node.count {
        var socket: u32 = node.first + i;
        var link: GraphSocket = graph_socket(read graph, socket);
        var peer: GraphSocket = graph_socket(read graph, link.peer);
        if graph_node(read graph, peer.room).kind == PREFAB_HEX_STOPPER {
            caps = caps + 1u32;
        } else if socket != incoming {
            if next != SHAFT_GRID_NONE {
                error("fan bypass has an uncapped branch");
                return SHAFT_GRID_NONE;
            }
            next = socket;
        }
        i = i + 1u32;
    }
    var expected_caps: u32 = 0u32;
    if node.kind == PREFAB_HEX_T_JUNCTION {
        expected_caps = 1u32;
    } else if node.kind != PREFAB_HEX_STOPPER_OPEN && node.kind != PREFAB_HEX_TUNNEL_10M {
        error("fan bypass uses an unexpected room");
        return SHAFT_GRID_NONE;
    }
    if caps != expected_caps || next == SHAFT_GRID_NONE {
        error("fan bypass needs one through route and capped T branches");
        return SHAFT_GRID_NONE;
    }
    return next;
}
fn shaft_layout_open_doors(scene: mut CollisionScene, graph: mut RoomGraph) -> unit {
    var trial: Trial = new_trial();
    var doors: mut DoorSet = graph_doors_mut(mut graph);
    var i: u32 = 0u32;
    while i < doors_count(read doors) {
        door_set_requested(mut doors, i, true);
        i = i + 1u32;
    }
    doors_step(mut scene, mut doors, mut trial);
}
fn shaft_layout_clock() -> u32 {
    return (DOOR_OPEN_SECONDS / STEP) as u32 + 1u32;
}
fn shaft_layout_bypass(
    scene: read CollisionScene,
    graph: read RoomGraph,
    first: LevelCursor,
    last: LevelCursor
) -> bool {
    var socket: u32 = course_socket(read graph, first.room, first.exit);
    var port: RoomPort = graph_socket(read graph, socket).port;
    var drone: Drone = new_drone();
    drone.clock = shaft_layout_clock();
    drone.world = first.room;
    drone.position = sub(port.position, scale(port.basis.forward, 0.6f32));
    var steps: u32 = 0u32;
    while steps < graph_count(read graph) {
        var outgoing: GraphSocket = graph_socket(read graph, socket);
        var incoming: GraphSocket = graph_socket(read graph, outgoing.peer);
        var end: Vec3 = add(
            outgoing.port.position,
            scale(outgoing.port.basis.forward, 0.6f32)
        );
        var expected: Vec3 = space_point(
            connection_transform(outgoing.port, incoming.port, outgoing.roll),
            end
        );
        move_drone(read scene, mut drone, sub(end, drone.position));
        if drone.world != incoming.room || length(sub(drone.position, expected)) > 0.001f32 {
            return error("drone cannot traverse the fan bypass interior");
        }
        if incoming.room == last.room {
            return asset_names_equal(incoming.port.id, last.exit) || error(
                "bypass returns through the wrong port"
            );
        }
        socket = shaft_layout_bypass_exit(read graph, incoming.room, outgoing.peer);
        if socket == SHAFT_GRID_NONE {
            return false;
        }
        steps = steps + 1u32;
    }
    return error("fan bypass does not reach the opposite collar");
}
fn shaft_layout_bypasses(scene: read CollisionScene, graph: read RoomGraph) -> bool {
    var room: u32 = 0u32;
    var found: bool = false;
    while room < graph_count(read graph) {
        if graph_node(read graph, room).kind == PREFAB_SHAFT_FAN {
            found = true;
            var lower: LevelCursor = shaft_region_fan_side(
                read graph,
                room,
                asset_name("BOTTOM")
            );
            var upper: LevelCursor = shaft_region_fan_side(
                read graph,
                room,
                asset_name("TOP")
            );
            if !shaft_layout_bypass(read scene, read graph, lower, upper) || !shaft_layout_bypass(
                read scene,
                read graph,
                upper,
                lower
            ) {
                return false;
            }
        }
        room = room + 1u32;
    }
    return found || error("shaft assembly fixture needs a fan bypass");
}
fn shaft_layout_grate(scene: read CollisionScene, graph: read RoomGraph, room: u32) -> bool {
    var end: GraphSocket = graph_socket(
        read graph,
        course_socket(read graph, room, asset_name("TOP"))
    );
    var cap: u32 = graph_node(read graph, graph_socket(read graph, end.peer).room).kind;
    if cap != PREFAB_SHAFT_CAP_BEARING && cap != PREFAB_SHAFT_CAP_COLLECTOR && cap != PREFAB_SHAFT_CAP_FILTER {
        return error("blocked grate shaft needs a closed enclosure behind it");
    }
    var centre: f32 = end.port.position.y * 0.5f32;
    var radius: f32 = (shaft_parameter(1u32).initial + shaft_parameter(2u32).initial) * 0.25f32;
    var i: u32 = 0u32;
    while i < 8u32 {
        var angle: f32 = 6.28318530718f32 * i as f32 / 8f32;
        var drone: Drone = new_drone();
        drone.world = room;
        drone.position = vec(radius * cosf(angle), centre - 1f32, radius * sinf(angle));
        if !collision_position_valid_at(
            read scene,
            room,
            drone.position,
            DRONE_RADIUS,
            0f32
        ) {
            return error("grate approach sample overlaps geometry");
        }
        move_drone(read scene, mut drone, vec(0f32, 2f32, 0f32));
        if drone.world != room || drone.position.y >= centre {
            return error("blocked grate shaft permits drone passage");
        }
        i = i + 1u32;
    }
    return true;
}
fn shaft_layout_variety(scene: read CollisionScene, graph: read RoomGraph) -> bool {
    var grates: u32 = 0u32;
    var rotors: u32 = 0u32;
    var i: u32 = 0u32;
    while i < graph_count(read graph) {
        var kind: u32 = graph_node(read graph, i).kind;
        if kind == PREFAB_SHAFT_GRATE {
            grates = grates + 1u32;
            if !shaft_layout_grate(read scene, read graph, i) {
                return false;
            }
        }
        if kind == PREFAB_SHAFT_ROTOR {
            rotors = rotors + 1u32;
        }
        i = i + 1u32;
    }
    return (grates != 0u32 && rotors != 0u32) || error("shaft assembly omits grates or rotors");
}
fn shaft_layout_default_rotors() -> bool {
    var grid: ShaftGrid = shaft_grid_new();
    if !shaft_grid_generate(mut grid, 1u32, shaft_grid_defaults()) {
        return false;
    }
    var i: u32 = 0u32;
    while i < shaft_grid_axials() {
        var edge: ShaftPassage = shaft_passage(read grid, i);
        if edge.open && edge.required && shaft_region_radial_kind(edge) == PREFAB_SHAFT_ROTOR {
            return true;
        }
        i = i + 1u32;
    }
    return error("default shaft route has no rotor passage");
}
fn shaft_layout_run() -> bool {
    var grid: ShaftGrid = shaft_grid_new();
    var rooms: GenerationWords = generation_words_new();
    var graph: RoomGraph = graph_new();
    var builder: CollisionBuilder = collision_builder_new();
    var mesh: Mesh = mesh_new();
    if !shaft_layout_fixture(mut grid) || !generation_words_allocate(
        mut rooms,
        shaft_grid_stations()
    ) || !graph_allocate(mut graph, shaft_grid_stations() * 7u32, 1u32) {
        return false;
    }
    generation_words_fill(mut rooms, SHAFT_GRID_NONE);
    var start: RoomAsset = room_asset_new();
    var ending: RoomAsset = room_asset_new();
    if !shaft_region_terminal(
        mut graph,
        mut builder,
        mut mesh,
        shaft_grid_entrance(read grid),
        PREFAB_SHAFT_CAP_BEARING,
        mut rooms,
        mut start
    ) || !shaft_region_spawn(mut start) || !shaft_region_terminal(
        mut graph,
        mut builder,
        mut mesh,
        shaft_grid_exit(read grid),
        PREFAB_SHAFT_CAP_OUTLET,
        mut rooms,
        mut ending
    ) {
        return false;
    }

    if !shaft_region_stations(read grid, mut graph, mut builder, mut mesh, mut rooms) || !shaft_region_passages(
        read grid,
        mut graph,
        mut builder,
        mut mesh,
        read rooms
    ) || !shaft_region_close(mut graph, mut builder, mut mesh) {
        return false;
    }
    var scene: CollisionScene = collision_new();
    if !collision_finish(move builder, mut scene) || !level_install(read graph, mut scene) {
        return false;
    }
    if !shaft_layout_variety(read scene, read graph) {
        return false;
    }
    shaft_layout_open_doors(mut scene, mut graph);
    if !shaft_layout_crossings(read scene, read graph) || !shaft_layout_bypasses(
        read scene,
        read graph
    ) {
        return false;
    }
    puts(
        "shaft assembly: rigid loops, radial links, oblique links, closures, drone crossings and bidirectional fan bypass flight passed"
    );
    return true;
}
fn main(argc: i32, argv: **u8) -> i32 {
    return (!shaft_layout_default_rotors() || !shaft_layout_run()) as i32;
}
