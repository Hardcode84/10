record ContinuationFixture {
    stage: u32;
    value: u32;
    source: *u32;
}
opaque;
fn continuation_source(data: *u8) -> TaskStep {
    *(data as *u32) = 42u32;
    return task_done(true);
}
fn continuation_consumer(data: *u8) -> TaskStep {
    var test: *ContinuationFixture = data as *ContinuationFixture;
    if test -> stage == 0u32 {
        test -> stage = 1u32;
        return task_await(1u32);
    }
    test -> value = *(test -> source);
    return task_done(test -> value == 42u32);
}
fn check_continuations() -> bool {
    var schedule: TaskSchedule = schedule_new();
    if !schedule_open(mut schedule, 1u32, 2u32) {
        return false;
    }
    var source: u32 = 0u32;
    var test: ContinuationFixture = make ContinuationFixture {
        stage: 0u32,
        value: 0u32,
        source: &source
    };
    schedule_define(read schedule, 0u32, continuation_consumer, &test as *u8);
    schedule_define(read schedule, 1u32, continuation_source, &source as *u8);
    schedule_request(read schedule, 0u32);
    while schedule_status(read schedule, 0u32) == 0i32 {
        schedule_poll(read schedule);
        schedule_idle(read schedule);
    }
    return schedule_status(read schedule, 0u32) == 1i32 && test.value == 42u32;
}
record ContinuationGate {
    entered: *u8;
    release: *u8;
}
opaque;
fn continuation_background(data: *u8) -> TaskStep {
    var gate: *ContinuationGate = data as *ContinuationGate;
    service_post(gate -> entered);
    service_wait(gate -> release);
    return task_done(true);
}
fn check_foreground_capacity() -> bool {
    var schedule: TaskSchedule = schedule_new();
    if !schedule_open(mut schedule, 2u32, 3u32) {
        return false;
    }
    var gate: ContinuationGate = make ContinuationGate {
        entered: service_sem_create(0u32),
        release: service_sem_create(0u32)
    };
    if gate.entered == null(*u8) || gate.release == null(*u8) {
        if gate.entered != null(*u8) {
            service_sem_destroy(gate.entered);
        }
        if gate.release != null(*u8) {
            service_sem_destroy(gate.release);
        }
        return false;
    }
    var value: u32 = 0u32;
    schedule_define(read schedule, 0u32, continuation_background, &gate as *u8);
    schedule_define(read schedule, 1u32, continuation_source, &value as *u8);
    schedule_define(read schedule, 2u32, continuation_source, &value as *u8);
    schedule_background(read schedule, 0u32);
    schedule_poll(read schedule);
    service_wait(gate.entered);
    schedule_background(read schedule, 1u32);
    schedule_request(read schedule, 2u32);
    var attempts: u32 = 0u32;
    while schedule_status(read schedule, 2u32) == 0i32 && attempts < 1000u32 {
        schedule_poll(read schedule);
        schedule_idle(read schedule);
        attempts = attempts + 1u32;
    }
    var good: bool = schedule_status(read schedule, 2u32) == 1i32 && schedule_status(
        read schedule,
        1u32
    ) == 0i32 && value == 42u32;
    service_post(gate.release);
    while schedule_busy(read schedule) {
        schedule_poll(read schedule);
        schedule_idle(read schedule);
    }
    service_sem_destroy(gate.entered);
    service_sem_destroy(gate.release);
    return good;
}
fn continuation_failure(data: *u8) -> TaskStep {
    return task_done(false);
}
fn check_continuation_failure() -> bool {
    var pool: TaskPool = task_pool_new();
    var schedule: TaskSchedule = schedule_new();
    if !task_pool_open(mut pool, 1u32, 3u32) || !schedule_on(mut schedule, read pool, 3u32) {
        return false;
    }
    drop pool;
    var source: u32 = 0u32;
    var test: ContinuationFixture = make ContinuationFixture {
        stage: 0u32,
        value: 0u32,
        source: &source
    };
    schedule_define(read schedule, 0u32, continuation_consumer, &test as *u8);
    schedule_define(read schedule, 1u32, continuation_failure, null(*u8));
    schedule_define(read schedule, 2u32, continuation_source, &source as *u8);
    schedule_request(read schedule, 0u32);
    schedule_request(read schedule, 2u32);
    while schedule_busy(read schedule) {
        schedule_poll(read schedule);
        schedule_idle(read schedule);
    }
    return schedule_status(read schedule, 0u32) == -1i32 && test.stage == 1u32 && test.value == 0u32 && schedule_status(
        read schedule,
        2u32
    ) == 1i32 && source == 42u32;
}
