fn check_external_order(early: bool) -> bool {
    var graph: TaskGraph = task_graph_new();
    if !task_graph_open(mut graph, 2u32, 1u32) || !task_graph_external(mut graph, 0u32) || !task_graph_edge(
        mut graph,
        0u32,
        1u32
    ) || !task_graph_seal(mut graph) {
        return false;
    }
    var repeat: u32 = 0u32;
    while repeat < 4u32 {
        task_graph_start(mut graph);
        if task_next(mut graph) != 0u32 {
            return false;
        }
        if early {
            task_external_complete(mut graph, 0u32, true);
        } else {
            task_submission_returned(mut graph, 0u32, true);
        }
        if task_next(mut graph) != TASK_NONE || !task_pending(read graph, 0u32) {
            return false;
        }
        if early {
            task_submission_returned(mut graph, 0u32, true);
        } else {
            task_external_complete(mut graph, 0u32, true);
        }
        if task_next(mut graph) != 1u32 {
            return false;
        }
        task_complete(mut graph, 1u32, true);
        if !task_succeeded(read graph) {
            return false;
        }
        repeat = repeat + 1u32;
    }
    return true;
}
fn check_cancel_drain() -> bool {
    var graph: TaskGraph = task_graph_new();
    if !task_graph_open(mut graph, 3u32, 1u32) || !task_graph_external(mut graph, 0u32) || !task_graph_edge(
        mut graph,
        1u32,
        2u32
    ) || !task_graph_seal(mut graph) {
        return false;
    }
    task_graph_start(mut graph);
    if task_next(mut graph) != 0u32 {
        return false;
    }
    task_submission_returned(mut graph, 0u32, true);
    if task_next(mut graph) != 1u32 {
        return false;
    }
    task_complete(mut graph, 1u32, false);
    if task_drained(read graph) || task_next(mut graph) != TASK_NONE {
        return false;
    }
    task_external_complete(mut graph, 0u32, true);
    return task_drained(read graph) && !task_succeeded(read graph);
}
fn check_ready_fanout() -> bool {
    var graph: TaskGraph = task_graph_new();
    if !task_graph_open(mut graph, 257u32, 256u32) || !task_graph_external(mut graph, 0u32) {
        return false;
    }
    var i: u32 = 1u32;
    while i < 257u32 {
        if !task_graph_edge(mut graph, 0u32, i) {
            return false;
        }
        i = i + 1u32;
    }
    if !task_graph_seal(mut graph) {
        return false;
    }
    task_graph_start(mut graph);
    if task_next(mut graph) != 0u32 {
        return false;
    }
    task_submission_returned(mut graph, 0u32, true);
    task_external_complete(mut graph, 0u32, true);
    var count: u32 = 0u32;
    var id: u32 = task_next(mut graph);
    while id != TASK_NONE {
        task_complete(mut graph, id, true);
        count = count + 1u32;
        id = task_next(mut graph);
    }
    return count == 256u32 && task_succeeded(read graph);
}
fn check_rejection() -> bool {
    var graph: TaskGraph = task_graph_new();
    if !task_graph_open(mut graph, 1u32, 0u32) || !task_graph_external(mut graph, 0u32) || !task_graph_seal(
        mut graph
    ) {
        return false;
    }
    task_graph_start(mut graph);
    if task_next(mut graph) != 0u32 {
        return false;
    }
    task_submission_returned(mut graph, 0u32, false);
    return task_drained(read graph) && !task_succeeded(read graph);
}
fn check_cycle() -> bool {
    var graph: TaskGraph = task_graph_new();
    return task_graph_open(mut graph, 2u32, 2u32) && task_graph_edge(mut graph, 0u32, 1u32) && task_graph_edge(
        mut graph,
        1u32,
        0u32
    ) && !task_graph_seal(mut graph);
}
fn main(argc: i32, argv: **u8) -> i32 {
    return (
        !(
            check_native_service() && check_external_order(false) && check_external_order(true) && check_cancel_drain() && check_ready_fanout() && check_rejection() && check_cycle()
        )
    ) as i32;
}
