record PoolWitness {
    count: u32;
    success: bool;
}
fn pool_witness_execute(data: *u8) -> bool {
    var witness: *PoolWitness = data as *PoolWitness;
    var i: u32 = 0u32;
    while i < 5000u32 {
        witness -> count = witness -> count + 1u32;
        i = i + 1u32;
    }
    return witness -> success;
}
fn pool_witness_wait(job: read PoolJob) -> i32 {
    var result: i32 = pool_job_poll(read job);
    while result == 0i32 {
        pool_job_idle(read job);
        result = pool_job_poll(read job);
    }
    return result;
}
fn check_pool_mode(workers: u32) -> bool {
    var pool: TaskPool = task_pool_new();
    if !task_pool_open(mut pool, workers, 2u32) {
        return false;
    }
    var a: PoolWitness = make PoolWitness {
        count: 0u32,
        success: true
    };
    var b: PoolWitness = make PoolWitness {
        count: 0u32,
        success: false
    };
    var iteration: u32 = 0u32;
    while iteration < 64u32 {
        {
            var first: PoolJob = pool_submit(read pool, pool_witness_execute, &a as *u8);
            var second: PoolJob = pool_submit(read pool, pool_witness_execute, &b as *u8);
            if !pool_job_accepted(read first) || !pool_job_accepted(read second) {
                return false;
            }
            if iteration == 0u32 {
                var rejected: PoolJob = pool_submit(
                    read pool,
                    pool_witness_execute,
                    &a as *u8
                );
                if pool_job_accepted(read rejected) || pool_job_poll(read rejected) != -1i32 {
                    return false;
                }
            }
            if pool_witness_wait(read first) != 1i32 || pool_witness_wait(read second) != -1i32 {
                return false;
            }
        }
        iteration = iteration + 1u32;
    }
    {
        var early: PoolJob = pool_submit(read pool, pool_witness_execute, &a as *u8);
        if !pool_job_accepted(read early) {
            return false;
        }
    }
    return a.count == 65u32 * 5000u32 && b.count == 64u32 * 5000u32;
}
fn check_worker_pool() -> bool {
    return check_pool_mode(0u32) && check_pool_mode(2u32);
}
