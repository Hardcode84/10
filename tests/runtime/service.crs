record ServiceWitness {
    ready: *u8;
    release: *u8;
    completed: u32;
    success: bool;
}
opaque;
fn witness_execute(data: *u8) -> bool {
    var witness: *ServiceWitness = data as *ServiceWitness;
    service_require(service_post(witness -> ready));
    service_require(service_wait(witness -> release));
    witness -> completed = witness -> completed + 1u32;
    return witness -> success;
}
fn service_witness_run(service: *ExternalService, witness: *ServiceWitness) -> bool {
    var i: u32 = 0u32;
    while i < 64u32 {
        service_submit(service, witness_execute, witness as *u8);
        service_require(service_wait(witness -> ready));
        if service_poll(service) != 0i32 {
            trap;
        }
        service_require(service_post(witness -> release));
        var status: i32 = service_poll(service);
        while status == 0i32 {
            service_idle(service);
            status = service_poll(service);
        }
        if status != 1i32 || witness -> completed != i + 1u32 {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn check_native_service() -> bool {
    var service: *ExternalService = service_new();
    if service == null(*ExternalService) {
        return false;
    }
    var witness: ServiceWitness = make ServiceWitness {
        ready: service_sem_create(0u32),
        release: service_sem_create(0u32),
        completed: 0u32,
        success: true
    };
    if witness.ready == null(*u8) || witness.release == null(*u8) {
        trap;
    }
    var good: bool = service_witness_run(service, &witness);
    witness.success = false;
    service_require(service_post(witness.release));
    service_submit(service, witness_execute, &witness as *u8);
    var result: i32 = service_poll(service);
    while result == 0i32 {
        service_idle(service);
        result = service_poll(service);
    }
    good = good && result == -1i32 && witness.completed == 65u32;
    witness.success = true;
    service_require(service_post(witness.release));
    service_submit(service, witness_execute, &witness as *u8);
    service_destroy(service);
    good = good && witness.completed == 66u32;
    service_sem_destroy(witness.ready);
    service_sem_destroy(witness.release);
    return good;
}
