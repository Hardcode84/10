fn asset_test_part_room(asset: mut RoomAsset) -> bool {
    var profile: RegularProfile = make RegularProfile {
        sides: 8u32,
        phase: 0f32
    };
    if !loft_allocate(mut asset.hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut asset.hull, profile, 0u32, 0f32, 8f32);
    loft_ring(mut asset.hull, profile, 1u32, 10f32, 8f32);
    loft_span(mut asset.hull, profile, 0u32, 0u32);
    loft_caps(mut asset.hull, profile, 2u32, 0u32, 0u32);
    if !solid_box(
        mut asset.geometry,
        vec(4f32, 1f32, 1f32),
        1u32,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        2f32
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < 2u32 {
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                linear: vec(0f32, 0f32, 0f32),
                angular: vec(0f32, 0f32, 0f32),
                name: asset_name("beam"),
                first: 0u32,
                count: 12u32,
                origin: vec(-3f32 + 6f32 * i as f32, 5f32, 0f32),
                basis: make Basis {
                    right: vec(0f32, 0f32, 1f32),
                    up: vec(0f32, 1f32, 0f32),
                    forward: vec(-1f32, 0f32, 0f32)
                }
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    if !asset_part_append(
        mut asset.colliders,
        make AssetPart {
            linear: vec(0f32, 0f32, 0f32),
            angular: vec(0f32, 0f32, 0f32),
            name: asset_name("collision-only"),
            first: 0u32,
            count: 12u32,
            origin: vec(0f32, 7f32, 3f32),
            basis: identity_basis()
        }
    ) {
        return false;
    }
    asset.spawn.position = vec(0f32, 1f32, 0f32);
    return true;
}
fn asset_test_parts() -> bool {
    return asset_test_flash_concrete() && asset_test_flash() && asset_test_arc() && asset_test_lightning() && asset_test_cutout_collision() && asset_test_part_assembly() && asset_test_motion();
}
fn asset_test_part_assembly() -> bool {
    var asset: RoomAsset = room_asset_new();
    if !asset_test_part_room(mut asset) || !asset_test_decal(mut asset) || !room_asset_finish(
        mut asset
    ) {
        return false;
    }
    var render: Mesh = mesh_new();
    var walls: Mesh = mesh_new();
    if !room_linked_mesh(read asset, mut render, mut walls, 7u32) {
        return false;
    }
    if mesh_triangle_count(read render) != mesh_triangle_count(read walls) + 25u32 || mesh_triangle_count(
        read render
    ) != mesh_triangle_count(read asset.mesh) || mesh_triangle(
        read render,
        mesh_triangle_count(read walls)
    ).material != 8u32 {
        return error("linked room lost solid render parts or material offsets");
    }
    var builder: CollisionBuilder = collision_builder_new();
    var linked: CollisionScene = collision_new();
    if !collision_append(
        mut builder,
        read walls,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) || !room_parts_collision(read asset, mut builder, 0u32) {
        return false;
    }
    if !collision_finish(move builder, mut linked) {
        return false;
    }
    if !asset_test_part_contacts(read asset.collision, read linked) {
        return false;
    }
    if !asset_test_decal_contacts(read asset.collision, read linked, read render) {
        return false;
    }
    var rejected: RoomAsset = room_asset_new();
    if !asset_test_part_room(mut rejected) {
        return false;
    }
    rejected.spawn.position = vec(-3f32, 5f32, 0f32);
    return !room_asset_finish(mut rejected) || error("spawn inside a solid part was accepted");
}

fn asset_test_decal(asset: mut RoomAsset) -> bool {
    return mesh_append(
        mut asset.decals,
        make MeshTriangle {
            vertices: make [MeshVertex; 3] {
                make MeshVertex {
                    x: -2f32,
                    y: 2f32,
                    z: -2f32,
                    u: 0f32,
                    v: 0f32
                },
                make MeshVertex {
                    x: 2f32,
                    y: 2f32,
                    z: -2f32,
                    u: 1f32,
                    v: 0f32
                },
                make MeshVertex {
                    x: 0f32,
                    y: 2f32,
                    z: 2f32,
                    u: 0.5f32,
                    v: 1f32
                }
            },
            material: 2u32,
            portal: 0u32,
            flags: 5u32
        }
    );
}

fn asset_test_part_contacts(original: read CollisionScene, linked: read CollisionScene) -> bool {
    if collision_position_valid(read original, 0u32, vec(0f32, 7f32, 3f32), 0.1f32) || collision_position_valid(
        read linked,
        0u32,
        vec(0f32, 7f32, 3f32),
        0.1f32
    ) {
        return error("collision-only part was lost during room assembly");
    }

    var i: u32 = 0u32;
    while i < 2u32 {
        var centre: Vec3 = vec(-3f32 + 6f32 * i as f32, 5f32, 0f32);
        if collision_position_valid(read original, 0u32, centre, 0.1f32) || collision_position_valid(
            read linked,
            0u32,
            centre,
            0.1f32
        ) || !collision_position_valid(
            read linked,
            0u32,
            add(centre, vec(1f32, 0f32, 0f32)),
            0.1f32
        ) {
            return error("shared part collision lost its rigid placement or solid volume");
        }
        var hit: CollisionContact = collision_sweep(
            read linked,
            0u32,
            add(centre, vec(0f32, -2f32, 0f32)),
            vec(0f32, 3f32, 0f32),
            0.25f32
        );
        if absf(hit.hit.time - 1.25f32 / 3f32) > 0.0001f32 {
            return error("placed solid part has incorrect sweep contact");
        }
        i = i + 1u32;
    }
    return true;
}
fn asset_test_preview_room() -> bool {
    var room: RoomAsset = room_asset_new();
    room.spawn_enabled = false;
    if !hex_passage_build(0.5f32, false, mut room) {
        return false;
    }
    if room_asset_player_spawn(read room) {
        return error("preview-only room accepted as player spawn");
    }
    var rejected: RoomAsset = room_asset_new();
    return !hex_passage_build(0.5f32, false, mut rejected) || error(
        "thin room accepted a player spawn without sphere clearance"
    );
}

fn asset_test_decal_contacts(
    original_scene: read CollisionScene,
    linked: read CollisionScene,
    render: read Mesh
) -> bool {
    var contact: CollisionContact = collision_sweep(
        read linked,
        0u32,
        vec(0f32, 1f32, 0f32),
        vec(0f32, 2f32, 0f32),
        0.25f32
    );
    var original: CollisionContact = collision_sweep(
        read original_scene,
        0u32,
        vec(0f32, 1f32, 0f32),
        vec(0f32, 2f32, 0f32),
        0.25f32
    );
    var decal: MeshTriangle = mesh_triangle(
        read render,
        mesh_triangle_count(read render) - 1u32
    );
    if contact.hit.time <= 1f32 || original.hit.time <= 1f32 || decal.material != 9u32 || decal.flags != 5u32 {
        return error("room decal lost its render data or entered collision");
    }
    return true;
}
fn asset_test_cutout_collision() -> bool {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = METAL_GRATE;
    material.tile_metres = 0.5f32;
    material.tile_height = material.tile_metres;
    material.border = grate_texel_bar_width(
        material.tile_metres,
        0.1f32,
        material.texels_per_metre
    );
    var asset: RoomAsset = room_asset_new();
    var layout: ShaftGrateLayout = make ShaftGrateLayout {
        radius: 3f32,
        core: 0.5f32,
        height: 8f32,
        count: 1u32,
        pitch: material.tile_metres,
        bar: material.border
    };
    if !grate_bars(mut asset, layout) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    if !room_parts_collision(read asset, mut builder, 0u32) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var clear: Vec3 = vec(layout.pitch * 2.5f32, 3f32, layout.pitch * 0.5f32);
    var bar: Vec3 = vec(layout.pitch * 2f32, clear.y, clear.z);
    var direction: Vec3 = vec(0f32, 2f32, 0f32);
    var small: CollisionContact = collision_sweep(
        read scene,
        0u32,
        clear,
        direction,
        layout.pitch * 0.1f32
    );
    var large: CollisionContact = collision_sweep(
        read scene,
        0u32,
        clear,
        direction,
        layout.pitch * 0.75f32
    );
    var solid: CollisionContact = collision_sweep(
        read scene,
        0u32,
        bar,
        direction,
        layout.pitch * 0.1f32
    );
    return small.hit.time >= 1f32 && large.hit.time < 1f32 && solid.hit.time < 1f32 && panel_sample(
        material,
        layout.pitch * 0.5f32,
        layout.pitch * 0.5f32
    ) == 0u32 && panel_sample(material, 0f32, layout.pitch * 0.5f32) != 0u32 || error(
        "cutout openings disagree with solid bar collision"
    );
}

fn asset_test_motion() -> bool {
    var asset: RoomAsset = room_asset_new();
    if !solid_box(
        mut asset.geometry,
        vec(1f32, 2f32, 1f32),
        0u32,
        vec(5f32, 0f32, 0f32),
        identity_basis(),
        1f32
    ) {
        return false;
    }
    var part: AssetPart = make AssetPart {
        name: asset_name("orbit"),
        first: 0u32,
        count: mesh_triangle_count(read asset.geometry),
        origin: vec(3f32, 4f32, 7f32),
        basis: make Basis {
            right: vec(0f32, 0f32, -1f32),
            up: vec(0f32, 1f32, 0f32),
            forward: vec(1f32, 0f32, 0f32)
        },
        linear: vec(0.1f32, -0.2f32, 0.3f32),
        angular: vec(0.2f32, 0.5f32, -0.1f32)
    };
    if !asset_part_append(mut asset.parts, part) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    if !room_parts_collision(read asset, mut builder, 0u32) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var source: MeshVertex = mesh_triangle(read asset.geometry, 0u32).vertices[0usize];
    var local: Vec3 = vec(source.x, source.y, source.z);
    var placed: Vec3 = add(part.origin, basis_vector(part.basis, local));
    var instance: MeshInstance = asset_part_motion(part, 0u32, 0u32);
    var i: u32 = 0u32;
    while i < 5u32 {
        var time: f32 = i as f32 * 3.7f32;
        var pose: MeshInstance = instance_at(instance, time);
        var point: Vec3 = vec(
            pose.transform[0usize] * placed.x + pose.transform[1usize] * placed.y + pose.transform[
                2usize
            ] * placed.z + pose.transform[3usize],
            pose.transform[4usize] * placed.x + pose.transform[5usize] * placed.y + pose.transform[
                6usize
            ] * placed.z + pose.transform[7usize],
            pose.transform[8usize] * placed.x + pose.transform[9usize] * placed.y + pose.transform[
                10usize
            ] * placed.z + pose.transform[11usize]
        );
        var anchor: Vec3 = collision_anchor(read scene, 0u32, local, time);
        var velocity: Vec3 = add(
            part.linear,
            cross(
                part.angular,
                sub(anchor, add(part.origin, scale(part.linear, time)))
            )
        );
        if length(sub(point, anchor)) > 0.00002f32 || length(
            sub(velocity, collision_anchor_velocity(read scene, 0u32, local, time))
        ) > 0.00002f32 {
            return error("moving asset render pose or tether anchor disagrees with collision");
        }
        if collision_embedded_at(
            read scene,
            0u32,
            add(
                collision_pose(collision_instance(read scene, 0u32), time).origin,
                basis_vector(
                    collision_pose(collision_instance(read scene, 0u32), time).basis,
                    vec(5f32, 0f32, 0f32)
                )
            ),
            time
        ) != 0u32 {
            return error("orbital solid collision did not follow its pivot");
        }
        i = i + 1u32;
    }
    return true;
}

fn asset_test_lightning() -> bool {
    var style: LightningStyle = make LightningStyle {
        minimum: 0.2f32,
        maximum: 1.3f32,
        angle: 0.9f32,
        radius: 0.01f32,
        seed: 0u32,
        region: 3u32
    };
    var end: Vec3 = vec(4f32, -3f32, 8f32);
    while style.seed < 32u32 {
        var point: Vec3 = vec(-2f32, 1f32, -5f32);
        var i: u32 = 0u32;
        while length(sub(end, point)) > 0f32 {
            var next: Vec3 = lightning_step(point, end, style, i);
            var delta: Vec3 = sub(next, point);
            var distance: f32 = length(sub(end, point));
            var remaining: f32 = length(sub(end, next));
            if i > 10000u32 || remaining >= distance || length(delta) > style.maximum + 0.00001f32 {
                return error("lightning step failed progress or maximum length");
            }
            if remaining != 0f32 && (
                length(delta) < style.minimum - 0.00001f32 || dot(
                    unit_vector(delta),
                    unit_vector(sub(end, point))
                ) < cosf(style.angle) - 0.00001f32
            ) {
                return error("lightning step left its cone or length interval");
            }
            if length(sub(next, lightning_step(point, end, style, i))) != 0f32 {
                return error("lightning seed is not repeatable");
            }
            point = next;
            i = i + 1u32;
        }
        style.seed = style.seed + 1u32;
    }
    var mesh: Mesh = mesh_new();
    if !lightning_mesh(mut mesh, vec(0f32, 0f32, 0f32), end, style) {
        return false;
    }
    var i: u32 = 0u32;
    while i < mesh_triangle_count(read mesh) {
        var primitive: MeshTriangle = mesh_triangle(read mesh, i);
        if primitive.flags != 4u32 || primitive.material != style.region {
            return error("lightning lost its unshadowed material");
        }
        i = i + 1u32;
    }
    return mesh_triangle_count(read mesh) != 0u32;
}
