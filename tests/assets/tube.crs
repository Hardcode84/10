fn asset_test_tube_case(diagonal: f32) -> bool {
    var mesh: Mesh = mesh_new();
    var bend: TubeBend = make TubeBend {
        radius: 1f32,
        tube_radius: 0.2f32,
        incoming: 2f32,
        outgoing: 2f32,
        diagonal: diagonal,
        sides: 8u32,
        steps: tube_sweep_steps((0.5f32 * PI)),
        tile_metres: 2f32
    };
    if !solid_tube_bend(mut mesh, bend, 0u32) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append_solid(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var scene: CollisionScene = collision_new();
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var middle: Vec3 = vec(
        1f32 - cosf((0.25f32 * PI)) + diagonal * 0.35355339059f32,
        2f32 + sinf((0.25f32 * PI)) + diagonal * 0.35355339059f32,
        0f32
    );
    if collision_position_valid(read scene, 0u32, middle, 0.05f32) || !collision_position_valid(
        read scene,
        0u32,
        add(middle, vec(0f32, 0f32, 0.6f32)),
        0.05f32
    ) {
        return error("bent tube lost its solid interior or exterior clearance");
    }
    var entry: CollisionContact = collision_sweep(
        read scene,
        0u32,
        vec(0f32, -1f32, 0f32),
        vec(0f32, 4f32, 0f32),
        0.1f32
    );
    var exit_hit: CollisionContact = collision_sweep(
        read scene,
        0u32,
        vec(4f32 + diagonal * 0.70710678118f32, 3f32 + diagonal * 0.70710678118f32, 0f32),
        vec(-4f32, 0f32, 0f32),
        0.1f32
    );
    return absf(entry.hit.time - 0.225f32) < 0.0001f32 && absf(exit_hit.hit.time - 0.225f32) < 0.0001f32 || error(
        "bent tube end caps are open or misplaced"
    );
}
fn asset_test_tube() -> bool {
    return asset_test_tube_sweep(0.0000001f32) && asset_test_tube_case(0f32) && asset_test_tube_case(
        2f32
    ) && asset_test_tube_sweep(0f32) && asset_test_tube_sweep(0.1f32) && asset_test_tube_sweep(
        1.0471975512f32
    ) && asset_test_tube_sweep(2.3f32) && asset_test_tube_spatial() && asset_test_helix(0f32) && asset_test_helix(
        3f32
    );
}

fn asset_test_sweep_closed(mesh: read Mesh, end: Vec3, direction: Vec3) -> bool {
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append_solid(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var scene: CollisionScene = collision_new();
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var hit: CollisionContact = collision_sweep(
        read scene,
        0u32,
        add(end, direction),
        scale(direction, -2f32),
        0.1f32
    );
    if absf(hit.hit.time - 0.45f32) > 0.00001f32 || collision_position_valid(
        read scene,
        0u32,
        sub(end, direction),
        0.05f32
    ) {
        return error("swept pipe missed its end cap or solid interior");
    }
    return true;
}
fn asset_test_tube_sweep(angle: f32) -> bool {
    var mesh: Mesh = mesh_new();
    var radial: Vec3 = vec(cosf(0.4f32), 0f32, sinf(0.4f32));
    var sweep: TubeSweep = tube_sweep_begin(
        vec(2f32, -1f32, 3f32),
        vec(0f32, 1f32, 0f32),
        radial,
        make TubeStyle {
            radius: 0.2f32,
            sides: 12u32,
            tile_metres: 2f32,
            region: 0u32
        }
    );
    var corner: Vec3 = vec(2f32, 2f32, 3f32);
    var direction: Vec3 = vec(sinf(angle), cosf(angle), 0f32);
    var end: Vec3 = add(corner, scale(direction, 6f32));
    if !tube_sweep_corner(mut mesh, mut sweep, corner, direction, 0.8f32) {
        return false;
    }
    var bend_count: u32 = mesh_triangle_count(read mesh);
    if !tube_sweep_corner(
        mut mesh,
        mut sweep,
        add(corner, scale(direction, 3f32)),
        direction,
        0.8f32
    ) {
        return false;
    }
    if mesh_triangle_count(read mesh) != bend_count {
        return error("straight waypoint adds redundant pipe geometry");
    }
    if !tube_sweep_finish(mut mesh, mut sweep, end) {
        return false;
    }
    var first: MeshVertex = mesh_triangle(read mesh, 0u32).vertices[0usize];
    var expected: Vec3 = add(
        vec(2f32, -1f32, 3f32),
        add(
            scale(radial, 0.2f32 * cosf(0.2617993878f32)),
            scale(
                cross(radial, vec(0f32, 1f32, 0f32)),
                0.2f32 * sinf(0.2617993878f32)
            )
        )
    );
    if length(sub(vec(first.x, first.y, first.z), expected)) > 0.00001f32 {
        return error("swept pipe moved or rotated its entry profile");
    }
    return asset_test_sweep_closed(read mesh, end, direction);
}
fn asset_test_tube_spatial() -> bool {
    var mesh: Mesh = mesh_new();
    var sweep: TubeSweep = tube_sweep_begin(
        vec(0f32, 0f32, 0f32),
        vec(0f32, 1f32, 0f32),
        vec(1f32, 0f32, 0f32),
        make TubeStyle {
            radius: 0.2f32,
            sides: 12u32,
            tile_metres: 2f32,
            region: 0u32
        }
    );
    var end: Vec3 = vec(4f32, 3f32, 5f32);
    if !tube_sweep_corner(
        mut mesh,
        mut sweep,
        vec(0f32, 3f32, 0f32),
        vec(1f32, 0f32, 0f32),
        1f32
    ) || !tube_sweep_corner(
        mut mesh,
        mut sweep,
        vec(4f32, 3f32, 0f32),
        vec(0f32, 0f32, 1f32),
        0.75f32
    ) || !tube_sweep_finish(mut mesh, mut sweep, end) {
        return false;
    }
    return asset_test_sweep_closed(read mesh, end, vec(0f32, 0f32, 1f32));
}

fn asset_test_helix(orbit: f32) -> bool {
    var mesh: Mesh = mesh_new();
    if !helix_tube(
        mut mesh,
        make HelixTube {
            orbit: orbit,
            height: 12f32,
            turns: 2u32,
            phase: 0f32,
            style: make TubeStyle {
                radius: 0.4f32,
                sides: 8u32,
                tile_metres: 1f32,
                region: 0u32
            }
        }
    ) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    var scene: CollisionScene = collision_new();
    if !collision_append_solid(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var entry: CollisionContact = collision_sweep(
        read scene,
        0u32,
        vec(orbit, -1f32, 0f32),
        vec(0f32, 2f32, 0f32),
        0.05f32
    );
    var end: CollisionContact = collision_sweep(
        read scene,
        0u32,
        vec(orbit, 13f32, 0f32),
        vec(0f32, -2f32, 0f32),
        0.05f32
    );
    return entry.hit.time < 1f32 && end.hit.time < 1f32 && !collision_position_valid(
        read scene,
        0u32,
        vec(0f32, 1.5f32, orbit),
        0.05f32
    ) && collision_position_valid(
        read scene,
        0u32,
        vec(orbit + 1f32, 6f32, 0f32),
        0.05f32
    ) || error("helical solid lost caps, curved interior, or exterior clearance");
}

fn asset_test_broken_box() -> bool {
    return asset_test_broken_box_case(false) && asset_test_broken_box_case(true);
}
fn asset_test_broken_box_case(chunk: bool) -> bool {
    var mesh: Mesh = mesh_new();
    var shape: BrokenBox = make BrokenBox {
        length: 6f32,
        depth: 2f32,
        width: 3f32,
        tear: 0.2f32,
        wall: 0.2f32,
        recess: 1f32,
        seed: 7u32,
        shell: 0u32,
        fracture: 1u32
    };
    var built: bool = false;
    if chunk {
        built = broken_box_chunk_mesh(mut mesh, shape);
    } else {
        built = broken_box_mesh(mut mesh, shape);
    }
    if !built {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append_solid(
        mut builder,
        read mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var scene: CollisionScene = collision_new();
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var hit: CollisionContact = collision_sweep(
        read scene,
        0u32,
        vec(8f32, 0f32, 0f32),
        vec(-5f32, 0f32, 0f32),
        0f32
    );
    if chunk {
        var other: CollisionContact = collision_sweep(
            read scene,
            0u32,
            vec(-8f32, 0f32, 0f32),
            vec(5f32, 0f32, 0f32),
            0f32
        );
        if absf(other.point.x + shape.length - shape.recess) > 0.00001f32 || collision_position_valid(
            read scene,
            0u32,
            vec(0f32, 0f32, 0f32),
            0.1f32
        ) {
            return error("beam chunk lost its solid middle or second recessed end");
        }
    }
    return absf(hit.point.x - (shape.length - shape.recess)) < 0.00001f32 && collision_position_valid(
        read scene,
        0u32,
        vec(5.5f32, 0f32, 0f32),
        0.1f32
    ) && !collision_position_valid(read scene, 0u32, vec(3f32, 0f32, 0f32), 0.1f32) || error(
        "torn box must have a closed solid back and an open recessed end"
    );
}
