fn asset_test_ports(asset: read RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < asset_port_count(read asset.ports) {
        var port: RoomPort = asset_port(read asset.ports, i);
        var face: HullFace = asset_face(read asset.hull, port.face);
        if asset_name_length(port.id) == 0u32 || asset_name_length(port.profile.name) == 0u32 || face.count != port.profile.shape.sides || !collision_rigid(
            port.basis
        ) {
            return error("invalid connection identity, profile, or frame");
        }
        if dot(hull_frame(read asset.hull, face).normal, port.basis.forward) < 0.9999f32 {
            return error("port frame does not point outward");
        }
        var j: u32 = 0u32;
        while j < face.count {
            var point: Vec3 = hull_corner(read asset.hull, face, j);
            if length(sub(point, connection_point(port, j))) > 0.0001f32 || absf(
                length(sub(point, port.position)) - port.profile.radius
            ) > 0.0001f32 {
                return error("port boundary differs from its shared profile");
            }
            j = j + 1u32;
        }
        if !asset_test_contacts(read asset, face, 0.35f32) || !asset_test_contacts(
            read asset,
            face,
            0.06f32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
