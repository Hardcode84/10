fn asset_test_face(hull: read AssetHull, face: HullFace) -> bool {
    var frame: SurfaceFrame = hull_frame(read hull, face);
    var i: u32 = 0u32;
    while i < asset_vertex_count(read hull) {
        if dot(frame.normal, sub(asset_vertex(read hull, i), frame.origin)) > 0.0001f32 {
            return error("asset hull is not convex or faces point inward");
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < face.count {
        if absf(
            dot(frame.normal, sub(hull_corner(read hull, face, i), frame.origin))
        ) > 0.0001f32 {
            return error("asset polygon is not planar");
        }
        i = i + 1u32;
    }
    return true;
}
fn asset_test_edge(hull: read AssetHull, a: u32, b: u32) -> bool {
    var forward: u32 = 0u32;
    var reverse: u32 = 0u32;
    var f: u32 = 0u32;
    while f < asset_face_count(read hull) {
        var face: HullFace = asset_face(read hull, f);
        var i: u32 = 0u32;
        while i < face.count {
            var x: u32 = asset_index(read hull, face.first + i);
            var y: u32 = asset_index(read hull, face.first + (i + 1u32) % face.count);
            if x == a && y == b {
                forward = forward + 1u32;
            }
            if x == b && y == a {
                reverse = reverse + 1u32;
            }
            i = i + 1u32;
        }
        f = f + 1u32;
    }
    return forward == 1u32 && reverse == 1u32 || error(
        "asset edge is not closed with opposite winding"
    );
}
fn asset_test_contacts(asset: read RoomAsset, face: HullFace, radius: f32) -> bool {
    var center: Vec3 = vec(0f32, 0f32, 0f32);
    var i: u32 = 0u32;
    while i < face.count {
        center = add(center, hull_corner(read asset.hull, face, i));
        i = i + 1u32;
    }
    center = scale(center, 1f32 / face.count as f32);
    var normal: Vec3 = hull_frame(read asset.hull, face).normal;
    var start: Vec3 = sub(center, scale(normal, 0.5f32));
    if !hull_contains(read asset.hull, start, radius) {
        return !collision_position_valid(read asset.collision, 0u32, start, radius) || error(
            "narrow surround accepted a sphere that overlaps another hull face"
        );
    }
    var expected: Hit = asset_hull_contact(
        read asset.hull,
        start,
        scale(normal, 2f32),
        radius
    );
    var contact: CollisionContact = collision_sweep(
        read asset.collision,
        0u32,
        start,
        scale(normal, 2f32),
        radius
    );
    if absf(contact.hit.time - expected.time) >= 0.0001f32 || dot(
        contact.hit.normal,
        expected.normal
    ) < 0.999f32 {
        asset_contact_report(
            face.region,
            radius,
            contact.hit.time,
            expected.time,
            dot(contact.hit.normal, expected.normal)
        );
        return error("room render face and sphere collision disagree");
    }
    return true;
}
fn asset_test_shell(asset: read RoomAsset) -> bool {
    var f: u32 = 0u32;
    while f < asset_face_count(read asset.hull) {
        var face: HullFace = asset_face(read asset.hull, f);
        if !asset_test_face(read asset.hull, face) || !asset_test_contacts(
            read asset,
            face,
            0.35f32
        ) || !asset_test_contacts(read asset, face, 0.06f32) {
            return false;
        }
        var i: u32 = 0u32;
        while i < face.count {
            if !asset_test_edge(
                read asset.hull,
                asset_index(read asset.hull, face.first + i),
                asset_index(read asset.hull, face.first + (i + 1u32) % face.count)
            ) {
                return false;
            }
            i = i + 1u32;
        }
        f = f + 1u32;
    }
    return hull_contains(read asset.hull, asset.spawn.position, 0.35f32) && collision_position_valid(
        read asset.collision,
        0u32,
        asset.spawn.position,
        0.35f32
    ) && collision_rigid(asset.spawn.basis) || error("invalid asset spawn frame or clearance");
}
fn asset_test_variant(values: read AssetValues) -> bool {
    var asset: RoomAsset = room_asset_new();
    return room_build(read values, mut asset) && asset_test_shell(read asset) && asset_test_ports(
        read asset
    ) && asset_test_uv(read asset, read values);
}
fn asset_test_invalid(values: mut AssetValues) -> bool {
    asset_parameters_reset(mut values);
    var parameter: AssetParameter = room_parameter(0u32);
    asset_value_set(mut values, 0u32, parameter.minimum - parameter.step);
    var asset: RoomAsset = room_asset_new();
    if room_build(read values, mut asset) {
        return error("out-of-range asset parameter was accepted");
    }
    return true;
}
fn asset_tests() -> bool {
    var values: AssetValues = asset_values_new();
    if !asset_values_allocate(mut values, room_parameter_count()) {
        return false;
    }
    asset_parameters_reset(mut values);
    if !asset_test_variant(read values) {
        return false;
    }
    var variant: u32 = 0u32;
    while variant < 2u32 {
        var i: u32 = 0u32;
        while i < room_parameter_count() {
            var parameter: AssetParameter = room_parameter(i);
            var value: f32 = parameter.minimum;
            if variant == 1u32 {
                value = parameter.maximum;
            }
            asset_value_set(mut values, i, value);
            i = i + 1u32;
        }
        if !asset_test_variant(read values) {
            return false;
        }
        variant = variant + 1u32;
    }
    return asset_test_invalid(mut values);
}
fn asset_test_uv(asset: read RoomAsset, values: read AssetValues) -> bool {
    var i: u32 = 0u32;
    while i < mesh_triangle_count(read asset.mesh) {
        var primitive: MeshTriangle = mesh_triangle(read asset.mesh, i);
        var j: usize = 0usize;
        while j < 3usize {
            var a: MeshVertex = primitive.vertices[j];
            var b: MeshVertex = primitive.vertices[(j + 1usize) % 3usize];
            var edge: Vec3 = vec(b.x - a.x, b.y - a.y, b.z - a.z);
            var material: PanelMaterial = room_material(primitive.material, read values);
            var u: f32 = (b.u - a.u) * material.tile_metres;
            var v: f32 = (b.v - a.v) * panel_tile_height(material);
            var square: f32 = dot(edge, edge);
            if absf(square - u * u - v * v) > (square + 1f32) * 0.00001f32 {
                return error("surface UV scale does not preserve physical texture density");
            }
            j = j + 1usize;
        }
        i = i + 1u32;
    }
    return true;
}

// Returns the first exit from the convex hull eroded by the sphere radius.
fn asset_hull_contact(hull: read AssetHull, start: Vec3, travel: Vec3, radius: f32) -> Hit {
    var result: Hit = miss();
    var i: u32 = 0u32;
    while i < asset_face_count(read hull) {
        var plane: SurfaceFrame = hull_frame(read hull, asset_face(read hull, i));
        var approach: f32 = dot(plane.normal, travel);
        if approach > 0f32 {
            var time: f32 = (-dot(plane.normal, sub(start, plane.origin)) - radius) / approach;
            if time < result.time {
                result = make Hit {
                    time: time,
                    normal: scale(plane.normal, -1f32)
                };
            }
        }
        i = i + 1u32;
    }
    return result;
}

fn asset_test_truncated_cube(extent: f32) -> bool {
    var asset: RoomAsset = room_asset_new();
    if !truncated_cube_hull(mut asset.hull, extent, 0u32, 1u32) || !room_asset_finish(mut asset) || !asset_test_shell(
        read asset
    ) {
        return false;
    }
    var edge: f32 = 2f32 * extent * (sqrtf(2f32) - 1f32);
    var face_id: u32 = 0u32;
    while face_id < asset_face_count(read asset.hull) {
        var face: HullFace = asset_face(read asset.hull, face_id);
        var i: u32 = 0u32;
        while i < face.count {
            var a: Vec3 = hull_corner(read asset.hull, face, i);
            var b: Vec3 = hull_corner(read asset.hull, face, (i + 1u32) % face.count);
            if absf(length(sub(b, a)) - edge) > edge * 0.00001f32 {
                return error("truncated cube edges are not regular");
            }
            i = i + 1u32;
        }
        face_id = face_id + 1u32;
    }
    return true;
}

fn asset_test_truncation(extent: f32, width: f32, depth: f32) -> bool {
    var source: RoomAsset = room_asset_new();
    var target: RoomAsset = room_asset_new();
    if !rhombi_hull(mut source.hull, extent, width, 0u32, 1u32) || !room_asset_finish(mut source) || !asset_test_shell(
        read source
    ) || !hull_truncate(read source.hull, mut target.hull, depth, 2u32) || !room_asset_finish(
        mut target
    ) || !asset_test_shell(read target) {
        return false;
    }
    var vertex: u32 = 0u32;
    while vertex < asset_vertex_count(read source.hull) {
        var original: Vec3 = asset_vertex(read source.hull, vertex);
        var normal: Vec3 = unit_vector(original);
        var face: HullFace = asset_face(
            read target.hull,
            asset_face_count(read source.hull) + vertex
        );
        var i: u32 = 0u32;
        while i < face.count {
            var point: Vec3 = hull_corner(read target.hull, face, i);
            if absf(dot(normal, point) - length(original) + depth) > length(original) * 0.00001f32 {
                return error("vertex cut does not lie on its radial plane");
            }
            i = i + 1u32;
        }
        vertex = vertex + 1u32;
    }
    var inset: RoomAsset = room_asset_new();
    asset_hull_swap(mut inset.hull, mut target.hull);
    rhombi_inset_corners(mut inset.hull, width * 0.1f32);
    return room_asset_finish(mut inset) && asset_test_shell(read inset) && asset_test_corner_planes(
        read source.hull,
        read inset.hull,
        width * 0.1f32
    );
}

fn asset_test_corner_planes(source: read AssetHull, target: read AssetHull, depth: f32) -> bool {
    var i: u32 = 0u32;
    while i < asset_face_count(read source) {
        var face: HullFace = asset_face(read source, i);
        var before: SurfaceFrame = hull_frame(read source, face);
        var after: SurfaceFrame = hull_frame(read target, asset_face(read target, i));
        var expected: f32 = 0f32;
        if face.region == 1u32 {
            expected = depth;
        }
        if dot(before.normal, after.normal) < 0.99999f32 || absf(
            dot(before.normal, sub(before.origin, after.origin)) - expected
        ) > 0.0001f32 {
            return error("corner inset changed a socket plane or missed its corner depth");
        }
        i = i + 1u32;
    }
    return true;
}
