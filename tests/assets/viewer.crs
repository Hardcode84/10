fn asset_rebuild_checks(session: AssetSession) -> bool {
    var asset: RoomAsset = room_asset_new();
    var values: AssetValues = asset_values_new();
    if !asset_values_allocate(mut values, room_parameter_count()) {
        return false;
    }
    asset_parameters_reset(mut values);
    if !room_build(read values, mut asset) || !asset_session_open(mut session) {
        return false;
    }
    var range: MeshRange = mesh_empty_range();
    if !asset_view_upload(mut session, read asset, mut range, false) {
        return false;
    }
    var original: MeshRange = range;
    if !asset_flight_checks(read asset, range) {
        return false;
    }
    var state: AssetViewState = asset_view_state(1u32);
    var i: u32 = 0u32;
    var parameter: AssetParameter = room_parameter(0u32);
    var edits: u32 = ((parameter.initial - parameter.minimum) / parameter.step) as u32 + 1u32;
    while i < edits {
        var good: bool = true;
        asset = asset_view_edit(
            mut session,
            read state,
            mut values,
            move asset,
            mut range,
            45u32,
            false,
            mut good
        );
        if !good {
            return false;
        }
        i = i + 1u32;
    }
    if !asset_rebuild_result(read asset, read values, range, original) {
        return false;
    }
    var port: RoomPort = asset_port(read asset.ports, 0u32);
    state.camera.view = 3u32;
    state.camera.flight = make AssetSpawn {
        position: sub(port.position, scale(port.basis.forward, 2f32)),
        basis: port.basis
    };
    var labels: MeshRange = asset_label_range(read session);
    {
        var renderer: mut Renderer = asset_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        if !asset_scene(mut input, read asset, range, labels, state.camera) {
            return false;
        }
    }
    if !asset_session_draw(mut session) || !asset_view_test_pixels(read session) {
        return false;
    }
    return asset_session_finish(mut session);
}
fn asset_rebuild_result(
    asset: read RoomAsset,
    values: read AssetValues,
    range: MeshRange,
    original: MeshRange
) -> bool {
    var parameter: AssetParameter = room_parameter(0u32);
    var expected: f32 = original.bounds[3usize] * parameter.minimum / parameter.initial;
    if asset_value(read values, 0u32) != parameter.minimum || range.first != 0u32 || range.count != mesh_triangle_count(
        read asset.mesh
    ) || absf(range.bounds[3usize] - expected) > 0.0001f32 {
        return error(
            "viewer rebuild did not replace the retained asset or restore rejected parameters"
        );
    }
    if !hull_contains(read asset.hull, asset.spawn.position, 0.35f32) {
        return error("rebuild lost spawn clearance");
    }
    return true;
}
