fn asset_test_inset() -> bool {
    var asset: RoomAsset = room_asset_new();
    var profile: RegularProfile = make RegularProfile {
        sides: 12u32,
        phase: 0.1f32
    };
    if !loft_allocate(mut asset.hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut asset.hull, profile, 0u32, 0f32, 8f32);
    loft_ring(mut asset.hull, profile, 1u32, 8f32, 8f32);
    loft_span(mut asset.hull, profile, 0u32, 0u32);
    loft_caps(mut asset.hull, profile, 2u32, 0u32, 0u32);
    var port: RoomPort = make RoomPort {
        id: asset_name("OFFSET"),
        profile: service_hex_profile(),
        face: 12u32,
        position: vec(1.5f32, 0f32, -0.75f32),
        basis: make Basis {
            right: vec(1f32, 0f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(0f32, -1f32, 0f32)
        }
    };
    var next: AssetHull = asset_hull_new();
    if !asset_test_face_border(mut asset.hull, mut next, 0u32) || !asset_test_face_border(
        mut asset.hull,
        mut next,
        port.face
    ) {
        return false;
    }
    var surround: RoomPort = port;
    surround.profile.radius = surround.profile.radius + 0.1f32 / cosf(
        3.14159265359f32 / port.profile.shape.sides as f32
    );
    if !hull_convex_partition(read asset.hull, mut next, surround, 2u32) {
        return false;
    }
    asset_hull_swap(mut asset.hull, mut next);
    if !hull_polygon_partition(read asset.hull, mut next, port, 1u32) || !asset_port_append(
        mut asset.ports,
        port
    ) {
        return false;
    }
    asset_hull_swap(mut asset.hull, mut next);
    asset.spawn.position = vec(0f32, 4f32, 0f32);
    if !room_asset_finish(mut asset) || !asset_test_shell(read asset) {
        return false;
    }
    var render: Mesh = mesh_new();
    var walls: Mesh = mesh_new();
    if !room_linked_mesh(read asset, mut render, mut walls, 0u32) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append(
        mut builder,
        read walls,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var scene: CollisionScene = collision_new();
    if !collision_finish(move builder, mut scene) {
        return false;
    }
    var through: CollisionContact = collision_sweep(
        read scene,
        0u32,
        add(port.position, vec(0f32, 1f32, 0f32)),
        vec(0f32, -2f32, 0f32),
        0.35f32
    );
    var wall: CollisionContact = collision_sweep(
        read scene,
        0u32,
        add(port.position, vec(-4f32, 1f32, 0f32)),
        vec(0f32, -2f32, 0f32),
        0.35f32
    );
    return through.hit.time > 1f32 && wall.hit.time < 1f32 || error(
        "convex inset failed to open only the port polygon"
    );
}

fn asset_test_face_border(hull: mut AssetHull, next: mut AssetHull, id: u32) -> bool {
    var face: HullFace = asset_face(read hull, id);
    if !hull_face_border(read hull, mut next, id, 0.2f32, 2u32) {
        return false;
    }
    var inner: HullFace = asset_face(read next, id);
    var normal: Vec3 = hull_frame(read hull, face).normal;
    var i: u32 = 0u32;
    while i < face.count {
        var a: Vec3 = hull_corner(read hull, face, i);
        var b: Vec3 = hull_corner(read hull, face, (i + 1u32) % face.count);
        var inward: Vec3 = cross(normal, unit_vector(sub(b, a)));
        var first: f32 = dot(sub(hull_corner(read next, inner, i), a), inward);
        var second: f32 = dot(
            sub(hull_corner(read next, inner, (i + 1u32) % face.count), a),
            inward
        );
        if absf(first - 0.2f32) > 0.00001f32 || absf(second - 0.2f32) > 0.00001f32 {
            return error("polygon border does not have constant physical width");
        }
        i = i + 1u32;
    }
    asset_hull_swap(mut hull, mut next);
    return true;
}
