fn asset_test_flash() -> bool {
    var period: u32 = PANEL_PULSE_FRAMES * 4u32;
    var previous: f32 = 1f32;
    var tick: u32 = 0u32;
    while tick < period {
        var intensity: f32 = flash_intensity(period, tick);
        if intensity > previous || intensity < 0f32 || flash_intensity(period, tick + period) != intensity {
            return error("flash fade or cycle is inconsistent");
        }
        if tick >= period / 2u32 && intensity != 0f32 {
            return error("flash dark interval is visible");
        }
        previous = intensity;
        tick = tick + 1u32;
    }
    if flash_intensity(period, 0u32) != 1f32 {
        return error("flash did not appear at full intensity");
    }
    var light: FixtureLight = make FixtureLight {
        space: 7u32,
        period: period,
        position: vec(3f32, 1f32, 4f32),
        colour: vec(0.1f32, 1f32, 4f32),
        radius: 5f32
    };
    var dim: FixtureLight = fixture_light_at(light, period / 4u32);
    if length(
        sub(dim.colour, scale(light.colour, flash_intensity(period, period / 4u32)))
    ) != 0f32 || length(fixture_light_at(light, period / 2u32).colour) != 0f32 {
        return error("flash light differs from its material envelope");
    }
    var emitter: SparkEmitter = make SparkEmitter {
        space: 0u32,
        position: vec(2f32, -4f32, 3f32),
        direction: vec(0f32, 1f32, 0f32),
        period: period,
        seed: 19u32,
        count: 12u32,
        speed: 7f32,
        size: 0.1f32,
        material: 2u32
    };
    var point: Vec3 = spark_emitter_point(emitter, 3u32, period / 4u32);
    return length(sub(spark_emitter_point(emitter, 3u32, 0u32), emitter.position)) == 0f32 && length(
        sub(point, emitter.position)
    ) > 0f32 && length(sub(point, spark_emitter_point(emitter, 3u32, period / 4u32))) == 0f32 || error(
        "spark burst is not repeatable at an absolute tick"
    );
}

fn asset_test_arc() -> bool {
    var asset: RoomAsset = room_asset_new();
    if !asset_test_part_room(mut asset) || !room_asset_finish(mut asset) {
        return false;
    }
    var emitter: ArcEmitter = make ArcEmitter {
        space: 0u32,
        position: vec(1f32, 2f32, 0f32),
        pivot: vec(0f32, 2f32, 0f32),
        angular: vec(0f32, 1f32, 0f32),
        direction: vec(1f32, 0f32, 0f32),
        reach: 30f32,
        period: 256u32,
        cycle_stride: 1u32,
        cycle_seed: 19u32,
        style: make LightningStyle {
            minimum: 1f32,
            maximum: 2f32,
            angle: 0.4f32,
            radius: 0.1f32,
            seed: 17u32,
            region: 2u32
        },
        spark_material: 3u32
    };
    if !asset_test_arc_pose(read asset, emitter) {
        return false;
    }
    if arc_contact(read asset.collision, emitter, emitter.period / 2u32).active {
        return error("arc remains visible in its dark interval");
    }
    if !arc_emitter_append(mut asset.arcs, emitter) {
        return false;
    }
    var placed: ArcEmitters = arc_emitters_new();
    if !arc_emitters_place(read asset.arcs, mut placed, 7u32, 11u32) {
        return false;
    }
    var copy: ArcEmitter = arc_emitter(read placed, 0u32);
    if copy.space != 7u32 || copy.style.region != 13u32 || copy.spark_material != 14u32 {
        return error("arc room placement lost material offsets");
    }
    collision_room_unload(mut asset.collision, 0u32);
    return asset_test_arc_pair(emitter) && (
        !arc_contact(read asset.collision, emitter, 0u32).active || error(
            "arc queried an unloaded room"
        )
    );
}

fn asset_test_flash_concrete() -> bool {
    var concrete: PanelMaterial = hex_tunnel_material();
    concrete.finish = SURFACE_CONCRETE;
    concrete.tile_metres = 3f32;
    concrete.tile_height = 4f32;
    var flash: PanelMaterial = concrete;
    flash.finish = METAL_FLASH;
    flash.emission_period = 256u32;
    return panel_texture_width(concrete) > 1u32 && panel_texture_height(concrete) > 1u32 && panel_texture_width(
        flash
    ) == 1u32 && panel_texture_height(flash) == 1u32 || error(
        "concrete and flash material layouts overlap"
    );
}

fn asset_test_arc_pair(emitter: ArcEmitter) -> bool {
    emitter.cycle_stride = 3u32;
    var other: ArcEmitter = emitter;
    other.style.seed = other.style.seed + 1u32;
    var tick: u32 = 0u32;
    while tick < emitter.period * 12u32 {
        if arc_active(emitter, tick) != arc_active(other, tick) {
            return error("paired strikes differ in timing");
        }
        tick = tick + 1u32;
    }
    return flash_intensity(emitter.period, emitter.period * 7u32 / 16u32) == 0f32 || error(
        "near-black flash tail remains visible"
    );
}

fn asset_test_arc_pose(asset: read RoomAsset, emitter: ArcEmitter) -> bool {
    var tick: u32 = 0u32;
    while tick < emitter.period * 3u32 {
        if !arc_active(emitter, tick) {
            tick = tick + 7u32;
            continue;
        }
        var contact: ArcContact = arc_contact(read asset.collision, emitter, tick);
        var birth: ArcContact = arc_contact(
            read asset.collision,
            emitter,
            tick / emitter.period * emitter.period
        );
        if length(sub(contact.start, birth.start)) != 0f32 || length(
            sub(contact.end, birth.end)
        ) != 0f32 {
            return error("arc moved during its fade");
        }
        var direction: Vec3 = arc_vector(
            emitter,
            emitter.direction,
            arc_start_tick(emitter, tick)
        );
        var expected: Vec3 = hull_radial_contact(read asset.hull, direction);
        expected.y = 2f32;
        if !contact.active || length(sub(contact.end, expected)) > 0.00001f32 || length(
            sub(contact.start, add(emitter.pivot, direction))
        ) > 0.00001f32 {
            return error("arc did not retain its cycle-start contact pose");
        }
        var light: FixtureLight = arc_light(emitter, contact, tick);
        if length(
            sub(light.position, scale(add(contact.start, contact.end), 0.5f32))
        ) != 0f32 {
            return error("arc light did not follow contacts");
        }
        tick = tick + 7u32;
    }
    return true;
}
