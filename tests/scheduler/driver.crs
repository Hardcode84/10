fn main(argc: i32, argv: **u8) -> i32 {
    if scheduler_benchmark_enabled() {
        return run_scheduler_benchmark();
    }
    var mode: u32 = scheduler_test_mode(argc, argv);
    if mode != 0u32 {
        return test_contract(mode);
    }
    scheduler_test_deaths(argv);
    return run_scheduler_suite();
}
