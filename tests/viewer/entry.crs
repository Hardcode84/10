fn main(argc: i32, argv: **u8) -> i32 {
    var o: Launch = uninit;
    if !game_options(argc, argv, &o) {
        return 2i32;
    }
    o.config.headless = true;
    o.capture = "build/test-viewer.ppm";
    return viewer_check(game_session(&o));
}
fn viewer_check(session: GameSession) -> i32 {
    var scene: CollisionScene = collision_new();
    var trial: Trial = new_trial();
    if !game_world_open(mut session, mut scene, mut trial) {
        return 1i32;
    }
    if !viewer_check_renderer(mut session) || !viewer_open(mut session, 8u32) {
        return 1i32;
    }
    var tick: u32 = 0u32;
    while tick < 2u32 {
        {
            var frame: FrameInput = renderer_inputs(mut session.renderer);
            viewer_scene(
                mut frame,
                read session.world,
                session.control.launch.config,
                8u32,
                tick,
                256u32
            );
        }
        if !visibility_compare(&session.renderer.state, tick == 0u32) {
            return 1i32;
        }
        tick = tick + 1u32;
    }
    return (!game_finish(mut session)) as i32;
}
fn viewer_check_renderer(session: mut GameSession) -> bool {
    var width: u32 = session.control.launch.config.width;
    var height: u32 = session.control.launch.config.height;
    var config: RenderConfig = make RenderConfig {
        width: width,
        height: height,
        output_width: width,
        output_height: height,
        shader_checks: true,
        read_pixels: true,
        debug_pixels: 0u32,
        baseline: 0u32,
        view_budget: 1u32,
        portal_budget: graph_ports(read session.control.graph),
        task_budget: ((width + 7u32) / 8u32) * ((height + 7u32) / 8u32),
        crossing_limit: 0u32,
        fault: 0u32
    };
    return app_renderer_open(&session.renderer.state, null(*u8), &config);
}
