// Flight inspection course. Run: crust demo.crs levels/prefabs.crs
// SIDE-0 is the only open start exit. All unused ports have closed stoppers.
// Main route: open hex door, 10 m hex, elbow, 1 m hex, T, 1 m hex, X,
// rotor shaft, hub FORWARD, open oct door, 10 m oct, elbow, T, nine oct Xs.
// The hex T side branch shows the blind passage; the X branch shows the
// ending room. Neither branch ends this demo. Return to continue the course.
// Oct Xs use upper 0/1/2, each with lower 0/1/2, in that order. Straight
// sections separate them. All use ENTRY to EXIT and retain the same roll.
// Each room has its own space. Geometry does not need a Euclidean embedding.
fn demo_room_build(
    asset: mut RoomAsset,
    collision: mut CollisionScene,
    mesh: mut Mesh,
    graph: mut RoomGraph
) -> bool {
    var values: AssetValues = asset_values_new();
    if !course_values(PREFAB_RADIAL_START, 0u32, mut values) || !room_build(
        read values,
        mut asset
    ) || !graph_allocate(mut graph, 128u32, 0u32) {
        return false;
    }
    var exit_port: RoomPort = asset_port(read asset.ports, 0u32);
    var direction: Vec3 = unit_vector(sub(exit_port.position, asset.spawn.position));
    var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), direction));
    asset.spawn.basis = make Basis {
        right: right,
        up: cross(direction, right),
        forward: direction
    };
    var builder: CollisionBuilder = collision_builder_new();
    if !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        PREFAB_RADIAL_START,
        0u32
    ) {
        return false;
    }
    var cursor: CourseCursor = make CourseCursor {
        room: 0u32
    };
    if!(
        course_hex_route(mut graph, mut builder, mut mesh, mut cursor) && course_rotor_route(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor
        ) && course_oct_route(mut graph, mut builder, mut mesh, mut cursor) && course_close_ports(
            mut graph,
            mut builder,
            mut mesh
        ) && course_links(read graph, mut builder)
    ) {
        return false;
    }
    return collision_finish(move builder, mut collision);
}
fn course_hex_route(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut CourseCursor
) -> bool {
    if!(
        course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("SIDE-0"),
            PREFAB_HEX_STOPPER_OPEN,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_HEX_TUNNEL_10M,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_HEX_ELBOW,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EAST"),
            PREFAB_HEX_TUNNEL,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_HEX_T_JUNCTION,
            asset_name("ENTRY"),
            0u32
        )
    ) {
        return false;
    }
    var branch: CourseCursor = cursor;
    if !course_step(
        mut graph,
        mut builder,
        mut mesh,
        mut branch,
        asset_name("EAST"),
        PREFAB_HEX_DEAD_END,
        asset_name("ENTRY"),
        0u32
    ) {
        return false;
    }
    if!(
        course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_HEX_TUNNEL,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_HEX_X_JUNCTION,
            asset_name("ENTRY"),
            0u32
        )
    ) {
        return false;
    }
    branch = cursor;
    return course_step(
        mut graph,
        mut builder,
        mut mesh,
        mut branch,
        asset_name("EAST"),
        PREFAB_HEX_ENDING,
        asset_name("BOTTOM"),
        0u32
    );
}
fn course_rotor_route(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut CourseCursor
) -> bool {
    return course_step(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        asset_name("EXIT"),
        PREFAB_ROTOR_SHAFT,
        asset_name("BOTTOM-0"),
        0u32
    ) && course_step(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        asset_name("TOP"),
        PREFAB_ROTOR_HUB,
        asset_name("SHAFT"),
        0u32
    ) && course_step(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        asset_name("FORWARD"),
        PREFAB_OCT_STOPPER_OPEN,
        asset_name("ENTRY"),
        0u32
    );
}
fn course_oct_route(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut CourseCursor
) -> bool {
    if!(
        course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_OCT_TUNNEL_10M,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EXIT"),
            PREFAB_OCT_ELBOW,
            asset_name("ENTRY"),
            0u32
        ) && course_step(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            asset_name("EAST"),
            PREFAB_OCT_T_JUNCTION,
            asset_name("ENTRY"),
            0u32
        )
    ) {
        return false;
    }
    var variant: u32 = 0u32;
    while variant < 9u32 {
        if!(
            course_step(
                mut graph,
                mut builder,
                mut mesh,
                mut cursor,
                asset_name("EXIT"),
                PREFAB_OCT_TUNNEL_10M,
                asset_name("ENTRY"),
                0u32
            ) && course_step(
                mut graph,
                mut builder,
                mut mesh,
                mut cursor,
                asset_name("EXIT"),
                PREFAB_OCT_X_JUNCTION,
                asset_name("ENTRY"),
                variant
            )
        ) {
            return false;
        }
        variant = variant + 1u32;
    }
    return true;
}
fn demo_room_ambient() -> Vec3 {
    return vec(0.08f32, 0.09f32, 0.11f32);
}
fn demo_palette(input: mut FrameInput) -> bool {
    return course_palette(mut input);
}
