// First service-network section. The radial berth has one open hex exit.
// Three straight pig lanes have capped end bays beyond their lateral access junctions.
// Grey service tunnels connect those junctions. Branch passages rejoin after the first
// pig lane, after the middle lane, and at the last lane exit. A lower cross-link
// joins the two side routes. The full detour is longer and has more turns.
// The seed varies detour bends between fixed junctions. Pig lanes and connections stay fixed.
// Inner branches use blue-grey tread plate; outer branches use green ribbed metal.
// The finish changes across the middle pig intersection. Branch materials have no full-bright texels.
// Ochre walls and amber full-bright strips identify the pig lanes. Pigs are not installed.
// Port-derived placements form a continuous rigid layout. The terminal door face is
// at radius SERVICE_END_RADIUS from the spin axis.
const SERVICE_END_RADIUS: f32 = 500f32;
const SERVICE_END_BAY: f32 = 8f32;
const SERVICE_BRANCH_INNER: u32 = 2u32;
const SERVICE_BRANCH_OUTER: u32 = 3u32;
record ServiceBranches {
    approach: LevelCursor;
    first_join: LevelCursor;
    middle: LevelCursor;
    second_join: LevelCursor;
    south: LevelCursor;
    last: LevelCursor;
}
fn demo_room_build(
    asset: mut RoomAsset,
    collision: mut CollisionScene,
    mesh: mut Mesh,
    graph: mut RoomGraph,
    seed: u32
) -> bool {
    var values: AssetValues = asset_values_new();
    if !course_values(PREFAB_RADIAL_START, 0u32, mut values) || !room_build(
        read values,
        mut asset
    ) || !graph_allocate(mut graph, 112u32, seed) {
        return false;
    }
    var port: RoomPort = asset_port(read asset.ports, 0u32);
    var forward: Vec3 = unit_vector(sub(port.position, asset.spawn.position));
    var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
    asset.spawn.basis = make Basis {
        right: right,
        up: cross(forward, right),
        forward: forward
    };
    var builder: CollisionBuilder = collision_builder_new();
    if !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        PREFAB_RADIAL_START,
        0u32
    ) {
        return false;
    }
    var node: GraphNode = graph_node(read graph, 0u32);
    var local: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: vec(0f32, 0f32, 0f32),
        basis: port.basis
    };
    var desired: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: vec(0f32, 0f32, 0f32),
        basis: make Basis {
            right: vec(0f32, 1f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(1f32, 0f32, 0f32)
        }
    };
    node.placement = space_compose(desired, space_inverse(local));
    graph_node_set(mut graph, 0u32, node);
    var cursor: LevelCursor = make LevelCursor {
        room: 0u32,
        exit: asset_name("SIDE-0")
    };
    var branches: ServiceBranches = make ServiceBranches {
        approach: cursor,
        first_join: cursor,
        middle: cursor,
        second_join: cursor,
        south: cursor,
        last: cursor
    };
    if !service_approach(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        mut branches.approach
    ) || !service_runs(mut graph, mut builder, mut mesh, mut cursor, mut branches) || !service_terminal(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor
    ) || !service_build_branches(mut graph, mut builder, mut mesh, branches, seed) || !level_close(
        mut graph,
        mut builder,
        mut mesh
    ) {
        return false;
    }
    return collision_finish(move builder, mut collision) && level_install(
        read graph,
        mut collision
    );
}
fn service_approach(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    branch: mut LevelCursor
) -> bool {
    if !level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_STOPPER_OPEN,
        asset_name("ENTRY"),
        asset_name("EXIT")
    ) || !level_straight(mut graph, mut builder, mut mesh, mut cursor, 8f32) || !service_styled_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        asset_name("ENTRY"),
        asset_name("EXIT"),
        make [u32; 4] {
            0u32,
            SERVICE_BRANCH_INNER,
            0u32,
            0u32
        }
    ) {
        return false;
    }
    branch = cursor;
    branch.exit = asset_name("EAST");
    return level_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        32f32 - 8f32 - service_junction_span()
    ) && service_turn(mut graph, mut builder, mut mesh, mut cursor, true) && level_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        18f32
    );
}
fn service_turn(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    right: bool
) -> bool {
    var entry: AssetName = asset_name("ENTRY");
    var exit_name: AssetName = asset_name("EAST");
    if !right {
        entry = asset_name("EAST");
        exit_name = asset_name("ENTRY");
    }
    return level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_ELBOW,
        entry,
        exit_name
    );
}
fn service_connector(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    right: bool,
    join: mut LevelCursor
) -> bool {
    var branch_style: u32 = SERVICE_BRANCH_INNER;
    if right {
        branch_style = SERVICE_BRANCH_OUTER;
    }
    var half: f32 = (20f32 - service_junction_span()) * 0.5f32;
    var entry: AssetName = asset_name("ENTRY");
    var exit_name: AssetName = asset_name("EXIT");
    if right {
        entry = asset_name("EXIT");
        exit_name = asset_name("ENTRY");
    }
    if !level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32) || !service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        right
    ) || !level_straight(mut graph, mut builder, mut mesh, mut cursor, half) || !service_styled_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        entry,
        exit_name,
        make [u32; 4] {
            0u32,
            branch_style,
            0u32,
            0u32
        }
    ) {
        return false;
    }
    join = cursor;
    join.exit = asset_name("EAST");
    return level_straight(mut graph, mut builder, mut mesh, mut cursor, half) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        right
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32);
}
fn service_pig_style(graph: read RoomGraph, mesh: mut Mesh, cursor: LevelCursor) -> unit {
    var node: GraphNode = graph_node(read graph, cursor.room);
    var count: u32 = 1u32;
    if node.kind == PREFAB_HEX_T_JUNCTION || node.kind == PREFAB_HEX_X_JUNCTION {
        count = node.count;
    }
    var i: u32 = 0u32;
    while i < count {
        var port: RoomPort = graph_socket(read graph, node.first + i).port;
        if count == 1u32 || service_pig_entry(port) {
            level_room_material(
                read graph,
                mut mesh,
                cursor.room,
                i,
                course_material_base(PREFAB_COUNT)
            );
        }
        i = i + 1u32;
    }
}
fn service_pig_straight(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32
) -> bool {
    if !level_straight(mut graph, mut builder, mut mesh, mut cursor, metres) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    return true;
}
fn service_end_bay(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: LevelCursor,
    port: AssetName
) -> bool {
    cursor.exit = port;
    return service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, SERVICE_END_BAY);
}
fn service_refuge(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: LevelCursor,
    port: AssetName,
    branches: mut ServiceBranches
) -> bool {
    cursor.exit = port;
    if !level_straight(mut graph, mut builder, mut mesh, mut cursor, 8f32) {
        return false;
    }
    if asset_names_equal(port, asset_name("WEST")) {
        service_branch_style(read graph, mut mesh, cursor, SERVICE_BRANCH_OUTER);
        branches.middle = cursor;
    } else {
        service_branch_style(read graph, mut mesh, cursor, SERVICE_BRANCH_INNER);
        branches.south = cursor;
    }
    return true;
}
fn service_pig_run(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    reverse: bool,
    refuge: bool,
    last: bool,
    branches: mut ServiceBranches
) -> bool {
    var back: AssetName = asset_name("ENTRY");
    var ahead: AssetName = asset_name("EXIT");
    if reverse {
        back = asset_name("EXIT");
        ahead = asset_name("ENTRY");
    }
    if !service_pig_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        asset_name("EAST"),
        ahead
    ) {
        return false;
    }
    var end_kind: u32 = PREFAB_HEX_T_JUNCTION;
    if last {
        end_kind = PREFAB_HEX_X_JUNCTION;
    }
    service_pig_style(read graph, mut mesh, cursor);
    if !service_end_bay(mut graph, mut builder, mut mesh, cursor, back) || !service_pig_span(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        metres,
        refuge,
        mut branches
    ) || !service_pig_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        end_kind,
        ahead,
        asset_name("EAST")
    ) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    if last {
        branches.last = cursor;
        branches.last.exit = asset_name("WEST");
    }
    return service_end_bay(mut graph, mut builder, mut mesh, cursor, back);
}
fn service_pig_span(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    refuge: bool,
    branches: mut ServiceBranches
) -> bool {
    if !refuge {
        return service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, metres);
    }
    var first: f32 = metres * 0.4f32;
    if !service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, first) || !service_styled_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_X_JUNCTION,
        asset_name("ENTRY"),
        asset_name("EXIT"),
        make [u32; 4] {
            1u32,
            SERVICE_BRANCH_INNER,
            1u32,
            SERVICE_BRANCH_OUTER
        }
    ) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    return service_refuge(
        mut graph,
        mut builder,
        mut mesh,
        cursor,
        asset_name("EAST"),
        mut branches
    ) && service_refuge(
        mut graph,
        mut builder,
        mut mesh,
        cursor,
        asset_name("WEST"),
        mut branches
    ) && service_pig_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        metres - first - service_junction_span()
    );
}
fn service_runs(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    branches: mut ServiceBranches
) -> bool {
    return service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        110f32,
        true,
        false,
        false,
        mut branches
    ) && service_connector(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        false,
        mut branches.first_join
    ) && service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        140f32,
        false,
        true,
        false,
        mut branches
    ) && service_connector(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        true,
        mut branches.second_join
    ) && service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        110f32,
        true,
        false,
        true,
        mut branches
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        false
    );
}
fn service_terminal(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor
) -> bool {
    var port: SpaceTransform = level_port_global(read graph, cursor);
    var p: Vec3 = port.origin;
    var d: Vec3 = port.basis.forward;
    p.z = 0f32;
    d.z = 0f32;
    var along: f32 = dot(p, d);
    var length_metres: f32 = (
        -along + sqrtf(
            along * along + dot(d, d) * (SERVICE_END_RADIUS * SERVICE_END_RADIUS - dot(p, p))
        )
    ) / dot(d, d);
    var depth: f32 = prefab_hex_stopper_parameter(0u32).initial;
    return level_straight(mut graph, mut builder, mut mesh, mut cursor, length_metres - depth) && level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_STOPPER,
        asset_name("ENTRY"),
        asset_name("ENTRY")
    );
}
fn demo_room_ambient() -> Vec3 {
    return vec(0f32, 0f32, 0f32);
}
fn service_pig_material() -> PanelMaterial {
    var panel: PanelMaterial = hex_tunnel_material();
    panel.colour = 0x447092u32;
    panel.finish = METAL_RIBBED;
    panel.pitch = 0.5f32;
    panel.marking = 1u32;
    panel.emission = 0x459bd5u32;
    return panel;
}
fn service_branch_material(style: u32) -> PanelMaterial {
    var panel: PanelMaterial = hex_tunnel_material();
    panel.colour = 0x958875u32;
    panel.finish = METAL_TREAD;
    panel.pitch = 0.5f32;
    if style == SERVICE_BRANCH_OUTER {
        panel.colour = 0x697c6bu32;
        panel.finish = METAL_RIBBED;
    }
    return panel;
}
fn service_material(style: u32) -> PanelMaterial {
    if style == 1u32 {
        return service_pig_material();
    }
    return service_branch_material(style);
}
fn demo_palette(input: mut FrameInput) -> bool {
    var configuration: AssetValues = asset_values_new();
    var words: u32 = 0u32;
    var style: u32 = 1u32;
    while style <= SERVICE_BRANCH_OUTER {
        var panel: PanelMaterial = service_material(style);
        words = words + panel_texture_width(panel) * panel_texture_height(panel) + PALETTE_COLORS * LIGHT_STATES;
        style = style + 1u32;
    }
    if !course_material_defaults(mut configuration) || !course_palette_reserved(
        mut input,
        read configuration,
        SERVICE_BRANCH_OUTER,
        words
    ) {
        return false;
    }
    var offset: u32 = course_extra_offset(read configuration, SERVICE_BRANCH_OUTER);
    style = 1u32;
    while style <= SERVICE_BRANCH_OUTER {
        var panel: PanelMaterial = service_material(style);
        if !panel_upload(
            mut input,
            course_material_base(PREFAB_COUNT) + style - 1u32,
            offset,
            panel_texture_width(panel),
            panel
        ) {
            return false;
        }
        offset = offset + panel_texture_width(panel) * panel_texture_height(panel) + PALETTE_COLORS * LIGHT_STATES;
        style = style + 1u32;
    }
    return true;
}

fn demo_room_lighting(
    scene: read CollisionScene,
    input: mut FrameInput,
    anchors: mut RoomAnchors
) -> unit {
    light_object_anchors(read scene, mut input, berth_light(), mut anchors);
}

fn service_junction_span() -> f32 {
    return 2f32 * (
        service_hex_profile().radius + prefab_hex_t_junction_parameter(0u32).initial
    );
}

fn service_pig_junction(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    kind: u32,
    entry: AssetName,
    exit_name: AssetName
) -> bool {
    var styles: [u32; 4] = make [u32; 4] {
        1u32,
        0u32,
        1u32,
        0u32
    };
    if kind == PREFAB_HEX_X_JUNCTION {
        styles[3usize] = SERVICE_BRANCH_OUTER;
    }
    return service_styled_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        kind,
        entry,
        exit_name,
        styles
    );
}
fn service_styled_junction(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    kind: u32,
    entry: AssetName,
    exit_name: AssetName,
    styles: [u32; 4]
) -> bool {
    var values: AssetValues = asset_values_new();
    var asset: RoomAsset = room_asset_new();
    var room: u32 = graph_count(read graph);
    if !course_values(kind, 0u32, mut values) || !course_build(kind, read values, mut asset) || !junction_style_seams(
        mut asset,
        styles
    ) || !course_room_mesh(read asset, mut graph, mut builder, mut mesh, kind, 0u32) {
        return false;
    }
    level_attach(mut graph, mut cursor, room, entry, exit_name);
    var i: u32 = 0u32;
    while i < asset_port_count(read asset.ports) {
        if styles[i as usize] != 0u32 {
            level_room_material(
                read graph,
                mut mesh,
                room,
                i,
                course_material_base(PREFAB_COUNT) + styles[i as usize] - 1u32
            );
        }
        i = i + 1u32;
    }
    return true;
}

fn service_pig_entry(port: RoomPort) -> bool {
    return asset_names_equal(port.id, asset_name("ENTRY")) || asset_names_equal(
        port.id,
        asset_name("EXIT")
    );
}

fn service_branch_style(
    graph: read RoomGraph,
    mesh: mut Mesh,
    cursor: LevelCursor,
    style: u32
) -> unit {
    var i: u32 = 0u32;
    var count: u32 = course_material_count(graph_node(read graph, cursor.room).kind);
    while i < count {
        level_room_material(
            read graph,
            mut mesh,
            cursor.room,
            i,
            course_material_base(PREFAB_COUNT) + style - 1u32
        );
        i = i + 1u32;
    }
}
fn service_route_straight(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    style: u32
) -> bool {
    if !level_straight(mut graph, mut builder, mut mesh, mut cursor, metres) {
        return false;
    }
    service_branch_style(read graph, mut mesh, cursor, style);
    return true;
}
fn service_route_turn(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    right: bool,
    style: u32
) -> bool {
    if !service_turn(mut graph, mut builder, mut mesh, mut cursor, right) {
        return false;
    }
    service_branch_style(read graph, mut mesh, cursor, style);
    return true;
}
// Connect parallel outward ports with a U route in their horizontal plane.
fn service_parallel_branch(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    start: LevelCursor,
    target: LevelCursor,
    reach: f32,
    fork_distance: f32,
    shape: ServicePathShape,
    fork: mut LevelCursor,
    style: u32
) -> bool {
    var a: SpaceTransform = level_port_global(read graph, start);
    var b: SpaceTransform = level_port_global(read graph, target);
    var delta: Vec3 = sub(b.origin, a.origin);
    var along: f32 = dot(delta, a.basis.forward);
    var across: f32 = dot(delta, a.basis.right);
    var right: bool = across < 0f32;
    if !service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut start,
        along + reach,
        style
    ) || !service_route_turn(mut graph, mut builder, mut mesh, mut start, right, style) || !service_branch_span(
        mut graph,
        mut builder,
        mut mesh,
        mut start,
        absf(across) - service_junction_span(),
        fork_distance,
        shape,
        mut fork,
        style
    ) || !service_route_turn(mut graph, mut builder, mut mesh, mut start, right, style) || !service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut start,
        reach,
        style
    ) {
        return false;
    }
    service_join(mut graph, start, target);
    return true;
}
fn service_join(graph: mut RoomGraph, start: LevelCursor, target: LevelCursor) -> unit {
    var first: u32 = course_socket(read graph, start.room, start.exit);
    var second: u32 = course_socket(read graph, target.room, target.exit);
    course_pair(mut graph, first, second);
}
fn service_branch_span(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    fork_distance: f32,
    shape: ServicePathShape,
    fork: mut LevelCursor,
    style: u32
) -> bool {
    if fork_distance == 0f32 {
        return service_route_span(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            metres,
            shape,
            style
        );
    }
    if !service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        fork_distance,
        style
    ) || !service_styled_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        asset_name("ENTRY"),
        asset_name("EXIT"),
        make [u32; 4] {
            style,
            style,
            style,
            style
        }
    ) {
        return false;
    }
    fork = cursor;
    fork.exit = asset_name("EAST");
    return service_route_span(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        metres - fork_distance - service_junction_span(),
        shape,
        style
    );
}
fn service_build_branches(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    branches: ServiceBranches,
    seed: u32
) -> bool {
    var lower_fork: LevelCursor = branches.approach;
    var upper_fork: LevelCursor = branches.middle;
    var start: SpaceTransform = level_port_global(read graph, branches.middle);
    var join: SpaceTransform = level_port_global(read graph, branches.second_join);
    var upper_split: f32 = join.origin.x - start.origin.x - service_junction_span();
    if !service_parallel_branch(
        mut graph,
        mut builder,
        mut mesh,
        branches.approach,
        branches.first_join,
        18f32,
        60f32,
        service_path_shape(seed, 0u32, 0f32),
        mut lower_fork,
        SERVICE_BRANCH_INNER
    ) || !service_parallel_branch(
        mut graph,
        mut builder,
        mut mesh,
        branches.middle,
        branches.last,
        43f32,
        upper_split,
        service_path_shape(seed, 1u32, -1f32),
        mut upper_fork,
        SERVICE_BRANCH_OUTER
    ) || !service_parallel_branch(
        mut graph,
        mut builder,
        mut mesh,
        lower_fork,
        branches.south,
        60f32,
        0f32,
        service_path_shape(seed, 2u32, 1f32),
        mut lower_fork,
        SERVICE_BRANCH_INNER
    ) {
        return false;
    }
    var end: SpaceTransform = level_port_global(read graph, upper_fork);
    var metres: f32 = dot(sub(join.origin, end.origin), end.basis.forward);
    if !service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut upper_fork,
        metres,
        SERVICE_BRANCH_OUTER
    ) {
        return false;
    }
    service_join(mut graph, upper_fork, branches.second_join);
    return true;
}

// A four-corner offset returns to the original axis with the same forward displacement.
fn service_route_cell(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    shape: ServicePathShape,
    style: u32,
    cell: u32
) -> bool {
    if shape.offset == 0f32 {
        return service_route_straight(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            metres,
            style
        );
    }
    var right: bool = shape.offset > 0f32;
    var minimum: f32 = 4f32;
    var available: f32 = metres - 2f32 * service_junction_span() - 3f32 * minimum;
    var lead: f32 = minimum + available * (
        0.1f32 + 0.25f32 * service_path_fraction(shape, cell * 2u32)
    );
    var middle: f32 = minimum + available * (
        0.25f32 + 0.25f32 * service_path_fraction(shape, cell * 2u32 + 1u32)
    );
    var tail: f32 = metres - lead - middle - 2f32 * service_junction_span();
    return service_route_straight(mut graph, mut builder, mut mesh, mut cursor, lead, style) && service_route_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        right,
        style
    ) && service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        absf(shape.offset),
        style
    ) && service_route_turn(mut graph, mut builder, mut mesh, mut cursor, !right, style) && service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        middle,
        style
    ) && service_route_turn(mut graph, mut builder, mut mesh, mut cursor, !right, style) && service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        absf(shape.offset),
        style
    ) && service_route_turn(mut graph, mut builder, mut mesh, mut cursor, right, style) && service_route_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        tail,
        style
    );
}

record ServicePathShape {
    seed: u32;
    route: u32;
    cells: u32;
    offset: f32;
}
// Route keys are stable across room insertion. The signed side selects the reserved corridor.
fn service_path_shape(seed: u32, route: u32, side: f32) -> ServicePathShape {
    return make ServicePathShape {
        seed: seed,
        route: route,
        cells: 1u32 + metal_hash(seed, route, 0x10u32) % 2u32,
        offset: side * (16u32 + metal_hash(seed, route, 0x20u32) % 11u32) as f32
    };
}
fn service_path_fraction(shape: ServicePathShape, field: u32) -> f32 {
    return (metal_hash(shape.seed, shape.route, 0x100u32 + field) & 1023u32) as f32 / 1023f32;
}
// Each cell returns to the forward axis. Junction anchors and topology remain unchanged.
fn service_route_span(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    shape: ServicePathShape,
    style: u32
) -> bool {
    if shape.offset == 0f32 {
        return service_route_straight(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            metres,
            style
        );
    }
    var cell: u32 = 0u32;
    while cell < shape.cells {
        if !service_route_cell(
            mut graph,
            mut builder,
            mut mesh,
            mut cursor,
            metres / shape.cells as f32,
            shape,
            style,
            cell
        ) {
            return false;
        }
        cell = cell + 1u32;
    }
    return true;
}
