// First service-network section. The radial berth has one open hex exit.
// Three straight pig lanes have capped end bays beyond their lateral access junctions.
// Grey service tunnels connect those junctions. The middle lane has an X refuge.
// Ochre walls and amber full-bright strips identify the pig lanes. Pigs are not installed.
// Port-derived placements form a continuous rigid layout. The terminal door face is
// at radius SERVICE_END_RADIUS from the spin axis.
const SERVICE_END_RADIUS: f32 = 500f32;
const SERVICE_END_BAY: f32 = 8f32;
fn demo_room_build(
    asset: mut RoomAsset,
    collision: mut CollisionScene,
    mesh: mut Mesh,
    graph: mut RoomGraph
) -> bool {
    var values: AssetValues = asset_values_new();
    if !course_values(PREFAB_RADIAL_START, 0u32, mut values) || !room_build(
        read values,
        mut asset
    ) || !graph_allocate(mut graph, 64u32, 0u32) {
        return false;
    }
    var port: RoomPort = asset_port(read asset.ports, 0u32);
    var forward: Vec3 = unit_vector(sub(port.position, asset.spawn.position));
    var right: Vec3 = unit_vector(cross(vec(0f32, 1f32, 0f32), forward));
    asset.spawn.basis = make Basis {
        right: right,
        up: cross(forward, right),
        forward: forward
    };
    var builder: CollisionBuilder = collision_builder_new();
    if !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        PREFAB_RADIAL_START,
        0u32
    ) {
        return false;
    }
    var node: GraphNode = graph_node(read graph, 0u32);
    var local: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: vec(0f32, 0f32, 0f32),
        basis: port.basis
    };
    var desired: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: vec(0f32, 0f32, 0f32),
        basis: make Basis {
            right: vec(0f32, 1f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(1f32, 0f32, 0f32)
        }
    };
    node.placement = space_compose(desired, space_inverse(local));
    graph_node_set(mut graph, 0u32, node);
    var cursor: LevelCursor = make LevelCursor {
        room: 0u32,
        exit: asset_name("SIDE-0")
    };
    if !service_approach(mut graph, mut builder, mut mesh, mut cursor) || !service_runs(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor
    ) || !service_terminal(mut graph, mut builder, mut mesh, mut cursor) || !level_close(
        mut graph,
        mut builder,
        mut mesh
    ) {
        return false;
    }
    return collision_finish(move builder, mut collision) && level_install(
        read graph,
        mut collision
    );
}
fn service_approach(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor
) -> bool {
    return level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_STOPPER_OPEN,
        asset_name("ENTRY"),
        asset_name("EXIT")
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 32f32) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        true
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32);
}
fn service_turn(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    right: bool
) -> bool {
    var entry: AssetName = asset_name("ENTRY");
    var exit_name: AssetName = asset_name("EAST");
    if !right {
        entry = asset_name("EAST");
        exit_name = asset_name("ENTRY");
    }
    return level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_ELBOW,
        entry,
        exit_name
    );
}
fn service_connector(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    right: bool
) -> bool {
    return level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        right
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 20f32) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        right
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32);
}
fn service_pig_style(graph: read RoomGraph, mesh: mut Mesh, cursor: LevelCursor) -> unit {
    var node: GraphNode = graph_node(read graph, cursor.room);
    var count: u32 = 1u32;
    if node.kind == PREFAB_HEX_T_JUNCTION || node.kind == PREFAB_HEX_X_JUNCTION {
        count = node.count;
    }
    var i: u32 = 0u32;
    while i < count {
        var port: RoomPort = graph_socket(read graph, node.first + i).port;
        if count == 1u32 || service_pig_entry(port) {
            level_room_material(
                read graph,
                mut mesh,
                cursor.room,
                i,
                course_material_base(PREFAB_COUNT)
            );
        }
        i = i + 1u32;
    }
}
fn service_pig_straight(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32
) -> bool {
    if !level_straight(mut graph, mut builder, mut mesh, mut cursor, metres) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    return true;
}
fn service_end_bay(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: LevelCursor,
    port: AssetName
) -> bool {
    cursor.exit = port;
    return service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, SERVICE_END_BAY);
}
fn service_refuge(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: LevelCursor,
    port: AssetName
) -> bool {
    cursor.exit = port;
    return level_straight(mut graph, mut builder, mut mesh, mut cursor, 8f32);
}
fn service_pig_run(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    reverse: bool,
    refuge: bool
) -> bool {
    var back: AssetName = asset_name("ENTRY");
    var ahead: AssetName = asset_name("EXIT");
    if reverse {
        back = asset_name("EXIT");
        ahead = asset_name("ENTRY");
    }
    if !service_pig_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        asset_name("EAST"),
        ahead
    ) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    if !service_end_bay(mut graph, mut builder, mut mesh, cursor, back) || !service_pig_span(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        metres,
        refuge
    ) || !service_pig_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_T_JUNCTION,
        ahead,
        asset_name("EAST")
    ) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    return service_end_bay(mut graph, mut builder, mut mesh, cursor, back);
}
fn service_pig_span(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    metres: f32,
    refuge: bool
) -> bool {
    if !refuge {
        return service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, metres);
    }
    var first: f32 = metres * 0.4f32;
    if !service_pig_straight(mut graph, mut builder, mut mesh, mut cursor, first) || !service_pig_junction(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_X_JUNCTION,
        asset_name("ENTRY"),
        asset_name("EXIT")
    ) {
        return false;
    }
    service_pig_style(read graph, mut mesh, cursor);
    return service_refuge(mut graph, mut builder, mut mesh, cursor, asset_name("EAST")) && service_refuge(
        mut graph,
        mut builder,
        mut mesh,
        cursor,
        asset_name("WEST")
    ) && service_pig_straight(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        metres - first - service_junction_span()
    );
}
fn service_runs(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor
) -> bool {
    return service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        110f32,
        true,
        false
    ) && service_connector(mut graph, mut builder, mut mesh, mut cursor, false) && service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        140f32,
        false,
        true
    ) && service_connector(mut graph, mut builder, mut mesh, mut cursor, true) && service_pig_run(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        110f32,
        true,
        false
    ) && level_straight(mut graph, mut builder, mut mesh, mut cursor, 18f32) && service_turn(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        false
    );
}
fn service_terminal(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor
) -> bool {
    var port: SpaceTransform = level_port_global(read graph, cursor);
    var p: Vec3 = port.origin;
    var d: Vec3 = port.basis.forward;
    p.z = 0f32;
    d.z = 0f32;
    var along: f32 = dot(p, d);
    var length_metres: f32 = (
        -along + sqrtf(
            along * along + dot(d, d) * (SERVICE_END_RADIUS * SERVICE_END_RADIUS - dot(p, p))
        )
    ) / dot(d, d);
    var depth: f32 = prefab_hex_stopper_parameter(0u32).initial;
    return level_straight(mut graph, mut builder, mut mesh, mut cursor, length_metres - depth) && level_piece(
        mut graph,
        mut builder,
        mut mesh,
        mut cursor,
        PREFAB_HEX_STOPPER,
        asset_name("ENTRY"),
        asset_name("ENTRY")
    );
}
fn demo_room_ambient() -> Vec3 {
    return vec(0f32, 0f32, 0f32);
}
fn demo_palette(input: mut FrameInput) -> bool {
    var configuration: AssetValues = asset_values_new();
    var panel: PanelMaterial = hex_tunnel_material();
    panel.colour = 0x447092u32;
    panel.finish = METAL_RIBBED;
    panel.pitch = 0.5f32;
    panel.marking = 1u32;
    panel.emission = 0x459bd5u32;
    var words: u32 = panel_texture_width(panel) * panel_texture_height(panel) + PALETTE_COLORS * LIGHT_STATES;
    return course_material_defaults(mut configuration) && course_palette_reserved(
        mut input,
        read configuration,
        1u32,
        words
    ) && panel_upload(
        mut input,
        course_material_base(PREFAB_COUNT),
        course_extra_offset(read configuration, 1u32),
        panel_texture_width(panel),
        panel
    );
}

fn demo_room_lighting(
    scene: read CollisionScene,
    input: mut FrameInput,
    anchors: mut RoomAnchors
) -> unit {
    light_object_anchors(read scene, mut input, berth_light(), mut anchors);
}

fn service_junction_span() -> f32 {
    return 2f32 * (
        service_hex_profile().radius + prefab_hex_t_junction_parameter(0u32).initial
    );
}

fn service_pig_junction(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    kind: u32,
    entry: AssetName,
    exit_name: AssetName
) -> bool {
    var values: AssetValues = asset_values_new();
    var asset: RoomAsset = room_asset_new();
    var room: u32 = graph_count(read graph);
    if !course_values(kind, 0u32, mut values) || !course_build(kind, read values, mut asset) {
        return false;
    }
    var styles: [u32; 4] = make [u32; 4] {
        0u32,
        0u32,
        0u32,
        0u32
    };
    var i: u32 = 0u32;
    while i < asset_port_count(read asset.ports) {
        if service_pig_entry(asset_port(read asset.ports, i)) {
            styles[i as usize] = 1u32;
        }
        i = i + 1u32;
    }
    if !junction_style_seams(mut asset, styles) || !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        kind,
        0u32
    ) {
        return false;
    }
    level_attach(mut graph, mut cursor, room, entry, exit_name);
    return true;
}

fn service_pig_entry(port: RoomPort) -> bool {
    return asset_names_equal(port.id, asset_name("ENTRY")) || asset_names_equal(
        port.id,
        asset_name("EXIT")
    );
}
