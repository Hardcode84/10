// Adjacent sides connect through one-metre tunnels: 0/1, 2/3, 4/5, and 6/7.
// The half-roll keeps local +Y upright at each crossing.
fn demo_room_build(
    asset: mut RoomAsset,
    collision: mut CollisionScene,
    mesh: mut Mesh,
    graph: mut RoomGraph,
    seed: u32
) -> bool {
    var values: AssetValues = asset_values_new();
    if !asset_values_allocate(mut values, room_parameter_count()) {
        return false;
    }
    asset_parameters_reset(mut values);
    if !room_build(read values, mut asset) {
        return false;
    }
    var walls: Mesh = mesh_new();
    if !demo_room_shell(read asset, mut mesh, mut walls) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append(
        mut builder,
        read walls,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var tunnel: RoomAsset = room_asset_new();
    if !hex_tunnel_build(1f32, mut tunnel) {
        return false;
    }
    var i: u32 = 0u32;
    while i < asset_port_count(read asset.ports) {
        if !demo_tunnel_pair(
            read tunnel,
            mut builder,
            mut mesh,
            asset_port(read asset.ports, i),
            asset_port(read asset.ports, i + 1u32),
            i
        ) {
            return false;
        }
        i = i + 2u32;
    }
    return collision_finish(move builder, mut collision) && flight_place_course(mut collision);
}

// Constant room light, added to player and hook lighting.
fn demo_room_ambient() -> Vec3 {
    return vec(0f32, 0f32, 0f32);
}

fn demo_palette(input: mut FrameInput) -> bool {
    return game_room_palette(mut input);
}

fn demo_room_lighting(
    scene: read CollisionScene,
    input: mut FrameInput,
    anchors: mut RoomAnchors
) -> unit {}
