// Assets without a replay recipe remain pinned. Recorded assets may leave the cache.
record ResidentRoom {
    mesh: Mesh;
    pieces: *ResidentPiece;
    piece_count: u32;
    uploaded: bool;
    pinned: bool;
    ready: bool;
    cost: u64;
    active: bool;
}
opaque;
record ResidentPiece {
    range: MeshRange;
    arena: u32;
}
record ResidentArena {
    first: u32;
    used: u32;
    live: u32;
}
record ResidentBuild {
    recipe: RoomRecipe;
    plan: CollisionRebuild;
    mesh: Mesh;
    collision: CollisionRoom;
    room: u32;
    portal: u32;
}
opaque;
resource RoomResidency {
    rooms: *ResidentRoom;
    plans: *ResidentPlan;
    planner: *ResidentPlanner;
    planning: bool;
    count: u32;
    scheduler: Scheduler;
    scope: Scope;
    jobs: RoomJobs;
    plan_task: Task!(PlannerWork);
    simulation_task: Task!(SimulationWork);
    builds: *ResidentBuild;
    wanted: GenerationWords;
    keep: GenerationWords;
    ahead: GenerationWords;
    predicted: u32;
    visible: GenerationWords;
    home: u32;
    simulation: *ResidentSimulation;
    arenas: *ResidentArena;
    arena_count: u32;
    arena_limit: u32;
    next: InstanceList;
    enabled: bool;
    paused_ns: u64;
    cpu_budget: u64;
    missing: u32;
}
opaque drop residency_drop;
const RESIDENT_ARENA_TRIANGLES: u32 = 16384u32;
const RESIDENT_GPU_BYTES: u64 = 67108864u64;
fn residency_new() -> RoomResidency {
    return make RoomResidency {
        rooms: null(*ResidentRoom),
        plans: null(*ResidentPlan),
        planner: null(*ResidentPlanner),
        planning: false,
        count: 0u32,
        scheduler: scheduler_new(),
        scope: scope_new(),
        jobs: room_jobs_new(),
        plan_task: task_empty!(PlannerWork)(),
        simulation_task: task_empty!(SimulationWork)(),
        builds: null(*ResidentBuild),
        wanted: generation_words_new(),
        keep: generation_words_new(),
        ahead: generation_words_new(),
        predicted: 0xffffffffu32,
        visible: generation_words_new(),
        home: 0xffffffffu32,
        simulation: null(*ResidentSimulation),
        arenas: null(*ResidentArena),
        arena_count: 0u32,
        arena_limit: 0u32,
        next: instances_new(),
        enabled: false,
        paused_ns: 0u64,
        cpu_budget: 0u64,
        missing: ROOM_NONE
    };
}
fn residency_drop(state: mut RoomResidency) -> unit {
    if state.scope.state != null(*SchedulerScope) {
        var end: Event = scope_finish(mut state.scope);
        event_join(read end);
    }
    var i: u32 = 0u32;
    while i < state.count {
        drop state.rooms[i as usize].mesh;
        if state.jobs.state == null(*RoomJobsState) {
            drop state.builds[i as usize].recipe;
            drop state.builds[i as usize].plan;
            drop state.builds[i as usize].mesh;
            drop state.builds[i as usize].collision;
        }
        drop state.plans[i as usize].wanted;
        drop state.plans[i as usize].keep;
        drop state.plans[i as usize].ahead;
        free(state.rooms[i as usize].pieces as *u8);
        i = i + 1u32;
    }
    free(state.rooms as *u8);
    if state.jobs.state == null(*RoomJobsState) {
        free(state.builds as *u8);
    }
    free(state.plans as *u8);
    if state.planner != null(*ResidentPlanner) {
        drop state.planner -> graph;
        drop state.planner -> selection;
        free(state.planner as *u8);
    }
    free(state.arenas as *u8);
    if state.simulation != null(*ResidentSimulation) {
        drop state.simulation -> scene;
        drop state.simulation -> before;
        drop state.simulation -> after;
        free(state.simulation as *u8);
    }
}
fn residency_allocate(state: mut RoomResidency, count: u32, workers: u32, memory: u32) -> bool {
    if !residency_runtime_open(mut state, workers) {
        return false;
    }
    state.rooms = malloc(count as usize * sizeof(ResidentRoom)) as *ResidentRoom;
    if state.rooms == null(*ResidentRoom) {
        return error("room residency allocation failed");
    }
    state.plans = malloc(count as usize * sizeof(ResidentPlan)) as *ResidentPlan;
    if state.plans == null(*ResidentPlan) {
        return error("visibility cache allocation failed");
    }
    state.builds = malloc(count as usize * sizeof(ResidentBuild)) as *ResidentBuild;
    if state.builds == null(*ResidentBuild) {
        return error("room tasks allocation failed");
    }
    var i: u32 = 0u32;
    while i < count {
        state.builds[i as usize] = make ResidentBuild {
            recipe: room_recipe_new(),
            plan: collision_rebuild_new(),
            mesh: mesh_new(),
            collision: collision_room_new(),
            room: i,
            portal: 0u32
        };
        state.plans[i as usize] = make ResidentPlan {
            wanted: generation_words_new(),
            keep: generation_words_new(),
            ahead: generation_words_new()
        };
        state.rooms[i as usize] = make ResidentRoom {
            mesh: mesh_new(),
            pieces: null(*ResidentPiece),
            piece_count: 0u32,
            uploaded: false,
            pinned: false,
            ready: false,
            cost: 0u64,
            active: false
        };
        i = i + 1u32;
    }
    state.count = count;
    state.cpu_budget = memory as u64 * 1048576u64 * 4u64;
    state.arena_limit = (
        memory as u64 * 1048576u64 / (RESIDENT_ARENA_TRIANGLES as u64 * 176u64)
    ) as u32;
    state.arenas = malloc(state.arena_limit as usize * sizeof(ResidentArena)) as *ResidentArena;
    if state.arenas == null(*ResidentArena) {
        return error("room arena table allocation failed");
    }
    return generation_words_allocate(mut state.visible, count) && generation_words_allocate(
        mut state.wanted,
        count
    ) && generation_words_allocate(mut state.keep, count) && generation_words_allocate(
        mut state.ahead,
        count
    ) && room_jobs_open(mut state.jobs, read state.scheduler, state.builds, count);
}

fn residency_polygon_new() -> ResidencyPolygon {
    var polygon: ResidencyPolygon = uninit;
    zero(&polygon as *u8, sizeof(ResidencyPolygon));
    return polygon;
}
fn residency_runtime_open(state: mut RoomResidency, workers: u32) -> bool {
    if state.scheduler.runtime != null(*SchedulerRuntime) {
        return true;
    }
    return game_scheduler_open(mut state.scheduler, workers) && scope_open(
        mut state.scope,
        read state.scheduler
    );
}
