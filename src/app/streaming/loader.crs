fn residency_execute(work: *ResidentBuild) -> bool {
    var replay: RoomReplay = room_replay_new();
    var builder: CollisionBuilder = collision_builder_new();
    if !room_recipe_build(
        read work -> recipe,
        work -> room,
        work -> portal,
        mut builder,
        mut replay
    ) {
        return false;
    }
    if !collision_rebuild_finish(read work -> plan, move builder, mut work -> collision) {
        return false;
    }
    mesh_swap(mut work -> mesh, mut replay.mesh);
    return true;
}
fn residency_jobs(
    state: mut RoomResidency,
    scene: read CollisionScene,
    graph: read RoomGraph
) -> bool {
    var i: u32 = 0u32;
    while i < state.count {
        var work: *ResidentBuild = &state.builds[i as usize];
        work -> portal = graph_node(read graph, i).first;
        if !room_recipe_copy(mut work -> recipe, graph_recipe(read graph, i)) || !collision_rebuild_plan(
            read scene,
            i,
            mut work -> plan
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
// Publish completed immutable room chunks between readers.
fn residency_poll(state: mut RoomResidency, scene: mut CollisionScene) -> bool {
    var i: u32 = 0u32;
    while i < state.count {
        var status: i32 = room_status(read state.jobs, i);
        if status < 0i32 {
            return error("room generation task failed");
        }
        if status > 0i32 && !state.rooms[i as usize].ready {
            var work: *ResidentBuild = &state.builds[i as usize];
            if !collision_room_resident(read scene, i) {
                collision_room_restore(mut scene, read work -> collision);
            }
            state.rooms[i as usize].ready = true;
            mesh_swap(mut state.rooms[i as usize].mesh, mut work -> mesh);
        }
        i = i + 1u32;
    }
    return true;
}
fn residency_request(
    state: mut RoomResidency,
    scene: read CollisionScene,
    graph: read RoomGraph,
    room: u32
) -> bool {
    if state.rooms[room as usize].ready && !residency_asset_ready(read state, room) {
        residency_forget(mut state, room);
    }
    room_request(read state.jobs, room, false);
    return true;
}
fn residency_prefetch(
    state: mut RoomResidency,
    scene: read CollisionScene,
    graph: read RoomGraph
) -> bool {
    var bytes: u64 = residency_prefetch_bytes(read state);
    var room: u32 = 0u32;
    while room < state.count {
        if (
            generation_word(read state.ahead, room) != 0u32 || generation_word(
                read state.wanted,
                room
            ) != 0u32
        ) && !room_requested(read state.jobs, room) {
            if bytes + state.rooms[room as usize].cost <= state.cpu_budget {
                room_request(read state.jobs, room, false);
                bytes = bytes + state.rooms[room as usize].cost;
            }
        }
        room = room + 1u32;
    }
    return true;
}
fn game_residency_require(
    control: mut GameControl,
    scene: mut CollisionScene,
    input: mut InputState,
    room: u32
) -> bool {
    residency_pin(mut control.residency, room);
    if !window_loading(control.window.handle, true) {
        return false;
    }
    var start: u64 = now();
    if !residency_request(mut control.residency, read scene, read control.graph, room) || !game_room_wait(
        mut control,
        mut input,
        room
    ) {
        return false;
    }
    control.residency.paused_ns = control.residency.paused_ns + now() - start;
    return residency_poll(mut control.residency, mut scene) && window_loading(
        control.window.handle,
        false
    );
}
fn game_residency_elapsed(control: mut GameControl, elapsed: u64) -> u64 {
    var paused: u64 = control.residency.paused_ns;
    control.residency.paused_ns = 0u64;
    if paused >= elapsed {
        return 0u64;
    }
    return elapsed - paused;
}
fn game_residency_prediction(control: mut GameControl, prediction: read Prediction) -> unit {
    control.residency.predicted = 0xffffffffu32;
    if prediction.admission.status == COLLISION_UNRESOLVED {
        control.residency.predicted = prediction.admission.space;
    }
}

fn residency_cpu_bytes(state: read RoomResidency) -> u64 {
    var bytes: u64 = 0u64;
    var i: u32 = 0u32;
    while i < state.count {
        if state.rooms[i as usize].ready {
            bytes = bytes + state.rooms[i as usize].cost;
        }
        i = i + 1u32;
    }
    return bytes;
}
fn residency_asset_ready(state: read RoomResidency, room: u32) -> bool {
    var item: *ResidentRoom = &state.rooms[room as usize];
    return item -> ready && (
        item -> uploaded || item -> mesh.count != 0u32 || item -> piece_count == 0u32
    );
}
fn residency_forget(state: mut RoomResidency, room: u32) -> unit {
    var work: *ResidentBuild = &state.builds[room as usize];
    work -> mesh = mesh_new();
    work -> collision = collision_room_new();
    room_reset(read state.jobs, room);
    state.rooms[room as usize].ready = false;
}
fn residency_cache_limit(state: mut RoomResidency, scene: mut CollisionScene) -> bool {
    var bytes: u64 = residency_cpu_bytes(read state);
    var room: u32 = 0u32;
    while bytes > state.cpu_budget && room < state.count {
        var item: *ResidentRoom = &state.rooms[room as usize];
        if item -> ready && !item -> pinned && !room_demanded(read state.jobs, room) && generation_word(
            read state.wanted,
            room
        ) == 0u32 {
            bytes = bytes - item -> cost;
            item -> mesh = mesh_new();
            collision_room_unload(mut scene, room);
            residency_forget(mut state, room);
        }
        room = room + 1u32;
    }
    if bytes <= state.cpu_budget {
        return true;
    }
    puts("room CPU cache: required / budget bytes");
    print_number(bytes as i64);
    print_number(state.cpu_budget as i64);
    return error("required room assets exceed CPU cache budget");
}
fn residency_prefetch_bytes(state: read RoomResidency) -> u64 {
    var bytes: u64 = residency_cpu_bytes(read state);
    var room: u32 = 0u32;
    while room < state.count {
        if !state.rooms[room as usize].ready && room_requested(read state.jobs, room) {
            bytes = bytes + state.rooms[room as usize].cost;
        }
        room = room + 1u32;
    }
    return bytes;
}
