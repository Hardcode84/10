fn residency_hole(input: mut FrameInput, first: u32, count: u32) -> unit {
    if count == 0u32 {
        return;
    }
    var words: *u32 = input.storage.mapped as *u32;
    var header: usize = (words[MESH_META as usize] + first * 4u32) as usize;
    words[header] = count;
    words[header + 3usize] = 0u32;
}
fn residency_arena(state: mut RoomResidency, input: mut FrameInput, count: u32) -> u32 {
    var i: u32 = 0u32;
    while i < state.arena_count {
        if count <= RESIDENT_ARENA_TRIANGLES - state.arenas[i as usize].used {
            return i;
        }
        i = i + 1u32;
    }
    if state.arena_count == state.arena_limit {
        residency_gpu_trim(mut state, mut input);
        i = 0u32;
        while i < state.arena_count {
            if count <= RESIDENT_ARENA_TRIANGLES - state.arenas[i as usize].used {
                return i;
            }
            i = i + 1u32;
        }
        residency_gpu_budget(read state, count);
        error("room GPU budget exhausted: increase --room-memory (MiB)");
        return 0xffffffffu32;
    }
    var first: u32 = input.storage.mesh_count;
    if !retained_reserve(
        &input.storage,
        first + RESIDENT_ARENA_TRIANGLES,
        input.storage.instance_capacity
    ) {
        return 0xffffffffu32;
    }
    input.storage.mesh_count = first + RESIDENT_ARENA_TRIANGLES;
    state.arenas[i as usize] = make ResidentArena {
        first: first,
        used: 0u32,
        live: 0u32
    };
    residency_hole(mut input, first, RESIDENT_ARENA_TRIANGLES);
    state.arena_count = state.arena_count + 1u32;
    return i;
}
fn residency_gpu_release(state: mut RoomResidency, input: mut FrameInput, room: u32) -> unit {
    var item: *ResidentRoom = &state.rooms[room as usize];
    var i: u32 = 0u32;
    while i < item -> piece_count {
        var piece: *ResidentPiece = &item -> pieces[i as usize];
        if piece -> arena != 0xffffffffu32 {
            var arena: *ResidentArena = &state.arenas[piece -> arena as usize];
            arena -> live = arena -> live - piece -> range.count;
            residency_hole(mut input, piece -> range.first, piece -> range.count);
            if arena -> live == 0u32 {
                arena -> used = 0u32;
                residency_hole(mut input, arena -> first, RESIDENT_ARENA_TRIANGLES);
            }
            piece -> arena = 0xffffffffu32;
        }
        i = i + 1u32;
    }
    item -> uploaded = false;
    input.storage.instance_map_dirty = true;
}
fn residency_gpu_load(state: mut RoomResidency, input: mut FrameInput, room: u32) -> bool {
    var item: *ResidentRoom = &state.rooms[room as usize];
    if item -> uploaded {
        item -> mesh = mesh_new();
        return true;
    }
    var i: u32 = 0u32;
    while i < item -> piece_count {
        var count: u32 = item -> pieces[i as usize].count;
        var index: u32 = residency_arena(mut state, mut input, count);
        if index == 0xffffffffu32 {
            residency_gpu_release(mut state, mut input, room);
            return false;
        }
        var arena: *ResidentArena = &state.arenas[index as usize];
        var piece: *ResidentPiece = &item -> pieces[i as usize];
        piece -> arena = index;
        input_mesh_write(
            mut input,
            read item -> mesh,
            piece -> source,
            count,
            arena -> first + arena -> used,
            mut piece -> range
        );
        arena -> used = arena -> used + count;
        arena -> live = arena -> live + count;
        residency_hole(
            mut input,
            arena -> first + arena -> used,
            RESIDENT_ARENA_TRIANGLES - arena -> used
        );
        i = i + 1u32;
    }
    item -> uploaded = true;
    item -> mesh = mesh_new();
    return true;
}
fn residency_gpu_world(
    state: mut RoomResidency,
    input: mut FrameInput,
    world: mut InstanceList
) -> bool {
    instances_clear(mut state.next);
    var room: u32 = 0u32;
    while room < state.count {
        var item: *ResidentRoom = &state.rooms[room as usize];
        if (generation_word(read state.keep, room) != 0u32 || item -> pinned) && item -> ready {
            if !residency_gpu_load(mut state, mut input, room) {
                return false;
            }
            var i: u32 = 0u32;
            while i < item -> piece_count {
                var instance: MeshInstance = mesh_identity(
                    item -> pieces[i as usize].range,
                    room
                );
                instance.motion = item -> pieces[i as usize].motion;
                if !instances_append(mut state.next, instance) {
                    return false;
                }
                i = i + 1u32;
            }
        }
        room = room + 1u32;
    }
    if !retained_reserve(&input.storage, input.storage.mesh_count, state.next.count) {
        return false;
    }
    instances_swap(mut world, mut state.next);
    room = 0u32;
    while room < state.count {
        state.rooms[room as usize].active = (
            generation_word(read state.keep, room) != 0u32 || state.rooms[room as usize].pinned
        ) && state.rooms[room as usize].ready;
        room = room + 1u32;
    }
    return true;
}
fn residency_gpu_collect(
    state: mut RoomResidency,
    input: mut FrameInput,
    scene: mut CollisionScene
) -> unit {
    var room: u32 = 0u32;
    while room < state.count {
        var item: *ResidentRoom = &state.rooms[room as usize];
        if item -> ready && !item -> pinned && generation_word(read state.keep, room) == 0u32 {
            if item -> uploaded {
                residency_gpu_release(mut state, mut input, room);
            }
            item -> mesh = mesh_new();
            collision_room_unload(mut scene, room);
            residency_forget(mut state, room);
        }
        room = room + 1u32;
    }
}

fn residency_gpu_budget(state: read RoomResidency, requested: u32) -> unit {
    var used: u64 = 0u64;
    var live: u64 = 0u64;
    var i: u32 = 0u32;
    while i < state.arena_count {
        used = used + state.arenas[i as usize].used as u64;
        live = live + state.arenas[i as usize].live as u64;
        i = i + 1u32;
    }
    puts("room GPU arenas: live / trapped / requested / budget bytes");
    print_number((live * 176u64) as i64);
    print_number(((used - live) * 176u64) as i64);
    print_number((requested as u64 * 176u64) as i64);
    print_number((state.arena_limit as u64 * RESIDENT_ARENA_TRIANGLES as u64 * 176u64) as i64);
}

fn residency_gpu_trim(state: mut RoomResidency, input: mut FrameInput) -> unit {
    var room: u32 = 0u32;
    while room < state.count {
        var item: *ResidentRoom = &state.rooms[room as usize];
        if item -> uploaded && !item -> pinned && !item -> active && generation_word(
            read state.wanted,
            room
        ) == 0u32 {
            residency_gpu_release(mut state, mut input, room);
        }
        room = room + 1u32;
    }
}
fn residency_gpu_admit(state: read RoomResidency, input: mut FrameInput) -> bool {
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < state.count {
        count = count + state.rooms[i as usize].piece_count;
        i = i + 1u32;
    }
    var triangles: u32 = input.storage.mesh_count + state.arena_limit * RESIDENT_ARENA_TRIANGLES;
    return retained_admit(
        &input.storage,
        triangles,
        count + input.storage.instance_capacity,
        triangles
    );
}
record ResidentUpload {
    state: *RoomResidency;
    renderer: *Renderer;
    world: *InstanceList;
}
opaque send;
fn residency_upload_execute(work: mut ResidentUpload, context: read Context) -> Step {
    var input: FrameInput = renderer_inputs(mut * work.renderer);
    return game_step(residency_gpu_world(mut * work.state, mut input, mut * work.world));
}
// Requires a retired renderer. Returns after the upload preparation task retires.
fn game_residency_upload(session: mut GameSession, input: mut InputState) -> bool {
    if !residency_upload_admit(read session.control.residency, &session.renderer.state) {
        return false;
    }
    var work: ResidentUpload = make ResidentUpload {
        state: &session.control.residency,
        renderer: &session.renderer,
        world: &session.world
    };
    var context: Context = scope_context(read session.control.residency.scope);
    var task: Task!(ResidentUpload) = spawn!(ResidentUpload)(
        read context,
        work,
        residency_upload_execute,
        deps_new()
    );
    var event: Event = task_event!(ResidentUpload)(read task);
    return game_event_wait(mut session.control, mut input, read event);
}

fn residency_upload_admit(state: read RoomResidency, renderer: *RenderState) -> bool {
    var instances: u32 = 0u32;
    var room: u32 = 0u32;
    while room < state.count {
        instances = instances + state.rooms[room as usize].piece_count;
        room = room + 1u32;
    }
    var meshes: u32 = renderer -> mesh_count + (state.arena_limit - state.arena_count) * RESIDENT_ARENA_TRIANGLES;
    return retained_reserve(renderer, meshes, instances);
}
