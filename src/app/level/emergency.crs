// Most service segments remain dark. The seed selects a sparse subset and its fixture count.
fn level_emergency_count(node: GraphNode, room: u32, seed: u32, excluded_style: u32) -> u32 {
    if node.kind != PREFAB_HEX_TUNNEL_10M || node.style == excluded_style {
        return 0u32;
    }
    if metal_hash(seed, room, 0x6c616d70u32) % 8u32 != 0u32 {
        return 0u32;
    }
    return 1u32 + metal_hash(seed, room, 0x726564u32) % 3u32;
}
fn level_emergency_room(
    graph: mut RoomGraph,
    room: u32,
    seed: u32,
    excluded_style: u32,
    builder: mut CollisionBuilder,
    mesh: mut Mesh
) -> bool {
    var node: GraphNode = graph_node(read graph, room);
    var count: u32 = level_emergency_count(node, room, seed, excluded_style);
    if count == 0u32 {
        return true;
    }
    var extent: f32 = graph_socket(read graph, node.first + 1u32).port.position.y;
    var asset: RoomAsset = room_asset_new();
    var values: AssetValues = asset_values_new();
    if !asset_values_allocate(mut values, 2u32) {
        return false;
    }
    asset_value_set(mut values, 0u32, extent);
    asset_value_set(mut values, 1u32, count as f32);
    return asset_generate(level_emergency_recipe, read values, mut asset) && graph_recipe_add(
        mut graph,
        room,
        read asset,
        course_material_base(node.kind),
        true
    ) && level_parts_append(
        mut asset,
        room,
        course_material_base(node.kind),
        mut builder,
        mut mesh
    ) && graph_lights_append(mut graph, read asset.lights, room);
}

fn level_emergency_recipe(values: read AssetValues, asset: mut RoomAsset) -> bool {
    return hex_emergency_lights(
        asset_value(read values, 0u32),
        asset_value(read values, 1u32) as u32,
        mut asset
    );
}
