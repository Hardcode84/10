fn shaft_region_values(kind: u32, values: mut AssetValues) -> bool {
    if !course_values(kind, 0u32, mut values) {
        return false;
    }
    if kind == PREFAB_SHAFT_PIPES || kind == PREFAB_SHAFT_GIRDERS || kind == PREFAB_SHAFT_ROTOR {
        asset_value_set(
            mut values,
            0u32,
            shaft_region_passage_height(kind == PREFAB_SHAFT_PIPES)
        );
        asset_value_set(mut values, 3u32, SHAFT_GRID_SUBDIVISIONS as f32);
    }
    if kind == PREFAB_SHAFT_GRATE {
        asset_value_set(mut values, 0u32, prefab_shaft_grate_parameter(0u32).minimum);
    }
    if kind == PREFAB_SHAFT_CLEAR {
        asset_value_set(mut values, 0u32, shaft_region_fan_approach_height());
    }
    return true;
}
fn shaft_region_station(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    station: u32,
    rooms: mut GenerationWords,
    asset: read RoomAsset
) -> bool {
    var room: u32 = graph_count(read graph);
    var basis: Basis = shaft_region_basis(shaft_region_angle(station));
    var centre: Vec3 = shaft_region_centre(station);
    if !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        PREFAB_SHAFT_STATION,
        0u32
    ) {
        return false;
    }
    shaft_region_place(
        mut graph,
        room,
        make SpaceTransform {
            factor: 1f32,
            origin: sub(centre, scale(basis.up, shaft_region_height() * 0.5f32)),
            basis: basis
        }
    );
    generation_word_set(mut rooms, station, room);
    return true;
}
fn shaft_region_terminal(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    station: u32,
    kind: u32,
    rooms: mut GenerationWords,
    asset: mut RoomAsset
) -> bool {
    var values: AssetValues = asset_values_new();
    if !shaft_region_values(kind, mut values) || !course_build(kind, read values, mut asset) {
        return false;
    }
    var room: u32 = graph_count(read graph);
    if !course_room_mesh(read asset, mut graph, mut builder, mut mesh, kind, 0u32) {
        return false;
    }
    var basis: Basis = shaft_region_basis(shaft_region_angle(station));
    if station < shaft_grid_columns() {
        basis.up = scale(basis.up, -1f32);
        basis.forward = scale(basis.forward, -1f32);
    }
    shaft_region_place(
        mut graph,
        room,
        make SpaceTransform {
            factor: 1f32,
            origin: shaft_region_centre(station),
            basis: basis
        }
    );
    generation_word_set(mut rooms, station, room);
    return true;
}
fn shaft_region_radial_kind(edge: ShaftPassage) -> u32 {
    if !shaft_grid_internal(edge.a) || !shaft_grid_internal(edge.b) {
        return PREFAB_SHAFT_PIPES;
    }
    if edge.a / shaft_grid_columns() % 2u32 == 0u32 {
        return PREFAB_SHAFT_FAN;
    }
    if (edge.a % SHAFT_GRID_WIDTH + edge.a / SHAFT_GRID_WIDTH % SHAFT_GRID_WIDTH) % 2u32 == 0u32 {
        return PREFAB_SHAFT_ROTOR;
    }
    return PREFAB_SHAFT_GIRDERS;
}
fn shaft_region_radial(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    edge: ShaftPassage,
    rooms: read GenerationWords,
    asset: read RoomAsset
) -> bool {
    var kind: u32 = shaft_region_radial_kind(edge);
    var entry: AssetName = asset_name("TOP");
    var destination: AssetName = asset_name("BOTTOM");
    if !shaft_grid_internal(edge.a) {
        entry = asset_name("SHAFT");
    }
    if !shaft_grid_internal(edge.b) {
        destination = asset_name("SHAFT");
    }
    var cursor: LevelCursor = shaft_region_cursor(
        generation_word(read rooms, edge.a),
        entry
    );
    var room: u32 = graph_count(read graph);
    if !course_room_mesh(read asset, mut graph, mut builder, mut mesh, kind, 0u32) {
        return false;
    }
    level_attach(mut graph, mut cursor, room, asset_name("BOTTOM"), asset_name("TOP"));
    return shaft_region_pair(
        mut graph,
        cursor,
        shaft_region_cursor(generation_word(read rooms, edge.b), destination)
    );
}
fn shaft_region_open_stopper(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    cursor: mut LevelCursor,
    asset: read RoomAsset,
    kind: u32
) -> bool {
    var room: u32 = graph_count(read graph);
    if !course_room_mesh(read asset, mut graph, mut builder, mut mesh, kind, 0u32) {
        return false;
    }
    level_attach(mut graph, mut cursor, room, asset_name("ENTRY"), asset_name("EXIT"));
    return true;
}
fn shaft_region_lateral(
    graph: mut RoomGraph,
    builder: mut CollisionBuilder,
    mesh: mut Mesh,
    edge: ShaftPassage,
    rooms: read GenerationWords,
    stopper: read RoomAsset
) -> bool {
    var spinward: bool = edge.b - edge.a == 1u32;
    var slot: u32 = 3u32;
    if spinward {
        slot = 1u32;
    }
    var a: LevelCursor = shaft_region_cursor(
        generation_word(read rooms, edge.a),
        shaft_region_port(slot)
    );
    var b: LevelCursor = shaft_region_cursor(
        generation_word(read rooms, edge.b),
        shaft_region_port(slot - 1u32)
    );
    if !shaft_region_open_stopper(
        mut graph,
        mut builder,
        mut mesh,
        mut a,
        read stopper,
        PREFAB_OCT_STOPPER_OPEN
    ) || !shaft_region_open_stopper(
        mut graph,
        mut builder,
        mut mesh,
        mut b,
        read stopper,
        PREFAB_OCT_STOPPER_OPEN
    ) {
        return false;
    }
    var first: SpaceTransform = level_port_global(read graph, a);
    var last: SpaceTransform = level_port_global(read graph, b);
    var direction: Vec3 = unit_vector(sub(last.origin, first.origin));
    var right: Vec3 = shaft_region_basis(shaft_region_angle(edge.a)).right;
    var tilt: f32 = 0f32;
    if spinward {
        var angle: f32 = (shaft_region_angle(edge.a) + shaft_region_angle(edge.b)) * 0.5f32;
        right = scale(shaft_region_basis(angle).up, -1f32);
        tilt = (shaft_region_angle(edge.b) - shaft_region_angle(edge.a)) * 0.5f32;
    }
    var pose: SpaceTransform = make SpaceTransform {
        factor: 1f32,
        origin: first.origin,
        basis: make Basis {
            right: right,
            up: direction,
            forward: cross(right, direction)
        }
    };
    var asset: RoomAsset = room_asset_new();
    var room: u32 = graph_count(read graph);
    if !oblique_oct_build(mut asset, length(sub(last.origin, first.origin)), tilt) || !course_room_mesh(
        read asset,
        mut graph,
        mut builder,
        mut mesh,
        PREFAB_OCT_TUNNEL_10M,
        0u32
    ) {
        return false;
    }
    shaft_region_place(mut graph, room, pose);
    return shaft_region_pair(
        mut graph,
        a,
        shaft_region_cursor(room, asset_name("ENTRY"))
    ) && shaft_region_pair(mut graph, shaft_region_cursor(room, asset_name("EXIT")), b);
}
