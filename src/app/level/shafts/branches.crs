fn shaft_branch_candidates(grid: read ShaftGrid, station: u32) -> [u32; 4] {
    var candidates: [u32; 4] = make [u32; 4] {
        SHAFT_GRID_NONE,
        SHAFT_GRID_NONE,
        SHAFT_GRID_NONE,
        SHAFT_GRID_NONE
    };
    var slot: u32 = 0u32;
    while slot < 4u32 {
        var next: u32 = shaft_grid_adjacent(station, slot);
        if next != SHAFT_GRID_NONE && !shaft_station(read grid, next).reached {
            candidates[slot as usize] = next;
        }
        slot = slot + 1u32;
    }
    return candidates;
}
fn shaft_branch_next(grid: mut ShaftGrid, station: u32) -> u32 {
    var candidates: [u32; 4] = shaft_branch_candidates(read grid, station);
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < 4u32 {
        if candidates[i as usize] != SHAFT_GRID_NONE {
            candidates[count as usize] = candidates[i as usize];
            count = count + 1u32;
        }
        i = i + 1u32;
    }
    if count == 0u32 {
        return SHAFT_GRID_NONE;
    }
    return candidates[shaft_grid_random(mut grid, count) as usize];
}
fn shaft_grid_branch(grid: mut ShaftGrid, station: u32, limit: u32) -> bool {
    var current: u32 = station;
    var count: u32 = 0u32;
    while count < limit {
        var next: u32 = shaft_branch_next(mut grid, current);
        if next == SHAFT_GRID_NONE {
            break;
        }
        var id: u32 = shaft_grid_between(current, next);
        var edge: ShaftPassage = shaft_passage(read grid, id);
        edge.open = true;
        shaft_passage_set(mut grid, id, edge);
        shaft_grid_reach(mut grid, next);
        current = next;
        count = count + 1u32;
    }
    return count != 0u32;
}
fn shaft_grid_branches(grid: mut ShaftGrid, options: ShaftGridOptions) -> bool {
    var roots: GenerationWords = generation_words_new();
    var count: u32 = shaft_grid_path_count(read grid) - 2u32;
    if !generation_words_allocate(mut roots, count) {
        return false;
    }
    var i: u32 = 0u32;
    while i < count {
        generation_word_set(mut roots, i, shaft_grid_path(read grid, i + 1u32));
        i = i + 1u32;
    }
    shaft_grid_shuffle(mut grid, mut roots, count);
    var added: u32 = 0u32;
    i = 0u32;
    while i < count && added < options.branches {
        if shaft_grid_branch(
            mut grid,
            generation_word(read roots, i),
            options.branch_length
        ) {
            added = added + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
// Builds one route of the requested length and up to the requested number of short dead ends.
fn shaft_grid_generate(grid: mut ShaftGrid, seed: u32, options: ShaftGridOptions) -> bool {
    if options.length < shaft_grid_length_min() || options.length > shaft_grid_length_max() {
        return error("shaft route length is outside the supported range");
    }
    if options.branches != 0u32 && options.branch_length == 0u32 {
        return error("shaft dead ends need a positive length limit");
    }
    if !shaft_grid_allocate(mut grid, seed) {
        return false;
    }
    shaft_grid_candidates(mut grid);
    if !shaft_grid_cycle(mut grid) {
        return false;
    }
    shaft_grid_initial_path(mut grid, options.length);
    return shaft_grid_branches(mut grid, options);
}
