extern fn SDL_Init(flags: u32) -> bool = "SDL_Init";
extern fn SDL_Quit() -> unit = "SDL_Quit";
extern fn SDL_GetError() -> *u8 = "SDL_GetError";
extern fn SDL_CreateWindow(title: *u8, width: i32, height: i32, flags: u64) -> *u8 = "SDL_CreateWindow";
extern fn SDL_DestroyWindow(window: *u8) -> unit = "SDL_DestroyWindow";
extern fn SDL_PollEvent(event: *u8) -> bool = "SDL_PollEvent";
extern fn SDL_WaitEvent(event: *u8) -> bool = "SDL_WaitEvent";
fn window_open(window: **u8, width: u32, height: u32) -> bool {
    if !SDL_Init(32u32) {
        error(SDL_GetError());
        SDL_Quit();
        return false;
    }
    * window = SDL_CreateWindow(
        "SPINWARD | compute portal renderer",
        width as i32,
        height as i32,
        WINDOW_RENDER_FLAGS
    );
    if *window == null(*u8) {
        error(SDL_GetError());
        SDL_Quit();
        return false;
    }
    return true;
}
fn window_close(window: *u8) -> unit {
    if window != null(*u8) {
        SDL_DestroyWindow(window);
        SDL_Quit();
    }
}

extern fn SDL_GetWindowFlags(window: *u8) -> u64 = "SDL_GetWindowFlags";
// A minimized window suspends rendering. Internal resolution remains unchanged.
fn window_draw(v: *RenderState, window: *u8) -> bool {
    var ready: i32 = window_prepare(v, window);
    if ready <= 0i32 {
        return ready == 0i32;
    }
    return renderer_draw(v);
}
fn window_prepare(v: *RenderState, window: *u8) -> i32 {
    if window != null(*u8) {
        var width: i32 = 0i32;
        var height: i32 = 0i32;
        if !window_extent(window, &width, &height) {
            error(SDL_GetError());
            return -1i32;
        }
        if width <= 0i32 || height <= 0i32 || (SDL_GetWindowFlags(window) & 64u64) != 0u64 {
            v -> present_ready = false;
            return 0i32;
        }
        if !renderer_resize(v, v -> width, v -> height, width as u32, height as u32) {
            return -1i32;
        }
        if v -> swapchain_dirty {
            v -> present_ready = false;
            return 0i32;
        }
    }
    return 1i32;
}

extern fn SDL_SetWindowFullscreen(window: *u8, enabled: bool) -> bool = "SDL_SetWindowFullscreen";
// Uses the desktop size without changing the display mode.
fn window_fullscreen(window: *u8) -> bool {
    return SDL_SetWindowFullscreen(window, true) || error(SDL_GetError());
}
extern fn app_set_window_title(window: *u8, title: *u8) -> bool = "SDL_SetWindowTitle";
fn window_loading(window: *u8, loading: bool) -> bool {
    if window == null(*u8) {
        return true;
    }
    var title: *u8 = "SPINWARD | compute portal renderer";
    if loading {
        title = "SPINWARD | Loading rooms";
    }
    return app_set_window_title(window, title) || error(SDL_GetError());
}
