extern fn fwrite(bytes: *u8, size: usize, count: usize, file: *u8) -> usize = "fwrite";

fn capture(v: *RenderState, path: *u8, width: u32, height: u32) -> bool {
    var file: *u8 = fopen(path, "wb");
    if file == null(*u8) {
        return error("cannot open capture");
    }
    var header: [u8; 64] = uninit;
    memcpy(&header[0usize], "P6\n", 3usize);
    var n: usize = 3usize + decimal_u32(&header[3usize], width, 1u32);
    header[n] = 32u8;
    n = n + 1usize;
    n = n + decimal_u32(&header[n], height, 1u32);
    memcpy(&header[n], "\n255\n", 5usize);
    n = n + 5usize;
    var good: bool = fwrite(&header[0usize], 1usize, n, file) == n;
    var bytes: *u8 = v -> mapped + ((v -> mapped as *u32)[PRESENT_PIXELS as usize] as isize) * 4isize;
    var i: usize = 0usize;
    while good && i < (width * height) as usize {
        good = fwrite(bytes + i as isize * 4isize, 1usize, 3usize, file) == 3usize;
        i = i + 1usize;
    }
    if fclose(file) != 0i32 {
        good = false;
    }
    if !good {
        return error("cannot write capture");
    }
    return true;
}
