// The current demo assets share one palette and use one 8 by 8 tile per material.
fn app_assets(v: mut FrameInput, count: u32) -> unit {
    app_assets_extra(mut v, count, 0u32, 0u32);
}
fn app_assets_extra(v: mut FrameInput, count: u32, extra: u32, words: u32) -> unit {
    if !input_assets(
        mut v,
        count + extra,
        count * 64u32 + PALETTE_COLORS * LIGHT_STATES + words
    ) {
        scene_overflow();
        return;
    }
    var i: u32 = 0u32;
    while i < count {
        var material: Material = make Material {
            texture: (count + extra) * MATERIAL_WORDS + i * 64u32,
            width: 8u32,
            height: 8u32,
            stride: 8u32,
            palette: (count + extra) * MATERIAL_WORDS + count * 64u32,
            style: 0u32,
            unlit: 0u32,
            address_u: ADDRESS_REPEAT,
            address_v: ADDRESS_REPEAT,
            transparent_index: i * 4u32
        };
        if !input_material(mut v, i, material) {
            scene_overflow();
            return;
        }
        i = i + 1u32;
    }
}
fn app_texture(v: read FrameInput, mat: u32) -> u32 {
    return input_asset_word(read v, mat * MATERIAL_WORDS);
}
fn app_palette(v: read FrameInput) -> u32 {
    return input_asset_word(read v, 4u32);
}
