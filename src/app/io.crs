extern fn exit(status: i32) -> unit = "exit";
extern fn io_puts(text: *u8) -> i32 = "puts";
extern fn memset(bytes: *u8, value: i32, size: usize) -> *u8 = "memset";
extern fn memcmp(left: *u8, right: *u8, size: usize) -> i32 = "memcmp";
extern fn malloc(size: usize) -> *u8 = "malloc";
extern fn memcpy(dest: *u8, source: *u8, size: usize) -> *u8 = "memcpy";
extern fn free(bytes: *u8) -> unit = "free";

// Writes a null-terminated string followed by a newline.
fn puts(text: *u8) -> i32 {
    return io_puts(text);
}

fn zero(bytes: *u8, size: usize) -> unit {
    memset(bytes, 0i32, size);
}

fn error(message: *u8) -> bool {
    puts(message);
    return false;
}

fn print_number(value: i64) -> unit {
    var buffer: [u8; 22] = uninit;
    var index: usize = 21usize;
    buffer[index] = 0u8;
    var number: u64 = value as u64;
    if value < 0i64 {
        number = 0u64 - number;
    }
    while true {
        index = index - 1usize;
        buffer[index] = (number % 10u64) as u8 + 48u8;
        number = number / 10u64;
        if number == 0u64 {
            break;
        }
    }
    if value < 0i64 {
        index = index - 1usize;
        buffer[index] = 45u8;
    }
    puts(&buffer[index]);
}

fn float_bits(value: f32) -> u32 {
    return *(&value as *u32);
}
fn bits_float(value: u32) -> f32 {
    return *(&value as *f32);
}

// Writes decimal digits without a terminator. Requires ten writable bytes and
// a minimum digit count from zero through ten. Returns the number of bytes written.
fn decimal_u32(output: *u8, value: u32, minimum: u32) -> usize {
    var digits: [u8; 10] = uninit;
    var count: usize = 0usize;
    var remaining: u32 = value;
    while true {
        digits[count] = 48u8 + (remaining % 10u32) as u8;
        count = count + 1usize;
        remaining = remaining / 10u32;
        if remaining == 0u32 && count >= minimum as usize {
            break;
        }
    }
    var i: usize = 0usize;
    while i < count {
        output[i] = digits[count - i - 1usize];
        i = i + 1usize;
    }
    return count;
}
