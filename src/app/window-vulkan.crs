const WINDOW_RENDER_FLAGS: u64 = 268435488u64;
extern fn SDL_Vulkan_GetInstanceExtensions(count: *u32) -> **u8 = "SDL_Vulkan_GetInstanceExtensions";
extern fn SDL_Vulkan_CreateSurface(
    window: *u8,
    instance: *u8,
    allocator: *u8,
    surface: **u8
) -> bool = "SDL_Vulkan_CreateSurface";
extern fn window_extent(window: *u8, width: *i32, height: *i32) -> bool = "SDL_GetWindowSizeInPixels";
fn window_instance(v: *RenderState, window: *u8) -> bool {
    if window == null(*u8) {
        return instance_open(v, 0u32, null(**u8));
    }
    var count: u32 = 0u32;
    var extensions: **u8 = SDL_Vulkan_GetInstanceExtensions(&count);
    if extensions == null(**u8) {
        return error(SDL_GetError());
    }
    if !instance_open(v, count, extensions) {
        return false;
    }
    return SDL_Vulkan_CreateSurface(window, v -> gpu.instance, null(*u8), &v -> surface) || error(
        SDL_GetError()
    );
}
