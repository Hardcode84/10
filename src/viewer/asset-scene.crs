fn asset_scene(
    input: mut FrameInput,
    asset: read RoomAsset,
    mesh: MeshRange,
    labels: MeshRange,
    camera: AssetCamera
) -> bool {
    input_frame(mut input);
    input_set_word(mut input, 20usize, 0u32);
    input_set_word(mut input, LIGHT_MODEL as usize, 1u32);
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    input_set_word(mut input, BACKGROUND as usize, 0xff181410u32);
    input_set_float(mut input, RENDER_STYLE as usize, 0.04f32);
    input_set_float(mut input, PROJECTION as usize, 1f32);
    input_set_float(mut input, CAMERA_LIGHT as usize, 900f32);
    var i: u32 = 0u32;
    while i < 3u32 {
        input_set_float(mut input, (SPACE_LIGHT + i) as usize, 0.5f32);
        input_set_float(mut input, (CAMERA_LIGHT + 1u32 + i) as usize, 1f32);
        i = i + 1u32;
    }
    asset_camera(mut input, read asset, mesh, camera);
    return fixture_lights_preview(read asset.lights, mut input) && input_instance(
        mut input,
        mesh_identity(mesh, 0u32)
    ) && input_instance(mut input, mesh_identity(labels, 0u32));
}
// Builds the selected shell and optional solid parts for inspection.
fn asset_view_filtered_mesh(
    asset: read RoomAsset,
    mesh: mut Mesh,
    open_portals: bool,
    parts: bool
) -> bool {
    var triangle: u32 = 0u32;
    var face: u32 = 0u32;
    while face < asset_face_count(read asset.hull) {
        var port: bool = false;
        var i: u32 = 0u32;
        while i < asset_port_count(read asset.ports) {
            port = port || asset_port(read asset.ports, i).face == face;
            i = i + 1u32;
        }
        var end: u32 = triangle + asset_face(read asset.hull, face).count - 2u32;
        while triangle < end {
            if (!port || !open_portals) && !mesh_append(
                mut mesh,
                mesh_triangle(read asset.mesh, triangle)
            ) {
                return false;
            }
            triangle = triangle + 1u32;
        }
        face = face + 1u32;
    }
    if parts {
        return asset_view_static_parts(read asset, mut mesh, triangle);
    }
    return true;
}
fn asset_view_mesh_upload(
    input: mut FrameInput,
    asset: read RoomAsset,
    range: mut MeshRange,
    open_portals: bool
) -> bool {
    var mesh: Mesh = mesh_new();
    return asset_view_filtered_mesh(read asset, mut mesh, open_portals, true) && input_mesh(
        mut input,
        read mesh,
        mut range
    );
}
fn asset_view_upload(
    values: read AssetValues,
    session: mut AssetSession,
    asset: read RoomAsset,
    range: mut MeshRange,
    open_portals: bool,
    motions: mut InstanceList
) -> bool {
    var labels: Mesh = mesh_new();
    if !asset_labels_build(read asset, mut labels) {
        return false;
    }
    var guides: Mesh = mesh_new();
    if route_nodes_count(read asset.routes) != 0u32 &&!(
        asset_view_filtered_mesh(read asset, mut guides, open_portals, false) && asset_waypoints_build(
            read asset,
            mut guides
        )
    ) {
        return false;
    }
    var guide_range: MeshRange = mesh_empty_range();
    var label_range: MeshRange = mesh_empty_range();
    {
        var renderer: mut Renderer = asset_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        input_clear_meshes(mut input);
        if !asset_view_mesh_upload(mut input, read asset, mut range, open_portals) || !asset_view_motion_upload(
            mut input,
            read asset,
            mut motions
        ) || !input_mesh(mut input, read labels, mut label_range) || !input_mesh(
            mut input,
            read guides,
            mut guide_range
        ) || !asset_view_materials(mut input, read values) {
            return false;
        }
    }
    asset_label_range_set(mut session, label_range);
    asset_guide_range_set(mut session, guide_range);
    return true;
}
fn asset_view_run(
    session: AssetSession,
    values: AssetValues,
    options: AssetViewOptions,
    headless: bool
) -> i32 {
    var asset: RoomAsset = room_asset_new();
    var started: u64 = now();
    if !room_build(read values, mut asset) {
        return 1i32;
    }
    asset_build_report(read asset, now() - started);

    var range: MeshRange = mesh_empty_range();
    var motions: InstanceList = instances_new();
    if !asset_session_open(mut session) || !asset_view_upload(
        read values,
        mut session,
        read asset,
        mut range,
        options.open_portals,
        mut motions
    ) {
        return 1i32;
    }
    asset_view_window(mut session);
    var state: AssetViewState = asset_view_state(options.view);
    state.camera.flight = asset.spawn;
    state.waypoints = options.waypoints;
    var previous: u64 = now();
    var animation_start: u64 = previous;
    var frame: u32 = 0u32;
    while state.running && (options.frames == 0u32 || frame < options.frames) {
        var current: u64 = now();
        var seconds: f32 = clamp((current - previous) as f32 / 1000000000f32, 0f32, 0.1f32);
        previous = current;
        if !headless {
            var event: AssetViewEvent = make AssetViewEvent {
                key: 0u32,
                dx: 0f32,
                dy: 0f32,
                wheel: 0f32
            };
            while asset_view_event(mut event) {
                var key: u32 = event.key;
                asset_view_switch(mut state, read asset, range, key);
                asset_view_mouse(mut state, event);
                asset_view_adjust(mut state, key);
                var good: bool = true;
                asset = asset_view_edit(
                    mut session,
                    read state,
                    mut values,
                    move asset,
                    mut range,
                    mut motions,
                    key,
                    options.open_portals,
                    mut good
                );
                if !good {
                    return 1i32;
                }
            }
        }
        if !headless {
            asset_flight_move(mut state.camera, asset_flight_input(), seconds);
        }
        var labels: MeshRange = asset_label_range(read session);
        var visible: MeshRange = asset_view_visible(
            read state,
            read asset,
            read session,
            range
        );
        {
            var renderer: mut Renderer = asset_renderer(mut session);
            var output: FrameInput = renderer_inputs(mut renderer);
            if !asset_scene(mut output, read asset, visible, labels, state.camera) {
                return 1i32;
            }
            var tick: u32 = asset_animation_tick(
                options,
                headless,
                frame,
                current - animation_start
            );
            input_animation_tick(mut output, tick);
            if !asset_view_motion_draw(
                mut output,
                read motions,
                tick,
                asset_view_only_waypoints(read state, read asset)
            ) {
                return 1i32;
            }
        }
        if !asset_session_draw(mut session) {
            return 1i32;
        }
        if !headless {
            asset_session_wait();
        }
        asset_view_rotate(mut state);
        frame = frame + 1u32;
    }
    return (!asset_session_finish(mut session)) as i32;
}

fn asset_view_visible(
    state: read AssetViewState,
    asset: read RoomAsset,
    session: read AssetSession,
    range: MeshRange
) -> MeshRange {
    if state.waypoints && route_nodes_count(read asset.routes) != 0u32 {
        return asset_guide_range(read session);
    }
    return range;
}

// Adds room-local fixture lights to a single-room preview.
fn fixture_lights_preview(lights: read FixtureLights, input: mut FrameInput) -> bool {
    var first: u32 = input_word(read input, LIGHT_COUNT as usize);
    if !input_lights(mut input, first + fixture_light_count(read lights)) {
        return false;
    }
    var i: u32 = 0u32;
    while i < fixture_light_count(read lights) {
        var light: FixtureLight = fixture_light(read lights, i);
        var p: usize = (input_word(read input, LIGHT_DATA as usize) + (first + i) * 8u32) as usize;
        input_set_float(mut input, p, light.position.x);
        input_set_float(mut input, p + 1usize, light.position.y);
        input_set_float(mut input, p + 2usize, light.position.z);
        input_set_float(mut input, p + 3usize, light.radius * light.radius);
        input_set_float(mut input, p + 4usize, light.colour.x);
        input_set_float(mut input, p + 5usize, light.colour.y);
        input_set_float(mut input, p + 6usize, light.colour.z);
        input_set_float(mut input, p + 7usize, LIGHT_UNSHADOWED as f32);
        input_light_space(mut input, first + i, light.space);
        i = i + 1u32;
    }
    return true;
}

fn asset_animation_tick(
    options: AssetViewOptions,
    headless: bool,
    frame: u32,
    elapsed: u64
) -> u32 {
    if !options.animate {
        return options.animation_tick;
    }
    if headless {
        return frame;
    }
    return (elapsed * MATERIAL_ANIMATION_HZ as u64 / 1000000000u64) as u32;
}

fn asset_view_rotate(state: mut AssetViewState) -> unit {
    if state.rotating {
        state.camera.yaw = state.camera.yaw + 0.008f32;
    }
}
fn asset_view_only_waypoints(state: read AssetViewState, asset: read RoomAsset) -> bool {
    return state.waypoints && route_nodes_count(read asset.routes) != 0u32;
}
