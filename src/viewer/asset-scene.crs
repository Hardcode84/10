fn asset_scene(
    input: mut FrameInput,
    asset: read RoomAsset,
    mesh: MeshRange,
    labels: MeshRange,
    camera: AssetCamera
) -> bool {
    input_frame(mut input);
    input_set_word(mut input, 4usize, 0u32);
    input_set_word(mut input, 20usize, 0u32);
    input_set_word(mut input, LIGHT_MODEL as usize, 1u32);
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    input_set_word(mut input, BACKGROUND as usize, 0xff181410u32);
    input_set_float(mut input, RENDER_STYLE as usize, 0.04f32);
    input_set_float(mut input, PROJECTION as usize, 1f32);
    input_set_float(mut input, CAMERA_LIGHT as usize, 900f32);
    var i: u32 = 0u32;
    while i < 3u32 {
        input_set_float(mut input, (SPACE_LIGHT + i) as usize, 0.5f32);
        input_set_float(mut input, (CAMERA_LIGHT + 1u32 + i) as usize, 1f32);
        i = i + 1u32;
    }
    asset_camera(mut input, read asset, mesh, camera);
    return input_instance(mut input, mesh_identity(mesh, 0u32)) && input_instance(
        mut input,
        mesh_identity(labels, 0u32)
    );
}
// Omits port closures for inspection. Shell walls and all solid parts remain.
fn asset_view_open_mesh(asset: read RoomAsset, mesh: mut Mesh) -> bool {
    var triangle: u32 = 0u32;
    var face: u32 = 0u32;
    while face < asset_face_count(read asset.hull) {
        var port: bool = false;
        var i: u32 = 0u32;
        while i < asset_port_count(read asset.ports) {
            port = port || asset_port(read asset.ports, i).face == face;
            i = i + 1u32;
        }
        var end: u32 = triangle + asset_face(read asset.hull, face).count - 2u32;
        while triangle < end {
            if !port && !mesh_append(mut mesh, mesh_triangle(read asset.mesh, triangle)) {
                return false;
            }
            triangle = triangle + 1u32;
        }
        face = face + 1u32;
    }
    while triangle < mesh_triangle_count(read asset.mesh) {
        if !mesh_append(mut mesh, mesh_triangle(read asset.mesh, triangle)) {
            return false;
        }
        triangle = triangle + 1u32;
    }
    return true;
}
fn asset_view_mesh_upload(
    input: mut FrameInput,
    asset: read RoomAsset,
    range: mut MeshRange,
    open_portals: bool
) -> bool {
    if !open_portals {
        return input_mesh(mut input, read asset.mesh, mut range);
    }
    var mesh: Mesh = mesh_new();
    return asset_view_open_mesh(read asset, mut mesh) && input_mesh(
        mut input,
        read mesh,
        mut range
    );
}
fn asset_view_upload(
    values: read AssetValues,
    session: mut AssetSession,
    asset: read RoomAsset,
    range: mut MeshRange,
    open_portals: bool
) -> bool {
    var labels: Mesh = mesh_new();
    if !asset_labels_build(read asset, mut labels) {
        return false;
    }
    var label_range: MeshRange = mesh_empty_range();
    {
        var renderer: mut Renderer = asset_renderer(mut session);
        var input: FrameInput = renderer_inputs(mut renderer);
        input_clear_meshes(mut input);
        if !asset_view_mesh_upload(mut input, read asset, mut range, open_portals) || !input_mesh(
            mut input,
            read labels,
            mut label_range
        ) || !asset_view_materials(mut input, read values) {
            return false;
        }
    }
    asset_label_range_set(mut session, label_range);
    return true;
}
fn asset_view_run(
    session: AssetSession,
    values: AssetValues,
    options: AssetViewOptions,
    headless: bool
) -> i32 {
    var asset: RoomAsset = room_asset_new();
    var started: u64 = now();
    if !room_build(read values, mut asset) {
        return 1i32;
    }
    asset_build_report(read asset, now() - started);

    var range: MeshRange = mesh_empty_range();
    if !asset_session_open(mut session) || !asset_view_upload(
        read values,
        mut session,
        read asset,
        mut range,
        options.open_portals
    ) {
        return 1i32;
    }
    asset_view_window(mut session);
    var state: AssetViewState = asset_view_state(options.view);
    state.camera.flight = asset.spawn;
    var previous: u64 = now();
    var frame: u32 = 0u32;
    while state.running && (options.frames == 0u32 || frame < options.frames) {
        var current: u64 = now();
        var seconds: f32 = clamp((current - previous) as f32 / 1000000000f32, 0f32, 0.1f32);
        previous = current;
        if !headless {
            var event: AssetViewEvent = make AssetViewEvent {
                key: 0u32,
                dx: 0f32,
                dy: 0f32,
                wheel: 0f32
            };
            while asset_view_event(mut event) {
                var key: u32 = event.key;
                asset_view_switch(mut state, read asset, range, key);
                asset_view_mouse(mut state, event);
                asset_view_adjust(mut state, key);
                var good: bool = true;
                asset = asset_view_edit(
                    mut session,
                    read state,
                    mut values,
                    move asset,
                    mut range,
                    key,
                    options.open_portals,
                    mut good
                );
                if !good {
                    return 1i32;
                }
            }
        }
        if !headless {
            asset_flight_move(mut state.camera, asset_flight_input(), seconds);
        }
        var labels: MeshRange = asset_label_range(read session);
        {
            var renderer: mut Renderer = asset_renderer(mut session);
            var output: FrameInput = renderer_inputs(mut renderer);
            if !asset_scene(mut output, read asset, range, labels, state.camera) {
                return 1i32;
            }
        }
        if !asset_session_draw(mut session) {
            return 1i32;
        }
        if !headless {
            asset_session_wait();
        }
        if state.rotating {
            state.camera.yaw = state.camera.yaw + 0.008f32;
        }
        frame = frame + 1u32;
    }
    return (!asset_session_finish(mut session)) as i32;
}
