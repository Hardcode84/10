fn asset_view_window(session: mut AssetSession) -> unit {
    if session.window.handle != null(*u8) {
        app_title(
            session.window.handle,
            "SPINWARD room viewer | drag look/orbit | wheel zoom | F fly: WASD Q/E Shift | Tab view | [ ] parameter | - + adjust | Esc close"
        );
    }
}
fn asset_build_report(asset: read RoomAsset, elapsed: u64) -> unit {
    puts("asset vertices / polygons / triangles / collision bytes / build nanoseconds:");
    print_number(asset_vertex_count(read asset.hull) as i64);
    print_number(asset_face_count(read asset.hull) as i64);
    print_number(asset.mesh.count as i64);
    print_number(collision_bytes(read asset.collision) as i64);
    print_number(elapsed as i64);
}
fn asset_view_rejected(session: mut AssetSession) -> unit {
    if session.window.handle != null(*u8) {
        app_title(
            session.window.handle,
            "Room rebuild rejected; previous successful asset remains visible"
        );
    }
}
fn asset_view_event(output: mut AssetViewEvent) -> bool {
    var event: AppEvent = uninit;
    output = make AssetViewEvent {
        key: 0u32,
        dx: 0f32,
        dy: 0f32,
        wheel: 0f32
    };
    while app_event(&event, false) > 0i32 {
        var kind: u32 = event.kind;
        if kind == APP_QUIT {
            output.key = 27u32;
            return true;
        }
        if kind == APP_KEY_DOWN {
            output.key = event.key;
            if event.repeat && (output.key == 9u32 || output.key == 102u32) {
                output.key = 0u32;
                continue;
            }
            return true;
        }
        if kind == APP_MOUSE_MOVE && (event.buttons & 5u32) != 0u32 {
            output.dx = event.dx;
            output.dy = event.dy;
            return true;
        }
        if kind == APP_MOUSE_WHEEL {
            output.wheel = event.wheel;
            return true;
        }
    }
    return false;
}
fn asset_flight_input() -> AssetFlightInput {
    var input: AssetFlightInput = make AssetFlightInput {
        movement: vec(0f32, 0f32, 0f32),
        boost: false
    };
    if !app_keyboard_active() {
        return input;
    }
    var count: i32 = 0i32;
    var keys: *u8 = app_keys(&count);
    input.movement = vec(
        keys[7usize] as f32 - keys[4usize] as f32,
        keys[8usize] as f32 - keys[20usize] as f32,
        keys[26usize] as f32 - keys[22usize] as f32
    );
    input.boost = keys[225usize] != 0u8 || keys[229usize] != 0u8;
    return input;
}
