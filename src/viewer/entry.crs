fn main(argc: i32, argv: **u8) -> i32 {
    var launch: ViewerLaunch = make ViewerLaunch {
        width: 960u32,
        height: 540u32,
        capture: null(*u8)
    };
    var values: AssetValues = asset_values_new();
    if !asset_values_allocate(mut values, room_parameter_count()) {
        return 1i32;
    }
    asset_parameters_reset(mut values);
    if argc == 2i32 && strcmp(argv[1usize], "--help") == 0i32 {
        asset_view_help();
        return 0i32;
    }
    var options: AssetViewOptions = make AssetViewOptions {
        frames: 0u32,
        view: 0u32,
        open_portals: false
    };
    if !asset_view_options(argc, argv, &launch, &options, mut values) {
        return 2i32;
    }
    if !image_extent_valid(launch.width, launch.height, launch.width, launch.height) {
        error("invalid viewer image dimensions");
        return 2i32;
    }
    if launch.capture != null(*u8) && options.frames == 0u32 {
        options.frames = 1u32;
    }
    return asset_view_run(
        asset_session(&launch),
        move values,
        options,
        launch.capture != null(*u8)
    );
}
