record AssetViewOptions {
    frames: u32;
    view: u32;
}
extern fn strtof(text: *u8, end: **u8) -> f32 = "strtof";
fn asset_parse_parameter(values: mut AssetValues, name: *u8, text: *u8) -> bool {
    var end: *u8 = null(*u8);
    var value: f32 = strtof(text, &end);
    if end == text || end[0usize] != 0u8 || value - value != 0f32 {
        return error("invalid asset parameter number");
    }
    var i: u32 = 0u32;
    while i < room_parameter_count() {
        if asset_name_equal(room_parameter_name(i), name) {
            asset_value_set(mut values, i, value);
            return true;
        }
        i = i + 1u32;
    }
    return error("unknown recipe parameter");
}
fn asset_view_option(
    launch: *ViewerLaunch,
    options: *AssetViewOptions,
    key: *u8,
    value: *u8
) -> bool {
    if strcmp(key, "--frames") == 0i32 {
        return viewer_number(value, &options -> frames);
    }
    if strcmp(key, "--width") == 0i32 {
        return viewer_number(value, &launch -> width);
    }
    if strcmp(key, "--height") == 0i32 {
        return viewer_number(value, &launch -> height);
    }
    if strcmp(key, "--capture") == 0i32 {
        launch -> capture = value;
        return true;
    }
    if strcmp(key, "--view") == 0i32 {
        if strcmp(value, "inside") == 0i32 {
            options -> view = 0u32;
            return true;
        }
        if strcmp(value, "outside") == 0i32 {
            options -> view = 1u32;
            return true;
        }
        if strcmp(value, "start") == 0i32 {
            options -> view = 2u32;
            return true;
        }
        return error("view must be inside, outside, or start");
    }
    return error("unknown viewer option; use --help");
}
fn asset_view_options(
    argc: i32,
    argv: **u8,
    launch: *ViewerLaunch,
    options: *AssetViewOptions,
    values: mut AssetValues
) -> bool {
    var i: usize = 1usize;
    while i < argc as usize {
        if strcmp(argv[i], "--set") == 0i32 {
            if i + 2usize >= argc as usize {
                return error("--set requires parameter name and value");
            }
            if !asset_parse_parameter(mut values, argv[i + 1usize], argv[i + 2usize]) {
                return false;
            }
            i = i + 3usize;
        } else {
            if i + 1usize >= argc as usize {
                return error("viewer option requires a value");
            }
            if !asset_view_option(launch, options, argv[i], argv[i + 1usize]) {
                return false;
            }
            i = i + 2usize;
        }
    }
    return true;
}
fn asset_view_help() -> unit {
    puts("crust viewer.crs ROOM.crs [--set NAME METRES] [--view inside|outside|start]");
    puts("  --width N --height N --frames N --capture FILE");
    puts("Tab: view; arrows: look/orbit; W/S: zoom; Space: auto rotate; Esc: close");
    puts("Left/right drag: look/orbit; mouse wheel: exterior zoom; spawn view stays fixed");
    puts("[/]: select parameter; -/+: change; R: reset selected parameter");
    puts("Recipe parameters (metres):");
    var i: u32 = 0u32;
    while i < room_parameter_count() {
        asset_name_print(room_parameter_name(i));
        i = i + 1u32;
    }
}
record ViewerLaunch {
    width: u32;
    height: u32;
    capture: *u8;
}
opaque;
extern fn strcmp(a: *u8, b: *u8) -> i32 = "strcmp";
fn viewer_number(text: *u8, value: *u32) -> bool {
    var i: usize = 0usize;
    var result: u32 = 0u32;
    while text[i] != 0u8 {
        if text[i] < 48u8 || text[i] > 57u8 || result > 1000000u32 {
            return error("invalid unsigned viewer option");
        }
        result = result * 10u32 + (text[i] - 48u8) as u32;
        i = i + 1usize;
    }
    if i == 0usize {
        return error("empty viewer option");
    }
    * value = result;
    return true;
}
