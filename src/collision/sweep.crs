// Sweeps a sphere against a two-sided triangle surface. The radius is nonnegative.
fn collision_face_hit(p: Vec3, d: Vec3, f: CollisionFace, radius: f32) -> Hit worker {
    var n: Vec3 = f.normal;
    if dot(sub(p, f.a), n) < 0f32 {
        n = scale(n, -1f32);
    }
    var speed: f32 = dot(d, n);
    if speed >= 0f32 {
        return miss();
    }
    var time: f32 = (radius - dot(sub(p, f.a), n)) / speed;
    if time < 0f32 || time > 1f32 {
        return miss();
    }
    var point: Vec3 = sub(add(p, scale(d, time)), scale(n, radius));
    if !collision_inside(f, point) {
        return miss();
    }
    return make Hit {
        time: time,
        normal: n
    };
}
fn collision_inside(f: CollisionFace, p: Vec3) -> bool worker {
    var i: u32 = 0u32;
    while i < 3u32 {
        var a: Vec3 = collision_corner(f, i);
        var b: Vec3 = collision_corner(f, (i + 1u32) % 3u32);
        var edge: Vec3 = sub(b, a);
        var side: f32 = dot(cross(edge, sub(p, a)), f.normal);
        var tolerance: f32 = 0f32;
        if f.neighbours[i as usize] != 0xffffffffu32 {
            tolerance = 0.000001f32 * collision_l1(edge) * (
                collision_l1(a) + collision_l1(b) + collision_l1(p)
            );
        }
        if side < -tolerance {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn collision_l1(p: Vec3) -> f32 worker {
    return absf(p.x) + absf(p.y) + absf(p.z);
}
fn collision_closest_edge(p: Vec3, a: Vec3, b: Vec3) -> Vec3 worker {
    var centre: Vec3 = add(scale(a, 0.5f32), scale(b, 0.5f32));
    var half: Vec3 = sub(scale(b, 0.5f32), scale(a, 0.5f32));
    var fraction: f32 = clamp(
        dot(sub(p, centre), half) / dot(half, half),
        -1f32,
        1f32
    );
    return add(centre, scale(half, fraction));
}
fn collision_closest(f: CollisionFace, p: Vec3) -> Vec3 worker {
    var plane: Vec3 = sub(p, scale(f.normal, dot(sub(p, f.a), f.normal)));
    if collision_inside(f, plane) {
        return plane;
    }
    var closest: Vec3 = f.a;
    var i: u32 = 0u32;
    while i < 3u32 {
        var q: Vec3 = collision_closest_edge(
            p,
            collision_corner(f, i),
            collision_corner(f, (i + 1u32) % 3u32)
        );
        if dot(sub(q, p), sub(q, p)) < dot(sub(closest, p), sub(closest, p)) {
            closest = q;
        }
        i = i + 1u32;
    }
    return closest;
}
fn collision_triangle(p: Vec3, d: Vec3, f: CollisionFace, radius: f32) -> Hit worker {
    var hit: Hit = collision_face_hit(p, d, f, radius);
    if radius == 0f32 {
        return hit;
    }
    var i: u32 = 0u32;
    while i < 3u32 {
        if f.neighbours[i as usize] == 0xffffffffu32 {
            hit = nearest(
                hit,
                edge_hit(
                    p,
                    d,
                    collision_corner(f, i),
                    collision_corner(f, (i + 1u32) % 3u32),
                    radius
                )
            );
        }
        i = i + 1u32;
    }
    return hit;
}
record CollisionContact {
    frame: SpaceTransform;
    hit: Hit;
    point: Vec3;
    local_point: Vec3;
    penetration: f32;
    instance: u32;
    surface: u32;
    space: u32;
}
fn collision_miss(space: u32) -> CollisionContact worker {
    return make CollisionContact {
        frame: space_identity(),
        hit: miss(),
        point: vec(0f32, 0f32, 0f32),
        local_point: vec(0f32, 0f32, 0f32),
        penetration: 0f32,
        instance: 0xffffffffu32,
        surface: 0xffffffffu32,
        space: space
    };
}
fn collision_surface(p: Vec3, d: Vec3, f: CollisionFace, radius: f32) -> CollisionContact worker {
    var contact: CollisionContact = collision_miss(0u32);
    var proximity: CollisionProximity = collision_proximity(f, p);
    var point: Vec3 = proximity.point;
    var distance: f32 = proximity.distance;
    if distance < radius {
        contact.penetration = radius - distance;
        var normal: Vec3 = proximity.normal;
        if distance == 0f32 && dot(normal, d) > 0f32 {
            normal = scale(normal, -1f32);
        }
        contact.hit = make Hit {
            time: 0f32,
            normal: normal
        };
    } else {
        contact.hit = collision_triangle(p, d, f, radius);
        point = sub(
            add(p, scale(d, contact.hit.time)),
            scale(contact.hit.normal, radius)
        );
    }
    contact.local_point = point;
    return contact;
}
record CollisionProximity {
    point: Vec3;
    normal: Vec3;
    distance: f32;
}
fn collision_proximity(f: CollisionFace, p: Vec3) -> CollisionProximity worker {
    var distance: f32 = dot(sub(p, f.a), f.normal);
    var point: Vec3 = sub(p, scale(f.normal, distance));
    var normal: Vec3 = f.normal;
    if distance < 0f32 {
        normal = scale(normal, -1f32);
    }
    if collision_inside(f, point) {
        return make CollisionProximity {
            point: point,
            normal: normal,
            distance: absf(distance)
        };
    }
    point = collision_closest(f, p);
    var offset: Vec3 = sub(p, point);
    distance = length(offset);
    if distance > 0f32 {
        normal = collision_normal(offset);
    }
    return make CollisionProximity {
        point: point,
        normal: normal,
        distance: distance
    };
}
