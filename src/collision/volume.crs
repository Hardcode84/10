fn collision_ray_edge(a: Vec3, b: Vec3, p: Vec3) -> f32 {
    return (a.y - p.y) * (b.z - p.z) - (a.z - p.z) * (b.y - p.y);
}
fn collision_ray_edge_owned(a: Vec3, b: Vec3, edge: f32) -> bool {
    return edge > 0f32 || (
        edge == 0f32 && (b.z > a.z || (b.z == a.z && b.y < a.y))
    );
}
fn collision_ray_crossing(f: CollisionFace, p: Vec3) -> i64 {
    var a: Vec3 = f.a;
    var b: Vec3 = f.b;
    var c: Vec3 = f.c;
    var area: f32 = collision_ray_edge(a, b, c);
    if area == 0f32 {
        return 0i64;
    }
    var sign: i64 = 1i64;
    if area < 0f32 {
        var swap: Vec3 = b;
        b = c;
        c = swap;
        sign = -1i64;
    }
    var ab: f32 = collision_ray_edge(a, b, p);
    var bc: f32 = collision_ray_edge(b, c, p);
    var ca: f32 = collision_ray_edge(c, a, p);
    if !collision_ray_edge_owned(a, b, ab) || !collision_ray_edge_owned(b, c, bc) || !collision_ray_edge_owned(
        c,
        a,
        ca
    ) {
        return 0i64;
    }
    var distance: f32 = bc * (a.x - p.x) + ca * (b.x - p.x) + ab * (c.x - p.x);
    if distance <= 0f32 {
        return 0i64;
    }
    return sign;
}
fn collision_volume_contains(scene: read CollisionScene, item: CollisionInstance, p: Vec3) -> bool {
    var crossings: i64 = 0i64;
    var i: u32 = item.root;
    while i < item.end {
        var node: CollisionNode = collision_node(read scene, item.chunk, i);
        if p.x > node.high.x || p.y < node.low.y || p.y > node.high.y || p.z < node.low.z || p.z > node.high.z {
            i = node.skip;
        } else {
            if node.leaf != 0xffffffffu32 {
                crossings = crossings + collision_ray_crossing(
                    collision_face(read scene, item.chunk, item.first + node.leaf),
                    p
                );
            }
            i = i + 1u32;
        }
    }
    return crossings != 0i64;
}
fn collision_inside_solid(scene: read CollisionScene, index: u32, p: Vec3) -> bool {
    var item: CollisionInstance = collision_instance(read scene, index);
    return collision_inside_pose(read scene, item, p);
}
fn collision_inside_pose(scene: read CollisionScene, item: CollisionInstance, p: Vec3) -> bool {
    if !item.solid {
        return false;
    }
    var local: Vec3 = collision_local(item.basis, sub(p, item.origin));
    if !collision_aabb(local, vec(0f32, 0f32, 0f32), 0f32, item.low, item.high) {
        return false;
    }
    return collision_volume_contains(read scene, item, local);
}
// Returns an enclosing solid instance, or 0xffffffff if the centre is outside all solids.
fn collision_embedded(scene: read CollisionScene, space: u32, p: Vec3) -> u32 {
    var range: CollisionSpace = collision_space(read scene, space);
    var i: u32 = range.root;
    while i < range.end {
        var node: CollisionNode = collision_node(read scene, range.chunk, i);
        if !collision_aabb(p, vec(0f32, 0f32, 0f32), 0f32, node.low, node.high) {
            i = node.skip;
        } else {
            if node.leaf != 0xffffffffu32 && !collision_moving(
                collision_instance(read scene, node.leaf)
            ) && collision_inside_solid(read scene, node.leaf, p) {
                return node.leaf;
            }
            i = i + 1u32;
        }
    }
    return 0xffffffffu32;
}
// Rejects an embedded centre or surface overlap. Use after spawn, load, or scene replacement.
fn collision_position_valid(scene: read CollisionScene, space: u32, p: Vec3, radius: f32) -> bool {
    if !collision_finite(p) ||!(radius > 0f32 && radius < 3.4028234e38f32) {
        return false;
    }
    if collision_embedded(read scene, space, p) != 0xffffffffu32 {
        return false;
    }
    var hit: CollisionContact = collision_sweep(
        read scene,
        space,
        p,
        vec(0f32, 0f32, 0f32),
        radius
    );
    return hit.penetration <= collision_tolerance(p, radius) * 0.25f32;
}
