extern fn portal_realloc(p: *u8, size: usize) -> *u8 = "realloc";
record SpaceTransform {
    origin: Vec3;
    basis: Basis;
}
record CollisionPortal {
    space: u32;
    destination: u32;
    origin: Vec3;
    basis: Basis;
    radius: f32;
    sides: u32;
    phase: f32;
    transform: SpaceTransform;
}
fn collision_portal_count(scene: read CollisionScene) -> u32 {
    return scene.data.portal_count;
}
fn collision_portal(scene: read CollisionScene, index: u32) -> CollisionPortal {
    return scene.data.portals[index as usize];
}
fn collision_portal_append(builder: mut CollisionBuilder, portal: CollisionPortal) -> bool {
    var count: usize = builder.data.portal_count as usize;
    if count == 0xffffffffusize {
        return error("portal table exceeds address range");
    }
    var data: *CollisionPortal = portal_realloc(
        builder.data.portals as *u8,
        (count + 1usize) * sizeof(CollisionPortal)
    ) as *CollisionPortal;
    if data == null(*CollisionPortal) {
        return error("portal allocation failed");
    }
    builder.data.portals = data;
    data[count] = portal;
    builder.data.portal_count = builder.data.portal_count + 1u32;
    return true;
}
