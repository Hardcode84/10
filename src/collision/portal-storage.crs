extern fn portal_realloc(p: *u8, size: usize) -> *u8 = "realloc";
record SpaceTransform {
    factor: f32;
    origin: Vec3;
    basis: Basis;
}
record CollisionPortal {
    support_bound: f32;
    source_scale: ScaleRatio;
    target_scale: ScaleRatio;
    reverse: u32;
    space: u32;
    destination: u32;
    origin: Vec3;
    basis: Basis;
    radius: f32;
    sides: u32;
    phase: f32;
    transform: SpaceTransform;
}
fn collision_portal_count(scene: read CollisionScene) -> u32 {
    return scene.data.portal_count;
}
fn collision_portal(scene: read CollisionScene, index: u32) -> CollisionPortal {
    return scene.data.portals[index as usize];
}
fn collision_portal_append(builder: mut CollisionBuilder, portal: CollisionPortal) -> bool {
    var ratio: Rational = portal_ratio(portal);
    portal.transform.factor = rational_float(read ratio);
    if !portal_transform_valid(portal) {
        return error("portal needs a finite positive similarity transform");
    }
    var count: usize = builder.data.portal_count as usize;
    if count == 0xffffffffusize {
        return error("portal table exceeds address range");
    }
    var data: *CollisionPortal = portal_realloc(
        builder.data.portals as *u8,
        (count + 1usize) * sizeof(CollisionPortal)
    ) as *CollisionPortal;
    if data == null(*CollisionPortal) {
        return error("portal allocation failed");
    }
    builder.data.portals = data;
    data[count] = portal;
    builder.data.portal_count = builder.data.portal_count + 1u32;
    return true;
}

fn collision_portals_valid(scene: read CollisionScene) -> bool {
    var i: u32 = 0u32;
    while i < collision_portal_count(read scene) {
        var portal: CollisionPortal = collision_portal(read scene, i);
        if portal.reverse != 0xffffffffu32 {
            if portal.reverse >= collision_portal_count(read scene) {
                return error("portal reverse index is outside the connection table");
            }
            var reverse: CollisionPortal = collision_portal(read scene, portal.reverse);
            var forward_ratio: Rational = portal_ratio(portal);
            var reverse_ratio: Rational = portal_ratio(reverse);
            var product: Rational = rational_product(read forward_ratio, read reverse_ratio);
            var one: Rational = rational_new(1u64, 1u64);
            if !rational_equal(read product, read one) {
                return error("portal reverse scales must be reciprocal");
            }
            if reverse.reverse != i || reverse.space != portal.destination || reverse.destination != portal.space {
                return error("portal reverse links must be reciprocal and exchange rooms");
            }
        }
        i = i + 1u32;
    }
    return true;
}

fn portal_ratio(portal: CollisionPortal) -> Rational {
    var source: Rational = rational_new(
        portal.source_scale.denominator,
        portal.source_scale.numerator
    );
    var target: Rational = rational_new(
        portal.target_scale.numerator,
        portal.target_scale.denominator
    );
    return rational_product(read source, read target);
}

fn portal_transform_valid(portal: CollisionPortal) -> bool {
    var factor: f32 = portal.transform.factor;
    var square: f32 = factor * factor;
    return factor > 0f32 && square > 0f32 && collision_finite(
        vec(square, 1f32 / square, portal.radius)
    ) && portal.radius > 0f32 && collision_finite(portal.origin) && collision_finite(
        portal.transform.origin
    ) && collision_rigid(portal.basis) && collision_rigid(portal.transform.basis);
}

fn collision_portal_support(scene: mut CollisionScene) -> unit {
    var i: u32 = 0u32;
    while i < scene.data.portal_count {
        var portal: CollisionPortal = scene.data.portals[i as usize];
        var bound: f32 = length(portal.transform.origin) + portal.radius * portal.transform.factor;
        var room: CollisionSpace = collision_space(read scene, portal.destination);
        if room.root < room.end {
            var node: CollisionNode = collision_node(read scene, room.chunk, room.root);
            bound = collision_max_scalar(
                bound,
                collision_max_scalar(length(node.low), length(node.high))
            );
        }
        scene.data.portals[i as usize].support_bound = bound;
        i = i + 1u32;
    }
}

record CollisionPortalEntry {
    space: u32;
    id: u32;
}
fn collision_portal_compare(a: *u8, b: *u8) -> i32 {
    var x: *CollisionPortalEntry = a as *CollisionPortalEntry;
    var y: *CollisionPortalEntry = b as *CollisionPortalEntry;
    var order: i32 = collision_compare_id(x -> space, y -> space);
    if order != 0i32 {
        return order;
    }
    return collision_compare_id(x -> id, y -> id);
}
fn collision_portal_index_build(scene: *CollisionScene) -> bool {
    var count: u32 = scene -> data.portal_count;
    if count == 0u32 {
        return true;
    }
    scene -> portal_index = malloc(count as usize * sizeof(CollisionPortalEntry)) as *CollisionPortalEntry;
    if scene -> portal_index == null(*CollisionPortalEntry) {
        return error("collision portal index allocation failed");
    }
    var i: u32 = 0u32;
    while i < count {
        scene -> portal_index[i as usize] = make CollisionPortalEntry {
            space: scene -> data.portals[i as usize].space,
            id: i
        };
        i = i + 1u32;
    }
    collision_sort(
        scene -> portal_index as *u8,
        count as usize,
        sizeof(CollisionPortalEntry),
        collision_portal_compare
    );
    return true;
}
fn collision_portal_begin(scene: read CollisionScene, space: u32) -> u32 {
    var lo: u32 = 0u32;
    var hi: u32 = scene.data.portal_count;
    while lo < hi {
        var mid: u32 = lo + (hi - lo) / 2u32;
        if scene.portal_index[mid as usize].space < space {
            lo = mid + 1u32;
        } else {
            hi = mid;
        }
    }
    return lo;
}
fn collision_portal_at_space(scene: read CollisionScene, cursor: u32, space: u32) -> bool {
    return cursor < scene.data.portal_count && scene.portal_index[cursor as usize].space == space;
}
fn collision_portal_id(scene: read CollisionScene, cursor: u32) -> u32 {
    return scene.portal_index[cursor as usize].id;
}
