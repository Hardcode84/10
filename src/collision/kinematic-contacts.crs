fn collision_contact_planes(
    pose: CollisionInstance,
    proximity: CollisionProximity,
    radius: f32,
    skin: f32,
    separate: mut CollisionPlanes,
    speeds: mut CollisionPlanes
) -> bool {
    var normal: Vec3 = collision_normal(basis_vector(pose.basis, proximity.normal));
    var position: CollisionPlane = make CollisionPlane {
        error: skin * 0.125f32,
        normal: normal,
        offset: radius + skin - proximity.distance
    };
    var velocity: CollisionPlane = make CollisionPlane {
        error: 0f32,
        normal: normal,
        offset: dot(normal, collision_surface_velocity(pose, proximity.point))
    };
    return collision_plane_add(mut separate, position) && collision_plane_add(
        mut speeds,
        velocity
    );
}
fn collision_moving_contacts(
    scene: read CollisionScene,
    item: CollisionInstance,
    p: Vec3,
    radius: f32,
    skin: f32,
    time: f32,
    separate: mut CollisionPlanes,
    speeds: mut CollisionPlanes
) -> bool {
    var anchors: RoomAnchors = room_anchors_new();
    return collision_anchored_contacts(
        read scene,
        item,
        p,
        radius,
        skin,
        time,
        mut separate,
        mut speeds,
        read anchors,
        0u32
    );
}
fn collision_anchored_contacts(
    scene: read CollisionScene,
    item: CollisionInstance,
    p: Vec3,
    radius: f32,
    skin: f32,
    time: f32,
    separate: mut CollisionPlanes,
    speeds: mut CollisionPlanes,
    anchors: read RoomAnchors,
    anchor_index: u32
) -> bool {
    var pose: CollisionInstance = collision_pose(item, time);
    var local: Vec3 = collision_local(pose.basis, sub(p, pose.origin));
    var i: u32 = item.root;
    while i < item.end {
        var node: CollisionNode = collision_node(read scene, item.chunk, i);
        if !collision_aabb(
            local,
            vec(0f32, 0f32, 0f32),
            radius + skin * 2f32,
            node.low,
            node.high
        ) {
            i = node.skip;
        } else {
            if node.leaf != 0xffffffffu32 {
                var proximity: CollisionProximity = collision_proximity(
                    collision_face(read scene, item.chunk, item.first + node.leaf),
                    local
                );
                if proximity.distance <= radius + skin * 2f32 && collision_anchor_accept(
                    read scene,
                    read anchors,
                    anchor_index,
                    p,
                    add(pose.origin, basis_vector(pose.basis, proximity.point))
                ) && !collision_anchored_planes(
                    pose,
                    proximity,
                    radius,
                    skin,
                    mut separate,
                    mut speeds,
                    read anchors,
                    anchor_index
                ) {
                    return false;
                }
            }
            i = i + 1u32;
        }
    }
    return true;
}
fn collision_local_interval_contacts(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    radius: f32,
    skin: f32,
    time: f32,
    separate: mut CollisionPlanes,
    speeds: mut CollisionPlanes
) -> bool {
    if !collision_contacts(read scene, space, p, radius, skin, mut separate) {
        return false;
    }
    collision_planes_clear(mut speeds);
    var i: u32 = 0u32;
    while i < collision_plane_count(read separate) {
        var plane: CollisionPlane = collision_plane(read separate, i);
        plane.offset = 0f32;
        plane.error = 0f32;
        if !collision_plane_add(mut speeds, plane) {
            return false;
        }
        i = i + 1u32;
    }
    i = collision_moving_head(read scene);
    while i != 0xffffffffu32 {
        var item: CollisionInstance = collision_instance(read scene, i);
        if item.space == space && !collision_moving_contacts(
            read scene,
            item,
            p,
            radius,
            skin,
            time,
            mut separate,
            mut speeds
        ) {
            return false;
        }
        i = item.next_moving;
    }
    return true;
}
fn collision_local_correction_blocked(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    radius: f32,
    time: f32
) -> CollisionContact {
    var anchors: RoomAnchors = room_anchors_new();
    return collision_filtered_correction_blocked(
        read scene,
        space,
        p,
        d,
        radius,
        time,
        read anchors,
        0u32
    );
}
fn collision_filtered_correction_blocked(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    radius: f32,
    time: f32,
    anchors: read RoomAnchors,
    anchor_index: u32
) -> CollisionContact {
    var result: CollisionContact = collision_query_filtered(
        read scene,
        space,
        p,
        d,
        radius,
        true,
        read anchors,
        anchor_index
    );
    var i: u32 = collision_moving_head(read scene);
    while i != 0xffffffffu32 {
        var item: CollisionInstance = collision_instance(read scene, i);
        if item.space == space {
            var next: CollisionContact = collision_query_pose_filtered(
                read scene,
                i,
                collision_pose(item, time),
                p,
                d,
                radius,
                true,
                read anchors,
                anchor_index,
                vec(0f32, 0f32, 0f32)
            );
            if collision_better(next, result) {
                result = next;
            }
        }
        i = item.next_moving;
    }
    return result;
}
fn collision_travel_planes(
    speeds: read CollisionPlanes,
    duration: f32,
    planes: mut CollisionPlanes
) -> bool {
    collision_planes_clear(mut planes);
    var i: u32 = 0u32;
    while i < collision_plane_count(read speeds) {
        var plane: CollisionPlane = collision_plane(read speeds, i);
        plane.offset = plane.offset * duration;
        plane.error = plane.error * duration;
        if !collision_plane_add(mut planes, plane) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
