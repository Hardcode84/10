fn collision_anchor_accept(
    scene: read CollisionScene,
    anchors: read RoomAnchors,
    index: u32,
    center: Vec3,
    point: Vec3
) -> bool {
    if room_anchor_count(read anchors) == 0u32 {
        return true;
    }
    var inverse: SpaceTransform = space_inverse(room_anchor(read anchors, index).transform);
    return anchor_contact_visible(
        read scene,
        read anchors,
        index,
        space_point(inverse, center),
        space_point(inverse, point)
    );
}
fn anchor_contact_visible(
    scene: read CollisionScene,
    anchors: read RoomAnchors,
    index: u32,
    center: Vec3,
    point: Vec3
) -> bool {
    var cursor: u32 = index;
    while room_anchor(read anchors, cursor).parent != 0xffffffffu32 {
        var child: RoomAnchor = room_anchor(read anchors, cursor);
        var parent: RoomAnchor = room_anchor(read anchors, child.parent);
        var portal: CollisionPortal = collision_portal(read scene, child.portal);
        var start: Vec3 = space_point(parent.transform, center);
        var end: Vec3 = space_point(parent.transform, point);
        var a: f32 = dot(portal.basis.forward, sub(start, portal.origin));
        var b: f32 = dot(portal.basis.forward, sub(end, portal.origin));
        if b < 0f32 {
            return false;
        }
        if a <= 0f32 {
            var crossing: Vec3 = end;
            if a != b {
                crossing = add(start, scale(sub(end, start), -a / (b - a)));
            }
            if !portal_inside(portal, crossing) {
                return false;
            }
        }
        cursor = child.parent;
    }
    return true;
}
fn anchor_contact(anchor: RoomAnchor, contact: CollisionContact) -> CollisionContact {
    var result: CollisionContact = contact;
    result.frame = space_inverse(anchor.transform);
    result.point = space_point(result.frame, contact.point);
    result.hit.normal = basis_vector(result.frame.basis, contact.hit.normal);
    return move result;
}
record CollisionAttachment {
    path: PortalPath;
    ratio: Rational;
}
fn collision_attachment_new() -> CollisionAttachment {
    return make CollisionAttachment {
        path: portal_path_new(),
        ratio: rational_new(1u64, 1u64)
    };
}
fn collision_attachment_swap(a: mut CollisionAttachment, b: mut CollisionAttachment) -> unit {
    portal_path_swap(mut a.path, mut b.path);
    rational_swap(mut a.ratio, mut b.ratio);
}
fn collision_sweep_interval_body(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    time: f32,
    duration: f32
) -> CollisionSweep {
    if collision_portal_count(read scene) == 0u32 {
        return collision_local_sweep_interval(
            read scene,
            space,
            p,
            d,
            collision_body_radius(read body),
            time,
            duration
        );
    }
    var anchors: RoomAnchors = room_anchors_new();
    var selected: u32 = 0xffffffffu32;
    return collision_sweep_with_anchors(
        read scene,
        space,
        p,
        d,
        read body,
        time,
        duration,
        mut anchors,
        mut selected
    );
}
// Writes the exact contact placement path and scale into reusable attachment storage.
fn collision_sweep_attachment_body(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    time: f32,
    duration: f32,
    attachment: mut CollisionAttachment
) -> CollisionSweep {
    portal_path_clear(mut attachment.path);
    var identity: Rational = rational_new(1u64, 1u64);
    rational_assign(mut attachment.ratio, read identity);
    if collision_portal_count(read scene) == 0u32 {
        return collision_local_sweep_interval(
            read scene,
            space,
            p,
            d,
            collision_body_radius(read body),
            time,
            duration
        );
    }
    var anchors: RoomAnchors = room_anchors_new();
    var selected: u32 = 0xffffffffu32;
    var result: CollisionSweep = collision_sweep_with_anchors(
        read scene,
        space,
        p,
        d,
        read body,
        time,
        duration,
        mut anchors,
        mut selected
    );
    if result.status == 0u32 && selected != 0xffffffffu32 {
        collision_anchor_path(read scene, read anchors, selected, mut attachment.path);
        rational_assign(mut attachment.ratio, room_anchor_ratio(read anchors, selected));
    }
    return result;
}
fn collision_sweep_attachment_interval(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    radius: f32,
    time: f32,
    duration: f32,
    attachment: mut CollisionAttachment
) -> CollisionSweep {
    var size: Rational = rational_new(1u64, 1u64);
    var body: CollisionBody = collision_body(radius, read size);
    return collision_sweep_attachment_body(
        read scene,
        space,
        p,
        d,
        read body,
        time,
        duration,
        mut attachment
    );
}
// Contact positions and normals use the query room. frame maps the contacted room to the query room.
fn collision_sweep_with_anchors(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    time: f32,
    duration: f32,
    anchors: mut RoomAnchors,
    selected: mut u32
) -> CollisionSweep {
    selected = 0xffffffffu32;
    room_anchors_clear(mut anchors);
    var crossing: PortalCrossing = portal_crossing(read scene, space, p, d);
    var fraction: f32 = clamp(crossing.time, 0f32, 1f32);
    var travel: Vec3 = scale(d, fraction);
    var result: CollisionSweep = collision_sweep_result(collision_miss(space));
    if !collision_scaled_anchors(
        read scene,
        mut anchors,
        space,
        p,
        travel,
        read body,
        false
    ) {
        result.status = 7u32;
        return move result;
    }
    var admission: CollisionAdmission = collision_require_anchors(read scene, read anchors);
    if admission.status != 0u32 {
        return collision_required_sweep(admission.space);
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        var next: CollisionSweep = collision_anchor_sweep(
            read scene,
            anchor,
            space_point(anchor.transform, p),
            space_vector(anchor.transform, travel),
            collision_placement_radius(read body, read anchors, i),
            time,
            duration * fraction,
            read anchors,
            i
        );
        if next.status != 0u32 {
            return move next;
        }
        if next.contact.hit.time <= 1f32 {
            next.contact = anchor_contact(anchor, next.contact);
            next.contact.hit.time = next.contact.hit.time * fraction;
            if collision_better(next.contact, result.contact) {
                result = next;
                selected = i;
            }
        }
        i = i + 1u32;
    }
    result.crossing = crossing;
    return move result;
}
fn collision_correction_blocked_body(
    scene: read CollisionScene,
    space: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    time: f32
) -> CollisionSweep {
    if !collision_room_resident(read scene, space) {
        return collision_required_sweep(space);
    }
    var radius: f32 = collision_body_radius(read body);
    if collision_portal_count(read scene) == 0u32 {
        return collision_sweep_result(
            collision_local_correction_blocked(read scene, space, p, d, radius, time)
        );
    }
    var result: CollisionContact = collision_miss(space);
    var anchors: RoomAnchors = room_anchors_new();
    if !collision_scaled_anchors(read scene, mut anchors, space, p, d, read body, false) {
        var failure: CollisionSweep = collision_sweep_result(result);
        failure.status = 7u32;
        return move failure;
    }
    var admission: CollisionAdmission = collision_require_anchors(read scene, read anchors);
    if admission.status != 0u32 {
        return collision_required_sweep(admission.space);
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        var next: CollisionContact = collision_anchor_correction(
            read scene,
            anchor,
            space_point(anchor.transform, p),
            space_vector(anchor.transform, d),
            collision_placement_radius(read body, read anchors, i),
            time,
            read anchors,
            i
        );
        if next.hit.time <= 1f32 {
            next = anchor_contact(anchor, next);
            if collision_better(next, result) {
                result = next;
            }
        }
        i = i + 1u32;
    }
    return collision_sweep_result(result);
}

fn collision_anchor_path(
    scene: read CollisionScene,
    anchors: read RoomAnchors,
    index: u32,
    path: mut PortalPath
) -> unit {
    portal_path_clear(mut path);
    var anchor: RoomAnchor = room_anchor(read anchors, index);
    while anchor.parent != 0xffffffffu32 {
        var link: CollisionPortal = collision_portal(read scene, anchor.portal);
        portal_path_prepend(mut path, anchor.portal, link.reverse);
        anchor = room_anchor(read anchors, anchor.parent);
    }
}

fn collision_anchor_sweep(
    scene: read CollisionScene,
    anchor: RoomAnchor,
    p: Vec3,
    d: Vec3,
    radius: f32,
    time: f32,
    duration: f32,
    anchors: read RoomAnchors,
    index: u32
) -> CollisionSweep {
    if anchor.cap != 0xffffffffu32 {
        return collision_sweep_result(
            collision_cap_sweep(read scene, read anchors, index, p, d, radius, false)
        );
    }
    return collision_filtered_sweep_interval(
        read scene,
        anchor.space,
        p,
        d,
        radius,
        time,
        duration,
        read anchors,
        index
    );
}
fn collision_anchor_correction(
    scene: read CollisionScene,
    anchor: RoomAnchor,
    p: Vec3,
    d: Vec3,
    radius: f32,
    time: f32,
    anchors: read RoomAnchors,
    index: u32
) -> CollisionContact {
    if anchor.cap != 0xffffffffu32 {
        return collision_cap_sweep(read scene, read anchors, index, p, d, radius, true);
    }
    return collision_filtered_correction_blocked(
        read scene,
        anchor.space,
        p,
        d,
        radius,
        time,
        read anchors,
        index
    );
}
