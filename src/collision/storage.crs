record CollisionFace {
    a: Vec3;
    b: Vec3;
    c: Vec3;
    normal: Vec3;
    neighbours: [u32; 3];
}
record CollisionInstance {
    controlled: bool;
    motion_start: f32;
    motion_duration: f32;
    motion_offset: Vec3;
    motion_target: Vec3;
    solid: bool;
    linear: Vec3;
    angular: Vec3;
    next_moving: u32;
    first: u32;
    count: u32;
    space: u32;
    origin: Vec3;
    basis: Basis;
    low: Vec3;
    high: Vec3;
    root: u32;
    end: u32;
}
record CollisionData {
    faces: *CollisionFace;
    face_count: u32;
    face_capacity: u32;
    instances: *CollisionInstance;
    instance_count: u32;
    instance_capacity: u32;
    moving: u32;
    portals: *CollisionPortal;
    portal_count: u32;
}
opaque;
resource CollisionBuilder {
    data: CollisionData;
}
opaque drop collision_builder_drop;
record RoomFrameEntry {
    id: u32;
    frame: RoomFrame;
}
resource CollisionScene {
    frames: *RoomFrameEntry;
    frame_count: u32;
    frame_capacity: u32;
    data: CollisionData;
    nodes: *CollisionNode;
    node_count: u32;
    spaces: *CollisionSpace;
    space_count: u32;
    portal_index: *CollisionPortalEntry;
}
opaque share drop collision_drop;
record CollisionNode {
    low: Vec3;
    high: Vec3;
    skip: u32;
    leaf: u32;
}
record CollisionSpace {
    id: u32;
    root: u32;
    end: u32;
}
fn collision_empty_data() -> CollisionData {
    return make CollisionData {
        faces: null(*CollisionFace),
        face_count: 0u32,
        face_capacity: 0u32,
        instances: null(*CollisionInstance),
        instance_count: 0u32,
        instance_capacity: 0u32,
        portals: null(*CollisionPortal),
        portal_count: 0u32,
        moving: 0xffffffffu32
    };
}
fn collision_builder_new() -> CollisionBuilder {
    return make CollisionBuilder {
        data: collision_empty_data()
    };
}
fn collision_builder_drop(builder: mut CollisionBuilder) -> unit {
    free(builder.data.portals as *u8);
    free(builder.data.faces as *u8);
    free(builder.data.instances as *u8);
}
fn collision_drop(scene: mut CollisionScene) -> unit {
    free(scene.frames as *u8);
    free(scene.data.portals as *u8);
    free(scene.data.faces as *u8);
    free(scene.data.instances as *u8);
    free(scene.nodes as *u8);
    free(scene.spaces as *u8);
    free(scene.portal_index as *u8);
}
fn collision_new() -> CollisionScene {
    return make CollisionScene {
        frames: null(*RoomFrameEntry),
        frame_count: 0u32,
        frame_capacity: 0u32,
        data: collision_empty_data(),
        nodes: null(*CollisionNode),
        node_count: 0u32,
        spaces: null(*CollisionSpace),
        portal_index: null(*CollisionPortalEntry),
        space_count: 0u32
    };
}
fn collision_face(scene: read CollisionScene, index: u32) -> CollisionFace {
    return scene.data.faces[index as usize];
}
fn collision_instance(scene: read CollisionScene, index: u32) -> CollisionInstance {
    return scene.data.instances[index as usize];
}
fn collision_instances(scene: read CollisionScene) -> u32 {
    return scene.data.instance_count;
}
fn collision_builder_instances(builder: read CollisionBuilder) -> u32 {
    return builder.data.instance_count;
}
fn collision_node(scene: read CollisionScene, index: u32) -> CollisionNode {
    return scene.nodes[index as usize];
}
fn collision_space(scene: read CollisionScene, id: u32) -> CollisionSpace {
    var lo: u32 = 0u32;
    var hi: u32 = scene.space_count;
    while lo < hi {
        var mid: u32 = lo + (hi - lo) / 2u32;
        if scene.spaces[mid as usize].id < id {
            lo = mid + 1u32;
        } else {
            hi = mid;
        }
    }
    if lo < scene.space_count && scene.spaces[lo as usize].id == id {
        return scene.spaces[lo as usize];
    }
    return make CollisionSpace {
        id: id,
        root: 0u32,
        end: 0u32
    };
}
fn collision_point(v: MeshVertex) -> Vec3 {
    return vec(v.x, v.y, v.z);
}
fn collision_make_face(t: MeshTriangle) -> CollisionFace {
    var a: Vec3 = collision_point(t.vertices[0usize]);
    var b: Vec3 = collision_point(t.vertices[1usize]);
    var c: Vec3 = collision_point(t.vertices[2usize]);
    return make CollisionFace {
        a: a,
        b: b,
        c: c,
        normal: collision_normal(cross(sub(b, a), sub(c, a))),
        neighbours: make [u32; 3] {
            0xffffffffu32,
            0xffffffffu32,
            0xffffffffu32
        }
    };
}
fn collision_mesh_valid(mesh: read Mesh) -> bool {
    var i: u32 = 0u32;
    while i < mesh.count {
        var t: MeshTriangle = mesh.triangles[i as usize];
        var f: CollisionFace = collision_make_face(t);
        if !collision_finite(f.a) || !collision_finite(f.b) || !collision_finite(f.c) || !collision_finite(
            f.normal
        ) || dot(f.normal, f.normal) < 0.5f32 {
            return error("collision mesh needs finite, nondegenerate triangles");
        }
        if t.portal != 0u32 {
            return error("portal surfaces must be holes in collision meshes");
        }
        i = i + 1u32;
    }
    return true;
}
fn collision_grow_faces(data: *CollisionData, required: u32) -> bool {
    if required <= data -> face_capacity {
        return true;
    }
    var capacity: u64 = data -> face_capacity as u64 * 2u64 + 1u64;
    if capacity < required as u64 {
        capacity = required as u64;
    }
    if capacity > 0xffffffffu64 {
        capacity = 0xffffffffu64;
    }
    var faces: *CollisionFace = malloc(capacity as usize * sizeof(CollisionFace)) as *CollisionFace;
    if faces == null(*CollisionFace) {
        return error("collision face allocation failed");
    }
    if data -> face_count != 0u32 {
        memcpy(
            faces as *u8,
            data -> faces as *u8,
            data -> face_count as usize * sizeof(CollisionFace)
        );
    }
    free(data -> faces as *u8);
    data -> faces = faces;
    data -> face_capacity = capacity as u32;
    return true;
}
fn collision_grow_instances(data: *CollisionData) -> bool {
    if data -> instance_count < data -> instance_capacity {
        return true;
    }
    var capacity: u64 = data -> instance_capacity as u64 * 2u64 + 1u64;
    if capacity > 0xffffffffu64 {
        capacity = 0xffffffffu64;
    }
    var instances: *CollisionInstance = malloc(capacity as usize * sizeof(CollisionInstance)) as *CollisionInstance;
    if instances == null(*CollisionInstance) {
        return error("collision instance allocation failed");
    }
    if data -> instance_count != 0u32 {
        memcpy(
            instances as *u8,
            data -> instances as *u8,
            data -> instance_count as usize * sizeof(CollisionInstance)
        );
    }
    free(data -> instances as *u8);
    data -> instances = instances;
    data -> instance_capacity = capacity as u32;
    return true;
}
// Appends a rigid static instance. Failure preserves all prior instances.
fn collision_append(
    builder: mut CollisionBuilder,
    mesh: read Mesh,
    space: u32,
    origin: Vec3,
    basis: Basis
) -> bool {
    if !collision_finite(origin) || !collision_rigid(basis) {
        return error("invalid collision instance");
    }
    if !collision_mesh_valid(read mesh) {
        return false;
    }
    var total: u64 = builder.data.face_count as u64 + mesh.count as u64;
    if total > 0xffffffffu64 || builder.data.instance_count == 0xffffffffu32 {
        return error("collision storage exceeds address range");
    }
    if !collision_grow_faces(&builder.data, total as u32) || !collision_grow_instances(
        &builder.data
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < mesh.count {
        builder.data.faces[(builder.data.face_count + i) as usize] = collision_make_face(
            mesh.triangles[i as usize]
        );
        i = i + 1u32;
    }
    builder.data.instances[builder.data.instance_count as usize] = make CollisionInstance {
        controlled: false,
        motion_start: 0f32,
        motion_duration: 0f32,
        motion_offset: vec(0f32, 0f32, 0f32),
        motion_target: vec(0f32, 0f32, 0f32),
        solid: false,
        linear: vec(0f32, 0f32, 0f32),
        angular: vec(0f32, 0f32, 0f32),
        next_moving: 0xffffffffu32,
        first: builder.data.face_count,
        count: mesh.count,
        space: space,
        origin: origin,
        basis: basis,
        low: vec(mesh.bounds[0usize], mesh.bounds[1usize], mesh.bounds[2usize]),
        high: vec(mesh.bounds[3usize], mesh.bounds[4usize], mesh.bounds[5usize]),
        root: 0u32,
        end: 0u32
    };
    builder.data.face_count = total as u32;
    builder.data.instance_count = builder.data.instance_count + 1u32;
    return true;
}
// Consumes the builder. Success replaces the scene with immutable indexed geometry.
// Failure preserves the previous scene and releases the consumed construction data.
fn collision_finish(builder: CollisionBuilder, scene: mut CollisionScene) -> bool {
    var next: CollisionScene = collision_new();
    next.data = builder.data;
    builder.data = collision_empty_data();
    if !collision_portals_valid(read next) || !collision_index_build(&next) || !collision_portal_index_build(
        &next
    ) {
        return false;
    }
    collision_portal_support(mut next);
    scene = move next;
    return true;
}
fn collision_bytes(scene: read CollisionScene) -> u64 {
    var bytes: u64 = scene.data.face_capacity as u64 * sizeof(CollisionFace) as u64 + scene.data.instance_capacity as u64 * sizeof(
        CollisionInstance
    ) as u64;
    if scene.nodes != null(*CollisionNode) {
        bytes = bytes + (
            2u64 * (scene.data.face_count as u64 + scene.data.instance_count as u64) + 1u64
        ) * sizeof(CollisionNode) as u64;
    }
    if scene.spaces != null(*CollisionSpace) {
        bytes = bytes + (scene.data.instance_count as u64 + 1u64) * sizeof(CollisionSpace) as u64;
    }
    return bytes + scene.frame_capacity as u64 * sizeof(RoomFrameEntry) as u64 + scene.data.portal_count as u64 * (
        sizeof(CollisionPortal) + sizeof(CollisionPortalEntry)
    ) as u64;
}

// Appends a solid volume. Finish rejects open or inconsistently wound surfaces.
fn collision_append_solid(
    builder: mut CollisionBuilder,
    mesh: read Mesh,
    space: u32,
    origin: Vec3,
    basis: Basis
) -> bool {
    if mesh.count == 0u32 {
        return error("solid collision mesh is empty");
    }
    if !collision_append(mut builder, read mesh, space, origin, basis) {
        return false;
    }
    builder.data.instances[(builder.data.instance_count - 1u32) as usize].solid = true;
    return true;
}

fn collision_moving_head(scene: read CollisionScene) -> u32 {
    return scene.data.moving;
}
// Sets constant centre and angular velocities on the last appended instance.
// Call once per moving instance, before finish. Units are metres/s and radians/s.
fn collision_set_motion(builder: mut CollisionBuilder, linear: Vec3, angular: Vec3) -> bool {
    if builder.data.instance_count == 0u32 || !collision_finite(linear) || !collision_finite(
        angular
    ) || !collision_finite(vec(length(linear), length(angular), 0f32)) {
        return error("invalid kinematic velocity");
    }
    var index: u32 = builder.data.instance_count - 1u32;
    var item: *CollisionInstance = &builder.data.instances[index as usize];
    if collision_moving(*item) {
        return error("kinematic velocity already set");
    }
    item -> linear = linear;
    item -> angular = angular;
    if collision_moving(*item) {
        item -> next_moving = builder.data.moving;
        builder.data.moving = index;
    }
    return true;
}

// Reserves the last solid as a runtime-controlled translating body, including while stopped.
fn collision_controlled(builder: mut CollisionBuilder) -> unit {
    var index: u32 = builder.data.instance_count - 1u32;
    var item: *CollisionInstance = &builder.data.instances[index as usize];
    item -> controlled = true;
    item -> next_moving = builder.data.moving;
    builder.data.moving = index;
}
// Schedules one bounded translation from the body's reference pose.
// The controlled body has no rotation. Duration is positive; start is simulation time.
fn collision_slide(
    scene: mut CollisionScene,
    index: u32,
    start: f32,
    duration: f32,
    travel: Vec3
) -> unit {
    var item: *CollisionInstance = &scene.data.instances[index as usize];
    item -> motion_start = start;
    item -> motion_duration = duration;
    item -> motion_offset = vec(0f32, 0f32, 0f32);
    item -> motion_target = travel;
    item -> linear = scale(travel, 1f32 / duration);
}
fn collision_controlled_reset(scene: mut CollisionScene) -> unit {
    var index: u32 = scene.data.moving;
    while index != 0xffffffffu32 {
        var item: *CollisionInstance = &scene.data.instances[index as usize];
        if item -> controlled {
            item -> linear = vec(0f32, 0f32, 0f32);
            item -> motion_start = 0f32;
            item -> motion_duration = 0f32;
            item -> motion_offset = vec(0f32, 0f32, 0f32);
            item -> motion_target = vec(0f32, 0f32, 0f32);
        }
        index = item -> next_moving;
    }
}
// Copies runtime motion into an already allocated snapshot of the same scene.
fn collision_snapshot_motion(source: read CollisionScene, target: mut CollisionScene) -> unit {
    var index: u32 = source.data.moving;
    while index != 0xffffffffu32 {
        target.data.instances[index as usize] = source.data.instances[index as usize];
        index = source.data.instances[index as usize].next_moving;
    }
}

// Retargets a controlled translation without changing its current position.
// Target is relative to the reference origin. Duration must be positive.
fn collision_retarget(
    scene: mut CollisionScene,
    index: u32,
    time: f32,
    duration: f32,
    target: Vec3
) -> unit {
    var item: *CollisionInstance = &scene.data.instances[index as usize];
    var offset: Vec3 = sub(collision_pose(*item, time).origin, item -> origin);
    item -> motion_offset = offset;
    item -> motion_target = target;
    item -> motion_start = time;
    item -> motion_duration = duration;
    item -> linear = scale(sub(target, offset), 1f32 / duration);
}
