// The tested sphere range is 2^-12 through 2^12 room metres.
// Coordinate error must stay below one part in 256 of the radius.
fn collision_size_supported(radius: f32, bound: f32) -> bool {
    return radius >= 0.000244140625f32 && radius <= 4096f32 && bound * 0.0000005f32 <= radius * 0.00390625f32;
}
fn collision_link_supported(transform: SpaceTransform, extent: f32, radius: f32) -> bool {
    var square: f32 = transform.factor * transform.factor;
    var reach: f32 = length(transform.origin) + extent * transform.factor;
    return square > 0f32 && collision_finite(vec(square, 1f32 / square, reach * reach)) && reach * 0.0000005f32 <= radius * 0.00390625f32;
}
fn collision_portal_admitted(
    body: read CollisionBody,
    anchors: read RoomAnchors,
    parent: u32,
    portal: CollisionPortal
) -> bool {
    var link: Rational = portal_ratio(portal);
    var path: Rational = rational_product(room_anchor_ratio(read anchors, parent), read link);
    var size: Rational = rational_product(read body.size, read path);
    var radius: f32 = body.radius * rational_float(read size);
    if !collision_size_supported(radius, portal.support_bound) {
        return false;
    }
    var transform: SpaceTransform = space_compose(
        portal.transform,
        room_anchor(read anchors, parent).transform
    );
    transform.factor = rational_float(read path);
    if !collision_link_supported(transform, collision_body_radius(read body), radius) {
        return false;
    }
    if body.extent > 0f32 && !collision_link_supported(
        space_compose(transform, body.link),
        body.extent,
        radius
    ) {
        return false;
    }
    return true;
}
fn collision_scaled_child(
    scene: read CollisionScene,
    anchors: mut RoomAnchors,
    parent: u32,
    index: u32,
    body: read CollisionBody
) -> bool {
    var anchor: RoomAnchor = room_anchor(read anchors, parent);
    var portal: CollisionPortal = collision_portal(read scene, index);
    if !collision_portal_admitted(read body, read anchors, parent, portal) {
        anchor.cap = index;
        var ratio: Rational = rational_clone(room_anchor_ratio(read anchors, parent));
        return room_anchor_take(mut anchors, anchor, move ratio);
    }
    if anchor.depth == 1024u32 {
        return error("body portal overlap exceeds traversal budget");
    }
    var child: RoomAnchor = make RoomAnchor {
        cap: 0xffffffffu32,
        object: anchor.object,
        space: portal.destination,
        transform: space_compose(portal.transform, anchor.transform),
        parent: parent,
        portal: index,
        incoming: portal.reverse,
        depth: anchor.depth + 1u32
    };
    return room_anchor_link(mut anchors, child, portal);
}
fn collision_scaled_children(
    scene: read CollisionScene,
    anchors: mut RoomAnchors,
    parent: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    margin: bool
) -> bool {
    var anchor: RoomAnchor = room_anchor(read anchors, parent);
    if anchor.cap != 0xffffffffu32 {
        return true;
    }
    var start: Vec3 = space_point(anchor.transform, p);
    var travel: Vec3 = space_vector(anchor.transform, d);
    var radius: f32 = collision_placement_radius(read body, read anchors, parent);
    if margin {
        radius = radius + 2f32 * collision_tolerance(start, radius);
    }
    var cursor: u32 = collision_portal_begin(read scene, anchor.space);
    while collision_portal_at_space(read scene, cursor, anchor.space) {
        var i: u32 = collision_portal_id(read scene, cursor);
        var portal: CollisionPortal = collision_portal(read scene, i);
        if i != anchor.incoming && portal_reaches(portal, start, travel, radius) && !collision_scaled_child(
            read scene,
            mut anchors,
            parent,
            i,
            read body
        ) {
            return false;
        }
        cursor = cursor + 1u32;
    }
    return true;
}
fn collision_scaled_anchors(
    scene: read CollisionScene,
    anchors: mut RoomAnchors,
    space: u32,
    p: Vec3,
    d: Vec3,
    body: read CollisionBody,
    margin: bool
) -> bool {
    if !room_anchor_add(mut anchors, primary_anchor(0u32, space)) {
        return false;
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        if !collision_scaled_children(read scene, mut anchors, i, p, d, read body, margin) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}

const COLLISION_UNRESOLVED: u32 = 8u32;
record CollisionAdmission {
    status: u32;
    space: u32;
}
fn collision_ready() -> CollisionAdmission {
    return make CollisionAdmission {
        status: 0u32,
        space: 0u32
    };
}
fn collision_required(space: u32) -> CollisionAdmission {
    return make CollisionAdmission {
        status: COLLISION_UNRESOLVED,
        space: space
    };
}
fn collision_require_room(scene: read CollisionScene, space: u32) -> CollisionAdmission {
    if !collision_room_resident(read scene, space) {
        return collision_required(space);
    }
    return collision_ready();
}
fn collision_require_anchors(scene: read CollisionScene, anchors: read RoomAnchors) -> CollisionAdmission {
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        if anchor.cap == 0xffffffffu32 && !collision_room_resident(read scene, anchor.space) {
            return collision_required(anchor.space);
        }
        i = i + 1u32;
    }
    return collision_ready();
}
fn collision_required_sweep(space: u32) -> CollisionSweep {
    var result: CollisionSweep = collision_sweep_result(collision_miss(space));
    result.status = COLLISION_UNRESOLVED;
    return move result;
}

// Requires complete coverage for a non-speculative operation.
fn collision_require_complete(admission: CollisionAdmission) -> unit {
    if admission.status != 0u32 {
        error("collision operation requires resident rooms");
        trap;
    }
}
