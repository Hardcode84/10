fn clip_distance(base: u32, plane: u32, near: f32) -> f32 {
    var x: f32 = floats_load(base);
    var y: f32 = floats_load(base + 1u32);
    var z: f32 = floats_load(base + 2u32);
    if plane == 0u32 {
        return z - near;
    }
    if plane == 1u32 {
        return floats_load(base + 5u32);
    }
    var aspect: f32 = words_load(0u32) as f32 / words_load(1u32) as f32;
    if plane == 2u32 {
        return z * aspect + x;
    }
    if plane == 3u32 {
        return z * aspect - x;
    }
    if plane == 4u32 {
        return z + y;
    }
    return z - y;
}
fn clip_polygon(base: u32, count: u32, plane: u32, near: f32) -> u32 {
    var output: u32 = 0u32;
    var i: u32 = 0u32;
    while i < count {
        var a: u32 = base + i * 6u32;
        var b: u32 = base + ((i + 1u32) % count) * 6u32;
        var da: f32 = clip_distance(a, plane, near);
        var db: f32 = clip_distance(b, plane, near);
        var j: u32 = 0u32;
        if da >= 0f32 {
            while j < 6u32 {
                floats_store(base + 72u32 + output * 6u32 + j, floats_load(a + j));
                j = j + 1u32;
            }
            output = output + 1u32;
        }
        if (da < 0f32) != (db < 0f32) {
            var t: f32 = da / (da - db);
            j = 0u32;
            while j < 6u32 {
                var av: f32 = floats_load(a + j);
                floats_store(
                    base + 72u32 + output * 6u32 + j,
                    av + (floats_load(b + j) - av) * t
                );
                j = j + 1u32;
            }
            output = output + 1u32;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < output * 6u32 {
        floats_store(base + i, floats_load(base + 72u32 + i));
        i = i + 1u32;
    }
    return output;
}
fn prepare_triangle(index: u32) -> unit {
    var view: u32 = words_load(9u32) + index / MAX_TRIS;
    var tri: u32 = index % MAX_TRIS;
    var slot: u32 = view * MAX_TRIS + tri;
    var output: u32 = PROJECTED + slot * MAX_FAN * 20u32;
    var fan: u32 = 0u32;
    while fan < MAX_FAN {
        floats_store(output + fan * 20u32 + 18u32, 0f32);
        fan = fan + 1u32;
    }
    if tri >= words_load(3u32) || words_load(META + tri * 4u32) != words_load(
        VIEW_META + view * 4u32
    ) {
        return;
    }
    var scratch: u32 = CLIP + slot * 144u32;
    var matrix: u32 = VIEW_FLOAT + view * 16u32;
    var vertex: u32 = 0u32;
    while vertex < 3u32 {
        var source: u32 = GEOMETRY + tri * 15u32 + vertex * 5u32;
        var x: f32 = floats_load(source);
        var y: f32 = floats_load(source + 1u32);
        var z: f32 = floats_load(source + 2u32);
        var r: u32 = 0u32;
        while r < 3u32 {
            floats_store(
                scratch + vertex * 6u32 + r,
                floats_load(matrix + r * 4u32) * x + floats_load(matrix + r * 4u32 + 1u32) * y + floats_load(
                    matrix + r * 4u32 + 2u32
                ) * z + floats_load(matrix + r * 4u32 + 3u32)
            );
            r = r + 1u32;
        }
        floats_store(scratch + vertex * 6u32 + 3u32, floats_load(source + 3u32));
        floats_store(scratch + vertex * 6u32 + 4u32, floats_load(source + 4u32));
        floats_store(
            scratch + vertex * 6u32 + 5u32,
            floats_load(matrix + 12u32) * x + floats_load(matrix + 13u32) * y + floats_load(
                matrix + 14u32
            ) * z + floats_load(matrix + 15u32)
        );
        vertex = vertex + 1u32;
    }
    var count: u32 = 3u32;
    var near: f32 = 0.125f32;
    if words_load(META + tri * 4u32 + 2u32) != 0u32 {
        near = 0f32;
    }
    var plane: u32 = 0u32;
    while plane < 6u32 && count >= 3u32 {
        count = clip_polygon(scratch, count, plane, near);
        plane = plane + 1u32;
    }
    if count < 3u32 {
        return;
    }
    vertex = 0u32;
    while vertex < count {
        // A polygon through the eye has no projected area.
        if floats_load(scratch + vertex * 6u32 + 2u32) <= 0f32 {
            return;
        }
        vertex = vertex + 1u32;
    }
    fan = 0u32;
    while fan < count - 2u32 {
        vertex = 0u32;
        while vertex < 3u32 {
            var src: u32 = 0u32;
            if vertex > 0u32 {
                src = fan + vertex;
            }
            src = scratch + src * 6u32;
            var dst: u32 = output + fan * 20u32 + vertex * 6u32;
            var iz: f32 = 1f32 / floats_load(src + 2u32);
            var h: f32 = words_load(1u32) as f32 * 0.5f32;
            var px: f32 = words_load(0u32) as f32 * 0.5f32 + floats_load(src) * iz * h;
            var py: f32 = h - floats_load(src + 1u32) * iz * h;
            if (words_load(MATERIAL_STYLE + words_load(META + tri * 4u32 + 1u32)) & 4u32) != 0u32 {
                px = ((px + 0.5f32) as i32) as f32;
                py = ((py + 0.5f32) as i32) as f32;
            }
            floats_store(dst, px);
            floats_store(dst + 1u32, py);
            floats_store(dst + 2u32, iz);
            floats_store(dst + 3u32, floats_load(src + 3u32) * iz);
            floats_store(dst + 4u32, floats_load(src + 4u32) * iz);
            vertex = vertex + 1u32;
        }
        var p: u32 = output + fan * 20u32;
        var area: f32 = edge(
            floats_load(p),
            floats_load(p + 1u32),
            floats_load(p + 6u32),
            floats_load(p + 7u32),
            floats_load(p + 12u32),
            floats_load(p + 13u32)
        );
        if area < 0f32 {
            var c: u32 = 0u32;
            while c < 5u32 {
                var a: f32 = floats_load(p + 6u32 + c);
                floats_store(p + 6u32 + c, floats_load(p + 12u32 + c));
                floats_store(p + 12u32 + c, a);
                c = c + 1u32;
            }
            area = 0f32 - area;
        }
        floats_store(p + 18u32, area);
        fan = fan + 1u32;
    }
}
fn compute() -> unit {
    var i: u32 = shader_global_x();
    if words_load(5u32) == 0u32 && i < words_load(10u32) * MAX_TRIS {
        prepare_triangle(i);
    }
}
