fn perspective_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, x, y);
    var b: f32 = edge(cx, cy, ax, ay, x, y);
    var c: f32 = edge(ax, ay, bx, by, x, y);
    return (
        a * floats_load(p + offset) + b * floats_load(p + 6u32 + offset) + c * floats_load(
            p + 12u32 + offset
        )
    ) / (
        a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(p + 14u32)
    );
}
fn span_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var left: f32 = 100000f32;
    var right: f32 = -100000f32;
    var i: u32 = 0u32;
    while i < 3u32 {
        var a: u32 = p + i * 6u32;
        var b: u32 = p + ((i + 1u32) % 3u32) * 6u32;
        var ay: f32 = floats_load(a + 1u32);
        var by: f32 = floats_load(b + 1u32);
        if (ay <= y && by > y) || (by <= y && ay > y) {
            var xx: f32 = floats_load(a) + (floats_load(b) - floats_load(a)) * (y - ay) / (
                by - ay
            );
            if xx < left {
                left = xx;
            }
            if xx > right {
                right = xx;
            }
        }
        i = i + 1u32;
    }
    var a: f32 = ((x as u32 / 8u32) * 8u32) as f32 + 0.5f32;
    var b: f32 = a + 8f32;
    if a < left {
        a = left;
    }
    if b > right {
        b = right;
    }
    if b <= a {
        return perspective_sample(p, x, y, offset);
    }
    var av: f32 = perspective_sample(p, a, y, offset);
    var bv: f32 = perspective_sample(p, b, y, offset);
    return av + (bv - av) * (x - a) / (b - a);
}
fn sample_uv(p: u32, x: f32, y: f32, offset: u32, style: u32) -> f32 {
    if style == 2u32 {
        return span_sample(p, x, y, offset);
    }
    var a: f32 = edge(
        floats_load(p + 6u32),
        floats_load(p + 7u32),
        floats_load(p + 12u32),
        floats_load(p + 13u32),
        x,
        y
    );
    var b: f32 = edge(
        floats_load(p + 12u32),
        floats_load(p + 13u32),
        floats_load(p),
        floats_load(p + 1u32),
        x,
        y
    );
    var c: f32 = edge(
        floats_load(p),
        floats_load(p + 1u32),
        floats_load(p + 6u32),
        floats_load(p + 7u32),
        x,
        y
    );
    if style == 1u32 {
        return (
            a * floats_load(p + offset) / floats_load(p + 2u32) + b * floats_load(
                p + 6u32 + offset
            ) / floats_load(p + 8u32) + c * floats_load(p + 12u32 + offset) / floats_load(
                p + 14u32
            )
        ) / floats_load(p + 18u32);
    }
    var area: f32 = floats_load(p + 18u32);
    var iz: f32 = (
        a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(p + 14u32)
    ) / area;
    return (
        a * floats_load(p + offset) + b * floats_load(p + 6u32 + offset) + c * floats_load(
            p + 12u32 + offset
        )
    ) / (area * iz);
}
fn tile_overlap(p: u32, x: f32, y: f32) -> bool {
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    return!(ax < x && bx < x && cx < x) &&!(ay < y && by < y && cy < y) &&!(
        ax > x + 8f32 && bx > x + 8f32 && cx > x + 8f32
    ) &&!(ay > y + 8f32 && by > y + 8f32 && cy > y + 8f32);
}
fn bin_tile(task: u32, lane: u32, fill: bool) -> unit {
    var base: u32 = task_base() + task * 4u32;
    var tile: u32 = words_load(base);
    var view: u32 = words_load(base + 1u32);
    var cols: u32 = (words_load(0u32) + 7u32) / 8u32;
    var x: f32 = (tile % cols * 8u32) as f32;
    var y: f32 = (tile / cols * 8u32) as f32;
    var count: u32 = 0u32;
    var offset: u32 = 0u32;
    if fill {
        var j: u32 = 0u32;
        while j < 64u32 {
            var n: u32 = shared_load(384u32 + j) as u32;
            if j < lane {
                offset = offset + n;
            }
            count = count + n;
            j = j + 1u32;
        }
        if lane == 0u32 {
            shared_store(256u32, count as f32);
            words_store(TASK_ERRORS + task, 0u32);
        }
        if count > 256u32 {
            if lane == 0u32 {
                shared_store(256u32, 0f32);
                words_store(TASK_ERRORS + task, 1u32);
            }
            return;
        }
    }
    count = 0u32;
    var i: u32 = lane;
    var length: u32 = words_load(COMPACT_COUNT + view);
    if words_load(25u32) != 0u32 {
        length = words_load(3u32) * MAX_FAN;
    }
    while i < length {
        var id: u32 = i;
        if words_load(25u32) == 0u32 {
            id = words_load(COMPACT_LIST + view * MAX_TRIS * MAX_FAN + i);
        }
        var p: u32 = PROJECTED + (view * MAX_TRIS * MAX_FAN + id) * 20u32;
        if floats_load(p + 18u32) > 0f32 && tile_overlap(p, x, y) {
            if fill {
                shared_store(offset + count, id as f32);
            }
            count = count + 1u32;
        }
        i = i + 64u32;
    }
    if !fill {
        shared_store(384u32 + lane, count as f32);
    }
}
fn raster_pixel(task: u32, lane: u32) -> unit {
    var base: u32 = task_base() + task * 4u32;
    var tile: u32 = words_load(base);
    var view: u32 = words_load(base + 1u32);
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    shared_store(320u32 + lane, 0f32);
    if x >= width || y >= words_load(1u32) || (
        words_load(base + 2u32 + lane / 32u32) & (1u32 << (lane % 32u32))
    ) == 0u32 {
        return;
    }
    var best: f32 = 0f32;
    var winner: u32 = 0xffffffffu32;
    var winner_id: u32 = 0xffffffffu32;
    var uu: f32 = 0f32;
    var vv: f32 = 0f32;
    var i: u32 = 0u32;
    var px: f32 = x as f32 + 0.5f32;
    var py: f32 = y as f32 + 0.5f32;
    while i < shared_load(256u32) as u32 {
        var id: u32 = shared_load(i) as u32;
        var p: u32 = PROJECTED + (view * MAX_TRIS * MAX_FAN + id) * 20u32;
        var ax: f32 = floats_load(p);
        var ay: f32 = floats_load(p + 1u32);
        var bx: f32 = floats_load(p + 6u32);
        var by: f32 = floats_load(p + 7u32);
        var cx: f32 = floats_load(p + 12u32);
        var cy: f32 = floats_load(p + 13u32);
        var a: f32 = edge(bx, by, cx, cy, px, py);
        var b: f32 = edge(cx, cy, ax, ay, px, py);
        var c: f32 = edge(ax, ay, bx, by, px, py);
        if inside(a, bx, by, cx, cy) && inside(b, cx, cy, ax, ay) && inside(c, ax, ay, bx, by) {
            var area: f32 = floats_load(p + 18u32);
            var iz: f32 = (
                a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(p + 14u32)
            ) / area;
            if iz > best || (iz == best && id < winner_id) {
                var cutout: bool = words_load(META + (id / MAX_FAN) * 4u32 + 3u32) != 0u32;
                var opaque: bool = true;
                if cutout {
                    var style: u32 = words_load(
                        MATERIAL_STYLE + words_load(META + (id / MAX_FAN) * 4u32 + 1u32)
                    ) & 3u32;
                    var u: f32 = sample_uv(p, px, py, 3u32, style);
                    var v: f32 = sample_uv(p, px, py, 4u32, style);
                    var tex: u32 = (((u * 8f32) as i32 as u32) & 7u32) + (
                        (((v * 8f32) as i32 as u32) & 7u32) * 8u32
                    );
                    opaque = words_load(TEXTURE + tex) != 0u32;
                }
                if opaque {
                    best = iz;
                    winner = id / MAX_FAN;
                    winner_id = id;
                }
            }
        }
        i = i + 1u32;
    }
    var color: u32 = 0xff463026u32;
    if winner != 0xffffffffu32 {
        var mat: u32 = words_load(META + winner * 4u32 + 1u32);
        var p: u32 = PROJECTED + (view * MAX_TRIS * MAX_FAN + winner_id) * 20u32;
        var style: u32 = words_load(MATERIAL_STYLE + mat) & 3u32;
        uu = sample_uv(p, px, py, 3u32, style);
        vv = sample_uv(p, px, py, 4u32, style);
        var portal: u32 = words_load(META + winner * 4u32 + 2u32);
        if portal != 0u32 && words_load(12u32) < words_load(4u32) {
            shared_store(320u32 + lane, portal as f32);
        }
        color = light_color(mat, uu, vv, 1f32 / best, x, y);
    }
    if words_load(26u32) != 0u32 {
        var debug: u32 = DEBUG_VALUES + (y * width + x) * 4u32;
        words_store(debug, winner + view * 256u32);
        words_store(debug + 1u32, (uu * 10000f32) as i32 as u32);
        words_store(debug + 2u32, (vv * 10000f32) as i32 as u32);
        words_store(debug + 3u32, (10000f32 / best) as u32);
    }
    words_store(PIXELS + y * width + x, color);
}
fn child_masks(task: u32, portal: u32) -> unit {
    var lo: u32 = 0u32;
    var hi: u32 = 0u32;
    var lane: u32 = 0u32;
    while lane < 64u32 {
        if shared_load(320u32 + lane) as u32 == portal {
            if lane < 32u32 {
                lo = lo | (1u32 << lane);
            } else {
                hi = hi | (1u32 << (lane - 32u32));
            }
        }
        lane = lane + 1u32;
    }
    var out: u32 = CANDIDATES + (task * MAX_PORTALS + portal - 1u32) * 2u32;
    words_store(out, lo);
    words_store(out + 1u32, hi);
}
fn compute() -> unit {
    var lane: u32 = shader_local_x();
    var task: u32 = shader_global_x() / 64u32;
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        bin_tile(task, lane, false);
    }
    shader_barrier();
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        bin_tile(task, lane, true);
    }
    shader_barrier();
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        raster_pixel(task, lane);
    }
    shader_barrier();
    if lane < MAX_PORTALS && task < words_load(6u32) && words_load(5u32) == 0u32 {
        child_masks(task, lane + 1u32);
    }
}
