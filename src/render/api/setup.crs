record DeferredGeometry {
    first: u32;
    capacity: u32;
}
opaque;
// Reserves inactive, non-shadow-casting triangles before retained instances.
// The reservation remains at the same addresses until the frame retires.
fn input_defer(input: mut FrameInput, capacity: u32) -> DeferredGeometry {
    var first: u32 = input_word(read input, 3usize);
    var end: u64 = first as u64 + capacity as u64;
    if end > 0xffffffffu64 || !input_reserve_triangles(mut input, end as u32) {
        error("deferred geometry reservation failed");
        exit(1i32);
    }
    var i: u32 = first;
    while i < end as u32 {
        var meta: usize = (input_word(read input, META as usize) + i * 4u32) as usize;
        input_set_word(mut input, meta, input_word(read input, 20usize));
        input_set_word(mut input, meta + 1usize, 0u32);
        input_set_word(mut input, meta + 2usize, 0u32);
        input_set_word(mut input, meta + 3usize, TRIANGLE_NO_SHADOW | TRIANGLE_INACTIVE);
        var j: u32 = 0u32;
        while j < 15u32 {
            input_set_float(mut input, (GEOMETRY + i * 15u32 + j) as usize, 0f32);
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    input_set_word(mut input, 3usize, end as u32);
    return make DeferredGeometry {
        first: first,
        capacity: capacity
    };
}
resource FrameSetup {
    storage: mut RenderState;
    range: DeferredGeometry;
    outcome: i32;
}
opaque drop frame_setup_drop;
// Starts shadow preparation. Holds all frame storage until scope exit.
fn frame_setup(renderer: mut Renderer, range: DeferredGeometry) -> FrameSetup from renderer {
    var v: *RenderState = &renderer.state;
    var accepted: bool = deferred_geometry_valid(v, range) && retirement_observer_open(v) && renderer_prepare(
        v,
        range.capacity
    ) && command_reset(v) && command_begin(v);
    if accepted {
        commands_setup_body(v);
        accepted = command_end(v) && dispatch_submit(v);
    }
    if accepted {
        retirement_observer_start(v);
    }
    return make FrameSetup {
        storage: mut renderer.state,
        range: range,
        outcome: -((!accepted) as i32)
    };
}
fn frame_setup_accepted(setup: read FrameSetup) -> bool {
    return setup.outcome >= 0i32;
}
fn frame_setup_drop(setup: mut FrameSetup) -> unit {
    retirement_wait(&setup.storage);
}
resource DeferredInput {
    input: FrameInput;
    total: u32;
    first: u32;
}
opaque drop deferred_input_drop;
// Requires accepted setup. Waits for setup retirement before lending the reserved range.
// Write only non-shadow-casting, non-portal triangles into this range.
fn frame_setup_edit(setup: mut FrameSetup) -> DeferredInput from setup {
    if setup.outcome < 0i32 {
        trap;
    }
    while frame_setup_poll(mut setup) == 0i32 {
        frame_setup_idle(mut setup);
    }
    if setup.outcome != 1i32 {
        trap;
    }
    var w: *u32 = setup.storage.mapped as *u32;
    var total: u32 = w[3usize];
    w[3usize] = setup.range.first;
    return make DeferredInput {
        input: make FrameInput {
            storage: mut setup.storage,
            triangle_limit: setup.range.first + setup.range.capacity
        },
        total: total,
        first: setup.range.first
    };
}
fn deferred_inputs(edit: mut DeferredInput) -> mut FrameInput from edit {
    return mut edit.input;
}
fn deferred_input_drop(edit: mut DeferredInput) -> unit {
    var w: *u32 = edit.input.storage.mapped as *u32;
    var i: u32 = edit.first;
    while i < w[3usize] {
        var meta: u32 = w[META as usize] + i * 4u32;
        if w[(meta + 2u32) as usize] != 0u32 || (
            w[(meta + 3u32) as usize] & TRIANGLE_NO_SHADOW
        ) == 0u32 {
            trap;
        }
        i = i + 1u32;
    }
    w[3usize] = edit.total;
}
// Requires accepted setup and a completed late write. Submits the remaining frame work.
fn frame_setup_submit(setup: mut FrameSetup) -> SubmittedFrame from setup {
    var v: *RenderState = &setup.storage;
    retirement_wait(v);
    projection_members(v);
    if projection_spaces(v) > v -> projection_capacity {
        trap;
    }
    var accepted: bool = setup.outcome == 1i32 && render_numeric_bounds(v) && retirement_observer_open(
        v
    ) && command_reset(v) && command_continue(v);
    if accepted {
        upload_scene(v);
        command_barrier(v, BARRIER_UPLOAD);
        commands_raster_body(v);
        accepted = command_end(v) && dispatch_submit(v);
    }
    if accepted {
        retirement_observer_start(v);
    }
    return make SubmittedFrame {
        storage: mut setup.storage,
        outcome: -((!accepted) as i32)
    };
}

// Returns pending, successful retirement, or failure as zero, one, or minus one.
fn frame_setup_poll(setup: mut FrameSetup) -> i32 {
    if setup.outcome == 0i32 {
        setup.outcome = retirement_poll(&setup.storage);
    }
    return setup.outcome;
}
fn frame_setup_idle(setup: mut FrameSetup) -> unit {
    retirement_idle(&setup.storage);
}

fn deferred_geometry_valid(v: *RenderState, range: DeferredGeometry) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var limit: u32 = w[3usize];
    if w[INSTANCE_COUNT as usize] != 0u32 {
        limit = w[DYNAMIC_COUNT as usize];
    }
    var end: u64 = range.first as u64 + range.capacity as u64;
    if end > limit as u64 {
        return error("deferred geometry reservation is outside this frame");
    }
    var i: u32 = range.first;
    while i < end as u32 {
        var meta: u32 = w[META as usize] + i * 4u32;
        if w[(meta + 2u32) as usize] != 0u32 || w[(meta + 3u32) as usize] != (
            TRIANGLE_INACTIVE | TRIANGLE_NO_SHADOW
        ) {
            return error("deferred geometry reservation is no longer inactive");
        }
        i = i + 1u32;
    }
    return true;
}
