// Shared buffer layout. All offsets and lengths count four-byte elements.
const PIXELS: u32 = 8192u32;
const PALETTE: u32 = 256u32;
const TEXTURE: u32 = 64u32;
const MAX_TRIS: u32 = 256u32;
const MAX_VIEWS: u32 = 32u32;
const MAX_TASKS: u32 = 32768u32;
const MAX_PORTALS: u32 = 4u32;
const MAX_FAN: u32 = 8u32;
const META: u32 = 2106000u32;
const TASK_A: u32 = 2108000u32;
const TASK_B: u32 = 2239072u32;
const CANDIDATES: u32 = 2370144u32;
const VIEW_MAP: u32 = 2633000u32;
const VIEW_META: u32 = 2634000u32;
const PORTAL_META: u32 = 2635000u32;
const VIEW_FLOAT: u32 = 64u32;
const PORTAL_FLOAT: u32 = 600u32;
const GEOMETRY: u32 = 1024u32;
const PROJECTED: u32 = 8192u32;
const CLIP: u32 = 1320000u32;
const LOCAL_SIZE: u32 = 64u32;
const MAX_INVOCATIONS: u32 = 2097152u32;
const WORDS_LENGTH: u32 = 16777216u32;
const FLOATS_LENGTH: u32 = 4194304u32;
const PRESENT_PIXELS: u32 = 5000000u32;
const MATERIAL_STYLE: u32 = 2635200u32;
const TASK_ERRORS: u32 = 2636000u32;
const COMPACT_COUNT: u32 = 2790000u32;
const COMPACT_LIST: u32 = 2800000u32;
const TASK_PREFIX: u32 = 2900000u32;
const GROUP_COUNTS: u32 = 2940000u32;
const GROUP_PREFIX: u32 = 2950000u32;
const DEBUG_VALUES: u32 = 8000000u32;

// Caller-supplied scene appearance. Colours are packed RGBA; style values are floats.
const BACKGROUND: u32 = 34u32;
const RENDER_STYLE: u32 = 16u32;

// Light records contain local position, radius squared, RGB intensity, and space.
const LIGHT_COUNT: u32 = 35u32;
const LIGHT_MODEL: u32 = 36u32;
const MAX_MATERIALS: u32 = 20u32;
const MAX_LIGHTS: u32 = 8u32;
const LIGHT_DATA: u32 = 704u32;
const MATERIAL_LIGHT: u32 = 800u32;
const SPACE_LIGHT: u32 = 880u32;
const MATERIAL_TEXTURE: u32 = 2700000u32;
// Camera light: radius squared (zero disables), followed by non-negative RGB intensity.
const CAMERA_LIGHT: u32 = 1008u32;

const LIT_PALETTE: u32 = 2702048u32;

// Positive tangent of half the vertical field of view; setup defaults to 1.
const PROJECTION: u32 = 20u32;
// Optional 80 by 6 text cells, eight pixels square, at the output top edge.
const OVERLAY_ENABLED: u32 = 37u32;
const OVERLAY_CELLS: u32 = 2750000u32;
const OVERLAY_FONT: u32 = 2751000u32;
// Overlay foreground and background colours, supplied by the caller.
const OVERLAY_COLOR: u32 = 38u32;

// Integer text pixel scale; zero and one both select the native glyph size.
const OVERLAY_SCALE: u32 = 40u32;
