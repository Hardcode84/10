fn commands_create(v: *Vulkan) -> bool {
    var pool: VkCommandPoolCreateInfo = uninit;
    zero(&pool as *u8, sizeof(VkCommandPoolCreateInfo));
    pool.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
    pool.queueFamilyIndex = v -> family;
    pool.flags = 2u32;
    if !vk_ok(
        vkCreateCommandPool(v -> device, &pool, null(*u8), &v -> command_pool),
        "vkCreateCommandPool"
    ) {
        return false;
    }
    var info: VkCommandBufferAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkCommandBufferAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    info.commandPool = v -> command_pool;
    info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
    info.commandBufferCount = 1u32;
    return retirement_create(v) && vk_ok(
        vkAllocateCommandBuffers(v -> device, &info, &v -> commands),
        "vkAllocateCommandBuffers"
    );
}

fn commands_record(v: *Vulkan) -> bool {
    var begin: VkCommandBufferBeginInfo = uninit;
    zero(&begin as *u8, sizeof(VkCommandBufferBeginInfo));
    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    if !vk_ok(vkBeginCommandBuffer(v -> commands, &begin), "vkBeginCommandBuffer") {
        return false;
    }
    vkCmdResetQueryPool(v -> commands, v -> query_pool, 0u32, v -> query_count);
    vkCmdWriteTimestamp(v -> commands, 1u32, v -> query_pool, 0u32);
    upload_scene(v);
    if v -> shader_checks {
        vkCmdFillBuffer(
            v -> commands,
            v -> buffer,
            (v -> words as u64 + v -> floats as u64 + 2u64) * 4u64,
            MAX_INVOCATIONS as u64 * 4u64,
            0u32
        );
    }
    frame_barrier(v, 4096u32, 0x1000u32, 2048u32, 96u32);
    vkCmdBindDescriptorSets(
        v -> commands,
        VK_PIPELINE_BIND_POINT_COMPUTE,
        v -> pipeline_layout,
        0u32,
        1u32,
        &v -> set,
        0u32,
        null(*u32)
    );
    retained_dispatch(v, 8usize, v -> instance_capacity);
    frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
    retained_dispatch(v, 0usize, (v -> width * v -> height + 63u32) / 64u32);
    frame_barrier(v, 2048u32, 64u32, 2048u32 | 2u32, 96u32 | 1u32);
    vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, 1u32);
    var depth: u32 = 0u32;
    while depth <= v -> crossing_limit {
        retained_dispatch(
            v,
            9usize,
            (v -> instance_capacity * v -> view_capacity + 63u32) / 64u32
        );
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdBindPipeline(
            v -> commands,
            VK_PIPELINE_BIND_POINT_COMPUTE,
            v -> pipelines[1usize]
        );
        vkCmdDispatchIndirect(v -> commands, v -> buffer, 68u64);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, 2u32 + depth * 4u32);
        compact_dispatch(v);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, 3u32 + depth * 4u32);
        task_dispatch(v, 10usize, 0u32);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        task_dispatch(v, 2usize, 0u32);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, 4u32 + depth * 4u32);
        task_dispatch(v, 6usize, 3u32);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdBindPipeline(
            v -> commands,
            VK_PIPELINE_BIND_POINT_COMPUTE,
            v -> pipelines[3usize]
        );
        vkCmdDispatch(v -> commands, 1u32, 1u32, 1u32);
        frame_barrier(v, 2048u32, 64u32, 2048u32 | 2u32, 96u32 | 1u32);
        task_dispatch(v, 7usize, 6u32);
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, 5u32 + depth * 4u32);
        depth = depth + 1u32;
    }
    retained_dispatch(v, 4usize, (v -> output_width * v -> output_height + 63u32) / 64u32);
    frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
    if v -> shader_checks {
        retained_dispatch(v, 11usize, STATUS_GROUPS);
    }
    var barrier: VkMemoryBarrier = uninit;
    zero(&barrier as *u8, sizeof(VkMemoryBarrier));
    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
    barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
    barrier.dstAccessMask = 2048u32;
    vkCmdPipelineBarrier(
        v -> commands,
        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        VK_PIPELINE_STAGE_HOST_BIT | 4096u32,
        0u32,
        1u32,
        &barrier,
        0u32,
        null(*u8),
        0u32,
        null(*VkImageMemoryBarrier)
    );
    vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, v -> query_count - 2u32);
    readback(v);
    vkCmdWriteTimestamp(v -> commands, 8192u32, v -> query_pool, v -> query_count - 1u32);
    return vk_ok(vkEndCommandBuffer(v -> commands), "vkEndCommandBuffer");
}
fn dispatch(v: *Vulkan) -> bool {
    if !dispatch_submit(v) {
        return false;
    }
    retirement_wait(v);
    return true;
}
fn dispatch_submit(v: *Vulkan) -> bool {
    retirement_wait(v);
    var submit: VkSubmitInfo = uninit;
    zero(&submit as *u8, sizeof(VkSubmitInfo));
    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
    submit.commandBufferCount = 1u32;
    submit.pCommandBuffers = &v -> commands;
    if !vk_ok(
        vkResetFences(v -> device, 1u32, &v -> retired),
        "reset renderer retirement fence"
    ) || !vk_ok(vkQueueSubmit(v -> queue, 1u32, &submit, v -> retired), "vkQueueSubmit") {
        return false;
    }
    v -> submitted = true;
    return true;
}
fn device_close(v: *Vulkan) -> unit {
    if v -> device != null(*u8) {
        retirement_close(v);
        if v -> queue != null(*u8) && !vk_ok(
            vkQueueWaitIdle(v -> queue),
            "wait before device close"
        ) {
            exit(1i32);
        }
        if v -> query_pool != null(*u8) {
            vkDestroyQueryPool(v -> device, v -> query_pool, null(*u8));
        }
        if v -> acquired != null(*u8) {
            vkDestroyFence(v -> device, v -> acquired, null(*u8));
        }
        swapchain_close(v);
        if v -> command_pool != null(*u8) {
            vkDestroyCommandPool(v -> device, v -> command_pool, null(*u8));
        }
        if v -> pool != null(*u8) {
            vkDestroyDescriptorPool(v -> device, v -> pool, null(*u8));
        }
        var i: usize = 0usize;
        while i < PIPELINE_COUNT as usize {
            if v -> pipelines[i] != null(*u8) {
                vkDestroyPipeline(v -> device, v -> pipelines[i], null(*u8));
            }
            if v -> modules[i] != null(*u8) {
                vkDestroyShaderModule(v -> device, v -> modules[i], null(*u8));
            }
            i = i + 1usize;
        }
        if v -> pipeline_layout != null(*u8) {
            vkDestroyPipelineLayout(v -> device, v -> pipeline_layout, null(*u8));
        }
        if v -> layout != null(*u8) {
            vkDestroyDescriptorSetLayout(v -> device, v -> layout, null(*u8));
        }
        buffers_close(v);
        vkDestroyDevice(v -> device, null(*u8));
    }
    if v -> surface != null(*u8) {
        vkDestroySurfaceKHR(v -> instance, v -> surface, null(*u8));
    }
    if v -> instance != null(*u8) {
        vkDestroyInstance(v -> instance, null(*u8));
    }
}

fn frame_barrier(
    v: *Vulkan,
    source_stage: u32,
    source_access: u32,
    dest_stage: u32,
    dest_access: u32
) -> unit {
    var b: VkMemoryBarrier = uninit;
    zero(&b as *u8, sizeof(VkMemoryBarrier));
    b.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
    b.srcAccessMask = source_access;
    b.dstAccessMask = dest_access;
    vkCmdPipelineBarrier(
        v -> commands,
        source_stage,
        dest_stage,
        0u32,
        1u32,
        &b,
        0u32,
        null(*u8),
        0u32,
        null(*VkImageMemoryBarrier)
    );
}

fn task_dispatch(v: *Vulkan, pipeline: usize, field: u32) -> unit {
    vkCmdBindPipeline(
        v -> commands,
        VK_PIPELINE_BIND_POINT_COMPUTE,
        v -> pipelines[pipeline]
    );
    var base: u32 = 0u32;
    var batch: u32 = 0u32;
    var commands: u32 = (v -> mapped as *u32)[TASK_COMMANDS as usize];
    while base < v -> task_capacity {
        frame_barrier(v, 2048u32 | 4096u32, 96u32 | 4096u32, 4096u32, 4096u32);
        vkCmdUpdateBuffer(
            v -> commands,
            v -> buffer,
            (DISPATCH_BASE as u64 + 1u64) * 4u64,
            4u64,
            &base as *u8
        );
        frame_barrier(v, 4096u32 | 2048u32, 4096u32 | 64u32, 2048u32 | 2u32, 32u32 | 1u32);
        vkCmdDispatchIndirect(
            v -> commands,
            v -> buffer,
            (commands as u64 + 1u64 + batch as u64 * 9u64 + field as u64) * 4u64
        );
        base = base + MAX_INVOCATIONS / LOCAL_SIZE;
        batch = batch + 1u32;
    }
}

fn compact_dispatch(v: *Vulkan) -> unit {
    var base: u32 = 0u32;
    while base < v -> view_capacity {
        var count: u32 = v -> view_capacity - base;
        if count > MAX_INVOCATIONS / LOCAL_SIZE {
            count = MAX_INVOCATIONS / LOCAL_SIZE;
        }
        frame_barrier(v, 2048u32 | 4096u32, 96u32 | 4096u32, 4096u32, 4096u32);
        vkCmdUpdateBuffer(
            v -> commands,
            v -> buffer,
            (DISPATCH_BASE as u64 + 1u64) * 4u64,
            4u64,
            &base as *u8
        );
        frame_barrier(v, 4096u32, 4096u32, 2048u32, 32u32);
        retained_dispatch(v, 5usize, count);
        base = base + count;
    }
}
