fn buffers_close(v: *Vulkan) -> unit {
    if v -> mapped != null(*u8) {
        vkUnmapMemory(v -> device, v -> staging_memory);
    }
    if v -> staging != null(*u8) {
        vkDestroyBuffer(v -> device, v -> staging, null(*u8));
    }
    if v -> staging_memory != null(*u8) {
        vkFreeMemory(v -> device, v -> staging_memory, null(*u8));
    }
    if v -> buffer != null(*u8) {
        vkDestroyBuffer(v -> device, v -> buffer, null(*u8));
    }
    if v -> memory != null(*u8) {
        vkFreeMemory(v -> device, v -> memory, null(*u8));
    }
}
