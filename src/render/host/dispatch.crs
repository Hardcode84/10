fn buffers_close(v: *RenderState) -> unit {
    if v -> mapped != null(*u8) {
        vkUnmapMemory(v -> gpu.device, v -> gpu.staging_memory);
    }
    if v -> staging != null(*u8) {
        vkDestroyBuffer(v -> gpu.device, v -> staging, null(*u8));
    }
    if v -> gpu.staging_memory != null(*u8) {
        vkFreeMemory(v -> gpu.device, v -> gpu.staging_memory, null(*u8));
    }
    if v -> buffer != null(*u8) {
        vkDestroyBuffer(v -> gpu.device, v -> buffer, null(*u8));
    }
    if v -> gpu.memory != null(*u8) {
        vkFreeMemory(v -> gpu.device, v -> gpu.memory, null(*u8));
    }
}
// SPDX-License-Identifier: Apache-2.0

fn commands_create(v: *RenderState) -> bool {
    var pool: VkCommandPoolCreateInfo = uninit;
    zero(&pool as *u8, sizeof(VkCommandPoolCreateInfo));
    pool.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
    pool.queueFamilyIndex = v -> gpu.family;
    pool.flags = 2u32;
    if !vk_ok(
        vkCreateCommandPool(
            v -> gpu.device,
            &pool,
            null(*u8),
            &v -> gpu.command_pool
        ),
        "vkCreateCommandPool"
    ) {
        return false;
    }
    var info: VkCommandBufferAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkCommandBufferAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    info.commandPool = v -> gpu.command_pool;
    info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
    info.commandBufferCount = 1u32;
    return retirement_create(v) && vk_ok(
        vkAllocateCommandBuffers(v -> gpu.device, &info, &v -> gpu.commands),
        "vkAllocateCommandBuffers"
    );
}

fn dispatch(v: *RenderState) -> bool {
    if !dispatch_submit(v) {
        return false;
    }
    retirement_wait(v);
    return true;
}
fn dispatch_submit(v: *RenderState) -> bool {
    retirement_wait(v);
    var submit: VkSubmitInfo = uninit;
    zero(&submit as *u8, sizeof(VkSubmitInfo));
    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
    submit.commandBufferCount = 1u32;
    submit.pCommandBuffers = &v -> gpu.commands;
    if !vk_ok(
        vkResetFences(v -> gpu.device, 1u32, &v -> gpu.retired),
        "reset renderer retirement fence"
    ) || !vk_ok(
        vkQueueSubmit(v -> gpu.queue, 1u32, &submit, v -> gpu.retired),
        "vkQueueSubmit"
    ) {
        return false;
    }
    v -> submitted = true;
    v -> frame_submit_ns = render_now();
    return true;
}
fn device_close(v: *RenderState) -> unit {
    render_bounds_close(v);
    if v -> gpu.device != null(*u8) {
        retirement_close(v);
        service_destroy(v -> gpu.observer);
        if v -> gpu.queue != null(*u8) && !vk_ok(
            vkQueueWaitIdle(v -> gpu.queue),
            "wait before device close"
        ) {
            exit(1i32);
        }
        queries_close(v);
        if v -> gpu.acquired != null(*u8) {
            vkDestroyFence(v -> gpu.device, v -> gpu.acquired, null(*u8));
        }
        swapchain_close(v);
        if v -> gpu.command_pool != null(*u8) {
            vkDestroyCommandPool(v -> gpu.device, v -> gpu.command_pool, null(*u8));
        }
        if v -> gpu.pool != null(*u8) {
            vkDestroyDescriptorPool(v -> gpu.device, v -> gpu.pool, null(*u8));
        }
        var i: usize = 0usize;
        while i < PIPELINE_COUNT as usize {
            if v -> gpu.pipelines[i] != null(*u8) {
                vkDestroyPipeline(v -> gpu.device, v -> gpu.pipelines[i], null(*u8));
            }
            if v -> gpu.modules[i] != null(*u8) {
                vkDestroyShaderModule(
                    v -> gpu.device,
                    v -> gpu.modules[i],
                    null(*u8)
                );
            }
            i = i + 1usize;
        }
        if v -> gpu.pipeline_layout != null(*u8) {
            vkDestroyPipelineLayout(
                v -> gpu.device,
                v -> gpu.pipeline_layout,
                null(*u8)
            );
        }
        if v -> gpu.layout != null(*u8) {
            vkDestroyDescriptorSetLayout(v -> gpu.device, v -> gpu.layout, null(*u8));
        }
        buffers_close(v);
        vkDestroyDevice(v -> gpu.device, null(*u8));
    }
    if v -> surface != null(*u8) {
        vkDestroySurfaceKHR(v -> gpu.instance, v -> surface, null(*u8));
    }
    if v -> gpu.instance != null(*u8) {
        vkDestroyInstance(v -> gpu.instance, null(*u8));
    }
}

fn frame_barrier(
    v: *RenderState,
    source_stage: u32,
    source_access: u32,
    dest_stage: u32,
    dest_access: u32
) -> unit {
    var b: VkMemoryBarrier = uninit;
    zero(&b as *u8, sizeof(VkMemoryBarrier));
    b.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
    b.srcAccessMask = source_access;
    b.dstAccessMask = dest_access;
    vkCmdPipelineBarrier(
        v -> gpu.commands,
        source_stage,
        dest_stage,
        0u32,
        1u32,
        &b,
        0u32,
        null(*u8),
        0u32,
        null(*VkImageMemoryBarrier)
    );
}

fn command_begin(v: *RenderState) -> bool {
    if !command_continue(v) {
        return false;
    }
    vkCmdResetQueryPool(v -> gpu.commands, v -> gpu.query_pool, 0u32, v -> query_count);
    if v -> gpu.batch_queries != null(*u8) {
        vkCmdResetQueryPool(
            v -> gpu.commands,
            v -> gpu.batch_queries,
            0u32,
            v -> gpu.batch_query_capacity
        );
        v -> gpu.batch_query_cursor = 0u32;
    }
    return true;
}
fn command_continue(v: *RenderState) -> bool {
    var begin: VkCommandBufferBeginInfo = uninit;
    zero(&begin as *u8, sizeof(VkCommandBufferBeginInfo));
    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    if !vk_ok(vkBeginCommandBuffer(v -> gpu.commands, &begin), "vkBeginCommandBuffer") {
        return false;
    }
    vkCmdBindDescriptorSets(
        v -> gpu.commands,
        VK_PIPELINE_BIND_POINT_COMPUTE,
        v -> gpu.pipeline_layout,
        0u32,
        1u32,
        &v -> gpu.set,
        0u32,
        null(*u32)
    );
    return true;
}
fn command_end(v: *RenderState) -> bool {
    return vk_ok(vkEndCommandBuffer(v -> gpu.commands), "vkEndCommandBuffer");
}
fn command_reset(v: *RenderState) -> bool {
    return vk_ok(vkResetCommandBuffer(v -> gpu.commands, 0u32), "reset renderer commands");
}
fn command_stamp(v: *RenderState, index: u32) -> unit {
    var stage: u32 = 8192u32;
    if index == 0u32 {
        stage = 1u32;
    }
    vkCmdWriteTimestamp(v -> gpu.commands, stage, v -> gpu.query_pool, index);
}
fn command_batch_stamp(v: *RenderState) -> unit {
    if v -> gpu.batch_queries == null(*u8) {
        return;
    }
    if v -> gpu.batch_query_cursor >= v -> gpu.batch_query_capacity {
        trap;
    }
    vkCmdWriteTimestamp(
        v -> gpu.commands,
        8192u32,
        v -> gpu.batch_queries,
        v -> gpu.batch_query_cursor
    );
    v -> gpu.batch_query_cursor = v -> gpu.batch_query_cursor + 1u32;
}
fn command_clear(v: *RenderState, offset: u64, size: u64) -> unit {
    vkCmdFillBuffer(v -> gpu.commands, v -> buffer, offset, size, 0u32);
}
fn command_bind(v: *RenderState, pipeline: usize) -> unit {
    vkCmdBindPipeline(
        v -> gpu.commands,
        VK_PIPELINE_BIND_POINT_COMPUTE,
        v -> gpu.pipelines[pipeline]
    );
}
fn command_direct(v: *RenderState, groups: u32) -> unit {
    vkCmdDispatch(v -> gpu.commands, groups, 1u32, 1u32);
}
fn command_indirect(v: *RenderState, offset: u64) -> unit {
    vkCmdDispatchIndirect(v -> gpu.commands, v -> buffer, offset);
}
fn command_word(v: *RenderState, offset: u32, value: u32) -> unit {
    vkCmdUpdateBuffer(
        v -> gpu.commands,
        v -> buffer,
        offset as u64 * 4u64,
        4u64,
        &value as *u8
    );
}
fn command_barrier(v: *RenderState, kind: u32) -> unit {
    if kind == BARRIER_HOST {
        frame_barrier(v, 4096u32, 4096u32, 16384u32, 8192u32);
        return;
    }
    if kind == BARRIER_UPLOAD {
        frame_barrier(v, 4096u32, 0x1000u32, 2048u32, 96u32);
        return;
    }
    if kind == BARRIER_COMPUTE {
        frame_barrier(v, 2048u32, 64u32, 2048u32, 96u32);
        return;
    }
    if kind == BARRIER_INDIRECT {
        frame_barrier(v, 2048u32, 64u32, 2048u32 | 2u32, 96u32 | 1u32);
        return;
    }
    if kind == BARRIER_BEFORE_UPDATE {
        frame_barrier(v, 2048u32 | 4096u32, 96u32 | 4096u32, 4096u32, 4096u32);
        return;
    }
    if kind == BARRIER_AFTER_UPDATE {
        frame_barrier(v, 4096u32 | 2048u32, 4096u32 | 64u32, 2048u32 | 2u32, 32u32 | 1u32);
        return;
    }
    if kind == BARRIER_UPDATED_COMPUTE {
        frame_barrier(v, 4096u32, 4096u32, 2048u32, 32u32);
        return;
    }
    frame_barrier(v, 2048u32, 64u32, 16384u32 | 4096u32, 2048u32);
}

fn command_copy(v: *RenderState, src: *u8, dst: *u8, offset: u64, size: u64) -> unit {
    var copy: VkBufferCopy = make VkBufferCopy {
        srcOffset: offset,
        dstOffset: offset,
        size: size
    };
    vkCmdCopyBuffer(v -> gpu.commands, src, dst, 1u32, &copy);
}
