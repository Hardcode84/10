const BARRIER_UPLOAD: u32 = 0u32;
const BARRIER_COMPUTE: u32 = 1u32;
const BARRIER_INDIRECT: u32 = 2u32;
const BARRIER_BEFORE_UPDATE: u32 = 3u32;
const BARRIER_AFTER_UPDATE: u32 = 4u32;
const BARRIER_UPDATED_COMPUTE: u32 = 5u32;
const BARRIER_READBACK: u32 = 6u32;
const BARRIER_HOST: u32 = 7u32;

fn commands_record(v: *RenderState) -> bool {
    if !command_begin(v) {
        return false;
    }
    commands_setup_body(v);
    commands_raster_body(v);
    return command_end(v);
}
fn commands_setup_body(v: *RenderState) -> unit {
    command_stamp(v, 0u32);
    upload_scene(v);
    if v -> shader_checks {
        command_clear(v, status_buffer_offset(v), MAX_INVOCATIONS as u64 * 4u64);
    }
    command_barrier(v, BARRIER_UPLOAD);
    if (v -> mapped as *u32)[26usize] != 0u32 || (v -> mapped as *u32)[
        INSTANCE_MAP_RESET as usize
    ] != 0u32 {
        retained_dispatch(v, 6usize, v -> instance_capacity);
    }
    command_barrier(v, BARRIER_COMPUTE);
    commands_shadow_build(v);
}
fn commands_raster_body(v: *RenderState) -> unit {
    commands_root_begin(v);
    commands_traversal(v, 0u32);
}
fn commands_root_begin(v: *RenderState) -> unit {
    retained_dispatch(v, 0usize, (v -> width * v -> height + 63u32) / 64u32);
    command_barrier(v, BARRIER_INDIRECT);
    command_stamp(v, 1u32);
}
fn commands_view_begin(v: *RenderState) -> unit {
    command_bind(v, 12usize);
    command_indirect(v, (CLEAR_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_COMPUTE);
    commands_dispatch_base(v, 0u32);
    command_bind(v, 15usize);
    command_indirect(v, (FRONTIER_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_COMPUTE);
    command_bind(v, 7usize);
    command_indirect(v, (VIEW_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_COMPUTE);
}
fn commands_portal_advance(v: *RenderState) -> unit {
    task_dispatch(v, 4usize, 3u32);
    command_barrier(v, BARRIER_COMPUTE);
    command_bind(v, 2usize);
    command_indirect(v, (ADVANCE_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_INDIRECT);
    task_dispatch(v, 5usize, 6u32);
    command_barrier(v, BARRIER_COMPUTE);
}
fn commands_traversal(v: *RenderState, round: u32) -> unit {
    var rounds: u32 = v -> work_rounds;
    if v -> portal_capacity == 0u32 {
        var bound: u32 = projection_root_rounds(v);
        if bound < round {
            bound = round;
        }
        if bound < rounds {
            rounds = bound;
        }
    }
    if rounds - round > RENDER_CHUNK_ROUNDS {
        rounds = round + RENDER_CHUNK_ROUNDS;
    }
    v -> scheduled_rounds = rounds;
    command_barrier(v, BARRIER_BEFORE_UPDATE);
    command_word(v, ROUND_STOP + 1u32, rounds);
    command_barrier(v, BARRIER_AFTER_UPDATE);
    while round < rounds {
        commands_dynamic_round(v);
        round = round + 1u32;
    }
    command_stamp(v, 2u32);
    retained_dispatch(
        v,
        PIPELINE_COMPOSE as usize,
        (v -> output_width * v -> output_height + 63u32) / 64u32
    );
    command_barrier(v, BARRIER_COMPUTE);
    if v -> shader_checks {
        retained_dispatch(v, (PIPELINE_COUNT - 1u32) as usize, STATUS_GROUPS);
    }
    command_barrier(v, BARRIER_READBACK);
    command_stamp(v, v -> query_count - 2u32);
    readback(v);
    command_stamp(v, v -> query_count - 1u32);
}

fn task_dispatch(v: *RenderState, pipeline: usize, field: u32) -> unit {
    command_bind(v, pipeline);
    var base: u32 = 0u32;
    var batch: u32 = 0u32;
    var commands: u32 = (v -> mapped as *u32)[TASK_COMMANDS as usize];
    while base < v -> task_capacity {
        commands_dispatch_base(v, base);
        command_indirect(
            v,
            (commands as u64 + 1u64 + batch as u64 * 12u64 + field as u64) * 4u64
        );
        base = base + MAX_INVOCATIONS / LOCAL_SIZE;
        batch = batch + 1u32;
    }
}

fn commands_dispatch_base(v: *RenderState, base: u32) -> unit {
    if v -> command_dispatch_base == base {
        return;
    }
    command_barrier(v, BARRIER_BEFORE_UPDATE);
    command_word(v, DISPATCH_BASE + 1u32, base);
    command_barrier(v, BARRIER_AFTER_UPDATE);
    v -> command_dispatch_base = base;
}

fn shadow_build_size(v: *RenderState) -> u32 {
    var w: *u32 = v -> mapped as *u32;
    var size: u32 = 0u32;
    if w[LIGHT_COUNT as usize] != 0u32 {
        size = w[DYNAMIC_COUNT as usize];
        if w[INSTANCE_COUNT as usize] > size {
            size = w[INSTANCE_COUNT as usize];
        }
    }
    return size;
}
fn commands_shadow_build(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var lights: u32 = w[LIGHT_COUNT as usize];
    retained_dispatch(v, 8usize, (lights * 2u32 + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    var size: u32 = shadow_build_size(v);
    var count: u32 = lights * (w[DYNAMIC_COUNT as usize] + w[INSTANCE_COUNT as usize]);
    var level: u32 = 0u32;
    while size != 0u32 {
        command_barrier(v, BARRIER_BEFORE_UPDATE);
        command_word(v, SHADOW_LEVEL + 1u32, level);
        command_barrier(v, BARRIER_UPDATED_COMPUTE);
        retained_dispatch(v, 9usize, (count + 63u32) / 64u32);
        command_barrier(v, BARRIER_COMPUTE);
        if size <= 4u32 {
            size = 0u32;
        } else {
            size = size - size / 4u32;
        }
        level = level + 1u32;
    }
}

fn shade_pipeline(v: *RenderState) -> usize {
    if (v -> mapped as *u32)[LIGHT_MODEL as usize] == 0u32 {
        return 14usize;
    }
    return 10usize;
}

fn commands_batch_geometry(v: *RenderState) -> unit {
    command_bind(v, 1usize);
    command_indirect(v, 68u64);
    command_barrier(v, BARRIER_COMPUTE);
    command_batch_stamp(v);
    task_dispatch(v, 16usize, 0u32);
    command_barrier(v, BARRIER_COMPUTE);
    command_bind(v, 17usize);
    command_indirect(v, (LIST_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_COMPUTE);
    task_dispatch(v, 18usize, 0u32);
    command_barrier(v, BARRIER_COMPUTE);
    command_bind(v, 19usize);
    command_indirect(v, (LIST_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_COMPUTE);
    command_batch_stamp(v);
    task_dispatch(v, 13usize, 0u32);
    command_barrier(v, BARRIER_COMPUTE);
    command_batch_stamp(v);
}

fn commands_dynamic_round(v: *RenderState) -> unit {
    commands_view_begin(v);
    command_batch_stamp(v);
    command_bind(v, 11usize);
    command_indirect(v, (PLAN_COMMAND as u64 + 1u64) * 4u64);
    command_barrier(v, BARRIER_INDIRECT);
    commands_batch_geometry(v);
    task_dispatch(v, shade_pipeline(v), 9u32);
    command_barrier(v, BARRIER_COMPUTE);
    command_batch_stamp(v);
    commands_portal_advance(v);
}
