const BARRIER_UPLOAD: u32 = 0u32;
const BARRIER_COMPUTE: u32 = 1u32;
const BARRIER_INDIRECT: u32 = 2u32;
const BARRIER_BEFORE_UPDATE: u32 = 3u32;
const BARRIER_AFTER_UPDATE: u32 = 4u32;
const BARRIER_UPDATED_COMPUTE: u32 = 5u32;
const BARRIER_READBACK: u32 = 6u32;
const BARRIER_HOST: u32 = 7u32;

fn commands_record(v: *RenderState) -> bool {
    if !command_begin(v) {
        return false;
    }
    commands_setup_body(v);
    commands_raster_body(v);
    return command_end(v);
}
fn commands_setup_body(v: *RenderState) -> unit {
    command_stamp(v, 0u32);
    upload_scene(v);
    if v -> shader_checks {
        command_clear(
            v,
            (v -> words as u64 + v -> floats as u64 + 2u64) * 4u64,
            MAX_INVOCATIONS as u64 * 4u64
        );
    }
    command_barrier(v, BARRIER_UPLOAD);
    if (v -> mapped as *u32)[26usize] != 0u32 || (v -> mapped as *u32)[
        INSTANCE_MAP_RESET as usize
    ] != 0u32 {
        retained_dispatch(v, 8usize, v -> instance_capacity);
    }
    command_barrier(v, BARRIER_COMPUTE);
    commands_shadow_build(v);
}
fn commands_raster_body(v: *RenderState) -> unit {
    retained_dispatch(v, 0usize, (v -> width * v -> height + 63u32) / 64u32);
    command_barrier(v, BARRIER_INDIRECT);
    command_stamp(v, 1u32);
    var depth: u32 = 0u32;
    while depth <= v -> crossing_limit {
        view_dispatch(v, 9usize);
        command_barrier(v, BARRIER_COMPUTE);
        commands_geometry_batches(v, depth);
        command_stamp(v, 2u32 + depth * 2u32);
        task_dispatch(v, 6usize, 3u32);
        command_barrier(v, BARRIER_COMPUTE);
        command_bind(v, 3usize);
        command_direct(v, 1u32);
        command_barrier(v, BARRIER_INDIRECT);
        task_dispatch(v, 7usize, 6u32);
        command_barrier(v, BARRIER_COMPUTE);
        command_stamp(v, 3u32 + depth * 2u32);
        depth = depth + 1u32;
    }
    retained_dispatch(v, 4usize, (v -> output_width * v -> output_height + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    if v -> shader_checks {
        retained_dispatch(v, (PIPELINE_COUNT - 1u32) as usize, STATUS_GROUPS);
    }
    command_barrier(v, BARRIER_READBACK);
    command_stamp(v, v -> query_count - 2u32);
    readback(v);
    command_stamp(v, v -> query_count - 1u32);
}

fn task_dispatch(v: *RenderState, pipeline: usize, field: u32) -> unit {
    command_bind(v, pipeline);
    var base: u32 = 0u32;
    var batch: u32 = 0u32;
    var commands: u32 = (v -> mapped as *u32)[TASK_COMMANDS as usize];
    while base < v -> task_capacity {
        command_barrier(v, BARRIER_BEFORE_UPDATE);
        command_word(v, DISPATCH_BASE + 1u32, base);
        command_barrier(v, BARRIER_AFTER_UPDATE);
        command_indirect(
            v,
            (commands as u64 + 1u64 + batch as u64 * 12u64 + field as u64) * 4u64
        );
        base = base + MAX_INVOCATIONS / LOCAL_SIZE;
        batch = batch + 1u32;
    }
}

fn view_dispatch(v: *RenderState, pipeline: usize) -> unit {
    var base: u32 = 0u32;
    while base < v -> view_capacity {
        var count: u32 = v -> view_capacity - base;
        if count > MAX_INVOCATIONS / LOCAL_SIZE {
            count = MAX_INVOCATIONS / LOCAL_SIZE;
        }
        command_barrier(v, BARRIER_BEFORE_UPDATE);
        command_word(v, DISPATCH_BASE + 1u32, base);
        command_barrier(v, BARRIER_UPDATED_COMPUTE);
        retained_dispatch(v, pipeline, count);
        base = base + count;
    }
}

fn shadow_build_size(v: *RenderState) -> u32 {
    var w: *u32 = v -> mapped as *u32;
    var size: u32 = 0u32;
    if w[LIGHT_COUNT as usize] != 0u32 {
        size = w[DYNAMIC_COUNT as usize];
        if w[INSTANCE_COUNT as usize] > size {
            size = w[INSTANCE_COUNT as usize];
        }
    }
    return size;
}
fn commands_shadow_build(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var lights: u32 = w[LIGHT_COUNT as usize];
    retained_dispatch(v, 11usize, (lights * 2u32 + 63u32) / 64u32);
    command_barrier(v, BARRIER_COMPUTE);
    var size: u32 = shadow_build_size(v);
    var count: u32 = lights * (w[DYNAMIC_COUNT as usize] + w[INSTANCE_COUNT as usize]);
    var level: u32 = 0u32;
    while size != 0u32 {
        command_barrier(v, BARRIER_BEFORE_UPDATE);
        command_word(v, SHADOW_LEVEL + 1u32, level);
        command_barrier(v, BARRIER_UPDATED_COMPUTE);
        retained_dispatch(v, 12usize, (count + 63u32) / 64u32);
        command_barrier(v, BARRIER_COMPUTE);
        if size <= 4u32 {
            size = 0u32;
        } else {
            size = size - size / 4u32;
        }
        level = level + 1u32;
    }
}

fn commands_geometry_batches(v: *RenderState, depth: u32) -> unit {
    var rounds: u64 = projection_depth_work(v, depth) / (v -> mapped as *u32)[
        PROJECTION_CAPACITY as usize
    ] as u64 + projection_depth_steps(v, depth) / 8u64 + 2u64;
    var round: u64 = 0u64;
    while round < rounds {
        var mode: u32 = 1u32;
        if round == 0u64 {
            mode = mode | 2u32;
        }
        if round + 1u64 == rounds {
            mode = mode | 4u32;
        }
        command_barrier(v, BARRIER_BEFORE_UPDATE);
        command_word(v, BATCH_MODE + 1u32, mode);
        command_barrier(v, BARRIER_UPDATED_COMPUTE);
        command_bind(v, 14usize);
        command_direct(v, 1u32);
        command_barrier(v, BARRIER_INDIRECT);
        command_bind(v, 1usize);
        command_indirect(v, 68u64);
        command_barrier(v, BARRIER_COMPUTE);
        view_dispatch(v, 5usize);
        command_barrier(v, BARRIER_COMPUTE);
        task_dispatch(v, 10usize, 0u32);
        command_barrier(v, BARRIER_COMPUTE);
        task_dispatch(v, 2usize, 0u32);
        command_barrier(v, BARRIER_COMPUTE);
        task_dispatch(v, 13usize, 9u32);
        command_barrier(v, BARRIER_COMPUTE);
        round = round + 1u64;
    }
    command_barrier(v, BARRIER_BEFORE_UPDATE);
    command_word(v, BATCH_MODE + 1u32, 0u32);
    command_barrier(v, BARRIER_UPDATED_COMPUTE);
}
