fn geometry_layout(v: *RenderState, capacity: u32) -> bool {
    projection_fit(v, capacity);
    var projected_count: u64 = v -> projection_capacity as u64;
    if projected_count > v -> storage_limit as u64 / (4u64 * (MAX_FAN as u64 * 20u64 + 144u64)) {
        return error("room projection storage exceeds device storage range");
    }
    var projected: u64 = GEOMETRY as u64 + capacity as u64 * 15u64;
    var clip: u64 = projected + projected_count * MAX_FAN as u64 * 20u64;
    var floats: u64 = (
        clip + projected_count * 144u64 + v -> width as u64 * v -> height as u64 * 3u64 + v -> mesh_capacity as u64 * 29u64 + v -> instance_capacity as u64 * (
            18u64 + v -> view_capacity as u64 * 48u64
        ) + traversal_floats(v) + v -> light_capacity as u64 * 8u64 + shadow_elements(v) * 12u64 + 64u64
    ) / 64u64 * 64u64 - 1u64;
    var words: u64 = (
        192u64 + v -> task_capacity as u64 * 4u64 + image_words(v) + tile_bit_words(
            v,
            v -> projection_capacity
        ) + capacity as u64 * 13u64 + projected_count * 4u64 + v -> asset_capacity as u64 + v -> mesh_capacity as u64 * 15u64 + v -> instance_capacity as u64 * (
            5u64 + v -> view_capacity as u64
        ) + traversal_words(v) + v -> light_capacity as u64 * 4u64 + 1u64 + shadow_elements(v) * 9u64 + 64u64
    ) / 64u64 * 64u64 - 1u64;
    if (words + 1u64) * 4u64 > v -> storage_limit as u64 || (floats + 1u64) * 4u64 > v -> storage_limit as u64 {
        return error("geometry storage exceeds device maxStorageBufferRange");
    }
    v -> words = words as u32;
    v -> floats = floats as u32;
    v -> triangle_capacity = capacity;
    return true;
}
fn geometry_header(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var capacity: u32 = v -> triangle_capacity;
    w[0usize] = v -> width;
    w[1usize] = v -> height;
    w[22usize] = v -> output_width;
    w[23usize] = v -> output_height;
    w[PRESENT_PIXELS as usize] = PIXELS + v -> width * v -> height;
    w[DEBUG_VALUES as usize] = w[PRESENT_PIXELS as usize] + v -> output_width * v -> output_height;
    w[META as usize] = image_words(v) as u32;
    image_viewport(v);
    w[PROJECTED_OFFSET as usize] = GEOMETRY + capacity * 15u32;
    w[CLIP_OFFSET as usize] = w[PROJECTED_OFFSET as usize] + v -> projection_capacity * MAX_FAN * 20u32;
    w[BATCH_IDS as usize] = w[META as usize] + capacity * 4u32;
    w[BATCH_PRIMITIVES as usize] = w[BATCH_IDS as usize] + v -> projection_capacity * 3u32;
    w[BATCH_WALKERS as usize] = w[BATCH_PRIMITIVES as usize] + v -> projection_capacity;
    w[TILE_BITS as usize] = w[BATCH_WALKERS as usize] + 192u32;
    w[TILE_STATS as usize] = w[TILE_BITS as usize] + tile_bit_words(v, v -> projection_capacity) as u32;
    w[ASSET_OFFSET as usize] = w[TILE_STATS as usize] + v -> task_capacity * 4u32;
    w[LIGHT_SPACE as usize] = w[ASSET_OFFSET as usize] + v -> asset_capacity;
    w[LIGHT_INDEX as usize] = w[LIGHT_SPACE as usize] + v -> light_capacity;
    w[INSTANCE_OWNER as usize] = w[LIGHT_INDEX as usize] + 1u32 + v -> light_capacity * 3u32;
    w[SPACE_TRIANGLES as usize] = w[INSTANCE_OWNER as usize] + capacity;
    w[SPACE_META as usize] = w[SPACE_TRIANGLES as usize] + capacity * 4u32;
    w[MESH_META as usize] = w[SPACE_META as usize] + capacity * 4u32;
    w[PROJECTION_CAPACITY as usize] = v -> projection_capacity;
    w[MESH_INDEX as usize] = w[MESH_META as usize] + v -> mesh_capacity * 4u32;
    w[MESH_NODES as usize] = w[MESH_INDEX as usize] + v -> mesh_capacity;
    w[INSTANCE_META as usize] = w[MESH_NODES as usize] + v -> mesh_capacity * 10u32;
    w[INSTANCE_VISIBLE as usize] = w[INSTANCE_META as usize] + v -> instance_capacity * 5u32;
    w[HIT_FLOAT as usize] = w[CLIP_OFFSET as usize] + v -> projection_capacity * 144u32;
    w[MESH_FLOAT as usize] = w[HIT_FLOAT as usize] + v -> width * v -> height * 3u32;
    w[MESH_BOUNDS as usize] = w[MESH_FLOAT as usize] + v -> mesh_capacity * 15u32;
    w[INSTANCE_FLOAT as usize] = w[MESH_BOUNDS as usize] + v -> mesh_capacity * 14u32;
    w[INSTANCE_PLANES as usize] = w[INSTANCE_FLOAT as usize] + v -> instance_capacity * 18u32;
    traversal_header(v);
    w[LIGHT_DATA as usize] = w[PORTAL_FLOAT as usize] + v -> portal_capacity * PORTAL_TRANSFORM_WORDS;
    w[SHADOW_BOUNDS as usize] = w[LIGHT_DATA as usize] + v -> light_capacity * 8u32;
    w[SHADOW_INDEX as usize] = w[VIEW_KEYS as usize] + ((v -> task_capacity + 63u32) / 64u32) * (
        (v -> view_capacity * v -> portal_capacity + 31u32) / 32u32
    );
    w[SHADOW_NODES as usize] = w[SHADOW_INDEX as usize] + shadow_elements(v) as u32;
    w[SHADOW_TOP as usize] = v -> light_capacity * v -> shadow_capacity;
    w[SHADOW_CAPACITY as usize] = v -> shadow_capacity;
    w[INSTANCE_CAPACITY as usize] = v -> instance_capacity;
    w[WORD_COUNT as usize] = v -> words;
    w[FLOAT_COUNT as usize] = v -> floats;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var portal: u32 = 0u32;
    while portal < v -> portal_capacity {
        f[(w[PORTAL_FLOAT as usize] + portal * PORTAL_TRANSFORM_WORDS + 16u32) as usize] = 1f32;
        portal = portal + 1u32;
    }
}
fn geometry_copy(v: *RenderState, old: *RenderState) -> unit {
    memcpy(v -> mapped, old -> mapped, PIXELS as usize * 4usize);
    memcpy(
        v -> mapped + image_words(v) as isize * 4isize,
        old -> mapped + image_words(old) as isize * 4isize,
        old -> triangle_capacity as usize * 16usize
    );
    memcpy(
        v -> mapped + (v -> words as isize + 1isize) * 4isize,
        old -> mapped + (old -> words as isize + 1isize) * 4isize,
        (GEOMETRY as usize + old -> triangle_capacity as usize * 15usize) * 4usize
    );
    geometry_header(v);
    retained_copy(v, old);
    retained_copy_region(v, old, SPACE_TRIANGLES, old -> triangle_capacity * 4u32, false);
    retained_copy_region(v, old, SPACE_META, old -> triangle_capacity * 4u32, false);
    retained_copy_region(v, old, LIGHT_DATA, old -> light_capacity * 8u32, true);
    retained_copy_region(v, old, LIGHT_SPACE, old -> light_capacity, false);
    retained_copy_region(v, old, PORTAL_META, old -> portal_capacity * 4u32, false);
    retained_copy_region(
        v,
        old,
        PORTAL_FLOAT,
        old -> portal_capacity * PORTAL_TRANSFORM_WORDS,
        true
    );
    memcpy(
        v -> mapped + (v -> mapped as *u32)[ASSET_OFFSET as usize] as isize * 4isize,
        old -> mapped + (old -> mapped as *u32)[ASSET_OFFSET as usize] as isize * 4isize,
        old -> asset_capacity as usize * 4usize
    );
}
fn geometry_reserve(v: *RenderState, required: u32) -> bool {
    if required <= v -> triangle_capacity {
        return true;
    }
    var next: RenderState = *v;
    var capacity: u32 = storage_growth(required);
    var limit: u32 = geometry_limit(v);
    if capacity > limit {
        capacity = required;
    }
    if !geometry_layout(&next, capacity) {
        return false;
    }
    return storage_replace(v, &next);
}
fn storage_replace(v: *RenderState, planned: *RenderState) -> bool {
    retirement_wait(v);
    var next: RenderState = *planned;
    next.submitted = false;
    buffers_forget(&next);
    if !buffer_create(&next) {
        buffers_close(&next);
        return false;
    }
    var peak: u64 = next.device_bytes + next.staging_bytes + v -> device_bytes + v -> staging_bytes;
    if peak > next.peak_buffer_bytes {
        next.peak_buffer_bytes = peak;
    }
    geometry_copy(&next, v);
    buffers_close(v);
    next.mesh_dirty = true;
    *v = next;
    descriptors_update(v);
    return command_reset(v) && commands_record(v);
}
fn geometry_limit(v: *RenderState) -> u32 {
    if v -> storage_limit < 256u32 {
        return 0u32;
    }
    var elements: u64 = (v -> storage_limit as u64 / 256u64) * 64u64 - 1u64;
    var fixed_words: u64 = 192u64 + v -> task_capacity as u64 * 4u64 + v -> projection_capacity as u64 * 4u64 + tile_bit_words(
        v,
        v -> projection_capacity
    ) + image_words(v) + v -> asset_capacity as u64 + v -> mesh_capacity as u64 * 15u64 + v -> instance_capacity as u64 * (
        5u64 + v -> view_capacity as u64
    ) + traversal_words(v) + v -> light_capacity as u64 * 4u64 + 1u64 + shadow_elements(v) * 9u64;
    var fixed_floats: u64 = v -> projection_capacity as u64 * (MAX_FAN as u64 * 20u64 + 144u64) + v -> width as u64 * v -> height as u64 * 3u64 + GEOMETRY as u64 + v -> mesh_capacity as u64 * 29u64 + v -> instance_capacity as u64 * (
        18u64 + v -> view_capacity as u64 * 48u64
    ) + traversal_floats(v) + v -> light_capacity as u64 * 8u64 + shadow_elements(v) * 12u64;
    if elements <= fixed_words || elements <= fixed_floats {
        return 0u32;
    }
    var words_limit: u64 = (elements - fixed_words) / 13u64;
    var floats_limit: u64 = (elements - fixed_floats) / 15u64;
    if words_limit < floats_limit {
        return words_limit as u32;
    }
    return floats_limit as u32;
}

fn traversal_floats(v: *RenderState) -> u64 {
    return (v -> portal_capacity as u64 + v -> view_capacity as u64) * PORTAL_TRANSFORM_WORDS as u64;
}
fn traversal_words(v: *RenderState) -> u64 {
    return v -> task_capacity as u64 * (10u64 + LOCAL_SIZE as u64 * 3u64) + (
        (v -> task_capacity as u64 + 63u64) / 64u64
    ) * 2u64 + v -> view_capacity as u64 * (12u64 + v -> portal_capacity as u64) + v -> portal_capacity as u64 * 4u64 + (
        (v -> task_capacity as u64 + 32767u64) / 32768u64
    ) * 12u64 + ((v -> task_capacity as u64 + 63u64) / 64u64) * (
        (v -> view_capacity as u64 * v -> portal_capacity as u64 + 31u64) / 32u64
    );
}
fn traversal_header(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    w[TASK_A as usize] = w[INSTANCE_VISIBLE as usize] + v -> instance_capacity * v -> view_capacity;
    w[TASK_B as usize] = w[TASK_A as usize] + v -> task_capacity * 4u32;
    w[CANDIDATES as usize] = w[TASK_B as usize] + v -> task_capacity * 4u32;
    w[VIEW_MAP as usize] = w[CANDIDATES as usize] + v -> task_capacity * (
        1u32 + LOCAL_SIZE * 3u32
    );
    w[VIEW_META as usize] = w[VIEW_MAP as usize] + v -> view_capacity * v -> portal_capacity;
    w[BATCH_META as usize] = w[VIEW_META as usize] + v -> view_capacity * 4u32;
    w[VIEW_RECT as usize] = w[BATCH_META as usize] + v -> view_capacity * 4u32;
    w[PORTAL_META as usize] = w[VIEW_RECT as usize] + v -> view_capacity * 4u32;
    w[TASK_PREFIX as usize] = w[PORTAL_META as usize] + v -> portal_capacity * 4u32;
    w[GROUP_COUNTS as usize] = w[TASK_PREFIX as usize] + v -> task_capacity;
    w[GROUP_PREFIX as usize] = w[GROUP_COUNTS as usize] + (v -> task_capacity + 63u32) / 64u32;
    w[TASK_COMMANDS as usize] = w[GROUP_PREFIX as usize] + (v -> task_capacity + 63u32) / 64u32;
    w[VIEW_KEYS as usize] = w[TASK_COMMANDS as usize] + (
        (v -> task_capacity + 32767u32) / 32768u32
    ) * 12u32;
    w[VIEW_FLOAT as usize] = w[INSTANCE_PLANES as usize] + v -> instance_capacity * v -> view_capacity * 48u32;
    w[PORTAL_FLOAT as usize] = w[VIEW_FLOAT as usize] + v -> view_capacity * PORTAL_TRANSFORM_WORDS;
    w[PORTAL_CAPACITY as usize] = v -> portal_capacity;
    w[TASK_CAPACITY as usize] = v -> task_capacity;
}

fn tile_bit_words(v: *RenderState, triangles: u32) -> u64 {
    return v -> task_capacity as u64 * ((triangles as u64 * MAX_FAN as u64 + 31u64) / 32u64);
}

fn shadow_elements(v: *RenderState) -> u64 {
    return v -> light_capacity as u64 * (
        v -> shadow_capacity as u64 + v -> instance_capacity as u64
    );
}

fn storage_growth(required: u32) -> u32 {
    var capacity: u32 = 1u32;
    while capacity < required && capacity <= 0x7fffffffu32 {
        capacity = capacity * 2u32;
    }
    if capacity < required {
        return required;
    }
    return capacity;
}

fn projection_fit(v: *RenderState, triangles: u32) -> unit {
    if geometry_limit(v) >= triangles {
        return;
    }
    var candidate: RenderState = *v;
    var lower: u32 = 1u32;
    var upper: u32 = v -> projection_capacity;
    while lower < upper {
        var middle: u32 = lower + (upper - lower + 1u32) / 2u32;
        candidate.projection_capacity = middle;
        if geometry_limit(&candidate) >= triangles {
            lower = middle;
        } else {
            upper = middle - 1u32;
        }
    }
    v -> projection_capacity = lower;
}

fn shadow_reserve(v: *RenderState, required: u32) -> bool {
    if required <= v -> shadow_capacity {
        return true;
    }
    var next: RenderState = *v;
    next.shadow_capacity = storage_growth(required);
    if geometry_limit(&next) < next.triangle_capacity {
        next.shadow_capacity = required;
    }
    if !geometry_layout(&next, next.triangle_capacity) {
        return false;
    }
    return storage_replace(v, &next);
}
