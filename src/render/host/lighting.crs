// Sets the active light count. Growth preserves submitted data; failure preserves the old layout.
// Fill each active record before drawing. Records use the offset in LIGHT_DATA.
fn input_lights(input: mut FrameInput, count: u32) -> bool {
    if count > input.storage.light_capacity {
        var next: RenderState = input.storage;
        next.light_capacity = storage_growth(count);
        if geometry_limit(&next) < next.triangle_capacity {
            next.light_capacity = count;
        }
        if !geometry_layout(&next, next.triangle_capacity) || !storage_replace(
            &input.storage,
            &next
        ) {
            return false;
        }
    }
    input_set_word(mut input, LIGHT_COUNT as usize, count);
    return true;
}
fn lighting_valid(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    if w[LIGHT_COUNT as usize] > v -> light_capacity {
        return error("light count exceeds reserved storage");
    }
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var i: u32 = 0u32;
    while i < w[LIGHT_COUNT as usize] {
        var p: usize = (w[LIGHT_DATA as usize] + i * 8u32) as usize;
        var mode: f32 = f[p + 7usize];
        if mode != LIGHT_ROOM as f32 && mode != LIGHT_VIEW as f32 && mode != LIGHT_UNSHADOWED as f32 && mode != LIGHT_HEADLAMP as f32 {
            return error("invalid light mode");
        }
        var j: usize = 0usize;
        while j < 7usize {
            var value: f32 = f[p + j];
            if value - value != 0f32 || (j >= 3usize && value < 0f32) {
                return error(
                    "light records require finite positions and non-negative radius and colour"
                );
            }
            j = j + 1usize;
        }
        i = i + 1u32;
    }
    return true;
}

// Sets the exact room ID for an active light record.
fn input_light_space(input: mut FrameInput, index: u32, space: u32) -> unit {
    var address: usize = (input_word(read input, LIGHT_SPACE as usize) + index) as usize;
    input_set_word(mut input, address, space);
}

fn lighting_compare(left: *u8, right: *u8) -> i32 {
    var a: *u32 = left as *u32;
    var b: *u32 = right as *u32;
    var i: usize = 0usize;
    while i < 3usize {
        if a[i] < b[i] {
            return -1i32;
        }
        if a[i] > b[i] {
            return 1i32;
        }
        i = i + 1usize;
    }
    return 0i32;
}
fn lighting_index(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var entries: *u32 = w + w[LIGHT_INDEX as usize] as isize + 1isize;
    var i: u32 = 0u32;
    var global: u32 = 0u32;
    while i < w[LIGHT_COUNT as usize] {
        var transported: bool = f[(w[LIGHT_DATA as usize] + i * 8u32 + 7u32) as usize] == LIGHT_VIEW as f32;
        entries[(i * 3u32) as usize] = (!transported) as u32;
        var space: u32 = 0u32;
        if !transported {
            space = w[(w[LIGHT_SPACE as usize] + i) as usize];
        }
        entries[(i * 3u32 + 1u32) as usize] = space;
        entries[(i * 3u32 + 2u32) as usize] = i;
        global = global + transported as u32;
        i = i + 1u32;
    }
    projection_sort(
        entries as *u8,
        w[LIGHT_COUNT as usize] as usize,
        12usize,
        lighting_compare
    );
    w[w[LIGHT_INDEX as usize] as usize] = global;
}

// Returns true when an active light needs scene shadow geometry.
fn lighting_has_shadows(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var f: *f32 = (v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32;
    var i: u32 = 0u32;
    while i < w[LIGHT_COUNT as usize] {
        if f[(w[LIGHT_DATA as usize] + i * 8u32 + 7u32) as usize] == LIGHT_ROOM as f32 {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}
// Bounds the dynamic casters that any light can place in its shadow tree.
fn shadow_dynamic_required(v: *RenderState) -> u32 {
    if !lighting_has_shadows(v) {
        return 0u32;
    }
    var w: *u32 = v -> mapped as *u32;
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < w[DYNAMIC_COUNT as usize] {
        var flags: u32 = w[(w[META as usize] + i * 4u32 + 3u32) as usize];
        if (flags & (TRIANGLE_NO_SHADOW | TRIANGLE_INACTIVE)) == 0u32 {
            count = count + 1u32;
        }
        i = i + 1u32;
    }
    return count;
}
