fn retirement_observer_open(v: *RenderState) -> bool {
    if v -> gpu.observer == null(*ExternalService) {
        v -> gpu.observer = service_new();
    }
    return v -> gpu.observer != null(*ExternalService);
}
fn retirement_service_wait(data: *u8) -> bool {
    var v: *RenderState = data as *RenderState;
    return vk_ok(
        vkWaitForFences(v -> gpu.device, 1u32, &v -> gpu.retired, 1u32, ~0u64),
        "observe renderer retirement"
    );
}
fn retirement_observer_start(v: *RenderState) -> unit {
    v -> gpu.observer_pending = true;
    service_submit(v -> gpu.observer, retirement_service_wait, v as *u8);
}
fn retirement_observer_poll(v: *RenderState) -> i32 {
    var result: i32 = service_poll(v -> gpu.observer);
    if result != 0i32 {
        v -> gpu.observer_pending = false;
        v -> submitted = false;
    }
    return result;
}
fn retirement_idle(v: *RenderState) -> unit {
    service_idle(v -> gpu.observer);
}
fn retirement_observer_drain(v: *RenderState) -> unit {
    var result: i32 = retirement_observer_poll(v);
    while result == 0i32 {
        service_require(service_wait(v -> gpu.observer -> complete));
        result = retirement_observer_poll(v);
    }
    if result < 0i32 {
        exit(1i32);
    }
}

fn presentation_execute(data: *u8) -> bool {
    return present(data as *RenderState);
}
fn presentation_start(v: *RenderState) -> bool {
    if !retirement_observer_open(v) {
        return false;
    }
    service_submit(v -> gpu.observer, presentation_execute, v as *u8);
    return true;
}
fn presentation_status(v: *RenderState) -> i32 {
    return service_poll(v -> gpu.observer);
}
fn presentation_pause(v: *RenderState) -> unit {
    service_idle(v -> gpu.observer);
}
