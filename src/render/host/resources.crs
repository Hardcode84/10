fn memory_allocate(
    v: *RenderState,
    requirements: *VkMemoryRequirements,
    flags: u32,
    memory: **u8
) -> bool {
    var index: u32 = 0u32;
    while index < v -> gpu.properties.memoryTypeCount {
        if (requirements -> memoryTypeBits & (1u32 << index)) != 0u32 && (
            v -> gpu.properties.memoryTypes[index as usize].propertyFlags & flags
        ) == flags {
            break;
        }
        index = index + 1u32;
    }
    if index == v -> gpu.properties.memoryTypeCount {
        puts("no memory type with required flags:");
        print_number(flags as i64);
        return false;
    }
    var info: VkMemoryAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkMemoryAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
    info.allocationSize = requirements -> size;
    info.memoryTypeIndex = index;
    return vk_ok(
        vkAllocateMemory(v -> gpu.device, &info, null(*u8), memory),
        "vkAllocateMemory"
    );
}

fn allocate_buffer(
    v: *RenderState,
    size: u64,
    usage: u32,
    flags: u32,
    buffer: **u8,
    memory: **u8
) -> bool {
    var info: VkBufferCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkBufferCreateInfo));
    info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
    info.size = size;
    info.usage = usage;
    if !vk_ok(
        vkCreateBuffer(v -> gpu.device, &info, null(*u8), buffer),
        "vkCreateBuffer"
    ) {
        return false;
    }
    var req: VkMemoryRequirements = uninit;
    vkGetBufferMemoryRequirements(v -> gpu.device, *buffer, &req);
    if !memory_allocate(v, &req, flags, memory) {
        return false;
    }
    if flags == 1u32 {
        v -> device_bytes = req.size;
    } else {
        v -> staging_bytes = req.size;
    }
    return vk_ok(
        vkBindBufferMemory(v -> gpu.device, *buffer, *memory, 0u64),
        "vkBindBufferMemory"
    );
}

fn layout_create(v: *RenderState) -> bool {
    var bindings: [VkDescriptorSetLayoutBinding; 4] = uninit;
    zero(&bindings as *u8, sizeof([VkDescriptorSetLayoutBinding; 4]));
    var i: usize = 0usize;
    while i < 3usize + v -> shader_checks as usize {
        bindings[i].binding = i as u32;
        bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
        bindings[i].descriptorCount = 1u32;
        bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
        i = i + 1usize;
    }
    var info: VkDescriptorSetLayoutCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkDescriptorSetLayoutCreateInfo));
    info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
    info.bindingCount = 3u32 + v -> shader_checks as u32;
    info.pBindings = &bindings[0usize];
    if !vk_ok(
        vkCreateDescriptorSetLayout(
            v -> gpu.device,
            &info,
            null(*u8),
            &v -> gpu.layout
        ),
        "vkCreateDescriptorSetLayout"
    ) {
        return false;
    }
    var pi: VkPipelineLayoutCreateInfo = uninit;
    zero(&pi as *u8, sizeof(VkPipelineLayoutCreateInfo));
    pi.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
    pi.setLayoutCount = 1u32;
    pi.pSetLayouts = &v -> gpu.layout;
    return vk_ok(
        vkCreatePipelineLayout(
            v -> gpu.device,
            &pi,
            null(*u8),
            &v -> gpu.pipeline_layout
        ),
        "vkCreatePipelineLayout"
    );
}
fn pipeline_create(v: *RenderState, code: *ShaderCode, slot: usize) -> bool {
    if code -> size < 20usize || code -> size % 4usize != 0usize || (code -> bytes as *u32)[
        0usize
    ] != 0x07230203u32 {
        return error("invalid SPIR-V module");
    }

    var module: VkShaderModuleCreateInfo = uninit;
    zero(&module as *u8, sizeof(VkShaderModuleCreateInfo));
    module.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
    module.codeSize = code -> size;
    module.pCode = code -> bytes as *u32;
    if !vk_ok(
        vkCreateShaderModule(
            v -> gpu.device,
            &module,
            null(*u8),
            &v -> gpu.modules[slot]
        ),
        "vkCreateShaderModule"
    ) {
        return false;
    }
    var pipeline: VkComputePipelineCreateInfo = uninit;
    zero(&pipeline as *u8, sizeof(VkComputePipelineCreateInfo));
    pipeline.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
    pipeline.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
    pipeline.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
    pipeline.stage.module = v -> gpu.modules[slot];
    pipeline.stage.pName = "main";
    pipeline.layout = v -> gpu.pipeline_layout;
    return vk_ok(
        vkCreateComputePipelines(
            v -> gpu.device,
            null(*u8),
            1u32,
            &pipeline,
            null(*u8),
            &v -> gpu.pipelines[slot]
        ),
        "vkCreateComputePipelines"
    );
}

fn descriptors_create(v: *RenderState) -> bool {
    var size: VkDescriptorPoolSize = make VkDescriptorPoolSize {
        type: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
        descriptorCount: 4u32
    };
    var pool: VkDescriptorPoolCreateInfo = uninit;
    zero(&pool as *u8, sizeof(VkDescriptorPoolCreateInfo));
    pool.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
    pool.maxSets = 1u32;
    pool.poolSizeCount = 1u32;
    pool.pPoolSizes = &size;
    if !vk_ok(
        vkCreateDescriptorPool(v -> gpu.device, &pool, null(*u8), &v -> gpu.pool),
        "vkCreateDescriptorPool"
    ) {
        return false;
    }
    var info: VkDescriptorSetAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkDescriptorSetAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
    info.descriptorPool = v -> gpu.pool;
    info.descriptorSetCount = 1u32;
    info.pSetLayouts = &v -> gpu.layout;
    if !vk_ok(
        vkAllocateDescriptorSets(v -> gpu.device, &info, &v -> gpu.set),
        "vkAllocateDescriptorSets"
    ) {
        return false;
    }
    descriptors_update(v);
    return true;
}
fn descriptors_update(v: *RenderState) -> unit {
    var buffers: [VkDescriptorBufferInfo; 4] = uninit;
    buffers[0usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: 0u64,
        range: (v -> words as u64 + 1u64) * 4u64
    };
    buffers[1usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: (v -> words as u64 + 1u64) * 4u64,
        range: (v -> floats as u64 + 1u64) * 4u64
    };
    buffers[2usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: tile_buffer_offset(v),
        range: (v -> tile_words as u64 + 1u64) * 4u64
    };
    buffers[3usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: status_buffer_offset(v),
        range: MAX_INVOCATIONS as u64 * 4u64
    };
    var writes: [VkWriteDescriptorSet; 4] = uninit;
    zero(&writes as *u8, sizeof([VkWriteDescriptorSet; 4]));
    var i: usize = 0usize;
    while i < 4usize {
        writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
        writes[i].dstSet = v -> gpu.set;
        writes[i].dstBinding = i as u32;
        writes[i].descriptorCount = 1u32;
        writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
        writes[i].pBufferInfo = &buffers[i];
        i = i + 1usize;
    }
    vkUpdateDescriptorSets(
        v -> gpu.device,
        3u32 + v -> shader_checks as u32,
        &writes[0usize],
        0u32,
        null(*u8)
    );
}

fn buffers_allocate(v: *RenderState, size: u64, staging_size: u64) -> bool {
    if !allocate_buffer(v, size, 35u32 | 256u32, 1u32, &v -> buffer, &v -> gpu.memory) || !allocate_buffer(
        v,
        staging_size,
        3u32,
        14u32,
        &v -> staging,
        &v -> gpu.staging_memory
    ) {
        return false;
    }
    if !vk_ok(
        vkMapMemory(
            v -> gpu.device,
            v -> gpu.staging_memory,
            0u64,
            staging_size,
            0u32,
            &v -> mapped
        ),
        "vkMapMemory"
    ) {
        return false;
    }
    return true;
}
fn buffers_forget(v: *RenderState) -> unit {
    v -> buffer = null(*u8);
    v -> gpu.memory = null(*u8);
    v -> staging = null(*u8);
    v -> gpu.staging_memory = null(*u8);
    v -> mapped = null(*u8);
}
