fn render_config_valid(config: *RenderConfig) -> bool {
    if config -> fault != 0u32 && !config -> shader_checks {
        return error("fault injection requires checked shaders");
    }
    if config -> width == 0u32 || config -> height == 0u32 || config -> output_width == 0u32 || config -> output_height == 0u32 || config -> view_budget == 0u32 || config -> task_budget == 0u32 || config -> crossing_limit > 0x3ffffffdu32 {
        return error("render configuration exceeds image or view capacity");
    }
    return image_extent_valid(
        config -> width,
        config -> height,
        config -> output_width,
        config -> output_height
    );
}
fn frame_valid(v: *RenderState) -> bool {
    var w: *u32 = v -> mapped as *u32;
    var first: u32 = 0xffffffffu32;
    var i: u32 = 0u32;
    while v -> shader_checks && i < STATUS_GROUPS {
        var index: u32 = w[(STATUS_REPORT + i * 4u32) as usize];
        if index < first {
            first = index;
        }
        i = i + 1u32;
    }
    if first != 0xffffffffu32 {
        print_number(first as i64);
        return error("device invocation failed");
    }
    var failure: u32 = (v -> mapped as *u32)[5usize];
    if failure == 1u32 {
        return error("portal task budget exhausted; output rejected");
    }
    if failure == 2u32 {
        return error("portal view budget exhausted; output rejected");
    }
    if failure == 3u32 {
        return error("geometry batch queue exceeds its admitted work bound");
    }
    return true;
}
record RenderConfig {
    width: u32;
    height: u32;
    output_width: u32;
    output_height: u32;
    read_pixels: bool;
    shader_checks: bool;
    debug_pixels: u32;
    view_budget: u32;
    portal_budget: u32;
    task_budget: u32;
    crossing_limit: u32;
    fault: u32;
}
// Requires an instance and an optional surface. Shader bytes are borrowed for this call.
// Call device_close after success or failure. Use renderer_resize to change image dimensions.
fn renderer_open(v: *RenderState, config: *RenderConfig, shaders: *ShaderCode) -> bool {
    if !render_config_valid(config) {
        return false;
    }
    v -> width = config -> width;
    v -> height = config -> height;
    v -> output_width = config -> output_width;
    v -> output_height = config -> output_height;
    v -> read_pixels = config -> read_pixels;
    v -> shader_checks = config -> shader_checks;
    v -> light_capacity = 32u32;
    v -> view_capacity = config -> view_budget;
    v -> portal_capacity = config -> portal_budget;
    v -> task_capacity = config -> task_budget;
    v -> crossing_limit = config -> crossing_limit;
    v -> query_count = 4u32 + (config -> crossing_limit + 1u32) * 2u32;
    if !device_open(v) || !traversal_valid(v) || !buffer_create(v) || !layout_create(v) {
        return false;
    }
    if !renderer_pipelines(v, shaders) {
        return false;
    }
    var w: *u32 = v -> mapped as *u32;
    w[4usize] = config -> crossing_limit;
    w[0usize] = config -> width;
    w[1usize] = config -> height;
    w[22usize] = config -> output_width;
    w[23usize] = config -> output_height;
    w[26usize] = config -> debug_pixels;
    w[31usize] = config -> view_budget;
    w[33usize] = config -> fault;
    ((v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32)[PROJECTION as usize] = 1f32;
    ((v -> mapped + (v -> words as isize + 1isize) * 4isize) as *f32)[RENDER_STYLE as usize] = 0.04f32;
    if !descriptors_create(v) || !commands_create(v) || !queries_create(v) || !commands_record(v) {
        return false;
    }
    return v -> surface == null(*u8) || swapchain_open(
        v,
        config -> output_width,
        config -> output_height
    );
}
// Consumes the caller's camera, geometry, portals, textures, and lighting in the input buffer.
// Returns after GPU completion and the selected readback. A failed frame must not be presented.
// Requires no input borrow. Frame storage addresses can change when room geometry grows.
fn renderer_prepare(v: *RenderState, extra: u32) -> bool {
    v -> frame_submit_ns = 0u64;
    v -> frame_present_ns = 0u64;
    v -> frame_retired_ns = 0u64;
    v -> frame_validated_ns = 0u64;
    v -> frame_present_start_ns = 0u64;
    v -> frame_present_done_ns = 0u64;
    v -> frame_released_ns = 0u64;
    v -> present_ready = false;
    if !lighting_valid(v) {
        return false;
    }
    var w: *u32 = v -> mapped as *u32;
    if w[4usize] > v -> crossing_limit {
        return error("frame crossing limit exceeds configured traversal depth");
    }
    if w[INSTANCE_COUNT as usize] == 0u32 {
        w[DYNAMIC_COUNT as usize] = w[3usize];
    }
    if !projection_admit(v, extra) {
        return false;
    }
    mesh_trees_prepare(v);
    if !render_numeric_bounds(v) {
        return false;
    }
    w = v -> mapped as *u32;
    w[INSTANCE_MAP_RESET as usize] = (
        v -> mesh_dirty || v -> instance_map_dirty || v -> instance_map_count != w[
            INSTANCE_COUNT as usize
        ]
    ) as u32;
    v -> frame_wait_ns = 0u64;
    v -> frame_upload_bytes = 0u64;
    v -> frame_readback_bytes = 0u64;
    v -> mesh_upload_bytes = 0u64;
    v -> asset_upload_bytes = 0u64;
    return true;
}
fn renderer_begin(v: *RenderState) -> bool {
    if !renderer_prepare(v, 0u32) || !command_reset(v) || !commands_record(v) || !dispatch_submit(
        v
    ) {
        return false;
    }
    return true;
}
fn renderer_complete(v: *RenderState) -> bool {
    if !frame_valid(v) {
        return false;
    }
    v -> mesh_dirty = false;
    v -> instance_map_dirty = false;
    v -> instance_map_count = (v -> mapped as *u32)[INSTANCE_COUNT as usize];
    v -> asset_dirty_begin = 0u32;
    v -> asset_dirty_end = 0u32;
    v -> font_dirty = false;
    v -> instance_dirty = false;
    v -> present_ready = true;
    v -> frame_validated_ns = render_trace_clock(v);
    return true;
}

fn renderer_draw(v: *RenderState) -> bool {
    if !renderer_begin(v) {
        return false;
    }
    retirement_wait(v);
    return renderer_complete(v);
}

fn traversal_valid(v: *RenderState) -> bool {
    var elements: u32 = v -> storage_limit / 4u32;
    if v -> portal_capacity > elements || v -> task_capacity > elements || v -> view_capacity > elements || v -> view_capacity as u64 * v -> portal_capacity as u64 > elements as u64 {
        return error("traversal capacities exceed device storage range");
    }
    return true;
}

fn renderer_pipelines(v: *RenderState, shaders: *ShaderCode) -> bool {
    var slot: usize = 0usize;
    while slot < renderer_pipeline_count(v) {
        if !pipeline_create(v, &shaders[slot], slot) {
            return false;
        }
        slot = slot + 1usize;
    }
    return true;
}
fn renderer_pipeline_count(v: *RenderState) -> usize {
    return PIPELINE_COUNT as usize - 1usize + v -> shader_checks as usize;
}
