fn render_config_valid(config: *RenderConfig) -> bool {
    if config -> width == 0u32 || config -> height == 0u32 || config -> width > 1920u32 || config -> height > 1080u32 || config -> output_width == 0u32 || config -> output_height == 0u32 || config -> output_width > 1920u32 || config -> output_height > 1080u32 || config -> view_budget == 0u32 || config -> view_budget > MAX_VIEWS {
        return error("render configuration exceeds image or view capacity");
    }
    return true;
}
fn frame_valid(v: *Vulkan) -> bool {
    var status: *u32 = (v -> mapped + (WORDS_LENGTH as isize + FLOATS_LENGTH as isize) * 4isize) as *u32;
    var i: usize = 0usize;
    while i < MAX_INVOCATIONS as usize {
        if status[i] != 0u32 {
            print_number(i as i64);
            return error("device invocation failed");
        }
        i = i + 1usize;
    }
    if (v -> mapped as *u32)[5usize] != 0u32 {
        return error("frame work budget exceeded; output rejected");
    }
    return true;
}
record RenderConfig {
    width: u32;
    height: u32;
    output_width: u32;
    output_height: u32;
    read_pixels: bool;
    debug_pixels: u32;
    baseline: u32;
    view_budget: u32;
    fault: u32;
}
// Requires an instance and an optional surface. Shader bytes are borrowed for this call.
// Call device_close after success or failure. Image dimensions stay fixed until close.
fn renderer_open(v: *Vulkan, config: *RenderConfig, shaders: *ShaderCode) -> bool {
    if !render_config_valid(config) {
        return false;
    }
    v -> read_pixels = config -> read_pixels;
    if !device_open(v) || !buffer_create(v) || !layout_create(v) {
        return false;
    }
    var slot: usize = 0usize;
    while slot < 8usize {
        if shaders[slot].size < 20usize || shaders[slot].size % 4usize != 0usize || (
            shaders[slot].bytes as *u32
        )[0usize] != 0x07230203u32 {
            return error("invalid SPIR-V module");
        }
        if !pipeline_create(v, &shaders[slot], slot) {
            return false;
        }
        slot = slot + 1usize;
    }
    var w: *u32 = v -> mapped as *u32;
    w[0usize] = config -> width;
    w[1usize] = config -> height;
    w[22usize] = config -> output_width;
    w[23usize] = config -> output_height;
    w[25usize] = config -> baseline;
    w[26usize] = config -> debug_pixels;
    w[31usize] = config -> view_budget;
    w[33usize] = config -> fault;
    if !descriptors_create(v) || !commands_create(v) || !queries_create(v) || !commands_record(v) {
        return false;
    }
    return v -> surface == null(*u8) || swapchain_open(
        v,
        config -> output_width,
        config -> output_height
    );
}
// Consumes the caller's camera, geometry, portals, textures, and lighting in the input buffer.
// Returns after GPU completion and status readback. A failed frame must not be presented.
fn renderer_draw(v: *Vulkan) -> bool {
    return dispatch(v) && frame_valid(v);
}
