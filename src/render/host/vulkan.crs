const VK_FORMAT_R32_SFLOAT: u32 = 100u32;
const VK_IMAGE_ASPECT_COLOR_BIT: u32 = 0x00000001u32;
const VK_IMAGE_LAYOUT_GENERAL: u32 = 1u32;
