const VK_PIPELINE_STAGE_HOST_BIT: u32 = 0x00004000u32;
const VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT: u32 = 0x00000001u32;
const VK_QUEUE_COMPUTE_BIT: u32 = 0x00000002u32;
const VK_QUEUE_FAMILY_IGNORED: u32 = 4294967295u32;
const VK_SAMPLE_COUNT_1_BIT: u32 = 0x00000001u32;
const VK_SHADER_STAGE_COMPUTE_BIT: u32 = 0x00000020u32;
const VK_STRUCTURE_TYPE_APPLICATION_INFO: u32 = 0u32;
const VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO: u32 = 12u32;
const VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO: u32 = 40u32;
const VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO: u32 = 42u32;
const VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO: u32 = 39u32;
const VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO: u32 = 29u32;
const VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO: u32 = 33u32;
const VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO: u32 = 34u32;
const VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO: u32 = 32u32;
const VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO: u32 = 3u32;
const VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO: u32 = 2u32;
const VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO: u32 = 14u32;
const VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER: u32 = 45u32;
const VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO: u32 = 15u32;
const VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: u32 = 1u32;
const VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO: u32 = 5u32;
const VK_STRUCTURE_TYPE_MEMORY_BARRIER: u32 = 46u32;
const VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2: u32 = 1000059000u32;
const VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FLOAT_CONTROLS_PROPERTIES: u32 = 1000197000u32;
const VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2: u32 = 1000059001u32;
const VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES: u32 = 51u32;
