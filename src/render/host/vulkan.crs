}
opaque;

record VkDescriptorPoolSize {
    type: u32;
    descriptorCount: u32;
}
opaque;

record VkDescriptorSetAllocateInfo {
    sType: u32;
    pNext: *u8;
    descriptorPool: *u8;
    descriptorSetCount: u32;
    pSetLayouts: **u8;
}
opaque;

