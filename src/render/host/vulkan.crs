record VkApplicationInfo {
    sType: u32;
    pNext: *u8;
    pApplicationName: *u8;
    applicationVersion: u32;
    pEngineName: *u8;
    engineVersion: u32;
    apiVersion: u32;
}
opaque;

record VkBufferCreateInfo {
    sType: u32;
    pNext: *u8;
    flags: u32;
    size: u64;
    usage: u32;
    sharingMode: u32;
    queueFamilyIndexCount: u32;
    pQueueFamilyIndices: *u32;
}
opaque;

record VkCommandBufferAllocateInfo {
    sType: u32;
    pNext: *u8;
    commandPool: *u8;
    level: u32;
    commandBufferCount: u32;
}
opaque;

record VkCommandBufferBeginInfo {
    sType: u32;
    pNext: *u8;
    flags: u32;
    pInheritanceInfo: *u8;
}
opaque;

record VkCommandPoolCreateInfo {
    sType: u32;
    pNext: *u8;
    flags: u32;
    queueFamilyIndex: u32;
}
opaque;

record VkComponentMapping {
    r: u32;
    g: u32;
    b: u32;
    a: u32;
}
opaque;

record VkComputePipelineCreateInfo {
    sType: u32;
    pNext: *u8;
    flags: u32;
