// Vulkan 1.2 ABI subset for Linux x86-64, extended from Crust's Vulkan fixture.
// Field order follows the Vulkan headers.

const VK_ACCESS_HOST_READ_BIT: u32 = 0x00002000u32;
const VK_ACCESS_SHADER_READ_BIT: u32 = 0x00000020u32;
const VK_ACCESS_SHADER_WRITE_BIT: u32 = 0x00000040u32;
