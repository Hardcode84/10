}
opaque;

record VkImageMemoryBarrier {
    sType: u32;
    pNext: *u8;
    srcAccessMask: u32;
    dstAccessMask: u32;
    oldLayout: u32;
    newLayout: u32;
    srcQueueFamilyIndex: u32;
    dstQueueFamilyIndex: u32;
