record RenderBackend {
    observer: *ExternalService;
    observer_pending: bool;
    retired: *u8;
    properties: VkPhysicalDeviceMemoryProperties;
    instance: *u8;
    physical: *u8;
    device: *u8;
    queue: *u8;
    memory: *u8;
    staging_memory: *u8;
    layout: *u8;
    pipeline_layout: *u8;
    modules: [*u8; 21];
    pipelines: [*u8; 21];
    pool: *u8;
    set: *u8;
    command_pool: *u8;
    commands: *u8;
    swapchain: *u8;
    images: **u8;
    acquired: *u8;
    present_semaphores: **u8;
    present_semaphore_count: u32;
    present_commands: *u8;
    query_pool: *u8;
    batch_queries: *u8;
    batch_query_capacity: u32;
    batch_query_cursor: u32;
    family: u32;
}
opaque;

fn device_profile(v: *RenderState) -> bool {
    var controls: VkPhysicalDeviceFloatControlsProperties = uninit;
    zero(&controls as *u8, sizeof(VkPhysicalDeviceFloatControlsProperties));
    controls.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FLOAT_CONTROLS_PROPERTIES;
    var props: VkPhysicalDeviceProperties2 = uninit;
    zero(&props as *u8, sizeof(VkPhysicalDeviceProperties2));
    props.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
    props.pNext = &controls as *u8;
    var support: VkPhysicalDeviceVulkan12Features = uninit;
    zero(&support as *u8, sizeof(VkPhysicalDeviceVulkan12Features));
    support.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
    var query: VkPhysicalDeviceFeatures2 = uninit;
    zero(&query as *u8, sizeof(VkPhysicalDeviceFeatures2));
    query.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
    query.pNext = &support as *u8;
    vkGetPhysicalDeviceProperties2(v -> gpu.physical, &props);
    vkGetPhysicalDeviceFeatures2(v -> gpu.physical, &query);
    puts(&props.properties.deviceName[0usize]);
    if props.properties.apiVersion < VK_API_VERSION_1_2 {
        return error("requires Vulkan 1.2");
    }
    if support.shaderInt8 == 0u32 {
        return error("shader modules require shaderInt8");
    }
    if controls.shaderRoundingModeRTEFloat32 == 0u32 || controls.shaderSignedZeroInfNanPreserveFloat32 == 0u32 {
        return error(
            "shader modules require RTE and signed-zero/Inf/NaN preservation for Float32"
        );
    }
    if props.properties.limits.minStorageBufferOffsetAlignment > 256u64 {
        return error("buffer interface requires storage alignment at most 256 bytes");
    }
    if props.properties.limits.maxPerStageDescriptorStorageBuffers < 4u32 + v -> shader_checks as u32 || props.properties.limits.maxDescriptorSetStorageBuffers < 4u32 + v -> shader_checks as u32 {
        return error("insufficient storage-buffer bindings for renderer and selected diagnostics");
    }
    if props.properties.limits.maxComputeWorkGroupCount[0usize] < MAX_INVOCATIONS / LOCAL_SIZE || props.properties.limits.maxComputeWorkGroupInvocations < 64u32 || props.properties.limits.maxComputeWorkGroupSize[
        0usize
    ] < 64u32 {
        return error("compute workgroup limits do not meet the shader interface");
    }
    if props.properties.limits.maxComputeSharedMemorySize < 2048u32 {
        return error("raster module requires 2048 bytes of workgroup memory");
    }
    v -> storage_limit = props.properties.limits.maxStorageBufferRange;
    v -> timestamp_period = props.properties.limits.timestampPeriod;
    return true;
}

fn device_create(v: *RenderState) -> bool {
    var priority: f32 = 1f32;
    var qci: VkDeviceQueueCreateInfo = uninit;
    zero(&qci as *u8, sizeof(VkDeviceQueueCreateInfo));
    qci.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
    qci.queueFamilyIndex = v -> gpu.family;
    qci.queueCount = 1u32;
    qci.pQueuePriorities = &priority;
    var features: VkPhysicalDeviceVulkan12Features = uninit;
    zero(&features as *u8, sizeof(VkPhysicalDeviceVulkan12Features));
    features.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
    features.shaderInt8 = VK_TRUE;
    var dci: VkDeviceCreateInfo = uninit;
    zero(&dci as *u8, sizeof(VkDeviceCreateInfo));
    dci.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
    dci.pNext = &features as *u8;
    dci.queueCreateInfoCount = 1u32;
    dci.pQueueCreateInfos = &qci;
    var extension: *u8 = "VK_KHR_swapchain";
    if v -> surface != null(*u8) {
        dci.enabledExtensionCount = 1u32;
        dci.ppEnabledExtensionNames = &extension;
    }
    if !vk_ok(
        vkCreateDevice(v -> gpu.physical, &dci, null(*u8), &v -> gpu.device),
        "vkCreateDevice"
    ) {
        return false;
    }
    vkGetDeviceQueue(v -> gpu.device, v -> gpu.family, 0u32, &v -> gpu.queue);
    vkGetPhysicalDeviceMemoryProperties(v -> gpu.physical, &v -> gpu.properties);
    return true;
}

fn instance_open(v: *RenderState, extension_count: u32, extensions: **u8) -> bool {
    var app: VkApplicationInfo = uninit;
    zero(&app as *u8, sizeof(VkApplicationInfo));
    app.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO;
    app.apiVersion = VK_API_VERSION_1_2;
    var ici: VkInstanceCreateInfo = uninit;
    zero(&ici as *u8, sizeof(VkInstanceCreateInfo));
    ici.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
    ici.pApplicationInfo = &app;
    ici.enabledExtensionCount = extension_count;
    ici.ppEnabledExtensionNames = extensions;
    return vk_ok(
        vkCreateInstance(&ici, null(*u8), &v -> gpu.instance),
        "vkCreateInstance"
    );
}
fn device_open(v: *RenderState) -> bool {
    var count: u32 = 1u32;
    var result: i32 = vkEnumeratePhysicalDevices(
        v -> gpu.instance,
        &count,
        &v -> gpu.physical
    );
    // Only the first device is required, including when enumeration is truncated.
    if result != VK_SUCCESS && result != VK_INCOMPLETE {
        return vk_ok(result, "vkEnumeratePhysicalDevices");
    }
    if count == 0u32 {
        return error("no Vulkan physical device");
    }
    var families: [VkQueueFamilyProperties; 64] = uninit;
    count = 64u32;
    vkGetPhysicalDeviceQueueFamilyProperties(
        v -> gpu.physical,
        &count,
        &families[0usize]
    );
    v -> gpu.family = 0u32;
    while v -> gpu.family < count {
        if (families[v -> gpu.family as usize].queueFlags & VK_QUEUE_COMPUTE_BIT) != 0u32 {
            var supported: u32 = 1u32;
            if v -> surface != null(*u8) && !vk_ok(
                vkGetPhysicalDeviceSurfaceSupportKHR(
                    v -> gpu.physical,
                    v -> gpu.family,
                    v -> surface,
                    &supported
                ),
                "vkGetPhysicalDeviceSurfaceSupportKHR"
            ) {
                return false;
            }
            if supported != 0u32 {
                if families[v -> gpu.family as usize].timestampValidBits == 0u32 {
                    return error("compute queue requires timestamp support for GPU timing");
                }
                v -> timestamp_mask = 0xffffffffffffffffu64 >> (
                    64u64 - families[v -> gpu.family as usize].timestampValidBits as u64
                );
                break;
            }
        }
        v -> gpu.family = v -> gpu.family + 1u32;
    }
    if v -> gpu.family == count {
        return error("no compute queue in the first 64 queue families");
    }
    return device_profile(v) && device_create(v);
}

fn device_wait_idle(v: *RenderState) -> bool {
    return vk_ok(vkQueueWaitIdle(v -> gpu.queue), "wait for renderer device");
}
