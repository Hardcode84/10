fn retained_dispatch(v: *RenderState, pipeline: usize, groups: u32) -> unit {
    var count: u32 = groups;
    if count > MAX_INVOCATIONS / LOCAL_SIZE {
        count = MAX_INVOCATIONS / LOCAL_SIZE;
    }
    command_bind(v, pipeline);
    command_direct(v, count);
}
fn retained_span(
    v: *RenderState,
    slot: u32,
    first: u32,
    count: u32,
    floats: bool,
    upload: bool
) -> unit {
    var offset: u64 = (v -> mapped as *u32)[slot as usize] as u64 + first as u64 + 1u64;
    if floats {
        offset = offset + v -> words as u64 + 1u64;
    }
    if upload {
        copy_region(v, v -> staging, v -> buffer, offset * 4u64, count as u64 * 4u64);
    } else {
        copy_region(v, v -> buffer, v -> staging, offset * 4u64, count as u64 * 4u64);
    }
}
fn retained_upload(v: *RenderState) -> unit {
    if v -> mesh_dirty {
        var first: u32 = v -> mesh_dirty_begin;
        var count: u32 = v -> mesh_dirty_end - first;
        retained_upload_span(v, MESH_FLOAT, first * 15u32, count * 15u32, true);
        retained_upload_span(v, MESH_META, first * 4u32, count * 4u32, false);
        retained_upload_span(v, MESH_INDEX, first, count, false);
        retained_upload_span(v, MESH_NODES, first * 10u32, count * 10u32, false);
        retained_upload_span(v, MESH_BOUNDS, first * 14u32, count * 14u32, true);
        v -> mesh_upload_bytes = count as u64 * 176u64;
    }
    if !v -> instance_dirty {
        return;
    }
    var count: u32 = (v -> mapped as *u32)[INSTANCE_COUNT as usize];
    retained_transfer(v, INSTANCE_FLOAT, count * 18u32, true, true);
    retained_transfer(v, INSTANCE_META, count * 5u32, false, true);
}
fn retained_readback(v: *RenderState) -> unit {
    var w: *u32 = v -> mapped as *u32;
    if w[26usize] == 0u32 || w[INSTANCE_COUNT as usize] == 0u32 {
        return;
    }
    retained_transfer(
        v,
        INSTANCE_VISIBLE,
        v -> view_capacity * w[INSTANCE_COUNT as usize],
        false,
        false
    );
    copy_region(
        v,
        v -> buffer,
        v -> staging,
        (GEOMETRY as u64 + v -> words as u64 + 2u64) * 4u64,
        w[3usize] as u64 * 60u64
    );
    copy_region(
        v,
        v -> buffer,
        v -> staging,
        (w[META as usize] as u64 + 1u64) * 4u64,
        w[3usize] as u64 * 16u64
    );
}

fn retained_upload_span(
    v: *RenderState,
    slot: u32,
    first: u32,
    count: u32,
    floats: bool
) -> unit {
    retained_span(v, slot, first, count, floats, true);
}
fn retained_transfer(v: *RenderState, slot: u32, count: u32, floats: bool, upload: bool) -> unit {
    retained_span(v, slot, 0u32, count, floats, upload);
}
