record RenderState {
    growth: *StorageGrowth;
    command_dispatch_base: u32;
    bounds_portals: *u8;
    bounds_bytes: usize;
    bounds_scale: f32;
    bounds_inverse: f32;
    bounds_translation: f32;
    bounds_plane: f32;
    width: u32;
    height: u32;
    output_width: u32;
    output_height: u32;
    timestamp_mask: u64;
    mesh_capacity: u32;
    mesh_count: u32;
    instance_capacity: u32;
    mesh_dirty: bool;
    mesh_dirty_begin: u32;
    mesh_dirty_end: u32;
    instance_map_dirty: bool;
    instance_map_count: u32;
    instance_dirty: bool;
    asset_dirty_begin: u32;
    asset_dirty_end: u32;
    font_dirty: bool;
    asset_upload_bytes: u64;

    submitted: bool;
    frame_upload_bytes: u64;
    frame_readback_bytes: u64;
    frame_wait_ns: u64;
    frame_submit_ns: u64;
    frame_present_ns: u64;
    frame_trace: bool;
    frame_retired_ns: u64;
    frame_validated_ns: u64;
    frame_present_start_ns: u64;
    frame_present_done_ns: u64;
    frame_released_ns: u64;
    device_bytes: u64;
    staging_bytes: u64;
    peak_buffer_bytes: u64;
    mesh_upload_bytes: u64;
    asset_capacity: u32;
    light_capacity: u32;
    words: u32;
    floats: u32;
    tile_words: u32;
    triangle_capacity: u32;
    shadow_capacity: u32;
    projection_capacity: u32;
    batch_triangle_limit: u32;
    projection_maximum: u32;
    view_capacity: u32;
    portal_capacity: u32;
    task_capacity: u32;
    work_rounds: u32;
    scheduled_rounds: u32;
    frame_chunks: u32;
    query_count: u32;
    storage_limit: u32;

    buffer: *u8;

    mapped: *u8;
    staging: *u8;

    read_pixels: bool;
    shader_checks: bool;

    surface: *u8;

    swapchain_dirty: bool;
    present_ready: bool;

    timestamp_period: f32;

    gpu: RenderBackend;
}
opaque;

fn buffer_create(v: *RenderState) -> bool {
    if v -> shadow_capacity == 0u32 {
        v -> shadow_capacity = 1u32;
    }
    if v -> projection_capacity == 0u32 {
        v -> projection_capacity = 1u32;
    }
    if v -> view_capacity == 0u32 {
        v -> view_capacity = 1u32;
    }
    if v -> triangle_capacity == 0u32 && !geometry_layout(v, 1u32) {
        return false;
    }
    var staging_size: u64 = status_buffer_offset(v);
    var size: u64 = staging_size + v -> shader_checks as u64 * MAX_INVOCATIONS as u64 * 4u64;
    if !buffers_allocate(v, size, staging_size) {
        return false;
    }
    zero(v -> mapped, (staging_size) as usize);
    buffer_initialize(v);
    return true;
}
fn buffer_initialize(v: *RenderState) -> unit {
    (v -> mapped as *u32)[0usize] = v -> words;
    (v -> mapped as *u32)[(v -> words + 1u32) as usize] = v -> floats;
    ((v -> mapped + tile_buffer_offset(v) as isize) as *u32)[0usize] = v -> tile_words;
    v -> mapped = v -> mapped + 4isize;
    geometry_header(v);
    v -> asset_dirty_begin = 0u32;
    v -> asset_dirty_end = v -> asset_capacity;
    v -> font_dirty = true;
    v -> instance_dirty = true;
    var bytes: u64 = v -> device_bytes + v -> staging_bytes;
    if bytes > v -> peak_buffer_bytes {
        v -> peak_buffer_bytes = bytes;
    }
}
record ShaderCode {
    bytes: *u8;
    size: usize;
}
opaque;

fn render_trace_clock(v: *RenderState) -> u64 {
    if v -> frame_trace {
        return render_now();
    }
    return 0u64;
}
