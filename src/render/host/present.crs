fn surface_extent(
    caps: *VkSurfaceCapabilitiesKHR,
    width: u32,
    height: u32,
    output: *VkExtent2D
) -> bool {
    if (caps -> supportedUsageFlags & 2u32) == 0u32 || (caps -> supportedCompositeAlpha & 1u32) == 0u32 {
        return error("surface requires transfer destination and opaque alpha support");
    }
    var extent: VkExtent2D = make VkExtent2D {
        width: width,
        height: height
    };
    if caps -> currentExtent.width != 0xffffffffu32 {
        extent = caps -> currentExtent;
    }
    if extent.width != width || extent.height != height {
        return error("surface extent differs from requested output extent");
    }
    if width < caps -> minImageExtent.width || width > caps -> maxImageExtent.width || height < caps -> minImageExtent.height || height > caps -> maxImageExtent.height {
        return error("requested output extent exceeds surface limits");
    }
    * output = extent;
    return true;
}
fn surface_format(v: *RenderState, format: *VkSurfaceFormatKHR) -> bool {
    var count: u32 = 0u32;
    if !vk_ok(
        vkGetPhysicalDeviceSurfaceFormatsKHR(
            v -> gpu.physical,
            v -> surface,
            &count,
            null(*VkSurfaceFormatKHR)
        ),
        "vkGetPhysicalDeviceSurfaceFormatsKHR"
    ) {
        return false;
    }
    var formats: *VkSurfaceFormatKHR = malloc(count as usize * sizeof(VkSurfaceFormatKHR)) as *VkSurfaceFormatKHR;
    if formats == null(*VkSurfaceFormatKHR) {
        return error("surface format allocation failed");
    }
    var good: bool = vk_ok(
        vkGetPhysicalDeviceSurfaceFormatsKHR(
            v -> gpu.physical,
            v -> surface,
            &count,
            formats
        ),
        "vkGetPhysicalDeviceSurfaceFormatsKHR"
    );
    var found: bool = false;
    var i: usize = 0usize;
    while good && i < count as usize {
        if (formats[i].format == 37u32 || formats[i].format == 44u32) && formats[i].colorSpace == 0u32 {
            *format = formats[i];
            found = true;
        }
        i = i + 1usize;
    }
    free(formats as *u8);
    if !good || !found {
        return error("surface requires RGBA8 or BGRA8 UNORM with SRGB nonlinear colour space");
    }
    return true;
}
fn swapchain_open(v: *RenderState, width: u32, height: u32) -> bool {
    var caps: VkSurfaceCapabilitiesKHR = uninit;
    var format: VkSurfaceFormatKHR = uninit;
    if !vk_ok(
        vkGetPhysicalDeviceSurfaceCapabilitiesKHR(v -> gpu.physical, v -> surface, &caps),
        "vkGetPhysicalDeviceSurfaceCapabilitiesKHR"
    ) || !surface_format(v, &format) {
        return false;
    }
    if caps.currentExtent.width != 0xffffffffu32 && (
        caps.currentExtent.width != width || caps.currentExtent.height != height
    ) {
        v -> swapchain_dirty = true;
        return true;
    }
    var extent: VkExtent2D = uninit;
    if !surface_extent(&caps, width, height, &extent) {
        return false;
    }
    var info: VkSwapchainCreateInfoKHR = uninit;
    zero(&info as *u8, sizeof(VkSwapchainCreateInfoKHR));
    info.sType = 1000001000u32;
    info.surface = v -> surface;
    info.minImageCount = caps.minImageCount + 1u32;
    if caps.maxImageCount != 0u32 && info.minImageCount > caps.maxImageCount {
        info.minImageCount = caps.maxImageCount;
    }
    info.imageFormat = format.format;
    info.imageColorSpace = format.colorSpace;
    info.imageExtent = extent;
    info.imageArrayLayers = 1u32;
    info.imageUsage = 2u32;
    info.preTransform = caps.currentTransform;
    info.compositeAlpha = 1u32;
    info.presentMode = 2u32;
    info.clipped = 1u32;
    var result: i32 = vkCreateSwapchainKHR(
        v -> gpu.device,
        &info,
        null(*u8),
        &v -> gpu.swapchain
    );
    if result == -1000001004i32 {
        v -> swapchain_dirty = true;
        return true;
    }
    if !vk_ok(result, "vkCreateSwapchainKHR") {
        return false;
    }
    (v -> mapped as *u32)[21usize] = format.format;
    v -> swapchain_dirty = false;
    return swapchain_resources(v);
}
fn swapchain_resources(v: *RenderState) -> bool {
    var count: u32 = 0u32;
    if !vk_ok(
        vkGetSwapchainImagesKHR(
            v -> gpu.device,
            v -> gpu.swapchain,
            &count,
            null(**u8)
        ),
        "vkGetSwapchainImagesKHR"
    ) {
        return false;
    }
    v -> gpu.images = malloc(count as usize * sizeof(*u8)) as **u8;
    if v -> gpu.images == null(**u8) {
        return error("swapchain image list allocation failed");
    }
    if !vk_ok(
        vkGetSwapchainImagesKHR(
            v -> gpu.device,
            v -> gpu.swapchain,
            &count,
            v -> gpu.images
        ),
        "vkGetSwapchainImagesKHR"
    ) {
        return false;
    }
    if !present_semaphores_open(v, count) {
        return false;
    }
    if v -> gpu.acquired != null(*u8) {
        return true;
    }
    if !present_semaphore_create(v, &v -> gpu.acquired) {
        return false;
    }
    var allocation: VkCommandBufferAllocateInfo = uninit;
    zero(&allocation as *u8, sizeof(VkCommandBufferAllocateInfo));
    allocation.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    allocation.commandPool = v -> gpu.command_pool;
    allocation.commandBufferCount = 1u32;
    if !vk_ok(
        vkAllocateCommandBuffers(v -> gpu.device, &allocation, &v -> gpu.present_commands),
        "vkAllocateCommandBuffers"
    ) {
        return false;
    }
    return true;
}
fn present_record(v: *RenderState, index: u32, width: u32, height: u32) -> bool {
    if !vk_ok(
        vkResetCommandBuffer(v -> gpu.present_commands, 0u32),
        "vkResetCommandBuffer"
    ) {
        return false;
    }
    var begin: VkCommandBufferBeginInfo = uninit;
    zero(&begin as *u8, sizeof(VkCommandBufferBeginInfo));
    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    if !vk_ok(
        vkBeginCommandBuffer(v -> gpu.present_commands, &begin),
        "vkBeginCommandBuffer"
    ) {
        return false;
    }
    var b: VkImageMemoryBarrier = uninit;
    zero(&b as *u8, sizeof(VkImageMemoryBarrier));
    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
    b.oldLayout = 0u32;
    b.newLayout = 7u32;
    b.dstAccessMask = 4096u32;
    b.srcQueueFamilyIndex = 0xffffffffu32;
    b.dstQueueFamilyIndex = 0xffffffffu32;
    b.image = v -> gpu.images[index as usize];
    b.subresourceRange = make VkImageSubresourceRange {
        aspectMask: 1u32,
        baseMipLevel: 0u32,
        levelCount: 1u32,
        baseArrayLayer: 0u32,
        layerCount: 1u32
    };
    vkCmdPipelineBarrier(
        v -> gpu.present_commands,
        4096u32,
        4096u32,
        0u32,
        0u32,
        null(*VkMemoryBarrier),
        0u32,
        null(*u8),
        1u32,
        &b
    );
    var region: VkBufferImageCopy = uninit;
    zero(&region as *u8, sizeof(VkBufferImageCopy));
    region.bufferOffset = 4u64 + ((v -> mapped as *u32)[PRESENT_PIXELS as usize] as u64) * 4u64;
    region.imageSubresource = make VkImageSubresourceLayers {
        aspectMask: 1u32,
        mipLevel: 0u32,
        baseArrayLayer: 0u32,
        layerCount: 1u32
    };
    region.imageExtent = make VkExtent3D {
        width: width,
        height: height,
        depth: 1u32
    };
    vkCmdCopyBufferToImage(
        v -> gpu.present_commands,
        v -> buffer,
        v -> gpu.images[index as usize],
        7u32,
        1u32,
        &region
    );
    b.oldLayout = 7u32;
    b.newLayout = 1000001002u32;
    b.srcAccessMask = 4096u32;
    b.dstAccessMask = 0u32;
    vkCmdPipelineBarrier(
        v -> gpu.present_commands,
        4096u32,
        8192u32,
        0u32,
        0u32,
        null(*VkMemoryBarrier),
        0u32,
        null(*u8),
        1u32,
        &b
    );
    return vk_ok(vkEndCommandBuffer(v -> gpu.present_commands), "vkEndCommandBuffer");
}
fn present(v: *RenderState) -> bool {
    v -> frame_present_start_ns = render_trace_clock(v);
    var good: bool = present_image(v);
    v -> frame_present_done_ns = render_trace_clock(v);
    return good;
}
fn present_image(v: *RenderState) -> bool {
    if !v -> present_ready {
        return true;
    }
    v -> present_ready = false;
    var index: u32 = 0u32;
    var result: i32 = vkAcquireNextImageKHR(
        v -> gpu.device,
        v -> gpu.swapchain,
        ~0u64,
        v -> gpu.acquired,
        null(*u8),
        &index
    );
    if result == -1000001004i32 {
        v -> swapchain_dirty = true;
        return true;
    }
    if result == 1000001003i32 {
        v -> swapchain_dirty = true;
    }
    if result != 0i32 && result != 1000001003i32 {
        return vk_ok(result, "vkAcquireNextImageKHR");
    }
    if !present_record(v, index, v -> output_width, v -> output_height) {
        return false;
    }
    var submit: VkSubmitInfo = uninit;
    zero(&submit as *u8, sizeof(VkSubmitInfo));
    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
    var stage: u32 = 4096u32;
    submit.waitSemaphoreCount = 1u32;
    submit.pWaitSemaphores = &v -> gpu.acquired;
    submit.pWaitDstStageMask = &stage;
    submit.signalSemaphoreCount = 1u32;
    submit.pSignalSemaphores = &v -> gpu.present_semaphores[index as usize];
    submit.commandBufferCount = 1u32;
    submit.pCommandBuffers = &v -> gpu.present_commands;
    if !vk_ok(
        vkQueueSubmit(v -> gpu.queue, 1u32, &submit, null(*u8)),
        "vkQueueSubmit presentation"
    ) {
        return false;
    }
    return present_release(v, index);
}
fn present_release(v: *RenderState, index: u32) -> bool {
    var info: VkPresentInfoKHR = uninit;
    zero(&info as *u8, sizeof(VkPresentInfoKHR));
    info.sType = 1000001001u32;
    info.waitSemaphoreCount = 1u32;
    info.pWaitSemaphores = &v -> gpu.present_semaphores[index as usize];
    info.swapchainCount = 1u32;
    info.pSwapchains = &v -> gpu.swapchain;
    info.pImageIndices = &index;
    v -> frame_present_ns = render_now();
    var result: i32 = vkQueuePresentKHR(v -> gpu.queue, &info);
    if result == -1000001004i32 || result == 1000001003i32 {
        v -> swapchain_dirty = true;
    }
    if result == -1000001004i32 {
        return true;
    }
    if result != 0i32 && result != 1000001003i32 {
        return vk_ok(result, "vkQueuePresentKHR");
    }
    return true;
}

fn swapchain_close(v: *RenderState) -> unit {
    var i: usize = 0usize;
    while i < v -> gpu.present_semaphore_count as usize {
        vkDestroySemaphore(
            v -> gpu.device,
            v -> gpu.present_semaphores[i],
            null(*u8)
        );
        i = i + 1usize;
    }
    free(v -> gpu.present_semaphores as *u8);
    v -> gpu.present_semaphores = null(**u8);
    v -> gpu.present_semaphore_count = 0u32;
    if v -> gpu.swapchain != null(*u8) {
        vkDestroySwapchainKHR(v -> gpu.device, v -> gpu.swapchain, null(*u8));
        v -> gpu.swapchain = null(*u8);
    }
    free(v -> gpu.images as *u8);
    v -> gpu.images = null(**u8);
}

fn present_semaphore_create(v: *RenderState, semaphore: **u8) -> bool {
    var info: VkSemaphoreCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkSemaphoreCreateInfo));
    info.sType = 9u32;
    return vk_ok(
        vkCreateSemaphore(v -> gpu.device, &info, null(*u8), semaphore),
        "create presentation semaphore"
    );
}
fn present_semaphores_open(v: *RenderState, count: u32) -> bool {
    v -> gpu.present_semaphores = malloc(count as usize * sizeof(*u8)) as **u8;
    if v -> gpu.present_semaphores == null(**u8) {
        return error("presentation semaphore list allocation failed");
    }
    while v -> gpu.present_semaphore_count < count {
        if !present_semaphore_create(
            v,
            &v -> gpu.present_semaphores[v -> gpu.present_semaphore_count as usize]
        ) {
            return false;
        }
        v -> gpu.present_semaphore_count = v -> gpu.present_semaphore_count + 1u32;
    }
    return true;
}
