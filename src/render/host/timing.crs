fn queries_create(v: *RenderState) -> bool {
    var info: VkQueryPoolCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkQueryPoolCreateInfo));
    info.sType = 11u32;
    info.queryType = 2u32;
    info.queryCount = v -> query_count;
    return vk_ok(
        vkCreateQueryPool(v -> gpu.device, &info, null(*u8), &v -> gpu.query_pool),
        "vkCreateQueryPool"
    );
}
fn queries_read(v: *RenderState, values: *u64) -> bool {
    if !vk_ok(
        vkGetQueryPoolResults(
            v -> gpu.device,
            v -> gpu.query_pool,
            0u32,
            v -> query_count,
            v -> query_count as usize * 8usize,
            values as *u8,
            8u64,
            3u32
        ),
        "vkGetQueryPoolResults"
    ) {
        return false;
    }
    return true;
}
record RenderTimespec {
    seconds: i64;
    nanoseconds: isize;
}
extern fn render_clock_gettime(clock: i32, time: *RenderTimespec) -> i32 = "clock_gettime";
fn render_now() -> u64 {
    var time: RenderTimespec = uninit;
    if render_clock_gettime(1i32, &time) != 0i32 {
        error("renderer monotonic clock failed");
        exit(1i32);
    }
    return time.seconds as u64 * 1000000000u64 + time.nanoseconds as u64;
}
fn retirement_create(v: *RenderState) -> bool {
    var info: VkFenceCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkFenceCreateInfo));
    info.sType = 8u32;
    return vk_ok(
        vkCreateFence(v -> gpu.device, &info, null(*u8), &v -> gpu.retired),
        "create renderer retirement fence"
    );
}
fn retirement_wait(v: *RenderState) -> unit {
    if v -> gpu.observer_pending {
        retirement_observer_drain(v);
        return;
    }
    if !v -> submitted {
        return;
    }
    var start: u64 = render_now();
    if !vk_ok(
        vkWaitForFences(v -> gpu.device, 1u32, &v -> gpu.retired, 1u32, ~0u64),
        "wait for renderer retirement"
    ) {
        exit(1i32);
        return;
    }
    v -> frame_wait_ns = render_now() - start;
    v -> submitted = false;
}
fn retirement_close(v: *RenderState) -> unit {
    retirement_wait(v);
    if v -> gpu.retired != null(*u8) {
        vkDestroyFence(v -> gpu.device, v -> gpu.retired, null(*u8));
    }
}

// Returns pending, complete, or failed. Completion makes staging reads visible.
fn retirement_poll(v: *RenderState) -> i32 {
    if v -> gpu.observer_pending {
        return retirement_observer_poll(v);
    }
    if !v -> submitted {
        return 1i32;
    }
    var result: i32 = vkGetFenceStatus(v -> gpu.device, v -> gpu.retired);
    if result == 1i32 {
        return 0i32;
    }
    if !vk_ok(result, "poll renderer retirement") {
        return -1i32;
    }
    v -> submitted = false;
    return 1i32;
}
