fn render_shader_name(slot: usize, checked: bool) -> *u8 {
    var paths: [*u8; 41] = make [*u8; 41] {
        "init",
        "transform",
        "raster",
        "advance",
        "compose",
        "compact",
        "scan",
        "fill",
        "instances",
        "visibility",
        "bin",
        "shadow-build",
        "shadow-top",
        "shade",
        "batch-plan",
        "tile",
        "projected-build",
        "projected-bin",
        "tile-list",
        "tile-list-raster",
        "init.debug",
        "transform.debug",
        "raster.debug",
        "advance.debug",
        "compose.debug",
        "compact.debug",
        "scan.debug",
        "fill.debug",
        "instances.debug",
        "visibility.debug",
        "bin.debug",
        "shadow-build.debug",
        "shadow-top.debug",
        "shade.debug",
        "batch-plan.debug",
        "tile.debug",
        "projected-build.debug",
        "projected-bin.debug",
        "tile-list.debug",
        "tile-list-raster.debug",
        "status.debug"
    };
    return paths[slot + checked as usize * 20usize];
}
