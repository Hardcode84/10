fn light_blocks(tri: u32, ox: f32, oy: f32, oz: f32, dx: f32, dy: f32, dz: f32) -> bool {
    var p: u32 = GEOMETRY + tri * 15u32;
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var az: f32 = floats_load(p + 2u32);
    var bx: f32 = floats_load(p + 5u32) - ax;
    var by: f32 = floats_load(p + 6u32) - ay;
    var bz: f32 = floats_load(p + 7u32) - az;
    var cx: f32 = floats_load(p + 10u32) - ax;
    var cy: f32 = floats_load(p + 11u32) - ay;
    var cz: f32 = floats_load(p + 12u32) - az;
    var qx: f32 = dy * cz - dz * cy;
    var qy: f32 = dz * cx - dx * cz;
    var qz: f32 = dx * cy - dy * cx;
    var det: f32 = bx * qx + by * qy + bz * qz;
    if det == 0f32 {
        return false;
    }
    var tx: f32 = ox - ax;
    var ty: f32 = oy - ay;
    var tz: f32 = oz - az;
    var u: f32 = (tx * qx + ty * qy + tz * qz) / det;
    if u < 0f32 || u > 1f32 {
        return false;
    }
    var rx: f32 = ty * bz - tz * by;
    var ry: f32 = tz * bx - tx * bz;
    var rz: f32 = tx * by - ty * bx;
    var v: f32 = (dx * rx + dy * ry + dz * rz) / det;
    if v < 0f32 || u + v > 1f32 {
        return false;
    }
    var t: f32 = (cx * rx + cy * ry + cz * rz) / det;
    if t <= 0.00001f32 || t >= 0.99999f32 {
        return false;
    }
    var meta: u32 = words_load(META) + tri * 4u32;
    if (words_load(meta + 3u32) & 1u32) == 0u32 {
        return true;
    }
    var tu: f32 = floats_load(p + 3u32) + u * (
        floats_load(p + 8u32) - floats_load(p + 3u32)
    ) + v * (floats_load(p + 13u32) - floats_load(p + 3u32));
    var tv: f32 = floats_load(p + 4u32) + u * (
        floats_load(p + 9u32) - floats_load(p + 4u32)
    ) + v * (floats_load(p + 14u32) - floats_load(p + 4u32));
    var mat: u32 = words_load(meta + 1u32);
    return material_texel(mat, tu, tv) != material_field(mat, 9u32);
}
fn shadow_abs(value: f32) -> f32 {
    if value < 0f32 {
        return -value;
    }
    return value;
}
fn shadow_intersects(node: u32, ox: f32, oy: f32, oz: f32, dx: f32, dy: f32, dz: f32) -> bool {
    var near: f32 = 0f32;
    var far: f32 = 1f32;
    var axis: u32 = 0u32;
    while axis < 3u32 {
        var origin: f32 = ox;
        var direction: f32 = dx;
        if axis == 1u32 {
            origin = oy;
            direction = dy;
        }
        if axis == 2u32 {
            origin = oz;
            direction = dz;
        }
        var p: u32 = words_load(SHADOW_BOUNDS) + node * 6u32 + axis;
        var low: f32 = floats_load(p);
        var high: f32 = floats_load(p + 3u32);
        if direction == 0f32 {
            if origin < low || origin > high {
                return false;
            }
        } else {
            var a: f32 = (low - origin) / direction;
            var b: f32 = (high - origin) / direction;
            if a > b {
                var swap: f32 = a;
                a = b;
                b = swap;
            }
            if a > near {
                near = a;
            }
            if b < far {
                far = b;
            }
            if near > far {
                return false;
            }
        }
        axis = axis + 1u32;
    }
    return true;
}
fn shadow_leaf(
    first: u32,
    count: u32,
    receiver: u32,
    shift: u32,
    ox: f32,
    oy: f32,
    oz: f32,
    dx: f32,
    dy: f32,
    dz: f32
) -> bool {
    var i: u32 = 0u32;
    while i < count {
        var tri: u32 = words_load(words_load(SHADOW_INDEX) + first + i) + shift;
        if tri != receiver && light_blocks(tri, ox, oy, oz, dx, dy, dz) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn shadow_visible(
    root: u32,
    receiver: u32,
    shift: u32,
    ox: f32,
    oy: f32,
    oz: f32,
    dx: f32,
    dy: f32,
    dz: f32
) -> bool {
    var node: u32 = root;
    if words_load(words_load(SHADOW_NODES) + node * 4u32 + 1u32) == 0u32 {
        return true;
    }
    while node != 0xffffffffu32 {
        var p: u32 = words_load(SHADOW_NODES) + node * 4u32;
        var next: u32 = words_load(p + 2u32);
        if shadow_intersects(node, ox, oy, oz, dx, dy, dz) {
            var child: u32 = words_load(p + 3u32);
            if child != 0xffffffffu32 {
                next = child;
            } else if !shadow_leaf(
                words_load(p),
                words_load(p + 1u32),
                receiver,
                shift,
                ox,
                oy,
                oz,
                dx,
                dy,
                dz
            ) {
                return false;
            }
        }
        node = next;
    }
    return true;
}

fn shadow_instances(
    first: u32,
    count: u32,
    receiver: u32,
    ox: f32,
    oy: f32,
    oz: f32,
    dx: f32,
    dy: f32,
    dz: f32
) -> bool {
    var i: u32 = 0u32;
    var shift: u32 = words_load(DYNAMIC_COUNT);
    while i < count {
        var instance: u32 = words_load(words_load(SHADOW_INDEX) + first + i);
        var p: u32 = words_load(INSTANCE_META) + instance * 5u32;
        var root: u32 = (words_load(p + 2u32) - shift) * 2u32;
        if !shadow_visible(root, receiver, shift, ox, oy, oz, dx, dy, dz) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn light_visible(
    light: u32,
    receiver: u32,
    ox: f32,
    oy: f32,
    oz: f32,
    lx: f32,
    ly: f32,
    lz: f32
) -> bool {
    var dx: f32 = lx - ox;
    var dy: f32 = ly - oy;
    var dz: f32 = lz - oz;
    var dynamic_root: u32 = (light + 1u32) * words_load(SCENE_CAPACITY) * 2u32;
    if !shadow_visible(dynamic_root, receiver, 0u32, ox, oy, oz, dx, dy, dz) {
        return false;
    }
    var node: u32 = (words_load(SHADOW_TOP) + light * words_load(INSTANCE_CAPACITY)) * 2u32;
    if words_load(words_load(SHADOW_NODES) + node * 4u32 + 1u32) == 0u32 {
        return true;
    }
    while node != 0xffffffffu32 {
        var p: u32 = words_load(SHADOW_NODES) + node * 4u32;
        var next: u32 = words_load(p + 2u32);
        if shadow_intersects(node, ox, oy, oz, dx, dy, dz) {
            var child: u32 = words_load(p + 3u32);
            if child != 0xffffffffu32 {
                next = child;
            } else if !shadow_instances(
                words_load(p),
                words_load(p + 1u32),
                receiver,
                ox,
                oy,
                oz,
                dx,
                dy,
                dz
            ) {
                return false;
            }
        }
        node = next;
    }
    return true;
}
