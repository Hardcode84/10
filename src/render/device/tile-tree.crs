fn tile_plane(view: u32, plane: u32, axis: u32, absolute: bool) -> f32 {
    var p: u32 = words_load(VIEW_FLOAT) + view * PORTAL_TRANSFORM_WORDS;
    if plane < 2u32 {
        var value: f32 = floats_load(p + (8u32 + plane * 4u32) + axis);
        if absolute {
            return shadow_abs(value);
        }
        return value;
    }

    var h: f32 = words_load(1u32) as f32;
    var w: f32 = words_load(0u32) as f32;
    var factor: f32 = (w - 2f32 * (shared_load(6u32) as f32 - 1f32)) / h;
    if plane == 3u32 {
        factor = (2f32 * (shared_load(6u32) + 9u32) as f32 - w) / h;
    }
    if plane == 4u32 {
        factor = 2f32 * (shared_load(7u32) + 9u32) as f32 / h - 1f32;
    }
    if plane == 5u32 {
        factor = 1f32 - 2f32 * (shared_load(7u32) as f32 - 1f32) / h;
    }
    var row: u32 = 0u32;
    if plane >= 4u32 {
        row = 4u32;
    }
    var value: f32 = floats_load(p + row + axis);
    if plane % 2u32 != 0u32 {
        value = -value;
    }
    var z: f32 = floats_load(p + 8u32 + axis) * floats_load(PROJECTION) * factor;
    if absolute {
        return shadow_abs(z) + shadow_abs(value);
    }
    return z + value;
}
fn tile_local_plane(view: u32, instance: u32, plane: u32, axis: u32, absolute: bool) -> f32 {
    if instance == 0xffffffffu32 {
        return tile_plane(view, plane, axis, absolute);
    }
    var matrix: u32 = words_load(INSTANCE_FLOAT) + instance * 18u32;
    var value: f32 = 0f32;
    if axis == 3u32 {
        value = tile_plane(view, plane, 3u32, absolute);
    }
    var row: u32 = 0u32;
    while row < 3u32 {
        var coefficient: f32 = floats_load(matrix + row * 4u32 + axis);
        if absolute {
            coefficient = shadow_abs(coefficient);
        }
        value = value + tile_plane(view, plane, row, absolute) * coefficient;
        row = row + 1u32;
    }
    return value;
}
fn tile_node_visible(node: u32) -> bool {
    if (words_load(words_load(MESH_NODES) + node * 5u32 + 4u32) & 2u32) != 0u32 {
        return true;
    }
    var p: u32 = 2432u32;
    var bounds: u32 = words_load(MESH_BOUNDS) + node * 7u32;
    var plane: u32 = 0u32;
    while plane < 6u32 {
        var maximum: f32 = local_load(p + plane * 4u32 + 3u32);
        var magnitude: f32 = local_load(p + plane * 4u32 + 27u32);
        var axis: u32 = 0u32;
        while axis < 3u32 {
            var coefficient: f32 = local_load(p + plane * 4u32 + axis);
            var low: f32 = floats_load(bounds + axis);
            var high: f32 = floats_load(bounds + axis + 3u32);
            var value: f32 = high;
            if coefficient < 0f32 {
                value = low;
            }
            maximum = maximum + coefficient * value;
            magnitude = magnitude + local_load(p + plane * 4u32 + axis + 24u32) * (
                shadow_abs(low) + shadow_abs(high)
            );
            axis = axis + 1u32;
        }
        if maximum < -0.00001f32 * (magnitude + 1f32) {
            return false;
        }
        plane = plane + 1u32;
    }
    return true;
}
fn tile_begin(task: u32, view: u32, tile: u32) -> unit {
    var begin: u32 = 0u32;
    var end: u32 = 0u32;
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        var meta: u32 = words_load(VIEW_META) + view * 4u32;
        begin = words_load(meta + 1u32);
        end = begin + words_load(meta + 2u32);
    }
    shared_store(0u32, 1u32);
    shared_store(1u32, begin);
    shared_store(2u32, end);
    shared_store(3u32, 0xffffffffu32);
    shared_store(4u32, 0u32);
    shared_store(5u32, 0u32);
    var cols: u32 = (words_load(0u32) + 7u32) / 8u32;
    shared_store(6u32, tile % cols * 8u32);
    shared_store(7u32, tile / cols * 8u32);
}
fn tile_range_begin(view: u32, instance: u32) -> unit {
    shared_store(3u32, words_load(words_load(INSTANCE_META) + instance * 5u32) * 2u32);
    shared_store(4u32, 0u32);
    shared_store(5u32, 1u32);
}

fn tile_seed(lane: u32, instance: u32) -> unit {
    var node: u32 = words_load(words_load(INSTANCE_META) + instance * 5u32) * 2u32;
    var bits: u32 = 3u32;
    while bits != 0u32 {
        var p: u32 = words_load(MESH_NODES) + node * 5u32;
        if words_load(p + 1u32) <= 4u32 {
            if lane % (1u32 << bits) != 0u32 {
                node = 0xffffffffu32;
            }
            bits = 0u32;
        } else {
            bits = bits - 1u32;
            node = words_load(p + 3u32);
            if (lane & (1u32 << bits)) != 0u32 {
                node = words_load(words_load(MESH_NODES) + node * 5u32 + 2u32);
            }
        }
    }
    var end: u32 = 0xffffffffu32;
    if node != end {
        end = words_load(words_load(MESH_NODES) + node * 5u32 + 2u32);
    }
    shared_store(16u32 + lane * 3u32, node);
    shared_store(17u32 + lane * 3u32, end);
    shared_store(18u32 + lane * 3u32, 0u32);
}
fn tile_mesh_next(lane: u32, instance: u32) -> u32 {
    var state: u32 = 16u32 + lane * 3u32;
    var node: u32 = shared_load(state);
    var end: u32 = shared_load(state + 1u32);
    while node != end {
        if words_load(26u32) != 0u32 {
            shared_store(80u32 + lane, shared_load(80u32 + lane) + 1u32);
        }
        var p: u32 = words_load(MESH_NODES) + node * 5u32;
        if shared_load(state + 2u32) != 0u32 || words_load(CULL_DISABLED) != 0u32 || tile_node_visible(
            node
        ) {
            if words_load(p + 1u32) <= 4u32 {
                var offset: u32 = shared_load(state + 2u32);
                var tri: u32 = words_load(words_load(MESH_INDEX) + words_load(p) + offset);
                var info: u32 = words_load(INSTANCE_META) + instance * 5u32;
                offset = offset + 1u32;
                if offset == words_load(p + 1u32) {
                    node = words_load(p + 2u32);
                    offset = 0u32;
                }
                shared_store(state, node);
                shared_store(state + 2u32, offset);
                return tri + words_load(info + 2u32) - words_load(info);
            }
            node = words_load(p + 3u32);
        } else {
            node = words_load(p + 2u32);
        }
    }
    shared_store(state, end);
    return 0xffffffffu32;
}
fn tile_range_setup(view: u32) -> unit {
    shared_store(8u32, 0u32);
    shared_store(9u32, 0xffffffffu32);
    shared_store(10u32, 1u32);
    if shared_load(1u32) < shared_load(2u32) {
        var instance: u32 = words_load(
            words_load(SPACE_TRIANGLES) + shared_load(1u32) * 4u32 + 3u32
        );
        shared_store(9u32, instance);
        if instance == 0xffffffffu32 {
            var count: u32 = 1u32;
            while count < 8u32 && shared_load(1u32) + count < shared_load(2u32) && words_load(
                words_load(SPACE_TRIANGLES) + (shared_load(1u32) + count) * 4u32 + 3u32
            ) == 0xffffffffu32 {
                count = count + 1u32;
            }
            shared_store(10u32, count);
        }
        if instance != 0xffffffffu32 && shared_load(5u32) == 0u32 {
            shared_store(5u32, 1u32);
            shared_store(8u32, 1u32);
        }
    }
}
fn tile_worker(lane: u32) -> unit {
    var tri: u32 = 0xffffffffu32;
    if shared_load(1u32) < shared_load(2u32) {
        if shared_load(9u32) == 0xffffffffu32 {
            if lane < shared_load(10u32) {
                tri = words_load(
                    words_load(SPACE_TRIANGLES) + (shared_load(1u32) + lane) * 4u32 + 1u32
                );
            }
        } else {
            tri = tile_mesh_next(lane, shared_load(9u32));
        }
    }
    shared_store(64u32 + lane, tri);
    if words_load(26u32) != 0u32 && tri != 0xffffffffu32 {
        shared_store(88u32 + lane, shared_load(88u32 + lane) + 1u32);
    }
}
fn tile_finish_chunk() -> unit {
    var more: bool = false;
    if shared_load(9u32) != 0xffffffffu32 {
        var lane: u32 = 0u32;
        while lane < 8u32 {
            more = more || shared_load(16u32 + lane * 3u32) != shared_load(17u32 + lane * 3u32);
            lane = lane + 1u32;
        }
    }
    if !more {
        shared_store(1u32, shared_load(1u32) + shared_load(10u32));
        shared_store(5u32, 0u32);
    }
    shared_store(0u32, (shared_load(1u32) < shared_load(2u32)) as u32);
}

fn tile_diagnostics(task: u32) -> unit {
    var nodes: u32 = 0u32;
    var triangles: u32 = 0u32;
    var lane: u32 = 0u32;
    while lane < 8u32 {
        nodes = nodes + shared_load(80u32 + lane);
        triangles = triangles + shared_load(88u32 + lane);
        lane = lane + 1u32;
    }
    var p: u32 = words_load(TILE_STATS) + task * 4u32;
    words_store(p, words_load(p) + nodes);
    words_store(p + 1u32, words_load(p + 1u32) + triangles);
    words_store(p + 2u32, words_load(p + 2u32) + shared_load(96u32));
}
