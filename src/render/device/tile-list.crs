fn compute() -> unit {
    if words_load(5u32) != 0u32 {
        return;
    }
    var tiles: u32 = ((words_load(0u32) + 7u32) / 8u32) * ((words_load(1u32) + 7u32) / 8u32);
    var i: u32 = shader_global_x();
    while i < tiles {
        tile_write(words_load(TILE_STATS) + i * 4u32, 0u32);
        i = i + MAX_INVOCATIONS;
    }
}
