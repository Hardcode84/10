fn child_view(parent: u32, portal: u32, view: u32) -> unit {
    var src: u32 = words_load(VIEW_FLOAT) + parent * PORTAL_TRANSFORM_WORDS;
    var transform: u32 = words_load(PORTAL_FLOAT) + portal * PORTAL_TRANSFORM_WORDS;
    var dst: u32 = words_load(VIEW_FLOAT) + view * PORTAL_TRANSFORM_WORDS;
    var r: u32 = 0u32;
    while r < 3u32 {
        var c: u32 = 0u32;
        while c < 4u32 {
            var value: f32 = floats_load(src + r * 4u32) * floats_load(transform + c) + floats_load(
                src + r * 4u32 + 1u32
            ) * floats_load(transform + 4u32 + c) + floats_load(src + r * 4u32 + 2u32) * floats_load(
                transform + 8u32 + c
            );
            if c == 3u32 {
                value = value + floats_load(src + r * 4u32 + 3u32);
            }
            floats_store(dst + r * 4u32 + c, value);
            c = c + 1u32;
        }
        r = r + 1u32;
    }
    r = 0u32;
    while r < 4u32 {
        floats_store(dst + 12u32 + r, floats_load(transform + 12u32 + r));
        r = r + 1u32;
    }
    floats_store(dst + 16u32, floats_load(src + 16u32) * floats_load(transform + 16u32));
    view_space(view, words_load(words_load(PORTAL_META) + portal * 4u32 + 1u32));
    words_store(
        words_load(VIEW_META) + view * 4u32 + 3u32,
        words_load(words_load(PORTAL_META) + portal * 4u32 + 2u32)
    );
}
fn allocate_key_word(word: u32, mask: u32, views: u32) -> u32 {
    var next: u32 = views;
    var bit: u32 = 0u32;
    while bit < 32u32 {
        if (mask & (1u32 << bit)) != 0u32 {
            if next == words_load(31u32) {
                words_store(5u32, 2u32);
                return next;
            }
            var key: u32 = word * 32u32 + bit;
            words_store(words_load(VIEW_MAP) + key, next);
            child_view(
                key / words_load(PORTAL_CAPACITY),
                key % words_load(PORTAL_CAPACITY),
                next
            );
            next = next + 1u32;
        }
        bit = bit + 1u32;
    }
    return next;
}
fn allocate_views(views: u32) -> u32 {
    var next: u32 = views;
    var word: u32 = words_load(9u32) * words_load(PORTAL_CAPACITY) / 32u32;
    var end: u32 = (
        (words_load(9u32) + words_load(10u32)) * words_load(PORTAL_CAPACITY) + 31u32
    ) / 32u32;
    while word < end && words_load(5u32) == 0u32 {
        var mask: u32 = words_load(words_load(VIEW_KEYS) + word);
        next = allocate_key_word(word, mask, next);
        word = word + 1u32;
    }
    return next;
}
fn advance() -> unit {
    task_commands(0u32, 0u32);
    words_store(16u32, 0u32);
    if words_load(5u32) != 0u32 {
        return;
    }
    var tasks: u32 = words_load(6u32);
    var groups: u32 = (tasks + 63u32) / 64u32;
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < groups {
        words_store(words_load(GROUP_PREFIX) + i, count);
        count = count + words_load(words_load(GROUP_COUNTS) + i);
        i = i + 1u32;
    }
    if count > words_load(PEAK_TASKS) {
        words_store(PEAK_TASKS, count);
    }
    if count > words_load(TASK_CAPACITY) {
        words_store(5u32, 1u32);
        return;
    }
    var oldviews: u32 = words_load(11u32);
    var views: u32 = allocate_views(oldviews);
    if words_load(5u32) != 0u32 {
        return;
    }
    task_commands(count, tasks);
    words_store(27u32, tasks);
    words_store(6u32, count);
    words_store(8u32, 1u32 - words_load(8u32));
    words_store(9u32, oldviews);
    words_store(10u32, views - oldviews);
    words_store(11u32, views);
    words_store(12u32, words_load(12u32) + 1u32);
    words_store(
        16u32,
        geometry_groups((views - oldviews) * words_load(PROJECTION_CAPACITY))
    );
}
fn reduce_view_keys() -> unit {
    var word: u32 = words_load(9u32) * words_load(PORTAL_CAPACITY) / 32u32 + shader_local_x();
    var end: u32 = (
        (words_load(9u32) + words_load(10u32)) * words_load(PORTAL_CAPACITY) + 31u32
    ) / 32u32;
    var groups: u32 = (words_load(6u32) + LOCAL_SIZE - 1u32) / LOCAL_SIZE;
    while word < end {
        var mask: u32 = 0u32;
        var group: u32 = 0u32;
        while group < groups {
            mask = mask | words_load(words_load(VIEW_KEYS) + group * view_key_words() + word);
            group = group + 1u32;
        }
        words_store(words_load(VIEW_KEYS) + word, mask);
        word = word + LOCAL_SIZE;
    }
}
fn compute() -> unit {
    if words_load(BATCH_MODE) == 0u32 && words_load(5u32) == 0u32 {
        reduce_view_keys();
    }
    shader_barrier();
    if shader_global_x() == 0u32 {
        if words_load(BATCH_MODE) != 0u32 {
            plan_geometry_batch();
        } else {
            advance();
        }
    }
}
fn plan_geometry_batch() -> unit {
    words_store(16u32, 0u32);
    words_store(BATCH_COUNT, 0u32);
    if words_load(5u32) != 0u32 {
        return;
    }
    var begin: u32 = words_load(9u32);
    var end: u32 = begin + words_load(10u32);
    var i: u32 = begin;
    while i < end {
        words_store(words_load(BATCH_META) + i * 4u32 + 3u32, 0u32);
        i = i + 1u32;
    }
    if (words_load(BATCH_MODE) & 2u32) != 0u32 {
        words_store(BATCH_VIEW, begin);
        words_store(BATCH_TRIANGLE, 0u32);
    }
    var view: u32 = words_load(BATCH_VIEW);
    var local: u32 = words_load(BATCH_TRIANGLE);
    words_store(BATCH_FIRST, view);
    var used: u32 = 0u32;
    while view < end && used < words_load(PROJECTION_CAPACITY) {
        var count: u32 = view_triangles(view) - local;
        if count > words_load(PROJECTION_CAPACITY) - used {
            count = words_load(PROJECTION_CAPACITY) - used;
        }
        var p: u32 = words_load(BATCH_META) + view * 4u32;
        words_store(p, local);
        words_store(p + 1u32, count);
        words_store(p + 2u32, used);
        words_store(p + 3u32, 1u32);
        used = used + count;
        local = local + count;
        words_store(BATCH_END, view + 1u32);
        if local == view_triangles(view) {
            view = view + 1u32;
            local = 0u32;
        }
    }
    words_store(BATCH_VIEW, view);
    words_store(BATCH_TRIANGLE, local);
    words_store(BATCH_COUNT, used);
    words_store(16u32, geometry_groups(used));
    if (words_load(BATCH_MODE) & 4u32) != 0u32 && view != end {
        words_store(5u32, 3u32);
    }
}
