fn perspective_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, x, y);
    var b: f32 = edge(cx, cy, ax, ay, x, y);
    var c: f32 = edge(ax, ay, bx, by, x, y);
    var denominator: f32 = a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(
        p + 14u32
    );
    var origin: f32 = floats_load(p + offset);
    return origin + (floats_load(p + 6u32 + offset) - origin) * (
        b * floats_load(p + 8u32) / denominator
    ) + (floats_load(p + 12u32 + offset) - origin) * (c * floats_load(p + 14u32) / denominator);
}
fn span_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var left: f32 = 100000f32;
    var right: f32 = -100000f32;
    var i: u32 = 0u32;
    while i < 3u32 {
        var a: u32 = p + i * 6u32;
        var b: u32 = p + ((i + 1u32) % 3u32) * 6u32;
        var ay: f32 = floats_load(a + 1u32);
        var by: f32 = floats_load(b + 1u32);
        if (ay <= y && by > y) || (by <= y && ay > y) {
            var xx: f32 = floats_load(a) + (floats_load(b) - floats_load(a)) * (y - ay) / (
                by - ay
            );
            if xx < left {
                left = xx;
            }
            if xx > right {
                right = xx;
            }
        }
        i = i + 1u32;
    }
    var a: f32 = ((x as u32 / 8u32) * 8u32) as f32 + 0.5f32;
    var b: f32 = a + 8f32;
    if a < left {
        a = left;
    }
    if b > right {
        b = right;
    }
    if b <= a {
        return perspective_sample(p, x, y, offset);
    }
    var av: f32 = perspective_sample(p, a, y, offset);
    var bv: f32 = perspective_sample(p, b, y, offset);
    return av + (bv - av) * (x - a) / (b - a);
}
fn sample_uv(p: u32, x: f32, y: f32, offset: u32, style: u32) -> f32 {
    if style == 2u32 {
        return span_sample(p, x, y, offset);
    }
    if style != 1u32 {
        return perspective_sample(p, x, y, offset);
    }
    var b: f32 = edge(
        floats_load(p + 12u32),
        floats_load(p + 13u32),
        floats_load(p),
        floats_load(p + 1u32),
        x,
        y
    );
    var c: f32 = edge(
        floats_load(p),
        floats_load(p + 1u32),
        floats_load(p + 6u32),
        floats_load(p + 7u32),
        x,
        y
    );
    var origin: f32 = floats_load(p + offset);
    var area: f32 = floats_load(p + 18u32);
    return origin + (floats_load(p + 6u32 + offset) - origin) * (b / area) + (
        floats_load(p + 12u32 + offset) - origin
    ) * (c / area);
}
fn candidate_depth(p: u32, px: f32, py: f32) -> f32 {
    if floats_load(p + 18u32) <= 0f32 {
        return 0f32;
    }
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, px, py);
    var b: f32 = edge(cx, cy, ax, ay, px, py);
    var c: f32 = edge(ax, ay, bx, by, px, py);
    if covered(bx, by, cx, cy, px, py) && covered(cx, cy, ax, ay, px, py) && covered(
        ax,
        ay,
        bx,
        by,
        px,
        py
    ) {
        var area: f32 = floats_load(p + 18u32);
        var iz: f32 = (
            a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(p + 14u32)
        ) / area;
        return iz;
    }
    return 0f32;
}
fn candidate_opaque(triangle: u32, p: u32, px: f32, py: f32) -> bool {
    var meta: u32 = words_load(META) + triangle * 4u32;
    if (words_load(meta + 3u32) & 1u32) == 0u32 {
        return true;
    }
    var mat: u32 = words_load(meta + 1u32);
    var style: u32 = material_field(mat, 5u32) & 3u32;
    return material_texel(
        mat,
        sample_uv(p, px, py, 3u32, style),
        sample_uv(p, px, py, 4u32, style)
    ) != material_field(mat, 9u32);
}
fn nearer(iz: f32, best: f32, id: u32, winner: u32) -> bool {
    return iz > 0f32 && (iz > best || (iz == best && id < winner));
}
fn raster_candidates(task: u32, view: u32, x: u32, y: u32) -> unit {
    var pixel: u32 = y * words_load(0u32) + x;
    var cache: u32 = words_load(HIT_FLOAT) + pixel * 3u32;
    var identity_word: u32 = words_load(DEBUG_VALUES) + pixel * 4u32;
    var best: f32 = 0f32;
    var winner: u32 = 0xffffffffu32;
    if batch_start(view) != 0u32 {
        best = floats_load(cache);
        winner = words_load(identity_word);
    } else {
        floats_store(cache + 1u32, 0f32);
        floats_store(cache + 2u32, 0f32);
    }
    var selected: u32 = 0xffffffffu32;
    var px: f32 = x as f32 + 0.5f32;
    var py: f32 = y as f32 + 0.5f32;
    var count: u32 = words_load(words_load(COMPACT_COUNT) + view);
    if words_load(25u32) != 0u32 {
        count = batch_size(view) * MAX_FAN;
    }
    var i: u32 = 0u32;
    if words_load(25u32) == 0u32 {
        i = next_tile_candidate(task, 0u32, count);
    }
    while i < count {
        var id: u32 = i;
        if words_load(25u32) == 0u32 {
            id = words_load(words_load(COMPACT_OFFSET) + batch_offset(view) * MAX_FAN + i);
        }
        var p: u32 = words_load(PROJECTED_OFFSET) + (batch_offset(view) * MAX_FAN + id) * 20u32;
        var triangle: u32 = batch_triangle(view, id / MAX_FAN);
        var identity: u32 = triangle * MAX_FAN + id % MAX_FAN;
        if tile_overlap(p, (x / 8u32 * 8u32) as f32, (y / 8u32 * 8u32) as f32) {
            var depth: f32 = candidate_depth(p, px, py);
            if nearer(depth, best, identity, winner) && candidate_opaque(triangle, p, px, py) {
                best = depth;
                winner = identity;
                selected = p;
            }
        }
        i = i + 1u32;
        if words_load(25u32) == 0u32 {
            i = next_tile_candidate(task, i, count);
        }
    }
    if selected != 0xffffffffu32 {
        var mat: u32 = words_load(words_load(META) + winner / MAX_FAN * 4u32 + 1u32);
        var style: u32 = material_field(mat, 5u32) & 3u32;
        floats_store(cache + 1u32, sample_uv(selected, px, py, 3u32, style));
        floats_store(cache + 2u32, sample_uv(selected, px, py, 4u32, style));
    }
    floats_store(cache, best);
    words_store(identity_word, winner);
}
fn raster_pixel(task: u32, lane: u32) -> unit {
    var base: u32 = task_base() + task * 4u32;
    var view: u32 = words_load(base + 1u32);
    if !batch_active(view) {
        return;
    }
    var tile: u32 = words_load(base);
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    if !task_pixel_active(base, lane, x, y, width) {
        return;
    }
    raster_candidates(task, view, x, y);
}
fn compute() -> unit {
    var task: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        raster_pixel(task, shader_local_x());
    }
}
