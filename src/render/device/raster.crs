fn raster_active(base: u32, lane: u32, x: u32, y: u32, width: u32) -> bool {
    return!(
        x >= width || y >= words_load(1u32) || (
            words_load(base + 2u32 + lane / 32u32) & (1u32 << (lane % 32u32))
        ) == 0u32
    );
}
fn perspective_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, x, y);
    var b: f32 = edge(cx, cy, ax, ay, x, y);
    var c: f32 = edge(ax, ay, bx, by, x, y);
    var denominator: f32 = a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(
        p + 14u32
    );
    var origin: f32 = floats_load(p + offset);
    return origin + (floats_load(p + 6u32 + offset) - origin) * (
        b * floats_load(p + 8u32) / denominator
    ) + (floats_load(p + 12u32 + offset) - origin) * (c * floats_load(p + 14u32) / denominator);
}
fn span_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var left: f32 = 100000f32;
    var right: f32 = -100000f32;
    var i: u32 = 0u32;
    while i < 3u32 {
        var a: u32 = p + i * 6u32;
        var b: u32 = p + ((i + 1u32) % 3u32) * 6u32;
        var ay: f32 = floats_load(a + 1u32);
        var by: f32 = floats_load(b + 1u32);
        if (ay <= y && by > y) || (by <= y && ay > y) {
            var xx: f32 = floats_load(a) + (floats_load(b) - floats_load(a)) * (y - ay) / (
                by - ay
            );
            if xx < left {
                left = xx;
            }
            if xx > right {
                right = xx;
            }
        }
        i = i + 1u32;
    }
    var a: f32 = ((x as u32 / 8u32) * 8u32) as f32 + 0.5f32;
    var b: f32 = a + 8f32;
    if a < left {
        a = left;
    }
    if b > right {
        b = right;
    }
    if b <= a {
        return perspective_sample(p, x, y, offset);
    }
    var av: f32 = perspective_sample(p, a, y, offset);
    var bv: f32 = perspective_sample(p, b, y, offset);
    return av + (bv - av) * (x - a) / (b - a);
}
fn sample_uv(p: u32, x: f32, y: f32, offset: u32, style: u32) -> f32 {
    if style == 2u32 {
        return span_sample(p, x, y, offset);
    }
    if style != 1u32 {
        return perspective_sample(p, x, y, offset);
    }
    var b: f32 = edge(
        floats_load(p + 12u32),
        floats_load(p + 13u32),
        floats_load(p),
        floats_load(p + 1u32),
        x,
        y
    );
    var c: f32 = edge(
        floats_load(p),
        floats_load(p + 1u32),
        floats_load(p + 6u32),
        floats_load(p + 7u32),
        x,
        y
    );
    var origin: f32 = floats_load(p + offset);
    var area: f32 = floats_load(p + 18u32);
    return origin + (floats_load(p + 6u32 + offset) - origin) * (b / area) + (
        floats_load(p + 12u32 + offset) - origin
    ) * (c / area);
}
fn candidate_depth(p: u32, px: f32, py: f32) -> f32 {
    if floats_load(p + 18u32) <= 0f32 {
        return 0f32;
    }
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, px, py);
    var b: f32 = edge(cx, cy, ax, ay, px, py);
    var c: f32 = edge(ax, ay, bx, by, px, py);
    if covered(bx, by, cx, cy, px, py) && covered(cx, cy, ax, ay, px, py) && covered(
        ax,
        ay,
        bx,
        by,
        px,
        py
    ) {
        var area: f32 = floats_load(p + 18u32);
        var iz: f32 = (
            a * floats_load(p + 2u32) + b * floats_load(p + 8u32) + c * floats_load(p + 14u32)
        ) / area;
        return iz;
    }
    return 0f32;
}
fn candidate_opaque(id: u32, p: u32, px: f32, py: f32) -> bool {
    var meta: u32 = words_load(META) + (id / MAX_FAN) * 4u32;
    if (words_load(meta + 3u32) & 1u32) == 0u32 {
        return true;
    }
    var mat: u32 = words_load(meta + 1u32);
    var style: u32 = material_field(mat, 5u32) & 3u32;
    return material_texel(
        mat,
        sample_uv(p, px, py, 3u32, style),
        sample_uv(p, px, py, 4u32, style)
    ) != material_field(mat, 9u32);
}
fn nearer(iz: f32, best: f32, id: u32, winner: u32) -> bool {
    return iz > 0f32 && (iz > best || (iz == best && id < winner));
}
fn raster_pixel(task: u32, lane: u32) -> unit {
    var base: u32 = task_base() + task * 4u32;
    var tile: u32 = words_load(base);
    var view: u32 = words_load(base + 1u32);
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    shared_store(320u32 + lane, 0u32);
    if !raster_active(base, lane, x, y, width) {
        return;
    }
    var best: f32 = 0f32;
    var winner: u32 = 0xffffffffu32;
    var winner_id: u32 = 0xffffffffu32;
    var uu: f32 = 0f32;
    var vv: f32 = 0f32;
    var i: u32 = 0u32;
    var px: f32 = x as f32 + 0.5f32;
    var py: f32 = y as f32 + 0.5f32;
    var count: u32 = words_load(words_load(COMPACT_COUNT) + view);
    if words_load(25u32) != 0u32 {
        count = words_load(3u32) * MAX_FAN;
    }
    if words_load(25u32) == 0u32 {
        i = next_tile_candidate(task, 0u32, count);
    }
    while i < count {
        var id: u32 = i;
        if words_load(25u32) == 0u32 {
            id = words_load(
                words_load(COMPACT_OFFSET) + view * words_load(3u32) * MAX_FAN + i
            );
        }
        var p: u32 = words_load(PROJECTED_OFFSET) + (view * words_load(3u32) * MAX_FAN + id) * 20u32;
        if tile_overlap(p, (x / 8u32 * 8u32) as f32, (y / 8u32 * 8u32) as f32) {
            var iz: f32 = candidate_depth(p, px, py);
            if nearer(iz, best, id, winner_id) {
                if candidate_opaque(id, p, px, py) {
                    best = iz;
                    winner = id / MAX_FAN;
                    winner_id = id;
                }
            }
        }
        i = i + 1u32;
        if words_load(25u32) == 0u32 {
            i = next_tile_candidate(task, i, count);
        }
    }
    var color: u32 = words_load(BACKGROUND);
    if winner != 0xffffffffu32 {
        var portal: u32 = words_load(words_load(META) + winner * 4u32 + 2u32);
        if portal != 0u32 && words_load(12u32) < words_load(4u32) {
            shared_store(320u32 + lane, portal);
            return;
        }
        var mat: u32 = words_load(words_load(META) + winner * 4u32 + 1u32);
        var p: u32 = words_load(PROJECTED_OFFSET) + (
            view * words_load(3u32) * MAX_FAN + winner_id
        ) * 20u32;
        var style: u32 = material_field(mat, 5u32) & 3u32;
        uu = sample_uv(p, px, py, 3u32, style);
        vv = sample_uv(p, px, py, 4u32, style);
        color = surface_color(winner, view, uu, vv, 1f32 / best, x, y);
    }
    if words_load(26u32) != 0u32 {
        var debug: u32 = words_load(DEBUG_VALUES) + (y * width + x) * 4u32;
        var identity: u32 = winner;
        if winner != 0xffffffffu32 {
            identity = winner + view * words_load(3u32);
        }
        words_store(debug, identity);
        words_store(debug + 1u32, (uu * 10000f32) as i32 as u32);
        words_store(debug + 2u32, (vv * 10000f32) as i32 as u32);
        words_store(debug + 3u32, (10000f32 / best) as u32);
    }
    words_store(PIXELS + y * width + x, color);
}

fn child_unique(lane: u32) -> unit {
    var portal: u32 = shared_load(320u32 + lane);
    shared_store(lane, 0u32);
    if portal == 0u32 {
        return;
    }
    var previous: u32 = 0u32;
    while previous < lane {
        if shared_load(320u32 + previous) == portal {
            return;
        }
        previous = previous + 1u32;
    }
    shared_store(lane, (portal != 0u32) as u32);
}
fn child_masks(task: u32, lane: u32) -> unit {
    if shared_load(lane) == 0u32 && lane != LOCAL_SIZE - 1u32 {
        return;
    }
    var offset: u32 = 0u32;
    var previous: u32 = 0u32;
    while previous < lane {
        offset = offset + shared_load(previous);
        previous = previous + 1u32;
    }
    var base: u32 = words_load(CANDIDATES) + task * (1u32 + LOCAL_SIZE * 3u32);
    if lane == LOCAL_SIZE - 1u32 {
        words_store(base, offset + shared_load(lane));
    }
    if shared_load(lane) == 0u32 {
        return;
    }
    var portal: u32 = shared_load(320u32 + lane);
    var lo: u32 = 0u32;
    var hi: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < LOCAL_SIZE {
        if shared_load(320u32 + pixel) == portal {
            if pixel < 32u32 {
                lo = lo | (1u32 << pixel);
            } else {
                hi = hi | (1u32 << (pixel - 32u32));
            }
        }
        pixel = pixel + 1u32;
    }
    var out: u32 = base + 1u32 + offset * 3u32;
    words_store(out, portal);
    words_store(out + 1u32, lo);
    words_store(out + 2u32, hi);
}
fn compute() -> unit {
    var lane: u32 = shader_local_x();
    var task: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        raster_pixel(task, lane);
    }
    shader_barrier();
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        child_unique(lane);
    }
    shader_barrier();
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        child_masks(task, lane);
    }
}
