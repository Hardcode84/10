fn prepare_triangle(index: u32) -> unit {
    var view: u32 = batch_slot_view(index);
    var local: u32 = index - batch_offset(view);
    var tri: u32 = batch_triangle(view, local);
    words_store(words_load(BATCH_PRIMITIVES) + index, tri);
    var slot: u32 = index;
    var output: u32 = words_load(PROJECTED_OFFSET) + slot * MAX_FAN * 20u32;
    floats_store(output + 19u32, 0f32);
    var fan: u32 = 0u32;
    while fan < MAX_FAN {
        floats_store(output + fan * 20u32 + 18u32, 0f32);
        fan = fan + 1u32;
    }
    if tri >= words_load(3u32) || scene_meta(tri, 0u32) != words_load(
        words_load(VIEW_META) + view * 4u32
    ) {
        return;
    }
    if !triangle_visible(tri, view) {
        return;
    }
    if !portal_facing(view, scene_meta(tri, 2u32)) {
        return;
    }
    var scratch: u32 = words_load(CLIP_OFFSET) + slot * 144u32;
    var matrix: u32 = words_load(VIEW_FLOAT) + view * PORTAL_TRANSFORM_WORDS;
    transform_vertices(tri, matrix, scratch);
    var count: u32 = 3u32;
    var near: f32 = triangle_near(tri);
    var plane: u32 = 0u32;
    while plane < 6u32 && count >= 3u32 {
        count = clip_polygon(scratch, count, plane, near);
        plane = plane + 1u32;
    }
    if count < 3u32 {
        return;
    }
    var vertex: u32 = 0u32;
    while vertex < count {
        // A polygon through the eye has no projected area.
        if floats_load(scratch + vertex * 6u32 + 2u32) <= 0f32 {
            return;
        }
        vertex = vertex + 1u32;
    }
    project_fan(scratch, output, count, tri);
}
fn compute() -> unit {
    var i: u32 = shader_global_x();
    while words_load(5u32) == 0u32 && i < words_load(BATCH_COUNT) {
        prepare_triangle(i);
        i = i + MAX_INVOCATIONS;
    }
}
