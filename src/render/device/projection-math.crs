fn project_fan(scratch: u32, output: u32, count: u32, tri: u32) -> unit {
    project_store(output + 19u32, (count - 2u32) as f32);
    var fan: u32 = 0u32;
    while fan < count - 2u32 {
        var vertex: u32 = 0u32;
        while vertex < 3u32 {
            var src: u32 = 0u32;
            if vertex > 0u32 {
                src = fan + vertex;
            }
            src = scratch + src * 6u32;
            var dst: u32 = output + fan * 20u32 + vertex * 6u32;
            var iz: f32 = 1f32 / project_load(src + 2u32);
            var h: f32 = words_load(1u32) as f32 * 0.5f32;
            var px: f32 = words_load(0u32) as f32 * 0.5f32 + project_load(src) * iz * h / floats_load(
                PROJECTION
            );
            var py: f32 = h - project_load(src + 1u32) * iz * h / floats_load(PROJECTION);
            if (material_field(scene_meta(tri, 1u32), 5u32) & 4u32) != 0u32 {
                px = ((px + 0.5f32) as i32) as f32;
                py = ((py + 0.5f32) as i32) as f32;
            }
            project_store(dst, px);
            project_store(dst + 1u32, py);
            project_store(dst + 2u32, iz);
            project_store(dst + 3u32, project_load(src + 3u32));
            project_store(dst + 4u32, project_load(src + 4u32));
            vertex = vertex + 1u32;
        }
        var p: u32 = output + fan * 20u32;
        var area: f32 = edge(
            project_load(p),
            project_load(p + 1u32),
            project_load(p + 6u32),
            project_load(p + 7u32),
            project_load(p + 12u32),
            project_load(p + 13u32)
        );
        if area < 0f32 {
            var c: u32 = 0u32;
            while c < 5u32 {
                var a: f32 = project_load(p + 6u32 + c);
                project_store(p + 6u32 + c, project_load(p + 12u32 + c));
                project_store(p + 12u32 + c, a);
                c = c + 1u32;
            }
            area = 0f32 - area;
        }
        project_store(p + 18u32, area);
        fan = fan + 1u32;
    }
}
fn clip_distance(base: u32, plane: u32, near: f32) -> f32 {
    var x: f32 = project_load(base);
    var y: f32 = project_load(base + 1u32);
    var z: f32 = project_load(base + 2u32);
    if plane == 0u32 {
        return z - near;
    }
    if plane == 1u32 {
        return project_load(base + 5u32);
    }
    z = z * floats_load(PROJECTION);
    var aspect: f32 = words_load(0u32) as f32 / words_load(1u32) as f32;
    if plane == 2u32 {
        return z * aspect + x;
    }
    if plane == 3u32 {
        return z * aspect - x;
    }
    if plane == 4u32 {
        return z + y;
    }
    return z - y;
}
fn clip_polygon(base: u32, count: u32, plane: u32, near: f32) -> u32 {
    if clip_inside(base, count, plane, near) {
        return count;
    }
    var output: u32 = 0u32;
    var i: u32 = 0u32;
    while i < count {
        var a: u32 = base + i * 6u32;
        var b: u32 = base + ((i + 1u32) % count) * 6u32;
        var da: f32 = clip_distance(a, plane, near);
        var db: f32 = clip_distance(b, plane, near);
        var j: u32 = 0u32;
        if da >= 0f32 {
            while j < 6u32 {
                project_store(base + 72u32 + output * 6u32 + j, project_load(a + j));
                j = j + 1u32;
            }
            output = output + 1u32;
        }
        if (da < 0f32) != (db < 0f32) {
            // Shared crossings use the inside endpoint first in both triangles.
            if da < 0f32 {
                var swap: u32 = a;
                a = b;
                b = swap;
                var distance: f32 = da;
                da = db;
                db = distance;
            }
            var t: f32 = da / (da - db);
            j = 0u32;
            while j < 6u32 {
                var av: f32 = project_load(a + j);
                project_store(
                    base + 72u32 + output * 6u32 + j,
                    av + (project_load(b + j) - av) * t
                );
                j = j + 1u32;
            }
            output = output + 1u32;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < output * 6u32 {
        project_store(base + i, project_load(base + 72u32 + i));
        i = i + 1u32;
    }
    return output;
}
fn triangle_near(tri: u32) -> f32 {
    var near: f32 = floats_load(RENDER_STYLE);
    if (scene_meta(tri, 3u32) & TRIANGLE_DETAIL_NEAR) != 0u32 && floats_load(DETAIL_NEAR) > near {
        near = floats_load(DETAIL_NEAR);
    }
    if scene_meta(tri, 2u32) != 0u32 {
        near = 0f32;
    }
    return near;
}
fn sprite_vertex(source: u32, matrix: u32, axis: u32) -> f32 {
    var inverse_scale: f32 = 1f32 / floats_load(matrix + 16u32);
    return scene_float(source + axis) + inverse_scale * (
        floats_load(matrix + axis) * scene_float(source + 3u32) + floats_load(
            matrix + 4u32 + axis
        ) * scene_float(source + 4u32)
    );
}
fn transform_vertices(tri: u32, matrix: u32, scratch: u32) -> unit {
    var vertex: u32 = 0u32;
    while vertex < 3u32 {
        var source: u32 = tri * 15u32 + vertex * 5u32;
        var sprite: bool = (scene_meta(tri, 3u32) & TRIANGLE_SPRITE) != 0u32;
        var x: f32 = scene_float(source);
        var y: f32 = scene_float(source + 1u32);
        var z: f32 = scene_float(source + 2u32);
        if sprite {
            x = sprite_vertex(source, matrix, 0u32);
            y = sprite_vertex(source, matrix, 1u32);
            z = sprite_vertex(source, matrix, 2u32);
        }
        var r: u32 = 0u32;
        while r < 3u32 {
            project_store(
                scratch + vertex * 6u32 + r,
                floats_load(matrix + r * 4u32) * x + floats_load(matrix + r * 4u32 + 1u32) * y + floats_load(
                    matrix + r * 4u32 + 2u32
                ) * z + floats_load(matrix + r * 4u32 + 3u32)
            );
            r = r + 1u32;
        }
        project_store(scratch + vertex * 6u32 + 3u32, scene_float(source + 3u32));
        project_store(scratch + vertex * 6u32 + 4u32, scene_float(source + 4u32));
        if sprite {
            project_store(
                scratch + vertex * 6u32 + 3u32,
                ((scene_float(source + 3u32) > 0f32) as u32) as f32
            );
            project_store(
                scratch + vertex * 6u32 + 4u32,
                ((scene_float(source + 4u32) > 0f32) as u32) as f32
            );
        }
        project_store(
            scratch + vertex * 6u32 + 5u32,
            floats_load(matrix + 12u32) * x + floats_load(matrix + 13u32) * y + floats_load(
                matrix + 14u32
            ) * z + floats_load(matrix + 15u32)
        );
        vertex = vertex + 1u32;
    }
}

fn clip_inside(base: u32, count: u32, plane: u32, near: f32) -> bool {
    var vertex: u32 = 0u32;
    while vertex < count {
        if!(clip_distance(base + vertex * 6u32, plane, near) >= 0f32) {
            return false;
        }
        vertex = vertex + 1u32;
    }
    return true;
}
