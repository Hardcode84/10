fn compute() -> unit {
    var i: u32 = shader_global_x();
    var lane: u32 = shader_local_x();
    var n: u32 = 0u32;
    var mask: u32 = 0u32;
    if i < words_load(6u32) {
        var portal: u32 = 0u32;
        while portal < MAX_PORTALS {
            var p: u32 = CANDIDATES + (i * MAX_PORTALS + portal) * 2u32;
            if (words_load(p) | words_load(p + 1u32)) != 0u32 {
                n = n + 1u32;
                mask = mask | (1u32 << portal);
            }
            portal = portal + 1u32;
        }
    }
    shared_store(lane, n as f32);
    shared_store(64u32 + lane, mask as f32);
    shader_barrier();
    if i < words_load(6u32) {
        var j: u32 = 0u32;
        var offset: u32 = 0u32;
        while j < lane {
            offset = offset + shared_load(j) as u32;
            j = j + 1u32;
        }
        words_store(TASK_PREFIX + i, offset);
    }
    if lane == 0u32 {
        var total: u32 = 0u32;
        var a: u32 = 0u32;
        var b: u32 = 0u32;
        var c: u32 = 0u32;
        var d: u32 = 0u32;
        var j: u32 = 0u32;
        while j < 64u32 && i + j < words_load(6u32) {
            total = total + shared_load(j) as u32;
            var parent: u32 = words_load(task_base() + (i + j) * 4u32 + 1u32);
            var m: u32 = shared_load(64u32 + j) as u32;
            var bits: u32 = m << ((parent % 8u32) * 4u32);
            if parent < 8u32 {
                a = a | bits;
            } else {
                if parent < 16u32 {
                    b = b | bits;
                } else {
                    if parent < 24u32 {
                        c = c | bits;
                    } else {
                        d = d | bits;
                    }
                }
            }
            if words_load(TASK_ERRORS + i + j) != 0u32 {
                total = total | 0x80000000u32;
            }
            j = j + 1u32;
        }
        var p: u32 = GROUP_COUNTS + (i / 64u32) * 5u32;
        words_store(p, total);
        words_store(p + 1u32, a);
        words_store(p + 2u32, b);
        words_store(p + 3u32, c);
        words_store(p + 4u32, d);
    }
}
