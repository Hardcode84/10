fn compute() -> unit {
    var i: u32 = shader_global_x() + words_load(DISPATCH_BASE);
    var lane: u32 = shader_local_x();
    var tasks: u32 = words_load(6u32);
    var first: u32 = words_load(9u32) * words_load(PORTAL_CAPACITY) / 32u32;
    var end: u32 = (
        (words_load(9u32) + words_load(10u32)) * words_load(PORTAL_CAPACITY) + 31u32
    ) / 32u32;
    var key: u32 = first + lane;
    while key < end {
        words_store(words_load(VIEW_KEYS) + (i / 64u32) * view_key_words() + key, 0u32);
        key = key + 64u32;
    }
    var n: u32 = 0u32;
    if i < tasks {
        n = words_load(words_load(CANDIDATES) + i * (1u32 + LOCAL_SIZE * 3u32));
    }
    shared_store(lane, n);
    shader_all_memory_barrier();
    var j: u32 = 0u32;
    var offset: u32 = 0u32;
    while j < lane {
        offset = offset + shared_load(j);
        j = j + 1u32;
    }
    if i < tasks {
        words_store(words_load(TASK_PREFIX) + i, offset);
    }
    if lane == 0u32 {
        group_keys(i, tasks);
    }
    if lane == 63u32 {
        words_store(words_load(GROUP_COUNTS) + i / 64u32, offset + n);
    }
}

fn group_keys(first: u32, tasks: u32) -> unit {
    var i: u32 = first;
    while i < first + 64u32 && i < tasks {
        var parent: u32 = words_load(task_base() + i * 4u32 + 1u32);
        var base: u32 = words_load(CANDIDATES) + i * (1u32 + LOCAL_SIZE * 3u32);
        var portal: u32 = 0u32;
        while portal < words_load(base) {
            var p: u32 = base + 1u32 + portal * 3u32;
            if words_load(p) != 0u32 {
                var key: u32 = parent * words_load(PORTAL_CAPACITY) + words_load(p) - 1u32;
                var slot: u32 = words_load(VIEW_KEYS) + (first / 64u32) * view_key_words() + key / 32u32;
                words_store(slot, words_load(slot) | (1u32 << (key % 32u32)));
            }
            portal = portal + 1u32;
        }
        i = i + 1u32;
    }
}
