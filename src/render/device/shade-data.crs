fn shade_pixel(view: u32, lane: u32, x: u32, y: u32) -> unit {
    var pixel: u32 = y * words_load(0u32) + x;
    var cache: u32 = words_load(HIT_FLOAT) + pixel * 3u32;
    var identity: u32 = words_load(words_load(DEBUG_VALUES) + pixel * 4u32);
    var depth: f32 = floats_load(cache);
    var u: f32 = floats_load(cache + 1u32);
    var v: f32 = floats_load(cache + 2u32);
    var winner: u32 = 0xffffffffu32;
    var color: u32 = words_load(BACKGROUND);
    if identity != 0xffffffffu32 {
        winner = identity / MAX_FAN;
        var portal: u32 = scene_meta(winner, 2u32);
        if portal != 0u32 {
            words_store(PIXELS + pixel, words_load(BACKGROUND));
            if !view_distance_exceeded(1f32 / depth, x, y) {
                shared_store(320u32 + lane, portal);
            }
            return;
        }
        if !view_distance_exceeded(1f32 / depth, x, y) {
            color = shade_color(winner, view, u, v, 1f32 / depth, x, y);
        }
    }
    if words_load(26u32) != 0u32 {
        var debug: u32 = words_load(DEBUG_VALUES) + pixel * 4u32;
        var debug_identity: u32 = winner;
        if winner != 0xffffffffu32 {
            debug_identity = winner + view * words_load(3u32);
        }
        words_store(debug, debug_identity);
        words_store(debug + 1u32, (u * 10000f32) as i32 as u32);
        words_store(debug + 2u32, (v * 10000f32) as i32 as u32);
        words_store(debug + 3u32, (10000f32 / depth) as u32);
    }
    words_store(PIXELS + pixel, color);
}
fn shade_task(task: u32, lane: u32) -> unit {
    shared_store(320u32 + lane, 0u32);
    var base: u32 = task_base() + task * 4u32;
    var view: u32 = words_load(base + 1u32);
    if !batch_finished(view) {
        return;
    }
    var tile: u32 = words_load(base);
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    if !task_pixel_active(base, lane, x, y, width) {
        return;
    }
    shade_pixel(view, lane, x, y);
}
fn shade_task_finished(task: u32) -> bool {
    return task < words_load(6u32) && words_load(5u32) == 0u32 && batch_finished(
        words_load(task_base() + task * 4u32 + 1u32)
    );
}

fn child_unique(lane: u32) -> unit {
    var portal: u32 = shared_load(320u32 + lane);
    shared_store(lane, 0u32);
    if portal == 0u32 {
        return;
    }
    var previous: u32 = 0u32;
    while previous < lane {
        if shared_load(320u32 + previous) == portal {
            return;
        }
        previous = previous + 1u32;
    }
    shared_store(lane, (portal != 0u32) as u32);
}
fn child_masks(task: u32, lane: u32) -> unit {
    if shared_load(lane) == 0u32 && lane != LOCAL_SIZE - 1u32 {
        return;
    }
    var offset: u32 = 0u32;
    var previous: u32 = 0u32;
    while previous < lane {
        offset = offset + shared_load(previous);
        previous = previous + 1u32;
    }
    var base: u32 = words_load(CANDIDATES) + task * (1u32 + LOCAL_SIZE * 3u32);
    if lane == LOCAL_SIZE - 1u32 {
        words_store(base, offset + shared_load(lane));
    }
    if shared_load(lane) == 0u32 {
        return;
    }
    var portal: u32 = shared_load(320u32 + lane);
    var lo: u32 = 0u32;
    var hi: u32 = 0u32;
    var pixel: u32 = 0u32;
    while pixel < LOCAL_SIZE {
        if shared_load(320u32 + pixel) == portal {
            if pixel < 32u32 {
                lo = lo | (1u32 << pixel);
            } else {
                hi = hi | (1u32 << (pixel - 32u32));
            }
        }
        pixel = pixel + 1u32;
    }
    var out: u32 = base + 1u32 + offset * 3u32;
    words_store(out, portal);
    words_store(out + 1u32, lo);
    words_store(out + 2u32, hi);
}
fn compute() -> unit {
    var lane: u32 = shader_local_x();
    var task: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    if task < words_load(6u32) && words_load(5u32) == 0u32 {
        shade_task(task, lane);
    }
    shader_workgroup_barrier();
    if shade_task_finished(task) {
        child_unique(lane);
    }
    shader_workgroup_barrier();
    if shade_task_finished(task) {
        child_masks(task, lane);
    }
}

fn shade_color(tri: u32, view: u32, u: f32, v: f32, z: f32, x: u32, y: u32) -> u32 {
    var mat: u32 = scene_meta(tri, 1u32);
    if (scene_meta(tri, 3u32) & TRIANGLE_SPRITE) != 0u32 {
        return assets_load(
            material_palette(mat) + material_texel(mat, u, v) * LIGHT_STATES + LIGHT_STATES - 1u32
        );
    }
    if SHADE_DISTANCE {
        return light_color(mat, u, v, z, x, y);
    }
    return assets_load(
        material_palette(mat) + material_texel(mat, u, v) * LIGHT_STATES + lit_state(
            tri,
            view,
            x,
            y
        )
    );
}

fn view_distance_exceeded(z: f32, x: u32, y: u32) -> bool {
    var limit: f32 = floats_load(VIEW_DISTANCE);
    if limit == 0f32 {
        return false;
    }
    var h: f32 = words_load(1u32) as f32;
    var dx: f32 = (2f32 * (x as f32 + 0.5f32) - words_load(0u32) as f32) / h * floats_load(
        PROJECTION
    );
    var dy: f32 = (h - 2f32 * (y as f32 + 0.5f32)) / h * floats_load(PROJECTION);
    return z * shader_sqrt(1f32 + dx * dx + dy * dy) >= limit;
}
