fn bin_tile() -> unit {
    var task: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    if task >= words_load(6u32) || words_load(5u32) != 0u32 || words_load(25u32) != 0u32 {
        return;
    }
    var base: u32 = task_base() + task * 4u32;
    var tile: u32 = words_load(base);
    var view: u32 = words_load(base + 1u32);
    if !batch_active(view) {
        return;
    }
    var cols: u32 = (words_load(0u32) + 7u32) / 8u32;
    var x: f32 = (tile % cols * 8u32) as f32;
    var y: f32 = (tile / cols * 8u32) as f32;
    var count: u32 = words_load(words_load(COMPACT_COUNT) + view);
    var word: u32 = shader_local_x();
    while word < (count + 31u32) / 32u32 {
        var bits: u32 = 0u32;
        var i: u32 = word * 32u32;
        while group_tile_overlap(view, word, x, y) && i < (word + 1u32) * 32u32 && i < count {
            var id: u32 = words_load(
                words_load(COMPACT_OFFSET) + batch_offset(view) * MAX_FAN + i
            );
            var p: u32 = words_load(PROJECTED_OFFSET) + (batch_offset(view) * MAX_FAN + id) * 20u32;
            if triangle_tile_overlap(p, x, y) {
                bits = bits | (1u32 << (i % 32u32));
            }
            i = i + 1u32;
        }
        words_store(words_load(TILE_BITS) + task * tile_bit_stride() + word, bits);
        word = word + LOCAL_SIZE;
    }
}
fn compute() -> unit {
    bin_tile();
}

fn edge_tile_overlap(ax: f32, ay: f32, bx: f32, by: f32, x: f32, y: f32) -> bool {
    var px: f32 = x;
    var py: f32 = y;
    if by < ay {
        px = px + 8f32;
    }
    if bx > ax {
        py = py + 8f32;
    }
    return coverage_edge(ax, ay, bx, by, px, py) >= 0f32;
}
fn triangle_tile_overlap(p: u32, x: f32, y: f32) -> bool {
    if !tile_overlap(p, x, y) {
        return false;
    }
    var ax: f32 = floats_load(p);
    var ay: f32 = floats_load(p + 1u32);
    var bx: f32 = floats_load(p + 6u32);
    var by: f32 = floats_load(p + 7u32);
    var cx: f32 = floats_load(p + 12u32);
    var cy: f32 = floats_load(p + 13u32);
    return edge_tile_overlap(ax, ay, bx, by, x, y) && edge_tile_overlap(bx, by, cx, cy, x, y) && edge_tile_overlap(
        cx,
        cy,
        ax,
        ay,
        x,
        y
    );
}
