fn overlay_color(x: u32, y: u32, color: u32) -> u32 {
    if words_load(OVERLAY_ENABLED) == 0u32 || x >= 640u32 || y >= 48u32 {
        return color;
    }
    var cell: u32 = words_load(OVERLAY_CELLS + (y / 8u32) * 80u32 + x / 8u32);
    if cell == 0u32 {
        return color;
    }
    var row: u32 = words_load(OVERLAY_FONT + (cell & 127u32) * 8u32 + y % 8u32);
    if (row & (1u32 << (x % 8u32))) != 0u32 {
        return words_load(OVERLAY_COLOR);
    }
    return words_load(OVERLAY_COLOR + 1u32);
}
fn compute() -> unit {
    var i: u32 = shader_global_x();
    if i < words_load(22u32) * words_load(23u32) && words_load(5u32) == 0u32 {
        var x: u32 = (i % words_load(22u32)) * words_load(0u32) / words_load(22u32);
        var y: u32 = (i / words_load(22u32)) * words_load(1u32) / words_load(23u32);
        var c: u32 = words_load(PIXELS + y * words_load(0u32) + x);
        c = overlay_color(i % words_load(22u32), i / words_load(22u32), c);
        if words_load(21u32) == 44u32 {
            c = (c & 0xff00ff00u32) | ((c & 255u32) << 16u32) | ((c >> 16u32) & 255u32);
        }
        words_store(PRESENT_PIXELS + i, c);
    }
}
