fn shadow_seed(first: u32, begin: u32, end: u32, shift: u32, space: u32, filter: bool) -> u32 {
    var count: u32 = 0u32;
    var i: u32 = begin;
    while i < end {
        var meta: u32 = words_load(META) + i * 4u32;
        if (!filter || words_load(meta) == space) && (words_load(meta + 3u32) & 4u32) == 0u32 {
            words_store(words_load(SHADOW_INDEX) + first + count, i - shift);
            count = count + 1u32;
        }
        i = i + 1u32;
    }
    return count;
}
fn shadow_instance(instance: u32) -> unit {
    var p: u32 = words_load(INSTANCE_META) + instance * 5u32;
    var size: u32 = words_load(p + 1u32);
    if size == 0u32 {
        return;
    }
    var begin: u32 = words_load(p + 2u32);
    var shift: u32 = words_load(DYNAMIC_COUNT);
    var first: u32 = begin - shift;
    var count: u32 = shadow_seed(first, begin, begin + size, shift, 0u32, false);
    shadow_build(first, count, shift, false);
}
fn compute() -> unit {
    if shader_local_x() == 0u32 {
        var item: u32 = shader_global_x() / LOCAL_SIZE;
        var instances: u32 = words_load(INSTANCE_COUNT);
        while item < instances + words_load(LIGHT_COUNT) {
            if item < instances {
                if words_load(SHADOW_RESET) != 0u32 {
                    shadow_instance(item);
                }
            } else if floats_load(words_load(LIGHT_DATA) + (item - instances) * 8u32 + 7u32) == LIGHT_ROOM as f32 {
                var light: u32 = item - instances;
                var first: u32 = (light + 1u32) * words_load(SCENE_CAPACITY);
                var space: u32 = words_load(words_load(LIGHT_SPACE) + light);
                var count: u32 = shadow_seed(
                    first,
                    0u32,
                    words_load(DYNAMIC_COUNT),
                    0u32,
                    space,
                    true
                );
                shadow_build(first, count, 0u32, false);
            }
            item = item + MAX_INVOCATIONS / LOCAL_SIZE;
        }
    }
}
