const PROJECTED_LEAF: u32 = 32u32;
fn projected_power(count: u32) -> u32 {
    var power: u32 = 1u32;
    while power < count {
        power = power * 2u32;
    }
    return power;
}
fn projected_next(node: u32) -> u32 {
    var cursor: u32 = node;
    while cursor > 1u32 && (cursor & 1u32) != 0u32 {
        cursor = cursor / 2u32;
    }
    if cursor <= 1u32 {
        return 0u32;
    }
    return cursor + 1u32;
}
fn projected_overlap(view: u32, node: u32, x: f32, y: f32) -> bool {
    var p: u32 = batch_bounds(view, node);
    return floats_load(p) <= x + 8f32 && floats_load(p + 1u32) <= y + 8f32 && floats_load(
        p + 2u32
    ) >= x && floats_load(p + 3u32) >= y;
}
fn projected_pointer(view: u32, id: u32) -> u32 {
    return words_load(PROJECTED_OFFSET) + (batch_offset(view) * MAX_FAN + id) * 20u32;
}
