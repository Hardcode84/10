fn tile_prepare(slot: u32, view: u32) -> unit {
    var tri: u32 = shared_load(64u32 + slot);
    var scratch: u32 = slot * 304u32;
    var output: u32 = scratch + 144u32;
    project_store(output + 19u32, 0f32);
    if !triangle_visible(tri, view) || !portal_facing(view, scene_meta(tri, 2u32)) {
        return;
    }
    transform_vertices(tri, words_load(VIEW_FLOAT) + view * PORTAL_TRANSFORM_WORDS, scratch);
    var count: u32 = 3u32;
    var plane: u32 = 0u32;
    while plane < 6u32 && count >= 3u32 {
        count = clip_polygon(scratch, count, plane, triangle_near(tri));
        plane = plane + 1u32;
    }
    if count < 3u32 {
        return;
    }
    var vertex: u32 = 0u32;
    while vertex < count {
        if project_load(scratch + vertex * 6u32 + 2u32) <= 0f32 {
            return;
        }
        vertex = vertex + 1u32;
    }
    project_fan(scratch, output, count, tri);
}
fn compute() -> unit {
    var lane: u32 = shader_local_x();
    var task: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    var base: u32 = task_base() + task * 4u32;
    var view: u32 = 0u32;
    var tile: u32 = 0u32;
    var active: bool = task < words_load(6u32) && words_load(5u32) == 0u32;
    if active {
        view = words_load(base + 1u32);
        tile = words_load(base);
    }
    var width: u32 = words_load(0u32);
    var cols: u32 = (width + 7u32) / 8u32;
    var x: u32 = tile % cols * 8u32 + lane % 8u32;
    var y: u32 = tile / cols * 8u32 + lane / 8u32;
    if active {
        active = task_pixel_active(base, lane, x, y, width);
    }
    if lane == 0u32 {
        tile_begin(task, view, tile);
        shared_store(96u32, 0u32);
    }
    if lane < 8u32 {
        shared_store(80u32 + lane, 0u32);
        shared_store(88u32 + lane, 0u32);
    }
    var best: f32 = 0f32;
    var winner: u32 = 0xffffffffu32;
    var u: f32 = 0f32;
    var v: f32 = 0f32;
    var px: f32 = x as f32 + 0.5f32;
    var py: f32 = y as f32 + 0.5f32;
    while shared_uniform_load(0u32) != 0u32 {
        tile_chunk(lane, view);
        var selected: u32 = 0xffffffffu32;
        if active {
            selected = tile_select(px, py, best, winner);
        }
        if selected != 0xffffffffu32 {
            var slot: u32 = selected / 304u32;
            winner = shared_load(64u32 + slot) * MAX_FAN + (selected - slot * 304u32 - 144u32) / 20u32;
            best = candidate_depth(selected, px, py);
            var style: u32 = material_field(scene_meta(winner / MAX_FAN, 1u32), 5u32) & 3u32;
            u = sample_uv(selected, px, py, 3u32, style);
            v = sample_uv(selected, px, py, 4u32, style);
        }
        shader_workgroup_barrier();
        if lane == 0u32 {
            tile_finish_chunk();
            shared_store(96u32, shared_load(96u32) + 1u32);
        }
    }
    if lane == 0u32 && task < words_load(6u32) && words_load(26u32) != 0u32 {
        tile_diagnostics(task);
    }
    if active {
        var pixel: u32 = y * width + x;
        var cache: u32 = words_load(HIT_FLOAT) + pixel * 3u32;
        floats_store(cache, best);
        floats_store(cache + 1u32, u);
        floats_store(cache + 2u32, v);
        words_store(words_load(DEBUG_VALUES) + pixel * 4u32, winner);
    }
}

fn tile_chunk(lane: u32, view: u32) -> unit {
    if lane == 0u32 {
        tile_range_setup(view);
    }
    shader_workgroup_barrier();
    if lane < 48u32 && shared_load(8u32) != 0u32 {
        local_store(
            2432u32 + lane,
            tile_local_plane(
                view,
                shared_load(9u32),
                lane % 24u32 / 4u32,
                lane % 4u32,
                lane >= 24u32
            )
        );
    }
    if lane < 8u32 && shared_load(8u32) != 0u32 {
        tile_seed(lane, shared_load(9u32));
    }
    shader_workgroup_barrier();
    if lane < 8u32 {
        tile_worker(lane);
    }
    shader_workgroup_barrier();
    if lane < 8u32 && shared_load(64u32 + lane) != 0xffffffffu32 {
        tile_prepare(lane, view);
    }
    shader_workgroup_barrier();
}

fn tile_select(px: f32, py: f32, best: f32, winner: u32) -> u32 {
    var slot: u32 = 0u32;
    var selected: u32 = 0xffffffffu32;
    while slot < 8u32 {
        var tri: u32 = shared_load(64u32 + slot);
        var output: u32 = slot * 304u32 + 144u32;
        var fan: u32 = 0u32;
        while tri != 0xffffffffu32 && fan < project_load(output + 19u32) as u32 {
            var p: u32 = output + fan * 20u32;
            var depth: f32 = candidate_depth(p, px, py);
            var identity: u32 = tri * MAX_FAN + fan;
            if nearer(depth, best, identity, winner) && candidate_opaque(tri, p, px, py) {
                best = depth;
                winner = identity;
                selected = p;
            }
            fan = fan + 1u32;
        }
        slot = slot + 1u32;
    }
    return selected;
}
