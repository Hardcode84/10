fn perspective_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var ax: f32 = project_load(p);
    var ay: f32 = project_load(p + 1u32);
    var bx: f32 = project_load(p + 6u32);
    var by: f32 = project_load(p + 7u32);
    var cx: f32 = project_load(p + 12u32);
    var cy: f32 = project_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, x, y);
    var b: f32 = edge(cx, cy, ax, ay, x, y);
    var c: f32 = edge(ax, ay, bx, by, x, y);
    var denominator: f32 = a * project_load(p + 2u32) + b * project_load(p + 8u32) + c * project_load(
        p + 14u32
    );
    var origin: f32 = project_load(p + offset);
    return origin + (project_load(p + 6u32 + offset) - origin) * (
        b * project_load(p + 8u32) / denominator
    ) + (project_load(p + 12u32 + offset) - origin) * (
        c * project_load(p + 14u32) / denominator
    );
}
fn span_sample(p: u32, x: f32, y: f32, offset: u32) -> f32 {
    var left: f32 = 100000f32;
    var right: f32 = -100000f32;
    var i: u32 = 0u32;
    while i < 3u32 {
        var a: u32 = p + i * 6u32;
        var b: u32 = p + ((i + 1u32) % 3u32) * 6u32;
        var ay: f32 = project_load(a + 1u32);
        var by: f32 = project_load(b + 1u32);
        if (ay <= y && by > y) || (by <= y && ay > y) {
            var xx: f32 = project_load(a) + (project_load(b) - project_load(a)) * (y - ay) / (
                by - ay
            );
            if xx < left {
                left = xx;
            }
            if xx > right {
                right = xx;
            }
        }
        i = i + 1u32;
    }
    var a: f32 = ((x as u32 / 8u32) * 8u32) as f32 + 0.5f32;
    var b: f32 = a + 8f32;
    if a < left {
        a = left;
    }
    if b > right {
        b = right;
    }
    if b <= a {
        return perspective_sample(p, x, y, offset);
    }
    var av: f32 = perspective_sample(p, a, y, offset);
    var bv: f32 = perspective_sample(p, b, y, offset);
    return av + (bv - av) * (x - a) / (b - a);
}
fn sample_uv(p: u32, x: f32, y: f32, offset: u32, style: u32) -> f32 {
    if style == 2u32 {
        return span_sample(p, x, y, offset);
    }
    if style != 1u32 {
        return perspective_sample(p, x, y, offset);
    }
    var b: f32 = edge(
        project_load(p + 12u32),
        project_load(p + 13u32),
        project_load(p),
        project_load(p + 1u32),
        x,
        y
    );
    var c: f32 = edge(
        project_load(p),
        project_load(p + 1u32),
        project_load(p + 6u32),
        project_load(p + 7u32),
        x,
        y
    );
    var origin: f32 = project_load(p + offset);
    var area: f32 = project_load(p + 18u32);
    return origin + (project_load(p + 6u32 + offset) - origin) * (b / area) + (
        project_load(p + 12u32 + offset) - origin
    ) * (c / area);
}
fn candidate_depth(p: u32, px: f32, py: f32) -> f32 {
    if project_load(p + 18u32) <= 0f32 {
        return 0f32;
    }
    var ax: f32 = project_load(p);
    var ay: f32 = project_load(p + 1u32);
    var bx: f32 = project_load(p + 6u32);
    var by: f32 = project_load(p + 7u32);
    var cx: f32 = project_load(p + 12u32);
    var cy: f32 = project_load(p + 13u32);
    var a: f32 = edge(bx, by, cx, cy, px, py);
    var b: f32 = edge(cx, cy, ax, ay, px, py);
    var c: f32 = edge(ax, ay, bx, by, px, py);
    if covered(bx, by, cx, cy, px, py) && covered(cx, cy, ax, ay, px, py) && covered(
        ax,
        ay,
        bx,
        by,
        px,
        py
    ) {
        var area: f32 = project_load(p + 18u32);
        var iz: f32 = (
            a * project_load(p + 2u32) + b * project_load(p + 8u32) + c * project_load(p + 14u32)
        ) / area;
        return iz;
    }
    return 0f32;
}
fn candidate_opaque(triangle: u32, p: u32, px: f32, py: f32) -> bool {

    if (scene_meta(triangle, 3u32) & 1u32) == 0u32 {
        return true;
    }
    var mat: u32 = scene_meta(triangle, 1u32);
    var style: u32 = material_field(mat, 5u32) & 3u32;
    return material_texel(
        mat,
        sample_uv(p, px, py, 3u32, style),
        sample_uv(p, px, py, 4u32, style)
    ) != material_field(mat, 9u32);
}
fn nearer(iz: f32, best: f32, id: u32, winner: u32) -> bool {
    return iz > 0f32 && (iz > best || (iz == best && id < winner));
}
