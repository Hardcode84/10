fn compute() -> unit {
    compact_view();
    var index: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    var view: u32 = words_load(9u32) + index;
    if index < words_load(10u32) && words_load(5u32) == 0u32 && batch_active(view) && batch_size(
        view
    ) != 0u32 {
        compact_bounds(view, shader_local_x());
    }
}
