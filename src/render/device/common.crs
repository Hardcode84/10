fn geometry_groups(count: u32) -> u32 {
    if count > MAX_INVOCATIONS {
        return MAX_INVOCATIONS / LOCAL_SIZE;
    }
    return (count + LOCAL_SIZE - 1u32) / LOCAL_SIZE;
}
fn task_base() -> u32 {
    if words_load(8u32) == 0u32 {
        return words_load(TASK_A);
    }
    return words_load(TASK_B);
}
fn other_tasks() -> u32 {
    if words_load(8u32) == 0u32 {
        return words_load(TASK_B);
    }
    return words_load(TASK_A);
}
fn threshold(x: u32, y: u32, mode: u32) -> u32 {
    if mode == 0u32 {
        return ((x + y) & 1u32) * 8u32 + 4u32;
    }
    var a: u32 = ((x & 1u32) ^ (y & 1u32)) * 2u32 + (y & 1u32);
    var b: u32 = (((x >> 1u32) & 1u32) ^ ((y >> 1u32) & 1u32)) * 2u32 + ((y >> 1u32) & 1u32);
    return a * 4u32 + b;
}
fn edge(ax: f32, ay: f32, bx: f32, by: f32, x: f32, y: f32) -> f32 {
    return (bx - ax) * (y - ay) - (by - ay) * (x - ax);
}
fn top_left(ax: f32, ay: f32, bx: f32, by: f32) -> bool {
    return by < ay || (by == ay && bx > ax);
}
fn covered(ax: f32, ay: f32, bx: f32, by: f32, x: f32, y: f32) -> bool {
    // Shared edges must use the same arithmetic in both directions.
    var e: f32 = 0f32;
    if ax < bx || (ax == bx && ay < by) {
        e = edge(ax, ay, bx, by, x, y);
    } else {
        e = 0f32 - edge(bx, by, ax, ay, x, y);
    }
    return e > 0f32 || (e == 0f32 && top_left(ax, ay, bx, by));
}
fn light_color(mat: u32, u: f32, v: f32, z: f32, x: u32, y: u32) -> u32 {
    var color: u32 = material_texel(mat, u, v);
    var light: f32 = floats_load(RENDER_STYLE + 2u32) - z * floats_load(RENDER_STYLE + 3u32);
    if light < floats_load(RENDER_STYLE + 1u32) {
        light = floats_load(RENDER_STYLE + 1u32);
    }
    var level: u32 = light as u32;
    if (light - level as f32) * 16f32 > threshold(x, y, words_load(2u32)) as f32 && level < 63u32 {
        level = level + 1u32;
    }
    return words_load(material_palette(mat) + color * LIGHT_STATES + level);
}

fn light_normal(tri: u32, axis: u32) -> f32 {
    var p: u32 = GEOMETRY + tri * 15u32;
    var a: u32 = (axis + 1u32) % 3u32;
    var b: u32 = (axis + 2u32) % 3u32;
    return (floats_load(p + 5u32 + a) - floats_load(p + a)) * (
        floats_load(p + 10u32 + b) - floats_load(p + b)
    ) - (floats_load(p + 5u32 + b) - floats_load(p + b)) * (
        floats_load(p + 10u32 + a) - floats_load(p + a)
    );
}
fn view_position(view: u32, z: f32, x: u32, y: u32, axis: u32) -> f32 {
    var p: u32 = words_load(VIEW_FLOAT) + view * 16u32;
    var h: f32 = words_load(1u32) as f32;
    var a: f32 = ((2f32 * (x as f32 + 0.5f32) - words_load(0u32) as f32) / h) * floats_load(
        PROJECTION
    ) * z - floats_load(p + 3u32);
    var b: f32 = (1f32 - 2f32 * (y as f32 + 0.5f32) / h) * floats_load(PROJECTION) * z - floats_load(
        p + 7u32
    );
    var c: f32 = z - floats_load(p + 11u32);
    return floats_load(p + axis) * a + floats_load(p + 4u32 + axis) * b + floats_load(
        p + 8u32 + axis
    ) * c;
}
fn light_amount(dx: f32, dy: f32, dz: f32, nx: f32, ny: f32, nz: f32, radius: f32) -> f32 {
    var distance: f32 = dx * dx + dy * dy + dz * dz;
    var incidence: f32 = dx * nx + dy * ny + dz * nz;
    if incidence <= 0f32 {
        return 0f32;
    }
    var diffuse: f32 = incidence / shader_sqrt((nx * nx + ny * ny + nz * nz) * distance);
    var attenuation: f32 = 1f32 + shader_sqrt(distance / radius);
    return diffuse / (attenuation * attenuation);
}
fn light_band(amount: f32, r: f32, g: f32, b: f32) -> f32 {
    var peak: f32 = r;
    if g > peak {
        peak = g;
    }
    if b > peak {
        peak = b;
    }
    if peak == 0f32 {
        return 0f32;
    }
    var scaled: f32 = 7f32 * peak * amount;
    if scaled >= 7f32 {
        return 1f32 / peak;
    }
    var level: u32 = scaled as u32;
    return level as f32 / (7f32 * peak);
}
fn light_at(tri: u32, view: u32, z: f32, x: u32, y: u32) -> u32 {
    var mat: u32 = words_load(words_load(META) + tri * 4u32 + 1u32);
    var space: u32 = words_load(words_load(META) + tri * 4u32);
    var red: f32 = floats_load(SPACE_LIGHT + space * 4u32);
    var green: f32 = floats_load(SPACE_LIGHT + space * 4u32 + 1u32);
    var blue: f32 = floats_load(SPACE_LIGHT + space * 4u32 + 2u32);
    if z <= 0f32 {
        return light_state(red, green, blue, mat);
    }
    var px: f32 = view_position(view, z, x, y, 0u32);
    var py: f32 = view_position(view, z, x, y, 1u32);
    var pz: f32 = view_position(view, z, x, y, 2u32);
    var nx: f32 = light_normal(tri, 0u32);
    var ny: f32 = light_normal(tri, 1u32);
    var nz: f32 = light_normal(tri, 2u32);
    var ex: f32 = view_position(view, 0f32, x, y, 0u32) - px;
    var ey: f32 = view_position(view, 0f32, x, y, 1u32) - py;
    var ez: f32 = view_position(view, 0f32, x, y, 2u32) - pz;
    if ex * nx + ey * ny + ez * nz < 0f32 {
        nx = -nx;
        ny = -ny;
        nz = -nz;
    }
    if floats_load(CAMERA_LIGHT) > 0f32 {
        var amount: f32 = light_amount(ex, ey, ez, nx, ny, nz, floats_load(CAMERA_LIGHT));
        amount = light_band(
            amount,
            floats_load(CAMERA_LIGHT + 1u32),
            floats_load(CAMERA_LIGHT + 2u32),
            floats_load(CAMERA_LIGHT + 3u32)
        );
        red = red + floats_load(CAMERA_LIGHT + 1u32) * amount;
        green = green + floats_load(CAMERA_LIGHT + 2u32) * amount;
        blue = blue + floats_load(CAMERA_LIGHT + 3u32) * amount;
    }
    var i: u32 = 0u32;
    while i < words_load(LIGHT_COUNT) {
        var p: u32 = LIGHT_DATA + i * 8u32;
        if floats_load(p + 7u32) as u32 == space {
            var amount: f32 = light_amount(
                floats_load(p) - px,
                floats_load(p + 1u32) - py,
                floats_load(p + 2u32) - pz,
                nx,
                ny,
                nz,
                floats_load(p + 3u32)
            );
            amount = light_band(
                amount,
                floats_load(p + 4u32),
                floats_load(p + 5u32),
                floats_load(p + 6u32)
            );
            red = red + floats_load(p + 4u32) * amount;
            green = green + floats_load(p + 5u32) * amount;
            blue = blue + floats_load(p + 6u32) * amount;
        }
        i = i + 1u32;
    }
    return light_state(red, green, blue, mat);
}
fn light_state(red: f32, green: f32, blue: f32, mat: u32) -> u32 {
    var emission: f32 = material_field(mat, 6u32) as f32;
    return light_quantize(red + emission) + light_quantize(green + emission) * 8u32 + light_quantize(
        blue + emission
    ) * 64u32;
}
fn light_corner(x: u32, y: u32) -> u32 {
    if words_load(2u32) == 0u32 {
        return ((x + y + 1u32) & 1u32) + ((y + 1u32) & 1u32) * 2u32;
    }
    var u: f32 = (x % 16u32) as f32 / 16f32;
    var v: f32 = (y % 16u32) as f32 / 16f32;
    var t: f32 = (threshold(x, y, 1u32) as f32 + 0.5f32) / 16f32;
    if t < (1f32 - u) * (1f32 - v) {
        return 0u32;
    }
    if t < 1f32 - v {
        return 1u32;
    }
    if t < 1f32 - v + (1f32 - u) * v {
        return 2u32;
    }
    return 3u32;
}
fn light_grid_depth(tri: u32, view: u32, sx: u32, sy: u32) -> f32 {
    var nx: f32 = light_normal(tri, 0u32);
    var ny: f32 = light_normal(tri, 1u32);
    var nz: f32 = light_normal(tri, 2u32);
    var ex: f32 = view_position(view, 0f32, sx, sy, 0u32);
    var ey: f32 = view_position(view, 0f32, sx, sy, 1u32);
    var ez: f32 = view_position(view, 0f32, sx, sy, 2u32);
    var dx: f32 = view_position(view, 1f32, sx, sy, 0u32) - ex;
    var dy: f32 = view_position(view, 1f32, sx, sy, 1u32) - ey;
    var dz: f32 = view_position(view, 1f32, sx, sy, 2u32) - ez;
    var denominator: f32 = nx * dx + ny * dy + nz * dz;
    if denominator == 0f32 {
        return 0f32;
    }
    var p: u32 = GEOMETRY + tri * 15u32;
    return (
        nx * (floats_load(p) - ex) + ny * (floats_load(p + 1u32) - ey) + nz * (
            floats_load(p + 2u32) - ez
        )
    ) / denominator;
}
fn lit_state(tri: u32, view: u32, x: u32, y: u32) -> u32 {
    var corner: u32 = light_corner(x, y);
    var sx: u32 = (x / 16u32 + (corner & 1u32)) * 16u32;
    var sy: u32 = (y / 16u32 + (corner >> 1u32)) * 16u32;
    return light_at(tri, view, light_grid_depth(tri, view, sx, sy), sx, sy);
}
fn light_quantize(value: f32) -> u32 {
    if value >= 1f32 {
        return 7u32;
    }
    return (value * 7f32 + 0.5f32) as u32;
}
fn material_field(mat: u32, field: u32) -> u32 {
    return words_load(words_load(ASSET_OFFSET) + mat * MATERIAL_WORDS + field);
}
fn material_palette(mat: u32) -> u32 {
    return words_load(ASSET_OFFSET) + material_field(mat, 4u32);
}
fn texture_axis(uv: f32, size: u32, mode: u32) -> u32 {
    if mode == ADDRESS_CLAMP {
        if uv <= 0f32 {
            return 0u32;
        }
        if uv >= 1f32 {
            return size - 1u32;
        }
    } else {
        // All finite binary32 values at this magnitude are integers.
        if uv >= 8388608f32 || uv <= -8388608f32 {
            return 0u32;
        }
        var whole: f32 = (uv as i32) as f32;
        if whole > uv {
            whole = whole - 1f32;
        }
        uv = uv - whole;
    }
    var texel: u32 = (uv * size as f32) as u32;
    if texel >= size {
        return size - 1u32;
    }
    return texel;
}
fn material_texel(mat: u32, u: f32, v: f32) -> u32 {
    var x: u32 = texture_axis(u, material_field(mat, 1u32), material_field(mat, 7u32));
    var y: u32 = texture_axis(v, material_field(mat, 2u32), material_field(mat, 8u32));
    return words_load(
        words_load(ASSET_OFFSET) + material_field(mat, 0u32) + x + y * material_field(mat, 3u32)
    );
}
fn surface_color(tri: u32, view: u32, u: f32, v: f32, z: f32, x: u32, y: u32) -> u32 {
    var mat: u32 = words_load(words_load(META) + tri * 4u32 + 1u32);
    if words_load(LIGHT_MODEL) == 0u32 {
        return light_color(mat, u, v, z, x, y);
    }
    var state: u32 = lit_state(tri, view, x, y);
    return words_load(
        material_palette(mat) + material_texel(mat, u, v) * LIGHT_STATES + state
    );
}

fn portal_facing(view: u32, portal: u32) -> bool {
    if portal == 0u32 {
        return true;
    }
    shader_require(portal <= words_load(PORTAL_CAPACITY));
    if portal > words_load(PORTAL_CAPACITY) {
        return false;
    }
    var p: u32 = words_load(PORTAL_FLOAT) + (portal - 1u32) * 16u32;
    var x: f32 = view_position(view, 0f32, 0u32, 0u32, 0u32) - floats_load(p + 3u32);
    var y: f32 = view_position(view, 0f32, 0u32, 0u32, 1u32) - floats_load(p + 7u32);
    var z: f32 = view_position(view, 0f32, 0u32, 0u32, 2u32) - floats_load(p + 11u32);
    var distance: f32 = floats_load(p + 15u32);
    var axis: u32 = 0u32;
    while axis < 3u32 {
        distance = distance + floats_load(p + 12u32 + axis) * (
            floats_load(p + axis) * x + floats_load(p + 4u32 + axis) * y + floats_load(
                p + 8u32 + axis
            ) * z
        );
        axis = axis + 1u32;
    }
    return distance < 0f32;
}
fn triangle_visible(tri: u32, view: u32) -> bool {
    if tri >= words_load(DYNAMIC_COUNT) {
        var instance: u32 = words_load(words_load(INSTANCE_OWNER) + tri);
        if words_load(
            words_load(INSTANCE_VISIBLE) + view * words_load(INSTANCE_COUNT) + instance
        ) == 0u32 {
            return false;
        }
    }
    if (words_load(words_load(META) + tri * 4u32 + 3u32) & 2u32) == 0u32 {
        return true;
    }
    var p: u32 = GEOMETRY + tri * 15u32;
    var distance: f32 = 0f32;
    var axis: u32 = 0u32;
    while axis < 3u32 {
        distance = distance + light_normal(tri, axis) * (
            view_position(view, 0f32, 0u32, 0u32, axis) - floats_load(p + axis)
        );
        axis = axis + 1u32;
    }
    return distance > 0f32;
}

fn task_commands(tasks: u32, previous: u32) -> unit {
    var base: u32 = 0u32;
    var batch: u32 = 0u32;
    while base < words_load(TASK_CAPACITY) {
        var count: u32 = 0u32;
        if tasks > base {
            count = tasks - base;
        }
        if count > MAX_INVOCATIONS / LOCAL_SIZE {
            count = MAX_INVOCATIONS / LOCAL_SIZE;
        }
        var fill: u32 = 0u32;
        if previous > base {
            fill = previous - base;
        }
        if fill > MAX_INVOCATIONS / LOCAL_SIZE {
            fill = MAX_INVOCATIONS / LOCAL_SIZE;
        }
        var p: u32 = words_load(TASK_COMMANDS) + batch * 9u32;
        words_store(p, count);
        words_store(p + 1u32, 1u32);
        words_store(p + 2u32, 1u32);
        words_store(p + 3u32, (count + 63u32) / 64u32);
        words_store(p + 4u32, 1u32);
        words_store(p + 5u32, 1u32);
        words_store(p + 6u32, (fill + 63u32) / 64u32);
        words_store(p + 7u32, 1u32);
        words_store(p + 8u32, 1u32);
        base = base + MAX_INVOCATIONS / LOCAL_SIZE;
        batch = batch + 1u32;
    }
}

fn view_key_words() -> u32 {
    return (words_load(31u32) * words_load(PORTAL_CAPACITY) + 31u32) / 32u32;
}

// Returns floor(coordinate * source / extent). Coordinate must be below extent.
fn image_coordinate(coordinate: u32, source: u32, extent: u32) -> u32 {
    if source <= 0xffffffffu32 / extent {
        return coordinate * source / extent;
    }
    var quotient: u32 = 0u32;
    var remainder: u32 = 0u32;
    var bit: u32 = 32u32;
    while bit != 0u32 {
        bit = bit - 1u32;
        quotient = quotient * 2u32;
        if remainder >= extent - remainder {
            remainder = remainder - (extent - remainder);
            quotient = quotient + 1u32;
        } else {
            remainder = remainder * 2u32;
        }
        if ((source >> bit) & 1u32) != 0u32 {
            if remainder >= extent - coordinate {
                remainder = remainder - (extent - coordinate);
                quotient = quotient + 1u32;
            } else {
                remainder = remainder + coordinate;
            }
        }
    }
    return quotient;
}
