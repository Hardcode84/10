fn view_rect_lane(view: u32, lane: u32) -> unit {
    var low_x: u32 = words_load(0u32);
    var low_y: u32 = words_load(1u32);
    var high_x: u32 = 0u32;
    var high_y: u32 = 0u32;
    var cols: u32 = (words_load(0u32) + 7u32) / 8u32;
    var task: u32 = lane;
    while task < words_load(6u32) {
        var p: u32 = task_base() + task * 4u32;
        if words_load(p + 1u32) == view {
            var tile: u32 = words_load(p);
            var x: u32 = tile % cols * 8u32;
            var y: u32 = tile / cols * 8u32;
            if x < low_x {
                low_x = x;
            }
            if y < low_y {
                low_y = y;
            }
            if x + 8u32 > high_x {
                high_x = x + 8u32;
            }
            if y + 8u32 > high_y {
                high_y = y + 8u32;
            }
        }
        task = task + LOCAL_SIZE;
    }
    shared_store(lane * 4u32, low_x);
    shared_store(lane * 4u32 + 1u32, low_y);
    shared_store(lane * 4u32 + 2u32, high_x);
    shared_store(lane * 4u32 + 3u32, high_y);
}
fn view_rect_reduce(view: u32, axis: u32) -> unit {
    var value: u32 = shared_load(axis);
    var lane: u32 = 1u32;
    while lane < LOCAL_SIZE {
        var next: u32 = shared_load(lane * 4u32 + axis);
        if (axis < 2u32 && next < value) || (axis >= 2u32 && next > value) {
            value = next;
        }
        lane = lane + 1u32;
    }
    words_store(words_load(VIEW_RECT) + view * 4u32 + axis, value);
}
fn compute() -> unit {
    var index: u32 = shader_global_x() / LOCAL_SIZE + words_load(DISPATCH_BASE);
    var lane: u32 = shader_local_x();
    var view: u32 = words_load(9u32) + index;
    if index < words_load(10u32) {
        view_rect_lane(view, lane);
    }
    shader_barrier();
    if index < words_load(10u32) && lane < 4u32 {
        view_rect_reduce(view, lane);
    }
    shader_barrier();
    if index < words_load(10u32) {
        var instance: u32 = lane;
        while instance < words_load(INSTANCE_COUNT) {
            if words_load(words_load(INSTANCE_META) + instance * 5u32 + 1u32) != 0u32 && words_load(
                words_load(INSTANCE_META) + instance * 5u32 + 3u32
            ) == words_load(words_load(VIEW_META) + view * 4u32) {
                scene_instance_planes(view, instance);
                var root: u32 = words_load(words_load(INSTANCE_META) + instance * 5u32) * 2u32;
                var sprite: bool = (
                    words_load(words_load(MESH_NODES) + root * 5u32 + 4u32) & 2u32
                ) != 0u32;
                var visible: bool = sprite || words_load(CULL_DISABLED) != 0u32 || scene_bounds_visible(
                    view,
                    0xffffffffu32,
                    words_load(INSTANCE_FLOAT) + instance * 18u32 + 12u32
                );
                words_store(
                    words_load(INSTANCE_VISIBLE) + view * words_load(INSTANCE_COUNT) + instance,
                    visible as u32
                );
            }
            instance = instance + LOCAL_SIZE;
        }
    }
}
