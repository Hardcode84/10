fn plane_coefficient(view: u32, plane: u32, axis: u32) -> f32 {
    var p: u32 = VIEW_FLOAT + view * 16u32;
    if plane == 0u32 {
        return floats_load(p + 8u32 + axis);
    }
    if plane == 1u32 {
        return floats_load(p + 12u32 + axis);
    }
    var z: f32 = floats_load(p + 8u32 + axis) * floats_load(PROJECTION);
    if plane < 4u32 {
        z = z * words_load(0u32) as f32 / words_load(1u32) as f32;
    }
    var row: u32 = 0u32;
    if plane >= 4u32 {
        row = 4u32;
    }
    if plane % 2u32 == 0u32 {
        return z + floats_load(p + row + axis);
    }
    return z - floats_load(p + row + axis);
}
fn bounds_visible(view: u32, instance: u32) -> bool {
    var bounds: u32 = words_load(INSTANCE_FLOAT) + instance * 18u32 + 12u32;
    var plane: u32 = 0u32;
    while plane < 6u32 {
        var maximum: f32 = plane_coefficient(view, plane, 3u32);
        var magnitude: f32 = plane_magnitude(view, plane, 3u32);
        if magnitude < 0f32 {
            magnitude = -magnitude;
        }
        var axis: u32 = 0u32;
        while axis < 3u32 {
            var coefficient: f32 = plane_coefficient(view, plane, axis);
            var value: f32 = floats_load(bounds + axis + 3u32);
            if coefficient < 0f32 {
                value = floats_load(bounds + axis);
            }
            var term: f32 = coefficient * value;
            maximum = maximum + term;
            var low: f32 = floats_load(bounds + axis);
            var high: f32 = floats_load(bounds + axis + 3u32);
            if low < 0f32 {
                low = -low;
            }
            if high < 0f32 {
                high = -high;
            }
            magnitude = magnitude + plane_magnitude(view, plane, axis) * (low + high);
            axis = axis + 1u32;
        }
        // Retain touching bounds and allow for Float32 transforms and plane evaluation.
        if maximum < -0.00001f32 * (magnitude + 1f32) {
            return false;
        }
        plane = plane + 1u32;
    }
    return true;
}
fn compute() -> unit {
    var i: u32 = shader_global_x();
    var count: u32 = words_load(INSTANCE_COUNT);
    while i < words_load(10u32) * count {
        var view: u32 = words_load(9u32) + i / count;
        var instance: u32 = i % count;
        var visible: bool = words_load(CULL_DISABLED) != 0u32 || bounds_visible(view, instance);
        words_store(words_load(INSTANCE_VISIBLE) + view * count + instance, visible as u32);
        i = i + MAX_INVOCATIONS;
    }
}

fn plane_magnitude(view: u32, plane: u32, axis: u32) -> f32 {
    var p: u32 = VIEW_FLOAT + view * 16u32;
    if plane < 2u32 {
        var value: f32 = floats_load(p + (8u32 + plane * 4u32) + axis);
        if value < 0f32 {
            value = -value;
        }
        return value;
    }
    var z: f32 = floats_load(p + 8u32 + axis) * floats_load(PROJECTION);
    if z < 0f32 {
        z = -z;
    }
    var row: u32 = 4u32;
    if plane < 4u32 {
        z = z * words_load(0u32) as f32 / words_load(1u32) as f32;
        row = 0u32;
    }
    var value: f32 = floats_load(p + row + axis);
    if value < 0f32 {
        value = -value;
    }
    return z + value;
}
