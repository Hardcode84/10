fn expand_triangle(instance: u32, local: u32) -> unit {
    var info: u32 = words_load(INSTANCE_META) + instance * 5u32;
    var source: u32 = words_load(info) + local;
    var triangle: u32 = words_load(info + 2u32) + local;
    var matrix: u32 = words_load(INSTANCE_FLOAT) + instance * 18u32;
    var vertex: u32 = 0u32;
    while vertex < 3u32 {
        var src: u32 = words_load(MESH_FLOAT) + source * 15u32 + vertex * 5u32;
        var dst: u32 = GEOMETRY + triangle * 15u32 + vertex * 5u32;
        var row: u32 = 0u32;
        while row < 3u32 {
            var p: u32 = matrix + row * 4u32;
            floats_store(
                dst + row,
                floats_load(p) * floats_load(src) + floats_load(p + 1u32) * floats_load(
                    src + 1u32
                ) + floats_load(p + 2u32) * floats_load(src + 2u32) + floats_load(p + 3u32)
            );
            row = row + 1u32;
        }
        floats_store(dst + 3u32, floats_load(src + 3u32));
        floats_store(dst + 4u32, floats_load(src + 4u32));
        vertex = vertex + 1u32;
    }
    var meta: u32 = words_load(MESH_META) + source * 4u32;
    var material: u32 = words_load(info + 4u32);
    if material == 0xffffffffu32 {
        material = words_load(meta);
    }
    words_store(words_load(META) + triangle * 4u32, words_load(info + 3u32));
    words_store(words_load(META) + triangle * 4u32 + 1u32, material);
    words_store(words_load(META) + triangle * 4u32 + 2u32, words_load(meta + 1u32));
    words_store(words_load(META) + triangle * 4u32 + 3u32, words_load(meta + 2u32));

}
fn compute() -> unit {
    var instance: u32 = shader_global_x() / LOCAL_SIZE;
    while instance < words_load(INSTANCE_COUNT) {
        var i: u32 = shader_local_x();
        var count: u32 = words_load(words_load(INSTANCE_META) + instance * 5u32 + 1u32);
        while i < count {
            var info: u32 = words_load(INSTANCE_META) + instance * 5u32;
            var first: u32 = words_load(info + 2u32) - words_load(DYNAMIC_COUNT);
            words_store(words_load(INSTANCE_OWNER) + first + i, instance);
            if words_load(26u32) != 0u32 {
                expand_triangle(instance, i);
            }
            i = i + LOCAL_SIZE;
        }
        instance = instance + MAX_INVOCATIONS / LOCAL_SIZE;
    }
}
