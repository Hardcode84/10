fn compute() -> unit {
    var i: u32 = shader_global_x();
    if i == 0u32 {
        render_debug_assert(words_load(33u32) == 0u32);
    }
    var width: u32 = words_load(0u32);
    var height: u32 = words_load(1u32);
    var tiles: u32 = ((width + 7u32) / 8u32) * ((height + 7u32) / 8u32);
    var pixel: u32 = i;
    while pixel < width * height {
        words_store(PIXELS + pixel, words_load(BACKGROUND));
        pixel = pixel + MAX_INVOCATIONS;
    }
    pixel = i;
    while pixel < tiles && tiles <= words_load(TASK_CAPACITY) {
        words_store(words_load(TASK_A) + pixel * 4u32, pixel);
        words_store(words_load(TASK_A) + pixel * 4u32 + 1u32, 0u32);
        words_store(words_load(TASK_A) + pixel * 4u32 + 2u32, 0xffffffffu32);
        words_store(words_load(TASK_A) + pixel * 4u32 + 3u32, 0xffffffffu32);
        pixel = pixel + MAX_INVOCATIONS;
    }
    pixel = i;
    while words_load(26u32) != 0u32 && pixel < words_load(TASK_CAPACITY) {
        var field: u32 = 0u32;
        while field < 4u32 {
            tile_write(words_load(TILE_STATS) + pixel * 4u32 + field, 0u32);
            field = field + 1u32;
        }
        pixel = pixel + MAX_INVOCATIONS;
    }
    if i == 0u32 {
        var bad: u32 = 0u32;
        var limit: u32 = words_load(TILE_WORK_BUDGET);
        if limit == 0u32 {
            limit = 0xffffffffu32;
            if words_load(4u32) <= limit / words_load(TASK_CAPACITY) {
                limit = words_load(4u32) * words_load(TASK_CAPACITY);
            }
        }
        words_store(TRAVERSAL_TILE_LIMIT, limit);
        if tiles > words_load(TASK_CAPACITY) || tiles > limit {
            bad = 1u32;
            tiles = 0u32;
        }
        words_store(PEAK_TASKS, tiles);
        words_store(TRAVERSAL_TILES, tiles);
        words_store(TRAVERSAL_STOPPED, 0u32);
        words_store(TRAVERSAL_ROUNDS, 0u32);
        words_store(ROUND_STOP, words_load(4u32));
        words_store(WORK_NODES, 0u32);
        words_store(WORK_TRIANGLES, 0u32);
        words_store(WORK_BATCHES, 0u32);
        words_store(WORK_EMPTY_ACTIVE, 0u32);
        words_store(WORK_EMPTY_IDLE, 0u32);
        task_commands(tiles, 0u32);
        words_store(5u32, bad);
        words_store(6u32, tiles);
        words_store(7u32, 1u32);
        words_store(8u32, 0u32);
        words_store(9u32, 0u32);
        words_store(10u32, 1u32);
        words_store(11u32, 1u32);
        words_store(12u32, 0u32);
        words_store(16u32, geometry_groups(words_load(PROJECTION_CAPACITY)));
        words_store(17u32, 1u32);
        words_store(18u32, 1u32);
        view_space(0u32, words_load(20u32));
        words_store(words_load(VIEW_META) + 3u32, 0u32);
        words_store(BATCH_MODE, 3u32);
        traversal_frontier(tiles);
        traversal_command(ADVANCE_COMMAND, 0u32);
        var j: u32 = 0u32;
        while j < 12u32 {
            floats_store(words_load(VIEW_FLOAT) + j, floats_load(j));
            j = j + 1u32;
        }
        floats_store(words_load(VIEW_FLOAT) + 12u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 13u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 14u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 15u32, 1f32);
        floats_store(words_load(VIEW_FLOAT) + 16u32, 1f32);
    }
}
