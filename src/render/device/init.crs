fn compute() -> unit {
    var i: u32 = shader_global_x();
    if i == 0u32 {
        shader_require(words_load(33u32) == 0u32);
    }
    var width: u32 = words_load(0u32);
    var height: u32 = words_load(1u32);
    var tiles: u32 = ((width + 7u32) / 8u32) * ((height + 7u32) / 8u32);
    var pixel: u32 = i;
    while pixel < width * height {
        words_store(PIXELS + pixel, words_load(BACKGROUND));
        pixel = pixel + MAX_INVOCATIONS;
    }
    pixel = i;
    while pixel < tiles && tiles <= words_load(TASK_CAPACITY) {
        words_store(words_load(TASK_A) + pixel * 4u32, pixel);
        words_store(words_load(TASK_A) + pixel * 4u32 + 1u32, 0u32);
        words_store(words_load(TASK_A) + pixel * 4u32 + 2u32, 0xffffffffu32);
        words_store(words_load(TASK_A) + pixel * 4u32 + 3u32, 0xffffffffu32);
        pixel = pixel + MAX_INVOCATIONS;
    }
    if i == 0u32 {
        var bad: u32 = 0u32;
        if tiles > words_load(TASK_CAPACITY) {
            bad = 1u32;
            tiles = 0u32;
        }
        words_store(PEAK_TASKS, tiles);
        task_commands(tiles, 0u32);
        words_store(5u32, bad);
        words_store(6u32, tiles);
        words_store(7u32, 1u32);
        words_store(8u32, 0u32);
        words_store(9u32, 0u32);
        words_store(10u32, 1u32);
        words_store(11u32, 1u32);
        words_store(12u32, 0u32);
        words_store(16u32, geometry_groups(words_load(3u32)));
        words_store(17u32, 1u32);
        words_store(18u32, 1u32);
        words_store(words_load(VIEW_META), words_load(20u32));
        var j: u32 = 0u32;
        while j < 12u32 {
            floats_store(words_load(VIEW_FLOAT) + j, floats_load(j));
            j = j + 1u32;
        }
        floats_store(words_load(VIEW_FLOAT) + 12u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 13u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 14u32, 0f32);
        floats_store(words_load(VIEW_FLOAT) + 15u32, 1f32);
    }
}
