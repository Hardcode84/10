fn tour_quad(
    v: mut FrameInput,
    space: u32,
    mat: u32,
    portal: u32,
    ax: f32,
    ay: f32,
    az: f32,
    bx: f32,
    by: f32,
    bz: f32,
    cx: f32,
    cy: f32,
    cz: f32,
    dx: f32,
    dy: f32,
    dz: f32
) -> unit {
    if space == 2u32 {
        quad(
            mut v,
            space,
            mat,
            portal,
            0u32,
            -az,
            ay,
            ax,
            -bz,
            by,
            bx,
            -cz,
            cy,
            cx,
            -dz,
            dy,
            dx
        );
    } else {
        quad(
            mut v,
            space,
            mat,
            portal,
            0u32,
            ax,
            ay,
            az,
            bx,
            by,
            bz,
            cx,
            cy,
            cz,
            dx,
            dy,
            dz
        );
    }
    var base: usize = (GEOMETRY + (input_word(read v, 3usize) - 2u32) * 15u32) as usize;
    var u: f32 = (bx - ax + by - ay + bz - az) * 0.25f32;
    var w: f32 = (dx - ax + dy - ay + dz - az) * 0.25f32;
    input_set_float(mut v, base + 8usize, u);
    input_set_float(mut v, base + 13usize, u);
    input_set_float(mut v, base + 14usize, w);
    input_set_float(mut v, base + 23usize, u);
    input_set_float(mut v, base + 24usize, w);
    input_set_float(mut v, base + 29usize, w);
}
fn tour_face(
    v: mut FrameInput,
    space: u32,
    mat: u32,
    axis: u32,
    k: f32,
    a: f32,
    b: f32,
    c: f32,
    d: f32
) -> unit {
    if axis == 0u32 {
        tour_quad(mut v, space, mat, 0u32, k, a, c, k, b, c, k, b, d, k, a, d);
    } else if axis == 1u32 {
        tour_quad(mut v, space, mat, 0u32, a, k, c, b, k, c, b, k, d, a, k, d);
    } else {
        tour_quad(mut v, space, mat, 0u32, a, c, k, b, c, k, b, d, k, a, d, k);
    }
}
fn tour_box(
    v: mut FrameInput,
    space: u32,
    mat: u32,
    x: f32,
    y: f32,
    z: f32,
    w: f32,
    h: f32,
    d: f32
) -> unit {
    tour_face(mut v, space, mat, 0u32, x, y, y + h, z, z + d);
    tour_face(mut v, space, mat, 0u32, x + w, y, y + h, z, z + d);
    tour_face(mut v, space, mat, 1u32, y, x, x + w, z, z + d);
    tour_face(mut v, space, mat, 1u32, y + h, x, x + w, z, z + d);
    tour_face(mut v, space, mat, 2u32, z, x, x + w, y, y + h);
    tour_face(mut v, space, mat, 2u32, z + d, x, x + w, y, y + h);
}
fn tour_door(v: mut FrameInput, space: u32, z: f32, w: f32, h: f32, portal: u32) -> unit {
    tour_face(mut v, space, 0u32, 2u32, z, -w, -2f32, -2f32, h);
    tour_face(mut v, space, 0u32, 2u32, z, 2f32, w, -2f32, h);
    tour_face(mut v, space, 4u32, 2u32, z, -2f32, 2f32, 3f32, h);
    tour_quad(
        mut v,
        space,
        4u32,
        portal,
        -2f32,
        -2f32,
        z,
        2f32,
        -2f32,
        z,
        2f32,
        3f32,
        z,
        -2f32,
        3f32,
        z
    );
}
fn tour_rooms(v: mut FrameInput) -> unit {
    tour_face(mut v, 0u32, 1u32, 1u32, -2f32, -6f32, 6f32, -6f32, 10f32);
    tour_face(mut v, 0u32, 4u32, 1u32, 5f32, -6f32, 6f32, -6f32, 10f32);
    tour_face(mut v, 0u32, 10u32, 0u32, -6f32, -2f32, 5f32, -6f32, 10f32);
    tour_face(mut v, 0u32, 10u32, 0u32, 6f32, -2f32, 5f32, -6f32, 10f32);
    tour_face(mut v, 0u32, 0u32, 2u32, -6f32, -6f32, 6f32, -2f32, 5f32);
    tour_door(mut v, 0u32, 10f32, 6f32, 5f32, 1u32);
    tour_face(mut v, 1u32, 1u32, 1u32, -2f32, -4f32, 4f32, 0f32, 14f32);
    tour_face(mut v, 1u32, 4u32, 1u32, 4f32, -4f32, 4f32, 0f32, 14f32);
    tour_face(mut v, 1u32, 0u32, 0u32, -4f32, -2f32, 4f32, 0f32, 14f32);
    tour_face(mut v, 1u32, 0u32, 0u32, 4f32, -2f32, 4f32, 0f32, 14f32);
    tour_door(mut v, 1u32, 0f32, 4f32, 4f32, 2u32);
    tour_door(mut v, 1u32, 14f32, 4f32, 4f32, 3u32);
    var i: u32 = 0u32;
    while i < 4u32 {
        var z: f32 = 1f32 + i as f32 * 3.5f32;
        tour_face(mut v, 0u32, 2u32, 2u32, z, -5.9f32, -5.5f32, -2f32, 4.8f32);
        tour_face(mut v, 0u32, 2u32, 2u32, z, 5.5f32, 5.9f32, -2f32, 4.8f32);
        tour_face(mut v, 0u32, 2u32, 1u32, 4.8f32, -5.5f32, 5.5f32, z, z + 0.35f32);
        i = i + 1u32;
    }
    tour_box(mut v, 0u32, 2u32, -4.5f32, -2f32, 3f32, 2f32, 2.3f32, 2f32);
    tour_box(mut v, 0u32, 4u32, 3.2f32, -2f32, 5f32, 2f32, 1.5f32, 3f32);
    tour_face(mut v, 0u32, 6u32, 1u32, -0.48f32, 3.3f32, 5.1f32, 5.2f32, 7.8f32);
    tour_box(mut v, 1u32, 4u32, -3.8f32, -2f32, 5f32, 1.3f32, 3.8f32, 4f32);
    tour_face(mut v, 1u32, 11u32, 0u32, -2.48f32, -1.7f32, 1.5f32, 5.2f32, 8.8f32);
}
fn tour_peak(
    v: mut FrameInput,
    mat: u32,
    ax: f32,
    ay: f32,
    az: f32,
    bx: f32,
    by: f32,
    bz: f32,
    cx: f32,
    cy: f32,
    cz: f32
) -> unit {
    triangle(mut v, 2u32, mat, 0u32, 0u32, -az, ay, ax, -bz, by, bx, -cz, cy, cx);
}
fn tour_rock(v: mut FrameInput, x: f32, z: f32, s: f32) -> unit {
    var y: f32 = terrain_height(x, z);
    tour_peak(mut v, 9u32, x - s, y, z - s, x + s, y, z - s, x, y + s * 2f32, z);
    tour_peak(mut v, 9u32, x + s, y, z - s, x + s, y, z + s, x, y + s * 2f32, z);
    tour_peak(mut v, 8u32, x + s, y, z + s, x - s, y, z + s, x, y + s * 2f32, z);
    tour_peak(mut v, 8u32, x - s, y, z + s, x - s, y, z - s, x, y + s * 2f32, z);
}
fn tour_outdoors(v: mut FrameInput) -> unit {
    var row: u32 = 0u32;
    while row < 4u32 {
        var col: u32 = 0u32;
        while col < 6u32 {
            var x: f32 = col as f32 * 12f32 - 36f32;
            var z: f32 = row as f32 * 18f32;
            tour_quad(
                mut v,
                2u32,
                8u32,
                0u32,
                x,
                terrain_height(x, z),
                z,
                x + 12f32,
                terrain_height(x + 12f32, z),
                z,
                x + 12f32,
                terrain_height(x + 12f32, z + 18f32),
                z + 18f32,
                x,
                terrain_height(x, z + 18f32),
                z + 18f32
            );
            col = col + 1u32;
        }
        row = row + 1u32;
    }
    tour_door(mut v, 2u32, 0f32, 8f32, 7f32, 4u32);
    tour_face(mut v, 2u32, 4u32, 1u32, 7f32, -8f32, 8f32, -4f32, 0f32);
    tour_box(mut v, 2u32, 0u32, -11f32, -2f32, 10f32, 3f32, 16f32, 5f32);
    tour_box(mut v, 2u32, 2u32, 7f32, -2f32, 17f32, 4f32, 21f32, 5f32);
    tour_face(mut v, 2u32, 4u32, 1u32, 10f32, -8f32, 8f32, 14f32, 16f32);
    tour_face(mut v, 2u32, 11u32, 2u32, 14f32, -8f32, 8f32, 10f32, 11f32);
    tour_rock(mut v, -7f32, 28f32, 3f32);
    tour_rock(mut v, 12f32, 34f32, 4f32);
    tour_rock(mut v, -16f32, 39f32, 5f32);
    tour_rock(mut v, 24f32, 56f32, 9f32);
    tour_rock(mut v, -25f32, 61f32, 11f32);
    tour_rock(mut v, 4f32, 68f32, 12f32);
    tour_face(mut v, 2u32, 6u32, 2u32, 9.98f32, -10.4f32, -8.6f32, 7f32, 12f32);
    tour_face(mut v, 2u32, 5u32, 2u32, 16.98f32, 7.5f32, 10.5f32, 12f32, 17f32);
}
fn tour_lamps(v: mut FrameInput) -> unit {
    tour_face(mut v, 0u32, 5u32, 0u32, -5.95f32, 1.5f32, 2.5f32, -1f32, 1f32);
    tour_face(mut v, 0u32, 6u32, 0u32, 5.95f32, 1.5f32, 2.5f32, 6f32, 8f32);
    tour_face(mut v, 1u32, 6u32, 0u32, 3.95f32, 1.5f32, 2.5f32, 2f32, 4f32);
    tour_face(mut v, 1u32, 5u32, 0u32, -3.95f32, 1.5f32, 2.5f32, 10f32, 12f32);
}
fn tour_camera(v: mut FrameInput, frame: u32) -> unit {
    var phase: f32 = (frame % 1200u32) as f32 / 1200f32;
    var journey: f32 = -3f32 + 26.5f32 * (1f32 - cosf(phase * 6.2831853f32));
    var z: f32 = journey;
    var x: f32 = sinf(phase * 6.2831853f32) * 0.65f32;
    var yaw: f32 = sinf(phase * 12.5663706f32) * 0.16f32;
    var space: u32 = 0u32;
    if journey >= 10f32 {
        space = 1u32;
        z = journey - 10f32;
    }
    if journey >= 24f32 {
        space = 2u32;
        z = x;
        x = 24f32 - journey;
        yaw = yaw - 1.5707963f32 + (journey - 24f32) / 26f32 * 3.1415927f32;
    }
    var c: f32 = cosf(yaw);
    var s: f32 = sinf(yaw);
    input_set_word(mut v, 20usize, space);
    input_set_float(mut v, 0usize, c);
    input_set_float(mut v, 1usize, 0f32);
    input_set_float(mut v, 2usize, -s);
    input_set_float(mut v, 3usize, -c * x + s * z);
    input_set_float(mut v, 4usize, 0f32);
    input_set_float(mut v, 5usize, 1f32);
    input_set_float(mut v, 6usize, 0f32);
    input_set_float(mut v, 7usize, -0.5f32);
    input_set_float(mut v, 8usize, s);
    input_set_float(mut v, 9usize, 0f32);
    input_set_float(mut v, 10usize, c);
    input_set_float(mut v, 11usize, -s * x - c * z);
}
fn tour_scene(v: mut FrameInput, width: u32, height: u32, frame: u32, mode: u32) -> unit {
    input_set_word(mut v, 0usize, width);
    input_set_word(mut v, 1usize, height);
    input_set_word(mut v, 2usize, mode);
    input_set_word(mut v, 3usize, 0u32);
    input_set_word(mut v, 4usize, 3u32);
    input_set_word(mut v, BACKGROUND as usize, 0xff493525u32);
    input_set_float(mut v, RENDER_STYLE as usize, 0.125f32);
    tour_camera(mut v, frame);
    tour_rooms(mut v);
    tour_outdoors(mut v);
    tour_lamps(mut v);
    tour_light(
        mut v,
        6u32,
        1u32,
        1.5f32,
        0.8f32,
        7f32 + 2f32 * sinf(frame as f32 * 0.025f32),
        10f32,
        0.8f32,
        0.18f32,
        0.08f32
    );
    tour_box(
        mut v,
        1u32,
        5u32,
        1.3f32,
        0.6f32,
        6.8f32 + 2f32 * sinf(frame as f32 * 0.025f32),
        0.4f32,
        0.4f32,
        0.4f32
    );
}
