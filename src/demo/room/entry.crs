fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && strcmp(argv[1usize], "--help") == 0i32 {
        puts("SPINWARD | Generated room flight demo");
        puts("WASD Ctrl/Space: move | mouse: look | Q/E: roll");
        puts("RMB: burst | F: brake | LMB: hold tether | R or Space: fast reel");
        puts("Backspace: reset | F4: spin | L: level | P: prediction | Tab: pause | Esc: exit");
        puts("--width N --height N --fov 70..110 --bindings FILE");
        puts("--headless --ticks N --capture FILE --record FILE --replay FILE");
        return 0i32;
    }
    var options: Launch = uninit;
    if !game_options_scene(argc, argv, &options, true) {
        return 2i32;
    }
    return game_run(game_session(&options), options.config);
}
