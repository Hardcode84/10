fn game_world_open(session: mut GameSession, collision: mut CollisionScene, trial: mut Trial) -> bool {
    if !demo_room_build(
        mut session.room,
        mut collision,
        mut session.room_mesh,
        mut session.control.graph,
        session.control.launch.config.seed
    ) {
        return false;
    }
    if !room_asset_player_spawn(read session.room) {
        return false;
    }
    demo_room_start(read session.room, mut trial);
    return true;
}
fn demo_room_start(asset: read RoomAsset, trial: mut Trial) -> unit {
    var spawn: Drone = new_drone();
    assign_drone(mut trial.spawn, read spawn);
    trial.spawn.position = asset.spawn.position;
    trial.spawn.basis = asset.spawn.basis;
    trial.auto_level = false;
    reset_trial(mut trial);
}

fn game_world_ambient() -> Vec3 {
    return demo_room_ambient();
}

fn game_world_palette(input: mut FrameInput) -> bool {
    return demo_palette(mut input);
}

fn game_world_lighting(
    scene: read CollisionScene,
    input: mut FrameInput,
    anchors: mut RoomAnchors
) -> unit {
    demo_room_lighting(read scene, mut input, mut anchors);
}
