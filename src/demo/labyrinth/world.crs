fn game_world_open(session: mut GameSession, collision: mut CollisionScene, trial: mut Trial) -> bool {
    if session.control.launch.config.scaling {
        return scaling_graph(mut session.control.graph) && scaling_prop(
            mut session.fixture_mesh
        ) && graph_assemble(
            mut session.control.graph,
            mut collision,
            mut session.room_mesh,
            mut trial
        );
    }
    return graph_generate(
        mut session.control.graph,
        session.control.launch.config.seed,
        session.control.launch.config.complexity
    ) && graph_assemble(
        mut session.control.graph,
        mut collision,
        mut session.room_mesh,
        mut trial
    );
}

fn game_world_ambient() -> Vec3 {
    return vec(0f32, 0f32, 0f32);
}

fn game_world_palette(input: mut FrameInput) -> bool {
    return game_room_palette(mut input);
}

fn game_world_lighting(
    scene: read CollisionScene,
    input: mut FrameInput,
    anchors: mut RoomAnchors
) -> unit {}
