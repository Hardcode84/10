fn graph_open_socket(graph: read RoomGraph, room: u32) -> u32 {
    var node: GraphNode = graph_node(read graph, room);
    var socket: u32 = node.first;
    while graph_socket(read graph, socket).peer != 0xffffffffu32 {
        socket = socket + 1u32;
    }
    return socket;
}
fn graph_corridor_kind(graph: mut RoomGraph) -> u32 {
    if graph_random(mut graph, 10u32) < 3u32 {
        return 2u32;
    }
    return 1u32;
}
fn graph_route_run(graph: mut RoomGraph, root: u32, run_length: u32) -> u32 {
    var socket: u32 = root;
    var step: u32 = 0u32;
    while step < run_length {
        var kind: u32 = graph_corridor_kind(mut graph);
        var child: u32 = graph_grow(mut graph, socket, kind);
        socket = graph_open_socket(read graph, child);
        step = step + 1u32;
    }
    return socket;
}
fn graph_merge_routes(graph: mut RoomGraph, a: u32, b: u32) -> u32 {
    var room: u32 = graph_grow(mut graph, a, 3u32);
    var entrance: u32 = graph_open_socket(read graph, room);
    graph_pair(mut graph, b, entrance);
    return graph_open_socket(read graph, room);
}
fn graph_route_gap(graph: mut RoomGraph, socket: u32) -> u32 {
    var run_length: u32 = 4u32 + graph_random(mut graph, 3u32);
    return graph_route_run(mut graph, socket, run_length);
}
fn graph_route_fork(graph: mut RoomGraph, socket: u32) -> u32 {
    var room: u32 = graph_grow(mut graph, socket, 3u32);
    var a: u32 = graph_open_socket(read graph, room);
    a = graph_route_gap(mut graph, a);
    var b: u32 = graph_open_socket(read graph, room);
    b = graph_route_gap(mut graph, b);
    var joined: u32 = graph_merge_routes(mut graph, a, b);
    return graph_route_gap(mut graph, joined);
}
fn graph_routes(graph: mut RoomGraph, complexity: u32) -> unit {
    var ends: [u32; 8] = make [u32; 8] {
        0u32,
        1u32,
        2u32,
        3u32,
        4u32,
        5u32,
        6u32,
        7u32
    };
    var count: u32 = 8u32;
    while count > 1u32 {
        var selected: u32 = graph_random(mut graph, count);
        count = count - 1u32;
        var saved: u32 = ends[count as usize];
        ends[count as usize] = ends[selected as usize];
        ends[selected as usize] = saved;
    }
    var root: u32 = 0u32;
    while root < 8u32 {
        ends[root as usize] = graph_route_run(
            mut graph,
            ends[root as usize],
            complexity + 6u32
        );
        root = root + 1u32;
    }
    count = 8u32;
    while count > 1u32 {
        var pair: u32 = 0u32;
        while pair < count / 2u32 {
            var joined: u32 = graph_merge_routes(
                mut graph,
                ends[(pair * 2u32) as usize],
                ends[(pair * 2u32 + 1u32) as usize]
            );
            ends[pair as usize] = graph_route_gap(mut graph, joined);
            pair = pair + 1u32;
        }
        count = count / 2u32;
    }
    var socket: u32 = ends[0usize];
    var forks: u32 = 1u32 + complexity / 3u32;
    while forks != 0u32 {
        socket = graph_route_fork(mut graph, socket);
        forks = forks - 1u32;
    }
    var goal: u32 = graph_grow(mut graph, socket, 6u32);
    graph_set_goal(mut graph, goal);
}
