record GraphNode {
    placement: SpaceTransform;
    kind: u32;
    first: u32;
    count: u32;
    depth: u32;
    branch: u32;
    style: u32;
    mesh: MeshRange;
    visited: bool;
}
record GraphSocket {
    room: u32;
    peer: u32;
    roll: u32;
    port: RoomPort;
}
resource RoomGraph {
    recipes: *RoomRecipe;
    lights: FixtureLights;
    sparks: SparkEmitters;
    arcs: ArcEmitters;
    doors: DoorSet;
    motions: InstanceList;
    nodes: *GraphNode;
    sockets: *GraphSocket;
    capacity: u32;
    count: u32;
    port_count: u32;
    goal: u32;
    random: u32;
}
opaque drop graph_drop;
fn graph_new() -> RoomGraph {
    return make RoomGraph {
        recipes: null(*RoomRecipe),
        lights: fixture_lights_new(),
        sparks: spark_emitters_new(),
        arcs: arc_emitters_new(),
        doors: doors_new(),
        motions: instances_new(),
        nodes: null(*GraphNode),
        sockets: null(*GraphSocket),
        capacity: 0u32,
        count: 0u32,
        port_count: 0u32,
        goal: 0u32,
        random: 0u32
    };
}
fn graph_drop(graph: mut RoomGraph) -> unit {
    var i: u32 = 0u32;
    while i < graph.count {
        drop graph.recipes[i as usize];
        i = i + 1u32;
    }
    free(graph.recipes as *u8);
    free(graph.nodes as *u8);
    free(graph.sockets as *u8);
}
fn graph_allocate(graph: mut RoomGraph, capacity: u32, seed: u32) -> bool {
    graph.recipes = malloc(capacity as usize * sizeof(RoomRecipe)) as *RoomRecipe;
    graph.nodes = malloc(capacity as usize * sizeof(GraphNode)) as *GraphNode;
    graph.sockets = malloc(capacity as usize * 8usize * sizeof(GraphSocket)) as *GraphSocket;
    graph.capacity = capacity;
    graph.random = generation_seed(seed);
    return graph.recipes != null(*RoomRecipe) && graph.nodes != null(*GraphNode) && graph.sockets != null(
        *GraphSocket
    ) || error("graph allocation failed");
}
fn graph_node(graph: read RoomGraph, index: u32) -> GraphNode {
    return graph.nodes[index as usize];
}
fn graph_node_set(graph: mut RoomGraph, index: u32, node: GraphNode) -> unit {
    graph.nodes[index as usize] = node;
}
fn graph_socket(graph: read RoomGraph, index: u32) -> GraphSocket {
    return graph.sockets[index as usize];
}
fn graph_socket_set(graph: mut RoomGraph, index: u32, socket: GraphSocket) -> unit {
    graph.sockets[index as usize] = socket;
}
fn graph_count(graph: read RoomGraph) -> u32 {
    return graph.count;
}
fn graph_ports(graph: read RoomGraph) -> u32 {
    return graph.port_count;
}
fn graph_goal(graph: read RoomGraph) -> u32 {
    return graph.goal;
}
fn graph_set_goal(graph: mut RoomGraph, room: u32) -> unit {
    graph.goal = room;
}
fn graph_random(graph: mut RoomGraph, bound: u32) -> u32 {
    graph.random = generation_next(graph.random);
    return generation_draw(graph.random, bound);
}
fn graph_add(graph: mut RoomGraph, kind: u32, depth: u32, branch: u32) -> u32 {
    var count: u32 = 2u32;
    if kind == 0u32 {
        count = 8u32;
    }
    if kind == 3u32 {
        count = 3u32;
    }
    if kind == 4u32 {
        count = 4u32;
    }
    if kind >= 5u32 {
        count = 1u32;
    }
    return graph_add_ports(mut graph, kind, depth, branch, count);
}
// Capacity must cover the rooms and the total socket count.
fn graph_add_ports(graph: mut RoomGraph, kind: u32, depth: u32, branch: u32, count: u32) -> u32 {
    var id: u32 = graph.count;
    if id >= graph.capacity || graph.port_count + count > graph.capacity * 8u32 {
        trap;
    }
    graph.recipes[id as usize] = room_recipe_new();
    graph.nodes[id as usize] = make GraphNode {
        placement: space_identity(),
        kind: kind,
        first: graph.port_count,
        count: count,
        depth: depth,
        branch: branch,
        style: 0u32,
        mesh: mesh_empty_range(),
        visited: false
    };
    var i: u32 = 0u32;
    while i < count {
        graph.sockets[(graph.port_count + i) as usize] = make GraphSocket {
            room: id,
            peer: 0xffffffffu32,
            roll: 0u32,
            port: junction_port(0u32, 0u32, 3f32)
        };
        i = i + 1u32;
    }
    graph.port_count = graph.port_count + count;
    graph.count = graph.count + 1u32;
    return id;
}
fn graph_pair(graph: mut RoomGraph, a: u32, b: u32) -> unit {
    var roll: u32 = graph_random(mut graph, 6u32);
    graph.sockets[a as usize].peer = b;
    graph.sockets[b as usize].peer = a;
    graph.sockets[a as usize].roll = roll;
    graph.sockets[b as usize].roll = roll;
}
fn graph_mesh_bounds(mesh: read Mesh) -> [f32; 6] {
    return mesh.bounds;
}
fn graph_lights(graph: read RoomGraph) -> read FixtureLights from graph {
    return read graph.lights;
}
fn graph_lights_append(graph: mut RoomGraph, source: read FixtureLights, room: u32) -> bool {
    return fixture_lights_place(read source, room, mut graph.lights);
}

fn graph_doors(graph: read RoomGraph) -> read DoorSet from graph {
    return read graph.doors;
}
fn graph_doors_add(
    graph: mut RoomGraph,
    asset: read RoomAsset,
    builder: mut CollisionBuilder,
    room: u32,
    material: u32
) -> bool {
    return doors_asset(mut graph.doors, read asset, mut builder, room, material);
}
fn graph_doors_upload(graph: mut RoomGraph, input: mut FrameInput) -> bool {
    return doors_upload(mut graph.doors, mut input);
}

fn graph_doors_mut(graph: mut RoomGraph) -> mut DoorSet from graph {
    return mut graph.doors;
}

fn graph_motion_append(graph: mut RoomGraph, instance: MeshInstance) -> bool {
    return instances_append(mut graph.motions, instance);
}
fn graph_motion_count(graph: read RoomGraph) -> u32 {
    return instances_count(read graph.motions);
}
fn graph_motion_get(graph: read RoomGraph, index: u32) -> MeshInstance {
    return instances_get(read graph.motions, index);
}

fn graph_sparks(graph: read RoomGraph) -> read SparkEmitters from graph {
    return read graph.sparks;
}
fn graph_effects_add(graph: mut RoomGraph, asset: read RoomAsset, room: u32, material: u32) -> bool {
    return spark_emitters_place(read asset.sparks, mut graph.sparks, room, material) && arc_emitters_place(
        read asset.arcs,
        mut graph.arcs,
        room,
        material
    );
}

fn graph_arcs(graph: read RoomGraph) -> read ArcEmitters from graph {
    return read graph.arcs;
}
