fn demo_assets(inputs: mut FrameInput, o: DemoConfig) -> unit {
    if o.test == 2u32 || o.test == 5u32 {
        palettes(mut inputs);
        portal_setup(mut inputs);
    } else {
        tour_assets(mut inputs);
    }
    var material: usize = 0usize;
    while material < 16usize {
        input_set_word(
            mut inputs,
            (MATERIAL_STYLE as usize) + material,
            o.mapping | (o.snap * 4u32)
        );
        material = material + 1usize;
    }
}
fn demo_output(session: mut DemoSession, playback: mut Playback, o: DemoConfig, index: u32) -> bool {
    var good: bool = true;
    if o.capture {
        if index + 1u32 == o.frames {
            good = session_capture(read session);
        }
    } else {
        good = session_present(mut session) && playback_print(read playback);
        if good && index + 1u32 < o.frames {
            good = playback_next(mut playback);
        }
    }
    return good;
}
fn demo_frame(o: DemoConfig, index: u32, frame_index: u32) -> u32 {
    var frame: u32 = o.frame + index;
    if !o.capture {
        frame = frame_index;
    }
    if o.test == 2u32 {
        frame = index * 60u32;
        if index == 7u32 {
            frame = 0u32;
        }
        if index >= 8u32 && index < 14u32 {
            frame = 281u32 + index - 8u32;
        }
        if index >= 14u32 {
            frame = 500u32 + index - 14u32;
        }
        if index == 21u32 {
            frame = 512u32;
        }
        if index == 22u32 {
            frame = 523u32;
        }
        if index >= 23u32 {
            frame = 367u32 + index - 23u32;
        }
    }
    if o.test == 4u32 {
        frame = tour_test_frame(index);
    }
    return frame;
}
fn demo_scene(inputs: mut FrameInput, o: DemoConfig, frame: u32, index: u32) -> unit {
    if o.test == 5u32 {
        capacity_scene(mut inputs, index);
        return;
    }
    if o.test == 2u32 {
        scene(mut inputs, o.width, o.height, frame, o.dither);
    } else {
        tour_scene(mut inputs, o.width, o.height, frame, o.dither);
    }
    if o.test == 4u32 {
        var lights: u32 = 7u32;
        var camera_radius: f32 = 36f32;
        if index == 37u32 {
            lights = 0u32;
            camera_radius = 0f32;
        }
        if index == 46u32 {
            lights = 0u32;
        }
        input_set_word(mut inputs, LIGHT_COUNT as usize, lights);
        input_set_float(mut inputs, CAMERA_LIGHT as usize, camera_radius);
    }
    if o.test == 4u32 && index >= 48u32 {
        var angle: f32 = 70f32 * 0.00872664626f32;
        if index == 49u32 {
            angle = 110f32 * 0.00872664626f32;
        }
        input_set_float(mut inputs, PROJECTION as usize, sinf(angle) / cosf(angle));
    }
    if o.test == 4u32 && index == 47u32 {
        light_band_scene(mut inputs);
    }
}
fn demo_run(session: DemoSession, o: DemoConfig) -> i32 {
    var good: bool = session_open(mut session);
    if good {
        var renderer: mut Renderer = session_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        demo_assets(mut inputs, o);
    }
    var index: u32 = 0u32;
    var playback: Playback = make Playback {
        frame: o.frame,
        paused: false,
        running: true
    };
    if good && !o.capture {
        demo_controls();
    }
    while good && playback.running && index < o.frames {
        var start: u64 = now();
        var frame: u32 = demo_frame(o, index, playback.frame);
        {
            var renderer: mut Renderer = session_renderer(mut session);
            var inputs: FrameInput = renderer_inputs(mut renderer);
            demo_scene(mut inputs, o, frame, index);
            if o.test == 2u32 && index == 6u32 {
                quad(
                    mut inputs,
                    1u32,
                    4u32,
                    0u32,
                    0u32,
                    -100f32,
                    -100f32,
                    -0.25f32,
                    100f32,
                    -100f32,
                    -0.25f32,
                    100f32,
                    100f32,
                    -0.25f32,
                    -100f32,
                    100f32,
                    -0.25f32
                );
            }
            if o.test == 2u32 && index == 7u32 {
                quad(
                    mut inputs,
                    0u32,
                    4u32,
                    0u32,
                    0u32,
                    -8f32,
                    -8f32,
                    7f32,
                    8f32,
                    -8f32,
                    7f32,
                    8f32,
                    8f32,
                    7f32,
                    -8f32,
                    8f32,
                    7f32
                );
            }
        }
        good = session_draw(mut session);
        session_sample(mut session, index, now() - start);
        if good {
            good = session_verify(read session, index, frame);
        }
        if good {
            good = demo_output(mut session, mut playback, o, index);
        }
        index = index + 1u32;
    }
    if good {
        good = session_report(mut session);
    }
    return (!good) as i32;
}

fn tour_test_frame(index: u32) -> u32 {
    if index >= 48u32 {
        return 240u32;
    }
    if index == 47u32 {
        return 0u32;
    }
    if index == 46u32 {
        return 170u32;
    }
    if index >= 44u32 {
        return 210u32 + (index - 44u32) * 90u32;
    }
    if index >= 41u32 {
        return 316u32 + index - 41u32;
    }
    if index >= 38u32 {
        return 229u32 + index - 38u32;
    }
    if index == 37u32 {
        return 240u32;
    }
    if index < 21u32 {
        return index * 60u32;
    }
    if index < 25u32 {
        return 179u32 + index - 21u32;
    }
    if index < 29u32 {
        return 332u32 + index - 25u32;
    }
    if index < 33u32 {
        return 865u32 + index - 29u32;
    }
    return 1018u32 + index - 33u32;
}
