extern fn frame_printf(format: *u8, frame: u32) -> i32 = "printf";
fn frame_print(p: *Playback) -> bool {
    var format: *u8 = "frame %u\n";
    if p -> paused {
        format = "frame %u (paused)\n";
    }
    if frame_printf(format, p -> frame) < 0i32 || fflush(null(*u8)) != 0i32 {
        return error("cannot print frame index");
    }
    return true;
}
record WindowEvent {
    status: i32;
    kind: u32;
    key: u32;
    repeat: bool;
}
fn window_event(wait: bool) -> WindowEvent {
    var event: [u64; 8] = uninit;
    zero(&event as *u8, sizeof([u64; 8]));
    var status: i32 = 0i32;
    if wait {
        status = SDL_WaitEvent(&event as *u8);
        if status == 0i32 {
            error(SDL_GetError());
            status = -1i32;
        }
    } else {
        status = SDL_PollEvent(&event as *u8);
    }
    return make WindowEvent {
        status: status,
        kind: (&event as *u32)[0usize],
        key: (&event as *u32)[5usize],
        repeat: (&event as *u8)[13usize] != 0u8
    };
}
fn playback_overflow() -> bool {
    return error("frame index overflow");
}
