resource DemoWindow {
    handle: *u8;
}
opaque drop demo_window_drop;
fn demo_window_drop(window: mut DemoWindow) -> unit {
    window_close(window.handle);
}
record DemoSession {
    window: DemoWindow;
    renderer: Renderer;
    options: Options;
    samples: [u64; 4096];
    measured: u32;
}
opaque;
fn session_new(source: *Options) -> DemoSession {
    var samples: [u64; 4096] = uninit;
    zero(&samples as *u8, sizeof([u64; 4096]));
    return make DemoSession {
        window: make DemoWindow {
            handle: null(*u8)
        },
        renderer: renderer_new(),
        options: *source,
        samples: samples,
        measured: 0u32
    };
}
fn session_renderer(session: mut DemoSession) -> mut Renderer from session {
    return mut session.renderer;
}
fn session_open(session: mut DemoSession) -> bool {
    var o: *Options = &session.options;
    if o -> capture == null(*u8) && !window_open(
        &session.window.handle,
        o -> window_width,
        o -> window_height
    ) {
        return false;
    }
    return demo_renderer_open(&session.renderer.state, o, session.window.handle);
}
fn session_draw(session: mut DemoSession) -> bool {
    return renderer_draw(&session.renderer.state);
}
fn session_verify(session: read DemoSession, index: u32, frame: u32) -> bool {
    var v: *Vulkan = &session.renderer.state;
    var o: *Options = &session.options;
    if o -> test == 2u32 {
        if !portal_plane_check(v) {
            return false;
        }
        if index == 0u32 && (v -> mapped as *u32)[11usize] < 3u32 {
            return error("two transformed portal views were not created");
        }
        if index == 7u32 && (v -> mapped as *u32)[11usize] != 1u32 {
            return error("hidden portal created child work");
        }
        if frame == 523u32 && !crossing_face_check(v) {
            return false;
        }
        if (frame == 367u32 || frame == 368u32) && !distant_cube_check(v, frame) {
            return false;
        }
    }
    return o -> verify == 0u32 || (reference_check(v -> mapped) && presentation_check(v));
}
fn session_sample(session: mut DemoSession, index: u32, elapsed: u64) -> unit {
    if index > 0u32 {
        session.samples[session.measured as usize] = elapsed;
        session.measured = session.measured + 1u32;
    }
}
fn session_capture(session: read DemoSession) -> bool {
    return capture(
        &session.renderer.state,
        session.options.capture,
        session.options.window_width,
        session.options.window_height
    );
}
fn session_present(session: mut DemoSession) -> bool {
    return present(
        &session.renderer.state,
        session.options.window_width,
        session.options.window_height
    );
}
fn session_report(session: mut DemoSession) -> bool {
    var good: bool = queries_report(&session.renderer.state);
    if session.measured > 0u32 {
        report(&session.samples[0usize], session.measured);
    }
    return good;
}
fn playback_print(playback: read Playback) -> bool {
    return frame_print(&playback);
}
fn demo_controls() -> unit {
    puts("Space: pause/resume | Left/Right: previous/next frame");
}
fn scene_overflow() -> unit {
    puts("scene exceeds triangle budget");
    exit(1i32);
}
fn config_from_options(o: *Options) -> DemoConfig {
    return make DemoConfig {
        capture: o -> capture != null(*u8),
        width: o -> width,
        height: o -> height,
        frame: o -> frame,
        frames: o -> frames,
        dither: o -> dither,
        verify: o -> verify,
        baseline: o -> baseline,
        view_budget: o -> view_budget,
        fault: o -> fault,
        test: o -> test,
        mapping: o -> mapping,
        snap: o -> snap,
        window_width: o -> window_width,
        window_height: o -> window_height
    };
}
