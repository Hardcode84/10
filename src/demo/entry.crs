fn option_value(key: *u8, value: *u8, o: *Options) -> bool {
    if strcmp(key, "--capture") == 0i32 {
        o -> capture = value;
        return true;
    }
    var keys: [*u8; 14] = make [*u8; 14] {
        "--window-width",
        "--window-height",
        "--mapping",
        "--snap",
        "--test",
        "--view-budget",
        "--fault",
        "--baseline",
        "--verify",
        "--width",
        "--height",
        "--frame",
        "--frames",
        "--dither"
    };
    var targets: [*u32; 14] = make [*u32; 14] {
        &o -> window_width,
        &o -> window_height,
        &o -> mapping,
        &o -> snap,
        &o -> test,
        &o -> view_budget,
        &o -> fault,
        &o -> baseline,
        &o -> verify,
        &o -> width,
        &o -> height,
        &o -> frame,
        &o -> frames,
        &o -> dither
    };
    var index: usize = 0usize;
    while index < 14usize {
        if strcmp(key, keys[index]) == 0i32 {
            return parse_number(value, targets[index]);
        }
        index = index + 1usize;
    }
    return error("unknown option: use --help");
}
fn option_dimensions(o: *Options) -> bool {
    return o -> width != 0u32 && o -> height != 0u32 && o -> width <= 1920u32 && o -> height <= 1080u32 && o -> window_width <= 1920u32 && o -> window_height <= 1080u32 && o -> frames != 0u32 && o -> frames <= 4096u32;
}
fn option_modes(o: *Options) -> bool {
    return o -> dither <= 1u32 && o -> view_budget != 0u32 && o -> view_budget <= MAX_VIEWS && o -> fault <= 1u32 && o -> test <= 7u32 && o -> mapping <= 2u32 && o -> snap <= 1u32 && (
        o -> verify == 0u32 || (o -> mapping == 0u32 && o -> snap == 0u32)
    );
}
extern fn reference_check(mapped: *u8) -> bool = "reference_check";
record Options {
    capture: *u8;
    width: u32;
    height: u32;
    frame: u32;
    frames: u32;
    dither: u32;
    verify: u32;
    baseline: u32;
    view_budget: u32;
    fault: u32;
    test: u32;
    mapping: u32;
    snap: u32;
    window_width: u32;
    window_height: u32;
}
opaque;
extern fn strcmp(a: *u8, b: *u8) -> i32 = "strcmp";
fn parse_number(text: *u8, result: *u32) -> bool {
    var i: usize = 0usize;
    var value: u32 = 0u32;
    while text[i] != 0u8 {
        if text[i] < 48u8 || text[i] > 57u8 || value > 100000u32 {
            return error("invalid numeric argument");
        }
        value = value * 10u32 + (text[i] - 48u8) as u32;
        i = i + 1usize;
    }
    if i == 0usize {
        return error("empty numeric argument");
    }
    * result = value;
    return true;
}
fn options(argc: i32, argv: **u8, o: *Options) -> bool {
    *o = make Options {
        capture: null(*u8),
        width: 640u32,
        height: 360u32,
        frame: 0u32,
        frames: 1200u32,
        dither: 0u32,
        verify: 0u32,
        baseline: 0u32,
        view_budget: MAX_VIEWS,
        fault: 0u32,
        test: 0u32,
        mapping: 0u32,
        snap: 0u32,
        window_width: 0u32,
        window_height: 0u32
    };
    var specified: bool = false;
    var i: usize = 1usize;
    while i < argc as usize {
        if i + 1usize >= argc as usize {
            return error("options require a value");
        }
        var key: *u8 = argv[i];
        var value: *u8 = argv[i + 1usize];
        if strcmp(key, "--frames") == 0i32 {
            specified = true;
        }
        if !option_value(key, value, o) {
            return false;
        }
        i = i + 2usize;
    }
    if o -> capture != null(*u8) && !specified {
        o -> frames = 1u32;
    }
    if o -> window_width == 0u32 {
        o -> window_width = o -> width;
    }
    if o -> window_height == 0u32 {
        o -> window_height = o -> height;
    }
    if !option_dimensions(o) || !option_modes(o) {
        return error("dimensions, frame count, or dither mode outside demo budget");
    }
    return true;
}
fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && strcmp(argv[1usize], "--help") == 0i32 {
        puts("SPINWARD automatic compute demo");
        puts("--capture FILE --width N --height N --window-width N --window-height N");
        puts("--frame N --frames N --dither 0|1 --mapping 0|1|2 --snap 0|1");
        puts(
            "--test 1 (exact palette/presentation) or 2 (scene reference) or 3 (playback input) or 4 (lit tour reference) or 5 (geometry capacity) or 6 (textures) or 7 (retained portal views)"
        );
        puts("--verify 1 --baseline 1 --view-budget N --fault 1");
        puts("Window keys: Esc closes; Space pauses/resumes; Left/Right step one frame and pause");
        return 0i32;
    }
    var o: Options = uninit;
    if !options(argc, argv, &o) {
        return 2i32;
    }
    if o.test == 1u32 {
        return (!palette_test()) as i32;
    }
    if o.test == 3u32 {
        return (!playback_test()) as i32;
    }
    if o.test == 2u32 || o.test == 7u32 {
        o.capture = "build/test-scene.ppm";
        o.width = 320u32;
        o.height = 180u32;
        o.window_width = 640u32;
        o.window_height = 360u32;
        o.frames = 25u32;
        o.verify = 1u32;
    }
    if o.test == 4u32 {
        o.capture = "build/test-tour.ppm";
        o.width = 320u32;
        o.height = 180u32;
        o.window_width = 640u32;
        o.window_height = 360u32;
        o.frames = 50u32;
        o.verify = 1u32;
    }
    if o.test == 5u32 || o.test == 6u32 {
        o.capture = "build/test-capacity.ppm";
        o.width = 64u32;
        o.height = 48u32;
        o.window_width = 64u32;
        o.window_height = 48u32;
        o.frames = 8u32;
        o.view_budget = 1u32;
        o.verify = 1u32;
    }
    if o.test == 6u32 {
        o.capture = "build/test-textures.ppm";
        o.frames = 11u32;
    }
    var session: DemoSession = session_new(&o);
    var config: DemoConfig = config_from_options(&o);
    return demo_run(move session, config);
}
