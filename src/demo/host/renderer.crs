fn demo_renderer_configured(v: *RenderState, config: *RenderConfig, window: *u8) -> bool {
    if !window_instance(v, window) {
        return false;
    }
    var shaders: [ShaderCode; 17] = uninit;
    zero(&shaders as *u8, sizeof([ShaderCode; 17]));
    var good: bool = true;
    var i: usize = 0usize;
    while good && i < (PIPELINE_COUNT as usize - 1usize + (config -> shader_checks) as usize) {
        good = read_renderer_shader(i, config -> shader_checks, &shaders[i]);
        i = i + 1usize;
    }
    if good {
        good = renderer_open(v, config, &shaders[0usize]);
    }
    i = 0usize;
    while i < PIPELINE_COUNT as usize {
        free(shaders[i].bytes);
        i = i + 1usize;
    }
    return good;
}
fn demo_render_config(o: *Options) -> RenderConfig {
    var config: RenderConfig = make RenderConfig {
        width: o -> width,
        height: o -> height,
        output_width: o -> window_width,
        output_height: o -> window_height,
        shader_checks: o -> debug_shaders != 0u32 || o -> debug_pixels != 0u32 || o -> fault != 0u32,
        read_pixels: o -> capture != null(*u8) || o -> debug_pixels != 0u32,
        debug_pixels: o -> debug_pixels,
        baseline: o -> baseline,
        view_budget: o -> view_budget,
        portal_budget: 4u32,
        task_budget: demo_task_budget(o -> width, o -> height),
        crossing_limit: 3u32,
        fault: o -> fault
    };
    return config;
}
fn demo_renderer_open(v: *RenderState, o: *Options, window: *u8) -> bool {
    var config: RenderConfig = demo_render_config(o);
    return demo_renderer_configured(v, &config, window);
}

fn demo_task_budget(width: u32, height: u32) -> u32 {
    var tiles: u32 = ((width + 7u32) / 8u32) * ((height + 7u32) / 8u32);
    if tiles < 32768u32 {
        return 32768u32;
    }
    return tiles;
}
