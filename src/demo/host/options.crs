fn option_value(key: *u8, value: *u8, o: *Options) -> bool {
    if strcmp(key, "--capture") == 0i32 {
        o -> capture = value;
        return true;
    }
    var keys: [*u8; 13] = make [*u8; 13] {
        "--window-width",
        "--window-height",
        "--mapping",
        "--snap",
        "--view-budget",
        "--fault",
        "--baseline",
        "--debug-pixels",
        "--width",
        "--height",
        "--frame",
        "--frames",
        "--dither"
    };
    var targets: [*u32; 13] = make [*u32; 13] {
        &o -> window_width,
        &o -> window_height,
        &o -> mapping,
        &o -> snap,
        &o -> view_budget,
        &o -> fault,
        &o -> baseline,
        &o -> debug_pixels,
        &o -> width,
        &o -> height,
        &o -> frame,
        &o -> frames,
        &o -> dither
    };
    var index: usize = 0usize;
    while index < 13usize {
        if strcmp(key, keys[index]) == 0i32 {
            return parse_number(value, targets[index]);
        }
        index = index + 1usize;
    }
    return error("unknown option: use --help");
}
fn option_dimensions(o: *Options) -> bool {
    return o -> width != 0u32 && o -> height != 0u32 && image_extent_valid(
        o -> width,
        o -> height,
        o -> window_width,
        o -> window_height
    ) && o -> frames != 0u32 && o -> frames <= 4096u32;
}
fn option_modes(o: *Options) -> bool {
    return o -> dither <= 1u32 && o -> view_budget != 0u32 && o -> fault <= 1u32 && o -> mapping <= 2u32 && o -> snap <= 1u32 && o -> debug_pixels <= 1u32;
}
record Options {
    capture: *u8;
    width: u32;
    height: u32;
    frame: u32;
    frames: u32;
    dither: u32;
    debug_pixels: u32;
    baseline: u32;
    view_budget: u32;
    fault: u32;
    mapping: u32;
    snap: u32;
    window_width: u32;
    window_height: u32;
}
opaque;
extern fn strcmp(a: *u8, b: *u8) -> i32 = "strcmp";
fn parse_number(text: *u8, result: *u32) -> bool {
    var i: usize = 0usize;
    var value: u32 = 0u32;
    while text[i] != 0u8 {
        if text[i] < 48u8 || text[i] > 57u8 || value > 100000u32 {
            return error("invalid numeric argument");
        }
        value = value * 10u32 + (text[i] - 48u8) as u32;
        i = i + 1usize;
    }
    if i == 0usize {
        return error("empty numeric argument");
    }
    * result = value;
    return true;
}
fn options(argc: i32, argv: **u8, o: *Options) -> bool {
    *o = make Options {
        capture: null(*u8),
        width: 640u32,
        height: 360u32,
        frame: 0u32,
        frames: 1200u32,
        dither: 0u32,
        debug_pixels: 0u32,
        baseline: 0u32,
        view_budget: 32u32,
        fault: 0u32,
        mapping: 0u32,
        snap: 0u32,
        window_width: 0u32,
        window_height: 0u32
    };
    var specified: bool = false;
    var i: usize = 1usize;
    while i < argc as usize {
        if i + 1usize >= argc as usize {
            return error("options require a value");
        }
        var key: *u8 = argv[i];
        var value: *u8 = argv[i + 1usize];
        if strcmp(key, "--frames") == 0i32 {
            specified = true;
        }
        if !option_value(key, value, o) {
            return false;
        }
        i = i + 2usize;
    }
    if o -> capture != null(*u8) && !specified {
        o -> frames = 1u32;
    }
    if o -> window_width == 0u32 {
        o -> window_width = o -> width;
    }
    if o -> window_height == 0u32 {
        o -> window_height = o -> height;
    }
    if !option_dimensions(o) || !option_modes(o) {
        return error("dimensions, frame count, or dither mode outside demo budget");
    }
    return true;
}
