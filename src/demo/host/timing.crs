fn report(samples: *u64, count: u32) -> unit {
    var i: usize = 1usize;
    while i < count as usize {
        var value: u64 = samples[i];
        var j: usize = i;
        while j > 0usize && samples[j - 1usize] > value {
            samples[j] = samples[j - 1usize];
            j = j - 1usize;
        }
        samples[j] = value;
        i = i + 1usize;
    }
    puts("steady frame CPU submission + GPU + selected readback p50 / p99 (microseconds):");
    print_number((samples[(count / 2u32) as usize] / 1000u64) as i64);
    print_number((samples[((count * 99u32 - 1u32) / 100u32) as usize] / 1000u64) as i64);
}

fn queries_report(v: *RenderState) -> bool {
    var values: *u64 = malloc(v -> query_count as usize * 8usize) as *u64;
    if values == null(*u64) {
        return error("timestamp report allocation failed");
    }
    if !queries_read(v, &values[0usize]) {
        free(values as *u8);
        return false;
    }
    puts(
        "last frame GPU intervals in microseconds: upload/init; geometry+lighting+portal traversal; compose; readback"
    );
    var gap: u64 = (
        values[(v -> query_count - 3u32) as usize] - values[(v -> query_count - 4u32) as usize]
    ) & v -> timestamp_mask;
    var previous: u64 = values[0usize];
    var i: usize = 1usize;
    while i < v -> query_count as usize {
        if i == (v -> query_count - 4u32) as usize {
            i = i + 2usize;
        }
        var ticks: u64 = (values[i] - previous) & v -> timestamp_mask;
        if i == 2usize {
            ticks = ticks - gap;
        }
        print_number((ticks as f32 * v -> timestamp_period / 1000f32) as i64);
        previous = values[i];
        i = i + 1usize;
    }
    puts("GPU submission gap in microseconds:");
    print_number((gap as f32 * v -> timestamp_period / 1000f32) as i64);
    free(values as *u8);
    return true;
}
