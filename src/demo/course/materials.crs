fn course_material_select(selection: mut GenerationWords, graph: read RoomGraph) -> bool {
    if !generation_words_allocate(mut selection, PREFAB_COUNT) {
        return false;
    }
    generation_words_fill(mut selection, 0u32);
    var room: u32 = 0u32;
    while room < graph_count(read graph) {
        generation_word_set(mut selection, graph_node(read graph, room).kind, 1u32);
        room = room + 1u32;
    }
    return true;
}
fn course_material_base(kind: u32) -> u32 {
    var offset: u32 = GAME_MATERIALS;
    var i: u32 = 0u32;
    while i < kind {
        offset = offset + course_material_count(i);
        i = i + 1u32;
    }
    return offset;
}
fn course_material_words(
    configuration: read AssetValues,
    selection: read GenerationWords,
    words: mut u32
) -> bool {
    words = 0u32;
    var kind: u32 = 0u32;
    while kind < PREFAB_COUNT {
        if generation_word(read selection, kind) == 0u32 {
            kind = kind + 1u32;
            continue;
        }
        var values: AssetValues = asset_values_new();
        if !course_material_values(kind, read configuration, mut values) {
            return false;
        }
        var region: u32 = 0u32;
        while region < course_material_count(kind) {
            var panel: PanelMaterial = course_material(kind, region, read values);
            words = words + panel_payload(panel);
            region = region + 1u32;
        }
        kind = kind + 1u32;
    }
    return true;
}
fn course_palette(input: mut FrameInput, selection: read GenerationWords) -> bool {
    var configuration: AssetValues = asset_values_new();
    return course_material_defaults(mut configuration) && course_palette_configured(
        mut input,
        read configuration,
        read selection
    );
}
// Configure each prefab's material dimensions to match its generated geometry.
fn course_palette_configured(
    input: mut FrameInput,
    configuration: read AssetValues,
    selection: read GenerationWords
) -> bool {
    var end: u32 = 0u32;
    return course_palette_reserved(
        mut input,
        read configuration,
        read selection,
        0u32,
        0u32,
        mut end
    );
}
// Reserve extra material records and payload words. The caller must fill them before use.
fn course_palette_reserved(
    input: mut FrameInput,
    configuration: read AssetValues,
    selection: read GenerationWords,
    extra_count: u32,
    extra_words: u32,
    end: mut u32
) -> bool {
    var words: u32 = 0u32;
    if !course_material_words(read configuration, read selection, mut words) {
        return false;
    }
    var count: u32 = course_material_base(PREFAB_COUNT) + extra_count;
    app_assets_extra(mut input, GAME_MATERIALS, count - GAME_MATERIALS, words + extra_words);
    game_palette_fill(mut input);
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    input_set_float(mut input, CAMERA_LIGHT as usize, 36f32);
    var offset: u32 = app_assets_payload_start(GAME_MATERIALS, count - GAME_MATERIALS);
    var kind: u32 = 0u32;
    while kind < PREFAB_COUNT {
        if generation_word(read selection, kind) == 0u32 {
            kind = kind + 1u32;
            continue;
        }
        var values: AssetValues = asset_values_new();
        if !course_material_values(kind, read configuration, mut values) {
            return false;
        }
        var region: u32 = 0u32;
        while region < course_material_count(kind) {
            var panel: PanelMaterial = course_material(kind, region, read values);
            if !panel_upload(
                mut input,
                course_material_base(kind) + region,
                offset,
                panel_texture_width(panel),
                panel
            ) {
                return false;
            }
            offset = offset + panel_payload(panel);
            region = region + 1u32;
        }
        kind = kind + 1u32;
    }
    end = offset;
    return true;
}

fn course_material_parameter_offset(kind: u32) -> u32 {
    var offset: u32 = 0u32;
    var i: u32 = 0u32;
    while i < kind {
        offset = offset + course_parameter_count(i);
        i = i + 1u32;
    }
    return offset;
}
// One contiguous parameter block per prefab, in catalogue order.
fn course_material_defaults(configuration: mut AssetValues) -> bool {
    if !asset_values_allocate(
        mut configuration,
        course_material_parameter_offset(PREFAB_COUNT)
    ) {
        return false;
    }
    var kind: u32 = 0u32;
    var offset: u32 = 0u32;
    while kind < PREFAB_COUNT {
        var i: u32 = 0u32;
        while i < course_parameter_count(kind) {
            asset_value_set(
                mut configuration,
                offset + i,
                course_parameter(kind, i).initial
            );
            i = i + 1u32;
        }
        offset = offset + i;
        kind = kind + 1u32;
    }
    return true;
}
fn course_material_values(
    kind: u32,
    configuration: read AssetValues,
    values: mut AssetValues
) -> bool {
    if !asset_values_allocate(mut values, course_parameter_count(kind)) {
        return false;
    }
    var offset: u32 = course_material_parameter_offset(kind);
    var i: u32 = 0u32;
    while i < course_parameter_count(kind) {
        asset_value_set(mut values, i, asset_value(read configuration, offset + i));
        i = i + 1u32;
    }
    return true;
}
