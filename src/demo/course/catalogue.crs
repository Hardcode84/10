const PREFAB_COUNT: u32 = 28u32;
fn course_parameter_count(kind: u32) -> u32 {
    if kind == PREFAB_SHAFT_CAP_OUTLET {
        return prefab_shaft_cap_outlet_parameter_count();
    }
    if kind == PREFAB_SHAFT_CAP_FILTER {
        return prefab_shaft_cap_filter_parameter_count();
    }
    if kind == PREFAB_SHAFT_CAP_COLLECTOR {
        return prefab_shaft_cap_collector_parameter_count();
    }
    if kind == PREFAB_SHAFT_CAP_BEARING {
        return prefab_shaft_cap_bearing_parameter_count();
    }
    if kind == PREFAB_SHAFT_GRATE {
        return prefab_shaft_grate_parameter_count();
    }
    if kind == PREFAB_SHAFT_FAN {
        return prefab_shaft_fan_parameter_count();
    }
    if kind < 9u32 {
        return course_hex_parameter_count(kind);
    }
    return course_service_parameter_count(kind);
}
fn course_hex_parameter_count(kind: u32) -> u32 {
    if kind == 0u32 {
        return room_parameter_count();
    }
    if kind == 1u32 {
        return prefab_hex_tunnel_parameter_count();
    }
    if kind == 2u32 {
        return prefab_hex_tunnel_10m_parameter_count();
    }
    if kind == 3u32 {
