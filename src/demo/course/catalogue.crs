fn course_build(kind: u32, parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if kind == PREFAB_SHAFT_CAP_OUTLET {
        return prefab_shaft_cap_outlet_build(read parameters, mut asset);
    }
    if kind == PREFAB_SHAFT_CAP_FILTER {
        return prefab_shaft_cap_filter_build(read parameters, mut asset);
    }
    if kind == PREFAB_SHAFT_CAP_COLLECTOR {
        return prefab_shaft_cap_collector_build(read parameters, mut asset);
    }
    if kind == PREFAB_SHAFT_CAP_BEARING {
        return prefab_shaft_cap_bearing_build(read parameters, mut asset);
    }
    if kind == PREFAB_SHAFT_GRATE {
        return prefab_shaft_grate_build(read parameters, mut asset);
    }
    if kind == PREFAB_SHAFT_FAN {
        return prefab_shaft_fan_build(read parameters, mut asset);
    }
    if kind < 9u32 {
        return course_hex_build(kind, read parameters, mut asset);
    }
    return course_service_build(kind, read parameters, mut asset);
}
fn course_hex_build(kind: u32, parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if kind == 0u32 {
        return room_build(read parameters, mut asset);
