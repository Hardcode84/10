    }
    if kind == 7u32 {
        return prefab_hex_ending_parameter_count();
    }
    if kind == 8u32 {
        return prefab_hex_stopper_parameter_count();
    }
    trap;
}
fn course_service_parameter_count(kind: u32) -> u32 {
