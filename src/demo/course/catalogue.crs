fn course_material(kind: u32, region: u32, parameters: read AssetValues) -> PanelMaterial {
    if kind == PREFAB_SHAFT_CAP_OUTLET {
        return prefab_shaft_cap_outlet_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_CAP_FILTER {
        return prefab_shaft_cap_filter_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_CAP_COLLECTOR {
        return prefab_shaft_cap_collector_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_CAP_BEARING {
        return prefab_shaft_cap_bearing_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_GRATE {
        return prefab_shaft_grate_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_FAN {
        return prefab_shaft_fan_material(region, read parameters);
    }
    if kind < 9u32 {
        return course_hex_material(kind, region, read parameters);
    }
    return course_service_material(kind, region, read parameters);
}
fn course_hex_material(kind: u32, region: u32, parameters: read AssetValues) -> PanelMaterial {
    if kind == 0u32 {
        return room_material(region, read parameters);
    }
    if kind == 1u32 {
        return prefab_hex_tunnel_material(region, read parameters);
    }
    if kind == 2u32 {
        return prefab_hex_tunnel_10m_material(region, read parameters);
    }
    if kind == 3u32 {
        return prefab_hex_elbow_material(region, read parameters);
    }
    if kind == 4u32 {
        return prefab_hex_t_junction_material(region, read parameters);
    }
    if kind == 5u32 {
        return prefab_hex_x_junction_material(region, read parameters);
    }
    if kind == 6u32 {
        return prefab_hex_dead_end_material(region, read parameters);
    }
    if kind == 7u32 {
        return prefab_hex_ending_material(region, read parameters);
    }
    if kind == 8u32 {
        return prefab_hex_stopper_material(region, read parameters);
    }
    trap;
}
fn course_service_material(kind: u32, region: u32, parameters: read AssetValues) -> PanelMaterial {
    if kind == 9u32 {
        return prefab_hex_stopper_open_material(region, read parameters);
    }
    if kind == 10u32 {
        return prefab_shaft_rotor_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_PIPES {
        return prefab_shaft_pipes_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_STATION {
        return prefab_shaft_station_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_GIRDERS {
        return prefab_shaft_girders_material(region, read parameters);
    }
    if kind == PREFAB_SHAFT_HEX_ADAPTER {
        return prefab_shaft_hex_adapter_material(region, read parameters);
    }
    if kind == 11u32 {
        return prefab_shaft_hub_material(region, read parameters);
    }
    if kind == 12u32 {
        return prefab_oct_tunnel_10m_material(region, read parameters);
    }
    if kind == 13u32 {
        return prefab_oct_elbow_material(region, read parameters);
    }
    if kind == 14u32 {
        return prefab_oct_t_junction_material(region, read parameters);
    }
    if kind == 15u32 {
        return prefab_oct_x_junction_material(region, read parameters);
    }
    if kind == 16u32 {
        return prefab_oct_stopper_material(region, read parameters);
    }
    if kind == 17u32 {
        return prefab_oct_stopper_open_material(region, read parameters);
    }
    trap;
}
fn course_values(kind: u32, variant: u32, values: mut AssetValues) -> bool {
    if !asset_values_allocate(mut values, course_parameter_count(kind)) {
        return false;
    }
    var i: u32 = 0u32;
    while i < course_parameter_count(kind) {
        asset_value_set(mut values, i, course_parameter(kind, i).initial);
        i = i + 1u32;
    }
    if kind == PREFAB_OCT_X_JUNCTION {
        asset_value_set(mut values, 1u32, (variant / 3u32) as f32);
        asset_value_set(mut values, 2u32, (variant % 3u32) as f32);
    }
    return true;
}
