fn course_parameter(kind: u32, index: u32) -> AssetParameter {
    if kind == PREFAB_SHAFT_CAP_OUTLET {
        return prefab_shaft_cap_outlet_parameter(index);
    }
    if kind == PREFAB_SHAFT_CAP_FILTER {
        return prefab_shaft_cap_filter_parameter(index);
    }
    if kind == PREFAB_SHAFT_CAP_COLLECTOR {
