        return prefab_shaft_grate_parameter(index);
    }
    if kind == PREFAB_SHAFT_FAN {
        return prefab_shaft_fan_parameter(index);
    }
    if kind < 9u32 {
        return course_hex_parameter(kind, index);
    }
    return course_service_parameter(kind, index);
}
