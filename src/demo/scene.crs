fn terrain_height(x: f32, z: f32) -> f32 {
    var distance: f32 = z - 8f32;
    if distance < 0f32 {
        distance = 0f32;
    }
    return -2f32 + distance * 0.04f32 + sinf(x * 0.22f32) * cosf(z * 0.14f32) * distance * 0.05f32;
}
extern fn sinf(x: f32) -> f32 foreign(scalar) = "sinf";
extern fn cosf(x: f32) -> f32 foreign(scalar) = "cosf";
fn palettes(v: mut FrameInput) -> unit {
    var i: u32 = 0u32;
    while i < 64u32 {
        input_set_word(
            mut v,
            (TEXTURE + i) as usize,
            ((i % 8u32) / 2u32 + (i / 8u32) / 2u32) % 4u32
        );
        i = i + 1u32;
    }
    i = 0u32;
    while i < 64u32 {
        var mat: u32 = i / 4u32;
        var tex: u32 = i % 4u32;
        var r: u32 = 65u32 + mat * 11u32 + tex * 13u32;
        var g: u32 = 100u32 + tex * 20u32;
        var b: u32 = 120u32 + tex * 17u32;
        if mat == 1u32 {
            r = 65u32 + tex * 14u32;
            g = 90u32 + tex * 15u32;
            b = 50u32 + tex * 9u32;
        }
        if mat == 2u32 {
            r = 170u32 + tex * 20u32;
            g = 90u32 + tex * 16u32;
            b = 40u32 + tex * 10u32;
        }
        if mat == 3u32 {
            r = 40u32 + tex * 10u32;
            g = 120u32 + tex * 25u32;
            b = 90u32 + tex * 13u32;
        }
        if mat == 4u32 {
            r = 170u32 + tex * 18u32;
            g = 40u32 + tex * 14u32;
            b = 60u32 + tex * 18u32;
        }
        if r > 255u32 {
            r = 255u32;
        }
        var light: u32 = 0u32;
        while light < 64u32 {
            input_set_word(
                mut v,
                (PALETTE + i * 64u32 + light) as usize,
                (r * light / 63u32) | ((g * light / 63u32) << 8u32) | (
                    (b * light / 63u32) << 16u32
                ) | 0xff000000u32
            );
            light = light + 1u32;
        }
        i = i + 1u32;
    }
}
fn portal_setup(v: mut FrameInput) -> unit {
    var i: u32 = 0u32;
    while i < MAX_PORTALS {
        var p: usize = (PORTAL_FLOAT + i * 16u32) as usize;
        input_set_float(mut v, p, 1f32);
        input_set_float(mut v, p + 5usize, 1f32);
        input_set_float(mut v, p + 10usize, 1f32);
        input_set_float(mut v, p + 14usize, 1f32);
        input_set_word(mut v, (PORTAL_META + i * 4u32 + 1u32) as usize, 1u32);
        i = i + 1u32;
    }
    input_set_float(mut v, (PORTAL_FLOAT + 11u32) as usize, 9f32);
    input_set_float(mut v, (PORTAL_FLOAT + 15u32) as usize, 0f32);
    var p: usize = (PORTAL_FLOAT + 16u32) as usize;
    input_set_float(mut v, p, 0f32);
    input_set_float(mut v, p + 2usize, 1f32);
    input_set_float(mut v, p + 3usize, 4f32);
    input_set_float(mut v, p + 8usize, -1f32);
    input_set_float(mut v, p + 10usize, 0f32);
    input_set_float(mut v, p + 11usize, 9f32);
    input_set_float(mut v, p + 12usize, -1f32);
    input_set_float(mut v, p + 14usize, 0f32);
    input_set_float(mut v, p + 15usize, 0f32);
    p = (PORTAL_FLOAT + 32u32) as usize;
    input_set_float(mut v, p + 11usize, 26f32);
    input_set_float(mut v, p + 14usize, 1f32);
    input_set_float(mut v, p + 15usize, 8f32);
    input_set_word(mut v, (PORTAL_META + 2u32 * 4u32) as usize, 1u32);
    input_set_word(mut v, (PORTAL_META + 2u32 * 4u32 + 1u32) as usize, 0u32);
}
fn scene(v: mut FrameInput, width: u32, height: u32, frame: u32, mode: u32) -> unit {
    input_set_word(mut v, 0usize, width);
    input_set_word(mut v, 1usize, height);
    input_set_word(mut v, 2usize, mode);
    input_set_word(mut v, 3usize, 0u32);
    input_set_word(mut v, 4usize, 3u32);
    input_set_word(mut v, BACKGROUND as usize, 0xff463026u32);
    input_set_float(mut v, RENDER_STYLE as usize, 0.125f32);
    input_set_float(mut v, (RENDER_STYLE + 1u32) as usize, 6f32);
    input_set_float(mut v, (RENDER_STYLE + 2u32) as usize, 52f32);
    input_set_float(mut v, (RENDER_STYLE + 3u32) as usize, 0.65f32);
    var t: f32 = frame as f32 / 60f32;
    var yaw: f32 = sinf(t * 0.25f32) * 0.12f32;
    var c: f32 = cosf(yaw);
    var s: f32 = sinf(yaw);
    var cx: f32 = sinf(t * 0.35f32) * 0.3f32;
    var phase: u32 = frame % 600u32;
    var cz: f32 = 2f32 + phase as f32 / 240f32 * 5f32;
    if phase >= 240u32 {
        cz = 7f32 + (phase - 240u32) as f32 / 180f32 * 8f32;
    }
    if phase >= 420u32 {
        cz = 15f32 - (phase - 420u32) as f32 / 180f32 * 13f32;
    }
    input_set_word(mut v, 20usize, 0u32);
    if cz >= 9f32 {
        input_set_word(mut v, 20usize, 1u32);
        cz = cz - 9f32;
    }
    input_set_float(mut v, 0usize, c);
    input_set_float(mut v, 1usize, 0f32);
    input_set_float(mut v, 2usize, -s);
    input_set_float(mut v, 3usize, -c * cx + s * cz);
    input_set_float(mut v, 4usize, 0f32);
    input_set_float(mut v, 5usize, 1f32);
    input_set_float(mut v, 6usize, 0f32);
    input_set_float(mut v, 7usize, -0.5f32);
    input_set_float(mut v, 8usize, s);
    input_set_float(mut v, 9usize, 0f32);
    input_set_float(mut v, 10usize, c);
    input_set_float(mut v, 11usize, -s * cx - c * cz);
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -6f32,
        -2f32,
        -8f32,
        6f32,
        -2f32,
        -8f32,
        6f32,
        -2f32,
        9f32,
        -6f32,
        -2f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -6f32,
        4f32,
        -8f32,
        6f32,
        4f32,
        -8f32,
        6f32,
        4f32,
        9f32,
        -6f32,
        4f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -6f32,
        -2f32,
        -8f32,
        -6f32,
        -2f32,
        9f32,
        -6f32,
        4f32,
        9f32,
        -6f32,
        4f32,
        -8f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        6f32,
        -2f32,
        -8f32,
        6f32,
        -2f32,
        9f32,
        6f32,
        4f32,
        9f32,
        6f32,
        4f32,
        -8f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -6f32,
        -2f32,
        9f32,
        -2f32,
        -2f32,
        9f32,
        -2f32,
        4f32,
        9f32,
        -6f32,
        4f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        2f32,
        -2f32,
        9f32,
        3f32,
        -2f32,
        9f32,
        3f32,
        3f32,
        9f32,
        2f32,
        3f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        5f32,
        -2f32,
        9f32,
        6f32,
        -2f32,
        9f32,
        6f32,
        4f32,
        9f32,
        5f32,
        4f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        0u32,
        0u32,
        0u32,
        -2f32,
        3f32,
        9f32,
        5f32,
        3f32,
        9f32,
        5f32,
        4f32,
        9f32,
        -2f32,
        4f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        2u32,
        1u32,
        0u32,
        -2f32,
        -2f32,
        9f32,
        2f32,
        -2f32,
        9f32,
        2f32,
        3f32,
        9f32,
        -2f32,
        3f32,
        9f32
    );
    quad(
        mut v,
        0u32,
        4u32,
        2u32,
        0u32,
        3f32,
        -2f32,
        9f32,
        5f32,
        -2f32,
        9f32,
        5f32,
        3f32,
        9f32,
        3f32,
        3f32,
        9f32
    );
    var row: u32 = 0u32;
    while row < 5u32 {
        var col: u32 = 0u32;
        while col < 6u32 {
            var x: f32 = col as f32 * 8f32 - 24f32;
            var z: f32 = row as f32 * 8f32;
            quad(
                mut v,
                1u32,
                1u32,
                0u32,
                0u32,
                x,
                terrain_height(x, z),
                z,
                x + 8f32,
                terrain_height(x + 8f32, z),
                z,
                x + 8f32,
                terrain_height(x + 8f32, z + 8f32),
                z + 8f32,
                x,
                terrain_height(x, z + 8f32),
                z + 8f32
            );
            col = col + 1u32;
        }
        row = row + 1u32;
    }
    box(mut v, 1u32, 2u32, 0f32, 1f32, 24f32, 3f32);
    box(mut v, 1u32, 0u32, -10f32, 3f32, 12f32, 4f32);
    quad(
        mut v,
        1u32,
        4u32,
        3u32,
        0u32,
        -1.5f32,
        -2f32,
        18f32,
        1.5f32,
        -2f32,
        18f32,
        1.5f32,
        2f32,
        18f32,
        -1.5f32,
        2f32,
        18f32
    );
    quad(
        mut v,
        1u32,
        3u32,
        0u32,
        1u32,
        -4f32,
        -2f32,
        6f32,
        -1f32,
        -2f32,
        6f32,
        -1f32,
        2f32,
        6f32,
        -4f32,
        2f32,
        6f32
    );
    var z: f32 = 8.5f32 + 2f32 * sinf(t);
    box(mut v, 0u32, 2u32, -0.8f32, -0.5f32, z, 0.8f32);
    box(mut v, 1u32, 2u32, -0.8f32, -0.5f32, z - 9f32, 0.8f32);
    box(mut v, 0u32, 4u32, 2.3f32, -1f32, 5f32, 0.6f32);
}
