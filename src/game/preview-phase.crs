fn wrap_preview_phase(distance: f32) -> f32 {
    var turns: i32 = (distance / PREVIEW_SPACING) as i32;
    var phase: f32 = distance - turns as f32 * PREVIEW_SPACING;
    if phase < 0f32 {
        phase = phase + PREVIEW_SPACING;
    }
    return phase;
}
fn advance_preview_phase(trial: mut Trial, before: Vec3) -> unit {
    var travel: Vec3 = sub(trial.drone.position, before);
    trial.preview_phase = wrap_preview_phase(trial.preview_phase + length(travel));
    var launch: Vec3 = add(
        trial.drone.velocity,
        scale(trial.drone.basis.forward, HOOK_SPEED)
    );
    trial.hook_preview_phase = wrap_preview_phase(
        trial.hook_preview_phase + dot(travel, unit_vector(launch))
    );
}
fn preview_station(before: Vec3, after: Vec3, distance: f32, next: f32) -> Vec3 {
    var travel: Vec3 = sub(after, before);
    return add(before, scale(travel, (next - distance) / length(travel)));
}
