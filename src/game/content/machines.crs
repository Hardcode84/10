fn machine_beam() -> Solid {
    return solid(vec(-6f32, -0.35f32, -0.35f32), vec(6f32, 0.35f32, 0.35f32), 4u32);
}
fn collision_build_machine(builder: mut CollisionBuilder, world: u32) -> bool {
    var mesh: Mesh = mesh_new();
    if !static_solid(mut mesh, machine_beam(), 63u32) || !collision_append_solid(
        mut builder,
        read mesh,
        world,
        vec(0f32, 8f32, 32f32),
        identity_basis()
    ) {
        return false;
    }
    return collision_set_motion(
        mut builder,
        vec(0f32, 0f32, 0f32),
        vec(0f32, 0f32, 0.4f32)
    );
}
