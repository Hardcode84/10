fn box_edge(s: Solid, axis: u32, index: u32) -> Vec3 {
    var a: u32 = (axis + 1u32) % 3u32;
    var b: u32 = (axis + 2u32) % 3u32;
    var point: Vec3 = s.low;
    if index % 2u32 != 0u32 {
        point = add(
            point,
            scale(axis_vector(a), component(sub(s.high, s.low), a))
        );
    }
    if index / 2u32 != 0u32 {
        point = add(
            point,
            scale(axis_vector(b), component(sub(s.high, s.low), b))
        );
    }
    return point;
}
