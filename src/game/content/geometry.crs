fn mesh_vertex(p: Vec3, u: f32, v: f32) -> MeshVertex {
    return make MeshVertex {
        x: p.x,
        y: p.y,
        z: p.z,
        u: u,
        v: v
    };
}
fn static_quad(
    mesh: mut Mesh,
    material: u32,
    a: Vec3,
    b: Vec3,
    c: Vec3,
    d: Vec3,
    normal: Vec3,
    axis: u32
) -> bool {
    var u: f32 = length(sub(b, a)) / 4f32;
    var v: f32 = length(sub(d, a)) / 4f32;
    var vertices: [MeshVertex; 4] = make [MeshVertex; 4] {
        mesh_vertex(a, 0f32, 0f32),
        mesh_vertex(b, u, 0f32),
        mesh_vertex(c, u, v),
        mesh_vertex(d, 0f32, v)
    };
    if axis < 3u32 {
        var points: [Vec3; 4] = make [Vec3; 4] {
            a,
            b,
            c,
            d
        };
        var i: usize = 0usize;
        while i < 4usize {
            vertices[i].u = component(points[i], (axis + 1u32) % 3u32) / 4f32;
            vertices[i].v = component(points[i], (axis + 2u32) % 3u32) / 4f32;
            i = i + 1usize;
        }
    }
    var order: [usize; 6] = make [usize; 6] {
        0usize,
        1usize,
        2usize,
        0usize,
        2usize,
        3usize
    };
    if dot(cross(sub(b, a), sub(c, a)), normal) < 0f32 {
        order = make [usize; 6] {
            0usize,
            2usize,
            1usize,
            0usize,
            3usize,
            2usize
        };
    }
    var i: usize = 0usize;
    while i < 6usize {
        var face: MeshTriangle = make MeshTriangle {
            vertices: make [MeshVertex; 3] {
                vertices[order[i]],
                vertices[order[i + 1usize]],
                vertices[order[i + 2usize]]
            },
            material: material,
            portal: 0u32,
            flags: 2u32
        };
        if !mesh_append(mut mesh, face) {
            return false;
        }
        i = i + 3usize;
    }
    return true;
}
fn static_solid(mesh: mut Mesh, item: Solid, faces: u32) -> bool {
    var face: u32 = 0u32;
    while face < 6u32 {
        if (faces & (1u32 << face)) != 0u32 {
            var axis: u32 = face / 2u32;
            var shift: Vec3 = vec(0f32, 0f32, 0f32);
            var sign: f32 = -1f32;
            if face % 2u32 != 0u32 {
                shift = scale(
                    axis_vector(axis),
                    component(sub(item.high, item.low), axis)
                );
                sign = 1f32;
            }
            if !static_quad(
                mut mesh,
                item.material,
                add(box_edge(item, axis, 0u32), shift),
                add(box_edge(item, axis, 1u32), shift),
                add(box_edge(item, axis, 3u32), shift),
                add(box_edge(item, axis, 2u32), shift),
                scale(axis_vector(axis), sign),
                3u32
            ) {
                return false;
            }
        }
        face = face + 1u32;
    }
    return true;
}
fn static_room(mesh: mut Mesh, room: u32) -> bool {
    var instance: RoomInstance = expedition_room(room);
    var mask: u32 = expedition_open_ports(room);
    var face: u32 = 0u32;
    while face < 6u32 {
        var walls: WallPanels = prefab_wall(instance, face, mask);
        var i: u32 = 0u32;
        while i < walls.count {
            var panel: Solid = walls.panels[i as usize];
            var mat: u32 = panel.material;
            if face == 2u32 {
                mat = 0u32;
            }
            if face == 3u32 {
                mat = 1u32;
            }
            var axis: u32 = face / 2u32;
            var sign: f32 = 1f32;
            if face % 2u32 != 0u32 {
                sign = -1f32;
            }
            if !static_quad(
                mut mesh,
                mat,
                box_edge(panel, axis, 0u32),
                box_edge(panel, axis, 1u32),
                box_edge(panel, axis, 3u32),
                box_edge(panel, axis, 2u32),
                scale(axis_vector(axis), sign),
                axis
            ) {
                return false;
            }
            i = i + 1u32;
        }
        face = face + 1u32;
    }
    return true;
}
fn static_pipe_cap(mesh: mut Mesh, pipe: CoursePipe, end: f32) -> bool {
    var sign: f32 = -1f32;
    if end > 0f32 {
        sign = 1f32;
    }
    var normal: Vec3 = scale(axis_vector(pipe.axis), sign);
    return static_quad(
        mut mesh,
        1u32,
        pipe_vertex(pipe, 0u32, end),
        pipe_vertex(pipe, 1u32, end),
        pipe_vertex(pipe, 2u32, end),
        pipe_vertex(pipe, 3u32, end),
        normal,
        3u32
    ) && static_quad(
        mut mesh,
        1u32,
        pipe_vertex(pipe, 0u32, end),
        pipe_vertex(pipe, 3u32, end),
        pipe_vertex(pipe, 4u32, end),
        pipe_vertex(pipe, 5u32, end),
        normal,
        3u32
    );
}
fn static_pipe(mesh: mut Mesh, pipe: CoursePipe) -> bool {
    var i: u32 = 0u32;
    while i < 6u32 {
        if !static_quad(
            mut mesh,
            pipe.material,
            pipe_vertex(pipe, i, 0f32),
            pipe_vertex(pipe, i + 1u32, 0f32),
            pipe_vertex(pipe, i + 1u32, 1f32),
            pipe_vertex(pipe, i, 1f32),
            add(pipe_radial(pipe, i), pipe_radial(pipe, i + 1u32)),
            3u32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return static_pipe_cap(mut mesh, pipe, 0f32) && static_pipe_cap(mut mesh, pipe, 1f32);
}
