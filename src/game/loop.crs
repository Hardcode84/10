record GameLoop {
    trial: Trial;
    input: InputState;
    ticks: u32;
    credit: u64;
    running: bool;
}
fn game_tick(session: mut GameSession, loop: mut GameLoop, config: GameConfig) -> bool {
    var command: Command = input_consume(mut loop.input);
    if config.smoke {
        command = smoke_command(read loop.trial, loop.ticks);
    }
    if config.tour {
        command = pilot_command(read loop.trial);
        if loop.trial.full_spin {
            command = spin_pilot_command(read loop.trial);
        }
    }
    if config.tour && loop.trial.drone.world == 1u32 {
        command = expedition_pilot(read loop.trial, config.shortcut);
    }
    var status: i32 = game_command(mut session, mut command);
    if status < 0i32 {
        return false;
    }
    if status == 0i32 {
        loop.running = false;
        return true;
    }
    var finished: bool = loop.trial.finished;
    trial_step(mut loop.trial, command);
    if loop.trial.finished && !finished {
        game_message(1u32);
        if config.tour {
            loop.running = false;
        }
    }
    loop.ticks = loop.ticks + 1u32;
    if config.ticks != 0u32 && loop.ticks >= config.ticks {
        loop.running = false;
    }
    return game_save(mut session, read loop.trial) && game_record(
        mut session,
        command,
        trial_hash(read loop.trial)
    );
}
fn game_render(session: mut GameSession, loop: read GameLoop, config: GameConfig) -> bool {
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        game_scene(mut inputs, read loop.trial, config);
        game_hud(mut inputs, read loop.trial, loop.input.paused);
        var hud_scale: u32 = 1u32;
        if loop.trial.drone.world == 1u32 {
            hud_scale = config.width / 448u32;
            if hud_scale == 0u32 {
                hud_scale = 1u32;
            }
        }
        input_set_word(mut inputs, OVERLAY_SCALE as usize, hud_scale);
    }
    return game_draw(mut session) && game_present(mut session);
}
fn game_advance(
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    elapsed: u64
) -> bool {
    if !game_poll(mut session, mut loop.input) {
        return false;
    }
    if loop.input.quit {
        loop.running = false;
        return true;
    }
    if config.headless {
        return game_tick(mut session, mut loop, config);
    }
    if elapsed > 1000000000u64 {
        loop.input.paused = true;
        game_message(0u32);
    }
    if loop.input.paused {
        loop.input.pending = idle_command();
        loop.input.mouse = vec(0f32, 0f32, 0f32);
        loop.credit = 0u64;
        return true;
    }
    var rate: u64 = 120u64;
    if config.slow {
        rate = 84u64;
    }
    loop.credit = loop.credit + elapsed * rate;
    while loop.credit >= 1000000000u64 && loop.running {
        if !game_tick(mut session, mut loop, config) {
            return false;
        }
        loop.credit = loop.credit - 1000000000u64;
    }
    return true;
}
fn game_run(session: GameSession, config: GameConfig) -> i32 {
    var loop: GameLoop = make GameLoop {
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_open(mut session, mut loop.input) {
        return 1i32;
    }
    loop.trial.full_spin = game_initial_spin(read session);
    if !game_restore(mut session, mut loop.trial) {
        return 1i32;
    }
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        game_palette(mut inputs);
        hud_font(mut inputs);
    }
    if config.review {
        return (!expedition_review(mut session, config)) as i32;
    }
    if !config.headless && !game_render(mut session, read loop, config) {
        return 1i32;
    }
    var previous: u64 = now();
    while loop.running {
        var current: u64 = now();
        var elapsed: u64 = current - previous;
        previous = current;
        if !game_advance(mut session, mut loop, config, elapsed) {
            return 1i32;
        }
        if !config.headless && !game_render(mut session, read loop, config) {
            return 1i32;
        }
        if !config.headless {
            game_wait();
        }
    }
    if config.headless && !game_render(mut session, read loop, config) {
        return 1i32;
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}
