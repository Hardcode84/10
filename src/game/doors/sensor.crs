// Tests a swept drone centre against the finite approach volume on both sides.
fn door_approach(door: DoorInstance, before: Vec3, after: Vec3, radius: f32) -> bool {
    var start: Vec3 = sub(before, door.origin);
    var travel: Vec3 = sub(after, before);
    var low: f32 = 0f32;
    var high: f32 = 1f32;
    var plane: u32 = 0u32;
    while plane < door.shape.sides + 2u32 {
        var normal: Vec3 = vec(0f32, 1f32, 0f32);
        var limit: f32 = DOOR_APPROACH_DEPTH + radius;
        if plane < door.shape.sides {
            var angle: f32 = door.shape.phase + (plane as f32 + 0.5f32) * (
                (2f32 * PI) / door.shape.sides as f32
            );
            normal = vec(cosf(angle), 0f32, sinf(angle));
            limit = door.radius * cosf(PI / door.shape.sides as f32) + radius;
        } else if plane == door.shape.sides + 1u32 {
            normal.y = -1f32;
        }
        var offset: f32 = dot(normal, start) - limit;
        var speed: f32 = dot(normal, travel);
        if speed == 0f32 {
            if offset > 0f32 {
                return false;
            }
        } else if speed < 0f32 {
            low = collision_max_scalar(low, -offset / speed);
        } else {
            high = mask_min(high, -offset / speed);
        }
        if low > high {
            return false;
        }
        plane = plane + 1u32;
    }
    return true;
}
fn doors_predict(doors: mut DoorSet, before: Vec3, after: Vec3, eye: PredictionEye) -> unit {
    var i: u32 = 0u32;
    while i < doors_count(read doors) {
        var door: DoorInstance = door_get(read doors, i);
        if door.space == eye.world && door_approach(
            door,
            before,
            after,
            DRONE_RADIUS * eye.factor
        ) {
            door_set_requested(mut doors, i, true);
        }
        i = i + 1u32;
    }
}

fn door_occupied(door: DoorInstance, anchors: read RoomAnchors, drone: read Drone) -> bool {
    var body: CollisionBody = collision_body(DRONE_RADIUS, read drone.size);
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        if anchor.cap == 0xffffffffu32 && anchor.space == door.space {
            var center: Vec3 = space_point(anchor.transform, drone.position);
            if door_approach(
                door,
                center,
                center,
                collision_placement_radius(read body, read anchors, i)
            ) {
                return true;
            }
        }
        i = i + 1u32;
    }
    return false;
}
