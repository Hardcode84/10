record DoorInstance {
    requested: bool;
    hold_until: f32;
    space: u32;
    origin: Vec3;
    radius: f32;
    shape: RegularProfile;
    first: u32;
    count: u32;
    collision_first: u32;
}
record DoorLeaf {
    source: MeshRange;
    mesh: MeshRange;
    travel: Vec3;
}
resource DoorSet {
    leaves: *DoorLeaf;
    leaf_count: u32;
    leaf_capacity: u32;
    data: *DoorInstance;
    count: u32;
    capacity: u32;
    mesh: Mesh;
    occupants: RoomAnchors;
}
opaque drop doors_drop;
fn doors_new() -> DoorSet {
    return make DoorSet {
        leaves: null(*DoorLeaf),
        leaf_count: 0u32,
        leaf_capacity: 0u32,
        data: null(*DoorInstance),
        count: 0u32,
        capacity: 0u32,
        mesh: mesh_new(),
        occupants: room_anchors_new()
    };
}
fn doors_drop(doors: mut DoorSet) -> unit {
    free(doors.data as *u8);
    free(doors.leaves as *u8);
}
fn doors_count(doors: read DoorSet) -> u32 {
    return doors.count;
}
fn door_get(doors: read DoorSet, index: u32) -> DoorInstance {
    return doors.data[index as usize];
}
fn door_add(doors: mut DoorSet, definition: DoorInstance) -> bool {
    if doors.count == doors.capacity {
        var capacity: u64 = doors.capacity as u64 * 2u64 + 1u64;
        if capacity > 0xffffffffu64 || capacity > (~0usize) as u64 / sizeof(DoorInstance) as u64 {
            return error("door count exceeds address range");
        }
        var data: *DoorInstance = malloc(capacity as usize * sizeof(DoorInstance)) as *DoorInstance;
        if data == null(*DoorInstance) {
            return error("door allocation failed");
        }
        var i: u32 = 0u32;
        while i < doors.count {
            data[i as usize] = doors.data[i as usize];
            i = i + 1u32;
        }
        free(doors.data as *u8);
        doors.data = data;
        doors.capacity = capacity as u32;
    }
    doors.data[doors.count as usize] = definition;
    doors.count = doors.count + 1u32;
    return true;
}
// Copies door instances and leaf descriptions for an independent forecast context.
fn doors_copy(source: read DoorSet, target: mut DoorSet) -> bool {
    var base: u32 = target.leaf_count;
    var i: u32 = 0u32;
    while i < source.leaf_count {
        if !door_leaf_add(mut target, source.leaves[i as usize]) {
            return false;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < source.count {
        var door: DoorInstance = source.data[i as usize];
        door.first = door.first + base;
        if !door_add(mut target, door) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn door_leaf(doors: read DoorSet, index: u32) -> DoorLeaf {
    return doors.leaves[index as usize];
}
fn door_leaf_add(doors: mut DoorSet, leaf: DoorLeaf) -> bool {
    if doors.leaf_count == doors.leaf_capacity {
        var capacity: u64 = doors.leaf_capacity as u64 * 2u64 + 1u64;
        if capacity > 0xffffffffu64 || capacity > (~0usize) as u64 / sizeof(DoorLeaf) as u64 {
            return error("door leaf count exceeds address range");
        }
        var data: *DoorLeaf = malloc(capacity as usize * sizeof(DoorLeaf)) as *DoorLeaf;
        if data == null(*DoorLeaf) {
            return error("door leaf allocation failed");
        }
        if doors.leaf_count != 0u32 {
            memcpy(
                data as *u8,
                doors.leaves as *u8,
                doors.leaf_count as usize * sizeof(DoorLeaf)
            );
        }
        free(doors.leaves as *u8);
        doors.leaves = data;
        doors.leaf_capacity = capacity as u32;
    }
    doors.leaves[doors.leaf_count as usize] = leaf;
    doors.leaf_count = doors.leaf_count + 1u32;
    return true;
}
fn doors_asset(
    doors: mut DoorSet,
    asset: read RoomAsset,
    builder: mut CollisionBuilder,
    space: u32,
    material: u32
) -> bool {
    if asset_door_leaf_count(read asset.door_leaves) == 0u32 {
        return true;
    }
    var first: u32 = collision_builder_instances(read builder);
    if !room_leaf_collision(read asset, mut builder, space) {
        return false;
    }
    var door: DoorInstance = make DoorInstance {
        requested: false,
        hold_until: 0f32,
        space: space,
        origin: asset_door_leaf(read asset.door_leaves, 0u32).part.origin,
        radius: asset_door_aperture(read asset.door_leaves).radius,
        shape: asset_door_aperture(read asset.door_leaves).shape,
        first: doors.leaf_count,
        count: asset_door_leaf_count(read asset.door_leaves),
        collision_first: first
    };
    var leaf: u32 = 0u32;
    while leaf < door.count {
        var description: AssetDoorLeaf = asset_door_leaf(read asset.door_leaves, leaf);
        var part: AssetPart = description.part;
        var slice: MeshRange = mesh_empty_range();
        slice.first = mesh_triangle_count(read doors.mesh);
        slice.count = part.count;
        var local: Mesh = mesh_new();
        var i: u32 = 0u32;
        while i < part.count {
            var t: MeshTriangle = mesh_triangle(read asset.geometry, part.first + i);
            t.material = t.material + material;
            if !mesh_append(mut local, t) || !mesh_append(mut doors.mesh, t) {
                return false;
            }
            i = i + 1u32;
        }
        slice.bounds = local.bounds;
        if !door_leaf_add(
            mut doors,
            make DoorLeaf {
                source: slice,
                mesh: mesh_empty_range(),
                travel: description.travel
            }
        ) {
            return false;
        }
        leaf = leaf + 1u32;
    }
    return door_add(mut doors, door);
}
fn doors_upload(doors: mut DoorSet, input: mut FrameInput) -> bool {
    var i: u32 = 0u32;
    while i < doors.leaf_count {
        var range: MeshRange = doors.leaves[i as usize].source;
        if !input_mesh_slice(
            mut input,
            read doors.mesh,
            range.first,
            range.count,
            mut range
        ) {
            return false;
        }
        doors.leaves[i as usize].mesh = range;
        i = i + 1u32;
    }
    return true;
}

fn door_set_requested(doors: mut DoorSet, index: u32, requested: bool) -> unit {
    doors.data[index as usize].requested = requested;
}
fn door_set_hold(doors: mut DoorSet, index: u32, time: f32) -> unit {
    doors.data[index as usize].hold_until = time;
}
fn doors_clear_requests(doors: mut DoorSet) -> unit {
    var i: u32 = 0u32;
    while i < doors.count {
        doors.data[i as usize].requested = false;
        i = i + 1u32;
    }
}
// Both sets describe the same scene. Copy only completed forecast requests.
fn doors_publish(source: read DoorSet, target: mut DoorSet) -> unit {
    var i: u32 = 0u32;
    while i < source.count {
        target.data[i as usize].requested = source.data[i as usize].requested;
        i = i + 1u32;
    }
}
fn doors_reset(doors: mut DoorSet) -> unit {
    var i: u32 = 0u32;
    while i < doors.count {
        doors.data[i as usize].requested = false;
        doors.data[i as usize].hold_until = 0f32;
        i = i + 1u32;
    }
}

fn doors_occupants(doors: read DoorSet) -> read RoomAnchors from doors {
    return read doors.occupants;
}
fn doors_occupants_mut(doors: mut DoorSet) -> mut RoomAnchors from doors {
    return mut doors.occupants;
}
