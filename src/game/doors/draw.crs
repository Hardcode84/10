fn doors_draw(
    scene: read CollisionScene,
    doors: read DoorSet,
    input: mut FrameInput,
    time: f32
) -> unit {
    var i: u32 = 0u32;
    while i < doors_count(read doors) {
        var door: DoorInstance = door_get(read doors, i);
        var leaf: u32 = 0u32;
        while leaf < door.count {
            var pose: CollisionInstance = collision_pose(
                collision_instance(read scene, door.collision_first + leaf),
                time
            );
            var instance: MeshInstance = mesh_identity(
                door_leaf(read doors, door.first + leaf).mesh,
                door.space
            );
            instance.transform = make [f32; 12] {
                pose.basis.right.x,
                pose.basis.up.x,
                pose.basis.forward.x,
                pose.origin.x,
                pose.basis.right.y,
                pose.basis.up.y,
                pose.basis.forward.y,
                pose.origin.y,
                pose.basis.right.z,
                pose.basis.up.z,
                pose.basis.forward.z,
                pose.origin.z
            };
            if !input_instance(mut input, instance) {
                scene_overflow();
            }
            leaf = leaf + 1u32;
        }
        i = i + 1u32;
    }
}
