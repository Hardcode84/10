const EXPEDITION_SOLIDS: u32 = 3u32;
fn world_solid_count(world: u32) -> u32 {
    if world == 1u32 {
        return EXPEDITION_SOLIDS;
    }
    return SOLID_COUNT;
}
fn world_solid(world: u32, index: u32) -> Solid {
    if world == 0u32 {
        return course_solid(index);
    }
    if index == 0u32 {
        return solid(vec(10f32, -8f32, 96f32), vec(18f32, 64f32, 120f32), 2u32);
    }
    if index == 2u32 {
        return solid(vec(-40f32, 112f32, 92f32), vec(18f32, 120f32, 100f32), 11u32);
    }
    return solid(vec(70f32, 120f32, 140f32), vec(82f32, 126f32, 152f32), 2u32);
}
fn world_pipe_count(world: u32) -> u32 {
    if world == 1u32 {
        return 1u32;
    }
    return PIPE_COUNT;
}
fn world_pipe(world: u32, index: u32) -> CoursePipe {
    if world == 0u32 {
        return course_pipe(index);
    }
    return make CoursePipe {
        start: vec(130f32, -8f32, 174f32),
        axis: 1u32,
        extent: 128f32,
        radius: 1f32,
        material: 13u32
    };
}
fn station_position(index: u32) -> Vec3 {
    if index == 0u32 {
        return vec(0f32, 1f32, 0f32);
    }
    if index == 1u32 {
        return vec(65f32, 16f32, 150f32);
    }
    return vec(76f32, 132f32, 150f32);
}
fn station_lit(progress: u32, station: u32) -> bool {
    return station == 0u32 || (progress & (1u32 << (station - 1u32))) != 0u32;
}
fn mission_goal(mission: Expedition) -> u32 {
    if (mission.progress & 1u32) == 0u32 {
        return 1u32;
    }
    if (mission.progress & 2u32) == 0u32 || !mission.return_link {
        return 2u32;
    }
    return 0u32;
}
fn world_solid_faces(world: u32, index: u32) -> u32 {
    if world == 0u32 {
        return 63u32;
    }
    if index == 0u32 {
        return 51u32;
    }
    if index == 2u32 {
        return 54u32;
    }
    return 59u32;
}
