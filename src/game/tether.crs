fn tether_winch(drone: mut Drone, reel: f32) -> unit {
    if drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    var old: f32 = drone.cable.extent;
    var speed: f32 = drone.cable.reel_speed + clamp(
        reel * 20f32 - drone.cable.reel_speed,
        -10f32 * STEP,
        10f32 * STEP
    );
    var extent: f32 = clamp(old + speed * STEP, 0.75f32, CABLE_REACH);
    var offset: Vec3 = sub(drone.position, drone.cable.anchor);
    var distance: f32 = length(offset);
    if distance > extent {
        move_drone(mut drone, scale(unit_vector(offset), extent - distance));
        extent = clamp(
            length(sub(drone.position, drone.cable.anchor)),
            extent,
            old
        );
    }
    drone.cable.extent = extent;
    drone.cable.reel_speed = (extent - old) / STEP;
}
fn tether_input(drone: mut Drone, command: Command) -> unit {
    if !command.tether {
        drone.cable = empty_cable();
        return;
    }
    if drone.cable.phase == CABLE_READY {
        hook_launch(mut drone);
    }
}
fn tether_travel(drone: read Drone, travel: Vec3) -> Vec3 {
    if drone.cable.phase != CABLE_ATTACHED {
        return travel;
    }
    var endpoint: Vec3 = add(drone.position, travel);
    var offset: Vec3 = sub(endpoint, drone.cable.anchor);
    if length(offset) <= drone.cable.extent {
        return travel;
    }
    return sub(
        add(drone.cable.anchor, scale(unit_vector(offset), drone.cable.extent)),
        drone.position
    );
}
fn tether_constraint(drone: mut Drone) -> unit {
    if drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    var offset: Vec3 = sub(drone.position, drone.cable.anchor);
    if length(offset) < drone.cable.extent - 0.001f32 {
        return;
    }
    var normal: Vec3 = unit_vector(offset);
    var speed: f32 = dot(drone.velocity, normal) - drone.cable.reel_speed;
    if speed <= 0f32 {
        return;
    }
    drone.velocity = sub(drone.velocity, scale(normal, speed));
    drone.winch_work = drone.winch_work + speed * clamp(
        -drone.cable.reel_speed,
        0f32,
        20f32
    );
}
