fn course_triangle_bound() -> u32 {
    return SOLID_COUNT * 6u32 + PIPE_COUNT * 10u32 + 16u32 + PREVIEW_MARKERS * 8u32 + 24u32;
}
fn draw_route_indicator(v: mut FrameInput, trial: read Trial, config: GameConfig) -> unit {
    var target: Vec3 = add(course_finish(), vec(0f32, 1f32, 0f32));
    if trial.gate < GATE_COUNT {
        target = course_gate_center(trial.gate);
    }
    var delta: Vec3 = sub(target, trial.drone.position);
    var aspect: f32 = config.width as f32 / config.height as f32;
    var angle: f32 = config.fov * 0.00872664626f32;
    var tangent: f32 = sinf(angle) / cosf(angle);
    var x: f32 = dot(delta, trial.drone.basis.right) / aspect;
    var y: f32 = dot(delta, trial.drone.basis.up);
    var z: f32 = dot(delta, trial.drone.basis.forward);
    if z > 0f32 && absf(x) < z * tangent * 0.85f32 && absf(y) < z * tangent * 0.85f32 {
        return;
    }
    var m: f32 = absf(x);
    if absf(y) > m {
        m = absf(y);
    }
    if m < 0.0001f32 {
        y = -1f32;
        m = 1f32;
    }
    x = x / m;
    y = y / m;
    var point: Vec3 = vec(x * 0.125f32, y * 0.125f32, 0f32);
    var axis: Vec3 = unit_vector(vec(x, y, 0f32));
    var side: Vec3 = vec(-axis.y, axis.x, 0f32);
    var a: Vec3 = add(point, scale(axis, 0.009f32));
    var b: Vec3 = add(sub(point, scale(axis, 0.005f32)), scale(side, 0.005f32));
    var c: Vec3 = sub(sub(point, scale(axis, 0.005f32)), scale(side, 0.005f32));
    var first: Vec3 = frame_point(trial.drone, config, a.x * aspect, a.y);
    var second: Vec3 = frame_point(trial.drone, config, b.x * aspect, b.y);
    var third: Vec3 = frame_point(trial.drone, config, c.x * aspect, c.y);
    game_quad(mut v, PREVIEW_MATERIAL, first, second, third, third);
}
