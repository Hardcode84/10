record PredictionPayload {
    collision: CollisionScene;
    trial: Trial;
    forecast: Drone;
    result: Prediction;
    doors: DoorSet;
    rooms: *ResidentBuild;
    waiting: u32;
}
opaque;
resource PredictionContext {
    schedule: TaskSchedule;
    slot: u32;
    payload: *PredictionPayload;
    times: TaskRunTimes;
}
opaque drop prediction_context_drop;
resource PredictionTask {
    context: mut PredictionContext;
}
opaque drop prediction_task_drop;
fn prediction_context(
    pool: read TaskPool,
    collision: read CollisionScene,
    doors: read DoorSet
) -> PredictionContext {
    var payload: *PredictionPayload = task_allocate(sizeof(PredictionPayload)) as *PredictionPayload;
    if payload == null(*PredictionPayload) {
        task_error("prediction task allocation failed");
    } else {
        payload -> collision = collision_new();
        payload -> doors = doors_new();
        if !collision_snapshot(read collision, mut payload -> collision) || !doors_copy(
            read doors,
            mut payload -> doors
        ) {
            drop payload -> collision;
            drop payload -> doors;
            task_release(payload as *u8);
            payload = null(*PredictionPayload);
        }
    }
    if payload != null(*PredictionPayload) {
        payload -> trial = new_trial();
        payload -> forecast = new_drone();
        payload -> rooms = null(*ResidentBuild);
        payload -> waiting = TASK_NONE;
    }
    var schedule: TaskSchedule = schedule_new();
    if !schedule_on(mut schedule, read pool, 1u32) {
        if payload != null(*PredictionPayload) {
            drop payload -> collision;
            drop payload -> doors;
            drop payload -> trial;
            drop payload -> forecast;
            task_release(payload as *u8);
            payload = null(*PredictionPayload);
        }
    }
    return make PredictionContext {
        schedule: move schedule,
        slot: 0u32,
        payload: payload,
        times: make TaskRunTimes {
            start: 0u64,
            finish: 0u64
        }
    };
}
fn prediction_context_ready(context: read PredictionContext) -> bool {
    return context.payload != null(*PredictionPayload);
}
fn prediction_context_drop(context: mut PredictionContext) -> unit {
    if context.payload != null(*PredictionPayload) {
        drop context.payload -> collision;
        drop context.payload -> doors;
        drop context.payload -> trial;
        drop context.payload -> forecast;
    }
    task_release(context.payload as *u8);
}
fn prediction_execute(data: *u8) -> TaskStep {
    var payload: *PredictionPayload = data as *PredictionPayload;
    if payload -> waiting != TASK_NONE {
        if !collision_room_resident(read payload -> collision, payload -> waiting) {
            collision_room_restore(
                mut payload -> collision,
                read payload -> rooms[payload -> waiting as usize].collision
            );
        }
        payload -> waiting = TASK_NONE;
    }
    payload -> result = predict_scene(
        read payload -> collision,
        read payload -> trial,
        mut payload -> forecast,
        mut payload -> doors
    );
    if payload -> result.admission.status == COLLISION_UNRESOLVED && payload -> rooms != null(
        *ResidentBuild
    ) {
        payload -> waiting = payload -> result.admission.space;
        return task_await(payload -> waiting);
    }
    return task_done(true);
}
fn prediction_start(
    context: mut PredictionContext,
    collision: read CollisionScene,
    trial: read Trial
) -> PredictionTask from context {
    collision_snapshot_motion(read collision, mut context.payload -> collision);
    assign_trial(mut context.payload -> trial, read trial);
    schedule_reset(read context.schedule, context.slot);
    schedule_define(
        read context.schedule,
        context.slot,
        prediction_execute,
        context.payload as *u8
    );
    schedule_request(read context.schedule, context.slot);
    schedule_poll(read context.schedule);
    return make PredictionTask {
        context: mut context
    };
}
fn prediction_task_poll(task: read PredictionTask) -> i32 {
    schedule_poll(read task.context.schedule);
    return schedule_status(read task.context.schedule, task.context.slot);
}
fn prediction_task_idle(task: read PredictionTask) -> unit {
    schedule_idle(read task.context.schedule);
}
fn prediction_task_result(task: mut PredictionTask) -> Prediction {
    if prediction_task_poll(read task) != 1i32 {
        trap;
    }
    task.context.times = schedule_times(read task.context.schedule, task.context.slot);
    return task.context.payload -> result;
}
fn prediction_context_times(context: read PredictionContext) -> TaskRunTimes {
    return context.times;
}
fn prediction_task_drop(task: mut PredictionTask) -> unit {
    while prediction_task_poll(read task) == 0i32 {
        prediction_task_idle(read task);
    }
}

fn prediction_task_doors(task: read PredictionTask, target: mut DoorSet, attempt: u32) -> unit {
    if prediction_task_poll(read task) != 1i32 {
        trap;
    }
    if task.context.payload -> result.admission.status == 0u32 && task.context.payload -> result.attempt == attempt {
        doors_publish(read task.context.payload -> doors, mut target);
    }
}

// Requires an idle context and the same scene construction as its snapshot.
fn prediction_select(
    context: mut PredictionContext,
    collision: read CollisionScene,
    rooms: read CollisionRooms
) -> CollisionAdmission {
    return collision_snapshot_admit(
        read collision,
        mut context.payload -> collision,
        read rooms
    );
}

// Requires all readers of the context to have retired.
fn prediction_context_residency(context: mut PredictionContext, collision: read CollisionScene) -> unit {
    collision_snapshot_residency(read collision, mut context.payload -> collision);
}
// Requires an idle context. The room owner must outlive this context and all its tasks.
fn prediction_streaming(context: mut PredictionContext, state: read RoomResidency) -> unit {
    context.schedule = schedule_clone(read state.schedule);
    context.slot = state.count;
    context.payload -> rooms = state.builds;
}
fn prediction_game_streaming(context: mut PredictionContext, session: read GameSession) -> unit {
    if session.control.residency.count != 0u32 {
        prediction_streaming(mut context, read session.control.residency);
    }
}
