fn game_next_snapshot(
    collision: read CollisionScene,
    control: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64,
    prediction: mut Prediction
) -> bool {
    var current: u64 = now();
    var elapsed: u64 = current - previous;
    previous = current;
    if !game_advance(read collision, mut control, mut loop, config, elapsed) {
        return false;
    }
    prediction = predict_paths(read collision, read loop.trial);
    return true;
}
fn game_overlapped_frame(
    graph: mut TaskGraph,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64,
    prediction: mut Prediction
) -> bool {
    game_prepare(read collision, mut session, read loop, config, read prediction);
    var surface: i32 = game_surface(mut session);
    if surface < 0i32 {
        return false;
    }
    if surface == 0i32 {
        game_wait();
        return game_next_snapshot(
            read collision,
            mut session.control,
            mut loop,
            config,
            mut previous,
            mut prediction
        );
    }
    task_graph_start(mut graph);
    if task_next(mut graph) != 0u32 {
        trap;
    }
    {
        var frame: SubmittedFrame = frame_submit(mut session.renderer);
        task_submission_returned(mut graph, 0u32, frame_accepted(read frame));
        game_frame_execute(
            mut graph,
            mut frame,
            read collision,
            mut session.control,
            mut loop,
            config,
            mut previous,
            mut prediction
        );
    }
    if !task_succeeded(read graph) {
        return false;
    }
    game_presented(mut session);
    return true;
}
fn game_run_tasks(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    game_task_mode();
    var graph: TaskGraph = task_graph_new();
    if !game_frame_graph(mut graph) {
        return 1i32;
    }
    var prediction: Prediction = predict_paths(read collision, read loop.trial);
    var previous: u64 = now();
    while loop.running {
        if !game_overlapped_frame(
            mut graph,
            read collision,
            mut session,
            mut loop,
            config,
            mut previous,
            mut prediction
        ) {
            return 1i32;
        }
    }
    if !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}

fn game_frame_graph(graph: mut TaskGraph) -> bool {
    return task_graph_open(mut graph, 4u32, 2u32) && task_graph_external(mut graph, 0u32) && task_graph_external(
        mut graph,
        3u32
    ) && task_graph_edge(mut graph, 0u32, 3u32) && task_graph_edge(mut graph, 1u32, 2u32) && task_graph_seal(
        mut graph
    );
}
fn game_frame_execute(
    graph: mut TaskGraph,
    frame: mut SubmittedFrame,
    collision: read CollisionScene,
    control: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64,
    prediction: mut Prediction
) -> unit {
    while !task_drained(read graph) {
        if task_pending(read graph, 0u32) {
            var status: i32 = frame_poll(mut frame);
            if status != 0i32 {
                task_external_complete(mut graph, 0u32, status > 0i32);
            }
        }
        var ready: u32 = task_next(mut graph);
        if ready == 1u32 {
            var current: u64 = now();
            var elapsed: u64 = current - previous;
            previous = current;
            task_complete(
                mut graph,
                ready,
                game_advance(read collision, mut control, mut loop, config, elapsed)
            );
        } else {
            if ready == 2u32 {
                prediction = predict_paths(read collision, read loop.trial);
                task_complete(mut graph, ready, true);
            } else {
                if ready == 3u32 {
                    game_present_task(
                        mut graph,
                        mut frame,
                        mut control,
                        mut loop.input,
                        config
                    );
                } else if !task_drained(read graph) {
                    frame_idle(mut frame);
                    if !task_has_error(read graph) && !game_poll(mut control, mut loop.input) {
                        task_cancel(mut graph);
                    }
                }
            }
        }
    }
}

fn game_present_task(
    graph: mut TaskGraph,
    frame: mut SubmittedFrame,
    control: mut GameControl,
    input: mut InputState,
    config: GameConfig
) -> unit {
    if config.headless {
        task_submission_returned(mut graph, 3u32, true);
        task_external_complete(mut graph, 3u32, true);
        return;
    }
    var image: ValidatedImage = frame_image(mut frame);
    var operation: Presentation = image_present(mut image);
    task_submission_returned(mut graph, 3u32, presentation_accepted(read operation));
    while task_pending(read graph, 3u32) {
        var status: i32 = presentation_poll(mut operation);
        if status != 0i32 {
            task_external_complete(mut graph, 3u32, status > 0i32);
        } else {
            presentation_idle(mut operation);
            if !task_has_error(read graph) && !game_poll(mut control, mut input) {
                task_cancel(mut graph);
            }
        }
    }
}
