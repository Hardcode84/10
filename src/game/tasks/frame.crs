fn game_task_frame(
    context: mut PredictionContext,
    sound: mut SoundContext,
    collision: mut CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64,
    prediction: mut Prediction
) -> bool {
    var current: u64 = now();
    var elapsed: u64 = current - previous;
    previous = current;
    if !game_advance(mut collision, mut session.control, mut loop, config, elapsed) {
        return false;
    }
    if loop.input.quit {
        loop.running = false;
        return true;
    }
    while true {
        game_residency_prediction(mut session.control, read prediction);
        if !game_residency_frame(mut collision, mut session, mut loop) {
            if loop.input.quit {
                loop.running = false;
                return true;
            }
            return false;
        }
        prediction_context_residency(mut context, read collision);
        sound_context_residency(mut sound, read collision);
        if !game_root_frame(
            mut context,
            mut sound,
            read collision,
            mut session,
            mut loop,
            config,
            mut prediction
        ) {
            return false;
        }
        if !game_residency_incomplete(read session.control) {
            return true;
        }
        if !game_residency_visible(mut collision, mut session.control, mut loop.input) {
            return false;
        }
    }
}
fn game_run_tasks(
    collision: mut CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    game_task_mode(config.workers);
    var prediction: Prediction = prediction_new();
    var context: PredictionContext = game_prediction_context(read session, read collision);
    prediction_game_streaming(mut context, read session);
    if !prediction_context_ready(read context) {
        return 1i32;
    }
    var sound: SoundContext = game_sound_context(read session, read collision);
    if !sound_game_streaming(mut sound, read session) || !sound_context_ready(read sound) {
        return 1i32;
    }
    var previous: u64 = now();
    while loop.running {
        if !game_task_frame(
            mut context,
            mut sound,
            mut collision,
            mut session,
            mut loop,
            config,
            mut previous,
            mut prediction
        ) {
            return 1i32;
        }
        if !config.headless {
            game_wait();
        }
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}
