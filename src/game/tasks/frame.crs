fn game_task_frame(
    graph: mut TaskGraph,
    context: mut PredictionContext,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64,
    prediction: mut Prediction
) -> bool {
    task_graph_start(mut graph);
    if task_next(mut graph) != 1u32 {
        trap;
    }
    game_simulation_task(
        mut graph,
        read collision,
        mut session.control,
        mut loop,
        config,
        mut previous
    );
    if task_has_error(read graph) {
        return false;
    }
    if task_next(mut graph) != 2u32 {
        trap;
    }
    if config.workers == 0u32 {
        return game_shadow_frame(
            mut graph,
            mut context,
            read collision,
            mut session,
            mut loop,
            config,
            mut prediction
        );
    }
    {
        var work: PredictionTask = prediction_start(mut context, loop.trial);
        if task_next(mut graph) != 4u32 {
            trap;
        }
        game_prepare_begin(read collision, mut session, read loop, config);
        task_complete(mut graph, 4u32, true);
        if task_next(mut graph) != 5u32 {
            trap;
        }
        task_submission_returned(mut graph, 5u32, true);
        task_external_complete(mut graph, 5u32, true);
        var status: i32 = prediction_task_poll(read work);
        while status == 0i32 {
            prediction_task_idle(read work);
            if !game_poll(mut session.control, mut loop.input) {
                task_cancel(mut graph);
            }
            status = prediction_task_poll(read work);
        }
        if status > 0i32 {
            prediction = prediction_task_result(mut work);
        }
        task_complete(mut graph, 2u32, status > 0i32);
    }
    if task_has_error(read graph) {
        return false;
    }
    game_prepare_finish(read collision, mut session, read loop, config, read prediction);
    var surface: i32 = game_surface(mut session);
    if surface <= 0i32 {
        task_cancel(mut graph);
        if surface == 0i32 {
            game_wait();
        }
        return surface == 0i32;
    }
    if task_next(mut graph) != 0u32 {
        trap;
    }
    {
        var frame: SubmittedFrame = frame_submit(mut session.renderer);
        task_submission_returned(mut graph, 0u32, frame_accepted(read frame));
        game_frame_execute(
            mut graph,
            mut frame,
            mut session.control,
            mut loop.input,
            config
        );
    }
    if !task_succeeded(read graph) {
        return false;
    }
    game_presented(mut session);
    return true;
}
fn game_run_tasks(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    game_task_mode(config.workers);
    var graph: TaskGraph = task_graph_new();
    if !game_frame_graph(mut graph) {
        return 1i32;
    }
    var prediction: Prediction = prediction_new();
    var pool: TaskPool = task_pool_new();
    if !task_pool_open(mut pool, config.workers, 1u32) {
        return 1i32;
    }
    var context: PredictionContext = prediction_context(read pool, read collision);
    if !prediction_context_ready(read context) {
        return 1i32;
    }
    var previous: u64 = now();
    while loop.running {
        if !game_task_frame(
            mut graph,
            mut context,
            read collision,
            mut session,
            mut loop,
            config,
            mut previous,
            mut prediction
        ) {
            return 1i32;
        }
        if !config.headless {
            game_wait();
        }
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}

fn game_frame_graph(graph: mut TaskGraph) -> bool {
    return task_graph_open(mut graph, 6u32, 6u32) && task_graph_external(mut graph, 0u32) && task_graph_external(
        mut graph,
        3u32
    ) && task_graph_edge(mut graph, 0u32, 3u32) && task_graph_edge(mut graph, 1u32, 4u32) && task_graph_edge(
        mut graph,
        1u32,
        2u32
    ) && task_graph_external(mut graph, 5u32) && task_graph_edge(mut graph, 4u32, 5u32) && task_graph_edge(
        mut graph,
        5u32,
        0u32
    ) && task_graph_edge(mut graph, 2u32, 0u32) && task_graph_seal(mut graph);
}
fn game_simulation_task(
    graph: mut TaskGraph,
    collision: read CollisionScene,
    control: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    previous: mut u64
) -> unit {
    var current: u64 = now();
    var elapsed: u64 = current - previous;
    previous = current;
    task_complete(
        mut graph,
        1u32,
        game_advance(read collision, mut control, mut loop, config, elapsed)
    );
}
fn game_frame_execute(
    graph: mut TaskGraph,
    frame: mut SubmittedFrame,
    control: mut GameControl,
    input: mut InputState,
    config: GameConfig
) -> unit {
    while !task_drained(read graph) {
        if task_pending(read graph, 0u32) {
            var status: i32 = frame_poll(mut frame);
            if status != 0i32 {
                task_external_complete(mut graph, 0u32, status > 0i32);
            }
        }
        var ready: u32 = task_next(mut graph);
        if ready == 3u32 {
            game_present_task(mut graph, mut frame, mut control, mut input, config);
        } else if !task_drained(read graph) {
            frame_idle(mut frame);
            if !task_has_error(read graph) && !game_poll(mut control, mut input) {
                task_cancel(mut graph);
            }
        }
    }
}
fn game_present_task(
    graph: mut TaskGraph,
    frame: mut SubmittedFrame,
    control: mut GameControl,
    input: mut InputState,
    config: GameConfig
) -> unit {
    if config.headless {
        task_submission_returned(mut graph, 3u32, true);
        task_external_complete(mut graph, 3u32, true);
        return;
    }
    var image: ValidatedImage = frame_image(mut frame);
    var operation: Presentation = image_present(mut image);
    task_submission_returned(mut graph, 3u32, presentation_accepted(read operation));
    while task_pending(read graph, 3u32) {
        var status: i32 = presentation_poll(mut operation);
        if status != 0i32 {
            task_external_complete(mut graph, 3u32, status > 0i32);
        } else {
            presentation_idle(mut operation);
            if !task_has_error(read graph) && !game_poll(mut control, mut input) {
                task_cancel(mut graph);
            }
        }
    }
}
