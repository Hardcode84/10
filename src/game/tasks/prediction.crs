record PredictionEye {
    position: Vec3;
    basis: Basis;
    world: u32;
    factor: f32;
}
fn prediction_eye(drone: read Drone) -> PredictionEye {
    return make PredictionEye {
        position: drone.position,
        basis: drone.basis,
        world: drone.world,
        factor: drone_size(read drone)
    };
}
const PREDICTION_TICKS: u32 = 240u32;
const PREVIEW_MARKERS: u32 = 8u32;
record PredictionMarker {
    center: Vec3;
    eye: PredictionEye;
    material: u32;
}
record Prediction {
    door: u32;
    attempt: u32;
    source_tick: u32;
    full_spin: bool;
    markers: [PredictionMarker; 8];
    count: u32;
}
fn prediction_new() -> Prediction {
    var drone: Drone = new_drone();
    var marker: PredictionMarker = make PredictionMarker {
        center: vec(0f32, 0f32, 0f32),
        eye: prediction_eye(read drone),
        material: 0u32
    };
    return make Prediction {
        door: 0xffffffffu32,
        attempt: 0u32,
        source_tick: 0u32,
        full_spin: false,
        markers: make [PredictionMarker; 8] {
            marker,
            marker,
            marker,
            marker,
            marker,
            marker,
            marker,
            marker
        },
        count: 0u32
    };
}
record PreviewTrail {
    distance: f32;
    markers: u32;
    limit: u32;
    material: u32;
}
fn preview_trail(limit: u32, material: u32, phase: f32) -> PreviewTrail {
    return make PreviewTrail {
        distance: phase,
        markers: 0u32,
        limit: limit,
        material: material
    };
}
fn predict_segment(
    prediction: mut Prediction,
    trail: mut PreviewTrail,
    before: Vec3,
    after: Vec3,
    eye: PredictionEye,
) -> unit {
    var travel: Vec3 = sub(after, before);
    var body_scale: f32 = eye.factor;
    var segment: f32 = length(travel) / body_scale;
    var spacing: f32 = PREVIEW_SPACING;
    var next: f32 = (trail.markers + 1u32) as f32 * spacing;
    while segment > 0f32 && next <= trail.distance + segment && trail.markers < trail.limit {
        var point: Vec3 = preview_station(
            before,
            after,
            trail.distance * body_scale,
            next * body_scale
        );
        prediction.markers[prediction.count as usize] = make PredictionMarker {
            center: point,
            eye: eye,
            material: trail.material
        };
        prediction.count = prediction.count + 1u32;
        trail.markers = trail.markers + 1u32;
        next = (trail.markers + 1u32) as f32 * spacing;
    }
    trail.distance = trail.distance + segment;
}
fn predict_paths(collision: read CollisionScene, trial: read Trial, scratch: mut Drone) -> Prediction {
    var doors: DoorSet = doors_new();
    return predict_scene(read collision, read trial, mut scratch, read doors);
}
fn predict_scene(
    collision: read CollisionScene,
    trial: read Trial,
    scratch: mut Drone,
    doors: read DoorSet
) -> Prediction {
    var prediction: Prediction = prediction_new();
    prediction.attempt = trial.attempt;
    prediction.source_tick = trial.tick;
    prediction.full_spin = trial.full_spin;
    var hook_ready: bool = trial.drone.cable.phase == CABLE_READY && trial.preview_enabled;
    var limit: u32 = PREVIEW_MARKERS;
    if hook_ready {
        limit = PREVIEW_MARKERS / 2u32;
    }
    var used: u32 = predict_drone(
        read collision,
        mut prediction,
        read trial,
        mut scratch,
        limit,
        read doors
    );
    if hook_ready {
        predict_hook(
            read collision,
            mut prediction,
            read trial,
            mut scratch,
            PREVIEW_MARKERS - used
        );
    }
    return prediction;
}
fn predict_drone(
    collision: read CollisionScene,
    prediction: mut Prediction,
    trial: read Trial,
    drone: mut Drone,
    limit: u32,
    doors: read DoorSet
) -> u32 {
    assign_drone(mut drone, read trial.drone);
    var eye: PredictionEye = prediction_eye(read trial.drone);
    var command: Command = idle_command();
    command.tether = drone.cable.phase == CABLE_ATTACHED || drone.cable.phase == CABLE_FLYING;
    var i: u32 = 0u32;
    var trail: PreviewTrail = preview_trail(limit, PREVIEW_MATERIAL, trial.preview_phase);
    while i < PREDICTION_TICKS {
        var before: Vec3 = drone.position;
        simulate(read collision, mut drone, command, trial.full_spin, trial.auto_level);
        predict_door_portal(
            read collision,
            read doors,
            mut prediction,
            mut trail,
            before,
            space_point(space_inverse(drone.step_frame), drone.position),
            eye,
        );
        eye = preview_eye(eye, drone.step_frame, drone.world);
        i = i + 1u32;
    }
    return trail.markers;
}
fn predict_portal(
    collision: read CollisionScene,
    prediction: mut Prediction,
    trail: mut PreviewTrail,
    before: Vec3,
    after: Vec3,
    eye: PredictionEye
) -> unit {
    var doors: DoorSet = doors_new();
    predict_door_portal(
        read collision,
        read doors,
        mut prediction,
        mut trail,
        before,
        after,
        eye
    );
}
fn predict_door_portal(
    collision: read CollisionScene,
    doors: read DoorSet,
    prediction: mut Prediction,
    trail: mut PreviewTrail,
    before: Vec3,
    after: Vec3,
    eye: PredictionEye,
) -> unit {
    var crossings: u32 = 0u32;
    while crossings < 1024u32 {
        var travel: Vec3 = sub(after, before);
        var crossing: PortalCrossing = portal_crossing(
            read collision,
            eye.world,
            before,
            travel
        );
        if crossing.time > 1f32 {
            doors_predict(read collision, read doors, mut prediction, before, after, eye);
            predict_segment(mut prediction, mut trail, before, after, eye);
            return;
        }
        var point: Vec3 = add(before, scale(travel, crossing.time));
        doors_predict(read collision, read doors, mut prediction, before, point, eye);
        predict_segment(mut prediction, mut trail, before, point, eye);
        var portal: CollisionPortal = collision_portal(read collision, crossing.index);
        before = space_point(portal.transform, point);
        after = space_point(portal.transform, after);
        eye = preview_eye(eye, portal.transform, portal.destination);
        crossings = crossings + 1u32;
    }
    scene_motion_failure();
}
fn predict_hook(
    collision: read CollisionScene,
    prediction: mut Prediction,
    trial: read Trial,
    drone: mut Drone,
    limit: u32
) -> unit {
    assign_drone(mut drone, read trial.drone);
    var command: Command = idle_command();
    command.tether = true;
    var trail: PreviewTrail = preview_trail(limit, HOOK_PREVIEW_MATERIAL, 0f32);
    var eye: PredictionEye = prediction_eye(read trial.drone);
    var i: u32 = 0u32;
    while i < PREDICTION_TICKS && trail.markers < trail.limit {
        var before: Vec3 = drone.position;
        var frame: SpaceTransform = space_identity();
        var space: u32 = drone.world;
        if drone.cable.phase == CABLE_FLYING {
            before = drone.cable.anchor;
            frame = drone.cable.frame;
            space = drone.cable.space;
        }
        simulate(read collision, mut drone, command, trial.full_spin, trial.auto_level);
        if drone.cable.phase == CABLE_SNAPPED {
            return;
        }
        var inverse: SpaceTransform = space_inverse(frame);
        predict_portal(
            read collision,
            mut prediction,
            mut trail,
            space_point(inverse, before),
            space_point(
                inverse,
                space_point(space_inverse(drone.step_frame), drone.cable.anchor)
            ),
            preview_eye(eye, inverse, space),
        );
        eye = preview_eye(eye, drone.step_frame, drone.world);
        if drone.cable.phase == CABLE_BLOCKED {
            if prediction.count == PREVIEW_MARKERS {
                prediction.count = prediction.count - 1u32;
            }
            prediction.markers[prediction.count as usize] = make PredictionMarker {
                center: space_point(
                    space_inverse(drone.cable.frame),
                    drone.cable.anchor
                ),
                eye: preview_eye(
                    eye,
                    space_inverse(drone.cable.frame),
                    drone.cable.space
                ),
                material: 4u32
            };
            prediction.count = prediction.count + 1u32;
            return;
        }
        if drone.cable.phase == CABLE_ATTACHED {
            return;
        }
        i = i + 1u32;
    }
}

fn preview_eye(eye: PredictionEye, transform: SpaceTransform, space: u32) -> PredictionEye {
    eye.factor = transform.factor * eye.factor;
    eye.position = space_point(transform, eye.position);
    eye.basis = space_basis(transform, eye.basis);
    eye.world = space;
    return eye;
}

fn prediction_visible(prediction: Prediction, trial: read Trial) -> Prediction {
    if prediction.attempt != trial.attempt || prediction.full_spin != trial.full_spin || !trial.preview_enabled {
        prediction.count = 0u32;
        return prediction;
    }
    var count: u32 = 0u32;
    var i: u32 = 0u32;
    while i < prediction.count {
        var marker: PredictionMarker = prediction.markers[i as usize];
        if marker.material == PREVIEW_MATERIAL || trial.drone.cable.phase == CABLE_READY {
            prediction.markers[count as usize] = marker;
            count = count + 1u32;
        }
        i = i + 1u32;
    }
    prediction.count = count;
    return prediction;
}
