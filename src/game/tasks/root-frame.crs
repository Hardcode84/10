fn game_root_frame(
    graph: mut TaskGraph,
    context: mut PredictionContext,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    prediction: mut Prediction
) -> bool {
    var surface: i32 = game_surface(mut session);
    if surface <= 0i32 {
        task_complete(mut graph, 2u32, false);
        if surface == 0i32 {
            game_wait();
        }
        return surface == 0i32;
    }
    var visible: Prediction = prediction_visible(prediction, read loop.trial);
    if config.workers > 0u32 {
        var work: PredictionTask = prediction_start(mut context, read loop.trial);
        game_prediction_scene(
            mut graph,
            read collision,
            mut session,
            read loop,
            config,
            read visible
        );
        {
            var frame: SubmittedFrame = frame_submit(mut session.renderer);
            task_submission_returned(mut graph, 0u32, frame_accepted(read frame));
            game_frame_execute(
                mut graph,
                mut frame,
                mut session.control,
                mut loop.input,
                config
            );
        }
        game_prediction_join(
            mut graph,
            mut work,
            mut session.control,
            mut loop.input,
            mut prediction
        );
    } else {
        game_prediction_scene(
            mut graph,
            read collision,
            mut session,
            read loop,
            config,
            read visible
        );
        var frame: SubmittedFrame = frame_submit(mut session.renderer);
        task_submission_returned(mut graph, 0u32, frame_accepted(read frame));
        var work: PredictionTask = prediction_start(mut context, read loop.trial);
        game_frame_execute(
            mut graph,
            mut frame,
            mut session.control,
            mut loop.input,
            config
        );
        game_prediction_join(
            mut graph,
            mut work,
            mut session.control,
            mut loop.input,
            mut prediction
        );
    }
    if !task_succeeded(read graph) {
        return false;
    }
    game_presented(mut session);
    return true;
}

fn game_prediction_scene(
    graph: mut TaskGraph,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    visible: read Prediction
) -> unit {
    if task_next(mut graph) != 4u32 {
        trap;
    }
    game_prepare(read collision, mut session, read loop, config, read visible);
    task_complete(mut graph, 4u32, true);
    if task_next(mut graph) != 0u32 {
        trap;
    }
}

fn game_prediction_join(
    graph: mut TaskGraph,
    work: mut PredictionTask,
    control: mut GameControl,
    input: mut InputState,
    prediction: mut Prediction
) -> unit {
    var status: i32 = prediction_task_poll(read work);
    while status == 0i32 {
        prediction_task_idle(read work);
        if !game_poll(mut control, mut input) {
            task_cancel(mut graph);
        }
        status = prediction_task_poll(read work);
    }
    if status > 0i32 {
        prediction = prediction_task_result(mut work);
    }
    task_complete(mut graph, 2u32, status > 0i32);
}
