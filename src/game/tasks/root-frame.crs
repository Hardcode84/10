fn game_root_frame(
    context: mut PredictionContext,
    sound: mut SoundContext,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    prediction: mut Prediction
) -> bool {
    var sound_work: SoundTask = sound_start(
        mut sound,
        read collision,
        game_sound_snapshot(mut session.control, read loop, config)
    );
    var surface: i32 = game_surface(mut session);
    if surface <= 0i32 {
        var good: bool = game_sound_join(
            mut sound_work,
            mut session.control,
            mut loop.input
        );
        if surface == 0i32 {
            game_wait();
        }
        return good && surface == 0i32;
    }
    var visible: Prediction = prediction_visible(prediction, read loop.trial);
    var work: PredictionTask = prediction_start(mut context, read collision, read loop.trial);
    game_prepare(read collision, mut session, read loop, config, read visible);
    var rendered: bool = false;
    {
        var frame: SubmittedFrame = frame_submit(mut session.renderer);
        rendered = game_frame_execute(
            mut frame,
            mut session.control,
            mut loop.input,
            config
        );
    }
    var forecast: bool = game_prediction_join(
        mut work,
        mut session.control,
        mut loop.input,
        mut prediction,
        loop.trial.attempt
    );
    var audio: bool = game_sound_join(mut sound_work, mut session.control, mut loop.input);
    if !rendered || !forecast || !audio {
        return false;
    }
    if !game_residency_incomplete(read session.control) {
        game_presented(mut session);
    }
    return true;
}
fn game_prediction_join(
    work: mut PredictionTask,
    control: mut GameControl,
    input: mut InputState,
    prediction: mut Prediction,
    attempt: u32
) -> bool {
    var event: Event = prediction_event(read work);
    if !game_event_wait(mut control, mut input, read event) {
        return false;
    }
    prediction = prediction_task_result(mut work);
    prediction_task_doors(read work, game_doors_mut(mut control), attempt);
    return true;
}
fn game_frame_execute(
    frame: mut SubmittedFrame,
    control: mut GameControl,
    input: mut InputState,
    config: GameConfig
) -> bool {
    if !frame_accepted(read frame) {
        return false;
    }
    var context: Context = game_task_context(read control);
    while true {
        var event: Event = frame_completion(read frame, read context);
        if !game_event_wait(mut control, mut input, read event) {
            return false;
        }
        var status: i32 = frame_poll(mut frame);
        if status < 0i32 {
            return false;
        }
        if status == 2i32 {
            game_residency_missing(mut control, frame_missing_portal(read frame));
            return true;
        }
        if status == 1i32 {
            break;
        }
    }
    if config.headless {
        return true;
    }
    var image: ValidatedImage = frame_image(mut frame);
    var operation: Presentation = image_present(mut image);
    if !presentation_accepted(read operation) {
        return false;
    }
    var event: Event = presentation_completion(read operation, read context);
    if !game_event_wait(mut control, mut input, read event) {
        return false;
    }
    return presentation_poll(mut operation) > 0i32;
}
