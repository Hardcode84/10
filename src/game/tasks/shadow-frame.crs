fn game_deferred_scene(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> DeferredGeometry {
    game_prepare_begin(read collision, mut session, read loop, config);
    var range: DeferredGeometry = game_defer_prediction(mut session);
    var empty: Prediction = prediction_new();
    game_prepare_finish(read collision, mut session, read loop, config, read empty);
    return range;
}
fn game_shadow_frame(
    graph: mut TaskGraph,
    context: mut PredictionContext,
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig,
    prediction: mut Prediction
) -> bool {
    if task_next(mut graph) != 4u32 {
        trap;
    }
    var range: DeferredGeometry = game_deferred_scene(
        read collision,
        mut session,
        read loop,
        config
    );
    task_complete(mut graph, 4u32, true);
    var surface: i32 = game_surface(mut session);
    if surface <= 0i32 {
        task_complete(mut graph, 2u32, false);
        if surface == 0i32 {
            game_wait();
        }
        return surface == 0i32;
    }
    {
        if task_next(mut graph) != 5u32 {
            trap;
        }
        var setup: FrameSetup = frame_setup(mut session.renderer, range);
        task_submission_returned(mut graph, 5u32, frame_setup_accepted(read setup));
        if !frame_setup_accepted(read setup) {
            task_complete(mut graph, 2u32, false);
            return false;
        }
        prediction = prediction_inline(mut context, read loop.trial);
        task_complete(mut graph, 2u32, true);
        var status: i32 = frame_setup_poll(mut setup);
        while status == 0i32 {
            frame_setup_idle(mut setup);
            if !game_poll(mut session.control, mut loop.input) {
                task_cancel(mut graph);
            }
            status = frame_setup_poll(mut setup);
        }
        task_external_complete(mut graph, 5u32, status > 0i32);
        if task_has_error(read graph) {
            return false;
        }
        {
            var edit: DeferredInput = frame_setup_edit(mut setup);
            draw_prediction(deferred_inputs(mut edit), read prediction, config);
        }
        if task_next(mut graph) != 0u32 {
            trap;
        }
        var frame: SubmittedFrame = frame_setup_submit(mut setup);
        task_submission_returned(mut graph, 0u32, frame_accepted(read frame));
        game_frame_execute(
            mut graph,
            mut frame,
            mut session.control,
            mut loop.input,
            config
        );
    }
    if !task_succeeded(read graph) {
        return false;
    }
    game_presented(mut session);
    return true;
}

fn game_defer_prediction(session: mut GameSession) -> DeferredGeometry {
    var input: FrameInput = renderer_inputs(mut session.renderer);
    return input_defer(mut input, PREVIEW_MARKERS * 8u32);
}
