fn expedition_light_layout(v: mut FrameInput) -> unit {
    input_set_word(mut v, LIGHT_COUNT as usize, 8u32);
    course_light(
        mut v,
        0u32,
        vec(0f32, 10f32, 12f32),
        vec(1.8f32, 1.1f32, 0.45f32),
        24f32
    );
    course_light(
        mut v,
        1u32,
        vec(0f32, 10f32, 52f32),
        vec(1.8f32, 1.1f32, 0.45f32),
        24f32
    );
    course_light(
        mut v,
        2u32,
        vec(65f32, 30f32, 150f32),
        vec(1.5f32, 0.8f32, 0.3f32),
        45f32
    );
    course_light(
        mut v,
        3u32,
        vec(116f32, 60f32, 150f32),
        vec(0.5f32, 1.3f32, 1.6f32),
        35f32
    );
    course_light(
        mut v,
        4u32,
        vec(116f32, 130f32, 150f32),
        vec(1.8f32, 0.45f32, 0.25f32),
        30f32
    );
    course_light(
        mut v,
        5u32,
        vec(76f32, 140f32, 150f32),
        vec(0.7f32, 1.2f32, 1.8f32),
        60f32
    );
    course_light(
        mut v,
        6u32,
        vec(40f32, 100f32, 150f32),
        vec(0.5f32, 1.2f32, 1.4f32),
        60f32
    );
    course_light(
        mut v,
        7u32,
        vec(40f32, 45f32, 150f32),
        vec(1.8f32, 1.1f32, 0.45f32),
        45f32
    );
}
