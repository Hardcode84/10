fn game_quad(v: mut FrameInput, mat: u32, a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> unit {
    quad(
        mut v,
        0u32,
        mat,
        0u32,
        0u32,
        a.x,
        a.y,
        a.z,
        b.x,
        b.y,
        b.z,
        c.x,
        c.y,
        c.z,
        d.x,
        d.y,
        d.z
    );
}
fn draw_solid(v: mut FrameInput, s: Solid, eye: Vec3) -> unit {
    draw_solid_faces(mut v, s, eye, 63u32);
}
fn draw_solid_faces(v: mut FrameInput, s: Solid, eye: Vec3, faces: u32) -> unit {
    var axis: u32 = 0u32;
    while axis < 3u32 {
        var side: f32 = component(eye, axis);
        var face: u32 = axis * 2u32;
        if side > component(s.high, axis) {
            face = face + 1u32;
        }
        if (faces & (1u32 << face)) != 0u32 && (
            side < component(s.low, axis) || side > component(s.high, axis)
        ) {
            var shift: Vec3 = vec(0f32, 0f32, 0f32);
            if side > component(s.high, axis) {
                shift = scale(
                    axis_vector(axis),
                    component(sub(s.high, s.low), axis)
                );
            }
            surface_quad(
                mut v,
                s.material,
                add(box_edge(s, axis, 0u32), shift),
                add(box_edge(s, axis, 1u32), shift),
                add(box_edge(s, axis, 3u32), shift),
                add(box_edge(s, axis, 2u32), shift)
            );
        }
        axis = axis + 1u32;
    }
}
fn draw_ribbon(v: mut FrameInput, a: Vec3, b: Vec3, eye: Vec3, width: f32, mat: u32) -> unit {
    var side: Vec3 = scale(unit_vector(cross(sub(b, a), sub(eye, a))), width);
    game_quad(
        mut v,
        mat,
        sub(a, side),
        add(a, side),
        add(b, side),
        sub(b, side)
    );
}
fn draw_gate(v: mut FrameInput, gate: CourseGate, mat: u32) -> unit {
    var r: Vec3 = gate.right;
    var u: Vec3 = gate.up;
    var i: u32 = 0u32;
    while i < 4u32 {
        var a: Vec3 = sub(scale(r, -1f32), u);
        var b: Vec3 = sub(r, u);
        game_quad(
            mut v,
            mat,
            add(gate.center, scale(a, 6f32)),
            add(gate.center, scale(b, 6f32)),
            add(gate.center, scale(b, 5.85f32)),
            add(gate.center, scale(a, 5.85f32))
        );
        var next: Vec3 = scale(r, -1f32);
        r = u;
        u = next;
        i = i + 1u32;
    }
}
fn camera_row(v: mut FrameInput, row: usize, axis: Vec3, position: Vec3) -> unit {
    input_set_float(mut v, row, axis.x);
    input_set_float(mut v, row + 1usize, axis.y);
    input_set_float(mut v, row + 2usize, axis.z);
    input_set_float(mut v, row + 3usize, -dot(axis, position));
}
fn game_scene(v: mut FrameInput, trial: read Trial, config: GameConfig) -> unit {
    input_set_word(mut v, 3usize, 0u32);
    input_set_word(mut v, 4usize, 0u32);
    input_set_word(mut v, 20usize, 0u32);
    input_set_word(mut v, BACKGROUND as usize, 0xff0d0906u32);
    input_set_float(mut v, RENDER_STYLE as usize, 0.04f32);
    var angle: f32 = config.fov * 0.00872664626f32;
    input_set_float(mut v, PROJECTION as usize, sinf(angle) / cosf(angle));
    camera_row(mut v, 0usize, trial.drone.basis.right, trial.drone.position);
    camera_row(mut v, 4usize, trial.drone.basis.up, trial.drone.position);
    camera_row(mut v, 8usize, trial.drone.basis.forward, trial.drone.position);
    if trial.drone.world == 1u32 {
        draw_expedition_shell(mut v, trial.drone.position);
    }
    var i: u32 = 0u32;
    while i < world_solid_count(trial.drone.world) {
        draw_solid_faces(
            mut v,
            world_solid(trial.drone.world, i),
            trial.drone.position,
            world_solid_faces(trial.drone.world, i)
        );
        i = i + 1u32;
    }
    i = 0u32;
    while i < world_pipe_count(trial.drone.world) {
        draw_pipe(mut v, world_pipe(trial.drone.world, i), trial.drone.position);
        i = i + 1u32;
    }
    if trial.drone.world == 1u32 {
        expedition_scene(mut v, read trial);
        expedition_lights(mut v, read trial);
    } else {
        draw_course_gates(mut v, read trial);
    }
    draw_cable(mut v, trial.drone, config);
    draw_preview(mut v, read trial, config);
    draw_frame(mut v, trial.drone, config);
    draw_route_indicator(mut v, read trial, config);
}

fn surface_quad(v: mut FrameInput, mat: u32, a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> unit {
    var first: u32 = input_word(read v, 3usize);
    game_quad(mut v, mat, a, b, c, d);
    var u: f32 = length(sub(b, a)) / 4f32;
    var w: f32 = length(sub(d, a)) / 4f32;
    var base: usize = (GEOMETRY + first * 15u32) as usize;
    input_set_float(mut v, base + 8usize, u);
    input_set_float(mut v, base + 13usize, u);
    input_set_float(mut v, base + 14usize, w);
    input_set_float(mut v, base + 23usize, u);
    input_set_float(mut v, base + 24usize, w);
    input_set_float(mut v, base + 29usize, w);
}

fn draw_course_gates(v: mut FrameInput, trial: read Trial) -> unit {
    var i: u32 = trial.gate;
    while i < GATE_COUNT && i < trial.gate + 2u32 {
        var mat: u32 = 7u32;
        if i == trial.gate {
            mat = 4u32;
        }
        draw_gate(mut v, course_gate(i), mat);
        i = i + 1u32;
    }
    if trial.gate == GATE_COUNT {
        var dock: CourseGate = course_gate(GATE_COUNT - 1u32);
        dock.center = add(course_finish(), vec(0f32, 6.1f32, 0f32));
        draw_gate(mut v, dock, 5u32);
    }
}
