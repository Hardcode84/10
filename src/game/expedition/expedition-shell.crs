fn expedition_contains(p: Vec3) -> bool {
    var i: u32 = 0u32;
    while i < ROOM_COUNT {
        var room: RoomInstance = expedition_room(i);
        var q: Vec3 = sub(p, room.origin);
        var s: Vec3 = room.prefab.size;
        if q.x >= 0f32 && q.y >= 0f32 && q.z >= 0f32 && q.x <= s.x && q.y <= s.y && q.z <= s.z {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}
