fn draw_station(v: mut FrameInput, position: Vec3, material: u32) -> unit {
    var low: Vec3 = sub(position, vec(0f32, 2f32, 0f32));
    var high: Vec3 = add(position, vec(0f32, 2f32, 0f32));
    var x: Vec3 = vec(0.4f32, 0f32, 0f32);
    var z: Vec3 = vec(0f32, 0f32, 0.4f32);
    game_quad(
        mut v,
        material,
        sub(low, x),
        add(low, x),
        add(high, x),
        sub(high, x)
    );
    game_quad(
        mut v,
        material,
        sub(low, z),
        add(low, z),
        add(high, z),
        sub(high, z)
    );
}
fn expedition_scene(v: mut FrameInput, trial: read Trial) -> unit {
    var i: u32 = 0u32;
    while i < 3u32 {
        var material: u32 = 6u32;
        if station_lit(trial.expedition.progress, i) {
            material = 4u32;
        }
        if i == 0u32 {
            material = 5u32;
        }
        if i == mission_goal(trial.expedition) {
            var dock: CourseGate = make CourseGate {
                center: station_position(i),
                right: trial.drone.basis.right,
                up: trial.drone.basis.up,
                normal: trial.drone.basis.forward
            };
            draw_gate(mut v, dock, material);
        } else if length(sub(trial.drone.position, station_position(i))) >= 6f32 {
            draw_station(mut v, station_position(i), material);
        }
        i = i + 1u32;
    }
    if trial.expedition.has_parked {
        var size: Vec3 = vec(0.3f32, 0.3f32, 0.3f32);
        draw_solid(
            mut v,
            solid(
                sub(trial.expedition.parked, size),
                add(trial.expedition.parked, size),
                5u32
            ),
            trial.drone.position
        );
    }
}
fn expedition_light_strength(trial: read Trial, index: u32) -> f32 {
    if index == 0u32 {
        return 1f32;
    }
    var strength: f32 = 0f32;
    if (trial.expedition.progress & 1u32) != 0u32 && index < 4u32 {
        strength = 0.65f32;
    }
    if (trial.expedition.progress & 2u32) != 0u32 {
        var wave: f32 = clamp(
            (trial.expedition.relight as f32 - index as f32 * 160f32) / 360f32,
            0f32,
            1f32
        );
        if wave > strength {
            strength = wave;
        }
    }
    return strength;
}
fn expedition_lights(v: mut FrameInput, trial: read Trial) -> unit {
    expedition_light_layout(mut v);
    var i: u32 = 0u32;
    while i < 8u32 {
        var strength: f32 = expedition_light_strength(read trial, i);
        var channel: u32 = 0u32;
        while channel < 3u32 {
            var at: usize = (
                input_word(read v, LIGHT_DATA as usize) + i * 8u32 + 4u32 + channel
            ) as usize;
            var value: f32 = input_float(read v, at) * strength;
            input_set_float(mut v, at, value);
            channel = channel + 1u32;
        }
        i = i + 1u32;
    }
    var ambient: f32 = 0.035f32;
    if (trial.expedition.progress & 2u32) != 0u32 {
        ambient = ambient + 0.20f32 * clamp(
            trial.expedition.relight as f32 / 1800f32,
            0f32,
            1f32
        );
    }
    i = 0u32;
    while i < 3u32 {
        input_set_float(mut v, (SPACE_LIGHT + i) as usize, ambient);
        i = i + 1u32;
    }
    var lamp: f32 = 140f32 + 2.6f32 * trial.drone.charge;
    if trial.drone.charge < 20f32 && trial.tick % 24u32 < 5u32 {
        lamp = lamp * 0.65f32;
    }
    input_set_float(mut v, CAMERA_LIGHT as usize, lamp);
}
