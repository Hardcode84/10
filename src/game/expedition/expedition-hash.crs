fn expedition_hash(hash: u32, mission: Expedition) -> u32 {
    var h: u32 = hash_word(hash, mission.progress);
    h = hash_word(h, mission.return_link as u32);
    h = hash_word(h, mission.shortcut as u32);
    h = hash_word(h, mission.elapsed);
    h = hash_word(h, float_bits(mission.spent));
    h = hash_word(h, mission.docking);
    h = hash_word(h, mission.relight);
    h = hash_word(h, mission.rescues);
    h = hash_vec(h, mission.parked);
    return hash_word(h, mission.has_parked as u32);
}
