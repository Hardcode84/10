fn expedition_objectives(trial: mut Trial) -> unit {
    var target: u32 = mission_goal(trial.expedition);
    var distance: f32 = length(sub(trial.drone.position, station_position(target)));
    if distance < 6f32 && length(trial.drone.velocity) < 2f32 {
        trial.expedition.docking = trial.expedition.docking + 1u32;
    } else {
        trial.expedition.docking = 0u32;
    }
    if trial.expedition.docking < 180u32 {
        return;
    }
    trial.expedition.docking = 0u32;
    if target == 0u32 {
        trial.expedition.progress = trial.expedition.progress | 4u32;
        trial.finished = true;
    } else {
        if !station_lit(trial.expedition.progress, target) {
            trial.expedition.relight = 1u32;
        }
        trial.expedition.progress = trial.expedition.progress | (1u32 << (target - 1u32));
        trial.drone.charge = 100f32;
        trial.gate = 4u32;
        if target == 2u32 {
            trial.expedition.return_link = true;
            trial.gate = 7u32;
        }
    }
}
fn expedition_step(trial: mut Trial, command: Command) -> unit {
    if command.restart {
        restart_expedition(mut trial);
    }
    if command.assist {
        trial.auto_level = !trial.auto_level;
    }
    if command.preview {
        trial.preview_enabled = !trial.preview_enabled;
    }
    if trial.finished {
        return;
    }
    if command.burst || command.brake || command.tether || length(command.thrust) > 0f32 {
        trial.started = true;
    }
    recharge_expedition(mut trial);
    if trial.expedition.relight > 0u32 && trial.expedition.relight < 2400u32 {
        trial.expedition.relight = trial.expedition.relight + 1u32;
    }
    if !trial.started {
        orient(mut trial.drone, command.look, trial.auto_level);
        return;
    }
    var before: Vec3 = trial.drone.position;
    var spent: f32 = trial.drone.charge_spent;
    simulate(mut trial.drone, command, false, trial.auto_level);
    advance_preview_phase(mut trial, before);
    trial.tick = trial.tick + 1u32;
    trial.expedition.elapsed = trial.expedition.elapsed + 1u32;
    trial.expedition.spent = trial.expedition.spent + trial.drone.charge_spent - spent;
    expedition_objectives(mut trial);
    expedition_route(mut trial);
}
