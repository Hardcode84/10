const ACTION_COUNT: usize = 23usize;
record Binding {
    key: i32;
    mouse: u32;
    button: i32;
    axis: i32;
    direction: f32;
    toggle: bool;
}
record InputState {
    bindings: [Binding; 23];
    held: [bool; 23];
    latched: [bool; 23];
    values: [f32; 23];
    pulses: [u32; 23];
    axes_down: [bool; 23];
    pending: Command;
    mouse: Vec3;
    quit: bool;
    paused: bool;
}
fn input_new() -> InputState {
    var empty: Binding = make Binding {
        key: -1i32,
        mouse: 0u32,
        button: -1i32,
        axis: -1i32,
        direction: 1f32,
        toggle: false
    };
    var bindings: [Binding; 23] = make [Binding; 23] {
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty,
        empty
    };
    var held: [bool; 23] = make [bool; 23] {
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false
    };
    var latched: [bool; 23] = held;
    var values: [f32; 23] = make [f32; 23] {
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32,
        0f32
    };
    var pulses: [u32; 23] = make [u32; 23] {
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    };
    var result: InputState = make InputState {
        bindings: bindings,
        held: held,
        latched: latched,
        values: values,
        pulses: pulses,
        axes_down: held,
        pending: idle_command(),
        mouse: vec(0f32, 0f32, 0f32),
        quit: false,
        paused: false
    };
    var keys: [i32; 23] = make [i32; 23] {
        26i32,
        22i32,
        4i32,
        7i32,
        44i32,
        224i32,
        -1i32,
        9i32,
        -1i32,
        21i32,
        23i32,
        -1i32,
        -1i32,
        -1i32,
        -1i32,
        8i32,
        20i32,
        42i32,
        61i32,
        15i32,
        19i32,
        41i32,
        43i32
    };
    var i: usize = 0usize;
    while i < ACTION_COUNT {
        result.bindings[i] = make Binding {
            key: keys[i],
            mouse: 0u32,
            button: -1i32,
            axis: -1i32,
            direction: 1f32,
            toggle: false
        };
        result.held[i] = false;
        result.latched[i] = false;
        result.values[i] = 0f32;
        i = i + 1usize;
    }
    result.bindings[6usize].mouse = 4u32;
    result.bindings[8usize].mouse = 1u32;
    result.bindings[0usize].axis = 1i32;
    result.bindings[0usize].direction = -1f32;
    result.bindings[1usize].axis = 1i32;
    result.bindings[2usize].axis = 0i32;
    result.bindings[2usize].direction = -1f32;
    result.bindings[3usize].axis = 0i32;
    result.bindings[4usize].button = 10i32;
    result.bindings[5usize].button = 9i32;
    result.bindings[6usize].axis = 5i32;
    result.bindings[8usize].axis = 4i32;
    result.bindings[7usize].button = 0i32;
    result.bindings[11usize].axis = 2i32;
    result.bindings[12usize].axis = 2i32;
    result.bindings[12usize].direction = -1f32;
    result.bindings[13usize].axis = 3i32;
    result.bindings[14usize].axis = 3i32;
    result.bindings[14usize].direction = -1f32;
    result.bindings[15usize].button = 14i32;
    result.bindings[16usize].button = 13i32;
    result.bindings[17usize].button = 2i32;
    result.bindings[18usize].button = 3i32;
    result.bindings[19usize].button = 4i32;
    result.bindings[20usize].button = 1i32;
    result.bindings[22usize].button = 6i32;
    return result;
}
fn action_edge(input: read InputState, index: usize) -> bool {
    return input.pulses[index] != 0u32 || (
        input.values[index] > 0.5f32 && !input.held[index]
    );
}
fn input_commands(input: mut InputState, mouse_x: f32, mouse_y: f32) -> unit {
    input.pending.burst = input.pending.burst || action_edge(read input, 6usize);
    input.pending.brake = input.pending.brake || action_edge(read input, 7usize);
    input.pending.restart = input.pending.restart || action_edge(read input, 17usize);
    input.pending.spin = input.pending.spin || action_edge(read input, 18usize);
    input.pending.assist = input.pending.assist || action_edge(read input, 19usize);
    input.pending.preview = input.pending.preview || action_edge(read input, 20usize);
    input.quit = input.quit || action_edge(read input, 21usize);
    if action_edge(read input, 22usize) {
        input.paused = !input.paused;
    }
    input_latches(mut input);
    input.pending.thrust = vec(
        input.values[3usize] - input.values[2usize],
        input.values[4usize] - input.values[5usize],
        input.values[0usize] - input.values[1usize]
    );
    input.pending.tether = input.values[8usize] > 0.5f32;
    input.pending.reel = input.values[10usize] - input.values[9usize];
    if input.pending.tether {
        input.pending.reel = clamp(
            input.pending.reel - input.pending.thrust.y,
            -1f32,
            1f32
        );
        input.pending.thrust.y = 0f32;
    }
    input.mouse = add(input.mouse, vec(mouse_x * 0.0025f32, mouse_y * 0.0025f32, 0f32));
    input.pending.look = vec(
        (input.values[11usize] - input.values[12usize]) * 2f32,
        (input.values[13usize] - input.values[14usize]) * 2f32,
        (input.values[15usize] - input.values[16usize]) * 2f32
    );
}
fn input_consume(input: mut InputState) -> Command {
    var command: Command = input.pending;
    var mouse: Vec3 = input.mouse;
    var amount: f32 = length(mouse);
    if amount > 3.14159265f32 * STEP {
        mouse = scale(mouse, 3.14159265f32 * STEP / amount);
    }
    command.look = add(command.look, scale(mouse, 1f32 / STEP));
    input.mouse = sub(input.mouse, mouse);
    input.pending.burst = false;
    input.pending.brake = false;
    input.pending.restart = false;
    input.pending.spin = false;
    input.pending.assist = false;
    input.pending.preview = false;
    return command;
}

fn input_latches(input: mut InputState) -> unit {
    var i: usize = 0usize;
    while i < ACTION_COUNT {
        var down: bool = input.values[i] > 0.5f32;
        if input.pulses[i] % 2u32 != 0u32 || (
            input.pulses[i] == 0u32 && down && !input.held[i]
        ) {
            input.latched[i] = !input.latched[i];
        }
        input.held[i] = down;
        input.pulses[i] = 0u32;
        if input.bindings[i].toggle {
            input.values[i] = input.latched[i] as u32 as f32;
        }
        i = i + 1usize;
    }
}
