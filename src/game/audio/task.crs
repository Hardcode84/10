record SoundPayload {
    collision: CollisionScene;
    frame: GameSoundFrame;
    rooms: *ResidentBuild;
    distances: GenerationWords;
    waiting: u32;
    prepared: bool;
}
opaque;
resource SoundContext {
    schedule: TaskSchedule;
    slot: u32;
    payload: *SoundPayload;
}
opaque drop sound_context_drop;
resource SoundTask {
    context: mut SoundContext;
}
opaque drop sound_task_drop;
fn sound_context(pool: read TaskPool, collision: read CollisionScene) -> SoundContext {
    var payload: *SoundPayload = task_allocate(sizeof(SoundPayload)) as *SoundPayload;
    if payload == null(*SoundPayload) {
        task_error("sound preparation allocation failed");
    }
    if payload != null(*SoundPayload) {
        payload -> collision = collision_new();
        payload -> rooms = null(*ResidentBuild);
        payload -> distances = generation_words_new();
        payload -> waiting = TASK_NONE;
        payload -> prepared = false;
        if !collision_snapshot(read collision, mut payload -> collision) {
            drop payload -> collision;
            task_release(payload as *u8);
            payload = null(*SoundPayload);
        }
    }
    var schedule: TaskSchedule = schedule_new();
    if !schedule_on(mut schedule, read pool, 1u32) {
        if payload != null(*SoundPayload) {
            drop payload -> collision;
            drop payload -> distances;
            task_release(payload as *u8);
            payload = null(*SoundPayload);
        }
    }
    return make SoundContext {
        schedule: move schedule,
        slot: 0u32,
        payload: payload
    };
}
fn sound_context_ready(context: read SoundContext) -> bool {
    return context.payload != null(*SoundPayload);
}
fn sound_context_drop(context: mut SoundContext) -> unit {
    if context.payload != null(*SoundPayload) {
        drop context.payload -> collision;
        drop context.payload -> distances;
    }
    task_release(context.payload as *u8);
}
fn sound_execute(data: *u8) -> TaskStep {
    var payload: *SoundPayload = data as *SoundPayload;
    var dependency: u32 = sound_geometry(payload);
    if dependency != TASK_NONE {
        return task_await(dependency);
    }
    game_sound_prepare(read payload -> collision, mut payload -> frame);
    return task_done(true);
}
fn sound_start(
    context: mut SoundContext,
    collision: read CollisionScene,
    frame: GameSoundFrame
) -> SoundTask from context {
    collision_snapshot_motion(read collision, mut context.payload -> collision);
    context.payload -> frame = frame;
    context.payload -> prepared = false;
    context.payload -> waiting = TASK_NONE;
    schedule_reset(read context.schedule, context.slot);
    schedule_define(
        read context.schedule,
        context.slot,
        sound_execute,
        context.payload as *u8
    );
    schedule_request(read context.schedule, context.slot);
    schedule_poll(read context.schedule);
    return make SoundTask {
        context: mut context
    };
}
fn sound_task_drop(task: mut SoundTask) -> unit {
    while sound_task_poll(read task) == 0i32 {
        schedule_idle(read task.context.schedule);
    }
}
fn game_sound_join(
    graph: mut TaskGraph,
    task: mut SoundTask,
    control: mut GameControl,
    input: mut InputState
) -> unit {
    var status: i32 = sound_task_poll(read task);
    while status == 0i32 {
        schedule_idle(read task.context.schedule);
        if !game_poll(mut control, mut input) {
            task_cancel(mut graph);
        }
        status = sound_task_poll(read task);
    }
    var good: bool = status > 0i32;
    if good {
        good = game_sound_submit(mut control, read task.context.payload -> frame);
    }
    task_complete(mut graph, 5u32, good);
}

// Requires all readers of the context to have retired.
fn sound_context_residency(context: mut SoundContext, collision: read CollisionScene) -> unit {
    collision_snapshot_residency(read collision, mut context.payload -> collision);
}
fn sound_task_poll(task: read SoundTask) -> i32 {
    schedule_poll(read task.context.schedule);
    return schedule_status(read task.context.schedule, task.context.slot);
}
fn sound_game_streaming(context: mut SoundContext, session: read GameSession) -> bool {
    var state: read RoomResidency = read session.control.residency;
    if state.count == 0u32 {
        return true;
    }
    context.schedule = schedule_clone(read state.schedule);
    context.slot = state.count + 1u32;
    context.payload -> rooms = state.builds;
    return generation_words_allocate(mut context.payload -> distances, state.count);
}
fn sound_geometry(payload: *SoundPayload) -> u32 {
    if payload -> rooms == null(*ResidentBuild) {
        return TASK_NONE;
    }
    if payload -> waiting != TASK_NONE {
        collision_room_restore(
            mut payload -> collision,
            read payload -> rooms[payload -> waiting as usize].collision
        );
        payload -> waiting = TASK_NONE;
    }
    if !payload -> prepared {
        sound_geometry_set(payload);
        payload -> prepared = true;
    }
    var i: u32 = 0u32;
    while i < payload -> distances.count {
        if generation_word(read payload -> distances, i) != TASK_NONE && !collision_room_resident(
            read payload -> collision,
            i
        ) {
            payload -> waiting = i;
            return i;
        }
        i = i + 1u32;
    }
    return TASK_NONE;
}
fn sound_geometry_set(payload: *SoundPayload) -> unit {
    generation_words_fill(mut payload -> distances, TASK_NONE);
    var spatial: bool = false;
    var i: u32 = 0u32;
    while i < payload -> frame.batch.count {
        spatial = spatial || payload -> frame.spatial[i as usize];
        i = i + 1u32;
    }
    if !spatial {
        return;
    }
    generation_word_set(mut payload -> distances, payload -> frame.listener.space, 0u32);
    var depth: u32 = 0u32;
    var gain: f32 = 1f32;
    while gain >= ACOUSTIC_THRESHOLD {
        i = 0u32;
        while i < payload -> distances.count {
            if generation_word(read payload -> distances, i) == depth {
                var cursor: u32 = collision_portal_begin(read payload -> collision, i);
                while collision_portal_at_space(read payload -> collision, cursor, i) {
                    var portal: CollisionPortal = collision_portal(
                        read payload -> collision,
                        collision_portal_id(read payload -> collision, cursor)
                    );
                    if gain * ACOUSTIC_TRANSMISSION >= ACOUSTIC_THRESHOLD && generation_word(
                        read payload -> distances,
                        portal.destination
                    ) == TASK_NONE {
                        generation_word_set(
                            mut payload -> distances,
                            portal.destination,
                            depth + 1u32
                        );
                    }
                    cursor = cursor + 1u32;
                }
            }
            i = i + 1u32;
        }
        depth = depth + 1u32;
        gain = gain * ACOUSTIC_TRANSMISSION;
    }
}
