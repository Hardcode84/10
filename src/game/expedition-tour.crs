fn expedition_waypoint(index: u32) -> Vec3 {
    if index == 12u32 || index == 15u32 {
        return vec(0f32, 40f32, -30f32);
    }
    if index == 13u32 || index == 16u32 {
        return vec(0f32, 10f32, -30f32);
    }
    if index == 14u32 || index >= 17u32 {
        return station_position(0u32);
    }
    if index == 5u32 {
        return vec(150f32, 130f32, 155f32);
    }
    if index == 7u32 {
        return vec(115f32, 130f32, 250f32);
    }
    if index == 3u32 {
        return station_position(1u32);
    }
    if index == 6u32 {
        return station_position(2u32);
    }
    if index == 11u32 {
        return vec(-55f32, 65f32, 55f32);
    }
    return course_gate_center(index);
}
fn expedition_route(trial: mut Trial) -> unit {
    if trial.expedition.return_link && trial.expedition.relight < 2400u32 {
        return;
    }
    var last: u32 = 3u32;
    if mission_goal(trial.expedition) == 2u32 {
        last = 6u32;
    }
    if mission_goal(trial.expedition) == 0u32 {
        last = 14u32;
    }
    if expedition_drop_entry(read trial) {
        trial.gate = 15u32;
        trial.expedition.shortcut = true;
    }
    if trial.gate >= 15u32 {
        last = 17u32;
    }
    if trial.gate < last && length(
        sub(trial.drone.position, expedition_waypoint(trial.gate))
    ) < 8f32 {
        trial.gate = trial.gate + 1u32;
    }
}
fn expedition_drop_entry(trial: read Trial) -> bool {
    var p: Vec3 = trial.drone.position;
    return mission_goal(trial.expedition) == 0u32 && trial.gate == 7u32 && p.x < 118f32 && p.y > 120f32 && p.z > 200f32 && p.z < 215f32 && trial.drone.velocity.z < -1f32;
}
fn expedition_pilot(trial: read Trial, shortcut: bool) -> Command {
    if trial.expedition.return_link && trial.expedition.relight < 2400u32 {
        var hold: Command = steer_expedition(read trial, vec(115f32, 132f32, 220f32));
        var view: Command = steer_expedition(read trial, station_position(1u32));
        hold.look = view.look;
        hold.burst = false;
        return hold;
    }
    if shortcut && trial.gate == 5u32 && trial.drone.position.y < 100f32 {
        return expedition_hook_climb(read trial);
    }
    var target: Vec3 = expedition_waypoint(trial.gate);
    if shortcut && trial.gate == 7u32 {
        target = vec(110f32, 125f32, 200f32);
    }
    var goal: u32 = mission_goal(trial.expedition);
    var c: Command = steer_expedition(read trial, target);
    if length(sub(trial.drone.position, station_position(goal))) < 6f32 {
        c = steer_expedition(read trial, station_position(goal));
    }
    return c;
}
fn steer_expedition(trial: read Trial, target: Vec3) -> Command {
    var c: Command = idle_command();
    var delta: Vec3 = sub(target, trial.drone.position);
    var distance: f32 = length(delta);
    var direction: Vec3 = unit_vector(delta);
    var b: Basis = trial.drone.basis;
    var x: f32 = dot(direction, b.right);
    var y: f32 = dot(direction, b.up);
    var z: f32 = dot(direction, b.forward);
    c.look = vec(atan2f(x, z) * 8f32, -atan2f(y, sqrtf(x * x + z * z)) * 8f32, 0f32);
    var desired_speed: f32 = clamp(distance * 0.6f32, 0f32, 8f32);
    if distance > 25f32 {
        desired_speed = 15f32;
    }
    var correction: Vec3 = sub(scale(direction, desired_speed), trial.drone.velocity);
    c.thrust = vec(
        dot(correction, b.right),
        dot(correction, b.up),
        dot(correction, b.forward)
    );
    var speed: f32 = length(trial.drone.velocity);
    c.burst = distance > 25f32 && speed < 4f32 && z > 0.995f32;
    c.brake = speed > desired_speed + 2f32 || (
        speed > 2f32 && dot(unit_vector(trial.drone.velocity), direction) < 0.8f32
    );
    c.burst = c.burst && !c.brake;
    return c;
}

fn expedition_hook_climb(trial: read Trial) -> Command {
    var anchor: Vec3 = vec(150f32, 112f32, 181f32);
    var c: Command = steer_expedition(read trial, anchor);
    c.thrust = vec(0f32, 0f32, 0f32);
    c.burst = false;
    c.brake = false;
    var aligned: f32 = dot(
        unit_vector(sub(anchor, trial.drone.position)),
        trial.drone.basis.forward
    );
    c.tether = aligned > 0.995f32 || trial.drone.cable.phase != CABLE_READY;
    c.reel = c.tether;
    return c;
}
