fn game_renderer_open(v: *RenderState, o: *Launch, window: *u8, portals: u32) -> bool {
    var depth: u32 = 0u32;
    if portals != 0u32 {
        depth = 6u32;
    }
    var c: RenderConfig = make RenderConfig {
        width: o -> config.width,
        height: o -> config.height,
        output_width: o -> config.width,
        output_height: o -> config.height,
        shader_checks: o -> shader_checks,
        read_pixels: o -> capture != null(*u8),
        debug_pixels: 0u32,
        view_budget: 129u32,
        portal_budget: portals,
        task_budget: ((o -> config.width + 7u32) / 8u32) * (
            (o -> config.height + 7u32) / 8u32
        ),
        crossing_limit: depth,
        fault: 0u32
    };
    if window != null(*u8) {
        var width: i32 = 0i32;
        var height: i32 = 0i32;
        window_extent(window, &width, &height);
        if width <= 0i32 || height <= 0i32 {
            return error("window drawable extent must be positive");
        }
        c.output_width = width as u32;
        c.output_height = height as u32;
    }
    v -> frame_trace = o -> latency_path != null(*u8);
    return app_renderer_open(v, window, &c);
}
fn game_draw(session: mut GameSession) -> bool {
    return window_draw(&session.renderer.state, session.control.window.handle);
}
fn game_present(session: mut GameSession) -> bool {
    if session.control.launch.config.headless {
        game_trace_output(mut session);
        return true;
    }
    var ready: bool = session.renderer.state.present_ready;
    if !present(&session.renderer.state) {
        return false;
    }
    session.renderer.state.frame_released_ns = render_trace_clock(&session.renderer.state);
    game_trace_output(mut session);
    if ready && !session.renderer.state.swapchain_dirty {
        frame_rate_sample(mut session.frame_rate, now());
    } else {
        session.frame_rate = frame_rate_new();
    }
    return true;
}

fn game_surface(session: mut GameSession) -> i32 {
    return window_prepare(&session.renderer.state, session.control.window.handle);
}

fn game_presented(session: mut GameSession) -> unit {
    game_trace_output(mut session);
    if !session.control.launch.config.headless {
        if session.renderer.state.swapchain_dirty {
            session.frame_rate = frame_rate_new();
        } else {
            frame_rate_sample(mut session.frame_rate, now());
        }
    }
}

fn game_task_mode(workers: u32) -> unit {
    if workers == 0u32 {
        puts("Task execution: application thread with asynchronous GPU services (experiment)");
    } else {
        puts("Task execution: worker prediction with asynchronous GPU services (experiment)");
    }
}
