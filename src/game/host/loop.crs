record GameLoop {
    sparks: Sparks;
    trial: Trial;
    input: InputState;
    ticks: u32;
    credit: u64;
    running: bool;
}
fn game_tick(
    collision: mut CollisionScene,
    session: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig
) -> bool {
    var command: Command = input_consume(mut loop.input);
    command = movement_command(command, config.movement_mode);
    var status: i32 = game_command(mut session, mut command);
    if status < 0i32 {
        return false;
    }
    if status == 0i32 {
        loop.running = false;
        return true;
    }
    var reset: bool = command.restart || command.spin;
    if !reset {
        doors_step(mut collision, game_doors_mut(mut session), mut loop.trial);
    }
    var finished: bool = loop.trial.finished;
    var attempt: u32 = loop.trial.attempt;
    var clock: u32 = loop.trial.drone.clock;
    if !game_residency_trial(mut collision, mut session, mut loop, command) {
        if loop.input.quit {
            loop.running = false;
            return true;
        }
        return false;
    }
    if !game_tick_effects(mut collision, mut session, mut loop, config, attempt, clock) {
        loop.running = !loop.input.quit;
        return loop.input.quit;
    }
    game_trace_tick(mut session, loop.ticks + 1u32, command);
    game_graph_visit(mut session, read loop.trial, reset);
    if loop.trial.finished && !finished {
        game_completion(loop.trial.tick);
    }
    loop.ticks = loop.ticks + 1u32;
    if config.ticks != 0u32 && loop.ticks >= config.ticks {
        loop.running = false;
    }
    var hash: u32 = doors_hash(
        read collision,
        graph_doors(game_graph(read session)),
        trial_hash(read loop.trial)
    );
    return game_record(mut session, command, hash);
}
fn game_render(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> bool {
    var prediction: Prediction = predict_paths(
        read collision,
        read loop.trial,
        mut session.forecast
    );
    prediction = prediction_visible(prediction, read loop.trial);
    game_prepare(read collision, mut session, read loop, config, read prediction);
    return game_draw(mut session) && game_present(mut session);
}
fn game_prepare(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    prediction: read Prediction
) -> unit {
    game_prepare_begin(read collision, mut session, read loop, config);
    game_prepare_finish(read collision, mut session, read loop, config, read prediction);
}
fn game_prepare_begin(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> unit {
    game_trace_snapshot(mut session, loop.ticks);
    var inputs: FrameInput = renderer_inputs(mut session.renderer);
    game_scene_begin(
        read collision,
        mut inputs,
        read loop.trial,
        config,
        mut session.view_anchors
    );
    game_fixture_lighting(
        read collision,
        graph_lights(game_graph(read session.control)),
        mut inputs,
        mut session.view_anchors
    );
    draw_sparks(read collision, mut inputs, read loop.sparks, mut session.view_anchors);
}
fn game_prepare_finish(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    prediction: read Prediction
) -> unit {
    game_scene_finish(read collision, mut session, read loop.trial, config, read prediction);
    var fps: u32 = game_fps(read session);
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        game_residency_portals(read session.control, mut inputs);
        game_hud(mut inputs, read loop.trial, loop.input.paused);
        if !config.headless {
            hud_fps(mut inputs, fps, loop.input.paused);
        }
        input_set_word(mut inputs, OVERLAY_SCALE as usize, 1u32);
    }
}
fn game_advance(
    collision: mut CollisionScene,
    session: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    elapsed: u64
) -> bool {
    elapsed = game_residency_elapsed(mut session, elapsed);
    if !game_poll(mut session, mut loop.input) {
        return false;
    }
    if loop.input.quit {
        loop.running = false;
        return true;
    }
    if config.headless {
        return game_tick(mut collision, mut session, mut loop, config);
    }
    if elapsed > 1000000000u64 {
        loop.input.paused = true;
        game_clock_stall();
    }
    if loop.input.paused {
        loop.input.pending = idle_command();
        loop.input.mouse = vec(0f32, 0f32, 0f32);
        loop.credit = 0u64;
        return true;
    }
    var rate: u64 = game_tick_rate(config) as u64;
    loop.credit = loop.credit + elapsed * rate;
    while loop.credit >= 1000000000u64 && loop.running {
        if !game_tick(mut collision, mut session, mut loop, config) {
            return false;
        }
        loop.credit = loop.credit - 1000000000u64;
    }
    return true;
}
fn game_run(session: GameSession, config: GameConfig) -> i32 {
    game_residency_enable(mut session);
    var collision: CollisionScene = collision_new();

    var loop: GameLoop = make GameLoop {
        sparks: sparks_new(),
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    var result: i32 = 1i32;
    if game_run_setup(mut session, mut collision, mut loop, config) {
        result = game_run_ready(mut collision, mut session, mut loop, config);
    }
    game_session_shutdown(mut session);
    return result;
}
fn game_run_ready(
    collision: mut CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    if !config.headless && !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    return game_run_active(mut collision, mut session, mut loop, config);
}
fn game_run_active(
    collision: mut CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    return game_run_tasks(mut collision, mut session, mut loop, config);
}

fn game_materials_open(session: mut GameSession, config: GameConfig) -> bool {
    var selection: GenerationWords = generation_words_new();
    if !game_material_selection(read session, mut selection) {
        return false;
    }
    var renderer: mut Renderer = game_renderer(mut session);
    var inputs: FrameInput = renderer_inputs(mut renderer);
    if !game_world_palette(mut inputs, read selection) {
        return false;
    }
    var ambient: Vec3 = game_world_ambient();
    input_set_float(mut inputs, SPACE_LIGHT as usize, ambient.x);
    input_set_float(mut inputs, (SPACE_LIGHT + 1u32) as usize, ambient.y);
    input_set_float(mut inputs, (SPACE_LIGHT + 2u32) as usize, ambient.z);
    hud_font(mut inputs);
    return true;
}

fn game_run_setup(
    session: mut GameSession,
    collision: mut CollisionScene,
    loop: mut GameLoop,
    config: GameConfig
) -> bool {
    if !game_world_open(mut session, mut collision, mut loop.trial) {
        return false;
    }
    if !game_open(mut session, mut loop.input) {
        return false;
    }
    loop.trial.full_spin = game_initial_spin(read session);
    loop.trial.drone.wall_anchor.mode = game_initial_movement_mode(read session);
    loop.trial.spawn.wall_anchor.mode = loop.trial.drone.wall_anchor.mode;
    if !game_collision_spawn(read collision, read loop.trial) {
        return false;
    }
    if !game_materials_open(mut session, config) {
        return false;
    }
    var spawn_world: u32 = loop.trial.drone.world;
    if !game_residency_open(mut session, mut collision, spawn_world) || !game_static_open(
        mut session,
        spawn_world
    ) {
        return false;
    }
    return true;
}

fn game_tick_effects(
    collision: mut CollisionScene,
    session: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    attempt: u32,
    clock: u32
) -> bool {
    if loop.trial.attempt != attempt {
        sparks_clear(mut loop.sparks);
        collision_controlled_reset(mut collision);
        doors_reset(game_doors_mut(mut session));
    }
    var advanced: bool = loop.trial.drone.clock != clock || loop.trial.attempt != attempt;
    if loop.trial.drone.clock != 0u32 && advanced {
        var spark_time: f32 = (loop.trial.drone.clock - 1u32) as f32 * STEP;
        if !game_residency_sparks(mut collision, mut session, mut loop, spark_time) {
            return false;
        }
        sparks_impact(mut loop.sparks, loop.trial.drone.hook_contact);
        sparks_contact(
            mut loop.sparks,
            loop.trial.drone.contact,
            flight_scrape(read collision, read loop.trial.drone)
        );
    }
    if advanced {
        if !game_sound_tick(mut session, read loop.trial, loop.ticks + 1u32, config) {
            return false;
        }
    }
    return true;
}
