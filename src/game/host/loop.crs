record GameLoop {
    sparks: Sparks;
    trial: Trial;
    input: InputState;
    ticks: u32;
    credit: u64;
    running: bool;
}
fn game_tick(
    collision: read CollisionScene,
    session: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig
) -> bool {
    var command: Command = input_consume(mut loop.input);
    var status: i32 = game_command(mut session, mut command);
    if status < 0i32 {
        return false;
    }
    if status == 0i32 {
        loop.running = false;
        return true;
    }
    var finished: bool = loop.trial.finished;
    var attempt: u32 = loop.trial.attempt;
    var clock: u32 = loop.trial.drone.clock;
    trial_step(read collision, mut loop.trial, command);
    if loop.trial.attempt != attempt {
        sparks_clear(mut loop.sparks);
    }
    if loop.trial.drone.clock != 0u32 && (
        loop.trial.drone.clock != clock || loop.trial.attempt != attempt
    ) {
        sparks_step(
            read collision,
            mut loop.sparks,
            loop.trial.full_spin,
            (loop.trial.drone.clock - 1u32) as f32 * STEP
        );
        sparks_impact(mut loop.sparks, loop.trial.drone.hook_contact);
        sparks_contact(
            mut loop.sparks,
            loop.trial.drone.contact,
            flight_scrape(read collision, read loop.trial.drone)
        );
    }
    game_trace_tick(mut session, loop.ticks + 1u32, command);
    game_graph_visit(mut session, read loop.trial, command.restart || command.spin);
    if loop.trial.finished && !finished {
        game_completion(loop.trial.tick);
    }
    loop.ticks = loop.ticks + 1u32;
    if config.ticks != 0u32 && loop.ticks >= config.ticks {
        loop.running = false;
    }
    return game_record(mut session, command, trial_hash(read loop.trial));
}
fn game_render(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> bool {
    var prediction: Prediction = predict_paths(read collision, read loop.trial);
    game_prepare(read collision, mut session, read loop, config, read prediction);
    return game_draw(mut session) && game_present(mut session);
}
fn game_prepare(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    prediction: read Prediction
) -> unit {
    game_prepare_begin(read collision, mut session, read loop, config);
    game_prepare_finish(read collision, mut session, read loop, config, read prediction);
}
fn game_prepare_begin(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig
) -> unit {
    game_trace_snapshot(mut session, loop.ticks);
    var inputs: FrameInput = renderer_inputs(mut session.renderer);
    game_scene_begin(read collision, mut inputs, read loop.trial, config);
    draw_sparks(read collision, mut inputs, read loop.sparks);
}
fn game_prepare_finish(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: read GameLoop,
    config: GameConfig,
    prediction: read Prediction
) -> unit {
    game_scene_finish(read collision, mut session, read loop.trial, config, read prediction);
    var fps: u32 = game_fps(read session);
    {
        var renderer: mut Renderer = game_renderer(mut session);
        var inputs: FrameInput = renderer_inputs(mut renderer);
        game_hud(mut inputs, read loop.trial, loop.input.paused);
        if !config.headless {
            hud_fps(mut inputs, fps, loop.input.paused);
        }
        input_set_word(mut inputs, OVERLAY_SCALE as usize, 1u32);
    }
}
fn game_advance(
    collision: read CollisionScene,
    session: mut GameControl,
    loop: mut GameLoop,
    config: GameConfig,
    elapsed: u64
) -> bool {
    if !game_poll(mut session, mut loop.input) {
        return false;
    }
    if loop.input.quit {
        loop.running = false;
        return true;
    }
    if config.headless {
        return game_tick(read collision, mut session, mut loop, config);
    }
    if elapsed > 1000000000u64 {
        loop.input.paused = true;
        game_clock_stall();
    }
    if loop.input.paused {
        loop.input.pending = idle_command();
        loop.input.mouse = vec(0f32, 0f32, 0f32);
        loop.credit = 0u64;
        return true;
    }
    var rate: u64 = 120u64;
    if config.slow {
        rate = 84u64;
    }
    loop.credit = loop.credit + elapsed * rate;
    while loop.credit >= 1000000000u64 && loop.running {
        if !game_tick(read collision, mut session, mut loop, config) {
            return false;
        }
        loop.credit = loop.credit - 1000000000u64;
    }
    return true;
}
fn game_run(session: GameSession, config: GameConfig) -> i32 {
    var collision: CollisionScene = collision_new();

    var loop: GameLoop = make GameLoop {
        sparks: sparks_new(),
        trial: new_trial(),
        input: input_new(),
        ticks: 0u32,
        credit: 0u64,
        running: true
    };
    if !game_run_setup(mut session, mut collision, mut loop, config) {
        return 1i32;
    }
    return game_run_ready(read collision, mut session, mut loop, config);
}
fn game_run_ready(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    if !config.headless && !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    return game_run_active(read collision, mut session, mut loop, config);
}
fn game_run_active(
    collision: read CollisionScene,
    session: mut GameSession,
    loop: mut GameLoop,
    config: GameConfig
) -> i32 {
    if config.tasks {
        return game_run_tasks(read collision, mut session, mut loop, config);
    }
    var previous: u64 = now();
    while loop.running {
        var current: u64 = now();
        var elapsed: u64 = current - previous;
        previous = current;
        if !game_advance(read collision, mut session.control, mut loop, config, elapsed) {
            return 1i32;
        }
        if !config.headless && !game_render(read collision, mut session, read loop, config) {
            return 1i32;
        }
        if !config.headless {
            game_wait();
        }
    }
    if config.headless && !game_render(read collision, mut session, read loop, config) {
        return 1i32;
    }
    game_summary(read loop.trial);
    return (!game_finish(mut session)) as i32;
}

fn game_materials_open(session: mut GameSession, config: GameConfig) -> bool {
    var renderer: mut Renderer = game_renderer(mut session);
    var inputs: FrameInput = renderer_inputs(mut renderer);
    if !game_room_palette(mut inputs) {
        return false;
    }
    var ambient: Vec3 = game_world_ambient();
    input_set_float(mut inputs, SPACE_LIGHT as usize, ambient.x);
    input_set_float(mut inputs, (SPACE_LIGHT + 1u32) as usize, ambient.y);
    input_set_float(mut inputs, (SPACE_LIGHT + 2u32) as usize, ambient.z);
    hud_font(mut inputs);
    return true;
}

fn game_run_setup(
    session: mut GameSession,
    collision: mut CollisionScene,
    loop: mut GameLoop,
    config: GameConfig
) -> bool {
    if !game_world_open(mut session, mut collision, mut loop.trial) {
        return false;
    }
    if !game_open(mut session, mut loop.input) {
        return false;
    }
    loop.trial.full_spin = game_initial_spin(read session);
    if !game_collision_spawn(read collision, read loop.trial) {
        return false;
    }
    if !game_materials_open(mut session, config) {
        return false;
    }
    if !game_static_open(mut session, loop.trial.drone.world) {
        return false;
    }
    return true;
}
