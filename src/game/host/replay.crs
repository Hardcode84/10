fn hash_word(hash: u32, value: u32) -> u32 {
    return (hash ^ value) * 16777619u32;
}
fn hash_vec(hash: u32, v: Vec3) -> u32 {
    return hash_word(
        hash_word(hash_word(hash, float_bits(v.x)), float_bits(v.y)),
        float_bits(v.z)
    );
}
fn trial_hash(trial: read Trial) -> u32 {
    var d: read Drone = read trial.drone;
    var hash: u32 = hash_vec(2166136261u32, d.position);
    hash = hash_ratio(hash, read d.size);
    hash = hash_ratio(hash, read d.cable.size);
    hash = hash_word(hash, portal_path_count(read d.cable.path));
    var path_index: u32 = 0u32;
    while path_index < portal_path_count(read d.cable.path) {
        hash = hash_word(hash, portal_path_at(read d.cable.path, path_index));
        path_index = path_index + 1u32;
    }
    hash = hash_word(hash, d.world);
    hash = hash_word(hash, d.clock);
    hash = hash_word(hash, float_bits(d.machine_work));
    hash = hash_word(hash, float_bits(d.cable_loss));
    hash = hash_word(hash, float_bits(d.contact_work));
    hash = hash_word(hash, d.cable.space);
    hash = hash_vec(hash, d.cable.frame.origin);
    hash = hash_vec(hash, d.cable.frame.basis.right);
    hash = hash_vec(hash, d.cable.frame.basis.up);
    hash = hash_vec(hash, d.cable.frame.basis.forward);
    hash = hash_word(hash, d.cable.instance);
    hash = hash_word(hash, d.cable.surface);
    hash = hash_vec(hash, d.cable.local_point);
    hash = hash_vec(hash, d.cable.local_normal);
    hash = hash_vec(hash, d.velocity);
    hash = hash_vec(hash, d.basis.right);
    hash = hash_vec(hash, d.basis.up);
    hash = hash_vec(hash, d.basis.forward);
    hash = hash_vec(hash, d.cable.anchor);
    hash = hash_vec(hash, d.cable.velocity);
    hash = hash_word(hash, float_bits(d.cable.extent));
    hash = hash_word(hash, float_bits(d.cable.reel_speed));
    hash = hash_word(hash, d.cable.reeling as u32);
    hash = hash_word(hash, d.cable.phase);
    hash = wall_anchor_hash(hash, d.wall_anchor);
    hash = hash_word(hash, d.bursts);
    hash = hash_word(hash, d.boost_ticks);
    hash = hash_vec(hash, d.boost_direction);
    hash = hash_word(hash, d.pulse_cooldown);
    hash = hash_word(hash, trial.graph_run as u32);
    hash = hash_word(hash, trial.goal_world);
    hash = hash_word(hash, trial.returning as u32);
    hash = hash_word(hash, d.brake_ticks);
    hash = hash_word(hash, float_bits(d.brake_rate));
    hash = hash_word(hash, float_bits(d.brake_speed));
    hash = hash_word(hash, float_bits(d.winch_work));
    hash = hash_word(hash, float_bits(trial.preview_phase));
    hash = hash_word(hash, trial.tick);
    hash = hash_word(hash, trial.attempt);
    hash = hash_word(hash, trial.finished as u32);
    hash = hash_word(hash, trial.started as u32);
    hash = hash_word(hash, trial.full_spin as u32);
    hash = hash_word(hash, trial.auto_level as u32);
    return hash_word(hash, trial.preview_enabled as u32);
}
fn command_flags(c: Command) -> u32 {
    return c.burst as u32 | ((c.brake as u32) << 1u32) | ((c.tether as u32) << 2u32) | (
        (c.restart as u32) << 3u32
    ) | ((c.spin as u32) << 4u32) | ((c.assist as u32) << 5u32) | ((c.preview as u32) << 6u32) | (
        (c.anchor as u32) << 7u32
    );
}

fn hash_ratio(hash: u32, ratio: read Rational) -> u32 {
    var part: u32 = 0u32;
    while part < 2u32 {
        var count: usize = rational_word_count(read ratio, part == 0u32);
        hash = hash_word(hash, count as u32);
        hash = hash_word(hash, (count as u64 >> 32u64) as u32);
        var i: usize = 0usize;
        while i < count {
            hash = hash_word(hash, rational_word(read ratio, part == 0u32, i));
            i = i + 1usize;
        }
        part = part + 1u32;
    }
    return hash;
}

fn wall_anchor_hash(hash: u32, anchor: WallAnchor) -> u32 {
    var h: u32 = hash_word(hash, anchor.mode);
    h = hash_word(h, anchor.instance);
    h = hash_vec(h, anchor.local_position);
    h = hash_word(h, anchor.held as u32);
    h = hash_word(h, anchor.active as u32);
    h = hash_word(h, anchor.recovering as u32);
    h = hash_word(h, anchor.charge);
    h = hash_vec(h, anchor.normal);
    h = hash_vec(h, anchor.up);
    return hash_word(h, float_bits(anchor.distance));
}
