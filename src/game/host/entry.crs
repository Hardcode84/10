fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && strcmp(argv[1usize], "--help") == 0i32 {
        puts("SPINWARD | There and Back");
        puts("--fullscreen: borderless desktop window; width/height set render resolution");
        puts("--tasks: same-frame CPU/GPU overlap (default); --serial: synchronous loop");
        puts("--workers N: prediction workers (default 0; browser requires 0)");
        puts("--width N --height N --fov 70..110 --slow --bindings FILE");
        puts("--seed N --complexity N (defaults: seed 1, complexity 3)");
        puts("--record FILE | --replay FILE (use the same seed and complexity)");
        puts(
            "--latency-log FILE: record input, simulation, submission and presentation timestamps"
        );
        puts("--headless --ticks N --capture FILE --full-spin");
        puts("Find the gold beacon in the ending room, then return to the start beacon.");
        puts("Boost and brake share a 3-second cooldown. Both have unlimited uses.");
        puts("WASD Ctrl/Space: move | mouse: look | Q/E: roll with level off");
        puts("RMB: burst | F: brake | LMB: hold tether | R or Space: start fast reel");
        puts("Backspace: recover / retry | F4: spin mode | L: level | P: preview");
        puts("Tab: pause | Esc: exit. Focus loss pauses; Tab resumes.");
        puts(
            "Pad: sticks move/look, shoulders vertical, RB starts reel with tether, RT burst, LT tether"
        );
        puts("Pad A brake, X retry, Y spin, Back level, B preview, Start pause");
        return 0i32;
    }
    var o: Launch = uninit;
    if !game_options(argc, argv, &o) {
        return 2i32;
    }
    return game_run(game_session(&o), o.config);
}
