record GameConfig {
    room_memory: u32;
    seed: u32;
    complexity: u32;
    room_demo: bool;
    scaling: bool;
    anchor_controls: bool;
    workers: u32;
    width: u32;
    height: u32;
    fov: f32;
    ticks: u32;
    headless: bool;
    fullscreen: bool;
    full_spin: bool;
    slow: bool;
}
record Launch {
    config: GameConfig;
    capture: *u8;
    shader_checks: bool;
    mute: bool;
    audio_stats: bool;
    sound_gain: f32;
    record_path: *u8;
    replay_path: *u8;
    bindings_path: *u8;
    latency_path: *u8;
}
opaque;
extern fn strcmp(a: *u8, b: *u8) -> i32 = "strcmp";
fn game_number(text: *u8, result: *u32) -> bool {
    var i: usize = 0usize;
    var n: u32 = 0u32;
    while text[i] != 0u8 {
        if text[i] < 48u8 || text[i] > 57u8 {
            return error("invalid numeric option");
        }
        if n > (0xffffffffu32 - (text[i] - 48u8) as u32) / 10u32 {
            return error("numeric option exceeds u32");
        }
        n = n * 10u32 + (text[i] - 48u8) as u32;
        i = i + 1usize;
    }
    * result = n;
    return i > 0usize;
}
fn game_value(o: *Launch, key: *u8, value: *u8) -> bool {
    if strcmp(key, "--room-memory") == 0i32 {
        if !game_number(value, &o -> config.room_memory) {
            return false;
        }
        return o -> config.room_memory >= 3u32 || error("room memory must be at least 3 MiB");
    }
    if strcmp(key, "--volume") == 0i32 {
        var gain: u32 = 0u32;
        if !game_number(value, &gain) || gain > 100u32 {
            return error("volume must be 0 through 100");
        }
        o -> sound_gain = gain as f32 / 100f32;
        return true;
    }
    if strcmp(key, "--latency-log") == 0i32 {
        o -> latency_path = value;
        return true;
    }
    if strcmp(key, "--capture") == 0i32 {
        o -> capture = value;
        o -> config.headless = true;
        return true;
    }
    if strcmp(key, "--record") == 0i32 {
        o -> record_path = value;
        return true;
    }
    if strcmp(key, "--replay") == 0i32 {
        o -> replay_path = value;
        return true;
    }
    if strcmp(key, "--bindings") == 0i32 {
        o -> bindings_path = value;
        return true;
    }
    return game_numeric(o, key, value);
}
fn game_numeric(o: *Launch, key: *u8, value: *u8) -> bool {
    var n: u32 = 0u32;
    if !game_number(value, &n) {
        return false;
    }
    if strcmp(key, "--workers") == 0i32 {
        o -> config.workers = n;
        if n == 0u32 {
            o -> config.workers = game_default_workers();
        }
        return true;
    }
    if strcmp(key, "--seed") == 0i32 {
        o -> config.seed = n;
        return true;
    }
    if strcmp(key, "--complexity") == 0i32 {
        if n == 0u32 || n > (0xffffffffu32 - 2048u32) / 384u32 {
            return error("complexity is outside the graph address range");
        }
        o -> config.complexity = n;
        return true;
    }
    if strcmp(key, "--debug-shaders") == 0i32 {
        if n > 1u32 {
            return error("--debug-shaders must be zero or one");
        }
        o -> shader_checks = n != 0u32;
        return true;
    }
    if strcmp(key, "--width") == 0i32 {
        o -> config.width = n;
        return true;
    }
    if strcmp(key, "--height") == 0i32 {
        o -> config.height = n;
        return true;
    }
    if strcmp(key, "--fov") == 0i32 {
        o -> config.fov = n as f32;
        return true;
    }
    if strcmp(key, "--ticks") == 0i32 {
        o -> config.ticks = n;
        return true;
    }
    return error("unknown option; use --help");
}
fn game_flag(o: *Launch, key: *u8) -> bool {
    if strcmp(key, "--anchor-controls") == 0i32 {
        o -> config.anchor_controls = true;
        return true;
    }
    if strcmp(key, "--audio-stats") == 0i32 {
        o -> audio_stats = true;
        return true;
    }
    if strcmp(key, "--mute") == 0i32 {
        o -> mute = true;
        return true;
    }
    if strcmp(key, "--scaling") == 0i32 {
        o -> config.scaling = true;
        return true;
    }
    if strcmp(key, "--fullscreen") == 0i32 {
        o -> config.fullscreen = true;
        return true;
    }
    if strcmp(key, "--full-spin") == 0i32 {
        o -> config.full_spin = true;
        return true;
    }
    if strcmp(key, "--headless") == 0i32 {
        o -> config.headless = true;
        return true;
    }
    if strcmp(key, "--slow") == 0i32 {
        o -> config.slow = true;
        return true;
    }
    return false;
}
fn game_options(argc: i32, argv: **u8, o: *Launch) -> bool {
    return game_options_scene(argc, argv, o, false);
}
fn game_options_scene(argc: i32, argv: **u8, o: *Launch, room_demo: bool) -> bool {
    *o = make Launch {
        config: make GameConfig {
            room_memory: (RESIDENT_GPU_BYTES / 1048576u64) as u32,
            seed: 1u32,
            complexity: 3u32,
            room_demo: room_demo,
            scaling: false,
            anchor_controls: false,
            workers: game_default_workers(),
            width: 960u32,
            height: 540u32,
            fov: 90f32,
            ticks: 0u32,
            headless: false,
            fullscreen: false,
            full_spin: false,
            slow: false,
        },
        capture: null(*u8),
        shader_checks: false,
        mute: false,
        audio_stats: false,
        sound_gain: 1f32,
        record_path: null(*u8),
        replay_path: null(*u8),
        bindings_path: null(*u8),
        latency_path: null(*u8),
    };
    var i: usize = 1usize;
    while i < argc as usize {
        if game_flag(o, argv[i]) {
            i = i + 1usize;
            continue;
        }
        if i + 1usize >= argc as usize {
            return error("option needs a value");
        }
        if !game_value(o, argv[i], argv[i + 1usize]) {
            return false;
        }
        i = i + 2usize;
    }
    return game_options_valid(o);
}
fn game_options_valid(o: *Launch) -> bool {
    if o -> config.scaling && o -> config.room_demo {
        return error("--scaling is a main game scene");
    }
    if o -> config.width < 320u32 || o -> config.height < 180u32 || !image_extent_valid(
        o -> config.width,
        o -> config.height,
        o -> config.width,
        o -> config.height
    ) {
        return error(
            "image dimensions must be at least 320x180 and fit the renderer address range"
        );
    }
    if o -> config.fov < 70f32 || o -> config.fov > 110f32 {
        return error("FOV must be 70 through 110 degrees");
    }
    if o -> record_path != null(*u8) && o -> replay_path != null(*u8) {
        return error("record and replay are mutually exclusive");
    }
    return game_input_options(o);
}
fn game_input_options(o: *Launch) -> bool {
    if o -> config.fullscreen && o -> config.headless {
        return error("--fullscreen requires a window; omit --headless and --capture");
    }
    if o -> config.full_spin && o -> replay_path != null(*u8) {
        return error("replay restores the recorded spin mode; omit --full-spin");
    }
    if o -> config.headless && o -> config.ticks == 0u32 && o -> replay_path == null(*u8) {
        o -> config.ticks = 1u32;
    }
    return true;
}

fn game_tick_rate(config: GameConfig) -> u32 {
    var rate: u32 = (1f32 / STEP + 0.5f32) as u32;
    if config.slow {
        return rate * 7u32 / 10u32;
    }
    return rate;
}
