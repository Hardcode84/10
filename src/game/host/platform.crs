resource GameWindow {
    handle: *u8;
    controller: *u8;
    focused: bool;
    input_ready: bool;
    audio: AudioSession;
}
opaque drop game_window_drop;
record GameControl {
    window: GameWindow;
    residency: RoomResidency;
    graph: RoomGraph;
    launch: Launch;
    stream: Recording;
    latency: LatencyLog;
    sound: GameSound;
}
opaque;
resource GameSession {
    platform: ApplicationPlatform;
    forecast: Drone;
    view_anchors: RoomAnchors;
    control: GameControl;
    frame_rate: FrameRate;
    room: RoomAsset;
    room_mesh: Mesh;
    drone_mesh: MeshRange;
    fixture_mesh: Mesh;
    renderer: Renderer;
    world: InstanceList;
}
drop game_session_drop;
fn game_session_drop(session: mut GameSession) -> unit {
    game_session_shutdown(mut session);
}
fn game_session_shutdown(session: mut GameSession) -> unit {
    renderer_shutdown(mut session.renderer);
    residency_shutdown(mut session.control.residency);
}
fn game_window_drop(window: mut GameWindow) -> unit {
    audio_close(mut window.audio);
    if window.controller != null(*u8) {
        app_pad_close(window.controller);
    }
    if window.input_ready {
        app_input_close();
    }
    window_close(window.handle);
}
fn game_session(o: *Launch) -> GameSession {
    var renderer: Renderer = renderer_new();
    return make GameSession {
        platform: application_platform(),
        forecast: new_drone(),
        view_anchors: room_anchors_new(),
        control: make GameControl {
            residency: residency_new(),
            graph: graph_new(),
            window: make GameWindow {
                handle: null(*u8),
                controller: null(*u8),
                focused: false,
                input_ready: false,
                audio: audio_new()
            },
            launch: *o,
            stream: recording_new(),
            latency: latency_new(),
            sound: game_sound_new()
        },
        frame_rate: frame_rate_new(),
        room: room_asset_new(),
        room_mesh: mesh_new(),
        drone_mesh: mesh_empty_range(),
        fixture_mesh: mesh_new(),
        renderer: move renderer,
        world: instances_new()
    };
}
fn game_material_selection(session: read GameSession, selection: mut GenerationWords) -> bool {
    return game_world_material_selection(mut selection, read session.control.graph);
}
fn game_renderer(session: mut GameSession) -> mut Renderer from session.renderer {
    return mut session.renderer;
}
fn game_open(session: mut GameSession, input: mut InputState) -> bool {
    if !latency_open(&session.control.latency, session.control.launch.latency_path) {
        return false;
    }
    var o: *Launch = &session.control.launch;
    if !bindings_load(o -> bindings_path, &input) || !recording_open(
        &session.control.stream,
        o
    ) {
        return false;
    }
    if !o -> config.headless {
        if !window_open(
            &session.control.window.handle,
            o -> config.width,
            o -> config.height
        ) {
            return false;
        }
        if o -> config.fullscreen && !window_fullscreen(session.control.window.handle) {
            return false;
        }
        session.control.window.input_ready = app_input_open();
        if !session.control.window.input_ready || !app_pad_update(
            &session.control.window.controller
        ) {
            return false;
        }
        app_title(session.control.window.handle, "SPINWARD | There and Back");
        if !app_relative_mouse(session.control.window.handle, true) {
            return false;
        }
    }
    if !game_sound_open(mut session.control) {
        return false;
    }
    var portals: u32 = asset_port_count(read session.room.ports);
    if graph_count(read session.control.graph) != 0u32 {
        portals = graph_ports(read session.control.graph);
    }
    return game_renderer_open(
        &session.renderer.state,
        o,
        session.control.window.handle,
        portals
    );
}
fn game_finish(session: mut GameSession) -> bool {
    game_sound_finish(mut session.control);
    var good: bool = recording_finish(&session.control.stream);
    good = latency_flush(&session.control.latency, session.control.launch.config) && good;
    if session.control.launch.capture != null(*u8) {
        good = capture(
            &session.renderer.state,
            session.control.launch.capture,
            session.control.launch.config.width,
            session.control.launch.config.height
        ) && good;
    }
    return good;
}
fn game_wait() -> unit {
    app_sleep(1u32);
}
fn scene_overflow() -> unit {
    error("game scene exceeds triangle capacity");
    exit(1i32);
}
fn game_clock_stall() -> unit {
    puts("Simulation paused after a clock stall. Tab resumes.");
}
fn game_initial_spin(session: read GameSession) -> bool {
    return session.control.launch.config.full_spin;
}

fn game_static_open(session: mut GameSession, world: u32) -> bool {
    var drone: Mesh = mesh_new();
    if !player_drone_mesh(mut drone, DRONE_RADIUS) {
        return false;
    }
    {
        var input: FrameInput = renderer_inputs(mut session.renderer);
        if !input_mesh(mut input, read drone, mut session.drone_mesh) {
            return false;
        }
    }
    if session.control.residency.count != 0u32 {
        return game_residency_static(mut session);
    }
    var input: FrameInput = renderer_inputs(mut session.renderer);
    if graph_count(read session.control.graph) == 0u32 {
        return static_upload(mut input, mut session.world, read session.room_mesh);
    }
    return graph_upload(
        read session.control.graph,
        mut input,
        mut session.world,
        read session.room_mesh
    ) && graph_doors_upload(mut session.control.graph, mut input);
}
fn game_scene_finish(
    collision: read CollisionScene,
    session: mut GameSession,
    trial: read Trial,
    config: GameConfig,
    prediction: read Prediction
) -> unit {
    var input: FrameInput = renderer_inputs(mut session.renderer);
    if !spark_emitters_draw(mut input, graph_sparks(read session.control.graph)) {
        scene_overflow();
    }
    game_arcs(
        read collision,
        graph_arcs(read session.control.graph),
        mut input,
        mut session.view_anchors
    );
    draw_anchor_surfaces(read collision, mut input, read trial.drone, config);
    draw_prediction(mut input, read prediction, config);
    draw_frame(mut input, read trial.drone, config);
    draw_portal_admission(
        read collision,
        mut input,
        read trial.drone,
        mut session.view_anchors
    );
    if config.scaling {
        scaling_draw(
            read collision,
            mut input,
            read session.fixture_mesh,
            trial.drone.clock as f32 * STEP
        );
    }
    if trial.graph_run {
        graph_scene(read session.control.graph, mut input, read trial, config);
    }
    draw_drone(
        read collision,
        mut input,
        session.drone_mesh,
        read trial.drone,
        mut session.view_anchors
    );
    doors_draw(
        read collision,
        graph_doors(read session.control.graph),
        mut input,
        trial.drone.clock as f32 * STEP
    );
    if !input_instances_at(mut input, read session.world, trial.drone.clock as f32 * STEP) {
        scene_overflow();
    }
}
fn game_graph_visit(session: mut GameControl, trial: read Trial, reset: bool) -> unit {
    if !trial.graph_run {
        return;
    }
    if reset {
        var i: u32 = 0u32;
        while i < graph_count(read session.graph) {
            var node: GraphNode = graph_node(read session.graph, i);
            node.visited = false;
            graph_node_set(mut session.graph, i, node);
            i = i + 1u32;
        }
    }
    graph_visit(mut session.graph, trial.drone.world);
}
fn game_graph(control: read GameControl) -> read RoomGraph from control {
    return read control.graph;
}

fn game_fps(session: read GameSession) -> u32 {
    return session.frame_rate.fps;
}

fn game_completion(ticks: u32) -> unit {
    puts("Run complete. Backspace starts a new run; Esc exits.");
    var text: [u8; 32] = completion_time(ticks);
    puts(&text[0usize]);
}

fn game_doors_mut(control: mut GameControl) -> mut DoorSet from control {
    return graph_doors_mut(mut control.graph);
}

fn game_initial_anchor_controls(session: read GameSession) -> bool {
    return session.control.launch.config.anchor_controls;
}
