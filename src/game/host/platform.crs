resource GameWindow {
    handle: *u8;
    controller: *u8;
    focused: bool;
}
opaque drop game_window_drop;
record GameSession {
    frame_rate: FrameRate;
    graph: RoomGraph;
    room: RoomAsset;
    room_mesh: Mesh;
    drone_mesh: Mesh;
    window: GameWindow;
    renderer: Renderer;
    world: InstanceList;
    launch: Launch;
    stream: Recording;
}
opaque;
fn game_window_drop(window: mut GameWindow) -> unit {
    if window.controller != null(*u8) {
        SDL_GameControllerClose(window.controller);
    }
    window_close(window.handle);
}
fn game_session(o: *Launch) -> GameSession {
    return make GameSession {
        frame_rate: frame_rate_new(),
        graph: graph_new(),
        room: room_asset_new(),
        room_mesh: mesh_new(),
        drone_mesh: mesh_new(),
        window: make GameWindow {
            handle: null(*u8),
            controller: null(*u8),
            focused: false
        },
        renderer: renderer_new(),
        world: instances_new(),
        launch: *o,
        stream: recording_new()
    };
}
fn game_renderer(session: mut GameSession) -> mut Renderer from session {
    return mut session.renderer;
}
fn game_open(session: mut GameSession, input: mut InputState) -> bool {
    var o: *Launch = &session.launch;
    if !bindings_load(o -> bindings_path, &input) || !recording_open(&session.stream, o) {
        return false;
    }
    if !o -> config.headless {
        if !window_open(&session.window.handle, o -> config.width, o -> config.height) {
            return false;
        }
        if o -> config.fullscreen && !window_fullscreen(session.window.handle) {
            return false;
        }
        if SDL_Init(8192u32) != 0i32 {
            return error(SDL_GetError());
        }
        SDL_SetWindowTitle(session.window.handle, "SPINWARD | There and Back");
        if SDL_SetRelativeMouseMode(1i32) != 0i32 {
            return error(SDL_GetError());
        }
    }
    var portals: u32 = asset_port_count(read session.room.ports);
    if !o -> config.room_demo {
        portals = graph_ports(read session.graph);
    }
    return game_renderer_open(
        &session.renderer.state,
        o,
        session.window.handle,
        portals
    );
}
fn game_finish(session: mut GameSession) -> bool {
    var good: bool = recording_finish(&session.stream);
    if session.launch.capture != null(*u8) {
        good = capture(
            &session.renderer.state,
            session.launch.capture,
            session.launch.config.width,
            session.launch.config.height
        ) && good;
    }
    return good;
}
fn game_wait() -> unit {
    SDL_Delay(1u32);
}
fn scene_overflow() -> unit {
    error("game scene exceeds triangle capacity");
    exit(1i32);
}
fn game_clock_stall() -> unit {
    puts("Simulation paused after a clock stall. Tab resumes.");
}
fn game_initial_spin(session: read GameSession) -> bool {
    return session.launch.config.full_spin;
}

fn game_static_open(session: mut GameSession, world: u32) -> bool {
    if !player_drone_mesh(mut session.drone_mesh, DRONE_RADIUS) {
        return false;
    }
    var input: FrameInput = renderer_inputs(mut session.renderer);
    if session.launch.config.room_demo {
        return static_upload(mut input, mut session.world, read session.room_mesh);
    }
    return graph_upload(
        read session.graph,
        mut input,
        mut session.world,
        read session.room_mesh
    );
}
fn game_scene_frame(
    collision: read CollisionScene,
    session: mut GameSession,
    trial: read Trial,
    config: GameConfig
) -> unit {
    var input: FrameInput = renderer_inputs(mut session.renderer);
    game_scene(read collision, mut input, read trial, config, read session.world);
    draw_drone(read collision, mut input, read session.drone_mesh, trial.drone);
    if trial.graph_run {
        graph_scene(read session.graph, mut input, read trial, config);
    }
    if !input_instances(mut input, read session.world) {
        scene_overflow();
    }
}
fn game_graph_visit(session: mut GameSession, trial: read Trial, reset: bool) -> unit {
    if !trial.graph_run {
        return;
    }
    if reset {
        var i: u32 = 0u32;
        while i < graph_count(read session.graph) {
            var node: GraphNode = graph_node(read session.graph, i);
            node.visited = false;
            graph_node_set(mut session.graph, i, node);
            i = i + 1u32;
        }
    }
    graph_visit(mut session.graph, trial.drone.world);
}
fn game_graph(session: read GameSession) -> read RoomGraph from session {
    return read session.graph;
}

fn game_fps(session: read GameSession) -> u32 {
    return session.frame_rate.fps;
}

fn game_completion(ticks: u32) -> unit {
    puts("Run complete. Backspace starts a new run; Esc exits.");
    var text: [u8; 32] = completion_time(ticks);
    puts(&text[0usize]);
}
