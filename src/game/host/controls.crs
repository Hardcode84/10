fn binding_value(b: Binding, keys: *u8, key_count: i32, mouse: u32, controller: *u8) -> f32 {
    var value: f32 = 0f32;
    if b.key >= 0i32 && b.key < key_count && keys[b.key as usize] != 0u8 {
        value = 1f32;
    }
    if (mouse & b.mouse) != 0u32 {
        value = 1f32;
    }
    if controller == null(*u8) {
        return value;
    }
    if b.button >= 0i32 && app_pad_button(controller, b.button) {
        value = 1f32;
    }
    if b.axis >= 0i32 {
        var axis: f32 = app_pad_axis(controller, b.axis) as f32 / 32767f32 * b.direction;
        axis = clamp((axis - 0.15f32) / 0.85f32, 0f32, 1f32);
        if axis > value {
            value = axis;
        }
    }
    return value;
}
fn game_poll(session: mut GameControl, input: mut InputState) -> bool {
    if session.launch.config.headless {
        return true;
    }
    var event: AppEvent = uninit;
    while app_event(&event, false) > 0i32 {
        game_trace_input(mut session, event);
        input_event(&input, event);
        if event.kind == APP_PAD_CHANGED && !app_pad_update(&session.window.controller) {
            return false;
        }
        if event.kind == APP_QUIT {
            input.quit = true;
        }
    }
    var focused: bool = app_focused(session.window.handle);
    if !focused {
        input.paused = true;
        input.pending = idle_command();
        input.mouse = vec(0f32, 0f32, 0f32);
        var i: usize = 0usize;
        while i < ACTION_COUNT {
            input.latched[i] = false;
            input.pulses[i] = 0u32;
            i = i + 1usize;
        }
    }
    session.window.focused = focused;
    var mx: f32 = 0f32;
    var my: f32 = 0f32;
    var mouse: u32 = app_mouse(&mx, &my);
    if !focused {
        return true;
    }
    var count: i32 = 0i32;
    var keys: *u8 = app_keys(&count);
    var i: usize = 0usize;
    while i < ACTION_COUNT {
        input.values[i] = binding_value(
            input.bindings[i],
            keys,
            count,
            mouse,
            session.window.controller
        );
        i = i + 1usize;
    }
    input_commands(mut input, mx as f32, my as f32);
    return true;
}

fn input_event(input: *InputState, event: AppEvent) -> unit {
    var kind: u32 = event.kind;
    var i: usize = 0usize;
    while i < ACTION_COUNT {
        var b: Binding = input -> bindings[i];
        if event_press(event, kind, b) {
            input -> pulses[i] = input -> pulses[i] + 1u32;
        }
        if kind == APP_PAD_AXIS && b.axis == event.axis {
            var down: bool = event.value as f32 * b.direction > 18841f32;
            if down && !input -> axes_down[i] {
                input -> pulses[i] = input -> pulses[i] + 1u32;
            }
            input -> axes_down[i] = down;
        }
        i = i + 1usize;
    }
}
fn event_press(event: AppEvent, kind: u32, b: Binding) -> bool {
    if kind == APP_KEY_DOWN && !event.repeat {
        return b.key == event.position;
    }
    if kind == APP_MOUSE_DOWN {
        var button: u32 = event.button;
        return button > 0u32 && button <= 5u32 && (b.mouse & (1u32 << (button - 1u32))) != 0u32;
    }
    if kind == APP_PAD_DOWN {
        return b.button == event.button as i32;
    }
    return false;
}
