resource Recording {
    file: *u8;
    mode: u32;
    count: u32;
    expected: u32;
    ended: bool;
}
opaque drop recording_drop;
fn recording_new() -> Recording {
    return make Recording {
        file: null(*u8),
        mode: 0u32,
        count: 0u32,
        expected: 0u32,
        ended: false
    };
}
fn recording_drop(stream: mut Recording) -> unit {
    if stream.file != null(*u8) && fclose(stream.file) != 0i32 {
        error("cannot close recording");
        exit(1i32);
    }
}
fn recording_open(stream: *Recording, o: *Launch) -> bool {
    var path: *u8 = o -> record_path;
    var mode: *u8 = "wb";
    stream -> mode = 1u32;
    if o -> replay_path != null(*u8) {
        path = o -> replay_path;
        mode = "rb";
        stream -> mode = 2u32;
    }
    if path == null(*u8) {
        stream -> mode = 0u32;
        return true;
    }
    stream -> file = fopen(path, mode);
    if stream -> file == null(*u8) {
        return error("cannot open recording");
    }
    var header: [u32; 6] = make [u32; 6] {
        0x53504e30u32,
        21u32,
        o -> config.full_spin as u32 | ((o -> config.anchor_controls as u32) << 1u32),
        o -> config.room_demo as u32 + 2u32 * o -> config.scaling as u32,
        o -> config.seed,
        o -> config.complexity
    };
    if stream -> mode == 1u32 {
        return fwrite(&header as *u8, 24usize, 1usize, stream -> file) == 1usize || error(
            "cannot write recording header"
        );
    }
    if fread(&header as *u8, 24usize, 1usize, stream -> file) != 1usize || header[0usize] != 0x53504e30u32 || header[
        1usize
    ] != 21u32 || header[2usize] > 3u32 || header[3usize] > 2u32 {
        return error("invalid recording header");
    }
    if header[3usize] != o -> config.room_demo as u32 + 2u32 * o -> config.scaling as u32 {
        return error("recording belongs to a different application scene");
    }
    if header[4usize] != o -> config.seed || header[5usize] != o -> config.complexity {
        return error("recording seed or complexity differs; use the recorded graph options");
    }
    o -> config.full_spin = (header[2usize] & 1u32) != 0u32;
    o -> config.anchor_controls = (header[2usize] & 2u32) != 0u32;
    return true;
}
fn recording_finish(stream: *Recording) -> bool {
    if stream -> mode == 1u32 && !stream -> ended {
        var end: [u32; 11] = make [u32; 11] {
            0xffffffffu32,
            stream -> count,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32
        };
        if fwrite(&end as *u8, 44usize, 1usize, stream -> file) != 1usize || fflush(
            stream -> file
        ) != 0i32 {
            return error("cannot finish recording");
        }
        stream -> ended = true;
    }
    return true;
}
fn recording_read(stream: *Recording, c: *Command, doors: mut DoorSet) -> i32 {
    if stream -> mode != 2u32 {
        return 1i32;
    }
    var data: [u32; 11] = uninit;
    if fread(&data as *u8, 44usize, 1usize, stream -> file) != 1usize {
        error("truncated recording");
        return -1i32;
    }
    if data[0usize] == 0xffffffffu32 {
        var extra: u8 = 0u8;
        if data[1usize] != stream -> count || fread(&extra, 1usize, 1usize, stream -> file) != 0usize || ferror(
            stream -> file
        ) != 0i32 {
            error("invalid recording end");
            return -1i32;
        }
        stream -> ended = true;
        return 0i32;
    }
    if data[0usize] != stream -> count || data[8usize] > 255u32 || data[7usize] > 1u32 {
        error("invalid recording tick or flags");
        return -1i32;
    }
    var i: usize = 1usize;
    while i <= 6usize {
        var value: f32 = bits_float(data[i]);
        if!(value >= -10000f32 && value <= 10000f32) {
            error("invalid recording numeric value");
            return -1i32;
        }
        i = i + 1usize;
    }
    * c = idle_command();
    c -> thrust = vec(
        bits_float(data[1usize]),
        bits_float(data[2usize]),
        bits_float(data[3usize])
    );
    c -> look = vec(
        bits_float(data[4usize]),
        bits_float(data[5usize]),
        bits_float(data[6usize])
    );
    c -> reel = data[7usize] != 0u32;
    var flags: u32 = data[8usize];
    c -> burst = (flags & 1u32) != 0u32;
    c -> brake = (flags & 2u32) != 0u32;
    c -> tether = (flags & 4u32) != 0u32;
    c -> restart = (flags & 8u32) != 0u32;
    c -> spin = (flags & 16u32) != 0u32;
    c -> assist = (flags & 32u32) != 0u32;
    c -> anchor = (flags & 128u32) != 0u32;
    c -> preview = (flags & 64u32) != 0u32;
    stream -> expected = data[9usize];
    if !recording_doors_read(stream -> file, mut doors, data[10usize]) {
        return -1i32;
    }
    return 1i32;
}
fn game_command(session: mut GameControl, command: mut Command) -> i32 {
    return recording_read(
        &session.stream,
        &command,
        graph_doors_mut(mut session.graph)
    );
}
fn game_record(session: mut GameControl, command: Command, hash: u32) -> bool {
    var stream: *Recording = &session.stream;
    if stream -> mode == 2u32 && hash != stream -> expected {
        print_number(stream -> count as i64);
        return error("replay state differs at this tick");
    }
    if stream -> mode == 1u32 {
        var data: [u32; 11] = make [u32; 11] {
            stream -> count,
            float_bits(command.thrust.x),
            float_bits(command.thrust.y),
            float_bits(command.thrust.z),
            float_bits(command.look.x),
            float_bits(command.look.y),
            float_bits(command.look.z),
            command.reel as u32,
            command_flags(command),
            hash,
            doors_count(graph_doors(read session.graph))
        };
        if fwrite(&data as *u8, 44usize, 1usize, stream -> file) != 1usize || !recording_doors_write(
            stream -> file,
            graph_doors(read session.graph)
        ) {
            return error("cannot write input tick");
        }
    }
    stream -> count = stream -> count + 1u32;
    return true;
}
fn game_summary(trial: read Trial) -> unit {
    if trial.graph_run {
        puts("current room / goal room / returning / complete:");
        print_number(trial.drone.world as i64);
        print_number(trial.goal_world as i64);
        print_number(trial.returning as i64);
        print_number(trial.finished as i64);
    }
    puts("expedition timer ticks / state hash:");
    print_number(trial.tick as i64);
    print_number(trial_hash(read trial) as i64);
    puts("burst count / brake speed removed (m/s) / winch work per mass (J/kg):");
    print_number(trial.drone.bursts as i64);
    print_number(trial.drone.brake_speed as i64);
    print_number(trial.drone.winch_work as i64);
}

fn recording_doors_read(file: *u8, doors: mut DoorSet, count: u32) -> bool {
    if count != doors_count(read doors) {
        return error("recording door count differs from scene");
    }
    var i: u32 = 0u32;
    while i < count {
        var requested: u8 = 0u8;
        if fread(&requested, 1usize, 1usize, file) != 1usize || requested > 1u8 {
            return error("invalid or truncated recording door requests");
        }
        door_set_requested(mut doors, i, requested != 0u8);
        i = i + 1u32;
    }
    return true;
}
fn recording_doors_write(file: *u8, doors: read DoorSet) -> bool {
    var i: u32 = 0u32;
    while i < doors_count(read doors) {
        var requested: u8 = door_get(read doors, i).requested as u8;
        if fwrite(&requested, 1usize, 1usize, file) != 1usize {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
