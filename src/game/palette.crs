const PREVIEW_MATERIAL: u32 = 8u32;
const HOOK_PREVIEW_MATERIAL: u32 = 9u32;
fn game_palette(v: mut FrameInput) -> unit {
    var colors: [u32; 10] = make [u32; 10] {
        0x687876u32,
        0x82949du32,
        0x365d8au32,
        0x538c70u32,
        0xf0d444u32,
        0x54c4ffu32,
        0x4260ffu32,
        0x303d41u32,
        0xf0d444u32,
        0xe880ffu32
    };
    var mat: u32 = 0u32;
    while mat < 10u32 {
        var tex: u32 = 0u32;
        while tex < 4u32 {
            var shade: u32 = 130u32 + tex * 40u32;
            if mat >= PREVIEW_MATERIAL {
                shade = 255u32;
            }
            var state: u32 = 0u32;
            while state < 512u32 {
                input_set_word(
                    mut v,
                    (LIT_PALETTE + (mat * 4u32 + tex) * 512u32 + state) as usize,
                    palette_entry(colors[mat as usize], shade, state, mat >= 4u32)
                );
                state = state + 1u32;
            }
            tex = tex + 1u32;
        }
        var i: u32 = 0u32;
        while i < 64u32 {
            input_set_word(
                mut v,
                (MATERIAL_TEXTURE + mat * 64u32 + i) as usize,
                ((i % 8u32) / 2u32 + (i / 8u32) / 2u32) % 4u32
            );
            i = i + 1u32;
        }
        mat = mat + 1u32;
    }
    input_set_word(mut v, LIGHT_MODEL as usize, 1u32);
    input_set_word(mut v, LIGHT_COUNT as usize, 0u32);
    input_set_float(mut v, CAMERA_LIGHT as usize, 400f32);
    input_set_float(mut v, (CAMERA_LIGHT + 1u32) as usize, 1f32);
    input_set_float(mut v, (CAMERA_LIGHT + 2u32) as usize, 1f32);
    input_set_float(mut v, (CAMERA_LIGHT + 3u32) as usize, 1f32);
    var i: u32 = 0u32;
    while i < 3u32 {
        input_set_float(mut v, (SPACE_LIGHT + i) as usize, 0.22f32);
        i = i + 1u32;
    }
}
