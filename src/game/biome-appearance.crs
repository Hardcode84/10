const SERVICE_CABINET_MATERIAL: u32 = 14u32;
const STRUCTURAL_RIB_MATERIAL: u32 = 15u32;
const ANCHOR_LEDGE_MATERIAL: u32 = 16u32;
const STRUCTURAL_WALL_MATERIAL: u32 = 17u32;
const CRADLE_BED_MATERIAL: u32 = 18u32;
const GAME_MATERIALS: u32 = 19u32;
fn cabinet_texel(x: u32, y: u32) -> u32 {
    if x == 0u32 || y == 0u32 {
        return 0u32;
    }
    if x == 6u32 && y == 6u32 {
        return 3u32;
    }
    if x >= 2u32 && x <= 5u32 && (y == 2u32 || y == 4u32) {
        return 0u32;
    }
    return 2u32;
}
fn room_texel(material: u32, x: u32, y: u32) -> u32 {
    if material == SERVICE_CABINET_MATERIAL {
        return cabinet_texel(x, y);
    }
    if material == ANCHOR_LEDGE_MATERIAL {
        if y == 0u32 && x >= 2u32 && x <= 5u32 {
            return 3u32;
        }
        if x == 0u32 || y == 0u32 {
            return 0u32;
        }
        return 2u32;
    }
    if material == STRUCTURAL_WALL_MATERIAL {
        if x == 0u32 || y == 0u32 {
            return 0u32;
        }
        return 1u32;
    }
    if material == CRADLE_BED_MATERIAL {
        if x >= 2u32 && x <= 5u32 {
            return 0u32;
        }
        return 2u32 + y % 2u32;
    }
    return rib_texel(x, y);
}
fn rib_texel(x: u32, y: u32) -> u32 {
    if x == 0u32 || y == 0u32 {
        return 0u32;
    }
    if x == 1u32 || x == 7u32 {
        return 3u32;
    }
    return 1u32;
}
fn game_material_texel(material: u32, x: u32, y: u32) -> u32 {
    if material >= SERVICE_CABINET_MATERIAL {
        return room_texel(material, x, y);
    }
    return course_texel(material, x, y);
}
fn game_material_color(base: u32, material: u32, texel: u32, state: u32) -> u32 {
    if material < SERVICE_CABINET_MATERIAL {
        return course_palette_color(base, material, texel, state);
    }
    var bright: bool = (material == SERVICE_CABINET_MATERIAL || material == ANCHOR_LEDGE_MATERIAL) && texel == 3u32;
    var color: u32 = base;
    if bright {
        color = 0x54c4ffu32;
    }
    var shade: u32 = 100u32 + texel * 50u32;
    if material == STRUCTURAL_WALL_MATERIAL {
        shade = 100u32 + texel * 15u32;
    }
    return palette_entry(color, shade, state, bright);
}
