const HOOK_SPEED: f32 = 60f32;
const HOOK_MASS_RATIO: f32 = 0.02f32;
const HOOK_RADIUS: f32 = 0.06f32;
const CABLE_REACH: f32 = 120f32;
fn hook_launch(drone: mut Drone) -> unit {
    portal_path_clear(mut drone.cable.path);
    drone.cable.phase = CABLE_FLYING;
    rational_assign(mut drone.cable.size, read drone.size);
    drone.cable.space = drone.world;
    drone.cable.frame = space_identity();
    drone.cable.anchor = drone.position;
    var impulse: Vec3 = scale(drone.basis.forward, HOOK_SPEED);
    drone.cable.velocity = add(drone.velocity, impulse);
    drone.velocity = sub(drone.velocity, scale(impulse, HOOK_MASS_RATIO));
}
fn hook_range_time(position: Vec3, travel: Vec3, origin: Vec3) -> f32 {
    var offset: Vec3 = sub(position, origin);
    var c: f32 = dot(offset, offset) - CABLE_REACH * CABLE_REACH;
    if c >= 0f32 {
        return 0f32;
    }
    var a: f32 = dot(travel, travel);
    if a < 0.00000001f32 {
        return 1f32;
    }
    var b: f32 = dot(offset, travel);
    return clamp((-b + sqrtf(b * b - a * c)) / a, 0f32, 1f32);
}
fn hook_step(collision: read CollisionScene, drone: mut Drone, full_spin: bool) -> unit {
    if drone.cable.phase != CABLE_FLYING {
        return;
    }
    var inverse: SpaceTransform = space_inverse(drone.cable.frame);
    var acceleration: Vec3 = flight_acceleration(
        space_point(inverse, drone.cable.anchor),
        space_vector(inverse, scale(drone.cable.velocity, drone_size(read drone))),
        full_spin
    );
    drone.cable.velocity = add(
        drone.cable.velocity,
        scale(
            space_vector(drone.cable.frame, acceleration),
            STEP / drone_size(read drone)
        )
    );
    var left: f32 = STEP;
    var crossings: u32 = 0u32;
    while left > 0f32 && drone.cable.phase == CABLE_FLYING {
        left = hook_interval(read collision, mut drone, left);
        crossings = crossings + 1u32;
        if crossings >= 1024u32 {
            scene_motion_failure();
        }
    }
}
fn hook_interval(collision: read CollisionScene, drone: mut Drone, left: f32) -> f32 {
    var inverse: SpaceTransform = space_inverse(drone.cable.frame);
    var position: Vec3 = space_point(inverse, drone.cable.anchor);
    var travel: Vec3 = scale(drone.cable.velocity, left * drone_size(read drone));
    var local_travel: Vec3 = space_vector(inverse, travel);
    var limit: f32 = hook_range_time(
        scale(
            sub(drone.cable.anchor, drone.position),
            1f32 / drone_size(read drone)
        ),
        scale(travel, 1f32 / drone_size(read drone)),
        vec(0f32, 0f32, 0f32)
    );
    var portal: PortalCrossing = portal_crossing(
        read collision,
        drone.cable.space,
        position,
        local_travel
    );
    var query: CollisionSweep = collision_sweep_interval(
        read collision,
        drone.cable.space,
        position,
        local_travel,
        hook_radius(read drone),
        drone.clock as f32 * STEP + STEP - left,
        left
    );
    if query.status != 0u32 {
        var failure: CollisionMotion = collision_motion_begin(
            read collision,
            drone.cable.space,
            position,
            local_travel,
            space_vector(inverse, scale(drone.cable.velocity, drone_size(read drone)))
        );
        failure.status = query.status;
        failure.contact = query.contact;
        game_collision_failure(failure);
    }
    if portal.time < query.contact.hit.time && portal.time <= limit {
        var link: CollisionPortal = collision_portal(read collision, portal.index);
        drone.cable.anchor = add(drone.cable.anchor, scale(travel, portal.time));
        portal_path_append(mut drone.cable.path, portal.index, link.reverse);
        tether_rebuild(read collision, mut drone.cable);
        var factor: Rational = portal_ratio(link);
        rational_multiply(mut drone.cable.size, read factor);
        drone.cable.space = link.destination;
        return left * (1f32 - portal.time);
    }
    if query.contact.hit.time <= limit {
        var end_time: f32 = (drone.clock + 1u32) as f32 * STEP;
        hook_attach(
            read collision,
            mut drone,
            read query,
            end_time - left + left * query.contact.hit.time,
            end_time
        );
    } else if limit < 1f32 {
        reset_cable(mut drone.cable);
        drone.cable.phase = CABLE_SNAPPED;
    } else {
        drone.cable.anchor = add(drone.cable.anchor, travel);
    }
    return 0f32;
}
