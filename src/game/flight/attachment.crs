const TETHER_SLACK: f32 = 0.001f32;
// The local point is on the contacted surface, not at the projectile centre.
fn hook_attach(
    scene: read CollisionScene,
    drone: mut Drone,
    query: read CollisionSweep,
    attachment: read CollisionAttachment,
    contact_time: f32,
    time: f32
) -> unit {
    var contact: CollisionContact = query.contact;
    drone.hook_contact = flight_contact(
        read scene,
        rational_float(read drone.cable.size),
        contact,
        space_vector(
            space_inverse(drone.cable.frame),
            scale(drone.cable.velocity, drone_size(read drone))
        ),
        contact_time
    );
    var body: CollisionInstance = collision_instance(read scene, contact.instance);
    if body.controlled && length(collision_pose(body, contact_time).linear) != 0f32 {
        hook_disconnect(mut drone);
        return;
    }
    var size: Rational = rational_product(read drone.cable.size, read attachment.ratio);
    var i: u32 = 0u32;
    while i < portal_path_count(read attachment.path) {
        var index: u32 = portal_path_at(read attachment.path, i);
        var link: CollisionPortal = collision_portal(read scene, index);
        portal_path_append(mut drone.cable.path, index, link.reverse);
        i = i + 1u32;
    }
    var frame: SpaceTransform = space_inverse(
        space_path(read scene, read drone.cable.path)
    );
    rational_swap(mut drone.cable.size, mut size);
    drone.cable.frame = frame;
    drone.cable.instance = contact.instance;
    drone.cable.surface = contact.surface;
    drone.cable.local_point = contact.local_point;
    var pose: CollisionInstance = collision_pose(
        collision_instance(read scene, contact.instance),
        contact_time
    );
    drone.cable.local_normal = collision_local(
        pose.basis,
        basis_vector(space_inverse(contact.frame).basis, contact.hit.normal)
    );
    drone.cable.space = contact.space;
    drone.cable.phase = CABLE_ATTACHED;
    hook_follow(read scene, mut drone, time);
    if drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    drone.cable.extent = clamp(
        length(sub(drone.position, drone.cable.anchor)) / drone_size(read drone),
        0.75f32,
        120f32
    );
}
fn hook_follow(scene: read CollisionScene, drone: mut Drone, time: f32) -> unit {
    if drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    var body: CollisionInstance = collision_instance(read scene, drone.cable.instance);
    if body.controlled && length(collision_pose(body, time).linear) != 0f32 {
        hook_disconnect(mut drone);
        return;
    }
    drone.cable.anchor = space_point(
        drone.cable.frame,
        collision_anchor(
            read scene,
            drone.cable.instance,
            drone.cable.local_point,
            time
        )
    );
    drone.cable.velocity = scale(
        space_vector(
            drone.cable.frame,
            collision_anchor_velocity(
                read scene,
                drone.cable.instance,
                drone.cable.local_point,
                time
            )
        ),
        1f32 / drone_size(read drone)
    );
}
// Release preserves the velocity acquired from a machine or the winch.
fn hook_release(drone: mut Drone) -> unit {
    reset_cable(mut drone.cable);
}
// Disconnects without relaunching until the tether control is released.
fn hook_disconnect(drone: mut Drone) -> unit {
    hook_release(mut drone);
    drone.cable.phase = CABLE_SNAPPED;
}
// Applies an inelastic, unit-player-mass constraint in the current space frame.
fn tether_constraint(drone: mut Drone) -> unit {
    if drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    var offset: Vec3 = sub(drone.position, drone.cable.anchor);
    if length(offset) / drone_size(read drone) < drone.cable.extent - TETHER_SLACK {
        return;
    }
    var normal: Vec3 = unit_vector(offset);
    var anchor_speed: f32 = dot(drone.cable.velocity, normal);
    var speed: f32 = dot(drone.velocity, normal) - anchor_speed - drone.cable.reel_speed;
    if speed <= 0f32 {
        return;
    }
    drone.velocity = sub(drone.velocity, scale(normal, speed));
    drone.winch_work = drone.winch_work - speed * drone.cable.reel_speed;
    drone.machine_work = drone.machine_work - speed * anchor_speed;
    drone.cable_loss = drone.cable_loss + 0.5f32 * speed * speed;
}
