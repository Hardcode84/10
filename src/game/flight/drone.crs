const STEP: f32 = 0.008333333333333333f32;
const DRONE_RADIUS: f32 = 0.35f32;
const CABLE_READY: u32 = 0u32;
const CABLE_FLYING: u32 = 1u32;
const CABLE_ATTACHED: u32 = 2u32;
const CABLE_SNAPPED: u32 = 3u32;
record Cable {
    path: PortalPath;
    size: Rational;
    frame: SpaceTransform;
    space: u32;
    phase: u32;
    instance: u32;
    surface: u32;
    local_point: Vec3;
    local_normal: Vec3;
    anchor: Vec3;
    velocity: Vec3;
    extent: f32;
    reel_speed: f32;
    reeling: bool;
}
fn empty_cable() -> Cable {
    return make Cable {
        path: portal_path_new(),
        size: rational_new(1u64, 1u64),
        frame: space_identity(),
        space: 0u32,
        phase: CABLE_READY,
        instance: 0xffffffffu32,
        surface: 0xffffffffu32,
        local_point: vec(0f32, 0f32, 0f32),
        local_normal: vec(0f32, 0f32, 0f32),
        anchor: vec(0f32, 0f32, 0f32),
        velocity: vec(0f32, 0f32, 0f32),
        extent: 0f32,
        reel_speed: 0f32,
        reeling: false
    };
}
record Drone {
    size: Rational;
    step_frame: SpaceTransform;
    world: u32;
    clock: u32;
    machine_work: f32;
    cable_loss: f32;
    contact_work: f32;
    position: Vec3;
    velocity: Vec3;
    basis: Basis;
    cable: Cable;
    bursts: u32;
    boost_ticks: u32;
    pulse_cooldown: u32;
    brake_ticks: u32;
    brake_rate: f32;
    brake_speed: f32;
    winch_work: f32;
}
fn new_drone() -> Drone {
    return make Drone {
        size: rational_new(1u64, 1u64),
        step_frame: space_identity(),
        world: 0u32,
        clock: 0u32,
        machine_work: 0f32,
        cable_loss: 0f32,
        contact_work: 0f32,
        position: vec(0f32, 1f32, 0f32),
        velocity: vec(0f32, 0f32, 0f32),
        basis: identity_basis(),
        cable: empty_cable(),
        bursts: 0u32,
        boost_ticks: 0u32,
        pulse_cooldown: 0u32,
        brake_ticks: 0u32,
        brake_rate: 0f32,
        brake_speed: 0f32,
        winch_work: 0f32
    };
}

fn drone_size(drone: read Drone) -> f32 {
    return rational_float(read drone.size);
}
fn drone_radius(drone: read Drone) -> f32 {
    return DRONE_RADIUS * drone_size(read drone);
}
fn hook_radius(drone: read Drone) -> f32 {
    return HOOK_RADIUS * rational_float(read drone.cable.size);
}

fn clone_cable(value: read Cable) -> Cable {
    return make Cable {
        path: portal_path_clone(read value.path),
        size: rational_clone(read value.size),
        frame: value.frame,
        space: value.space,
        phase: value.phase,
        instance: value.instance,
        surface: value.surface,
        local_point: value.local_point,
        local_normal: value.local_normal,
        anchor: value.anchor,
        velocity: value.velocity,
        extent: value.extent,
        reel_speed: value.reel_speed,
        reeling: value.reeling
    };
}

fn clone_drone(value: read Drone) -> Drone {
    return make Drone {
        size: rational_clone(read value.size),
        step_frame: value.step_frame,
        world: value.world,
        clock: value.clock,
        machine_work: value.machine_work,
        cable_loss: value.cable_loss,
        contact_work: value.contact_work,
        position: value.position,
        velocity: value.velocity,
        basis: value.basis,
        cable: clone_cable(read value.cable),
        bursts: value.bursts,
        boost_ticks: value.boost_ticks,
        pulse_cooldown: value.pulse_cooldown,
        brake_ticks: value.brake_ticks,
        brake_rate: value.brake_rate,
        brake_speed: value.brake_speed,
        winch_work: value.winch_work
    };
}

fn assign_cable(target: mut Cable, value: read Cable) -> unit {
    portal_path_assign(mut target.path, read value.path);
    rational_assign(mut target.size, read value.size);
    target.frame = value.frame;
    target.space = value.space;
    target.phase = value.phase;
    target.instance = value.instance;
    target.surface = value.surface;
    target.local_point = value.local_point;
    target.local_normal = value.local_normal;
    target.anchor = value.anchor;
    target.velocity = value.velocity;
    target.extent = value.extent;
    target.reel_speed = value.reel_speed;
    target.reeling = value.reeling;
}

fn assign_drone(target: mut Drone, value: read Drone) -> unit {
    rational_assign(mut target.size, read value.size);
    target.step_frame = value.step_frame;
    target.world = value.world;
    target.clock = value.clock;
    target.machine_work = value.machine_work;
    target.cable_loss = value.cable_loss;
    target.contact_work = value.contact_work;
    target.position = value.position;
    target.velocity = value.velocity;
    target.basis = value.basis;
    assign_cable(mut target.cable, read value.cable);
    target.bursts = value.bursts;
    target.boost_ticks = value.boost_ticks;
    target.pulse_cooldown = value.pulse_cooldown;
    target.brake_ticks = value.brake_ticks;
    target.brake_rate = value.brake_rate;
    target.brake_speed = value.brake_speed;
    target.winch_work = value.winch_work;
}

fn reset_cable(target: mut Cable) -> unit {
    var value: Cable = empty_cable();
    assign_cable(mut target, read value);
}
