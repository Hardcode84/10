fn course_hit(collision: read CollisionScene, world: u32, p: Vec3, d: Vec3, radius: f32) -> Hit {
    return collision_sweep(read collision, world, p, d, radius).hit;
}
// Applies sphere motion. Invalid geometry or unresolved contacts terminate the run.
fn move_drone(collision: read CollisionScene, drone: mut Drone, travel: Vec3) -> unit {
    var motion: CollisionMotion = collision_motion_begin(
        read collision,
        drone.world,
        drone.position,
        travel,
        drone.velocity
    );
    var planes: CollisionPlanes = collision_planes_new();
    var done: bool = false;
    while !done {
        motion.remaining = tether_travel(read drone, motion.remaining);
        done = collision_motion_step(
            read collision,
            drone.world,
            DRONE_RADIUS,
            mut planes,
            mut motion
        );
        drone.position = motion.position;
    }
    if motion.status != 0u32 {
        game_collision_failure(motion);
    }
    drone.velocity = motion.velocity;
}
fn game_collision_spawn(collision: read CollisionScene, trial: read Trial) -> bool {
    if !collision_position_valid(
        read collision,
        trial.drone.world,
        trial.drone.position,
        DRONE_RADIUS
    ) {
        return error("drone spawn intersects collision geometry");
    }
    if trial.expedition.has_parked && !collision_position_valid(
        read collision,
        1u32,
        trial.expedition.parked,
        DRONE_RADIUS
    ) {
        return error("saved drone intersects collision geometry");
    }
    return true;
}
