fn course_hit(collision: read CollisionScene, world: u32, p: Vec3, d: Vec3, radius: f32) -> Hit {
    return collision_sweep(read collision, world, p, d, radius).hit;
}
// Applies sphere motion. Invalid geometry or unresolved contacts terminate the run.
fn move_drone(collision: read CollisionScene, drone: mut Drone, travel: Vec3) -> unit {
    move_drone_interval(read collision, mut drone, travel, 0f32);
}
fn move_drone_interval(
    collision: read CollisionScene,
    drone: mut Drone,
    travel: Vec3,
    duration: f32
) -> unit {
    var time: f32 = drone.clock as f32 * STEP;
    var motion: CollisionMotion = collision_interval_begin(
        read collision,
        drone.world,
        drone.position,
        travel,
        drone.velocity,
        time
    );
    var planes: CollisionPlanes = collision_planes_new();
    var speeds: CollisionPlanes = collision_planes_new();
    var done: bool = false;
    while !done {
        motion.remaining = tether_travel(read drone, motion.remaining);
        done = collision_interval_step(
            read collision,
            drone.world,
            DRONE_RADIUS,
            time,
            duration,
            mut planes,
            mut speeds,
            mut motion
        );
        drone.position = motion.position;
    }
    if motion.status != 0u32 {
        game_collision_failure(motion);
    }
    drone.velocity = motion.velocity;
    drone.contact_work = drone.contact_work + motion.contact_work;
}
