fn course_hit(collision: read CollisionScene, world: u32, p: Vec3, d: Vec3, radius: f32) -> Hit {
    return collision_sweep(read collision, world, p, d, radius).hit;
}
// Applies cable-limited motion with solid contact taking priority.
// Invalid geometry or unresolved contacts terminate the run.
fn move_drone(collision: read CollisionScene, drone: mut Drone, travel: Vec3) -> unit {
    move_drone_interval(read collision, mut drone, travel, 0f32);
}
fn move_drone_interval_admitted(
    collision: read CollisionScene,
    drone: mut Drone,
    travel: Vec3,
    duration: f32
) -> CollisionAdmission {
    var time: f32 = drone.clock as f32 * STEP;
    var motion: CollisionMotion = collision_interval_begin(
        read collision,
        drone.world,
        drone.position,
        tether_travel(read drone, travel),
        scale(drone.velocity, drone_size(read drone)),
        time
    );
    var planes: CollisionPlanes = collision_planes_new();
    var speeds: CollisionPlanes = collision_planes_new();
    var done: bool = false;
    while !done {
        if drone_portal_step(read collision, mut drone, mut motion, time, duration) {
            continue;
        }
        var body: CollisionBody = flight_body(read drone);
        var incoming: Vec3 = motion.velocity;
        done = collision_interval_step_body(
            read collision,
            drone.world,
            read body,
            time,
            duration,
            mut planes,
            mut speeds,
            mut motion
        );
        var contact: FlightContact = flight_contact(
            read collision,
            drone_size(read drone),
            motion.contact,
            incoming,
            time + motion.elapsed
        );
        if contact.active && (
            !drone.contact.active || contact.impact > drone.contact.impact
        ) {
            drone.contact = contact;
        }
        drone.position = motion.position;
    }
    if motion.status == COLLISION_UNRESOLVED {
        return collision_required(motion.contact.space);
    }
    if motion.status != 0u32 {
        game_collision_failure(motion);
    }
    drone.velocity = scale(motion.velocity, 1f32 / drone_size(read drone));
    var factor: f32 = drone_size(read drone);
    drone.contact_work = drone.contact_work + motion.contact_work / (factor * factor);
    return collision_ready();
}

fn drone_portal(scene: read CollisionScene, drone: mut Drone, index: u32) -> unit {
    var position: Vec3 = drone.position;
    var velocity: Vec3 = drone.velocity;
    drone_portal_at(read scene, mut drone, index, position, velocity);
}
fn drone_portal_at(
    scene: read CollisionScene,
    drone: mut Drone,
    index: u32,
    position: Vec3,
    velocity: Vec3
) -> unit {
    var portal: CollisionPortal = collision_portal(read scene, index);
    var t: SpaceTransform = portal.transform;
    var factor: Rational = portal_ratio(portal);
    var size: Rational = rational_product(read drone.size, read factor);
    var frame: SpaceTransform = drone.cable.frame;
    if drone.cable.phase == CABLE_FLYING || drone.cable.phase == CABLE_ATTACHED {
        if portal.reverse == 0xffffffffu32 {
            error("a tether crossing requires a reciprocal portal");
            trap;
        }
        portal_path_prepend(mut drone.cable.path, portal.reverse, index);
        frame = space_inverse(space_path(read scene, read drone.cable.path));
    }
    rational_swap(mut drone.size, mut size);
    drone.cable.frame = frame;
    drone.step_frame = space_compose(t, drone.step_frame);
    drone.world = portal.destination;
    drone.position = space_point(t, position);
    drone.velocity = basis_vector(t.basis, velocity);
    drone.basis = space_orthogonal(space_basis(t, drone.basis));
    drone.cable.anchor = space_point(t, drone.cable.anchor);
    drone.cable.velocity = basis_vector(t.basis, drone.cable.velocity);
}
fn drone_portal_step(
    collision: read CollisionScene,
    drone: mut Drone,
    motion: mut CollisionMotion,
    time: f32,
    duration: f32
) -> bool {
    if motion.status != 0u32 {
        return false;
    }
    var crossing: PortalCrossing = portal_crossing(
        read collision,
        drone.world,
        motion.position,
        motion.remaining
    );
    if crossing.time > 1f32 {
        return false;
    }
    var body: CollisionBody = flight_body(read drone);
    var query: CollisionSweep = collision_sweep_interval_body(
        read collision,
        drone.world,
        motion.position,
        motion.remaining,
        read body,
        time + motion.elapsed,
        duration - motion.elapsed
    );
    if query.status != 0u32 || query.contact.hit.time <= crossing.time {
        return false;
    }
    var portal: CollisionPortal = collision_portal(read collision, crossing.index);
    var position: Vec3 = add(motion.position, scale(motion.remaining, crossing.time));
    var velocity: Vec3 = scale(motion.velocity, 1f32 / drone_size(read drone));
    var old_size: f32 = drone_size(read drone);
    drone_portal_at(read collision, mut drone, crossing.index, position, velocity);
    drone.contact_work = drone.contact_work + motion.contact_work / (old_size * old_size);
    motion.contact_work = 0f32;
    motion.position = drone.position;
    motion.velocity = scale(drone.velocity, drone_size(read drone));
    motion.remaining = space_vector(
        portal.transform,
        scale(motion.remaining, 1f32 - crossing.time)
    );
    motion.elapsed = motion.elapsed + (duration - motion.elapsed) * crossing.time;
    motion.contacts = motion.contacts + 1u32;
    if motion.contacts >= 1024u32 {
        motion.status = 3u32;
        game_collision_failure(motion);
    }
    return true;
}

// Requires all rooms touched by this motion to be resident.
fn move_drone_interval(
    collision: read CollisionScene,
    drone: mut Drone,
    travel: Vec3,
    duration: f32
) -> unit {
    collision_require_complete(
        move_drone_interval_admitted(read collision, mut drone, travel, duration)
    );
}
