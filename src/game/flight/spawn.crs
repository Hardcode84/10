fn game_collision_spawn(collision: read CollisionScene, trial: read Trial) -> bool {
    if !collision_position_valid_at(
        read collision,
        trial.drone.world,
        trial.drone.position,
        drone_radius(read trial.drone),
        trial.drone.clock as f32 * STEP
    ) {
        return error("drone spawn intersects collision geometry");
    }
    return true;
}
