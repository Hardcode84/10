fn brake_amount(drone: read Drone) -> f32 {
    return clamp(length(drone.velocity), 0f32, 30f32);
}
fn powered_winch(collision: read CollisionScene, drone: mut Drone) -> CollisionAdmission {
    var admission: CollisionAdmission = tether_winch_admitted(read collision, mut drone);
    if admission.status != 0u32 {
        return admission;
    }
    tether_constraint(mut drone);
    return collision_ready();
}
