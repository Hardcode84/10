const JUMPER_LAUNCH_SPEED: f32 = 15f32;
fn jumper_pinned(drone: read Drone) -> bool {
    return drone.wall_anchor.mode == MOVEMENT_JUMPER && drone.wall_anchor.active;
}
fn jumper_step(scene: read CollisionScene, drone: mut Drone, held: bool) -> unit {
    drone.wall_anchor.held = held;
    if !held || drone.wall_anchor.recovering {
        wall_anchor_recharge(mut drone.wall_anchor);
        return;
    }
    if drone.wall_anchor.active {
        var item: CollisionInstance = collision_instance(
            read scene,
            drone.wall_anchor.instance
        );
        if !collision_attachment_available(item, drone.clock as f32 * STEP) {
            wall_anchor_recharge(mut drone.wall_anchor);
            return;
        }
    } else {
        if !jumper_acquire(read scene, mut drone) {
            wall_anchor_recharge(mut drone.wall_anchor);
            return;
        }
    }
    wall_anchor_drain(mut drone.wall_anchor);
}
fn jumper_acquire(scene: read CollisionScene, drone: mut Drone) -> bool {
    var query: BoundaryQuery = collision_boundary_begin(
        read scene,
        drone.world,
        drone.position,
        WALL_ANCHOR_RANGE * drone_size(read drone),
        vec(0f32, 0f32, 0f32)
    );
    query.hull_only = false;
    query.time = drone.clock as f32 * STEP;
    var best: BoundaryContact = boundary_miss(drone.position, query.reach);
    while true {
        var hit: BoundaryContact = collision_boundary_nearby(read scene, mut query);
        if !hit.found {
            break;
        }
        if wall_anchor_clear(read scene, read drone, hit) {
            best = hit;
            query.reach = hit.distance;
        }
    }
    if !best.found {
        return false;
    }
    var pose: CollisionInstance = collision_pose(
        collision_instance(read scene, best.instance),
        query.time
    );
    drone.wall_anchor.active = true;
    drone.wall_anchor.instance = best.instance;
    drone.wall_anchor.local_position = collision_local(
        pose.basis,
        sub(drone.position, pose.origin)
    );
    drone.wall_anchor.normal = best.normal;
    return true;
}
fn jumper_velocity(scene: read CollisionScene, drone: mut Drone) -> unit {
    var target: Vec3 = collision_anchor(
        read scene,
        drone.wall_anchor.instance,
        drone.wall_anchor.local_position,
        (drone.clock + 1u32) as f32 * STEP
    );
    drone.velocity = scale(
        sub(target, drone.position),
        1f32 / (STEP * drone_size(read drone))
    );
}
fn jumper_finish(scene: read CollisionScene, drone: mut Drone) -> unit {
    if !jumper_pinned(read drone) {
        return;
    }
    var item: CollisionInstance = collision_instance(read scene, drone.wall_anchor.instance);
    if item.space != drone.world || drone.contact.active {
        drone.wall_anchor.active = false;
        return;
    }
    drone.velocity = scale(
        collision_anchor_velocity(
            read scene,
            drone.wall_anchor.instance,
            drone.wall_anchor.local_position,
            drone.clock as f32 * STEP
        ),
        1f32 / drone_size(read drone)
    );
}

fn jumper_release(scene: read CollisionScene, drone: read Drone, held: bool) -> bool {
    if !jumper_pinned(read drone) || held || !drone.wall_anchor.held || drone.wall_anchor.charge == 0u32 {
        return false;
    }
    return collision_attachment_available(
        collision_instance(read scene, drone.wall_anchor.instance),
        drone.clock as f32 * STEP
    );
}
