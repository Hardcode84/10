fn reset_trial(trial: mut Trial) -> unit {
    trial.returning = false;
    trial.drone = trial.spawn;
    trial.tick = 0u32;
    trial.preview_phase = 0f32;
    trial.finished = false;
    trial.started = false;
    trial.attempt = trial.attempt + 1u32;
}
fn trial_step(collision: read CollisionScene, trial: mut Trial, command: Command) -> unit {
    if command.spin {
        trial.full_spin = !trial.full_spin;
        reset_trial(mut trial);
    }
    if command.restart {
        reset_trial(mut trial);
    }
    if command.assist {
        trial.auto_level = !trial.auto_level;
    }
    if command.preview {
        trial.preview_enabled = !trial.preview_enabled;
    }
    if trial.finished {
        return;
    }
    if command.burst || command.brake || command.tether || length(command.thrust) > 0f32 {
        trial.started = true;
    }
    if !trial.started {
        orient(mut trial.drone, command.look, trial.auto_level);
        return;
    }
    var before: Vec3 = trial.drone.position;
    simulate(
        read collision,
        mut trial.drone,
        command,
        trial.full_spin,
        trial.auto_level
    );
    advance_preview_phase(mut trial, before);
    trial.tick = trial.tick + 1u32;
    if trial.graph_run {
        graph_progress(mut trial);
    }
}
