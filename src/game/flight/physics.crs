const FLIGHT_PULSE_TICKS: u32 = 18u32;
const FLIGHT_COOLDOWN_TICKS: u32 = 180u32;
const FLIGHT_THRUST_ACCELERATION: f32 = 1f32;
fn flight_pulses(drone: mut Drone, command: Command) -> bool {
    var boosted: bool = false;
    if drone.pulse_cooldown > 0u32 {
        drone.pulse_cooldown = drone.pulse_cooldown - 1u32;
    }
    if command.brake && drone.pulse_cooldown == 0u32 {
        drone.brake_ticks = FLIGHT_PULSE_TICKS;
        drone.brake_rate = brake_amount(read drone) / (FLIGHT_PULSE_TICKS as f32 * STEP);
        drone.pulse_cooldown = FLIGHT_COOLDOWN_TICKS;
    } else if command.burst && drone.pulse_cooldown == 0u32 && length(command.thrust) > 0f32 {
        boosted = true;
        drone.boost_direction = unit_vector(command.thrust);
        drone.boost_ticks = FLIGHT_PULSE_TICKS;
        drone.bursts = drone.bursts + 1u32;
        drone.pulse_cooldown = FLIGHT_COOLDOWN_TICKS;
    }
    if drone.boost_ticks > 0u32 {
        drone.velocity = add(
            drone.velocity,
            scale(
                basis_vector(drone.basis, drone.boost_direction),
                15f32 / FLIGHT_PULSE_TICKS as f32
            )
        );
        drone.boost_ticks = drone.boost_ticks - 1u32;
    }
    flight_brake(mut drone);
    return boosted;
}
fn flight_brake(drone: mut Drone) -> unit {
    if drone.brake_ticks > 0u32 {
        var speed: f32 = length(drone.velocity);
        var removed: f32 = clamp(drone.brake_rate * STEP, 0f32, brake_amount(read drone));
        drone.brake_speed = drone.brake_speed + removed;
        if speed > 0f32 {
            drone.velocity = scale(drone.velocity, (speed - removed) / speed);
        }
        drone.brake_ticks = drone.brake_ticks - 1u32;
        if drone.brake_ticks == 0u32 {
            drone.brake_rate = 0f32;
        }
    }
}
// On incomplete coverage, discard the speculative drone and retry after admission.
fn simulate_admitted(
    collision: read CollisionScene,
    drone: mut Drone,
    command: Command,
    full_spin: bool,
    auto_level: bool
) -> CollisionAdmission {
    var admission: CollisionAdmission = collision_require_room(read collision, drone.world);
    if admission.status != 0u32 {
        return admission;
    }
    if command.tether && (
        drone.cable.phase == CABLE_FLYING || drone.cable.phase == CABLE_ATTACHED
    ) {
        admission = collision_require_room(read collision, drone.cable.space);
        if admission.status != 0u32 {
            return admission;
        }
    }
    drone.contact = flight_contact_empty();
    drone.step_frame = space_identity();
    orient(
        collision_room_frame(read collision, drone.world),
        mut drone,
        command.look,
        auto_level
    );
    var boosted: bool = flight_pulses(mut drone, command);
    tether_input(mut drone, command);
    var thrust: Vec3 = command.thrust;
    if boosted {
        thrust = vec(0f32, 0f32, 0f32);
    }
    if length(thrust) > 1f32 {
        thrust = unit_vector(thrust);
    }
    var acceleration: Vec3 = add(
        scale(
            flight_acceleration(
                collision_room_frame(read collision, drone.world),
                drone.position,
                scale(drone.velocity, drone_size(read drone)),
                full_spin
            ),
            1f32 / drone_size(read drone)
        ),
        scale(basis_vector(drone.basis, thrust), FLIGHT_THRUST_ACCELERATION)
    );
    drone.velocity = add(drone.velocity, scale(acceleration, STEP));
    var travel: Vec3 = scale(drone.velocity, STEP * drone_size(read drone));
    var end_time: f32 = (drone.clock + 1u32) as f32 * STEP;
    hook_follow(read collision, mut drone, end_time);
    admission = move_drone_interval_admitted(read collision, mut drone, travel, STEP);
    if admission.status != 0u32 {
        return admission;
    }
    admission = hook_step_admitted(read collision, mut drone, full_spin);
    if admission.status != 0u32 {
        return admission;
    }
    drone.clock = drone.clock + 1u32;
    return powered_winch(read collision, mut drone);
}

// Requires complete collision coverage for the tick.
fn simulate(
    collision: read CollisionScene,
    drone: mut Drone,
    command: Command,
    full_spin: bool,
    auto_level: bool
) -> unit {
    collision_require_complete(
        simulate_admitted(read collision, mut drone, command, full_spin, auto_level)
    );
}
