const FLIGHT_PULSE_TICKS: u32 = 30u32;
const FLIGHT_PULSE_SECONDS: f32 = 0.25f32;
fn flight_pulses(drone: mut Drone, command: Command) -> unit {
    if command.burst && drone.boost_ticks == 0u32 && burst_available(read drone) {
        use_charge(mut drone, BURST_CHARGE);
        drone.boost_ticks = FLIGHT_PULSE_TICKS;
        drone.bursts = drone.bursts + 1u32;
    }
    if command.brake && drone.brake_ticks == 0u32 {
        drone.brake_ticks = FLIGHT_PULSE_TICKS;
        drone.brake_rate = brake_amount(read drone) / FLIGHT_PULSE_SECONDS;
    }
    if drone.boost_ticks > 0u32 {
        drone.velocity = add(
            drone.velocity,
            scale(drone.basis.forward, 15f32 * STEP / FLIGHT_PULSE_SECONDS)
        );
        drone.boost_ticks = drone.boost_ticks - 1u32;
    }
    flight_brake(mut drone);
}
fn flight_brake(drone: mut Drone) -> unit {
    if drone.brake_ticks > 0u32 {
        var speed: f32 = length(drone.velocity);
        var removed: f32 = clamp(drone.brake_rate * STEP, 0f32, brake_amount(read drone));
        use_charge(mut drone, removed * BRAKE_CHARGE_PER_SPEED);
        drone.brake_speed = drone.brake_speed + removed;
        if speed > 0f32 {
            drone.velocity = scale(drone.velocity, (speed - removed) / speed);
        }
        drone.brake_ticks = drone.brake_ticks - 1u32;
        if drone.brake_ticks == 0u32 {
            drone.brake_rate = 0f32;
        }
    }
}
fn simulate(
    collision: read CollisionScene,
    drone: mut Drone,
    command: Command,
    full_spin: bool,
    auto_level: bool
) -> unit {
    drone.step_frame = space_identity();
    orient(mut drone, command.look, auto_level);
    flight_pulses(mut drone, command);
    tether_input(mut drone, command);
    var thrust: Vec3 = command.thrust;
    if length(thrust) > 1f32 {
        thrust = unit_vector(thrust);
    }
    var acceleration: Vec3 = add(
        flight_acceleration(drone.position, drone.velocity, full_spin),
        scale(basis_vector(drone.basis, thrust), 0.5f32)
    );
    drone.velocity = add(drone.velocity, scale(acceleration, STEP));
    var travel: Vec3 = scale(drone.velocity, STEP);
    var end_time: f32 = (drone.clock + 1u32) as f32 * STEP;
    hook_follow(read collision, mut drone, end_time);
    move_drone_interval(read collision, mut drone, travel, STEP);
    hook_step(read collision, mut drone, full_spin);
    drone.clock = drone.clock + 1u32;
    powered_winch(read collision, mut drone);
}
