record Command {
    thrust: Vec3;
    look: Vec3;
    reel: bool;
    // Enables a burst along thrust when the shared cooldown permits it.
    burst: bool;
    anchor: bool;
    brake: bool;
    tether: bool;
    restart: bool;
    spin: bool;
    assist: bool;
    preview: bool;
}
fn idle_command() -> Command {
    return make Command {
        thrust: vec(0f32, 0f32, 0f32),
        look: vec(0f32, 0f32, 0f32),
        reel: false,
        burst: false,
        anchor: false,
        brake: false,
        tether: false,
        restart: false,
        spin: false,
        assist: false,
        preview: false
    };
}

// Converts the shared held action to the selected movement scheme.
fn movement_command(command: Command, anchor_controls: bool) -> Command {
    var result: Command = command;
    if anchor_controls {
        result.anchor = result.burst;
        result.burst = false;
    }
    return result;
}
