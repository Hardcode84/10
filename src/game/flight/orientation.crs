fn turn_basis(b: Basis, axis: Vec3, angle: f32) -> Basis {
    var f: Vec3 = unit_vector(rotate(b.forward, axis, angle));
    var r: Vec3 = unit_vector(cross(rotate(b.up, axis, angle), f));
    return make Basis {
        right: r,
        up: cross(f, r),
        forward: f
    };
}
fn orient(frame: RoomFrame, drone: mut Drone, look: Vec3, auto_level: bool) -> unit {
    var factor: f32 = 1f32;
    if !auto_level {
        factor = 1.3f32;
    }
    // Look commands are radians per second. The cap also applies while tethered.
    var delta: Vec3 = scale(look, factor * STEP);
    var amount: f32 = length(delta);
    if amount > 3.14159265f32 * STEP {
        delta = scale(delta, 3.14159265f32 * STEP / amount);
    }
    drone.basis = turn_basis(drone.basis, drone.basis.up, delta.x);
    drone.basis = turn_basis(drone.basis, drone.basis.right, delta.y);
    if !auto_level {
        drone.basis = turn_basis(drone.basis, drone.basis.forward, delta.z);
        return;
    }
    var up: Vec3 = unit_vector(scale(drum_position(frame, drone.position), -1f32));
    var desired: Vec3 = sub(
        up,
        scale(drone.basis.forward, dot(up, drone.basis.forward))
    );
    if length(desired) < 0.0001f32 {
        return;
    }
    desired = unit_vector(desired);
    var angle: f32 = atan2f(
        dot(cross(drone.basis.up, desired), drone.basis.forward),
        dot(drone.basis.up, desired)
    );
    drone.basis = turn_basis(
        drone.basis,
        drone.basis.forward,
        clamp(angle, -1.57079633f32 * STEP, 1.57079633f32 * STEP)
    );
}
