record Trial {
    graph_run: bool;
    goal_world: u32;
    returning: bool;
    spawn: Drone;
    drone: Drone;
    tick: u32;
    finished: bool;
    started: bool;
    full_spin: bool;
    auto_level: bool;
    preview_enabled: bool;
    attempt: u32;
    preview_phase: f32;
}
fn new_trial() -> Trial {
    return make Trial {
        graph_run: false,
        goal_world: 0u32,
        returning: false,
        spawn: new_drone(),
        drone: new_drone(),
        tick: 0u32,
        finished: false,
        started: false,
        full_spin: false,
        auto_level: true,
        preview_enabled: true,
        attempt: 1u32,
        preview_phase: 0f32
    };
}
