record Trial {
    free_flight: bool;
    spawn: Drone;
    expedition: Expedition;
    drone: Drone;
    tick: u32;
    gate: u32;
    finished: bool;
    started: bool;
    full_spin: bool;
    auto_level: bool;
    preview_enabled: bool;
    attempt: u32;
    preview_phase: f32;
}
fn new_trial() -> Trial {
    return make Trial {
        free_flight: false,
        spawn: new_drone(),
        expedition: new_expedition(),
        drone: new_drone(),
        tick: 0u32,
        gate: 0u32,
        finished: false,
        started: false,
        full_spin: false,
        auto_level: true,
        preview_enabled: true,
        attempt: 1u32,
        preview_phase: 0f32
    };
}
