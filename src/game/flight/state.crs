record Trial {
    graph_run: bool;
    goal_world: u32;
    returning: bool;
    spawn: Drone;
    drone: Drone;
    tick: u32;
    finished: bool;
    started: bool;
    full_spin: bool;
    auto_level: bool;
    preview_enabled: bool;
    attempt: u32;
    preview_phase: f32;
}
fn new_trial() -> Trial {
    return make Trial {
        graph_run: false,
        goal_world: 0u32,
        returning: false,
        spawn: new_drone(),
        drone: new_drone(),
        tick: 0u32,
        finished: false,
        started: false,
        full_spin: false,
        auto_level: true,
        preview_enabled: true,
        attempt: 1u32,
        preview_phase: 0f32
    };
}

fn clone_trial(value: read Trial) -> Trial {
    return make Trial {
        graph_run: value.graph_run,
        goal_world: value.goal_world,
        returning: value.returning,
        spawn: clone_drone(read value.spawn),
        drone: clone_drone(read value.drone),
        tick: value.tick,
        finished: value.finished,
        started: value.started,
        full_spin: value.full_spin,
        auto_level: value.auto_level,
        preview_enabled: value.preview_enabled,
        attempt: value.attempt,
        preview_phase: value.preview_phase
    };
}

fn assign_trial(target: mut Trial, value: read Trial) -> unit {
    target.graph_run = value.graph_run;
    target.goal_world = value.goal_world;
    target.returning = value.returning;
    assign_drone(mut target.spawn, read value.spawn);
    assign_drone(mut target.drone, read value.drone);
    target.tick = value.tick;
    target.finished = value.finished;
    target.started = value.started;
    target.full_spin = value.full_spin;
    target.auto_level = value.auto_level;
    target.preview_enabled = value.preview_enabled;
    target.attempt = value.attempt;
    target.preview_phase = value.preview_phase;
}
