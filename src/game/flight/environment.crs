// Returns the displacement from the spin axis, in room-local metres.
fn drum_position(frame: RoomFrame, local: Vec3) -> Vec3 {
    var offset: Vec3 = sub(local, frame.axis_origin);
    return sub(offset, scale(frame.axis, dot(offset, frame.axis)));
}
fn spin_rate(full_spin: bool) -> f32 {
    if full_spin {
        return 0.0495f32;
    }
    return 0f32;
}
fn air_density(frame: RoomFrame, p: Vec3) -> f32 {
    var t: f32 = clamp(length(drum_position(frame, p)) / 4000f32, 0f32, 1f32);
    return 0.05f32 + 0.95f32 * t * t * (3f32 - 2f32 * t);
}
fn flight_acceleration(frame: RoomFrame, position: Vec3, velocity: Vec3, full_spin: bool) -> Vec3 {
    var omega: Vec3 = scale(frame.axis, spin_rate(full_spin));
    var coriolis: Vec3 = scale(cross(omega, velocity), -2f32);
    var gravity: Vec3 = scale(
        cross(omega, cross(omega, drum_position(frame, position))),
        -1f32
    );
    var drag: f32 = air_density(frame, position) * (0.08f32 + 0.012f32 * length(velocity));
    return add(
        sub(add(coriolis, gravity), scale(velocity, drag)),
        axis_attraction_acceleration(frame.attraction, position)
    );
}

// Inverse-radius pull outside the core; linear inside, with zero force on the axis.
fn axis_attraction_acceleration(field: AxisAttraction, position: Vec3) -> Vec3 {
    if field.strength == 0f32 {
        return vec(0f32, 0f32, 0f32);
    }
    var offset: Vec3 = sub(position, field.origin);
    offset = sub(offset, scale(field.axis, dot(offset, field.axis)));
    var squared: f32 = dot(offset, offset);
    var denominator: f32 = clamp(
        squared,
        field.core_radius * field.core_radius,
        3.4028234e38f32
    );
    return scale(offset, -field.strength * field.core_radius / denominator);
}
