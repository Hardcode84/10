fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && strcmp(argv[1usize], "--help") == 0i32 {
        puts("SPINWARD movement trial | stopped / full-spin course");
        puts("--width N --height N --fov 70..110 --slow --bindings FILE");
        puts("--record FILE | --replay FILE | --test");
        puts("--headless --ticks N --capture FILE --smoke");
        puts("WASD Ctrl/Space: move | mouse: look | Q/E: roll with level off");
        puts("RMB: burst | F: brake | LMB: hold tether | R/T or Space/Ctrl: reel");
        puts("Backspace: retry | F4: spin and retry | L: level | P: preview");
        puts("Tab: pause | Esc: exit. Focus loss pauses; Tab resumes.");
        puts("Pad: sticks move/look, shoulders vertical/reel, RT burst, LT tether");
        puts("Pad A brake, X retry, Y spin, Back level, B preview, Start pause");
        return 0i32;
    }
    var o: Launch = uninit;
    if !game_options(argc, argv, &o) {
        return 2i32;
    }
    if o.config.test {
        return (!game_tests()) as i32;
    }
    return game_run(game_session(&o), o.config);
}
fn game_check(good: bool, message: *u8) -> bool {
    if !good {
        return error(message);
    }
    return true;
}
