fn graph_lighting(scene: read CollisionScene, input: mut FrameInput, trial: read Trial) -> unit {
    if !trial.graph_run {
        return;
    }
    var lamp: LightObject = make LightObject {
        id: 2u32,
        space: 0u32,
        position: vec(0f32, 7f32, 0f32),
        colour: vec(1.6f32, 1.45f32, 1.2f32),
        radius: 16f32,
        mode: LIGHT_ROOM
    };
    light_object_anchors(read scene, mut input, lamp);
    lamp.id = 3u32;
    lamp.space = trial.goal_world;
    lamp.position = vec(0f32, 10f32, 0f32);
    lamp.radius = 12f32;
    light_object_anchors(read scene, mut input, lamp);
}
