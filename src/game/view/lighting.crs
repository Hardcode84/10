record LightObject {
    id: u32;
    space: u32;
    position: Vec3;
    colour: Vec3;
    radius: f32;
    mode: u32;
}
fn light_object_reach(light: LightObject) -> f32 {
    var peak: f32 = clamp(light.colour.x, light.colour.y, 3.4028234e38f32);
    peak = clamp(peak, light.colour.z, 3.4028234e38f32);
    return light.radius * clamp(sqrtf(7f32 * peak) - 1f32, 0f32, 3.4028234e38f32);
}
fn light_placement_submit(
    input: mut FrameInput,
    light: LightObject,
    anchor: RoomAnchor,
    radius: f32
) -> unit {
    var index: u32 = input_word(read input, LIGHT_COUNT as usize);
    if !input_lights(mut input, index + 1u32) {
        scene_overflow();
    }
    var point: Vec3 = space_point(anchor.transform, light.position);
    var p: usize = (input_word(read input, LIGHT_DATA as usize) + index * 8u32) as usize;
    input_set_float(mut input, p, point.x);
    input_set_float(mut input, p + 1usize, point.y);
    input_set_float(mut input, p + 2usize, point.z);
    input_set_float(mut input, p + 3usize, radius * radius);
    input_set_float(mut input, p + 4usize, light.colour.x);
    input_set_float(mut input, p + 5usize, light.colour.y);
    input_set_float(mut input, p + 6usize, light.colour.z);
    input_set_float(mut input, p + 7usize, light.mode as f32);
    input_light_space(mut input, index, anchor.space);
}
fn light_scaled_object_anchors(
    scene: read CollisionScene,
    input: mut FrameInput,
    light: LightObject,
    size: read Rational
) -> unit {
    var anchors: RoomAnchors = room_anchors_new();
    if !light_scaled_anchors(
        read scene,
        mut anchors,
        light,
        read size,
        input_word(read input, 4usize)
    ) {
        scene_overflow();
    }
    var count: u32 = input_word(read input, LIGHT_COUNT as usize);
    if !input_lights(mut input, count + room_anchor_count(read anchors)) {
        scene_overflow();
    }
    input_set_word(mut input, LIGHT_COUNT as usize, count);
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var placement: Rational = rational_product(
            read size,
            room_anchor_ratio(read anchors, i)
        );
        light_placement_submit(
            mut input,
            light,
            room_anchor(read anchors, i),
            light.radius * rational_float(read placement)
        );
        i = i + 1u32;
    }
}
fn game_object_lighting(scene: read CollisionScene, input: mut FrameInput, trial: read Trial) -> unit {
    input_set_word(mut input, LIGHT_COUNT as usize, 0u32);
    var player: LightObject = make LightObject {
        id: 0u32,
        space: trial.drone.world,
        position: trial.drone.position,
        colour: vec(1f32, 1f32, 1f32),
        radius: 6f32,
        mode: LIGHT_HEADLAMP
    };
    input_set_float(mut input, CAMERA_LIGHT as usize, 0f32);
    light_scaled_object_anchors(read scene, mut input, player, read trial.drone.size);
    hook_light(read scene, mut input, read trial.drone);
    graph_lighting(read scene, mut input, read trial);
}

fn light_object_anchors(
    scene: read CollisionScene,
    input: mut FrameInput,
    light: LightObject
) -> unit {
    var size: Rational = rational_new(1u64, 1u64);
    light_scaled_object_anchors(read scene, mut input, light, read size);
}
fn light_object_submit(input: mut FrameInput, light: LightObject, anchor: RoomAnchor) -> unit {
    light_placement_submit(
        mut input,
        light,
        anchor,
        light.radius * anchor.transform.factor
    );
}
