fn draw_cable(
    collision: read CollisionScene,
    v: mut FrameInput,
    drone: Drone,
    config: GameConfig
) -> unit {
    if drone.cable.phase != CABLE_ATTACHED && drone.cable.phase != CABLE_FLYING {
        return;
    }
    var mat: u32 = 4u32;
    var size: Vec3 = vec(HOOK_RADIUS, HOOK_RADIUS, HOOK_RADIUS);
    var physical: Vec3 = space_point(
        space_inverse(drone.cable.frame),
        drone.cable.anchor
    );
    var first: u32 = input_word(read v, 3usize);
    draw_solid(mut v, solid(sub(physical, size), add(physical, size), 5u32));
    game_dynamic_space(mut v, first, drone.cable.space);
    var start: Vec3 = add(
        drone.position,
        basis_vector(drone.basis, vec(0f32, -0.12f32, 0.2f32))
    );
    var middle: Vec3 = scale(add(start, drone.cable.anchor), 0.5f32);
    var slack: f32 = clamp(
        drone.cable.extent - length(sub(drone.position, drone.cable.anchor)),
        0f32,
        10f32
    );
    middle = add(
        middle,
        scale(unit_vector(drum_position(drone.position)), slack * 0.5f32)
    );
    if collision_portal_count(read collision) == 0u32 {
        draw_ribbon(mut v, start, middle, drone.position, 0.004f32, mat);
        draw_ribbon(mut v, middle, drone.cable.anchor, drone.position, 0.004f32, mat);
    } else {
        draw_portal_cable(read collision, mut v, drone, start, drone.cable.anchor, mat);
    }
    game_dynamic_no_shadow(mut v, first);
    var direction: Vec3 = unit_vector(sub(drone.cable.anchor, drone.position));
    if dot(direction, drone.basis.forward) < 0.5f32 {
        var x: f32 = dot(direction, drone.basis.right);
        var y: f32 = dot(direction, drone.basis.up);
        var m: f32 = sqrtf(x * x + y * y);
        if m < 0.001f32 {
            y = -1f32;
            m = 1f32;
        }
        frame_rect(
            mut v,
            drone,
            config,
            x / m * 0.12f32,
            y / m * 0.12f32,
            0.008f32,
            0.008f32,
            mat
        );
    }
}

fn draw_portal_cable(
    collision: read CollisionScene,
    v: mut FrameInput,
    drone: Drone,
    start: Vec3,
    end: Vec3,
    material: u32
) -> unit {
    var space: u32 = drone.world;
    var eye: Vec3 = drone.position;
    var count: u32 = 0u32;
    while count < 1024u32 {
        var travel: Vec3 = sub(end, start);
        var crossing: PortalCrossing = portal_crossing(read collision, space, start, travel);
        if crossing.time > 1f32 {
            var first: u32 = input_word(read v, 3usize);
            draw_ribbon(mut v, start, end, eye, 0.004f32, material);
            game_dynamic_space(mut v, first, space);
            return;
        }
        var point: Vec3 = add(start, scale(travel, crossing.time));
        var first: u32 = input_word(read v, 3usize);
        draw_ribbon(mut v, start, point, eye, 0.004f32, material);
        game_dynamic_space(mut v, first, space);
        var portal: CollisionPortal = collision_portal(read collision, crossing.index);
        start = space_point(portal.transform, point);
        end = space_point(portal.transform, end);
        eye = space_point(portal.transform, eye);
        space = portal.destination;
        count = count + 1u32;
    }
    scene_motion_failure();
}

fn hook_light_position(collision: read CollisionScene, drone: Drone) -> Vec3 {
    var point: Vec3 = space_point(
        space_inverse(drone.cable.frame),
        drone.cable.anchor
    );
    if drone.cable.phase == CABLE_ATTACHED {
        var pose: CollisionInstance = collision_pose(
            collision_instance(read collision, drone.cable.instance),
            drone.clock as f32 * STEP
        );
        point = add(
            point,
            scale(
                basis_vector(pose.basis, drone.cable.local_normal),
                HOOK_RADIUS * 2f32
            )
        );
    }
    return point;
}
fn hook_light(collision: read CollisionScene, input: mut FrameInput, drone: Drone) -> unit {
    var active: bool = drone.cable.phase == CABLE_FLYING || drone.cable.phase == CABLE_ATTACHED;
    input_set_word(mut input, LIGHT_COUNT as usize, active as u32);
    if !active {
        return;
    }
    var physical: Vec3 = hook_light_position(read collision, drone);
    var point: Vec3 = collision_local(
        drone.basis,
        sub(space_point(drone.cable.frame, physical), drone.position)
    );
    var p: usize = input_word(read input, LIGHT_DATA as usize) as usize;
    input_set_float(mut input, p, point.x);
    input_set_float(mut input, p + 1usize, point.y);
    input_set_float(mut input, p + 2usize, point.z);
    input_set_float(mut input, p + 3usize, 36f32);
    input_set_float(mut input, p + 4usize, 2f32);
    input_set_float(mut input, p + 5usize, 1.6f32);
    input_set_float(mut input, p + 6usize, 0.1f32);
    input_set_float(mut input, p + 7usize, LIGHT_VIEW as f32);
    input_light_space(mut input, 0u32, drone.cable.space);
}
