fn draw_cable(
    collision: read CollisionScene,
    v: mut FrameInput,
    drone: read Drone,
    config: GameConfig,
    anchors: mut RoomAnchors
) -> unit {
    if drone.cable.phase != CABLE_ATTACHED && drone.cable.phase != CABLE_FLYING {
        return;
    }
    var mat: u32 = 4u32;
    var physical: Vec3 = space_point(
        space_inverse(drone.cable.frame),
        drone.cable.anchor
    );
    var first: u32 = input_word(read v, 3usize);
    draw_hook_anchors(
        read collision,
        mut v,
        drone.cable.space,
        physical,
        read drone.cable.size,
        mut anchors
    );
    var start: Vec3 = add(
        drone.position,
        scale(
            basis_vector(drone.basis, vec(0f32, -0.12f32, 0.2f32)),
            drone_size(read drone)
        )
    );
    var middle: Vec3 = scale(add(start, drone.cable.anchor), 0.5f32);
    var slack: f32 = clamp(
        drone.cable.extent * drone_size(read drone) - length(
            sub(drone.position, drone.cable.anchor)
        ),
        0f32,
        10f32
    );
    middle = add(
        middle,
        scale(unit_vector(drum_position(drone.position)), slack * 0.5f32)
    );
    if collision_portal_count(read collision) == 0u32 {
        draw_ribbon(
            mut v,
            start,
            middle,
            drone.position,
            0.004f32 * drone_size(read drone),
            mat
        );
        draw_ribbon(
            mut v,
            middle,
            drone.cable.anchor,
            drone.position,
            0.004f32 * drone_size(read drone),
            mat
        );
    } else {
        draw_portal_cable(
            read collision,
            mut v,
            read drone,
            start,
            drone.cable.anchor,
            mat
        );
    }
    game_dynamic_no_shadow(mut v, first);
    var direction: Vec3 = unit_vector(sub(drone.cable.anchor, drone.position));
    if dot(direction, drone.basis.forward) < 0.5f32 {
        var x: f32 = dot(direction, drone.basis.right);
        var y: f32 = dot(direction, drone.basis.up);
        var m: f32 = sqrtf(x * x + y * y);
        if m < 0.001f32 {
            y = -1f32;
            m = 1f32;
        }
        frame_rect(
            mut v,
            read drone,
            config,
            x / m * 0.12f32,
            y / m * 0.12f32,
            0.008f32,
            0.008f32,
            mat
        );
    }
}

fn hook_light_position(collision: read CollisionScene, drone: read Drone) -> Vec3 {
    var point: Vec3 = space_point(
        space_inverse(drone.cable.frame),
        drone.cable.anchor
    );
    if drone.cable.phase == CABLE_ATTACHED {
        var pose: CollisionInstance = collision_pose(
            collision_instance(read collision, drone.cable.instance),
            drone.clock as f32 * STEP
        );
        point = add(
            point,
            scale(
                basis_vector(pose.basis, drone.cable.local_normal),
                hook_radius(read drone) * 2f32
            )
        );
    }
    return point;
}
fn hook_light(
    collision: read CollisionScene,
    input: mut FrameInput,
    drone: read Drone,
    anchors: mut RoomAnchors
) -> unit {
    if drone.cable.phase != CABLE_FLYING && drone.cable.phase != CABLE_ATTACHED {
        return;
    }
    var light: LightObject = make LightObject {
        id: 1u32,
        space: drone.cable.space,
        position: hook_light_position(read collision, read drone),
        colour: vec(2f32, 1.6f32, 0.1f32),
        radius: 6f32,
        mode: LIGHT_UNSHADOWED
    };
    light_scaled_object_anchors(
        read collision,
        mut input,
        light,
        read drone.cable.size,
        mut anchors
    );
}

fn draw_hook_anchors(
    scene: read CollisionScene,
    input: mut FrameInput,
    space: u32,
    point: Vec3,
    ratio: read Rational,
    anchors: mut RoomAnchors
) -> unit {
    room_anchors_clear(mut anchors);
    var still: Vec3 = vec(0f32, 0f32, 0f32);
    var body: CollisionBody = collision_body(HOOK_RADIUS * sqrtf(3f32), read ratio);
    if !collision_scaled_anchors(
        read scene,
        mut anchors,
        space,
        point,
        still,
        read body,
        false
    ) {
        scene_motion_failure();
    }
    var radius: f32 = HOOK_RADIUS;
    var size: Vec3 = vec(radius, radius, radius);
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        if anchor.cap != 0xffffffffu32 {
            i = i + 1u32;
            continue;
        }
        var placement: Rational = rational_product(
            read ratio,
            room_anchor_ratio(read anchors, i)
        );
        var centre: Vec3 = space_point(anchor.transform, point);
        anchor.transform.origin = centre;
        anchor.transform.factor = rational_float(read placement);
        var first: u32 = input_word(read input, 3usize);
        draw_solid(mut input, solid(scale(size, -1f32), size, 5u32));
        game_dynamic_anchor(mut input, first, anchor);
        i = i + 1u32;
    }
}
