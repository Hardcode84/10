fn hud_text(v: mut FrameInput, x: u32, y: u32, text: *u8) -> unit {
    var i: u32 = 0u32;
    while text[i as usize] != 0u8 && x + i < 80u32 {
        input_set_word(
            mut v,
            (OVERLAY_CELLS + y * 80u32 + x + i) as usize,
            text[i as usize] as u32
        );
        i = i + 1u32;
    }
}
fn hud_font(v: mut FrameInput) -> unit {
    var characters: *u8 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/-%.|";
    var i: usize = 0usize;
    while i < 40usize {
        var y: u32 = 0u32;
        while y < 8u32 {
            input_set_word(
                mut v,
                (OVERLAY_FONT + (characters[i] as u32) * 8u32 + y) as usize,
                ((font_glyph(characters[i] as u32) >> (y * 8u32) as u64) & 31u64) as u32
            );
            y = y + 1u32;
        }
        i = i + 1usize;
    }
    var y: u32 = 0u32;
    while y < 8u32 {
        input_set_word(mut v, (OVERLAY_FONT + 124u32 * 8u32 + y) as usize, 4u32);
        y = y + 1u32;
    }
}

// Returns a null-terminated duration in minutes and seconds.
fn completion_time(ticks: u32) -> [u8; 32] {
    var text: [u8; 32] = uninit;
    var i: usize = 0usize;
    while i < 32usize {
        text[i] = 0u8;
        i = i + 1usize;
    }
    memcpy(&text[0usize], "TIME ", 5usize);
    var count: usize = 5usize + decimal_u32(&text[5usize], ticks / 7200u32, 1u32);
    memcpy(&text[count], "M ", 2usize);
    count = count + 2usize;
    count = count + decimal_u32(&text[count], (ticks / 120u32) % 60u32, 2u32);
    text[count] = 83u8;
    return text;
}

fn hud_completion(v: mut FrameInput, ticks: u32) -> unit {
    var text: [u8; 32] = completion_time(ticks);
    hud_text(mut v, 38u32, 0u32, &text[0usize]);
}
