// Draws all body placements, including overlap across a connection.
fn draw_drone(
    scene: read CollisionScene,
    input: mut FrameInput,
    mesh: MeshRange,
    drone: read Drone,
    anchors: mut RoomAnchors
) -> unit {
    room_anchors_clear(mut anchors);
    var body: CollisionBody = flight_body(read drone);
    if !collision_scaled_anchors(
        read scene,
        mut anchors,
        drone.world,
        drone.position,
        vec(0f32, 0f32, 0f32),
        read body,
        false
    ) {
        scene_motion_failure();
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        var pose: SpaceTransform = space_compose(
            anchor.transform,
            make SpaceTransform {
                factor: drone_size(read drone),
                origin: drone.position,
                basis: drone.basis
            }
        );
        var size: Rational = rational_product(
            read drone.size,
            room_anchor_ratio(read anchors, i)
        );
        pose.factor = rational_float(read size);
        if anchor.cap == 0xffffffffu32 {
            var instance: MeshInstance = mesh_identity(mesh, anchor.space);
            instance.transform = make [f32; 12] {
                pose.basis.right.x * pose.factor,
                pose.basis.up.x * pose.factor,
                pose.basis.forward.x * pose.factor,
                pose.origin.x,
                pose.basis.right.y * pose.factor,
                pose.basis.up.y * pose.factor,
                pose.basis.forward.y * pose.factor,
                pose.origin.y,
                pose.basis.right.z * pose.factor,
                pose.basis.up.z * pose.factor,
                pose.basis.forward.z * pose.factor,
                pose.origin.z
            };
            if !input_instance(mut input, instance) {
                scene_overflow();
            }
        }
        i = i + 1u32;
    }
}

// Submits a uniformly scaled placement, preserving UVs and surface flags.
fn draw_mesh(input: mut FrameInput, mesh: read Mesh, space: u32, pose: SpaceTransform) -> unit {
    var i: u32 = 0u32;
    while i < mesh_triangle_count(read mesh) {
        var face: MeshTriangle = placed_triangle(
            mesh_triangle(read mesh, i),
            pose.origin,
            make Basis {
                right: scale(pose.basis.right, pose.factor),
                up: scale(pose.basis.up, pose.factor),
                forward: scale(pose.basis.forward, pose.factor)
            }
        );
        var a: MeshVertex = face.vertices[0usize];
        var b: MeshVertex = face.vertices[1usize];
        var c: MeshVertex = face.vertices[2usize];
        triangle_uv(
            mut input,
            space,
            face.material,
            face.portal,
            face.flags,
            a.x,
            a.y,
            a.z,
            b.x,
            b.y,
            b.z,
            c.x,
            c.y,
            c.z,
            a.u,
            a.v,
            b.u,
            b.v,
            c.u,
            c.v
        );
        i = i + 1u32;
    }
}
