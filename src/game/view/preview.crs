const PREVIEW_SPACING: f32 = 4f32;
const PREVIEW_MARKERS: u32 = 8u32;
fn preview_border_pixels(config: GameConfig) -> u32 {
    var width: u32 = (config.width + 639u32) / 640u32;
    var height: u32 = (config.height + 479u32) / 480u32;
    if width > height {
        return width;
    }
    return height;
}
fn preview_pixel_size(center: Vec3, drone: Drone, config: GameConfig) -> f32 {
    var depth: f32 = dot(sub(center, drone.position), drone.basis.forward);
    var angle: f32 = config.fov * 0.00872664626f32;
    return 2f32 * depth * sinf(angle) / (cosf(angle) * config.height as f32);
}
fn draw_preview_marker(
    v: mut FrameInput,
    center: Vec3,
    drone: Drone,
    config: GameConfig,
    material: u32
) -> unit {
    if length(sub(center, drone.position)) < 6f32 {
        return;
    }
    var pixel: f32 = preview_pixel_size(center, drone, config) * preview_border_pixels(config) as f32;
    if pixel <= 0f32 {
        return;
    }
    if material == HOOK_PREVIEW_MATERIAL {
        draw_hook_marker(mut v, center, drone.basis, pixel);
        return;
    }
    if pixel >= 0.12f32 {
        return;
    }
    var outer: f32 = 0.12f32 + pixel * 0.5f32;
    var inner: f32 = 0.12f32 - pixel * 0.5f32;
    var r: Vec3 = drone.basis.right;
    var u: Vec3 = drone.basis.up;
    var edge: u32 = 0u32;
    while edge < 4u32 {
        var a: Vec3 = sub(scale(r, -1f32), u);
        var b: Vec3 = sub(r, u);
        game_quad(
            mut v,
            material,
            add(center, scale(a, outer)),
            add(center, scale(b, outer)),
            add(center, scale(b, inner)),
            add(center, scale(a, inner))
        );
        var next: Vec3 = scale(r, -1f32);
        r = u;
        u = next;
        edge = edge + 1u32;
    }
}
record PreviewTrail {
    distance: f32;
    markers: u32;
    limit: u32;
    material: u32;
}
fn preview_trail(limit: u32, material: u32, phase: f32) -> PreviewTrail {
    return make PreviewTrail {
        distance: phase,
        markers: 0u32,
        limit: limit,
        material: material
    };
}
fn draw_preview_segment(
    v: mut FrameInput,
    trail: mut PreviewTrail,
    before: Vec3,
    after: Vec3,
    eye: Drone,
    config: GameConfig
) -> unit {
    var travel: Vec3 = sub(after, before);
    var segment: f32 = length(travel);
    var next: f32 = (trail.markers + 1u32) as f32 * PREVIEW_SPACING;
    while segment > 0f32 && next <= trail.distance + segment && trail.markers < trail.limit {
        var point: Vec3 = preview_station(before, after, trail.distance, next);
        var first: u32 = input_word(read v, 3usize);
        draw_preview_marker(mut v, point, eye, config, trail.material);
        game_dynamic_space(mut v, first, eye.world);
        game_dynamic_no_shadow(mut v, first);
        trail.markers = trail.markers + 1u32;
        next = (trail.markers + 1u32) as f32 * PREVIEW_SPACING;
    }
    trail.distance = trail.distance + segment;
}
fn draw_preview(
    collision: read CollisionScene,
    v: mut FrameInput,
    trial: read Trial,
    config: GameConfig
) -> unit {
    var hook_ready: bool = trial.drone.cable.phase == CABLE_READY && trial.preview_enabled;
    var limit: u32 = PREVIEW_MARKERS;
    if hook_ready {
        limit = PREVIEW_MARKERS / 2u32;
    }
    var used: u32 = draw_drone_preview(read collision, mut v, read trial, config, limit);
    if hook_ready {
        draw_hook_preview(read collision, mut v, read trial, config, PREVIEW_MARKERS - used);
    }
}
fn draw_drone_preview(
    collision: read CollisionScene,
    v: mut FrameInput,
    trial: read Trial,
    config: GameConfig,
    limit: u32
) -> u32 {
    if !trial.preview_enabled {
        return 0u32;
    }
    var drone: Drone = trial.drone;
    var eye: Drone = trial.drone;
    var command: Command = idle_command();
    command.tether = drone.cable.phase == CABLE_ATTACHED || drone.cable.phase == CABLE_FLYING;
    var i: u32 = 0u32;
    var trail: PreviewTrail = preview_trail(limit, PREVIEW_MATERIAL, trial.preview_phase);
    while i < 240u32 && trail.markers < trail.limit {
        var before: Vec3 = drone.position;
        simulate(read collision, mut drone, command, trial.full_spin, trial.auto_level);
        draw_portal_preview(
            read collision,
            mut v,
            mut trail,
            before,
            space_point(space_inverse(drone.step_frame), drone.position),
            eye,
            config
        );
        eye = preview_eye(eye, drone.step_frame, drone.world);
        i = i + 1u32;
    }
    return trail.markers;
}
fn frame_point(drone: Drone, config: GameConfig, x: f32, y: f32) -> Vec3 {
    var angle: f32 = config.fov * 0.00872664626f32;
    var tangent: f32 = sinf(angle) / cosf(angle);
    return add(
        drone.position,
        basis_vector(drone.basis, vec(x * tangent, y * tangent, 0.15f32))
    );
}
fn frame_rect(
    v: mut FrameInput,
    drone: Drone,
    config: GameConfig,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    mat: u32
) -> unit {
    var first: u32 = input_word(read v, 3usize);
    game_quad(
        mut v,
        mat,
        frame_point(drone, config, x, y),
        frame_point(drone, config, x + w, y),
        frame_point(drone, config, x + w, y + h),
        frame_point(drone, config, x, y + h)
    );
    game_dynamic_no_shadow(mut v, first);
}
fn draw_frame(v: mut FrameInput, drone: Drone, config: GameConfig) -> unit {
    var aspect: f32 = config.width as f32 / config.height as f32;
    frame_rect(mut v, drone, config, -0.035f32, 0.13f32, 0.07f32, 0.02f32, 7u32);
    frame_rect(
        mut v,
        drone,
        config,
        -0.15f32 * aspect,
        -0.15f32,
        0.025f32,
        0.06f32,
        7u32
    );
    frame_rect(
        mut v,
        drone,
        config,
        0.15f32 * aspect - 0.025f32,
        -0.15f32,
        0.025f32,
        0.06f32,
        7u32
    );
    frame_rect(mut v, drone, config, -0.0005f32, -0.004f32, 0.001f32, 0.008f32, 4u32);
    frame_rect(mut v, drone, config, -0.004f32, -0.0005f32, 0.008f32, 0.001f32, 4u32);
}

fn preview_eye(eye: Drone, transform: SpaceTransform, space: u32) -> Drone {
    eye.position = space_point(transform, eye.position);
    eye.basis = space_basis(transform, eye.basis);
    eye.world = space;
    return eye;
}
fn draw_portal_preview(
    collision: read CollisionScene,
    v: mut FrameInput,
    trail: mut PreviewTrail,
    before: Vec3,
    after: Vec3,
    eye: Drone,
    config: GameConfig
) -> unit {
    var crossings: u32 = 0u32;
    while crossings < 1024u32 {
        var travel: Vec3 = sub(after, before);
        var crossing: PortalCrossing = portal_crossing(
            read collision,
            eye.world,
            before,
            travel
        );
        if crossing.time > 1f32 {
            draw_preview_segment(mut v, mut trail, before, after, eye, config);
            return;
        }
        var point: Vec3 = add(before, scale(travel, crossing.time));
        draw_preview_segment(mut v, mut trail, before, point, eye, config);
        var portal: CollisionPortal = collision_portal(read collision, crossing.index);
        before = space_point(portal.transform, point);
        after = space_point(portal.transform, after);
        eye = preview_eye(eye, portal.transform, portal.destination);
        crossings = crossings + 1u32;
    }
    scene_motion_failure();
}
