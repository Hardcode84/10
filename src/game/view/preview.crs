fn preview_border_pixels(config: GameConfig) -> u32 {
    var width: u32 = (config.width + 639u32) / 640u32;
    var height: u32 = (config.height + 479u32) / 480u32;
    if width > height {
        return width;
    }
    return height;
}
fn preview_pixel_size(center: Vec3, drone: PredictionEye, config: GameConfig) -> f32 {
    var depth: f32 = dot(sub(center, drone.position), drone.basis.forward);
    var angle: f32 = config.fov * 0.00872664626f32;
    return 2f32 * depth * sinf(angle) / (cosf(angle) * config.height as f32);
}
fn draw_preview_marker(
    v: mut FrameInput,
    center: Vec3,
    drone: PredictionEye,
    config: GameConfig,
    material: u32
) -> unit {
    var pixel: f32 = preview_pixel_size(center, drone, config) * preview_border_pixels(config) as f32;
    if pixel <= 0f32 {
        return;
    }
    if material == HOOK_PREVIEW_MATERIAL {
        draw_hook_marker(mut v, center, drone.basis, pixel, drone.factor);
        return;
    }
    if pixel >= 0.12f32 * drone.factor {
        return;
    }
    var outer: f32 = 0.12f32 * drone.factor + pixel * 0.5f32;
    var inner: f32 = 0.12f32 * drone.factor - pixel * 0.5f32;
    var r: Vec3 = drone.basis.right;
    var u: Vec3 = drone.basis.up;
    var edge: u32 = 0u32;
    while edge < 4u32 {
        var a: Vec3 = sub(scale(r, -1f32), u);
        var b: Vec3 = sub(r, u);
        game_quad(
            mut v,
            material,
            add(center, scale(a, outer)),
            add(center, scale(b, outer)),
            add(center, scale(b, inner)),
            add(center, scale(a, inner))
        );
        var next: Vec3 = scale(r, -1f32);
        r = u;
        u = next;
        edge = edge + 1u32;
    }
}
fn draw_preview(
    collision: read CollisionScene,
    v: mut FrameInput,
    trial: read Trial,
    config: GameConfig
) -> unit {
    var prediction: Prediction = predict_paths(read collision, read trial);
    draw_prediction(mut v, read prediction, config);
}
fn draw_prediction(v: mut FrameInput, prediction: read Prediction, config: GameConfig) -> unit {
    var i: u32 = 0u32;
    while i < prediction.count {
        var marker: PredictionMarker = prediction.markers[i as usize];
        var first: u32 = input_word(read v, 3usize);
        draw_preview_marker(mut v, marker.center, marker.eye, config, marker.material);
        game_dynamic_space(mut v, first, marker.eye.world);
        game_dynamic_no_shadow(mut v, first);
        while first < input_word(read v, 3usize) {
            var flags: usize = (input_word(read v, META as usize) + first * 4u32 + 3u32) as usize;
            var value: u32 = input_word(read v, flags) | TRIANGLE_DETAIL_NEAR;
            input_set_word(mut v, flags, value);
            first = first + 1u32;
        }
        i = i + 1u32;
    }
}
fn frame_point(drone: read Drone, config: GameConfig, x: f32, y: f32) -> Vec3 {
    var angle: f32 = config.fov * 0.00872664626f32;
    var tangent: f32 = sinf(angle) / cosf(angle);
    return add(
        drone.position,
        scale(
            basis_vector(drone.basis, vec(x * tangent, y * tangent, 0.15f32)),
            drone_size(read drone)
        )
    );
}
fn frame_rect(
    v: mut FrameInput,
    drone: read Drone,
    config: GameConfig,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    mat: u32
) -> unit {
    var first: u32 = input_word(read v, 3usize);
    game_quad(
        mut v,
        mat,
        frame_point(read drone, config, x, y),
        frame_point(read drone, config, x + w, y),
        frame_point(read drone, config, x + w, y + h),
        frame_point(read drone, config, x, y + h)
    );
    game_dynamic_no_shadow(mut v, first);
}
fn draw_frame(v: mut FrameInput, drone: read Drone, config: GameConfig) -> unit {
    var aspect: f32 = config.width as f32 / config.height as f32;
    frame_rect(mut v, read drone, config, -0.035f32, 0.13f32, 0.07f32, 0.02f32, 7u32);
    frame_rect(
        mut v,
        read drone,
        config,
        -0.15f32 * aspect,
        -0.15f32,
        0.025f32,
        0.06f32,
        7u32
    );
    draw_burst_console(mut v, read drone, config);
    frame_rect(
        mut v,
        read drone,
        config,
        -0.0005f32,
        -0.004f32,
        0.001f32,
        0.008f32,
        4u32
    );
    frame_rect(
        mut v,
        read drone,
        config,
        -0.004f32,
        -0.0005f32,
        0.008f32,
        0.001f32,
        4u32
    );
}
