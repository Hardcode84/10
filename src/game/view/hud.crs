fn hud_number(v: mut FrameInput, column: u32, row: u32, value: u32) -> unit {
    var n: u32 = value;
    var index: u32 = 0u32;
    while index < 6u32 {
        input_set_word(
            mut v,
            (OVERLAY_CELLS + row * 80u32 + column + 5u32 - index) as usize,
            48u32 + n % 10u32
        );
        n = n / 10u32;
        index = index + 1u32;
    }
}
fn game_hud(v: mut FrameInput, trial: read Trial, paused: bool) -> unit {
    input_set_word(mut v, OVERLAY_ENABLED as usize, 1u32);
    input_set_word(mut v, OVERLAY_COLOR as usize, 0xffd8e8e8u32);
    input_set_word(mut v, (OVERLAY_COLOR + 1u32) as usize, 0xff181410u32);
    var i: u32 = 0u32;
    while i < 480u32 {
        input_set_word(mut v, (OVERLAY_CELLS + i) as usize, 0u32);
        i = i + 1u32;
    }
    hud_size(mut v, drone_size(read trial.drone));
    if trial.graph_run {
        graph_hud(mut v, read trial, paused);
        return;
    }
    hud_text(mut v, 0u32, 0u32, "STOPPED");
    if trial.full_spin {
        hud_text(mut v, 0u32, 0u32, "FULL SPIN");
    }
    hud_text(mut v, 12u32, 0u32, "TIME MS");
    hud_number(mut v, 20u32, 0u32, trial.tick * 1000u32 / 120u32);

    hud_text(mut v, 42u32, 0u32, "SPEED");
    hud_number(mut v, 48u32, 0u32, length(trial.drone.velocity) as u32);
    hud_text(mut v, 56u32, 0u32, "M/S");
    hud_text(mut v, 61u32, 0u32, "ROOM FLIGHT");
    hud_text(mut v, 0u32, 1u32, "HOOK");
    hud_text(mut v, 5u32, 1u32, "READY");
    if trial.drone.cable.phase == CABLE_FLYING {
        hud_text(mut v, 5u32, 1u32, "FLYING");
    } else if trial.drone.cable.phase == CABLE_ATTACHED {
        hud_text(mut v, 5u32, 1u32, "ATTACHED");
        if trial.drone.cable.reeling {
            hud_text(mut v, 5u32, 1u32, "REELING ");
        }
    } else if trial.drone.cable.phase == CABLE_BLOCKED {
        hud_text(mut v, 5u32, 1u32, "BLOCKED: RELEASE");
    } else if trial.drone.cable.phase == CABLE_SNAPPED {
        hud_text(mut v, 5u32, 1u32, "SNAP: RELEASE");
    }
    hud_text(mut v, 20u32, 1u32, "CABLE M");
    var cable_length: f32 = trial.drone.cable.extent;
    if trial.drone.cable.phase == CABLE_FLYING {
        cable_length = length(sub(trial.drone.cable.anchor, trial.drone.position)) / drone_size(
            read trial.drone
        );
    }
    hud_number(mut v, 28u32, 1u32, cable_length as u32);
    hud_text(mut v, 36u32, 1u32, "BURSTS");
    hud_number(mut v, 43u32, 1u32, trial.drone.bursts);
    hud_text(mut v, 51u32, 1u32, "CHARGE UNLIMITED");
    hud_text(mut v, 0u32, 2u32, "AUTO LEVEL");
    hud_number(mut v, 11u32, 2u32, trial.auto_level as u32);
    hud_text(mut v, 19u32, 2u32, "PREVIEW 0 OFF 1 ON");
    hud_number(mut v, 38u32, 2u32, trial.preview_enabled as u32);
    hud_text(mut v, 0u32, 3u32, "WASD SPACE CTRL MOVE | MOUSE LOOK | RMB BURST | F BRAKE");
    hud_text(mut v, 0u32, 4u32, "LMB TETHER | R REEL | F4 SPIN | L LEVEL | P PREVIEW");
    hud_text(mut v, 0u32, 5u32, "BACKSPACE RETRY | TAB PAUSE | ESC EXIT");

    hud_text(
        mut v,
        0u32,
        5u32,
        "BACKSPACE RESET | TAB PAUSE | ESC EXIT | FLY THROUGH HEX PORTALS    "
    );
    if paused {
        hud_text(
            mut v,
            0u32,
            5u32,
            "PAUSED - TAB TO RESUME                                            "
        );
    }
    if trial.finished {
        hud_text(
            mut v,
            0u32,
            5u32,
            "FINISHED - BACKSPACE TO RETRY                                     "
        );
    }
}

fn hud_fps(v: mut FrameInput, fps: u32, paused: bool) -> unit {
    var i: u32 = 0u32;
    while i < 80u32 {
        input_set_word(mut v, (OVERLAY_CELLS + 400u32 + i) as usize, 0u32);
        i = i + 1u32;
    }
    hud_text(mut v, 0u32, 5u32, "FPS");
    hud_number(mut v, 4u32, 5u32, fps);
    hud_text(mut v, 11u32, 5u32, "TAB PAUSE / ESC EXIT / BACKSPACE RESTART");
    if paused {
        hud_text(mut v, 11u32, 5u32, "PAUSED - TAB TO RESUME                 ");
    }
}

fn hud_size(input: mut FrameInput, factor: f32) -> unit {
    var exponent: i32 = 0i32;
    while factor >= 10f32 {
        factor = factor * 0.1f32;
        exponent = exponent + 1i32;
    }
    while factor < 1f32 {
        factor = factor * 10f32;
        exponent = exponent - 1i32;
    }
    hud_text(mut input, 60u32, 2u32, "SIZE");
    var digits: u32 = (factor * 1000f32 + 0.5f32) as u32;
    if digits == 10000u32 {
        digits = 1000u32;
        exponent = exponent + 1i32;
    }
    hud_number(mut input, 65u32, 2u32, digits);
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 65u32) as usize,
        48u32 + digits / 1000u32
    );
    input_set_word(mut input, (OVERLAY_CELLS + 2u32 * 80u32 + 66u32) as usize, 46u32);
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 67u32) as usize,
        48u32 + digits / 100u32 % 10u32
    );
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 68u32) as usize,
        48u32 + digits / 10u32 % 10u32
    );
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 69u32) as usize,
        48u32 + digits % 10u32
    );
    hud_text(mut input, 70u32, 2u32, "E+");
    if exponent < 0i32 {
        hud_text(mut input, 71u32, 2u32, "-");
        exponent = -exponent;
    }
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 72u32) as usize,
        48u32 + exponent as u32 / 10u32
    );
    input_set_word(
        mut input,
        (OVERLAY_CELLS + 2u32 * 80u32 + 73u32) as usize,
        48u32 + exponent as u32 % 10u32
    );
}
