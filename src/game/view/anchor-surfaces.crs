const ANCHOR_PREVIEW_RADIUS: f32 = 10f32;
const ANCHOR_WIRE_LIFT: f32 = 0.02f32;
fn draw_anchor_surface(
    input: mut FrameInput,
    scene: read CollisionScene,
    eye: PredictionEye,
    clip_depth: f32,
    config: GameConfig,
    query: BoundaryQuery,
    hit: BoundaryContact
) -> unit {
    var item: CollisionInstance = collision_instance(read scene, hit.instance);
    var face: CollisionFace = collision_face(read scene, item.chunk, query.face);
    var lift: Vec3 = scale(hit.normal, ANCHOR_WIRE_LIFT * eye.factor);
    var edge: u32 = 0u32;
    while edge < 3u32 {
        var a: Vec3 = add(
            item.origin,
            basis_vector(item.basis, collision_corner(face, edge))
        );
        var b: Vec3 = add(
            item.origin,
            basis_vector(item.basis, collision_corner(face, (edge + 1u32) % 3u32))
        );
        draw_anchor_edge(
            mut input,
            eye,
            clip_depth,
            config,
            add(a, lift),
            add(b, lift)
        );
        edge = edge + 1u32;
    }
}
// Shows nearby resident hulls through portal placements while anchor input is held.
fn draw_anchor_surfaces(
    scene: read CollisionScene,
    input: mut FrameInput,
    drone: read Drone,
    config: GameConfig,
    anchors: mut RoomAnchors
) -> unit {
    if !drone.wall_anchor.enabled || !drone.wall_anchor.held {
        return;
    }
    room_anchors_clear(mut anchors);
    if !view_sphere_anchors(
        read scene,
        mut anchors,
        primary_anchor(0u32, drone.world),
        drone.position,
        ANCHOR_PREVIEW_RADIUS,
        ANCHOR_PREVIEW_RADIUS,
        read drone.size,
        input_word(read input, 31usize)
    ) {
        scene_overflow();
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        if collision_room_resident(read scene, anchor.space) {
            var size: Rational = rational_product(
                read drone.size,
                room_anchor_ratio(read anchors, i)
            );
            var eye: PredictionEye = make PredictionEye {
                position: space_point(anchor.transform, drone.position),
                basis: space_orthogonal(space_basis(anchor.transform, drone.basis)),
                world: anchor.space,
                factor: rational_float(read size)
            };
            var clip_depth: f32 = input_float(read input, RENDER_STYLE as usize) * anchor.transform.factor;
            draw_anchor_room(read scene, mut input, eye, clip_depth, config);
        }
        i = i + 1u32;
    }
}
fn draw_anchor_room(
    scene: read CollisionScene,
    input: mut FrameInput,
    eye: PredictionEye,
    clip_depth: f32,
    config: GameConfig
) -> unit {
    var query: BoundaryQuery = collision_boundary_begin(
        read scene,
        eye.world,
        eye.position,
        ANCHOR_PREVIEW_RADIUS * eye.factor,
        vec(0f32, 0f32, 0f32)
    );
    var first: u32 = input_word(read input, 3usize);
    while true {
        var hit: BoundaryContact = collision_boundary_nearby(read scene, mut query);
        if !hit.found {
            break;
        }
        draw_anchor_surface(mut input, read scene, eye, clip_depth, config, query, hit);
    }
    game_dynamic_space(mut input, first, eye.world);
    game_dynamic_no_shadow(mut input, first);
}

fn draw_anchor_edge(
    input: mut FrameInput,
    eye: PredictionEye,
    clip_depth: f32,
    config: GameConfig,
    a: Vec3,
    b: Vec3
) -> unit {
    var start: Vec3 = a;
    var end: Vec3 = b;
    var da: f32 = dot(sub(a, eye.position), eye.basis.forward);
    var db: f32 = dot(sub(b, eye.position), eye.basis.forward);
    if da < clip_depth && db < clip_depth {
        return;
    }
    if da < clip_depth {
        start = add(a, scale(sub(b, a), (clip_depth - da) / (db - da)));
    }
    if db < clip_depth {
        end = add(b, scale(sub(a, b), (clip_depth - db) / (da - db)));
    }
    var width: f32 = 0.5f32 * preview_border_pixels(config) as f32;
    var aw: f32 = preview_pixel_size(start, eye, config) * width;
    var bw: f32 = preview_pixel_size(end, eye, config) * width;
    if aw <= 0f32 && bw <= 0f32 {
        return;
    }
    var side: Vec3 = anchor_wire_side(eye, start, end);
    if length(side) == 0f32 {
        return;
    }
    var offset_a: Vec3 = scale(side, aw);
    var offset_b: Vec3 = scale(side, bw);
    game_quad(
        mut input,
        CONSOLE_READY,
        sub(start, offset_a),
        add(start, offset_a),
        add(end, offset_b),
        sub(end, offset_b)
    );
}

// Requires both endpoints in front of the eye. Returns a unit screen-plane
// vector perpendicular to the projected edge, or zero for a projected point.
fn anchor_wire_side(eye: PredictionEye, start: Vec3, end: Vec3) -> Vec3 {
    var a: Vec3 = sub(start, eye.position);
    var b: Vec3 = sub(end, eye.position);
    var az: f32 = dot(a, eye.basis.forward);
    var bz: f32 = dot(b, eye.basis.forward);
    var dx: f32 = dot(b, eye.basis.right) / bz - dot(a, eye.basis.right) / az;
    var dy: f32 = dot(b, eye.basis.up) / bz - dot(a, eye.basis.up) / az;
    var magnitude: f32 = sqrtf(dx * dx + dy * dy);
    if magnitude == 0f32 {
        return vec(0f32, 0f32, 0f32);
    }
    return add(
        scale(eye.basis.right, -dy / magnitude),
        scale(eye.basis.up, dx / magnitude)
    );
}
