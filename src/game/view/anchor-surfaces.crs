const ANCHOR_PREVIEW_RADIUS: f32 = 10f32;
const ANCHOR_SURFACE_LIFT: f32 = 0.02f32;
const ANCHOR_DOT_PERIOD: f32 = 0.5f32;
// Shows nearby resident hulls through portal placements while anchor input is held.
fn draw_anchor_surfaces(
    scene: read CollisionScene,
    input: mut FrameInput,
    drone: read Drone,
    anchors: mut RoomAnchors
) -> unit {
    if !drone.wall_anchor.enabled || !drone.wall_anchor.held {
        return;
    }
    room_anchors_clear(mut anchors);
    if !view_sphere_anchors(
        read scene,
        mut anchors,
        primary_anchor(0u32, drone.world),
        drone.position,
        ANCHOR_PREVIEW_RADIUS,
        ANCHOR_PREVIEW_RADIUS,
        read drone.size,
        input_word(read input, 31usize)
    ) {
        scene_overflow();
    }
    var i: u32 = 0u32;
    while i < room_anchor_count(read anchors) {
        var anchor: RoomAnchor = room_anchor(read anchors, i);
        if collision_room_resident(read scene, anchor.space) {
            var size: Rational = rational_product(
                read drone.size,
                room_anchor_ratio(read anchors, i)
            );
            var eye: PredictionEye = make PredictionEye {
                position: space_point(anchor.transform, drone.position),
                basis: space_orthogonal(space_basis(anchor.transform, drone.basis)),
                world: anchor.space,
                factor: rational_float(read size)
            };
            draw_anchor_room(read scene, mut input, eye);
        }
        i = i + 1u32;
    }
}
fn draw_anchor_room(scene: read CollisionScene, input: mut FrameInput, eye: PredictionEye) -> unit {
    var query: BoundaryQuery = collision_boundary_begin(
        read scene,
        eye.world,
        eye.position,
        ANCHOR_PREVIEW_RADIUS * eye.factor,
        vec(0f32, 0f32, 0f32)
    );
    var first: u32 = input_word(read input, 3usize);
    while true {
        var hit: BoundaryContact = collision_boundary_nearby(read scene, mut query);
        if !hit.found {
            break;
        }
        draw_anchor_surface(mut input, read scene, eye, query, hit);
    }
    game_dynamic_space(mut input, first, eye.world);
    game_dynamic_no_shadow(mut input, first);
}

fn anchor_dot_uv(point: Vec3, normal: Vec3) -> Vec3 {
    var axis: u32 = 0u32;
    if absf(normal.y) > absf(normal.x) {
        axis = 1u32;
    }
    if absf(normal.z) > absf(component(normal, axis)) {
        axis = 2u32;
    }
    return vec(
        component(point, (axis + 1u32) % 3u32) / ANCHOR_DOT_PERIOD,
        component(point, (axis + 2u32) % 3u32) / ANCHOR_DOT_PERIOD,
        0f32
    );
}
fn draw_anchor_surface(
    input: mut FrameInput,
    scene: read CollisionScene,
    eye: PredictionEye,
    query: BoundaryQuery,
    hit: BoundaryContact
) -> unit {
    var item: CollisionInstance = collision_instance(read scene, hit.instance);
    var face: CollisionFace = collision_face(read scene, item.chunk, query.face);
    var patch: AnchorPatch = anchor_patch(
        add(item.origin, basis_vector(item.basis, face.a)),
        add(item.origin, basis_vector(item.basis, face.b)),
        add(item.origin, basis_vector(item.basis, face.c)),
        hit.normal,
        eye.position,
        ANCHOR_PREVIEW_RADIUS * eye.factor
    );
    var i: usize = 1usize;
    while i + 1usize < patch.count {
        anchor_dot_triangle(
            mut input,
            eye.world,
            patch.points[0usize],
            patch.points[i],
            patch.points[i + 1usize],
            hit.normal
        );
        i = i + 1usize;
    }
}
fn anchor_dot_triangle(
    input: mut FrameInput,
    space: u32,
    a: Vec3,
    b: Vec3,
    c: Vec3,
    normal: Vec3
) -> unit {
    var auv: Vec3 = anchor_dot_uv(a, normal);
    var buv: Vec3 = anchor_dot_uv(b, normal);
    var cuv: Vec3 = anchor_dot_uv(c, normal);
    var lift: Vec3 = scale(normal, ANCHOR_SURFACE_LIFT);
    a = add(a, lift);
    b = add(b, lift);
    c = add(c, lift);
    triangle_uv(
        mut input,
        space,
        ANCHOR_DOT_MATERIAL,
        0u32,
        1u32,
        a.x,
        a.y,
        a.z,
        b.x,
        b.y,
        b.z,
        c.x,
        c.y,
        c.z,
        auv.x,
        auv.y,
        buv.x,
        buv.y,
        cuv.x,
        cuv.y
    );
}
