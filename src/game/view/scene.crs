fn game_quad(v: mut FrameInput, mat: u32, a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> unit {
    var space: u32 = input_word(read v, 20usize);
    quad(
        mut v,
        space,
        mat,
        0u32,
        0u32,
        a.x,
        a.y,
        a.z,
        b.x,
        b.y,
        b.z,
        c.x,
        c.y,
        c.z,
        d.x,
        d.y,
        d.z
    );
}
fn draw_solid(v: mut FrameInput, s: Solid) -> unit {
    draw_solid_faces(mut v, s, 63u32);
}
fn draw_solid_faces(v: mut FrameInput, s: Solid, faces: u32) -> unit {
    var face: u32 = 0u32;
    while face < 6u32 {
        var axis: u32 = face / 2u32;
        if (faces & (1u32 << face)) != 0u32 {
            var shift: Vec3 = vec(0f32, 0f32, 0f32);
            if face % 2u32 != 0u32 {
                shift = scale(
                    axis_vector(axis),
                    component(sub(s.high, s.low), axis)
                );
            }
            var b: u32 = 1u32;
            var d: u32 = 2u32;
            if face % 2u32 == 0u32 {
                b = 2u32;
                d = 1u32;
            }
            surface_quad(
                mut v,
                s.material,
                add(box_edge(s, axis, 0u32), shift),
                add(box_edge(s, axis, b), shift),
                add(box_edge(s, axis, 3u32), shift),
                add(box_edge(s, axis, d), shift)
            );
        }
        face = face + 1u32;
    }
}
fn draw_ribbon(v: mut FrameInput, a: Vec3, b: Vec3, eye: Vec3, width: f32, mat: u32) -> unit {
    var side: Vec3 = scale(unit_vector(cross(sub(b, a), sub(eye, a))), width);
    game_quad(
        mut v,
        mat,
        sub(a, side),
        add(a, side),
        add(b, side),
        sub(b, side)
    );
}
fn game_scene_begin(
    collision: read CollisionScene,
    v: mut FrameInput,
    trial: read Trial,
    config: GameConfig
) -> unit {
    input_frame(mut v);
    input_set_word(mut v, 4usize, 0u32);
    if collision_portal_count(read collision) != 0u32 {
        input_set_word(mut v, 4usize, 6u32);
    }
    render_portals(mut v, read collision);
    input_set_word(mut v, 20usize, trial.drone.world);
    input_set_word(mut v, SHARED_AMBIENT as usize, trial.graph_run as u32);
    input_set_word(mut v, BACKGROUND as usize, 0xff0d0906u32);
    input_set_float(mut v, RENDER_STYLE as usize, 0.04f32 * drone_size(read trial.drone));
    input_set_float(mut v, DETAIL_NEAR as usize, 6f32 * drone_size(read trial.drone));
    var angle: f32 = config.fov * 0.00872664626f32;
    input_set_float(mut v, PROJECTION as usize, sinf(angle) / cosf(angle));
    camera_row(mut v, 0usize, trial.drone.basis.right, trial.drone.position);
    camera_row(mut v, 4usize, trial.drone.basis.up, trial.drone.position);
    camera_row(mut v, 8usize, trial.drone.basis.forward, trial.drone.position);
    game_object_lighting(read collision, mut v, read trial);
    draw_cable(read collision, mut v, read trial.drone, config);
}
fn game_dynamic_space(v: mut FrameInput, first: u32, space: u32) -> unit {
    var i: u32 = first;
    while i < input_word(read v, 3usize) {
        var address: usize = (input_word(read v, META as usize) + i * 4u32) as usize;
        input_set_word(mut v, address, space);
        i = i + 1u32;
    }
}

fn game_dynamic_no_shadow(v: mut FrameInput, first: u32) -> unit {
    var i: u32 = first;
    while i < input_word(read v, 3usize) {
        var flags: usize = (input_word(read v, META as usize) + i * 4u32 + 3u32) as usize;
        var value: u32 = input_word(read v, flags) | 4u32;
        input_set_word(mut v, flags, value);
        i = i + 1u32;
    }
}

fn game_dynamic_anchor(input: mut FrameInput, first: u32, anchor: RoomAnchor) -> unit {
    game_dynamic_space(mut input, first, anchor.space);
    var vertex: u32 = first * 3u32;
    while vertex < input_word(read input, 3usize) * 3u32 {
        var p: usize = (GEOMETRY + vertex * 5u32) as usize;
        var point: Vec3 = space_point(
            anchor.transform,
            vec(
                input_float(read input, p),
                input_float(read input, p + 1usize),
                input_float(read input, p + 2usize)
            )
        );
        input_set_float(mut input, p, point.x);
        input_set_float(mut input, p + 1usize, point.y);
        input_set_float(mut input, p + 2usize, point.z);
        vertex = vertex + 1u32;
    }
}
