fn light_scaled_anchors(
    scene: read CollisionScene,
    anchors: mut RoomAnchors,
    light: LightObject,
    size: read Rational,
    budget: u32
) -> bool {
    return view_sphere_anchors(
        read scene,
        mut anchors,
        primary_anchor(light.id, light.space),
        light.position,
        light_object_reach(light),
        light.radius + light_object_reach(light),
        read size,
        budget
    );
}
fn light_anchor_numeric_valid(anchor: RoomAnchor, light: LightObject, size: f32) -> bool {
    return view_anchor_numeric_valid(
        anchor,
        light.position,
        light.radius + light_object_reach(light),
        size
    );
}
fn light_anchors(
    scene: read CollisionScene,
    anchors: mut RoomAnchors,
    light: LightObject,
    budget: u32
) -> bool {
    var size: Rational = rational_new(1u64, 1u64);
    return light_scaled_anchors(read scene, mut anchors, light, read size, budget);
}
