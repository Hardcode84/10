fn static_upload(v: mut FrameInput, list: mut InstanceList, mesh: read Mesh) -> bool {
    var range: MeshRange = mesh_empty_range();
    if !input_mesh(mut v, read mesh, mut range) {
        return false;
    }
    return instances_append(mut list, mesh_identity(range, 0u32));
}
fn game_static_build(v: mut FrameInput, list: mut InstanceList, world: u32) -> bool {
    var i: u32 = 0u32;
    if world == 1u32 {
        while i < ROOM_COUNT {
            var mesh: Mesh = mesh_new();
            if !static_room(mut mesh, i) || !static_upload(mut v, mut list, read mesh) {
                return false;
            }
            i = i + 1u32;
        }
    }
    i = 0u32;
    while i < world_solid_count(world) {
        var mesh: Mesh = mesh_new();
        if !static_solid(mut mesh, world_solid(world, i), world_solid_faces(world, i)) || !static_upload(
            mut v,
            mut list,
            read mesh
        ) {
            return false;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < world_pipe_count(world) {
        var mesh: Mesh = mesh_new();
        if !static_pipe(mut mesh, world_pipe(world, i)) || !static_upload(
            mut v,
            mut list,
            read mesh
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
