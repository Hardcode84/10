fn draw_hook_preview(
    collision: read CollisionScene,
    v: mut FrameInput,
    trial: read Trial,
    config: GameConfig,
    limit: u32
) -> unit {
    var prediction: Prediction = prediction_new();
    predict_hook(read collision, mut prediction, read trial, limit);
    draw_prediction(mut v, read prediction, config);
}

fn draw_hook_marker(
    v: mut FrameInput,
    center: Vec3,
    basis: Basis,
    pixel: f32,
    factor: f32
) -> unit {
    var half: f32 = 0.04f32 * factor;
    if pixel * 0.5f32 > half {
        half = pixel * 0.5f32;
    }
    var right: Vec3 = scale(basis.right, half);
    var up: Vec3 = scale(basis.up, half);
    game_quad(
        mut v,
        HOOK_PREVIEW_MATERIAL,
        sub(sub(center, right), up),
        sub(add(center, right), up),
        add(add(center, right), up),
        add(sub(center, right), up)
    );
}
