record Solid {
    low: Vec3;
    high: Vec3;
    material: u32;
}
fn solid(lo: Vec3, hi: Vec3, mat: u32) -> Solid {
    return make Solid {
        low: lo,
        high: hi,
        material: mat
    };
}

fn box_edge(s: Solid, axis: u32, index: u32) -> Vec3 {
    var a: u32 = (axis + 1u32) % 3u32;
    var b: u32 = (axis + 2u32) % 3u32;
    var point: Vec3 = s.low;
    if index % 2u32 != 0u32 {
        point = add(
            point,
            scale(axis_vector(a), component(sub(s.high, s.low), a))
        );
    }
    if index / 2u32 != 0u32 {
        point = add(
            point,
            scale(axis_vector(b), component(sub(s.high, s.low), b))
        );
    }
    return point;
}

fn mesh_vertex(p: Vec3, u: f32, v: f32) -> MeshVertex {
    return make MeshVertex {
        x: p.x,
        y: p.y,
        z: p.z,
        u: u,
        v: v
    };
}
fn static_quad(
    mesh: mut Mesh,
    material: u32,
    a: Vec3,
    b: Vec3,
    c: Vec3,
    d: Vec3,
    normal: Vec3,
    axis: u32
) -> bool {
    var u: f32 = length(sub(b, a)) / 4f32;
    var v: f32 = length(sub(d, a)) / 4f32;
    var vertices: [MeshVertex; 4] = make [MeshVertex; 4] {
        mesh_vertex(a, 0f32, 0f32),
        mesh_vertex(b, u, 0f32),
        mesh_vertex(c, u, v),
        mesh_vertex(d, 0f32, v)
    };
    if axis < 3u32 {
        var points: [Vec3; 4] = make [Vec3; 4] {
            a,
            b,
            c,
            d
        };
        var i: usize = 0usize;
        while i < 4usize {
            vertices[i].u = component(points[i], (axis + 1u32) % 3u32) / 4f32;
            vertices[i].v = component(points[i], (axis + 2u32) % 3u32) / 4f32;
            i = i + 1usize;
        }
    }
    var order: [usize; 6] = make [usize; 6] {
        0usize,
        1usize,
        2usize,
        0usize,
        2usize,
        3usize
    };
    if dot(cross(sub(b, a), sub(c, a)), normal) < 0f32 {
        order = make [usize; 6] {
            0usize,
            2usize,
            1usize,
            0usize,
            3usize,
            2usize
        };
    }
    var i: usize = 0usize;
    while i < 6usize {
        var face: MeshTriangle = make MeshTriangle {
            vertices: make [MeshVertex; 3] {
                vertices[order[i]],
                vertices[order[i + 1usize]],
                vertices[order[i + 2usize]]
            },
            material: material,
            portal: 0u32,
            flags: 2u32
        };
        if !mesh_append(mut mesh, face) {
            return false;
        }
        i = i + 3usize;
    }
    return true;
}
fn static_solid(mesh: mut Mesh, item: Solid, faces: u32) -> bool {
    var face: u32 = 0u32;
    while face < 6u32 {
        if (faces & (1u32 << face)) != 0u32 {
            var axis: u32 = face / 2u32;
            var shift: Vec3 = vec(0f32, 0f32, 0f32);
            var sign: f32 = -1f32;
            if face % 2u32 != 0u32 {
                shift = scale(
                    axis_vector(axis),
                    component(sub(item.high, item.low), axis)
                );
                sign = 1f32;
            }
            if !static_quad(
                mut mesh,
                item.material,
                add(box_edge(item, axis, 0u32), shift),
                add(box_edge(item, axis, 1u32), shift),
                add(box_edge(item, axis, 3u32), shift),
                add(box_edge(item, axis, 2u32), shift),
                scale(axis_vector(axis), sign),
                3u32
            ) {
                return false;
            }
        }
        face = face + 1u32;
    }
    return true;
}
fn surface_quad(v: mut FrameInput, mat: u32, a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> unit {
    var first: u32 = input_word(read v, 3usize);
    game_quad(mut v, mat, a, b, c, d);
    var u: f32 = length(sub(b, a)) / 4f32;
    var w: f32 = length(sub(d, a)) / 4f32;
    var base: usize = (GEOMETRY + first * 15u32) as usize;
    input_set_float(mut v, base + 8usize, u);
    input_set_float(mut v, base + 13usize, u);
    input_set_float(mut v, base + 14usize, w);
    input_set_float(mut v, base + 23usize, u);
    input_set_float(mut v, base + 24usize, w);
    input_set_float(mut v, base + 29usize, w);
}
