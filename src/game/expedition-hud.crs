fn expedition_status(v: mut FrameInput, trial: read Trial) -> unit {
    if trial.finished {
        hud_text(mut v, 0u32, 1u32, "EXPEDITION COMPLETE - THE SILENT FOUNDRY IS LIT");
        hud_text(mut v, 0u32, 2u32, "TIME SECONDS");
        expedition_number(mut v, 13u32, 2u32, trial.expedition.elapsed / 120u32);
        hud_text(mut v, 22u32, 2u32, "RECOVERIES");
        expedition_number(mut v, 33u32, 2u32, trial.expedition.rescues);
        hud_text(mut v, 42u32, 2u32, "ESC EXIT");
        return;
    }
    if trial.drone.charge <= 0f32 {
        hud_text(mut v, 0u32, 1u32, "POWER EMPTY - FREE MANEUVER AND HOOK STILL WORK");
        hud_text(mut v, 0u32, 2u32, "FOLLOW LIT STATIONS OR BACKSPACE / PAD X TO RECOVER");
        return;
    }
    var goal: u32 = mission_goal(trial.expedition);
    if goal == 1u32 {
        hud_text(mut v, 0u32, 1u32, "01 SERVICE GALLERY - RESTORE THE PUMP COURT RELAY");
    }
    if goal == 2u32 {
        hud_text(mut v, 0u32, 1u32, "02 PUMP COURT - CLIMB TO THE CROWN BEACON");
    }
    if goal == 0u32 {
        hud_text(mut v, 0u32, 1u32, "03 CROWN LINK ABOARD - RETURN TO THE WARM BERTH");
    }
    hud_text(mut v, 0u32, 2u32, "TARGET M");
    expedition_number(
        mut v,
        9u32,
        2u32,
        length(sub(station_position(goal), trial.drone.position)) as u32
    );
    hud_text(mut v, 18u32, 2u32, "DOCK 6M / 2M/S");
    if trial.expedition.return_link && trial.expedition.relight < 2400u32 {
        hud_text(mut v, 36u32, 2u32, "LIGHT");
        expedition_number(mut v, 43u32, 2u32, trial.expedition.relight * 100u32 / 2400u32);
    } else {
        hud_text(mut v, 36u32, 2u32, "DOCK");
        expedition_number(mut v, 43u32, 2u32, trial.expedition.docking * 100u32 / 180u32);
    }
}
fn expedition_hud(v: mut FrameInput, trial: read Trial, paused: bool) -> unit {
    if input_word(read v, 0usize) < 448u32 {
        expedition_compact_hud(mut v, read trial, paused);
        return;
    }
    hud_text(mut v, 0u32, 0u32, "CHARGE");
    expedition_number(mut v, 7u32, 0u32, trial.drone.charge as u32);
    hud_text(mut v, 15u32, 0u32, "SPEED");
    expedition_number(mut v, 21u32, 0u32, length(trial.drone.velocity) as u32);
    hud_text(mut v, 29u32, 0u32, "SPENT");
    expedition_number(mut v, 35u32, 0u32, trial.expedition.spent as u32);
    hud_text(mut v, 43u32, 0u32, "TIME S");
    expedition_number(mut v, 50u32, 0u32, trial.expedition.elapsed / 120u32);
    expedition_status(mut v, read trial);
    if trial.expedition.elapsed < 2400u32 || paused {
        hud_text(mut v, 0u32, 3u32, "WASD SPACE CTRL MOVE | RMB BURST 8 | F BRAKE | LMB HOOK");
        hud_text(mut v, 0u32, 4u32, "R REEL | RELEASE LMB | BACKSPACE RECOVER | TAB PAUSE");
    }
    expedition_hint(mut v, read trial);
    if paused {
        hud_text(
            mut v,
            0u32,
            5u32,
            "PAUSED - TAB TO RESUME                                           "
        );
    }
}
fn expedition_compact_hud(v: mut FrameInput, trial: read Trial, paused: bool) -> unit {
    hud_text(mut v, 0u32, 0u32, "CHARGE");
    expedition_number(mut v, 7u32, 0u32, trial.drone.charge as u32);
    hud_text(mut v, 16u32, 0u32, "TIME S");
    expedition_number(mut v, 23u32, 0u32, trial.expedition.elapsed / 120u32);
    var goal: u32 = mission_goal(trial.expedition);
    if goal == 1u32 {
        hud_text(mut v, 0u32, 1u32, "RESTORE THE PUMP COURT RELAY");
    }
    if goal == 2u32 {
        hud_text(mut v, 0u32, 1u32, "CLIMB TO THE CROWN BEACON");
    }
    if goal == 0u32 {
        hud_text(mut v, 0u32, 1u32, "CARRY THE LINK TO THE WARM BERTH");
    }
    hud_text(mut v, 0u32, 2u32, "DOCK WITHIN 6M AT LESS THAN 2M/S");
    hud_text(mut v, 0u32, 3u32, "RMB BURST / F BRAKE / LMB HOOK");
    hud_text(mut v, 0u32, 4u32, "R REEL / BACKSPACE RECOVER / TAB PAUSE");
    hud_text(mut v, 0u32, 5u32, "TARGET M");
    expedition_number(
        mut v,
        9u32,
        5u32,
        length(sub(station_position(goal), trial.drone.position)) as u32
    );
    hud_text(mut v, 17u32, 5u32, "DOCK");
    expedition_number(mut v, 22u32, 5u32, trial.expedition.docking * 100u32 / 180u32);
    if trial.drone.charge <= 0f32 {
        hud_text(mut v, 0u32, 5u32, "EMPTY - FREE MANEUVER AND HOOK WORK");
    }
    if trial.finished {
        hud_text(mut v, 0u32, 1u32, "EXPEDITION COMPLETE - SECTOR LIT ");
        hud_text(mut v, 0u32, 4u32, "BACKSPACE NEW EXPEDITION / ESC EXIT  ");
    }
    if paused {
        hud_text(mut v, 0u32, 5u32, "PAUSED - TAB TO RESUME             ");
    }
}

fn expedition_hint(v: mut FrameInput, trial: read Trial) -> unit {
    if trial.finished {
        hud_text(mut v, 0u32, 5u32, "SECTOR RESTORED - BACKSPACE / PAD X FOR A NEW EXPEDITION");
        return;
    }
    var goal: u32 = mission_goal(trial.expedition);
    if goal == 1u32 {
        hud_text(mut v, 0u32, 5u32, "PASS RIGHT OF THE SPOKE - FIND THE RED RELAY FRAME");
    }
    if goal == 2u32 {
        hud_text(
            mut v,
            0u32,
            5u32,
            "CLIMB THE SHAFT - HOOK HIGH - REEL - RELEASE EARLY TO COAST"
        );
    }
    if goal == 0u32 {
        hud_text(mut v, 0u32, 5u32, "HOME: COVERED RETURN DUCT / OPEN DROP ABOVE THE GALLERY");
    }
}

fn expedition_number(v: mut FrameInput, column: u32, row: u32, value: u32) -> unit {
    var n: u32 = value;
    var index: u32 = 0u32;
    while index < 6u32 {
        var digit: u32 = 0u32;
        if n > 0u32 || index == 0u32 {
            digit = 48u32 + n % 10u32;
        }
        input_set_word(
            mut v,
            (OVERLAY_CELLS + row * 80u32 + column + 5u32 - index) as usize,
            digit
        );
        n = n / 10u32;
        index = index + 1u32;
    }
}
