fn pilot_command(trial: read Trial) -> Command {
    var c: Command = idle_command();
    var target: Vec3 = add(course_finish(), vec(0f32, 0.36f32, 0f32));
    if trial.gate < GATE_COUNT {
        var gate: CourseGate = course_gate(trial.gate);
        target = add(gate.center, scale(gate.normal, 3f32));
    }
    var delta: Vec3 = sub(target, trial.drone.position);
    var distance: f32 = length(delta);
    var direction: Vec3 = unit_vector(delta);
    var b: Basis = trial.drone.basis;
    var x: f32 = dot(direction, b.right);
    var y: f32 = dot(direction, b.up);
    var z: f32 = dot(direction, b.forward);
    c.look = vec(atan2f(x, z) * 8f32, -atan2f(y, sqrtf(x * x + z * z)) * 8f32, 0f32);
    var speed: f32 = length(trial.drone.velocity);
    var desired_speed: f32 = clamp(sqrtf(distance) * 0.8f32, 0f32, 8f32);
    if distance > 20f32 {
        desired_speed = 15f32;
    }
    var desired: Vec3 = scale(direction, desired_speed);
    var correction: Vec3 = sub(desired, trial.drone.velocity);
    c.thrust = vec(
        dot(correction, b.right),
        dot(correction, b.up),
        dot(correction, b.forward)
    );
    c.burst = distance > 20f32 && speed < 4f32 && z > 0.995f32;
    c.brake = speed > length(desired) + 2f32 || (
        speed > 2f32 && dot(unit_vector(trial.drone.velocity), direction) < 0.8f32
    );
    c.burst = c.burst && !c.brake;
    return c;
}
fn spin_pilot_command(trial: read Trial) -> Command {
    var c: Command = idle_command();
    var target: Vec3 = add(course_finish(), vec(0f32, 0.4f32, 0f32));
    if trial.gate < GATE_COUNT {
        var gate: CourseGate = course_gate(trial.gate);
        target = add(gate.center, scale(gate.normal, 12f32));
        var offset: Vec3 = sub(trial.drone.position, gate.center);
        if dot(offset, gate.normal) >= 0f32 {
            target = sub(gate.center, scale(gate.normal, 12f32));
        }
    }
    var delta: Vec3 = sub(target, trial.drone.position);
    var desired: Vec3 = scale(
        unit_vector(delta),
        clamp(length(delta) * 0.7f32, 0f32, 18f32)
    );
    var correction: Vec3 = sub(
        sub(desired, trial.drone.velocity),
        scale(
            flight_acceleration(trial.drone.position, trial.drone.velocity, true),
            1.2f32
        )
    );
    var direction: Vec3 = unit_vector(correction);
    var b: Basis = trial.drone.basis;
    var x: f32 = dot(direction, b.right);
    var y: f32 = dot(direction, b.up);
    var z: f32 = dot(direction, b.forward);
    c.look = vec(atan2f(x, z) * 8f32, -atan2f(y, sqrtf(x * x + z * z)) * 8f32, 0f32);
    c.thrust = vec(
        dot(correction, b.right),
        dot(correction, b.up),
        dot(correction, b.forward)
    );
    c.burst = length(correction) > 8f32 && z > 0.995f32 && trial.tick % 30u32 == 0u32;
    c.brake = trial.gate == GATE_COUNT && length(delta) < 8f32 && length(trial.drone.velocity) > 3f32;
    c.burst = c.burst && !c.brake;
    return c;
}
