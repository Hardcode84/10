record Timespec {
    seconds: i64;
    nanoseconds: i64;
}
extern fn clock_gettime(clock: i32, time: *Timespec) -> i32 = "clock_gettime";
fn now() -> u64 {
    var t: Timespec = uninit;
    if clock_gettime(1i32, &t) != 0i32 {
        puts("monotonic clock failed");
        exit(1i32);
        return 0u64;
    }
    return t.seconds as u64 * 1000000000u64 + t.nanoseconds as u64;
}
fn report(samples: *u64, count: u32) -> unit {
    var i: usize = 1usize;
    while i < count as usize {
        var value: u64 = samples[i];
        var j: usize = i;
        while j > 0usize && samples[j - 1usize] > value {
            samples[j] = samples[j - 1usize];
            j = j - 1usize;
        }
        samples[j] = value;
        i = i + 1usize;
    }
    puts("steady frame CPU submission + GPU + status readback p50 / p99 (microseconds):");
    print_number((samples[(count / 2u32) as usize] / 1000u64) as i64);
    print_number((samples[((count * 99u32 - 1u32) / 100u32) as usize] / 1000u64) as i64);
}

fn queries_create(v: *Vulkan) -> bool {
    var info: VkQueryPoolCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkQueryPoolCreateInfo));
    info.sType = 11u32;
    info.queryType = 2u32;
    info.queryCount = 20u32;
    return vk_ok(
        vkCreateQueryPool(v -> device, &info, null(*u8), &v -> query_pool),
        "vkCreateQueryPool"
    );
}
fn queries_report(v: *Vulkan) -> bool {
    var values: [u64; 20] = uninit;
    if !vk_ok(
        vkGetQueryPoolResults(
            v -> device,
            v -> query_pool,
            0u32,
            20u32,
            sizeof([u64; 20]),
            &values as *u8,
            8u64,
            3u32
        ),
        "vkGetQueryPoolResults"
    ) {
        return false;
    }
    puts(
        "last frame GPU intervals in microseconds: upload/init; transform/compact/raster/advance per depth; compose; readback"
    );
    var i: usize = 1usize;
    while i < 20usize {
        print_number(
            (
                ((values[i] - values[i - 1usize]) & v -> timestamp_mask) as f32 * v -> timestamp_period / 1000f32
            ) as i64
        );
        i = i + 1usize;
    }
    return true;
}
