fn memory_allocate(
    v: *Vulkan,
    requirements: *VkMemoryRequirements,
    flags: u32,
    memory: **u8
) -> bool {
    var index: u32 = 0u32;
    while index < v -> properties.memoryTypeCount {
        if (requirements -> memoryTypeBits & (1u32 << index)) != 0u32 && (
            v -> properties.memoryTypes[index as usize].propertyFlags & flags
        ) == flags {
            break;
        }
        index = index + 1u32;
    }
    if index == v -> properties.memoryTypeCount {
        puts("no memory type with required flags:");
        print_number(flags as i64);
        return false;
    }
    var info: VkMemoryAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkMemoryAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
    info.allocationSize = requirements -> size;
    info.memoryTypeIndex = index;
    return vk_ok(
        vkAllocateMemory(v -> device, &info, null(*u8), memory),
        "vkAllocateMemory"
    );
}

fn allocate_buffer(
    v: *Vulkan,
    size: u64,
    usage: u32,
    flags: u32,
    buffer: **u8,
    memory: **u8
) -> bool {
    var info: VkBufferCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkBufferCreateInfo));
    info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
    info.size = size;
    info.usage = usage;
    if !vk_ok(vkCreateBuffer(v -> device, &info, null(*u8), buffer), "vkCreateBuffer") {
        return false;
    }
    var req: VkMemoryRequirements = uninit;
    vkGetBufferMemoryRequirements(v -> device, *buffer, &req);
    if !memory_allocate(v, &req, flags, memory) {
        return false;
    }
    return vk_ok(
        vkBindBufferMemory(v -> device, *buffer, *memory, 0u64),
        "vkBindBufferMemory"
    );
}
fn buffer_create(v: *Vulkan) -> bool {
    var size: u64 = (WORDS_LENGTH as u64 + FLOATS_LENGTH as u64 + MAX_INVOCATIONS as u64) * 4u64;
    if !allocate_buffer(v, size, 35u32 | 256u32, 1u32, &v -> buffer, &v -> memory) || !allocate_buffer(
        v,
        size,
        3u32,
        14u32,
        &v -> staging,
        &v -> staging_memory
    ) {
        return false;
    }
    if !vk_ok(
        vkMapMemory(v -> device, v -> staging_memory, 0u64, size, 0u32, &v -> mapped),
        "vkMapMemory"
    ) {
        return false;
    }
    zero(v -> mapped, size as usize);
    return true;
}
fn layout_create(v: *Vulkan) -> bool {
    var bindings: [VkDescriptorSetLayoutBinding; 3] = uninit;
    zero(&bindings as *u8, sizeof([VkDescriptorSetLayoutBinding; 3]));
    var i: usize = 0usize;
    while i < 3usize {
        bindings[i].binding = i as u32;
        bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
        bindings[i].descriptorCount = 1u32;
        bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
        i = i + 1usize;
    }
    var info: VkDescriptorSetLayoutCreateInfo = uninit;
    zero(&info as *u8, sizeof(VkDescriptorSetLayoutCreateInfo));
    info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
    info.bindingCount = 3u32;
    info.pBindings = &bindings[0usize];
    if !vk_ok(
        vkCreateDescriptorSetLayout(v -> device, &info, null(*u8), &v -> layout),
        "vkCreateDescriptorSetLayout"
    ) {
        return false;
    }
    var pi: VkPipelineLayoutCreateInfo = uninit;
    zero(&pi as *u8, sizeof(VkPipelineLayoutCreateInfo));
    pi.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
    pi.setLayoutCount = 1u32;
    pi.pSetLayouts = &v -> layout;
    return vk_ok(
        vkCreatePipelineLayout(v -> device, &pi, null(*u8), &v -> pipeline_layout),
        "vkCreatePipelineLayout"
    );
}
fn pipeline_create(v: *Vulkan, code: *Input, slot: usize) -> bool {
    var module: VkShaderModuleCreateInfo = uninit;
    zero(&module as *u8, sizeof(VkShaderModuleCreateInfo));
    module.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
    module.codeSize = code -> size;
    module.pCode = code -> bytes as *u32;
    if !vk_ok(
        vkCreateShaderModule(v -> device, &module, null(*u8), &v -> modules[slot]),
        "vkCreateShaderModule"
    ) {
        return false;
    }
    var pipeline: VkComputePipelineCreateInfo = uninit;
    zero(&pipeline as *u8, sizeof(VkComputePipelineCreateInfo));
    pipeline.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
    pipeline.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
    pipeline.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
    pipeline.stage.module = v -> modules[slot];
    pipeline.stage.pName = "main";
    pipeline.layout = v -> pipeline_layout;
    return vk_ok(
        vkCreateComputePipelines(
            v -> device,
            null(*u8),
            1u32,
            &pipeline,
            null(*u8),
            &v -> pipelines[slot]
        ),
        "vkCreateComputePipelines"
    );
}

fn descriptors_create(v: *Vulkan) -> bool {
    var size: VkDescriptorPoolSize = make VkDescriptorPoolSize {
        type: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
        descriptorCount: 3u32
    };
    var pool: VkDescriptorPoolCreateInfo = uninit;
    zero(&pool as *u8, sizeof(VkDescriptorPoolCreateInfo));
    pool.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
    pool.maxSets = 1u32;
    pool.poolSizeCount = 1u32;
    pool.pPoolSizes = &size;
    if !vk_ok(
        vkCreateDescriptorPool(v -> device, &pool, null(*u8), &v -> pool),
        "vkCreateDescriptorPool"
    ) {
        return false;
    }
    var info: VkDescriptorSetAllocateInfo = uninit;
    zero(&info as *u8, sizeof(VkDescriptorSetAllocateInfo));
    info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
    info.descriptorPool = v -> pool;
    info.descriptorSetCount = 1u32;
    info.pSetLayouts = &v -> layout;
    if !vk_ok(
        vkAllocateDescriptorSets(v -> device, &info, &v -> set),
        "vkAllocateDescriptorSets"
    ) {
        return false;
    }
    var buffers: [VkDescriptorBufferInfo; 3] = uninit;
    buffers[0usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: 0u64,
        range: WORDS_LENGTH as u64 * 4u64
    };
    buffers[1usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: WORDS_LENGTH as u64 * 4u64,
        range: FLOATS_LENGTH as u64 * 4u64
    };
    buffers[2usize] = make VkDescriptorBufferInfo {
        buffer: v -> buffer,
        offset: (WORDS_LENGTH as u64 + FLOATS_LENGTH as u64) * 4u64,
        range: MAX_INVOCATIONS as u64 * 4u64
    };
    var writes: [VkWriteDescriptorSet; 3] = uninit;
    zero(&writes as *u8, sizeof([VkWriteDescriptorSet; 3]));
    var i: usize = 0usize;
    while i < 3usize {
        writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
        writes[i].dstSet = v -> set;
        writes[i].dstBinding = i as u32;
        writes[i].descriptorCount = 1u32;
        writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
        writes[i].pBufferInfo = &buffers[i];
        i = i + 1usize;
    }
    vkUpdateDescriptorSets(v -> device, 3u32, &writes[0usize], 0u32, null(*u8));
    return true;
}
