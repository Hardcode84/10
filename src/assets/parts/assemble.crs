// Append each placed part as a closed solid in the requested room space.
fn room_parts_collision(asset: read RoomAsset, builder: mut CollisionBuilder, space: u32) -> bool {
    return asset_parts_collision(read asset.geometry, read asset.parts, mut builder, space) && asset_parts_collision(
        read asset.geometry,
        read asset.colliders,
        mut builder,
        space
    );
}
fn asset_parts_collision(
    geometry: read Mesh,
    parts: read AssetParts,
    builder: mut CollisionBuilder,
    space: u32
) -> bool {
    var i: u32 = 0u32;
    while i < asset_part_count(read parts) {
        var part: AssetPart = asset_part(read parts, i);
        var mesh: Mesh = mesh_new();
        var j: u32 = 0u32;
        while j < part.count {
            if !mesh_append(mut mesh, mesh_triangle(read geometry, part.first + j)) {
                return false;
            }
            j = j + 1u32;
        }
        if !collision_append_solid(mut builder, read mesh, space, part.origin, part.basis) || !collision_set_motion(
            mut builder,
            part.linear,
            part.angular
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
// Append placed parts after the shell. Local geometry and pivots stay available.
fn room_parts_render(asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < asset_part_count(read asset.parts) {
        var part: AssetPart = asset_part(read asset.parts, i);
        var j: u32 = 0u32;
        while j < part.count {
            var t: MeshTriangle = mesh_triangle(read asset.geometry, part.first + j);
            if !mesh_append(
                mut asset.mesh,
                placed_triangle(t, part.origin, part.basis)
            ) {
                return false;
            }
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < mesh_triangle_count(read asset.decals) {
        if !mesh_append(mut asset.mesh, mesh_triangle(read asset.decals, i)) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}

// Places all geometry appended since first as one named solid part.
fn asset_part_place_tail(asset: mut RoomAsset, first: u32, name: AssetName, origin: Vec3) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            linear: vec(0f32, 0f32, 0f32),
            angular: vec(0f32, 0f32, 0f32),
            name: name,
            first: first,
            count: mesh_triangle_count(read asset.geometry) - first,
            origin: origin,
            basis: identity_basis()
        }
    );
}
