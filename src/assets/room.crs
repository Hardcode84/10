record AssetSpawn {
    position: Vec3;
    basis: Basis;
}
record RoomAsset {
    recipe: AssetRecipe;
    hull: AssetHull;
    ports: AssetPorts;
    mesh: Mesh;
    geometry: Mesh;
    // Room-local visual surfaces, appended after solids and excluded from collision.
    decals: Mesh;
    parts: AssetParts;
    // Collision-only solids use geometry ranges without adding render instances.
    colliders: AssetParts;
    door_leaves: AssetDoorLeaves;
    lights: FixtureLights;
    sparks: SparkEmitters;
    arcs: ArcEmitters;
    routes: PipeRouter;
    collision: CollisionScene;
    spawn: AssetSpawn;
    spawn_enabled: bool;
    tile_metres: f32;
    // Default inspection lighting. Game lighting is set by the level.
    preview_ambient: Vec3;
    preview_headlamp: f32;
}
fn room_asset_new() -> RoomAsset {
    return make RoomAsset {
        recipe: asset_recipe_new(),
        hull: asset_hull_new(),
        ports: asset_ports_new(),
        mesh: mesh_new(),
        geometry: mesh_new(),
        decals: mesh_new(),
        parts: asset_parts_new(),
        colliders: asset_parts_new(),
        door_leaves: asset_door_leaves_new(),
        lights: fixture_lights_new(),
        sparks: spark_emitters_new(),
        arcs: arc_emitters_new(),
        routes: pipe_router_new(-1f32, 0u32),
        collision: collision_new(),
        spawn: make AssetSpawn {
            position: vec(0f32, 0f32, 0f32),
            basis: identity_basis()
        },
        spawn_enabled: true,
        tile_metres: 2f32,
        preview_ambient: vec(0.5f32, 0.5f32, 0.5f32),
        preview_headlamp: 900f32
    };
}
fn room_asset_finish(asset: mut RoomAsset) -> bool {
    var clearance: f32 = 0f32;
    if asset.spawn_enabled {
        clearance = 0.35f32;
    }
    if !hull_contains(read asset.hull, asset.spawn.position, clearance) {
        return error("room camera or spawn lacks hull clearance");
    }
    if !hull_mesh(read asset.hull, mut asset.mesh, asset.tile_metres) {
        return false;
    }
    var builder: CollisionBuilder = collision_builder_new();
    if !collision_append(
        mut builder,
        read asset.mesh,
        0u32,
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !room_parts_collision(read asset, mut builder, 0u32) || !room_leaf_collision(
        read asset,
        mut builder,
        0u32
    ) || !room_parts_render(mut asset) || !room_leaf_render(mut asset) {
        return false;
    }
    if !collision_finish(move builder, mut asset.collision) {
        return false;
    }
    if !asset.spawn_enabled {
        return collision_embedded_at(
            read asset.collision,
            0u32,
            asset.spawn.position,
            0f32
        ) == 0xffffffffu32 || error("room preview camera is inside a solid part");
    }
    return collision_position_valid(
        read asset.collision,
        0u32,
        asset.spawn.position,
        0.35f32
    ) || error("room spawn overlaps a solid part");
}
// Returns an error when this room provides only a preview camera pose.
fn room_asset_player_spawn(asset: read RoomAsset) -> bool {
    return asset.spawn_enabled || error("room has no player spawn");
}
