// Regular hexagon: 6 m across corners, horizontal corner pair, six roll choices.
fn service_hex_profile() -> ConnectionProfile {
    return make ConnectionProfile {
        scale: scale_identity(),
        name: asset_name("HEX-6M"),
        shape: make RegularProfile {
            sides: 6u32,
            phase: 0f32
        },
        radius: 3f32,
        rotations: 6u32,
        clearance: 2.1f32
    };
}
fn connection_point(port: RoomPort, corner: u32) -> Vec3 {
    var angle: f32 = port.profile.shape.phase + 6.28318530718f32 * corner as f32 / port.profile.shape.sides as f32;
    return add(
        port.position,
        add(
            scale(port.basis.right, port.profile.radius * cosf(angle)),
            scale(port.basis.up, port.profile.radius * sinf(angle))
        )
    );
}
// Octagon: 8 m across corners, cardinal wall faces, four pipe-aligned rolls.
fn service_oct_profile() -> ConnectionProfile {
    return make ConnectionProfile {
        scale: scale_identity(),
        name: asset_name("OCT-8M"),
        shape: make RegularProfile {
            sides: 8u32,
            phase: 0.39269908169f32
        },
        radius: 4f32,
        rotations: 4u32,
        clearance: 2.75f32
    };
}
