record AssetParameter {
    minimum: f32;
    maximum: f32;
    initial: f32;
    step: f32;
}
// The recipe defines parameter units. The recipe also checks coupled constraints.
fn asset_parameters_reset(values: mut AssetValues) -> unit {
    var i: u32 = 0u32;
    while i < room_parameter_count() {
        asset_value_set(mut values, i, room_parameter(i).initial);
        i = i + 1u32;
    }
}
fn asset_parameters_valid(values: read AssetValues) -> bool {
    var i: u32 = 0u32;
    while i < room_parameter_count() {
        var p: AssetParameter = room_parameter(i);
        var value: f32 = asset_value(read values, i);
        if !asset_parameter_valid(p, value) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn asset_parameter_valid(parameter: AssetParameter, value: f32) -> bool {
    if value - value != 0f32 || value < parameter.minimum || value > parameter.maximum {
        return error("room parameter is outside its declared range");
    }
    return true;
}
