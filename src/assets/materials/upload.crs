// Builds indexed surface materials from the recipe, with one 256-colour palette each.
fn room_material_payload(parameters: read AssetValues) -> u32 {
    var payload: u32 = 0u32;
    var region: u32 = 0u32;
    while region < room_material_count() {
        var material: PanelMaterial = room_material(region, read parameters);
        var size: u32 = panel_texture_width(material);
        var height: u32 = panel_texture_height(material);
        payload = payload + size * height + PALETTE_COLORS * LIGHT_STATES;
        region = region + 1u32;
    }
    return payload;
}
// The caller reserves the complete material table and payload before upload.
fn room_materials(input: mut FrameInput, offset: u32, parameters: read AssetValues) -> bool {
    return room_materials_at(mut input, offset, 0u32, read parameters);
}
fn room_materials_at(
    input: mut FrameInput,
    offset: u32,
    first: u32,
    parameters: read AssetValues
) -> bool {
    var region: u32 = 0u32;
    while region < room_material_count() {
        var material: PanelMaterial = room_material(region, read parameters);
        var size: u32 = panel_texture_width(material);
        var height: u32 = panel_texture_height(material);
        if !panel_upload(mut input, first + region, offset, size, material) {
            return false;
        }
        offset = offset + size * height + PALETTE_COLORS * LIGHT_STATES;
        region = region + 1u32;
    }
    return true;
}
fn panel_upload(
    input: mut FrameInput,
    region: u32,
    offset: u32,
    size: u32,
    panel: PanelMaterial
) -> bool {
    var height: u32 = panel_texture_height(panel);
    var palette: u32 = offset + size * height;
    var material: Material = make Material {
        texture: offset,
        width: size,
        height: height,
        stride: size,
        palette: palette,
        style: 0u32,
        unlit: 0u32,
        address_u: ADDRESS_REPEAT,
        address_v: ADDRESS_REPEAT,
        transparent_index: 0u32
    };
    if !input_material(mut input, region, material) {
        return false;
    }
    var index: u32 = 0u32;
    while index < 256u32 {
        var state: u32 = 0u32;
        while state < LIGHT_STATES {
            input_asset_set(
                mut input,
                palette + index * LIGHT_STATES + state,
                panel_palette(panel, index, state)
            );
            state = state + 1u32;
        }
        index = index + 1u32;
    }
    index = 0u32;
    while index < size * height {
        var x: f32 = ((index % size) as f32 + 0.5f32) * panel.tile_metres / size as f32;
        var y: f32 = ((index / size) as f32 + 0.5f32) * panel_tile_height(panel) / height as f32;
        input_texel(mut input, offset + index, panel_sample(panel, x, y));
        index = index + 1u32;
    }
    return true;
}

fn panel_palette(panel: PanelMaterial, index: u32, state: u32) -> u32 {
    if index >= 248u32 {
        return palette_entry(panel.emission, 255u32, state, true);
    }
    if index >= 224u32 {
        return palette_entry(panel.accent, 160u32 + (index - 224u32) * 4u32, state, false);
    }
    return palette_entry(panel.colour, index, state, false);
}
