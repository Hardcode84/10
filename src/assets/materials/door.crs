// Returns the lateral offset of a repeating trapezoidal door joint in metres.
fn metal_door_joint(y: f32) -> f32 {
    var phase: f32 = mask_repeat(y, 1.6f32);
    if phase < 0.4f32 {
        return -0.22f32 + phase * 1.1f32;
    }
    if phase < 0.8f32 {
        return 0.22f32;
    }
    if phase < 1.2f32 {
        return 0.22f32 - (phase - 0.8f32) * 1.1f32;
    }
    return -0.22f32;
}
// Samples a closed two-leaf door with an interlocking joint. Dimensions are metres.
// Two indicators use the material's full-bright palette entries.
fn metal_door_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var px: f32 = x - material.tile_metres * 0.5f32;
    var py: f32 = y - material.tile_metres * 0.5f32;
    var led_x: f32 = absf(px) - 0.7f32;
    var led_y: f32 = py - 1.15f32;
    if absf(led_x) < 0.065f32 && absf(led_y) < 0.045f32 {
        return 248u32;
    }
    if absf(led_x) < 0.13f32 && absf(led_y) < 0.11f32 {
        return 28u32;
    }
    var joint: f32 = absf(px - metal_door_joint(y));
    if joint < 0.035f32 {
        return 12u32;
    }
    if joint < 0.075f32 {
        return 190u32;
    }
    var apothem: f32 = material.tile_metres * 0.43301270189f32;
    var edge: f32 = apothem - absf(py);
    edge = mask_min(edge, apothem - absf(px) * 0.86602540378f32 - absf(py) * 0.5f32);
    if edge < 0.09f32 {
        return 24u32;
    }
    if edge < 0.19f32 {
        return 185u32;
    }
    var seam: f32 = absf(absf(py) - 1.8f32);
    if seam < 0.025f32 {
        return 55u32;
    }
    return (145f32 + metal_grain(material, x, y)) as u32;
}
// Indicators have a quarter-turn symmetric offset within their quadrants.
// Dimensions are in metres relative to the door centre.
fn metal_oct_door_led(x: f32, y: f32) -> u32 {
    var px: f32 = absf(x);
    var py: f32 = absf(y);
    if x * y < 0f32 {
        px = absf(y);
        py = absf(x);
    }
    var dx: f32 = px - 0.8f32;
    var dy: f32 = py - 0.45f32;
    if absf(dx) < 0.055f32 && absf(dy) < 0.055f32 {
        return 248u32;
    }
    if absf(dx) < 0.09f32 && absf(dy) < 0.09f32 {
        return 22u32;
    }
    return 0u32;
}
// An octagonal four-leaf door has a + joint and four fixed triangular pipe plates.
// Each leaf has one full-bright indicator near the centre. Tile size is diameter.
fn metal_oct_door_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var radius: f32 = material.tile_metres * 0.5f32;
    var px: f32 = absf(x - radius);
    var py: f32 = absf(y - radius);
    var across: f32 = mask_min(px, py);
    var along: f32 = px + py - across;
    var led: u32 = metal_oct_door_led(x - radius, y - radius);
    if led != 0u32 {
        return led;
    }
    var wide: f32 = radius * cosf(0.39269908169f32);
    var narrow: f32 = radius * sinf(0.39269908169f32);
    var edge: f32 = mask_min(wide - along, (wide + narrow - px - py) * 0.70710678f32);
    if edge < 0.07f32 {
        return 22u32;
    }
    if edge < 0.13f32 {
        return 185u32;
    }
    var plate: f32 = along - (wide - narrow) - across;
    if plate > -0.04f32 {
        return metal_oct_pipe_plate(material, x, y, plate);
    }
    var joint: f32 = across;
    if joint < 0.035f32 {
        return 12u32;
    }
    if joint < 0.08f32 {
        return 190u32;
    }
    return (149f32 + metal_grain(material, x, y)) as u32;
}
fn metal_oct_pipe_plate(material: PanelMaterial, x: f32, y: f32, edge: f32) -> u32 {
    if edge < 0.035f32 {
        return 20u32;
    }
    if edge < 0.095f32 {
        return 181u32;
    }
    return (100f32 + metal_grain(material, x, y)) as u32;
}
// Shared door and fixed-plate material for OCT-8M stoppers.
fn oct_stopper_door_material() -> PanelMaterial {
    var material: PanelMaterial = oct_service_material(0u32);
    material.finish = METAL_OCT_DOOR;
    material.tile_metres = service_oct_profile().radius * 2f32;
    material.panel_height = material.tile_metres;
    material.colour = 0x949ba4u32;
    material.emission = 0x0000ffu32;
    return material;
}
fn stopper_seat_material() -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0u32;
    material.accent = 0u32;
    material.emission = 0u32;
    material.texels_per_metre = 1u32;
    return material;
}
