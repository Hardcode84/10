const METAL_FILTER: u32 = 16u32;
const METAL_GRATE: u32 = 15u32;
const METAL_FULLBRIGHT: u32 = 14u32;
const METAL_PLATE: u32 = 0u32;
const METAL_TREAD: u32 = 1u32;
const METAL_RIBBED: u32 = 2u32;
const METAL_HEX: u32 = 3u32;
const METAL_DOOR: u32 = 4u32;
const METAL_PIPE: u32 = 5u32;
const METAL_OCT_DOOR: u32 = 6u32;
const METAL_TRAPEZOID: u32 = 7u32;
const METAL_HEX_COVER: u32 = 8u32;
const METAL_PLAIN: u32 = 9u32;
const METAL_LEAK: u32 = 10u32;
const METAL_PIPE_COATED: u32 = 11u32;
const METAL_GIRDER_WEB: u32 = 12u32;
const METAL_GIRDER_MOUNT: u32 = 13u32;
// Dimensions are in metres. Repeated plate height must divide the tile height
// remaining after band_width is removed.
// Sizes and texel density must be positive.
// Ribbed metal requires a pitch greater than the 0.065 m seam width.
// METAL_HEX uses width = 3 radii and height = sqrt(3) radii.
// METAL_HEX ignores panel height and pitch.
// METAL_TRAPEZOID requires 0 < top_width <= tile_metres; it fills one tile.
// METAL_HEX_COVER has one centred cover with alternating edge apothems.
// Its first edge faces -Y. Both apothems must exceed 0.6 m.
// Marking is 0 (none), 1 (paired strips), 2 (split bars), or 3 (inset studs).
// Finish is METAL_PLATE, METAL_TREAD, METAL_RIBBED, METAL_HEX, METAL_DOOR,
// METAL_PIPE, METAL_TRAPEZOID, METAL_HEX_COVER, METAL_PLAIN, METAL_LEAK,
// METAL_GIRDER_MOUNT, METAL_GIRDER_WEB, METAL_PIPE_COATED, or METAL_OCT_DOOR. METAL_LEAK uses a 1.1 by 1.8 m cutout tile.
// METAL_PIPE_COATED uses exposed length, circumference, and face width as
// tile_metres, tile_height, and panel_height. Exposed length is at least 0.5 m.
// METAL_FULLBRIGHT fills the tile with the emission colour.
// METAL_GRATE has a square cutout grid; border sets the bar width.
// METAL_FILTER uses pitch for the positive fold spacing.
// Colours use packed RGB.
record PanelMaterial {
    colour: u32;
    accent: u32;
    emission: u32;
    tile_metres: f32;
    tile_height: f32;
    panel_height: f32;
    // Dark band centred on each tile boundary along Y; zero disables it.
    // Width is smaller than tile_height. Metal starts at the band edge.
    band_width: f32;
    // METAL_TRAPEZOID has a centred top edge of this width, in metres.
    top_width: f32;
    hex_apothem: f32;
    hex_clip_apothem: f32;
    texels_per_metre: u32;
    border: f32;
    finish: u32;
    pitch: f32;
    seed: u32;
    indicator: bool;
    marking: u32;
}
fn metal_hash(x: u32, y: u32, seed: u32) -> u32 {
    var h: u32 = (x * 73856093u32) ^ (y * 19349663u32) ^ seed;
    h = (h ^ (h >> 13u32)) * 1274126177u32;
    return h ^ (h >> 16u32);
}
// Samples metal grain in metres. Grain contrast stays below panel relief contrast.
fn metal_grain(material: PanelMaterial, x: f32, y: f32) -> f32 {
    var row: u32 = (y * material.texels_per_metre as f32) as u32;
    var column: u32 = (x * material.texels_per_metre as f32) as u32;
    var brush: f32 = (metal_hash(column / 16u32, row, material.seed) % 7u32) as f32;
    var fleck: f32 = (metal_hash(column, row, material.seed) % 3u32) as f32;
    return brush + fleck - 4f32;
}
fn metal_tread(material: PanelMaterial, x: f32, y: f32) -> f32 {
    var cell: u32 = (x / material.pitch) as u32 + (y / material.pitch) as u32;
    var px: f32 = mask_repeat(x, material.pitch) - material.pitch * 0.5f32;
    var py: f32 = mask_repeat(y, material.pitch) - material.pitch * 0.5f32;
    if cell % 2u32 == 0u32 {
        py = -py;
    }
    var along: f32 = (px + py) * 0.70710678f32;
    var across: f32 = (px - py) * 0.70710678f32;
    if absf(along) < material.pitch * 0.31f32 && absf(across) < 0.025f32 {
        if across < 0f32 {
            return 19f32;
        }
        return -17f32;
    }
    return 0f32;
}
fn metal_relief(material: PanelMaterial, x: f32, y: f32) -> f32 {
    if material.finish == METAL_TREAD {
        return metal_tread(material, x, y);
    }
    return 0f32;
}
// Samples continuous folded metal strips without crosswise panel joints.
fn metal_strip_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var across: f32 = mask_repeat(x, material.pitch);
    var shade: f32 = 154f32;
    if across < 0.035f32 {
        shade = 94f32;
    } else if across < 0.065f32 {
        shade = 184f32;
    } else {
        var field: f32 = (across - 0.065f32) / (material.pitch - 0.065f32);
        shade = shade + 8f32 * (1f32 - absf(field * 2f32 - 1f32));
    }
    return (shade + metal_grain(material, y, x) * 0.5f32) as u32;
}
fn metal_fastener(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var px: f32 = mask_min(x, material.tile_metres - x) - 0.12f32;
    var py: f32 = y - 0.12f32;
    if px * px + py * py > 0.0016f32 {
        return 0u32;
    }
    if px * px + py * py > 0.0009f32 {
        return 60u32;
    }
    if absf(py) < 0.008f32 {
        return 75u32;
    }
    if py < 0f32 {
        return 210u32;
    }
    return 130u32;
}
// Returns a palette index for a point within one repeated panel tile.
fn panel_base_sample(material: PanelMaterial, x: f32, tile_y: f32) -> u32 {
    if material.finish == METAL_FILTER {
        return metal_filter_sample(material, x, tile_y);
    }
    if material.finish == METAL_GRATE {
        return metal_grate_sample(material, x, tile_y);
    }
    if material.finish == METAL_GIRDER_MOUNT {
        return metal_girder_mount_sample(material, x, tile_y);
    }
    if material.finish == METAL_GIRDER_WEB {
        return metal_girder_web_sample(material, x, tile_y);
    }
    if material.finish == METAL_PIPE_COATED {
        return metal_pipe_coated_sample(material, x, tile_y);
    }
    if material.finish == METAL_LEAK {
        return metal_leak_sample(material, x, tile_y);
    }
    if material.finish == METAL_PLAIN {
        return (150f32 + metal_grain(material, x, tile_y)) as u32;
    }
    if material.finish == METAL_HEX_COVER {
        return metal_hex_cover_sample(material, x, tile_y);
    }
    if material.finish == METAL_TRAPEZOID {
        return metal_trapezoid_sample(material, x, tile_y);
    }
    if material.finish == METAL_OCT_DOOR {
        return metal_oct_door_sample(material, x, tile_y);
    }
    if material.finish == METAL_PIPE {
        return metal_pipe_sample(material, x, tile_y);
    }
    if material.finish == METAL_DOOR {
        return metal_door_sample(material, x, tile_y);
    }
    if material.finish == METAL_RIBBED {
        return metal_strip_sample(material, tile_y, x);
    }
    if material.finish == METAL_HEX {
        return metal_hex_sample(material, x, tile_y);
    }
    return metal_plate_sample(material, x, tile_y);
}
fn metal_plate_sample(material: PanelMaterial, x: f32, tile_y: f32) -> u32 {
    var y: f32 = mask_repeat(tile_y, material.panel_height);
    if mask_border(x, y, material.tile_metres, material.panel_height, material.border) {
        return 24u32;
    }
    var edge: f32 = material.border + 0.025f32;
    if x < edge || y < edge {
        return 194u32;
    }
    if x > material.tile_metres - edge || y > material.panel_height - edge {
        return 82u32;
    }
    var screw: u32 = metal_fastener(material, x, y);
    if screw != 0u32 {
        return screw;
    }
    if material.indicator && mask_box(
        x,
        y,
        0.25f32,
        0.19f32,
        material.tile_metres - 0.25f32,
        0.30f32
    ) {
        if y < 0.23f32 {
            return 248u32;
        }
        return 228u32;
    }
    var edge_distance: f32 = mask_min(
        mask_min(x, y),
        mask_min(material.tile_metres - x, material.panel_height - y)
    );
    var plate: u32 = (tile_y / material.panel_height) as u32;
    var sheen: f32 = 9f32 * (1f32 - absf(x / material.tile_metres * 2f32 - 1f32));
    var shade: f32 = 150f32 + (plate % 2u32) as f32 * 6f32 + sheen + metal_grain(material, x, y) + metal_relief(
        material,
        x,
        y
    );
    shade = shade - 22f32 * (1f32 - clamp(edge_distance / 0.20f32, 0f32, 1f32));
    return clamp(shade, 1f32, 223f32) as u32;
}

fn panel_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    if material.finish == METAL_FULLBRIGHT {
        return 248u32;
    }
    var local_y: f32 = y;
    if material.band_width > 0f32 {
        if y < material.band_width * 0.5f32 || y >= material.tile_height - material.band_width * 0.5f32 {
            return 8u32;
        }
        local_y = y - material.band_width * 0.5f32;
    }
    var marking: u32 = panel_mark_sample(material, x, local_y);
    if marking != 0u32 {
        return marking;
    }
    return panel_base_sample(material, x, local_y);
}

// Samples a single isosceles trapezoid with constant-width perimeter seams.
// The bottom edge fills the tile width; the narrower top edge is centred.
fn metal_trapezoid_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var slope: f32 = (material.tile_metres - material.top_width) / (2f32 * material.tile_height);
    var side: f32 = (mask_min(x, material.tile_metres - x) - slope * y) / sqrtf(
        1f32 + slope * slope
    );
    var distance: f32 = mask_min(side, mask_min(y, material.tile_height - y));
    if distance < material.border {
        return 24u32;
    }
    if distance < material.border + 0.025f32 {
        return 82u32;
    }
    return (150f32 + metal_grain(material, x, y)) as u32;
}

// Samples six recessed fasteners around a hexagonal cover, in physical metres.
fn metal_hex_cover_bolts(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var i: u32 = 0u32;
    while i < 6u32 {
        var angle: f32 = i as f32 * 1.0471975512f32 - 1.57079632679f32;
        var radius: f32 = material.hex_apothem - 0.25f32;
        if i % 2u32 != 0u32 {
            radius = material.hex_clip_apothem - 0.25f32;
        }
        var dx: f32 = x - radius * cosf(angle);
        var dy: f32 = y - radius * sinf(angle);
        var distance: f32 = dx * dx + dy * dy;
        if distance < 0.0064f32 {
            if distance > 0.0036f32 {
                return 72u32;
            }
            if absf(dy) < 0.012f32 {
                return 85u32;
            }
            return 174u32;
        }
        i = i + 1u32;
    }
    return 0u32;
}
// Samples a cast-metal panel with one closed, bevelled hexagonal service cover.
fn metal_hex_cover_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var px: f32 = x - material.tile_metres * 0.5f32;
    var py: f32 = y - material.tile_height * 0.5f32;
    var diagonal: f32 = absf(px) * 0.86602540378f32;
    var first: f32 = -mask_min(py, -diagonal - py * 0.5f32);
    var second: f32 = -mask_min(-py, -diagonal + py * 0.5f32);
    var distance: f32 = mask_min(
        material.hex_apothem - first,
        material.hex_clip_apothem - second
    );
    var edge: f32 = 0.5f32 - distance;
    var shade: f32 = 144f32;
    if edge < -0.16f32 {
        shade = 125f32;
    } else if edge < -0.12f32 {
        shade = 79f32;
    } else if edge < -0.07f32 {
        shade = 172f32;
    } else if edge < 0f32 {
        shade = 156f32;
    } else if edge < 0.035f32 {
        shade = 65f32;
    } else if edge < 0.075f32 {
        shade = 162f32;
    }
    if distance < material.border {
        return 24u32;
    } else if distance < material.border + 0.025f32 {
        shade = 174f32;
    }
    var bolt: u32 = metal_hex_cover_bolts(material, px, py);
    if bolt != 0u32 {
        return bolt;
    }
    return (shade + metal_grain(material, x, y)) as u32;
}
