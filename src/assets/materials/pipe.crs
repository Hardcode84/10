// Axial coordinates run along X. Coupling bands meet at the repeated tile ends.
fn metal_pipe_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var end: f32 = mask_min(x, material.tile_metres - x);
    if end < 0.025f32 {
        return 35u32;
    }
    if end < 0.045f32 {
        return 192u32;
    }
    if end < 0.12f32 {
        return 108u32;
    }
    if end < 0.14f32 {
        return 182u32;
    }
    return (153f32 + metal_grain(material, x, y) * 0.5f32) as u32;
}
fn service_pipe_material() -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = METAL_PIPE;
    material.colour = 0x6589b0u32;
    material.panel_height = 2f32;
    return material;
}
fn service_mount_material(leak: bool) -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = METAL_PLAIN;
    material.colour = 0x35373bu32;
    if leak {
        material.finish = METAL_LEAK;
        material.colour = 0x807568u32;
        material.tile_metres = 1.1f32;
        material.tile_height = 1.8f32;
    }
    return material;
}

fn oct_service_material(region: u32) -> PanelMaterial {
    if region == 1u32 {
        return service_pipe_material();
    }
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0xafa69cu32;
    if region == 2u32 {
        material.colour = 0x686e74u32;
    }
    return material;
}

// Transparent grime patch with its source at (0.55, 0.4) m and streaks along +Y.
fn metal_leak_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var across: f32 = absf(x - 0.55f32);
    var along: f32 = y - 0.4f32;
    var noise: u32 = metal_hash((x * 64f32) as u32, (y * 64f32) as u32, material.seed);
    var pool: f32 = 1f32 - sqrtf(across * across + along * along) / 0.43f32;
    var stripe: u32 = metal_hash((x * 48f32) as u32, 0u32, material.seed);
    var reach: f32 = 0.55f32 + (stripe % 100u32) as f32 * 0.008f32;
    var trail: f32 = 0f32;
    if along >= 0f32 {
        trail = clamp(1f32 - along / reach, 0f32, 1f32) * clamp(
            1f32 - across / 0.34f32,
            0f32,
            1f32
        );
    }
    var coverage: f32 = -mask_min(-pool, -trail);
    if coverage <= 0f32 || (noise % 256u32) as f32 / 256f32 > coverage * 0.85f32 {
        return 0u32;
    }
    return 70u32 + noise % 30u32;
}

// Coated pipe between two collars. X spans the exposed length; Y spans the circumference.
// End bands and worn metal edges keep their physical width as the pipe changes size.
fn metal_pipe_coated_sample(material: PanelMaterial, x: f32, y: f32) -> u32 {
    var end: f32 = mask_min(x, material.tile_metres - x);
    var edge: f32 = mask_min(y, material.tile_height - y);
    var grain: f32 = metal_grain(material, x, y);
    if end < 0.035f32 {
        return 35u32;
    }
    if end < 0.065f32 {
        return 231u32;
    }
    if end < 0.16f32 {
        return (82f32 + grain) as u32;
    }
    if end < 0.19f32 {
        return 228u32;
    }
    if edge < 0.012f32 {
        return 90u32;
    }
    if edge < 0.03f32 {
        return 184u32;
    }
    var wear: u32 = metal_hash((x * 40f32) as u32, (y * 40f32) as u32, material.seed);
    if end < 0.3f32 && wear % 5u32 == 0u32 {
        return 226u32;
    }
    var sheen: f32 = 12f32 * (
        1f32 - absf(
            mask_repeat(y, material.panel_height) / material.panel_height * 2f32 - 1f32
        )
    );
    return (170f32 + sheen + grain) as u32;
}
