fn mask_box(x: f32, y: f32, low_x: f32, low_y: f32, high_x: f32, high_y: f32) -> bool {
    return x >= low_x && y >= low_y && x <= high_x && y <= high_y;
}
fn mask_border(x: f32, y: f32, width: f32, height: f32, border: f32) -> bool {
    return !mask_box(x, y, border, border, width - border, height - border);
}
// Repeats a non-negative coordinate with a positive period, in metres.
fn mask_repeat(value: f32, period: f32) -> f32 {
    return value - (value / period) as u32 as f32 * period;
}
fn mask_min(a: f32, b: f32) -> f32 {
    if a < b {
        return a;
    }
    return b;
}
