fn prefab_shaft_cap_filter_parameter_count() -> u32 {
    return 3u32;
}
fn prefab_shaft_cap_filter_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("depth");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_cap_filter_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 10f32,
            maximum: 20f32,
            initial: 12f32,
            step: 1f32
        };
    }
    return shaft_parameter(index);
}
fn filter_grate_material() -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = METAL_GRATE;
    material.colour = 0x777b70u32;
    material.tile_metres = 0.6f32;
    material.tile_height = material.tile_metres;
    material.border = grate_texel_bar_width(
        material.tile_metres,
        0.12f32,
        material.texels_per_metre
    );
    return material;
}
fn prefab_shaft_cap_filter_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_cap_filter_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_cap_filter_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var layout: FilterPlenumLayout = make FilterPlenumLayout {
        depth: asset_value(read parameters, 0u32),
        radius: asset_value(read parameters, 1u32) * 0.5f32,
        core: asset_value(read parameters, 2u32) * 0.5f32
    };
    if layout.radius - filter_bearing_radius(layout) < 3.1f32 {
        return error("filter plenum needs clearance for its cassettes and ducts");
    }
    if !filter_plenum_shell(mut asset, layout) || !shaft_core(
        mut asset,
        layout.core,
        layout.depth,
        2f32
    ) || !filter_plenum_grate(mut asset, layout) || !filter_plenum_equipment(mut asset, layout) {
        return false;
    }
    var eye: Vec3 = vec(
        (layout.radius + filter_bearing_radius(layout)) * 0.5f32,
        0.6f32,
        0f32
    );
    var forward: Vec3 = unit_vector(
        sub(vec(0f32, filter_grate_height(layout) + 2f32, 0f32), eye)
    );
    var right: Vec3 = unit_vector(cross(forward, vec(0f32, 0f32, -1f32)));
    asset.spawn = make AssetSpawn {
        position: eye,
        basis: make Basis {
            right: right,
            up: cross(forward, right),
            forward: forward
        }
    };
    return room_asset_finish(mut asset);
}
fn prefab_shaft_cap_filter_material_count() -> u32 {
    return 9u32;
}
fn prefab_shaft_cap_filter_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    if region == 3u32 {
        return filter_grate_material();
    }
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 2u32 {
        material.tile_metres = asset_value(read parameters, 2u32) * sinf(3.14159265359f32 / 48f32);
        material.tile_height = 2f32;
    }
    if region >= 4u32 {
        material = hex_tunnel_material();
        material.finish = METAL_PLAIN;
    }
    if region == 4u32 {
        material.colour = 0x7b8586u32;
        material.finish = METAL_FILTER;
        material.pitch = material.tile_height / 10f32;
    }
    if region == 5u32 {
        material.colour = 0x675b49u32;
    }
    if region == 6u32 {
        material.colour = 0x444d46u32;
    }
    if region == 7u32 {
        material.colour = 0x141817u32;
    }
    if region == 8u32 {
        material.colour = filter_grate_material().colour;
    }
    return material;
}
