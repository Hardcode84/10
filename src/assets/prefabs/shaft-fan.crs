const SHAFT_FAN_HOUSING_EXTRA: f32 = 0.6f32;
const SHAFT_FAN_END_CLEARANCE: f32 = 2f32;
fn prefab_shaft_fan_parameter_count() -> u32 {
    return 5u32;
}
fn prefab_shaft_fan_parameter_name(index: u32) -> AssetName {
    if index == 3u32 {
        return asset_name("blade-count");
    }
    if index == 4u32 {
        return asset_name("blade-depth");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_fan_parameter(index: u32) -> AssetParameter {
    if index == 3u32 {
        return make AssetParameter {
            minimum: 3f32,
            maximum: 8f32,
            initial: 4f32,
            step: 1f32
        };
    }
    if index == 4u32 {
        return make AssetParameter {
            minimum: 0.6f32,
            maximum: 4f32,
            initial: 2f32,
            step: 0.2f32
        };
    }
    if index == 0u32 {
        var blade: AssetParameter = prefab_shaft_fan_parameter(4u32);
        var margin: f32 = SHAFT_FAN_HOUSING_EXTRA + 2f32 * SHAFT_FAN_END_CLEARANCE;
        return make AssetParameter {
            minimum: blade.minimum + margin,
            maximum: 24f32,
            initial: blade.initial + margin,
            step: 0.2f32
        };
    }
    return shaft_parameter(index);
}
fn shaft_fan_valid(parameters: read AssetValues) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_fan_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_fan_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var blades: f32 = asset_value(read parameters, 3u32);
    if blades != blades as u32 as f32 {
        return error("blade-count must be an integer");
    }
    if asset_value(read parameters, 0u32) < asset_value(read parameters, 4u32) + SHAFT_FAN_HOUSING_EXTRA + 2f32 * SHAFT_FAN_END_CLEARANCE {
        return error("fan room needs clearance between its bearing housing and both end ports");
    }
    return (asset_value(read parameters, 1u32) - asset_value(read parameters, 2u32)) * 0.5f32 >= 2.2f32 || error(
        "fan needs clearance between its bearing sleeve and the wall"
    );
}
fn shaft_fan_part(
    asset: mut RoomAsset,
    name: AssetName,
    first: u32,
    count: u32,
    height: f32,
    angle: f32
) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            linear: vec(0f32, 0f32, 0f32),
            angular: vec(0f32, 0f32, 0f32),
            name: name,
            first: first,
            count: count,
            origin: vec(0f32, height, 0f32),
            basis: shaft_axis_basis(angle)
        }
    );
}
fn shaft_fan_instances(
    asset: mut RoomAsset,
    parameters: read AssetValues,
    first: u32,
    count: u32,
    housing: u32,
    housing_count: u32
) -> bool {
    var blades: u32 = asset_value(read parameters, 3u32) as u32;
    var y: f32 = asset_value(read parameters, 0u32) * 0.5f32;
    if !shaft_fan_part(
        mut asset,
        asset_name("fan-bearing"),
        housing,
        housing_count,
        y,
        0f32
    ) {
        return false;
    }
    var blade: u32 = 0u32;
    while blade < blades {
        var angle: f32 = blade as f32 * 6.28318530718f32 / blades as f32;
        if !shaft_fan_part(mut asset, asset_name("fan-blade"), first, count, y, angle) {
            return false;
        }
        blade = blade + 1u32;
    }
    return true;
}

fn shaft_fan_blade(parameters: read AssetValues) -> FanBlade {
    var sector: f32 = 6.28318530718f32 / asset_value(read parameters, 3u32);
    return make FanBlade {
        inner: asset_value(read parameters, 2u32) * 0.5f32,
        outer: asset_value(read parameters, 1u32) * 0.5f32 / cosf(sector / 24f32),
        sector: sector,
        depth: asset_value(read parameters, 4u32),
        thickness: 0.25f32,
        radial_steps: 5u32,
        angular_steps: 6u32
    };
}
fn shaft_fan_geometry(asset: mut RoomAsset, parameters: read AssetValues) -> bool {
    var radius: f32 = asset_value(read parameters, 1u32) * 0.5f32;
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    var depth: f32 = asset_value(read parameters, 4u32);
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !fan_blade_mesh(mut asset.geometry, shaft_fan_blade(read parameters)) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var housing: u32 = mesh_triangle_count(read asset.geometry);
    if !annular_band_mesh(
        mut asset.geometry,
        core * 0.98f32,
        core + 0.35f32,
        depth + SHAFT_FAN_HOUSING_EXTRA,
        7u32,
        FAN_TEXTURE_METRES,
        FAN_TEXTURE_METRES
    ) || !annular_band_mesh(
        mut asset.geometry,
        radius - 0.35f32,
        radius + 0.1f32,
        depth + SHAFT_FAN_HOUSING_EXTRA,
        7u32,
        FAN_TEXTURE_METRES,
        FAN_TEXTURE_METRES
    ) {
        return false;
    }
    var housing_count: u32 = mesh_triangle_count(read asset.geometry) - housing;
    return shaft_fan_instances(
        mut asset,
        read parameters,
        first,
        count,
        housing,
        housing_count
    );
}
fn shaft_fan_track_surfaces(asset: mut RoomAsset, height: f32) -> unit {
    var sides: u32 = shaft_profile(shaft_parameter(1u32).initial).shape.sides;
    var i: u32 = 0u32;
    while i < sides {
        var surface: SurfaceFrame = asset_surface(read asset.hull, i);
        surface.origin.y = surface.origin.y + height * 0.5f32;
        asset_surface_set(mut asset.hull, i, surface);
        i = i + 1u32;
    }
    mesh_offset_uv(mut asset.geometry, 0f32, -0.5f32);
}
fn prefab_shaft_fan_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !shaft_fan_valid(read parameters) {
        return false;
    }
    var height: f32 = asset_value(read parameters, 0u32);
    if !shaft_room_shell(
        mut asset,
        asset_value(read parameters, 1u32) * 0.5f32,
        asset_value(read parameters, 2u32) * 0.5f32,
        height,
        0u32
    ) {
        return false;
    }
    shaft_fan_track_surfaces(mut asset, height);
    return shaft_fan_geometry(mut asset, read parameters) && room_asset_finish(mut asset);
}

fn prefab_shaft_fan_material_count() -> u32 {
    return 8u32;
}
fn prefab_shaft_fan_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    if region == 0u32 || region == 2u32 {
        var track: PanelMaterial = shaft_surface_material(region);
        var diameter: f32 = asset_value(read parameters, 1u32);
        if region == 2u32 {
            diameter = asset_value(read parameters, 2u32);
        }
        track.tile_metres = diameter * sinf(
            3.14159265359f32 / shaft_profile(asset_value(read parameters, 1u32)).shape.sides as f32
        );
        track.tile_height = asset_value(read parameters, 0u32);
        track.panel_height = track.tile_height;
        track.band_width = asset_value(read parameters, 4u32) + SHAFT_FAN_HOUSING_EXTRA;
        return track;
    }
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 3u32 {
        material.colour = 0x3f718au32;
        material.accent = 0x252d30u32;
        material.finish = METAL_PLATE;
        var blade: FanBlade = shaft_fan_blade(read parameters);
        material.tile_metres = (blade.outer - blade.inner) / fan_blade_panels(blade) as f32;
        material.tile_height = blade.outer * fan_blade_width(blade, 1f32);
        material.panel_height = material.tile_height;
    }
    if region == 7u32 {
        material.colour = 0x403c33u32;
        material.accent = 0x201d16u32;
        material.tile_metres = FAN_TEXTURE_METRES;
        material.tile_height = FAN_TEXTURE_METRES;
        material.finish = METAL_RIBBED;
        material.pitch = 0.25f32;
    }
    return material;
}
