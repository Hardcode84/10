const SHAFT_GIRDER_RAIL_REGION: u32 = 3u32;
const SHAFT_GIRDER_WEB_REGION: u32 = 7u32;
const SHAFT_GIRDER_MOUNT_REGION: u32 = 8u32;
fn prefab_shaft_girders_parameter_count() -> u32 {
    return 7u32;
}
fn prefab_shaft_girders_parameter_name(index: u32) -> AssetName {
    if index == 5u32 {
        return asset_name("girder-depth");
    }
    if index == 6u32 {
        return asset_name("rail-width");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_girders_parameter(index: u32) -> AssetParameter {
    if index == 5u32 {
        return make AssetParameter {
            minimum: 1f32,
            maximum: 4f32,
            initial: 2f32,
            step: 0.25f32
        };
    }
    if index == 6u32 {
        return make AssetParameter {
            minimum: 0.15f32,
            maximum: 0.6f32,
            initial: 0.3f32,
            step: 0.05f32
        };
    }
    return shaft_parameter(index);
}
fn shaft_girder_layout(parameters: read AssetValues) -> ShaftGirderLayout {
    return make ShaftGirderLayout {
        wall: asset_value(read parameters, 1u32) * 0.5f32,
        core: asset_value(read parameters, 2u32) * 0.5f32,
        height: asset_value(read parameters, 0u32),
        stations: asset_value(read parameters, 3u32) as u32,
        seed: asset_value(read parameters, 4u32) as u32,
        depth: asset_value(read parameters, 5u32),
        rail: asset_value(read parameters, 6u32)
    };
}
fn prefab_shaft_girders_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_girders_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_girders_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var count: f32 = asset_value(read parameters, 3u32);
    var seed: f32 = asset_value(read parameters, 4u32);
    if count != count as u32 as f32 || seed != seed as u32 as f32 {
        return error("station-count and pipe-seed must be integers");
    }
    var layout: ShaftGirderLayout = shaft_girder_layout(read parameters);
    if layout.wall * cosf(PI / 48f32) - layout.core < 2f32 {
        return error("shaft needs at least 2 m between the spindle and wall");
    }
    if layout.depth <= layout.rail * 3f32 {
        return error("girder depth must exceed three rail widths");
    }
    if layout.height / (layout.stations + 1u32) as f32 < layout.depth + 2.3f32 {
        return error("girder stations need space for rails and service pipes");
    }
    return shaft_room_shell(
        mut asset,
        layout.wall,
        layout.core,
        layout.height,
        layout.stations
    ) && shaft_girders(mut asset, layout) && shaft_girder_service_pipes(mut asset, layout) && room_asset_finish(
        mut asset
    );
}
fn prefab_shaft_girders_material_count() -> u32 {
    return 9u32;
}
fn prefab_shaft_girders_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 0u32 || region == 2u32 {
        material = shaft_track_material(region, read parameters);
        material.band_width = 0f32;
        material.panel_height = material.tile_height;
        if region == 2u32 {
            material.finish = METAL_PLAIN;
        }
    }
    if region == SHAFT_GIRDER_RAIL_REGION || region == SHAFT_GIRDER_WEB_REGION {
        material.colour = 0x295779u32;
        material.finish = METAL_PLAIN;
    }
    if region == SHAFT_GIRDER_WEB_REGION {
        var layout: ShaftGirderLayout = shaft_girder_layout(read parameters);
        material.finish = METAL_GIRDER_WEB;
        material.tile_metres = shaft_girder_web_period(layout);
        material.tile_height = layout.depth - layout.rail;
        material.border = layout.rail * 0.6f32;
    }
    if region == SHAFT_GIRDER_MOUNT_REGION {
        var size: f32 = shaft_girder_pad_size(shaft_girder_layout(read parameters));
        material.finish = METAL_GIRDER_MOUNT;
        material.colour = 0x454b50u32;
        material.accent = 0x929ba4u32;
        material.tile_metres = size;
        material.tile_height = size;
        material.top_width = asset_value(read parameters, 6u32);
    }
    return material;
}
