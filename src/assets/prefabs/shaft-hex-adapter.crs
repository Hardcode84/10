fn prefab_shaft_hex_adapter_parameter_count() -> u32 {
    return 3u32;
}
fn prefab_shaft_hex_adapter_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("depth");
    }
    return prefab_shaft_rotor_parameter_name(index);
}
fn prefab_shaft_hex_adapter_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 0.5f32,
            maximum: 4f32,
            initial: 1f32,
            step: 0.5f32
        };
    }
    return prefab_shaft_rotor_parameter(index);
}
fn prefab_shaft_hex_adapter_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_hex_adapter_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_hex_adapter_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var depth: f32 = asset_value(read parameters, 0u32);
    var diameter: f32 = asset_value(read parameters, 1u32);
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    if !prefab_shaft_rotor_cylinder(mut asset.hull, diameter * 0.5f32, depth, 0u32, 1u32) || !prefab_shaft_rotor_core(
        mut asset,
        core,
        depth,
        2f32
    ) || !prefab_shaft_hex_adapter_connections(mut asset, core) {
        return false;
    }
    asset.spawn = make AssetSpawn {
        position: vec((diameter * 0.5f32 + core) * 0.5f32, depth * 0.5f32, 0f32),
        basis: cube_face_basis(3u32)
    };
    return asset_port_append(
        mut asset.ports,
        make RoomPort {
            id: asset_name("SHAFT"),
            profile: shaft_profile(diameter),
            face: 49u32,
            position: vec(0f32, depth, 0f32),
            basis: cube_face_basis(3u32)
        }
    ) && room_asset_finish(mut asset);
}
fn prefab_shaft_hex_adapter_material_count() -> u32 {
    return 5u32;
}
fn prefab_shaft_hex_adapter_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    var material: PanelMaterial = prefab_shaft_rotor_surface_material(region);
    if region == 2u32 {
        material.tile_metres = asset_value(read parameters, 2u32) * sinf(3.14159265359f32 / 48f32);
        material.tile_height = 2f32;
    }
    if region >= 3u32 {
        return prefab_shaft_hex_adapter_end_material(region);
    }
    return material;
}

fn prefab_shaft_hex_adapter_end_material(region: u32) -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0x807769u32;
    material.finish = METAL_HEX;
    material.tile_metres = 9f32;
    material.tile_height = 9f32 * 0.57735026919f32;
    if region == 4u32 {
        material.colour = 0x788dadu32;
    }
    return material;
}
fn prefab_shaft_hex_adapter_port_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("BOTTOM-0");
    }
    if index == 1u32 {
        return asset_name("BOTTOM-1");
    }
    return asset_name("BOTTOM-2");
}
fn prefab_shaft_hex_adapter_port(index: u32, distance: f32) -> RoomPort {
    var angle: f32 = 3.14159265359f32 / 48f32 + 1.04719755120f32 + index as f32 * 2.09439510239f32;
    var radial: Vec3 = vec(cosf(angle), 0f32, sinf(angle));
    return make RoomPort {
        id: prefab_shaft_hex_adapter_port_name(index),
        profile: service_hex_profile(),
        face: 48u32 + index,
        position: scale(radial, distance),
        basis: make Basis {
            right: vec(radial.z, 0f32, -radial.x),
            up: radial,
            forward: vec(0f32, -1f32, 0f32)
        }
    };
}
fn prefab_shaft_hex_adapter_port_fits(hull: read AssetHull, port: RoomPort, core: f32) -> bool {
    var face: HullFace = asset_face(read hull, port.face);
    var i: u32 = 0u32;
    while i < 6u32 {
        var p: Vec3 = connection_point(port, i);
        var j: u32 = 0u32;
        while j < face.count {
            if inset_turn(
                hull_corner(read hull, face, j),
                hull_corner(read hull, face, (j + 1u32) % face.count),
                p,
                port.basis.forward
            ) <= 0f32 {
                return error("adapter diameter is too small for three HEX-6M end ports");
            }
            j = j + 1u32;
        }
        i = i + 1u32;
    }
    return length(port.position) - port.profile.radius * 0.86602540378f32 > core || error(
        "adapter spindle obstructs the end ports"
    );
}
fn prefab_shaft_hex_adapter_connections(asset: mut RoomAsset, core: f32) -> bool {
    var next: AssetHull = asset_hull_new();
    var first: u32 = asset_face_count(read asset.hull);
    if !hull_face_sectors(
        read asset.hull,
        mut next,
        48u32,
        3u32,
        vec(0f32, 0f32, 0f32)
    ) {
        return false;
    }
    asset_hull_swap(mut asset.hull, mut next);
    var spacing: f32 = service_hex_profile().radius * 1.73205080757f32;
    var ring: u32 = ((core + service_hex_profile().radius * 0.86602540378f32) / spacing) as u32 + 1u32;
    var distance: f32 = ring as f32 * spacing;
    var reference: RoomPort = prefab_shaft_hex_adapter_port(0u32, distance);
    var i: u32 = 0u32;
    while i < 3u32 {
        var port: RoomPort = prefab_shaft_hex_adapter_port(i, distance);
        if i != 0u32 {
            port.face = first + i - 1u32;
        }
        if !prefab_shaft_hex_adapter_port_fits(read asset.hull, port, core) {
            return false;
        }
        var material: PanelMaterial = prefab_shaft_hex_adapter_end_material(3u32);
        var surface: SurfaceFrame = make SurfaceFrame {
            origin: reference.position,
            right: scale(reference.basis.right, asset.tile_metres / material.tile_metres),
            up: scale(
                reference.basis.up,
                asset.tile_metres / panel_tile_height(material)
            ),
            normal: port.basis.forward
        };
        var face: HullFace = asset_face(read asset.hull, port.face);
        face.region = 3u32;
        asset_face_set(mut asset.hull, port.face, face);
        asset_surface_set(mut asset.hull, port.face, surface);
        if !hull_convex_partition(read asset.hull, mut next, port, 4u32) || !asset_port_append(
            mut asset.ports,
            port
        ) {
            return false;
        }
        asset_hull_swap(mut asset.hull, mut next);
        i = i + 1u32;
    }
    return true;
}
