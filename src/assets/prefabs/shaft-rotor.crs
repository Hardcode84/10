fn prefab_shaft_rotor_parameter_count() -> u32 {
    return shaft_parameter_count();
}
fn prefab_shaft_rotor_parameter_name(index: u32) -> AssetName {
    if index == 3u32 {
        return asset_name("rotor-count");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_rotor_parameter(index: u32) -> AssetParameter {
    return shaft_parameter(index);
}
fn prefab_shaft_rotor_basis(angle: f32) -> Basis {
    return make Basis {
        right: vec(cosf(angle), 0f32, sinf(angle)),
        up: vec(0f32, 1f32, 0f32),
        forward: vec(-sinf(angle), 0f32, cosf(angle))
    };
}

fn prefab_shaft_rotor_wings(mesh: mut Mesh, radius: f32, core: f32) -> bool {
    var rim: f32 = radius * cosf(3.14159265359f32 / 48f32);
    var width: f32 = mask_min(1.2f32, rim * 0.12f32);
    var i: u32 = 0u32;
    while i < 4u32 {
        var basis: Basis = prefab_shaft_rotor_basis(1.57079632679f32 * i as f32);
        var centre: Vec3 = scale(basis.right, (rim + core) * 0.5f32);
        if !solid_box_wrapped(
            mut mesh,
            vec(rim - core, 0.6f32, width),
            3u32,
            centre,
            basis,
            2f32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn prefab_shaft_rotor_rotors(
    asset: mut RoomAsset,
    radius: f32,
    core: f32,
    height: f32,
    count: u32
) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !prefab_shaft_rotor_wings(mut asset.geometry, radius, core) {
        return false;
    }
    var triangles: u32 = mesh_triangle_count(read asset.geometry) - first;
    var i: u32 = 0u32;
    while i < count {
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: asset_name("rotor"),
                first: first,
                count: triangles,
                origin: vec(0f32, height * (i + 1u32) as f32 / (count + 1u32) as f32, 0f32),
                basis: prefab_shaft_rotor_basis(0.78539816339f32 + 0.39269908169f32 * i as f32)
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn prefab_shaft_rotor_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !shaft_parameters_valid(read parameters) {
        return false;
    }
    var pipe_seed: f32 = asset_value(read parameters, 4u32);
    if pipe_seed != (pipe_seed as u32) as f32 {
        return error("pipe-seed must be an integer");
    }
    var height: f32 = asset_value(read parameters, 0u32);
    var diameter: f32 = asset_value(read parameters, 1u32);
    var radius: f32 = diameter * 0.5f32;
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    var count: f32 = asset_value(read parameters, 3u32);
    if count != count as u32 as f32 || height / (count + 1f32) < 3f32 {
        return error("rotor-count must be integral and leave at least 3 m between stations");
    }
    if radius * cosf(3.14159265359f32 / 48f32) - core < 2f32 {
        return error("shaft needs at least 2 m between the spindle and wall");
    }
    return shaft_room_shell(mut asset, radius, core, height, count as u32) && prefab_shaft_rotor_rotors(
        mut asset,
        radius,
        core,
        height,
        count as u32
    ) && shaft_service_pipes(mut asset, radius, core, height, count as u32, pipe_seed as u32) && room_asset_finish(
        mut asset
    );
}
fn prefab_shaft_rotor_material_count() -> u32 {
    return shaft_material_count();
}
fn prefab_shaft_rotor_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    if region == 3u32 {
        var material: PanelMaterial = shaft_surface_material(region);
        material.colour = 0x438ab0u32;
        material.accent = 0x3c4248u32;
        material.emission = 0x6dc6ffu32;
        material.finish = METAL_TREAD;
        material.marking = 2u32;
        material.pitch = 0.5f32;
        var rim: f32 = asset_value(read parameters, 1u32) * 0.5f32 * cosf(
            3.14159265359f32 / 48f32
        );
        material.tile_height = mask_min(1.2f32, rim * 0.12f32) + 0.6f32;
        material.panel_height = material.tile_height;
        return material;
    }
    if region == 0u32 || region == 2u32 {
        return shaft_track_material(region, read parameters);
    }
    return shaft_surface_material(region);
}
