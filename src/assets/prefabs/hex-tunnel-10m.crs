fn prefab_hex_tunnel_10m_parameter_count() -> u32 {
    return prefab_hex_tunnel_parameter_count();
}
fn prefab_hex_tunnel_10m_parameter(index: u32) -> AssetParameter {
    var parameter: AssetParameter = prefab_hex_tunnel_parameter(index);
    if index == 0u32 {
        parameter.initial = 10f32;
    }
    return parameter;
}
fn prefab_hex_tunnel_10m_parameter_name(index: u32) -> AssetName {
    return prefab_hex_tunnel_parameter_name(index);
}
fn prefab_hex_tunnel_10m_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_hex_tunnel_build(read parameters, mut asset);
}
fn prefab_hex_tunnel_10m_material_count() -> u32 {
    return prefab_hex_tunnel_material_count();
}
fn prefab_hex_tunnel_10m_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_hex_tunnel_material(region, read parameters);
}
