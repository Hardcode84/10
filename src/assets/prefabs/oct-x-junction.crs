const prefab_oct_x_junction_CONNECTIONS: u32 = 15u32;
fn prefab_oct_x_junction_parameter_count() -> u32 {
    return 3u32;
}
fn prefab_oct_x_junction_parameter(index: u32) -> AssetParameter {
    if index != 0u32 {
        return make AssetParameter {
            minimum: 0f32,
            maximum: 2f32,
            initial: 0f32,
            step: 1f32
        };
    }
    return make AssetParameter {
        minimum: 5f32,
        maximum: 12f32,
        initial: 5f32,
        step: 0.5f32
    };
}
fn prefab_oct_x_junction_parameter_name(index: u32) -> AssetName {
    if index == 1u32 {
        return asset_name("upper-pipes");
    }
    if index == 2u32 {
        return asset_name("lower-pipes");
    }
    return asset_name("leg");
}
fn prefab_oct_x_junction_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !prefab_oct_x_junction_parameters_valid(read parameters) {
        return false;
    }
    var upper: f32 = asset_value(read parameters, 1u32);
    var lower: f32 = asset_value(read parameters, 2u32);
    if upper != (upper as u32) as f32 || lower != (lower as u32) as f32 {
        return error("pipe routing must be 0 (cross), 1 (curve), or 2 (diagonal)");
    }
    var plan: JunctionPlan = junction_plan(
        prefab_oct_x_junction_CONNECTIONS,
        service_oct_profile().radius,
        asset_value(read parameters, 0u32)
    );
    return oct_junction_shell(plan, mut asset) && oct_junction_side_pipes(mut asset, plan) && oct_junction_layer_pipes(
        mut asset,
        plan,
        true,
        upper as u32
    ) && oct_junction_layer_pipes(mut asset, plan, false, lower as u32) && room_asset_finish(
        mut asset
    );
}
fn prefab_oct_x_junction_material_count() -> u32 {
    return 2u32;
}
fn prefab_oct_x_junction_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return oct_service_material(region);
}

fn prefab_oct_x_junction_parameters_valid(values: read AssetValues) -> bool {
    var i: u32 = 0u32;
    while i < prefab_oct_x_junction_parameter_count() {
        if !asset_parameter_valid(
            prefab_oct_x_junction_parameter(i),
            asset_value(read values, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
