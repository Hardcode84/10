fn prefab_oct_tunnel_10m_parameter_count() -> u32 {
    return 1u32;
}
fn prefab_oct_tunnel_10m_parameter_name(index: u32) -> AssetName {
    return asset_name("length");
}
fn prefab_oct_tunnel_10m_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 1f32,
        maximum: 40f32,
        initial: 10f32,
        step: 1f32
    };
}
fn prefab_oct_tunnel_10m_oct_tunnel_pipes(asset: mut RoomAsset, extent: f32) -> bool {
    var radius: f32 = oct_pipe_radius();
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var material: PanelMaterial = service_pipe_material();
    var sections: u32 = (extent / material.tile_metres) as u32;
    if sections as f32 * material.tile_metres < extent {
        sections = sections + 1u32;
    }
    var period: f32 = extent / sections as f32;
    if !solid_cylinder(mut asset.geometry, 12u32, radius, extent, 1u32, period) || !prefab_oct_tunnel_10m_oct_pipe_mounts(
        mut asset.geometry,
        extent,
        sections
    ) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var distance: f32 = oct_pipe_distance();
    var i: u32 = 0u32;
    while i < 4u32 {
        var angle: f32 = i as f32 * 1.57079632679f32;
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: oct_pipe_name(i),
                first: first,
                count: count,
                origin: vec(distance * cosf(angle), 0f32, distance * sinf(angle)),
                basis: make Basis {
                    right: vec(cosf(angle), 0f32, sinf(angle)),
                    up: vec(0f32, 1f32, 0f32),
                    forward: vec(-sinf(angle), 0f32, cosf(angle))
                }
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn prefab_oct_tunnel_10m_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !prefab_oct_tunnel_10m_parameters_valid(read parameters) {
        return false;
    }
    var extent: f32 = asset_value(read parameters, 0u32);
    if !passage_shape(extent, true, service_oct_profile(), mut asset) || !prefab_oct_tunnel_10m_oct_tunnel_pipes(
        mut asset,
        extent
    ) {
        return false;
    }
    asset.spawn.position.y = mask_min(1f32, extent * 0.5f32);
    return room_asset_finish(mut asset);
}
fn prefab_oct_tunnel_10m_material_count() -> u32 {
    return 3u32;
}
fn prefab_oct_tunnel_10m_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return oct_service_material(region);
}

fn prefab_oct_tunnel_10m_oct_pipe_mounts(mesh: mut Mesh, extent: f32, count: u32) -> bool {
    var i: u32 = 0u32;
    while i < count {
        var height: f32 = (i as f32 + 0.5f32) * extent / count as f32;
        if !solid_box(
            mut mesh,
            vec(0.23f32, 0.18f32, 0.32f32),
            2u32,
            vec(0.315f32, height, 0f32),
            identity_basis(),
            2f32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}

fn prefab_oct_tunnel_10m_parameters_valid(values: read AssetValues) -> bool {
    var i: u32 = 0u32;
    while i < prefab_oct_tunnel_10m_parameter_count() {
        if !asset_parameter_valid(
            prefab_oct_tunnel_10m_parameter(i),
            asset_value(read values, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
