fn prefab_shaft_pipes_parameter_count() -> u32 {
    return shaft_parameter_count() + 1u32;
}
fn prefab_shaft_pipes_parameter_name(index: u32) -> AssetName {
    if index == 5u32 {
        return asset_name("pipe-pattern");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_pipes_parameter(index: u32) -> AssetParameter {
    if index == 5u32 {
        return make AssetParameter {
            minimum: 0f32,
            maximum: 1f32,
            initial: 0f32,
            step: 1f32
        };
    }
    return shaft_parameter(index);
}
fn prefab_shaft_pipes_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !shaft_parameters_valid(read parameters) {
        return false;
    }
    var pattern: f32 = asset_value(read parameters, 5u32);
    if !asset_parameter_valid(prefab_shaft_pipes_parameter(5u32), pattern) || pattern != pattern as u32 as f32 {
        return error("pipe-pattern must be 0 (regular pairs) or 1 (random single pipes)");
    }
    var height: f32 = asset_value(read parameters, 0u32);
    var radius: f32 = asset_value(read parameters, 1u32) * 0.5f32;
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    var count: f32 = asset_value(read parameters, 3u32);
    var seed: f32 = asset_value(read parameters, 4u32);
    if count != count as u32 as f32 || seed != seed as u32 as f32 {
        return error("station-count and pipe-seed must be integers");
    }
    if radius * cosf(PI / 48f32) - core < 2f32 {
        return error("shaft needs at least 2 m between the spindle and wall");
    }
    if shaft_spoke_coating_span(radius, core) < 0.5f32 {
        return error("shaft collars need at least 0.5 m of exposed pipe between them");
    }
    var spacing: f32 = height / (count + 1f32);
    if spacing < shaft_spoke_minimum_gap(core) {
        return error("shaft stations need more axial space for thick pipes and service runs");
    }
    var layout: ShaftSpokeLayout = make ShaftSpokeLayout {
        radius: radius,
        core: core,
        height: height,
        stations: count as u32,
        seed: seed as u32,
        random: pattern == 1f32
    };
    return shaft_room_shell(mut asset, radius, core, height, count as u32) && shaft_spokes(
        mut asset,
        layout
    ) && shaft_spoke_service_pipes(mut asset, layout) && room_asset_finish(mut asset);
}
fn prefab_shaft_pipes_material_count() -> u32 {
    return shaft_material_count();
}
fn prefab_shaft_pipes_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    if region == 0u32 || region == 2u32 {
        var surface: PanelMaterial = shaft_track_material(region, read parameters);
        surface.band_width = 0f32;
        surface.panel_height = surface.tile_height;
        if region == 2u32 {
            surface.finish = METAL_PLAIN;
        }
        return surface;
    }
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 3u32 {
        material.colour = 0x3850c2u32;
        material.accent = 0x6b747cu32;
        material.finish = METAL_PIPE_COATED;
        material.tile_metres = shaft_spoke_coating_span(
            asset_value(read parameters, 1u32) * 0.5f32,
            asset_value(read parameters, 2u32) * 0.5f32
        );
        material.panel_height = shaft_spoke_face_width(
            asset_value(read parameters, 2u32) * 0.5f32 * SHAFT_SPOKE_RADIUS_RATIO
        );
        material.tile_height = material.panel_height * 8f32;
    }
    return material;
}
