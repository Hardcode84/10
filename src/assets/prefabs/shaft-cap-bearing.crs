fn prefab_shaft_cap_bearing_parameter_count() -> u32 {
    return 3u32;
}
fn prefab_shaft_cap_bearing_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("depth");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_cap_bearing_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 4f32,
            maximum: 10f32,
            initial: 5f32,
            step: 0.5f32
        };
    }
    return shaft_parameter(index);
}
fn prefab_shaft_cap_bearing_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_cap_bearing_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_cap_bearing_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var depth: f32 = asset_value(read parameters, 0u32);
    var radius: f32 = asset_value(read parameters, 1u32) * 0.5f32;
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    if core * 1.8f32 + 1f32 >= radius * 0.7f32 {
        return error("bearing housing needs clearance inside the dished shaft end");
    }
    if !bearing_cap_shell(mut asset, radius, depth) || !shaft_core(
        mut asset,
        core,
        depth,
        2f32
    ) || !bearing_cap_structure(mut asset, radius, core, depth) {
        return false;
    }
    var eye: Vec3 = vec((radius + core) * 0.5f32, 0.6f32, 0f32);
    var forward: Vec3 = unit_vector(sub(vec(0f32, depth * 0.8f32, 0f32), eye));
    var right: Vec3 = unit_vector(cross(forward, vec(0f32, 0f32, -1f32)));
    asset.spawn = make AssetSpawn {
        position: eye,
        basis: make Basis {
            right: right,
            up: cross(forward, right),
            forward: forward
        }
    };
    return room_asset_finish(mut asset);
}
fn prefab_shaft_cap_bearing_material_count() -> u32 {
    return 7u32;
}
fn prefab_shaft_cap_bearing_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 2u32 {
        material.tile_metres = asset_value(read parameters, 2u32) * sinf(3.14159265359f32 / 48f32);
        material.tile_height = 2f32;
    }
    if region == 3u32 {
        material.colour = 0x4d6571u32;
        material.finish = METAL_PLAIN;
    }
    if region == 4u32 {
        material = hex_tunnel_material();
        material.colour = 0x494e46u32;
        material.finish = METAL_PLAIN;
    }
    if region == 5u32 {
        material = hex_tunnel_material();
        material.colour = 0x252b29u32;
        material.finish = METAL_RIBBED;
        material.pitch = 0.25f32;
    }
    if region == 6u32 {
        material = hex_tunnel_material();
        material.finish = METAL_FULLBRIGHT;
        material.emission = 0x2569a6u32;
    }
    return material;
}
