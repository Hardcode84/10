fn prefab_shaft_cap_outlet_parameter_count() -> u32 {
    return 3u32;
}
fn prefab_shaft_cap_outlet_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("depth");
    }
    return shaft_parameter_name(index);
}
fn prefab_shaft_cap_outlet_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 8f32,
            maximum: 20f32,
            initial: 8f32,
            step: 1f32
        };
    }
    return shaft_parameter(index);
}
fn prefab_shaft_cap_outlet_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < prefab_shaft_cap_outlet_parameter_count() {
        if !asset_parameter_valid(
            prefab_shaft_cap_outlet_parameter(i),
            asset_value(read parameters, i)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var layout: OutletCapLayout = outlet_cap_layout(read parameters);
    if !outlet_cap_shell(mut asset, layout) || !shaft_core(
        mut asset,
        layout.core,
        layout.depth,
        2f32
    ) || !outlet_cap_bearing(mut asset, layout) || !outlet_cap_pipes(mut asset, layout) {
        return false;
    }
    var eye: Vec3 = vec((layout.radius + layout.core) * 0.5f32, 0.6f32, 0f32);
    var forward: Vec3 = unit_vector(
        sub(vec(layout.offset * 0.7f32, layout.depth, 0f32), eye)
    );
    var right: Vec3 = unit_vector(cross(forward, vec(0f32, 0f32, -1f32)));
    asset.spawn = make AssetSpawn {
        position: eye,
        basis: make Basis {
            right: right,
            up: cross(forward, right),
            forward: forward
        }
    };
    return room_asset_finish(mut asset);
}
fn prefab_shaft_cap_outlet_material_count() -> u32 {
    return 9u32;
}
fn prefab_shaft_cap_outlet_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    var material: PanelMaterial = shaft_surface_material(region);
    if region == 0u32 {
        material.colour = 0x72776bu32;
        material.finish = METAL_PLAIN;
    }
    if region == 2u32 {
        material.tile_metres = asset_value(read parameters, 2u32) * sinf(PI / 48f32);
        material.tile_height = 2f32;
    }
    if region == 3u32 {
        material.colour = 0x7c8078u32;
        material.finish = METAL_PLAIN;
    }
    if region == 5u32 {
        material = hex_tunnel_material();
        material.colour = 0x444d46u32;
        material.finish = METAL_PLAIN;
    }
    if region == 6u32 {
        material = hex_tunnel_material();
        material.finish = METAL_FULLBRIGHT;
        material.emission = 0x86bb86u32;
    }
    if region == 7u32 {
        material = hex_tunnel_material();
        material.colour = 0x141817u32;
        material.finish = METAL_PLAIN;
    }
    if region == 8u32 {
        material = hex_bulkhead_material();
    }
    return material;
}
