const SHAFT_SPOKE_RADIUS_RATIO: f32 = 0.8f32;
const SHAFT_SPOKE_COLLAR_RATIO: f32 = 1.15f32;
fn shaft_spoke_basis(angle: f32) -> Basis {
    var radial: Vec3 = shaft_pipe_normal(angle);
    var right: Vec3 = vec(0f32, 1f32, 0f32);
    return make Basis {
        right: right,
        up: radial,
        forward: cross(right, radial)
    };
}
fn shaft_spoke_instance(
    asset: mut RoomAsset,
    first: u32,
    count: u32,
    origin: Vec3,
    basis: Basis
) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            name: asset_name("spoke"),
            first: first,
            count: count,
            origin: origin,
            basis: basis
        }
    );
}
fn shaft_spoke_collars(
    asset: mut RoomAsset,
    first: u32,
    count: u32,
    radius: f32,
    core: f32,
    height: f32,
    basis: Basis
) -> bool {
    var side: u32 = 0u32;
    while side < 4u32 {
        var distance: f32 = core * cosf(3.14159265359f32 / 48f32);
        if side >= 2u32 {
            distance = radius * cosf(3.14159265359f32 / 48f32);
        }
        if side % 2u32 == 0u32 {
            distance = -distance;
        }
        var origin: Vec3 = add(vec(0f32, height, 0f32), scale(basis.up, distance));
        if !shaft_spoke_instance(mut asset, first, count, origin, basis) {
            return false;
        }
        side = side + 1u32;
    }
    return true;
}
fn shaft_spokes(
    asset: mut RoomAsset,
    radius: f32,
    core: f32,
    height: f32,
    stations: u32,
    seed: u32
) -> bool {
    var pipe_radius: f32 = core * SHAFT_SPOKE_RADIUS_RATIO;
    var extent: f32 = radius + pipe_radius * 0.25f32;
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !solid_cylinder(mut asset.geometry, 8u32, pipe_radius, extent * 2f32, 3u32, 2f32) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var collar: u32 = mesh_triangle_count(read asset.geometry);
    if !bevelled_body(
        mut asset.geometry,
        make BevelledBody {
            sides: 8u32,
            radius: pipe_radius * SHAFT_SPOKE_COLLAR_RATIO,
            length: pipe_radius * 0.4f32,
            bevel: pipe_radius * 0.05f32,
            shell: 5u32,
            rear: 5u32,
            front: 5u32
        },
        vec(0f32, 0f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    var collar_count: u32 = mesh_triangle_count(read asset.geometry) - collar;
    var station: u32 = 0u32;
    while station < stations {
        var angle: f32 = (seed % 12u32) as f32 * 0.1308996939f32 + (station % 2u32) as f32 * 1.57079632679f32;
        var basis: Basis = shaft_spoke_basis(angle);
        var y: f32 = height * (station + 1u32) as f32 / (stations + 1u32) as f32;
        var origin: Vec3 = sub(vec(0f32, y, 0f32), scale(basis.up, extent));
        if !shaft_spoke_instance(mut asset, first, count, origin, basis) || !shaft_spoke_collars(
            mut asset,
            collar,
            collar_count,
            radius,
            core,
            y,
            basis
        ) {
            return false;
        }
        station = station + 1u32;
    }
    return true;
}
