const SHAFT_SPOKE_PANEL_LENGTH: f32 = 3f32;
const SHAFT_SPOKE_RADIUS_RATIO: f32 = 0.8f32;
const SHAFT_SPOKE_COLLAR_RATIO: f32 = 1.15f32;
record ShaftSpokeLayout {
    radius: f32;
    core: f32;
    height: f32;
    stations: u32;
    seed: u32;
    random: bool;
}
fn shaft_spoke_clearance(core: f32) -> f32 {
    return core * SHAFT_SPOKE_RADIUS_RATIO * SHAFT_SPOKE_COLLAR_RATIO + 0.4f32;
}
fn shaft_spoke_minimum_gap(core: f32) -> f32 {
    return 2f32 * shaft_spoke_clearance(core) + 1.5f32;
}
fn shaft_spoke_height(layout: ShaftSpokeLayout, station: u32) -> f32 {
    var spacing: f32 = layout.height / (layout.stations + 1u32) as f32;
    var height: f32 = spacing * (station + 1u32) as f32;
    if layout.random {
        var offset: f32 = (metal_hash(station, 17u32, layout.seed) % 65536u32) as f32 / 65535f32 - 0.5f32;
        height = height + offset * (spacing - shaft_spoke_minimum_gap(layout.core));
    }
    return height;
}
fn shaft_spoke_angle(layout: ShaftSpokeLayout, station: u32) -> f32 {
    if layout.random {
        return (metal_hash(station, 31u32, layout.seed) % 48u32) as f32 * 0.1308996939f32;
    }
    return (layout.seed % 12u32) as f32 * 0.1308996939f32 + (station % 2u32) as f32 * 1.57079632679f32;
}
fn shaft_spoke_basis(angle: f32) -> Basis {
    var radial: Vec3 = shaft_pipe_normal(angle);
    var right: Vec3 = vec(0f32, 1f32, 0f32);
    return make Basis {
        right: right,
        up: radial,
        forward: cross(right, radial)
    };
}
fn shaft_spoke_instance(
    asset: mut RoomAsset,
    first: u32,
    count: u32,
    origin: Vec3,
    basis: Basis
) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            name: asset_name("spoke"),
            first: first,
            count: count,
            origin: origin,
            basis: basis
        }
    );
}
fn shaft_spoke_collars(
    asset: mut RoomAsset,
    first: u32,
    count: u32,
    core_first: u32,
    radius: f32,
    core: f32,
    height: f32,
    basis: Basis,
    one_sided: bool
) -> bool {
    var side: u32 = 0u32;
    var step: u32 = 1u32;
    if one_sided {
        side = 1u32;
        step = 2u32;
    }
    while side < 4u32 {
        var distance: f32 = core * cosf(3.14159265359f32 / 48f32);
        if side >= 2u32 {
            distance = radius * cosf(3.14159265359f32 / 48f32);
        }
        var collar_first: u32 = core_first;
        if side >= 2u32 {
            collar_first = first;
        }
        var placement: Basis = basis;
        if side % 2u32 == 0u32 {
            distance = -distance;
            placement.up = scale(placement.up, -1f32);
            placement.forward = scale(placement.forward, -1f32);
        }
        var origin: Vec3 = add(vec(0f32, height, 0f32), scale(basis.up, distance));
        if !shaft_spoke_instance(mut asset, collar_first, count, origin, placement) {
            return false;
        }
        side = side + step;
    }
    return true;
}
fn shaft_spokes(asset: mut RoomAsset, layout: ShaftSpokeLayout) -> bool {
    var pipe_radius: f32 = layout.core * SHAFT_SPOKE_RADIUS_RATIO;
    var extent: f32 = layout.radius + pipe_radius * 0.25f32;
    var pipe_length: f32 = extent * 2f32;
    if layout.random {
        pipe_length = extent;
    }
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !shaft_spoke_pipe_mesh(mut asset.geometry, pipe_radius, pipe_length) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var collar: u32 = mesh_triangle_count(read asset.geometry);
    if !shaft_spoke_collar_mesh(mut asset.geometry, pipe_radius, 0f32) {
        return false;
    }
    var collar_count: u32 = mesh_triangle_count(read asset.geometry) - collar;
    var core_collar: u32 = mesh_triangle_count(read asset.geometry);
    var collar_radius: f32 = pipe_radius * SHAFT_SPOKE_COLLAR_RATIO;
    var apothem: f32 = layout.core * cosf(3.14159265359f32 / 48f32);
    var inset: f32 = apothem - sqrtf(apothem * apothem - collar_radius * collar_radius);
    if !shaft_spoke_collar_mesh(mut asset.geometry, pipe_radius, inset) {
        return false;
    }
    var station: u32 = 0u32;
    while station < layout.stations {
        var basis: Basis = shaft_spoke_basis(shaft_spoke_angle(layout, station));
        var y: f32 = shaft_spoke_height(layout, station);
        var origin: Vec3 = vec(0f32, y, 0f32);
        if !layout.random {
            origin = sub(origin, scale(basis.up, extent));
        }
        if !shaft_spoke_instance(mut asset, first, count, origin, basis) || !shaft_spoke_collars(
            mut asset,
            collar,
            collar_count,
            core_collar,
            layout.radius,
            layout.core,
            y,
            basis,
            layout.random
        ) {
            return false;
        }
        station = station + 1u32;
    }
    return true;
}

fn shaft_spoke_service_pipes(asset: mut RoomAsset, layout: ShaftSpokeLayout) -> bool {
    var station: u32 = 1u32;
    while station < layout.stations {
        var bottom: f32 = shaft_spoke_height(layout, station - 1u32);
        var top: f32 = shaft_spoke_height(layout, station);
        var clearance: f32 = -mask_min(
            -shaft_service_clearance(top - bottom),
            -shaft_spoke_clearance(layout.core)
        );
        var bay: ShaftPipeBay = make ShaftPipeBay {
            radius: layout.radius,
            core: layout.core,
            low: bottom + clearance,
            high: top - clearance,
            station: station,
            seed: metal_hash(station, 0u32, layout.seed),
            spindle_feeds: false
        };
        if !shaft_service_bay(mut asset, bay) {
            return false;
        }
        station = station + 1u32;
    }
    return true;
}

// The rear extends inward by inset. The exposed front stays at the same position.
fn shaft_spoke_collar_mesh(mesh: mut Mesh, pipe_radius: f32, inset: f32) -> bool {
    return bevelled_body(
        mut mesh,
        make BevelledBody {
            sides: 8u32,
            radius: pipe_radius * SHAFT_SPOKE_COLLAR_RATIO,
            length: pipe_radius * 0.4f32 + inset,
            bevel: pipe_radius * 0.05f32,
            shell: 5u32,
            rear: 5u32,
            front: 5u32
        },
        vec(0f32, -inset * 0.5f32, 0f32),
        identity_basis()
    );
}
// Each octagonal face has one panel across its width. Adjacent rows are staggered.
fn shaft_spoke_pipe_mesh(mesh: mut Mesh, radius: f32, extent: f32) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = make RegularProfile {
        sides: 8u32,
        phase: 3.14159265359f32 / 8f32
    };
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, 0f32, radius);
    loft_ring(mut hull, profile, 1u32, extent, radius);
    loft_span(mut hull, profile, 0u32, 3u32);
    loft_caps(mut hull, profile, 2u32, 3u32, 3u32);
    var width: f32 = shaft_spoke_face_width(radius);
    var face: u32 = 0u32;
    while face < 8u32 {
        var polygon: HullFace = asset_face(read hull, face);
        var frame: SurfaceFrame = asset_surface(read hull, face);
        frame.origin = sub(
            hull_corner(read hull, polygon, 0u32),
            scale(frame.right, (face % 2u32) as f32 * SHAFT_SPOKE_PANEL_LENGTH * 0.5f32)
        );
        frame.up = scale(frame.up, SHAFT_SPOKE_PANEL_LENGTH / width);
        asset_surface_set(mut hull, face, frame);
        face = face + 1u32;
    }
    return hull_solid_mesh(
        read hull,
        mut mesh,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        SHAFT_SPOKE_PANEL_LENGTH
    );
}
fn shaft_spoke_face_width(radius: f32) -> f32 {
    return 2f32 * radius * sinf(3.14159265359f32 / 8f32);
}
