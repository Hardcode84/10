fn conduit_rebar_material() -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = METAL_RIBBED;
    material.colour = 0x35496bu32;
    material.accent = 0x5b778du32;
    material.tile_metres = 1f32;
    material.tile_height = 1f32;
    material.texels_per_metre = 32u32;
    material.pitch = 0.2f32;
    material.indicator = false;
    material.marking = 0u32;
    return material;
}
fn conduit_debris_rebar(
    asset: mut RoomAsset,
    hull: read AssetHull,
    centre: Vec3,
    basis: Basis,
    radius: f32,
    seed: u32,
    angular: f32,
    reach: f32
) -> bool {
    var ends: [Vec3; 4] = make [Vec3; 4] {
        centre,
        centre,
        centre,
        centre
    };
    var i: u32 = 0u32;
    while i < 4u32 {
        var face: HullFace = asset_face(read hull, 2u32 + i / 2u32);
        var frame: SurfaceFrame = asset_surface(read hull, 2u32 + i / 2u32);
        var point: Vec3 = add(
            scale(hull_face_centre(read hull, face), 0.65f32),
            scale(hull_corner(read hull, face, (i % 2u32) * 4u32), 0.35f32)
        );
        var origin: Vec3 = add(
            vec(centre.x, 0f32, centre.z),
            basis_vector(basis, point)
        );
        var normal: Vec3 = basis_vector(basis, frame.normal);
        var right: Vec3 = basis_vector(basis, frame.right);
        var start: Vec3 = sub(origin, scale(normal, radius * 0.018f32));
        var corner: Vec3 = add(origin, scale(normal, radius * 0.09f32));
        var lean: f32 = conduit_debris_random(seed, 21u32 + i) * 2f32 - 1f32;
        var outgoing: Vec3 = unit_vector(add(normal, scale(right, lean)));
        var end: Vec3 = add(corner, scale(outgoing, radius * 0.08f32));
        ends[i as usize] = add(end, vec(0f32, centre.y, 0f32));
        var first: u32 = mesh_triangle_count(read asset.geometry);
        var sweep: TubeSweep = tube_sweep_begin(
            start,
            normal,
            right,
            make TubeStyle {
                radius: radius * 0.012f32,
                sides: 8u32,
                tile_metres: conduit_rebar_material().tile_metres,
                region: CONDUIT_REBAR_MATERIAL
            }
        );
        if !tube_sweep_corner(
            mut asset.geometry,
            mut sweep,
            corner,
            outgoing,
            radius * 0.03f32
        ) || !tube_sweep_finish(mut asset.geometry, mut sweep, end) || !asset_part_place_motion_tail(
            mut asset,
            first,
            asset_name("debris-rebar"),
            vec(0f32, centre.y, 0f32),
            vec(0f32, angular, 0f32)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return conduit_debris_arcs(mut asset, centre, ends, angular, reach, seed);
}
