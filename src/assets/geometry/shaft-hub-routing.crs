fn hub_diagonal_lane(
    asset: read RoomAsset,
    router: mut PipeRouter,
    lanes: read HubLanes,
    port: RoomPort,
    slot: u32,
    layout: HubPipeLayout
) -> bool {
    var cardinal: u32 = hub_pipe_cardinal(port, slot);
    var target: u32 = PIPE_NO_EXIT;
    var normal: Vec3 = vec(0f32, 0f32, 0f32);
    if cardinal != PIPE_NO_EXIT {
        var other: RoomPort = asset_port(read asset.ports, cardinal);
        target = hub_lane_wall(
            read lanes,
            cardinal,
            1u32,
            hub_pipe_slot(other, port) * 2u32
        );
        normal = other.basis.forward;
    } else {
        var signs: Vec3 = hub_pipe_corner_signs(port, slot);
        var axis: u32 = 2u32;
        if absf(port.basis.forward.x) < 0.1f32 {
            axis = 0u32;
        }
        if absf(port.basis.forward.y) < 0.1f32 {
            axis = 1u32;
        }
        target = hub_lane_corner(read lanes, hub_corner_index(signs), axis, false);
        normal = unit_vector(signs);
    }
    var mouth: u32 = hub_lane_mouth(mut router, port, slot);
    var entry: Vec3 = hub_pipe_entry(port, slot, layout);
    var node: u32 = hub_lane_point(mut router, entry);
    var fold: Vec3 = hub_pipe_fold(
        entry,
        port.basis.forward,
        route_nodes_get(read router, target).position,
        normal
    );
    return pipe_route_link(mut router, mouth, node) && pipe_route_via(
        mut router,
        node,
        target,
        fold
    );
}
fn hub_lane_graph(
    asset: read RoomAsset,
    router: mut PipeRouter,
    lanes: mut HubLanes,
    layout: HubPipeLayout
) -> bool {
    var face: u32 = 0u32;
    while face < 6u32 {
        if face != 2u32 && !hub_wall_lanes(
            mut router,
            mut lanes,
            asset_port(read asset.ports, face),
            layout
        ) {
            return false;
        }
        face = face + 1u32;
    }
    var corner: u32 = 0u32;
    while corner < 8u32 {
        if !hub_corner_lanes(mut router, mut lanes, corner, layout) {
            return false;
        }
        var axis: u32 = 0u32;
        while axis < 3u32 {
            if !hub_corner_bridge(read asset, mut router, read lanes, corner, axis, layout) {
                return false;
            }
            axis = axis + 1u32;
        }
        corner = corner + 1u32;
    }
    face = 6u32;
    while face < 18u32 {
        var port: RoomPort = asset_port(read asset.ports, face);
        var slot: u32 = 0u32;
        while slot < 4u32 {
            if hub_pipe_cardinal(port, slot) != 2u32 && !hub_diagonal_lane(
                read asset,
                mut router,
                read lanes,
                port,
                slot,
                layout
            ) {
                return false;
            }
            slot = slot + 1u32;
        }
        face = face + 1u32;
    }
    return true;
}
fn hub_service_pipes(asset: mut RoomAsset, layout: HubPipeLayout) -> bool {
    var router: PipeRouter = pipe_router_new(-1f32);
    var wall: [u32; 8] = make [u32; 8] {
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    };
    var corner: [u32; 6] = make [u32; 6] {
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    };
    var lanes: HubLanes = make HubLanes {
        walls: make [[u32; 8]; 12] {
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall,
            wall
        },
        corners: make [[u32; 6]; 8] {
            corner,
            corner,
            corner,
            corner,
            corner,
            corner,
            corner,
            corner
        }
    };
    var graph: PipeGraph = pipe_graph_new();
    if !hub_lane_graph(read asset, mut router, mut lanes, layout) || !pipe_route_solve(
        mut router,
        mut graph,
        layout.bend,
        oct_pipe_radius(),
        layout.seed
    ) {
        return false;
    }

    if !hub_fixed_feeds(read asset.ports, mut router, mut graph, layout) {
        return false;
    }
    if!(
        hub_pipe_spindle(mut asset, layout) && hub_structure(mut asset, layout) && pipe_graph_mesh(
            mut asset,
            read graph,
            make TubeStyle {
                radius: oct_pipe_radius(),
                sides: 8u32,
                tile_metres: 2f32,
                region: 6u32
            },
            layout.bend
        )
    ) {
        return false;
    }
    if !hub_spindle_mounts(mut asset, read graph, layout) {
        return false;
    }
    pipe_route_guides(mut router);
    pipe_router_swap(mut asset.routes, mut router);
    return true;
}
fn hub_spindle_mounts(asset: mut RoomAsset, graph: read PipeGraph, layout: HubPipeLayout) -> bool {
    var i: u32 = 0u32;
    while i < pipe_node_count(read graph) {
        var node: PipeNode = pipe_node(read graph, i);
        if node.degree == 1u32 && node.exit_id == PIPE_NO_EXIT {
            var normal: Vec3 = unit_vector(
                vec(node.position.x, 0f32, node.position.z)
            );
            var mount: CylinderMount = make CylinderMount {
                centre: add(
                    scale(normal, layout.core * cosf(0.06544984695f32)),
                    vec(0f32, node.position.y, 0f32)
                ),
                outward: normal,
                radius: layout.core,
                inner: false,
                scale: oct_pipe_radius() / 0.18f32,
                lower: -layout.extent,
                upper: 0f32,
                flange_region: 9u32,
                leak_region: 10u32
            };
            if !cylinder_pipe_mount(mut asset, mount) {
                return false;
            }
        }
        i = i + 1u32;
    }
    return true;
}
fn hub_lane_sink(router: mut PipeRouter, point: Vec3) -> u32 {
    var sink: u32 = pipe_route_point(
        mut router,
        point,
        vec(0f32, 1f32, 0f32),
        PIPE_NO_EXIT
    );
    if sink == PIPE_NO_EXIT {
        return sink;
    }
    var node: RouteNode = route_nodes_get(read router, sink);
    node.sink = true;
    route_nodes_set(mut router, sink, node);
    return sink;
}
fn hub_lane_spindle(
    router: mut PipeRouter,
    lanes: read HubLanes,
    corner: u32,
    layout: HubPipeLayout
) -> bool {
    var signs: Vec3 = cube_corner_signs(corner);
    var radial: Vec3 = unit_vector(vec(signs.x, 0f32, signs.z));
    var end: Vec3 = add(
        scale(radial, layout.core - oct_pipe_radius() - 0.1f32),
        vec(0f32, -layout.extent + layout.stand_off, 0f32)
    );
    var from: u32 = hub_lane_corner(read lanes, corner, 1u32, true);
    var point: Vec3 = route_nodes_get(read router, from).position;
    var fold: Vec3 = hub_pipe_fold(
        point,
        unit_vector(signs),
        end,
        vec(0f32, -1f32, 0f32)
    );
    var sink: u32 = hub_lane_sink(mut router, end);
    return pipe_route_via(mut router, from, sink, fold);
}
fn hub_lane_feed(
    router: mut PipeRouter,
    graph: mut PipeGraph,
    port: RoomPort,
    slot: u32,
    layout: HubPipeLayout
) -> bool {
    var radial: Vec3 = unit_vector(vec(port.position.x, 0f32, port.position.z));
    var end: Vec3 = add(
        scale(radial, layout.core - oct_pipe_radius() - 0.1f32),
        vec(0f32, -layout.extent + layout.stand_off, 0f32)
    );
    var entry: Vec3 = hub_pipe_entry(port, slot, layout);
    var fold: Vec3 = hub_pipe_fold(
        entry,
        port.basis.forward,
        end,
        vec(0f32, -1f32, 0f32)
    );
    var mouth: u32 = hub_lane_mouth(mut router, port, slot);
    var start: u32 = hub_lane_point(mut router, entry);
    var turn: u32 = hub_lane_point(mut router, fold);
    var sink: u32 = hub_lane_sink(mut router, end);
    if !pipe_route_link(mut router, mouth, start) || !pipe_route_link(mut router, start, turn) || !pipe_route_link(
        mut router,
        turn,
        sink
    ) {
        return false;
    }
    var first: u32 = route_indices_count(read router);
    if route_indices_append(mut router, mouth) == PIPE_NO_EXIT || route_indices_append(
        mut router,
        start
    ) == PIPE_NO_EXIT || route_indices_append(mut router, turn) == PIPE_NO_EXIT || route_indices_append(
        mut router,
        sink
    ) == PIPE_NO_EXIT {
        return false;
    }
    var path: RoutePath = make RoutePath {
        first: first,
        count: 4u32,
        segment_first: 0u32,
        segment_count: 0u32,
        source: mouth,
        target: sink,
        priority: 0u32,
        head: PIPE_NO_EXIT,
        blocked: 0u32,
        selected: true,
        low: end,
        high: end,
        length: 0f32,
        sink: true
    };
    return route_paths_append(mut router, path) != PIPE_NO_EXIT && route_copy_path(
        read router,
        mut graph,
        path
    );
}
fn hub_fixed_feeds(
    ports: read AssetPorts,
    router: mut PipeRouter,
    graph: mut PipeGraph,
    layout: HubPipeLayout
) -> bool {
    var face: u32 = 6u32;
    while face < 18u32 {
        var port: RoomPort = asset_port(read ports, face);
        var slot: u32 = 0u32;
        while slot < 4u32 {
            if hub_pipe_cardinal(port, slot) == 2u32 && !hub_lane_feed(
                mut router,
                mut graph,
                port,
                slot,
                layout
            ) {
                return false;
            }
            slot = slot + 1u32;
        }
        face = face + 1u32;
    }
    return true;
}
