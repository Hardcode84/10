// Builds a straight HEX-6M passage along local +Y. Length is at least 0.75 m.
// End ports remain closed until assembly. The spawn has sphere clearance.
fn hex_tunnel_build(length_metres: f32, asset: mut RoomAsset) -> bool {
    return hex_passage_build(length_metres, true, mut asset);
}
// A blind passage has one entry and a solid far cap in material region 1.
fn hex_passage_build(length_metres: f32, through: bool, asset: mut RoomAsset) -> bool {
    return hex_passage_profile(length_metres, through, service_hex_profile(), mut asset);
}
fn hex_passage_profile(
    length_metres: f32,
    through: bool,
    profile: ConnectionProfile,
    asset: mut RoomAsset
) -> bool {
    if !loft_allocate(mut asset.hull, profile.shape, 2u32) {
        return false;
    }
    loft_ring(mut asset.hull, profile.shape, 0u32, 0f32, profile.radius);
    loft_ring(mut asset.hull, profile.shape, 1u32, length_metres, profile.radius);
    loft_span(mut asset.hull, profile.shape, 0u32, 0u32);
    loft_caps(mut asset.hull, profile.shape, 2u32, 0u32, 0u32);
    if !through {
        var cap: HullFace = asset_face(read asset.hull, profile.shape.sides + 1u32);
        cap.region = 1u32;
        asset_face_set(mut asset.hull, profile.shape.sides + 1u32, cap);
    }
    hex_tunnel_surfaces(mut asset.hull, profile.shape.sides, length_metres);
    var entry: RoomPort = make RoomPort {
        id: asset_name("ENTRY"),
        profile: profile,
        face: profile.shape.sides,
        position: vec(0f32, 0f32, 0f32),
        basis: make Basis {
            right: vec(1f32, 0f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(0f32, -1f32, 0f32)
        }
    };
    var far: RoomPort = entry;
    far.id = asset_name("EXIT");
    far.face = far.face + 1u32;
    far.position.y = length_metres;
    far.basis.right.x = -1f32;
    far.basis.forward.y = 1f32;
    if !asset_port_append(mut asset.ports, entry) {
        return false;
    }
    if through && !asset_port_append(mut asset.ports, far) {
        return false;
    }
    asset.spawn = make AssetSpawn {
        position: vec(0f32, length_metres * 0.5f32, 0f32),
        basis: far.basis
    };
    return room_asset_finish(mut asset);
}
// Both passage ends lie on plate seams. Axial plates are at most one metre long.
fn hex_tunnel_surfaces(hull: mut AssetHull, sides: u32, length_metres: f32) -> unit {
    var material: PanelMaterial = hex_tunnel_material();
    var plates: u32 = length_metres as u32;
    if plates as f32 < length_metres {
        plates = plates + 1u32;
    }
    var i: u32 = 0u32;
    while i < sides {
        var frame: SurfaceFrame = asset_surface(read hull, i);
        frame.origin = sub(
            frame.origin,
            add(
                scale(frame.right, length_metres * 0.5f32),
                scale(frame.up, material.panel_height * 0.5f32)
            )
        );
        frame.right = scale(
            frame.right,
            material.tile_metres * plates as f32 / length_metres
        );
        asset_surface_set(mut hull, i, frame);
        i = i + 1u32;
    }
}
