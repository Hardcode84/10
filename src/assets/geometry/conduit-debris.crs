const CONDUIT_HAZARD_LENGTH: f32 = 250f32;
const CONDUIT_HAZARD_SECTIONS: u32 = 4u32;
const CONDUIT_HAZARD_PARAMETER: u32 = 7u32;
const CONDUIT_DEBRIS_SLOTS: u32 = 3u32;
fn conduit_hazard_seed_parameter() -> u32 {
    return CONDUIT_HAZARD_PARAMETER + CONDUIT_HAZARD_SECTIONS;
}
fn conduit_hazard_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("hazard-1");
    }
    if index == 1u32 {
        return asset_name("hazard-2");
    }
    if index == 2u32 {
        return asset_name("hazard-3");
    }
    if index == 3u32 {
        return asset_name("hazard-4");
    }
    return asset_name("hazard-seed");
}
fn conduit_hazard_parameter(index: u32) -> AssetParameter {
    var maximum: f32 = 1f32;
    if index == CONDUIT_HAZARD_SECTIONS {
        maximum = 65535f32;
    }
    return make AssetParameter {
        minimum: 0f32,
        maximum: maximum,
        initial: 1f32,
        step: 1f32
    };
}
fn conduit_debris_random(seed: u32, index: u32) -> f32 {
    return (metal_hash(seed, index, 217u32) & 65535u32) as f32 / 65535f32;
}
// Keeps the largest interval outside a closed exclusion band.
fn conduit_debris_interval(low: f32, high: f32, centre: f32, extent: f32) -> [f32; 2] {
    if extent == 0f32 || high <= centre - extent || low >= centre + extent {
        return make [f32; 2] {
            low,
            high
        };
    }
    var left: f32 = mask_min(high, centre - extent);
    var right: f32 = -mask_min(-low, -(centre + extent));
    if left - low > high - right {
        return make [f32; 2] {
            low,
            -mask_min(-low, -left)
        };
    }
    return make [f32; 2] {
        mask_min(high, right),
        high
    };
}
// A closed concrete fragment within the given radius around centre.
fn conduit_debris_chunk(
    asset: mut RoomAsset,
    centre: Vec3,
    radius: f32,
    seed: u32,
    angular: f32,
    reach: f32
) -> bool {
    var hull: AssetHull = asset_hull_new();
    if !truncated_cube_hull(mut hull, 1f32, CONDUIT_DEBRIS_MATERIAL, CONDUIT_FRACTURE_MATERIAL) {
        return false;
    }
    var bound: f32 = 0f32;
    var i: u32 = 0u32;
    while i < asset_vertex_count(read hull) {
        var p: Vec3 = cube_corner_signs(i / 3u32);
        var cut: f32 = 0.15f32 + 0.5f32 * conduit_debris_random(seed, i / 3u32);
        if i % 3u32 == 0u32 {
            p.x = p.x * cut;
        }
        if i % 3u32 == 1u32 {
            p.y = p.y * cut;
        }
        if i % 3u32 == 2u32 {
            p.z = p.z * cut;
        }
        p = vec(p.x + p.y * 0.25f32, p.y * 0.62f32, p.z * 0.3f32);
        bound = -mask_min(-bound, -length(p));
        asset_vertex_set(mut hull, i, p);
        i = i + 1u32;
    }
    i = 0u32;
    while i < asset_vertex_count(read hull) {
        var point: Vec3 = scale(asset_vertex(read hull, i), radius * 0.78f32 / bound);
        asset_vertex_set(mut hull, i, point);
        i = i + 1u32;
    }
    i = 0u32;
    while i < asset_face_count(read hull) {
        var face: HullFace = asset_face(read hull, i);
        if i != 4u32 && i != 5u32 {
            face.region = CONDUIT_FRACTURE_MATERIAL;
            asset_face_set(mut hull, i, face);
        }
        var frame: SurfaceFrame = hull_frame(read hull, face);
        asset_surface_set(mut hull, i, frame);
        i = i + 1u32;
    }
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var basis: Basis = conduit_debris_basis(seed);
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        vec(centre.x, 0f32, centre.z),
        basis,
        conduit_debris_material(false).tile_metres
    ) {
        return false;
    }
    return asset_part_place_motion_tail(
        mut asset,
        first,
        asset_name("conduit-debris"),
        vec(0f32, centre.y, 0f32),
        vec(0f32, angular, 0f32)
    ) && conduit_debris_rebar(
        mut asset,
        read hull,
        centre,
        basis,
        radius,
        seed,
        angular,
        reach
    );
}
fn conduit_debris_section(
    asset: mut RoomAsset,
    values: read AssetValues,
    section: u32,
    entry: f32,
    entry_extent: f32
) -> bool {
    var height: f32 = asset_value(read values, 0u32);
    var core: f32 = asset_value(read values, 2u32) * 0.5f32;
    var wall: f32 = asset_value(read values, 1u32) * 0.5f32 * cosf(3.14159265359f32 / 48f32) - asset_value(
        read values,
        6u32
    );
    var low: f32 = section as f32 * CONDUIT_HAZARD_LENGTH;
    var high: f32 = mask_min(height, low + CONDUIT_HAZARD_LENGTH);
    var span: f32 = (high - low) / CONDUIT_DEBRIS_SLOTS as f32;
    var seed: u32 = metal_hash(
        asset_value(read values, conduit_hazard_seed_parameter()) as u32,
        section,
        17u32
    );
    var slot: u32 = 0u32;
    var count: u32 = 0u32;
    while slot < CONDUIT_DEBRIS_SLOTS {
        var interval: [f32; 2] = conduit_debris_interval(
            low + slot as f32 * span,
            low + (slot + 1u32) as f32 * span,
            height * 0.5f32,
            conduit_support_axial_extent(core)
        );
        interval = conduit_debris_interval(
            interval[0usize],
            interval[1usize],
            entry,
            entry_extent
        );
        var radius: f32 = mask_min(
            (wall - core) * 0.32f32,
            (interval[1usize] - interval[0usize]) * 0.35f32
        );
        if radius > 0f32 {
            var hash: u32 = metal_hash(seed, slot, 31u32);
            var angle: f32 = (
                conduit_debris_random(seed, 1u32) + slot as f32 * 0.381966f32 + conduit_debris_random(
                    hash,
                    2u32
                ) * 0.07f32
            ) * 6.28318530718f32;
            var orbit: f32 = core + radius + (wall - core - 2f32 * radius) * (
                0.2f32 + 0.6f32 * conduit_debris_random(hash, 3u32)
            );
            var centre: Vec3 = vec(
                cosf(angle) * orbit,
                (interval[0usize] + interval[1usize]) * 0.5f32,
                sinf(angle) * orbit
            );
            if !conduit_debris_variant(
                mut asset,
                read values,
                centre,
                radius,
                hash,
                slot + seed % CONDUIT_DEBRIS_SLOTS
            ) {
                return false;
            }
            count = count + 1u32;
        }
        slot = slot + 1u32;
    }
    return count != 0u32 || error(
        "conduit debris section has no space outside entry and supports"
    );
}
fn conduit_hazards(
    asset: mut RoomAsset,
    values: read AssetValues,
    entry: f32,
    entry_extent: f32
) -> bool {
    var i: u32 = CONDUIT_HAZARD_PARAMETER;
    while i <= conduit_hazard_seed_parameter() {
        var value: f32 = asset_value(read values, i);
        if value != value as u32 as f32 {
            return error("conduit hazard settings must be integers");
        }
        i = i + 1u32;
    }
    i = 0u32;
    while i < CONDUIT_HAZARD_SECTIONS && i as f32 * CONDUIT_HAZARD_LENGTH < asset_value(
        read values,
        0u32
    ) {
        if asset_value(read values, CONDUIT_HAZARD_PARAMETER + i) == 1f32 && !conduit_debris_section(
            mut asset,
            read values,
            i,
            entry,
            entry_extent
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn conduit_debris_speed(values: read AssetValues) -> f32 {
    if asset_value(read values, conduit_powered_parameter()) == 0f32 {
        return 0f32;
    }
    return 6.28318530718f32 / asset_value(read values, conduit_orbit_parameter());
}

fn conduit_debris_basis(seed: u32) -> Basis {
    return hull_radial_basis(
        vec(
            conduit_debris_random(seed, 11u32) * 2f32 - 1f32,
            0.4f32 + conduit_debris_random(seed, 12u32),
            conduit_debris_random(seed, 13u32) * 2f32 - 1f32
        )
    );
}
