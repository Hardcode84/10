fn conduit_breach_rubble(asset: mut RoomAsset, centre: Vec3, seed: u32) -> bool {
    var side: u32 = 0u32;
    while side < 4u32 {
        var i: u32 = 0u32;
        while i < 8u32 {
            var along: f32 = ((i as f32 + 0.5f32) / 8f32 - 0.5f32) * CONDUIT_BREACH_WIDTH;
            var edge: f32 = CONDUIT_BREACH_WIDTH * 0.5f32;
            var point: Vec3 = vec(-CONDUIT_BREACH_RIM * 1.3f32, along, edge);
            if side == 1u32 {
                point = vec(point.x, along, -edge);
            }
            if side == 2u32 {
                point = vec(point.x, edge, along);
            }
            if side == 3u32 {
                point = vec(point.x, -edge, along);
            }
            var local_seed: u32 = metal_hash(seed, side, i);
            var size: f32 = CONDUIT_BREACH_RIM * (
                0.8f32 + conduit_debris_random(local_seed, 0u32) * 0.35f32
            );
            if !conduit_debris_chunk(
                mut asset,
                add(centre, point),
                size,
                local_seed,
                0f32,
                0f32
            ) {
                return false;
            }
            i = i + 1u32;
        }
        side = side + 1u32;
    }
    return true;
}
fn conduit_breach_edge(seed: u32, index: u32, inner: bool) -> Vec3 {
    var angle: f32 = (index % 32u32) as f32 * (2f32 * PI) / 32f32;
    var u: f32 = cosf(angle);
    var v: f32 = sinf(angle);
    var maximum: f32 = -mask_min(-absf(u), -absf(v));
    var half: f32 = CONDUIT_BREACH_WIDTH * 0.5f32 + CONDUIT_BREACH_RIM * (
        0.5f32 + 0.5f32 * conduit_debris_random(seed, index % 32u32 + 80u32)
    );
    if inner {
        var phase: f32 = conduit_debris_random(seed, 119u32) * (2f32 * PI);
        var tear: f32 = 0.9f32 + 0.06f32 * sinf(angle * 3f32 + phase) + 0.04f32 * cosf(
            angle * 5f32 - phase
        ) - 0.05f32 * conduit_debris_random(seed, index % 32u32);
        var radius: f32 = CONDUIT_BREACH_WIDTH * 0.5f32 * tear;
        return vec(u * radius, 0f32, v * radius * 0.94f32);
    }
    return vec(u * half / maximum, 0f32, v * half / maximum);
}
fn conduit_breach_rim_piece(asset: mut RoomAsset, centre: Vec3, seed: u32, index: u32) -> bool {
    var profile: RegularProfile = make RegularProfile {
        sides: 4u32,
        phase: 0f32
    };
    var hull: AssetHull = asset_hull_new();
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    var corners: [Vec3; 4] = make [Vec3; 4] {
        conduit_breach_edge(seed, index, false),
        conduit_breach_edge(seed, index + 1u32, false),
        conduit_breach_edge(seed, index + 1u32, true),
        conduit_breach_edge(seed, index, true)
    };
    var depth: f32 = CONDUIT_BREACH_RIM * (
        0.8f32 + 0.6f32 * conduit_debris_random(seed, index + 40u32)
    );
    var i: u32 = 0u32;
    while i < 8u32 {
        var p: Vec3 = corners[(i % 4u32) as usize];
        p.y = 0.5f32 + (i / 4u32) as f32 * depth;
        asset_vertex_set(mut hull, i, p);
        i = i + 1u32;
    }
    loft_span(mut hull, profile, 0u32, CONDUIT_FRACTURE_MATERIAL);
    loft_caps(mut hull, profile, 2u32, CONDUIT_DEBRIS_MATERIAL, CONDUIT_FRACTURE_MATERIAL);
    var first: u32 = mesh_triangle_count(read asset.geometry);
    return hull_solid_mesh(
        read hull,
        mut asset.geometry,
        centre,
        conduit_shaft_axis(),
        conduit_debris_material(true).tile_metres
    ) && asset_part_place_tail(
        mut asset,
        first,
        asset_name("fractured-rim"),
        vec(0f32, 0f32, 0f32)
    );
}
fn conduit_breach_rim(asset: mut RoomAsset, centre: Vec3, seed: u32) -> bool {
    var i: u32 = 0u32;
    while i < 32u32 {
        if !conduit_breach_rim_piece(mut asset, centre, seed, i) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn conduit_breach_panel_basis(radial: Vec3, tilt: f32, roll: f32) -> Basis {
    var frame: Basis = conduit_catwalk_basis(radial);
    var up: Vec3 = add(scale(frame.up, cosf(tilt)), scale(radial, sinf(tilt)));
    var forward: Vec3 = sub(
        scale(radial, cosf(tilt)),
        scale(frame.up, sinf(tilt))
    );
    return make Basis {
        right: add(scale(frame.right, cosf(roll)), scale(up, sinf(roll))),
        up: sub(scale(up, cosf(roll)), scale(frame.right, sinf(roll))),
        forward: forward
    };
}
fn conduit_breach_panel(
    asset: mut RoomAsset,
    origin: Vec3,
    dimensions: Vec3,
    basis: Basis,
    tile: f32,
    bay: f32
) -> bool {
    var hull: AssetHull = asset_hull_new();
    if !solid_box_hull(mut hull, dimensions, 0u32) {
        return false;
    }
    var side: u32 = 0u32;
    while side < asset_face_count(read hull) {
        conduit_tile_surface(mut hull, side, tile, bay);
        side = side + 1u32;
    }
    var first: u32 = mesh_triangle_count(read asset.geometry);
    return hull_solid_mesh(read hull, mut asset.geometry, origin, basis, tile) && asset_part_place_tail(
        mut asset,
        first,
        asset_name("breach-panel"),
        vec(0f32, 0f32, 0f32)
    );
}
record BreachPanelSpan {
    z: f32;
    y: f32;
    width: f32;
    height: f32;
}
fn conduit_breach_panel_span(
    z: f32,
    y: f32,
    width: f32,
    height: f32,
    centre: f32,
    seed: u32
) -> BreachPanelSpan {
    var edge: f32 = CONDUIT_BREACH_WIDTH * 0.5f32 - CONDUIT_BREACH_RIM * (
        0.15f32 + 0.3f32 * conduit_debris_random(seed, 0u32)
    );
    var low_z: f32 = z - width * 0.5f32;
    var high_z: f32 = z + width * 0.5f32;
    var low_y: f32 = y - centre - height * 0.5f32;
    var high_y: f32 = y - centre + height * 0.5f32;
    if absf(z) - width * 0.5f32 < edge && absf(y - centre) - height * 0.5f32 < edge {
        if absf(z) > absf(y - centre) {
            if z > 0f32 {
                low_z = -mask_min(-low_z, -edge);
            } else {
                high_z = mask_min(high_z, -edge);
            }
        } else {
            if y > centre {
                low_y = -mask_min(-low_y, -edge);
            } else {
                high_y = mask_min(high_y, -edge);
            }
        }
    }
    return make BreachPanelSpan {
        z: (low_z + high_z) * 0.5f32,
        y: centre + (low_y + high_y) * 0.5f32,
        width: high_z - low_z,
        height: high_y - low_y
    };
}
fn conduit_breach_panel_fit(
    hull: read AssetHull,
    origin: Vec3,
    basis: Basis,
    dimensions: Vec3,
    radial: Vec3
) -> Vec3 {
    var inset: f32 = 0f32;
    var i: u32 = 0u32;
    while i < asset_face_count(read hull) {
        var face: HullFace = asset_face(read hull, i);
        var normal: Vec3 = asset_surface(read hull, i).normal;
        var projection: f32 = dot(normal, radial);
        if projection > 0f32 {
            var extent: f32 = (
                absf(dot(normal, basis.right)) * dimensions.x + absf(dot(normal, basis.up)) * dimensions.y + absf(
                    dot(normal, basis.forward)
                ) * dimensions.z
            ) * 0.5f32;
            var distance: f32 = dot(
                normal,
                sub(origin, hull_corner(read hull, face, 0u32))
            ) + extent + dimensions.z * 0.1f32;
            inset = -mask_min(-inset, -distance / projection);
        }
        i = i + 1u32;
    }
    return sub(origin, scale(radial, inset));
}
fn conduit_breach_panel_cell(
    asset: mut RoomAsset,
    span: BreachPanelSpan,
    radius: f32,
    tile: f32,
    bay: f32,
    height: f32,
    damage: f32,
    seed: u32
) -> bool {
    var radial: Vec3 = vec(
        sqrtf(radius * radius - span.z * span.z) / radius,
        0f32,
        span.z / radius
    );
    var depth: f32 = 2f32 + damage * 3.5f32;
    var inset: f32 = 0.5f32 + damage * (3f32 + 4f32 * conduit_debris_random(seed, 1u32));
    var tilt: f32 = (conduit_debris_random(seed, 2u32) * 2f32 - 1f32) * (
        0.02f32 + damage * 0.22f32
    );
    var roll: f32 = (conduit_debris_random(seed, 3u32) * 2f32 - 1f32) * damage * 0.06f32;
    var origin: Vec3 = add(
        scale(radial, radius - inset - depth * 0.5f32),
        vec(
            0f32,
            span.y + (conduit_debris_random(seed, 4u32) - 0.5f32) * damage * 2f32,
            0f32
        )
    );
    origin.x = origin.x - mask_min(0f32, 1f32 - damage * 2f32) * CONDUIT_BREACH_RIM;
    var basis: Basis = conduit_breach_panel_basis(radial, tilt, roll);
    var dimensions: Vec3 = vec(
        span.width / radial.x * 0.98f32,
        span.height * 0.96f32,
        depth
    );
    var end_clearance: f32 = (
        absf(basis.right.y) * dimensions.x + absf(basis.up.y) * dimensions.y + absf(
            basis.forward.y
        ) * dimensions.z
    ) * 0.5f32 + bay * 0.02f32;
    origin.y = -mask_min(-end_clearance, -mask_min(origin.y, height - end_clearance));
    origin = conduit_breach_panel_fit(read asset.hull, origin, basis, dimensions, radial);
    return conduit_breach_panel(mut asset, origin, dimensions, basis, tile, bay);
}
fn conduit_breach_panel_row(
    asset: mut RoomAsset,
    values: read AssetValues,
    centre: Vec3,
    side: u32,
    seed: u32
) -> bool {
    var radius: f32 = asset_value(read values, 1u32) * 0.5f32;
    var height: f32 = asset_value(read values, 0u32);
    var rows: u32 = panel_pixel_extent(height / CONDUIT_CAST_LENGTH, 1u32);
    var bay: f32 = height / rows as f32;
    var width: f32 = 2f32 * radius * sinf(PI / 48f32);
    var wall: f32 = radius * cosf(PI / 48f32);
    var radial: Vec3 = conduit_catwalk_point(1f32, 0f32, side as f32 * (2f32 * PI) / 48f32);
    var z: f32 = radial.z * wall;
    var apron: f32 = CONDUIT_BREACH_RIM * 3f32 - mask_min(-width, -bay);
    var reach: f32 = CONDUIT_BREACH_WIDTH * 0.5f32 + apron;
    if radial.x <= 0.25f32 || absf(z) >= reach {
        return true;
    }
    var row: u32 = 0u32;
    while row < rows {
        var y: f32 = (row as f32 + 0.5f32) * bay;
        var dy: f32 = absf(y - centre.y);
        var local_seed: u32 = metal_hash(seed, side, row);
        var span: BreachPanelSpan = conduit_breach_panel_span(
            z,
            y,
            width * radial.x,
            bay,
            centre.y,
            local_seed
        );
        if dy < reach - conduit_debris_random(local_seed, 7u32) * bay * 0.2f32 && span.width > 1f32 && span.height > 1f32 {
            var distance: f32 = -mask_min(-absf(z), -dy) - CONDUIT_BREACH_WIDTH * 0.5f32;
            var damage: f32 = 1f32 - mask_min(1f32, -mask_min(0f32, -distance) / apron);
            if !conduit_breach_panel_cell(
                mut asset,
                span,
                wall,
                width,
                bay,
                height,
                damage,
                local_seed
            ) {
                return false;
            }
        }
        row = row + 1u32;
    }
    return true;
}
fn conduit_breach_panels(
    asset: mut RoomAsset,
    values: read AssetValues,
    centre: Vec3,
    seed: u32
) -> bool {
    var side: u32 = 0u32;
    while side < 48u32 {
        if !conduit_breach_panel_row(mut asset, read values, centre, side, seed) {
            return false;
        }
        side = side + 1u32;
    }
    return true;
}
