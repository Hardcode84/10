fn bearing_cap_shell(asset: mut RoomAsset, radius: f32, depth: f32) -> bool {
    var profile: RegularProfile = shaft_profile(radius * 2f32).shape;
    if !loft_allocate(mut asset.hull, profile, 3u32) {
        return false;
    }
    loft_ring(mut asset.hull, profile, 0u32, 0f32, radius);
    loft_ring(mut asset.hull, profile, 1u32, depth * 0.65f32, radius);
    loft_ring(mut asset.hull, profile, 2u32, depth, radius * 0.7f32);
    loft_span(mut asset.hull, profile, 0u32, 0u32);
    loft_span(mut asset.hull, profile, 1u32, 3u32);
    loft_caps(mut asset.hull, profile, 3u32, 1u32, 3u32);
    return asset_port_append(
        mut asset.ports,
        make RoomPort {
            id: asset_name("SHAFT"),
            profile: shaft_profile(radius * 2f32),
            face: profile.sides * 2u32,
            position: vec(0f32, 0f32, 0f32),
            basis: cube_face_basis(2u32)
        }
    );
}
fn bearing_cap_part(asset: mut RoomAsset, first: u32, name: AssetName, origin: Vec3) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            name: name,
            first: first,
            count: mesh_triangle_count(read asset.geometry) - first,
            origin: origin,
            basis: identity_basis()
        }
    );
}
fn bearing_cap_boss(asset: mut RoomAsset, core: f32, depth: f32) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !bevelled_body(
        mut asset.geometry,
        make BevelledBody {
            sides: 16u32,
            radius: core * 1.8f32,
            length: depth * 0.5f32,
            bevel: 0.15f32,
            shell: 4u32,
            rear: 3u32,
            front: 4u32
        },
        vec(0f32, depth * 0.85f32, 0f32),
        identity_basis()
    ) {
        return false;
    }
    if !bearing_cap_part(
        mut asset,
        first,
        asset_name("bearing-housing"),
        vec(0f32, 0f32, 0f32)
    ) {
        return false;
    }
    first = mesh_triangle_count(read asset.geometry);
    if !annular_band_mesh(
        mut asset.geometry,
        core * 0.98f32,
        core * 1.45f32,
        0.25f32,
        5u32,
        2f32
    ) {
        return false;
    }
    return bearing_cap_part(
        mut asset,
        first,
        asset_name("spindle-seal"),
        vec(0f32, depth * 0.6f32, 0f32)
    );
}
fn bearing_cap_rib(asset: mut RoomAsset, radius: f32, core: f32, depth: f32, index: u32) -> bool {
    var angle: f32 = index as f32 * 0.785398163397f32;
    var basis: Basis = shaft_axis_basis(angle);
    var inner: f32 = core * 1.65f32;
    var span: f32 = radius - inner;
    var centre: Vec3 = add(
        scale(basis.right, (radius + inner) * 0.5f32),
        vec(0f32, depth * 0.8f32, 0f32)
    );
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !solid_box(
        mut asset.geometry,
        vec(span, depth * 0.35f32, 0.28f32),
        4u32,
        centre,
        basis,
        2f32
    ) {
        return false;
    }
    if !bearing_cap_part(
        mut asset,
        first,
        asset_name("radial-rib"),
        vec(0f32, 0f32, 0f32)
    ) {
        return false;
    }
    first = mesh_triangle_count(read asset.geometry);
    var mark: Vec3 = add(
        scale(basis.right, radius * 0.85f32),
        vec(0f32, depth * 0.62f32, 0f32)
    );
    if !solid_box(
        mut asset.geometry,
        vec(0.6f32, 0.08f32, 0.18f32),
        6u32,
        mark,
        basis,
        1f32
    ) {
        return false;
    }
    return bearing_cap_part(
        mut asset,
        first,
        asset_name("rim-marker"),
        vec(0f32, 0f32, 0f32)
    );
}
fn bearing_cap_structure(asset: mut RoomAsset, radius: f32, core: f32, depth: f32) -> bool {
    if !bearing_cap_boss(mut asset, core, depth) {
        return false;
    }
    var i: u32 = 0u32;
    while i < 8u32 {
        if !bearing_cap_rib(mut asset, radius, core, depth, i) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
