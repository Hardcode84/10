fn hub_structure_scale(layout: HubPipeLayout) -> f32 {
    return -mask_min(-0.22f32, -layout.core / layout.half_width);
}
fn hub_structure_end(asset: mut RoomAsset, layout: HubPipeLayout, ratio: f32) -> bool {
    var base: AssetHull = asset_hull_new();
    var hull: AssetHull = asset_hull_new();
    var a: f32 = layout.extent * ratio;
    var b: f32 = layout.half_width * ratio;
    var diagonal: f32 = (a - b) / 1.41421356237f32;
    var depth: f32 = 0.3f32 * diagonal * diagonal / sqrtf(a * a + 2f32 * b * b);
    if !rhombi_hull(mut base, a, b, 8u32, 8u32) || !hull_truncate(
        read base,
        mut hull,
        depth,
        5u32
    ) {
        return false;
    }
    rhombi_inset_corners(mut hull, layout.corner_shift * ratio / 1.73205080757f32);
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        asset.tile_metres
    ) {
        return false;
    }
    return hub_pipe_part(mut asset, first, asset_name("SPINDLE-END"));
}
fn hub_structure_beam(asset: mut RoomAsset, layout: HubPipeLayout, ratio: f32, corner: u32) -> bool {
    var normal: Vec3 = unit_vector(cube_corner_signs(corner));
    var distance: f32 = (layout.extent + 2f32 * layout.half_width - layout.corner_shift) / 1.73205080757f32;
    var start: f32 = distance * ratio;
    var span: f32 = distance - start;
    var radius: f32 = mask_min(
        0.65f32,
        (layout.extent - layout.half_width + layout.corner_shift) / 2.44948974278f32 * ratio * 0.42f32
    );
    var profile: RegularProfile = make RegularProfile {
        sides: 6u32,
        phase: 0f32
    };
    var hull: AssetHull = asset_hull_new();
    if !loft_allocate(mut hull, profile, 6u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, -0.02f32, radius * 1.25f32);
    loft_ring(mut hull, profile, 1u32, 0.12f32, radius * 1.25f32);
    loft_ring(mut hull, profile, 2u32, 0.22f32, radius);
    loft_ring(mut hull, profile, 3u32, span - 0.22f32, radius);
    loft_ring(mut hull, profile, 4u32, span - 0.12f32, radius * 1.25f32);
    loft_ring(mut hull, profile, 5u32, span + 0.02f32, radius * 1.25f32);
    var i: u32 = 0u32;
    while i < 5u32 {
        var region: u32 = 8u32;
        if i == 0u32 || i == 4u32 {
            region = 5u32;
        }
        loft_span(mut hull, profile, i, region);
        i = i + 1u32;
    }
    loft_caps(mut hull, profile, 6u32, 5u32, 5u32);
    var right: Vec3 = unit_vector(cross(normal, vec(0f32, 1f32, 0f32)));
    var basis: Basis = make Basis {
        right: right,
        up: normal,
        forward: cross(right, normal)
    };
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        scale(normal, start),
        basis,
        asset.tile_metres
    ) {
        return false;
    }
    return hub_pipe_part(mut asset, first, asset_name("CORNER-BEAM"));
}
fn hub_structure(asset: mut RoomAsset, layout: HubPipeLayout) -> bool {
    var ratio: f32 = hub_structure_scale(layout);
    if !hub_structure_end(mut asset, layout, ratio) {
        return false;
    }
    var corner: u32 = 0u32;
    while corner < 8u32 {
        if !hub_structure_beam(mut asset, layout, ratio, corner) {
            return false;
        }
        corner = corner + 1u32;
    }
    return true;
}
