fn conduit_beam_shape(radius: f32, core: f32, seed: u32) -> BrokenBox {
    var shape: BrokenBox = conduit_broken_box(
        vec(radius * 0.65f32, conduit_support_depth(core), conduit_support_width(core)),
        seed
    );
    var bound: f32 = length(
        vec(shape.length + shape.tear, shape.depth * 0.5f32, shape.width * 0.5f32)
    );
    var factor: f32 = mask_min(1f32, radius * 0.9f32 / bound);
    shape.length = shape.length * factor;
    shape.depth = shape.depth * factor;
    shape.width = shape.width * factor;
    shape.tear = shape.tear * factor;
    shape.wall = shape.wall * factor;
    shape.recess = shape.recess * factor;
    return shape;
}
fn conduit_beam_debris(
    asset: mut RoomAsset,
    centre: Vec3,
    radius: f32,
    seed: u32,
    angular: f32,
    reach: f32,
    core: f32
) -> bool {
    var shape: BrokenBox = conduit_beam_shape(radius, core, seed);
    var source: Mesh = mesh_new();
    if !broken_box_chunk_mesh(mut source, shape) {
        return false;
    }
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var basis: Basis = conduit_debris_basis(seed);
    var i: u32 = 0u32;
    while i < mesh_triangle_count(read source) {
        var primitive: MeshTriangle = conduit_support_uv(
            mesh_triangle(read source, i),
            vec(shape.length * 2f32, shape.depth, shape.width),
            0f32,
            1f32,
            -shape.length,
            shape.length
        );
        if !mesh_append(
            mut asset.geometry,
            placed_triangle(primitive, vec(centre.x, 0f32, centre.z), basis)
        ) {
            return false;
        }
        i = i + 1u32;
    }
    var ends: [Vec3; 4] = make [Vec3; 4] {
        centre,
        centre,
        centre,
        centre
    };
    i = 0u32;
    while i < 4u32 {
        var end: BrokenBox = shape;
        end.seed = metal_hash(shape.seed, i / 2u32, 47u32);
        var tip: Vec3 = collision_point(broken_box_vertex(end, 1u32, (i % 2u32) * 4u32));
        if i >= 2u32 {
            tip.x = -tip.x;
            tip.z = -tip.z;
        }
        ends[i as usize] = add(centre, basis_vector(basis, tip));
        i = i + 1u32;
    }
    return asset_part_place_motion_tail(
        mut asset,
        first,
        asset_name("beam-debris"),
        vec(0f32, centre.y, 0f32),
        vec(0f32, angular, 0f32)
    ) && conduit_debris_arcs(mut asset, centre, ends, angular, reach, seed);
}
fn conduit_debris_variant(
    asset: mut RoomAsset,
    values: read AssetValues,
    centre: Vec3,
    radius: f32,
    seed: u32,
    selection: u32
) -> bool {
    var style: u32 = asset_value(read values, conduit_debris_style_parameter()) as u32;
    if style == 2u32 || (style == 0u32 && selection % CONDUIT_DEBRIS_SLOTS == 0u32) {
        return conduit_beam_debris(
            mut asset,
            centre,
            radius,
            seed,
            conduit_debris_speed(read values),
            asset_value(read values, 1u32),
            asset_value(read values, 2u32) * 0.5f32
        );
    }
    return conduit_debris_chunk(
        mut asset,
        centre,
        radius,
        seed,
        conduit_debris_speed(read values),
        asset_value(read values, 1u32)
    );
}
