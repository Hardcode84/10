const FAN_TEXTURE_METRES: f32 = 2f32;
// A closed swept blade around the Y axis. Angles are radians; lengths are metres.
record FanBlade {
    inner: f32;
    outer: f32;
    sector: f32;
    depth: f32;
    thickness: f32;
    radial_steps: u32;
    angular_steps: u32;
}
fn fan_blade_width(blade: FanBlade, span: f32) -> f32 {
    return blade.sector * (0.38f32 + 0.12f32 * span);
}
fn fan_blade_panels(blade: FanBlade) -> u32 {
    return panel_pixel_extent((blade.outer - blade.inner) / FAN_TEXTURE_METRES, 1u32);
}
fn fan_blade_vertex(blade: FanBlade, radial: u32, angular: u32, top: bool) -> MeshVertex {
    var t: f32 = radial as f32 / blade.radial_steps as f32;
    var s: f32 = angular as f32 / blade.angular_steps as f32;
    var radius: f32 = blade.inner + (blade.outer - blade.inner) * t;
    var width: f32 = fan_blade_width(blade, t);
    var angle: f32 = blade.sector * 0.22f32 * t * t + (s - 0.5f32) * width;
    var height: f32 = (s - 0.5f32) * blade.depth * (0.65f32 + 0.35f32 * t);
    height = height + (top as u32 as f32 - 0.5f32) * blade.thickness;
    return make MeshVertex {
        x: radius * cosf(angle),
        y: height,
        z: radius * sinf(angle),
        u: t * fan_blade_panels(blade) as f32,
        v: s
    };
}
fn fan_blade_edge(
    mesh: mut Mesh,
    a: MeshVertex,
    b: MeshVertex,
    c: MeshVertex,
    d: MeshVertex,
    along: f32,
    across: f32,
    thickness: f32
) -> bool {
    var aa: MeshVertex = a;
    var bb: MeshVertex = b;
    var cc: MeshVertex = c;
    var dd: MeshVertex = d;
    aa.u = along / FAN_TEXTURE_METRES;
    bb.u = across / FAN_TEXTURE_METRES;
    cc.u = bb.u;
    dd.u = aa.u;
    aa.v = 0f32;
    bb.v = 0f32;
    cc.v = thickness / FAN_TEXTURE_METRES;
    dd.v = cc.v;
    return solid_mesh_quad(mut mesh, aa, bb, cc, dd, 7u32);
}
fn fan_blade_cell(mesh: mut Mesh, blade: FanBlade, r: u32, a: u32) -> bool {
    var p: MeshVertex = fan_blade_vertex(blade, r, a, true);
    var q: MeshVertex = fan_blade_vertex(blade, r, a + 1u32, true);
    var t: MeshVertex = fan_blade_vertex(blade, r + 1u32, a + 1u32, true);
    var s: MeshVertex = fan_blade_vertex(blade, r + 1u32, a, true);
    var pp: MeshVertex = fan_blade_vertex(blade, r, a, false);
    var qq: MeshVertex = fan_blade_vertex(blade, r, a + 1u32, false);
    var tt: MeshVertex = fan_blade_vertex(blade, r + 1u32, a + 1u32, false);
    var ss: MeshVertex = fan_blade_vertex(blade, r + 1u32, a, false);
    if !solid_mesh_quad(mut mesh, p, q, t, s, 3u32) || !solid_mesh_quad(
        mut mesh,
        pp,
        ss,
        tt,
        qq,
        3u32
    ) {
        return false;
    }
    var width: f32 = blade.inner * fan_blade_width(blade, 0f32);
    var end_width: f32 = blade.outer * fan_blade_width(blade, 1f32);
    var span: f32 = blade.outer - blade.inner;
    var lo: f32 = a as f32 / blade.angular_steps as f32;
    var hi: f32 = (a + 1u32) as f32 / blade.angular_steps as f32;
    var start: f32 = r as f32 / blade.radial_steps as f32 * span;
    var end: f32 = (r + 1u32) as f32 / blade.radial_steps as f32 * span;
    if r == 0u32 && !fan_blade_edge(
        mut mesh,
        q,
        p,
        pp,
        qq,
        hi * width,
        lo * width,
        blade.thickness
    ) {
        return false;
    }
    if r + 1u32 == blade.radial_steps && !fan_blade_edge(
        mut mesh,
        s,
        t,
        tt,
        ss,
        lo * end_width,
        hi * end_width,
        blade.thickness
    ) {
        return false;
    }
    if a == 0u32 && !fan_blade_edge(mut mesh, p, s, ss, pp, start, end, blade.thickness) {
        return false;
    }
    if a + 1u32 == blade.angular_steps && !fan_blade_edge(
        mut mesh,
        t,
        q,
        qq,
        tt,
        end,
        start,
        blade.thickness
    ) {
        return false;
    }
    return true;
}
fn fan_blade_mesh(mesh: mut Mesh, blade: FanBlade) -> bool {
    var r: u32 = 0u32;
    while r < blade.radial_steps {
        var a: u32 = 0u32;
        while a < blade.angular_steps {
            if !fan_blade_cell(mut mesh, blade, r, a) {
                return false;
            }
            a = a + 1u32;
        }
        r = r + 1u32;
    }
    return true;
}
