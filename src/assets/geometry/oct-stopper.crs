fn oct_stopper_pipes(asset: mut RoomAsset, depth: f32) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !solid_cylinder(
        mut asset.geometry,
        12u32,
        oct_pipe_radius(),
        depth + 0.05f32,
        2u32,
        depth
    ) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var i: u32 = 0u32;
    while i < 4u32 {
        var angle: f32 = i as f32 * 1.57079632679f32;
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: oct_pipe_name(i),
                first: first,
                count: count,
                origin: vec(
                    oct_pipe_distance() * cosf(angle),
                    0f32,
                    oct_pipe_distance() * sinf(angle)
                ),
                basis: make Basis {
                    right: vec(cosf(angle), 0f32, sinf(angle)),
                    up: vec(0f32, 1f32, 0f32),
                    forward: vec(-sinf(angle), 0f32, cosf(angle))
                }
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
// Four solid plates occupy the fixed triangular regions of the octagonal door.
// Plates are 0.08 m thick and finish at the far end of the sleeve.
fn oct_stopper_plates(asset: mut RoomAsset, depth: f32) -> bool {
    var radius: f32 = service_oct_profile().radius;
    var narrow: f32 = radius * sinf(0.39269908169f32);
    var wide: f32 = radius * cosf(0.39269908169f32);
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !solid_triangular_prism(mut asset.geometry, narrow, narrow, 0.08f32, 1u32, 2f32) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var i: u32 = 0u32;
    while i < 4u32 {
        var angle: f32 = i as f32 * 1.57079632679f32;
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: asset_name("PIPE-PLATE"),
                first: first,
                count: count,
                origin: vec(
                    (wide - narrow) * cosf(angle),
                    depth - 0.08f32,
                    (wide - narrow) * sinf(angle)
                ),
                basis: make Basis {
                    right: vec(cosf(angle), 0f32, sinf(angle)),
                    up: vec(0f32, 1f32, 0f32),
                    forward: vec(-sinf(angle), 0f32, cosf(angle))
                }
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
