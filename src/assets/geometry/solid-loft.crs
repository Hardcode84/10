// Appends an outward-facing solid with shadows. The hull has outward winding.
fn hull_solid_mesh(
    hull: read AssetHull,
    mesh: mut Mesh,
    origin: Vec3,
    basis: Basis,
    tile_metres: f32
) -> bool {
    var i: u32 = 0u32;
    while i < asset_face_count(read hull) {
        var face: HullFace = asset_face(read hull, i);
        var frame: SurfaceFrame = asset_surface(read hull, i);
        var corner: u32 = 1u32;
        while corner + 1u32 < face.count {
            var primitive: MeshTriangle = make MeshTriangle {
                vertices: make [MeshVertex; 3] {
                    surface_vertex(hull_corner(read hull, face, 0u32), frame, tile_metres),
                    surface_vertex(
                        hull_corner(read hull, face, corner),
                        frame,
                        tile_metres
                    ),
                    surface_vertex(
                        hull_corner(read hull, face, corner + 1u32),
                        frame,
                        tile_metres
                    )
                },
                material: face.region,
                portal: 0u32,
                flags: 2u32
            };
            if !mesh_append(mut mesh, placed_triangle(primitive, origin, basis)) {
                return false;
            }
            corner = corner + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
record BevelledBody {
    sides: u32;
    radius: f32;
    length: f32;
    bevel: f32;
    shell: u32;
    rear: u32;
    front: u32;
}
// Appends a closed body along local +Y. Bevel is smaller than radius and half-length.
fn bevelled_body(mesh: mut Mesh, body: BevelledBody, origin: Vec3, basis: Basis) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = make RegularProfile {
        sides: body.sides,
        phase: 3.14159265359f32 / body.sides as f32
    };
    if !loft_allocate(mut hull, profile, 4u32) {
        return false;
    }
    var half: f32 = body.length * 0.5f32;
    loft_ring(mut hull, profile, 0u32, -half, body.radius - body.bevel);
    loft_ring(mut hull, profile, 1u32, -half + body.bevel, body.radius);
    loft_ring(mut hull, profile, 2u32, half - body.bevel, body.radius);
    loft_ring(mut hull, profile, 3u32, half, body.radius - body.bevel);
    var ring: u32 = 0u32;
    while ring < 3u32 {
        loft_span(mut hull, profile, ring, body.shell);
        ring = ring + 1u32;
    }
    loft_caps(mut hull, profile, 4u32, body.rear, body.front);
    return hull_solid_mesh(read hull, mut mesh, origin, basis, body.radius * 4f32);
}
// Appends a closed rectangular solid centred on its local origin.
// Dimensions are positive. Each face uses the region and a centred texture tile.
fn solid_box(
    mesh: mut Mesh,
    dimensions: Vec3,
    region: u32,
    origin: Vec3,
    basis: Basis,
    tile_metres: f32
) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = make RegularProfile {
        sides: 4u32,
        phase: 0f32
    };
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    var ring: u32 = 0u32;
    while ring < 2u32 {
        var i: u32 = 0u32;
        while i < 4u32 {
            var x: f32 = dimensions.x * 0.5f32;
            var z: f32 = dimensions.z * 0.5f32;
            if i == 1u32 || i == 2u32 {
                x = -x;
            }
            if i >= 2u32 {
                z = -z;
            }
            asset_vertex_set(
                mut hull,
                ring * 4u32 + i,
                vec(x, (ring as f32 - 0.5f32) * dimensions.y, z)
            );
            i = i + 1u32;
        }
        ring = ring + 1u32;
    }
    loft_span(mut hull, profile, 0u32, region);
    loft_caps(mut hull, profile, 2u32, region, region);
    var face: u32 = 0u32;
    while face < asset_face_count(read hull) {
        var frame: SurfaceFrame = asset_surface(read hull, face);
        frame.origin = sub(
            frame.origin,
            scale(add(frame.right, frame.up), tile_metres * 0.5f32)
        );
        asset_surface_set(mut hull, face, frame);
        face = face + 1u32;
    }
    return hull_solid_mesh(read hull, mut mesh, origin, basis, tile_metres);
}
// Appends a closed cylinder from Y=0 to length. Dimensions and tile size are
// positive; sides is at least three. Side UVs run axially and around the perimeter.
fn solid_cylinder(
    mesh: mut Mesh,
    sides: u32,
    radius: f32,
    extent: f32,
    region: u32,
    tile_metres: f32
) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = make RegularProfile {
        sides: sides,
        phase: 3.14159265359f32 / sides as f32
    };
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, 0f32, radius);
    loft_ring(mut hull, profile, 1u32, extent, radius);
    loft_span(mut hull, profile, 0u32, region);
    loft_caps(mut hull, profile, 2u32, region, region);
    var edge: f32 = 2f32 * radius * sinf(3.14159265359f32 / sides as f32);
    var i: u32 = 0u32;
    while i < sides {
        var face: HullFace = asset_face(read hull, i);
        var frame: SurfaceFrame = asset_surface(read hull, i);
        frame.origin = sub(
            hull_corner(read hull, face, 0u32),
            scale(frame.up, edge * i as f32)
        );
        asset_surface_set(mut hull, i, frame);
        i = i + 1u32;
    }
    return hull_solid_mesh(
        read hull,
        mut mesh,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        tile_metres
    );
}
// Appends a solid isosceles triangular prism along +Y. Dimensions are positive.
// The apex is at X=0, Z=0; the base is at X=height, Z=+/-half_width.
fn solid_triangular_prism(
    mesh: mut Mesh,
    half_width: f32,
    height: f32,
    depth: f32,
    region: u32,
    tile_metres: f32
) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = make RegularProfile {
        sides: 3u32,
        phase: 3.14159265359f32
    };
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, 0f32, 1f32);
    loft_ring(mut hull, profile, 1u32, depth, 1f32);
    var i: u32 = 0u32;
    while i < 6u32 {
        var p: Vec3 = asset_vertex(read hull, i);
        p.x = (p.x + 1f32) * height / 1.5f32;
        p.z = p.z * half_width / 0.86602540378f32;
        asset_vertex_set(mut hull, i, p);
        i = i + 1u32;
    }
    loft_span(mut hull, profile, 0u32, region);
    loft_caps(mut hull, profile, 2u32, region, region);
    return hull_solid_mesh(
        read hull,
        mut mesh,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        tile_metres
    );
}
