const GALLERY_CABLE_LAYERS: u32 = 4u32;
fn conduit_gallery_point(side: u32, radial: f32, y: f32, along: f32) -> Vec3 {
    if side == 0u32 {
        return vec(radial, y, along);
    }
    if side == 1u32 {
        return vec(-along, y, radial);
    }
    if side == 2u32 {
        return vec(-radial, y, -along);
    }
    return vec(along, y, -radial);
}
// Wall lanes stay outside the central flight corridor. Each layer has two
// perimeter rings and four longitudinal corner links.
fn conduit_gallery_lanes(router: mut PipeRouter, length_metres: f32, layer: u32, seed: u32) -> bool {
    var base: u32 = route_nodes_count(read router);
    var radial: f32 = CONDUIT_BREACH_WIDTH * 0.5f32 - 5f32 - layer as f32 * 3f32;
    var ring: u32 = 0u32;
    while ring < 2u32 {
        var y: f32 = length_metres * (0.12f32 + layer as f32 * 0.075f32 + ring as f32 * 0.55f32);
        var side: u32 = 0u32;
        while side < 4u32 {
            if pipe_route_point(
                mut router,
                conduit_gallery_point(side, radial, y, -radial),
                vec(0f32, 1f32, 0f32),
                PIPE_NO_EXIT
            ) == PIPE_NO_EXIT {
                return false;
            }
            side = side + 1u32;
        }
        ring = ring + 1u32;
    }
    var side: u32 = 0u32;
    while side < 4u32 {
        if !pipe_route_link(mut router, base + side, base + side + 4u32) {
            return false;
        }
        ring = 0u32;
        while ring < 2u32 {
            var corner: u32 = base + ring * 4u32 + side;
            var y: f32 = route_nodes_get(read router, corner).position.y;
            var along: f32 = (
                conduit_debris_random(seed, layer * 8u32 + ring * 4u32 + side) - 0.5f32
            ) * 26f32;
            var node: u32 = pipe_route_point(
                mut router,
                conduit_gallery_point(side, radial, y, along),
                vec(0f32, 1f32, 0f32),
                PIPE_NO_EXIT
            );
            var mouth: u32 = pipe_route_point(
                mut router,
                conduit_gallery_point(side, CONDUIT_BREACH_WIDTH * 0.5f32, y, along),
                vec(0f32, 1f32, 0f32),
                layer * 8u32 + ring * 4u32 + side
            );
            if !pipe_route_link(mut router, corner, node) || !pipe_route_link(
                mut router,
                node,
                base + ring * 4u32 + (side + 1u32) % 4u32
            ) || !pipe_route_link(mut router, node, mouth) {
                return false;
            }
            ring = ring + 1u32;
        }
        side = side + 1u32;
    }
    return true;
}
fn conduit_gallery_mount(asset: mut RoomAsset, point: Vec3, radius: f32) -> bool {
    var normal: Vec3 = vec(0f32, 0f32, 1f32);
    if point.z < 0f32 {
        normal.z = -1f32;
    }
    if absf(point.x) > absf(point.z) {
        normal = vec(1f32, 0f32, 0f32);
        if point.x < 0f32 {
            normal.x = -1f32;
        }
    }
    var wall: Vec3 = add(
        point,
        scale(normal, CONDUIT_BREACH_WIDTH * 0.5f32 - dot(point, normal))
    );
    return conduit_catwalk_box(
        mut asset,
        vec(radius * 4f32, radius * 4f32, 0.6f32),
        sub(wall, scale(normal, 0.3f32)),
        conduit_catwalk_basis(normal),
        CONDUIT_REBAR_MATERIAL,
        asset_name("utility-mount")
    );
}
fn conduit_gallery_route(
    asset: mut RoomAsset,
    router: read PipeRouter,
    path: RoutePath,
    seed: u32
) -> bool {
    var graph: PipeGraph = pipe_graph_new();
    var region: u32 = 1u32 + metal_hash(seed, path.source, 72u32) % 3u32;
    if route_nodes_get(read router, path.source).exit_id == GALLERY_CABLE_LAYERS * 8u32 {
        region = 2u32;
    }
    var radius: f32 = 0.7f32 + conduit_debris_random(seed, path.source + 91u32) * 0.7f32;
    if !route_copy_path(read router, mut graph, path) || !pipe_graph_mesh(
        mut asset,
        read graph,
        make TubeStyle {
            radius: radius,
            sides: 8u32,
            tile_metres: conduit_gallery_cable_tile(region),
            region: region
        },
        2f32
    ) {
        return false;
    }
    return conduit_gallery_mount(
        mut asset,
        route_nodes_get(read router, path.source).position,
        radius
    ) && conduit_gallery_mount(
        mut asset,
        route_nodes_get(read router, path.target).position,
        radius
    );
}
fn conduit_gallery_crossings(router: mut PipeRouter, length_metres: f32, seed: u32) -> bool {
    var i: u32 = 0u32;
    while i < 2u32 {
        var side: u32 = (seed + i) % 4u32;
        var y: f32 = length_metres * (0.43f32 + i as f32 * 0.14f32);
        var wall: f32 = CONDUIT_BREACH_WIDTH * 0.5f32;
        var a: f32 = 8f32 + 8f32 * conduit_debris_random(seed, 121u32 + i);
        var b: f32 = 8f32 + 8f32 * conduit_debris_random(seed, 131u32 + i);
        var source: u32 = pipe_route_point(
            mut router,
            conduit_gallery_point(side, wall, y, a),
            vec(0f32, 1f32, 0f32),
            GALLERY_CABLE_LAYERS * 8u32 + i * 2u32
        );
        var target: u32 = pipe_route_point(
            mut router,
            conduit_gallery_point((side + 2u32) % 4u32, wall, y, -b),
            vec(0f32, 1f32, 0f32),
            GALLERY_CABLE_LAYERS * 8u32 + i * 2u32 + 1u32
        );
        if !pipe_route_link(mut router, source, target) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn conduit_gallery_services(asset: mut RoomAsset, length_metres: f32, seed: u32) -> bool {
    var router: PipeRouter = pipe_router_new(0f32, 0u32);
    var graph: PipeGraph = pipe_graph_new();
    var layer: u32 = 0u32;
    while layer < GALLERY_CABLE_LAYERS {
        if !conduit_gallery_lanes(mut router, length_metres, layer, seed) {
            return false;
        }
        layer = layer + 1u32;
    }
    if !conduit_gallery_crossings(mut router, length_metres, seed) || !pipe_route_solve(
        mut router,
        mut graph,
        2f32,
        1.4f32,
        seed
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < route_paths_count(read router) {
        var path: RoutePath = route_paths_get(read router, i);
        if path.selected && !conduit_gallery_route(mut asset, read router, path, seed) {
            return false;
        }
        i = i + 1u32;
    }
    pipe_route_guides(mut router);
    pipe_router_swap(mut asset.routes, mut router);
    return true;
}
