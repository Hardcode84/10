fn oct_junction_pipe_part(
    asset: mut RoomAsset,
    first: u32,
    origin: Vec3,
    side: u32,
    name: AssetName
) -> bool {
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            linear: vec(0f32, 0f32, 0f32),
            angular: vec(0f32, 0f32, 0f32),
            name: name,
            first: first,
            count: mesh_triangle_count(read asset.geometry) - first,
            origin: origin,
            basis: make Basis {
                right: junction_quarter(vec(1f32, 0f32, 0f32), side),
                up: junction_quarter(vec(0f32, 1f32, 0f32), side),
                forward: vec(0f32, 0f32, 1f32)
            }
        }
    );
}
fn oct_junction_straight_pipe(
    asset: mut RoomAsset,
    origin: Vec3,
    side: u32,
    extent: f32,
    name: AssetName
) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var bands: u32 = (extent / 2f32) as u32 + 1u32;
    if !solid_cylinder(
        mut asset.geometry,
        8u32,
        oct_pipe_radius(),
        extent,
        1u32,
        extent / bands as f32
    ) {
        return false;
    }
    return oct_junction_pipe_part(mut asset, first, origin, side, name);
}
// Joins adjacent mouths with a 1.2 m pipe bend. Offset is relative to the first mouth.
fn oct_junction_bent_pipe(
    asset: mut RoomAsset,
    leg: f32,
    side: u32,
    offset: Vec3,
    diagonal: f32,
    name: AssetName
) -> bool {
    var radius: f32 = 1.2f32;
    var lead: f32 = leg - offset.x - radius - diagonal * 0.70710678118f32;
    var extent: f32 = lead * 2f32 + radius * 1.57079632679f32 + diagonal;
    var bands: u32 = (extent / 2f32) as u32 + 1u32;
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var bend: TubeBend = make TubeBend {
        radius: radius,
        tube_radius: oct_pipe_radius(),
        incoming: lead,
        outgoing: lead,
        diagonal: diagonal,
        sides: 8u32,
        steps: tube_sweep_steps(1.57079632679f32),
        tile_metres: extent / bands as f32
    };
    if !solid_tube_bend(mut asset.geometry, bend, 1u32) {
        return false;
    }
    return oct_junction_pipe_part(
        mut asset,
        first,
        junction_quarter(vec(offset.x, -leg, offset.z), side),
        side,
        name
    );
}
fn oct_junction_overhead(
    asset: mut RoomAsset,
    plan: JunctionPlan,
    height: f32,
    name: AssetName
) -> bool {
    if !oct_junction_straight_pipe(
        mut asset,
        vec(0f32, -plan.distance, height),
        0u32,
        plan.distance * 2f32,
        name
    ) {
        return false;
    }
    var start: f32 = 0f32;
    var extent: f32 = plan.distance;
    if plan.count == 4u32 {
        start = -plan.distance;
        extent = plan.distance * 2f32;
    }
    return oct_junction_straight_pipe(
        mut asset,
        vec(start, 0f32, height),
        3u32,
        extent,
        name
    );
}
// Side pipes join successive mouths and leave the central flight path clear.
fn oct_junction_side_pipes(asset: mut RoomAsset, plan: JunctionPlan) -> bool {
    var i: u32 = 0u32;
    while i < plan.count {
        var side: u32 = plan.sides[i as usize];
        var next: u32 = plan.sides[((i + 1u32) % plan.count) as usize];
        if (next + 4u32 - side) % 4u32 == 1u32 {
            if !oct_junction_bent_pipe(
                mut asset,
                plan.distance,
                side,
                vec(oct_pipe_distance(), 0f32, 0f32),
                0f32,
                junction_port(side, 0u32, plan.distance).id
            ) {
                return false;
            }
        } else {
            if !oct_junction_straight_pipe(
                mut asset,
                junction_quarter(vec(oct_pipe_distance(), -plan.distance, 0f32), side),
                side,
                plan.distance * 2f32,
                junction_port(side, 0u32, plan.distance).id
            ) {
                return false;
            }
        }
        i = i + 1u32;
    }
    return true;
}
// Side pipes join successive mouths. Ceiling and floor pipes form a tee or cross.
fn oct_junction_pipes(asset: mut RoomAsset, plan: JunctionPlan) -> bool {
    return oct_junction_side_pipes(mut asset, plan) && oct_junction_overhead(
        mut asset,
        plan,
        oct_pipe_distance(),
        asset_name("TOP-PIPE")
    ) && oct_junction_overhead(
        mut asset,
        plan,
        -oct_pipe_distance(),
        asset_name("BOTTOM-PIPE")
    );
}
// Cross-junction ceiling or floor routing: 0 cross, 1 curve, 2 diagonal.
// The floor pairs the opposite mouths to the ceiling for curved routes.
fn oct_junction_layer_pipes(
    asset: mut RoomAsset,
    plan: JunctionPlan,
    upper: bool,
    style: u32
) -> bool {
    var height: f32 = oct_pipe_distance();
    var side: u32 = 0u32;
    var name: AssetName = asset_name("TOP-PIPE");
    if !upper {
        height = -height;
        side = 1u32;
        name = asset_name("BOTTOM-PIPE");
    }
    if style == 0u32 {
        return oct_junction_overhead(mut asset, plan, height, name);
    }
    var diagonal: f32 = 0f32;
    if style == 2u32 {
        diagonal = plan.distance * 0.6f32;
    }
    return oct_junction_bent_pipe(
        mut asset,
        plan.distance,
        side,
        vec(0f32, 0f32, height),
        diagonal,
        name
    ) && oct_junction_bent_pipe(
        mut asset,
        plan.distance,
        side + 2u32,
        vec(0f32, 0f32, height),
        diagonal,
        name
    );
}
