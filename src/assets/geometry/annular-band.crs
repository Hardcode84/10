// A closed annular bearing housing centred on Y=0.
// Texture width follows the circumference; height follows the cross-section.
fn annular_band_vertex(
    inner: f32,
    outer: f32,
    depth: f32,
    section: u32,
    corner: u32,
    circum_tiles: f32,
    radial_tiles: f32,
    axial_tiles: f32
) -> MeshVertex {
    var radius: f32 = inner;
    if corner % 4u32 == 1u32 || corner % 4u32 == 2u32 {
        radius = outer;
    }
    var height: f32 = -depth * 0.5f32;
    if corner % 4u32 >= 2u32 {
        height = -height;
    }
    var angle: f32 = (section % 48u32) as f32 * (2f32 * PI) / 48f32;
    return make MeshVertex {
        x: radius * cosf(angle),
        y: height,
        z: radius * sinf(angle),
        u: section as f32 / 48f32 * circum_tiles,
        v: (corner / 2u32) as f32 * (radial_tiles + axial_tiles) + (corner % 2u32) as f32 * radial_tiles
    };
}
fn annular_band_mesh(
    mesh: mut Mesh,
    inner: f32,
    outer: f32,
    depth: f32,
    region: u32,
    tile: f32,
    tile_height: f32
) -> bool {
    return annular_band_mesh_uv(
        mut mesh,
        inner,
        outer,
        depth,
        region,
        panel_pixel_extent(PI * (inner + outer) / tile, 1u32) as f32,
        (outer - inner) / tile_height,
        depth / tile_height
    );
}
// Appends a closed ring with explicit texture repeats around and across each face.
fn annular_band_mesh_uv(
    mesh: mut Mesh,
    inner: f32,
    outer: f32,
    depth: f32,
    region: u32,
    circum_tiles: f32,
    radial_tiles: f32,
    axial_tiles: f32
) -> bool {
    var i: u32 = 0u32;
    while i < 48u32 {
        var c: u32 = 0u32;
        while c < 4u32 {
            var next: u32 = c + 1u32;
            if !solid_mesh_quad(
                mut mesh,
                annular_band_vertex(
                    inner,
                    outer,
                    depth,
                    i,
                    c,
                    circum_tiles,
                    radial_tiles,
                    axial_tiles
                ),
                annular_band_vertex(
                    inner,
                    outer,
                    depth,
                    i,
                    next,
                    circum_tiles,
                    radial_tiles,
                    axial_tiles
                ),
                annular_band_vertex(
                    inner,
                    outer,
                    depth,
                    i + 1u32,
                    next,
                    circum_tiles,
                    radial_tiles,
                    axial_tiles
                ),
                annular_band_vertex(
                    inner,
                    outer,
                    depth,
                    i + 1u32,
                    c,
                    circum_tiles,
                    radial_tiles,
                    axial_tiles
                ),
                region
            ) {
                return false;
            }
            c = c + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
