// A closed annular bearing housing centred on Y=0.
fn annular_band_vertex(
    inner: f32,
    outer: f32,
    depth: f32,
    section: u32,
    corner: u32,
    tile: f32
) -> MeshVertex {
    var radius: f32 = inner;
    if corner % 4u32 == 1u32 || corner % 4u32 == 2u32 {
        radius = outer;
    }
    var height: f32 = -depth * 0.5f32;
    if corner % 4u32 >= 2u32 {
        height = -height;
    }
    var angle: f32 = (section % 48u32) as f32 * 6.28318530718f32 / 48f32;
    return make MeshVertex {
        x: radius * cosf(angle),
        y: height,
        z: radius * sinf(angle),
        u: section as f32 / 48f32 * panel_pixel_extent(
            3.14159265359f32 * (inner + outer) / tile,
            1u32
        ) as f32,
        v: (
            (corner / 2u32) as f32 * (outer - inner + depth) + (corner % 2u32) as f32 * (
                outer - inner
            )
        ) / tile
    };
}
fn annular_band_mesh(
    mesh: mut Mesh,
    inner: f32,
    outer: f32,
    depth: f32,
    region: u32,
    tile: f32
) -> bool {
    var i: u32 = 0u32;
    while i < 48u32 {
        var c: u32 = 0u32;
        while c < 4u32 {
            var next: u32 = c + 1u32;
            if !solid_mesh_quad(
                mut mesh,
                annular_band_vertex(inner, outer, depth, i, c, tile),
                annular_band_vertex(inner, outer, depth, i, next, tile),
                annular_band_vertex(inner, outer, depth, i + 1u32, next, tile),
                annular_band_vertex(inner, outer, depth, i + 1u32, c, tile),
                region
            ) {
                return false;
            }
            c = c + 1u32;
        }
        i = i + 1u32;
    }
    return true;
}
