record CylinderMount {
    centre: Vec3;
    outward: Vec3;
    radius: f32;
    inner: bool;
    scale: f32;
    lower: f32;
    upper: f32;
    flange_region: u32;
    leak_region: u32;
}
fn cylinder_mount_flange(asset: mut RoomAsset, mount: CylinderMount, axis: Vec3) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !bevelled_body(
        mut asset.geometry,
        make BevelledBody {
            sides: 12u32,
            radius: 0.31f32 * mount.scale,
            length: 0.24f32 * mount.scale,
            bevel: 0.025f32 * mount.scale,
            shell: mount.flange_region,
            rear: mount.flange_region,
            front: mount.flange_region
        },
        sub(mount.centre, scale(axis, 0.03f32 * mount.scale)),
        make Basis {
            right: vec(0f32, 1f32, 0f32),
            up: axis,
            forward: cross(vec(0f32, 1f32, 0f32), axis)
        }
    ) {
        return false;
    }
    return pipe_graph_part(mut asset, first);
}
// Adds a pipe flange and +Y leak marks on a 48-sided Y-axis cylinder.
// Outward is a facet normal. Lower and upper bound the cylindrical surface.
fn cylinder_pipe_mount(asset: mut RoomAsset, mount: CylinderMount) -> bool {
    if !cylinder_mount_flange(mut asset, mount, mount.outward) {
        return false;
    }
    return cylinder_surface_patch(
        mut asset.decals,
        make CylinderPatch {
            centre: add(mount.centre, vec(0f32, 0.5f32 * mount.scale, 0f32)),
            outward: mount.outward,
            radius: mount.radius,
            inner: mount.inner,
            width: 1.1f32 * mount.scale,
            height: 1.8f32 * mount.scale,
            lower: mount.lower,
            upper: mount.upper,
            region: mount.leak_region
        }
    );
}
