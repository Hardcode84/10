fn conduit_support_material() -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.finish = SURFACE_STRUCTURAL_STEEL;
    material.colour = 0x8f9172u32;
    material.accent = 0x5ba5cau32;
    material.tile_metres = 16f32;
    material.tile_height = 8f32;
    material.texels_per_metre = 16u32;
    material.indicator = false;
    material.marking = 0u32;
    material.pitch = 0.8f32;
    return material;
}
fn conduit_support_box(
    asset: mut RoomAsset,
    dimensions: Vec3,
    centre: Vec3,
    basis: Basis,
    visible_start: f32,
    visible_end: f32,
    name: AssetName
) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var hull: AssetHull = asset_hull_new();
    if !solid_box_hull(mut hull, dimensions, CONDUIT_SUPPORT_MATERIAL) {
        return false;
    }
    var side: u32 = 0u32;
    while side < asset_face_count(read hull) {
        var frame: SurfaceFrame = asset_surface(read hull, side);
        frame.origin = scale(dimensions, -0.5f32);
        if absf(frame.normal.x) < 0.5f32 {
            var span: f32 = visible_end - visible_start;
            var tiles: f32 = panel_pixel_extent(
                span / conduit_support_material().tile_metres,
                1u32
            ) as f32;
            frame.origin.x = visible_start;
            frame.right = vec(
                conduit_support_material().tile_metres * tiles / span,
                0f32,
                0f32
            );
            frame.up = vec(
                0f32,
                conduit_support_material().tile_metres / dimensions.y,
                0f32
            );
            if absf(frame.normal.y) > 0.5f32 {
                frame.up = vec(
                    0f32,
                    0f32,
                    conduit_support_material().tile_metres / dimensions.z
                );
            }
        } else {
            frame.right = vec(
                0f32,
                conduit_support_material().tile_metres / dimensions.y,
                0f32
            );
            frame.up = vec(
                0f32,
                0f32,
                conduit_support_material().tile_metres / dimensions.z
            );
        }
        asset_surface_set(mut hull, side, frame);
        side = side + 1u32;
    }
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        centre,
        basis,
        conduit_support_material().tile_metres
    ) {
        return false;
    }
    return asset_part_place_tail(mut asset, first, name, vec(0f32, 0f32, 0f32));
}
fn conduit_support_width(core: f32) -> f32 {
    return core * 0.24f32;
}
fn conduit_support_depth(core: f32) -> f32 {
    return core * 0.32f32;
}
fn conduit_support_axial_extent(core: f32) -> f32 {
    return conduit_support_depth(core) * 1.4f32 * 0.5f32;
}
fn conduit_supports(
    asset: mut RoomAsset,
    radius: f32,
    core: f32,
    height: f32,
    relief: f32,
    broken: u32
) -> bool {
    var centre: Vec3 = vec(0f32, height * 0.5f32, 0f32);
    var collar: f32 = core * 1.08f32;
    var width: f32 = conduit_support_width(core);
    var depth: f32 = conduit_support_depth(core);
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var inner: f32 = core * 0.85f32;
    var collar_depth: f32 = conduit_support_axial_extent(core) * 2f32;
    var circumference: f32 = PI * (inner + collar);
    var circum_tiles: u32 = panel_pixel_extent(
        circumference / (conduit_support_material().tile_metres * 8f32),
        1u32
    ) * 8u32;
    if !annular_band_mesh_uv(
        mut asset.geometry,
        inner,
        collar,
        collar_depth,
        CONDUIT_SUPPORT_MATERIAL,
        circum_tiles as f32,
        panel_pixel_extent((collar - inner) / conduit_support_material().tile_height, 1u32) as f32,
        panel_pixel_extent(collar_depth / conduit_support_material().tile_height, 1u32) as f32
    ) || !asset_part_place_tail(mut asset, first, asset_name("core-clamp"), centre) {
        return false;
    }
    var wall: f32 = radius * cosf(PI / 48f32);
    var start: f32 = core;
    var span: f32 = radius - start;
    var foot: f32 = relief + width * 0.3f32;
    var i: u32 = 0u32;
    while i < 4u32 {
        var angle: f32 = (i as f32 + 0.5f32) * (0.5f32 * PI);
        var radial: Vec3 = vec(cosf(angle), 0f32, sinf(angle));
        var up: Vec3 = vec(0f32, 1f32, 0f32);
        var basis: Basis = make Basis {
            right: radial,
            up: up,
            forward: cross(radial, up)
        };
        if !conduit_support_beam(
            mut asset,
            centre,
            basis,
            vec(span, depth, width),
            start,
            collar,
            wall,
            foot,
            broken == i + 1u32
        ) || !conduit_support_box(
            mut asset,
            vec(foot, depth * 1.3f32, width * 1.3f32),
            add(centre, scale(radial, wall - foot * 0.5f32)),
            basis,
            -foot * 0.5f32,
            foot * 0.5f32,
            asset_name("support-foot")
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn conduit_support_lights(
    asset: mut RoomAsset,
    centre: Vec3,
    radial: Vec3,
    depth: f32,
    width: f32
) -> bool {
    var side: u32 = 0u32;
    while side < 2u32 {
        var outward: Vec3 = vec(0f32, side as f32 * 2f32 - 1f32, 0f32);
        var frame: SurfaceFrame = make SurfaceFrame {
            origin: add(centre, scale(outward, depth * 0.5f32)),
            normal: scale(outward, -1f32),
            right: radial,
            up: cross(outward, radial)
        };
        if !emergency_fixture(
            frame,
            mut asset,
            CONDUIT_SUPPORT_MATERIAL,
            CONDUIT_LIGHT_MATERIAL,
            width * 0.75f32,
            conduit_support_material().tile_metres
        ) {
            return false;
        }
        side = side + 1u32;
    }
    return true;
}
