record StationPipeLayout {
    width: f32;
    depth: f32;
    height: f32;
    core: f32;
    inset: f32;
    bend: f32;
}
fn station_pipe_corner(layout: StationPipeLayout, corner: u32, layer: u32) -> Vec3 {
    var x: f32 = layout.width * 0.5f32 - layout.inset;
    var z: f32 = layout.depth * 0.5f32 - layout.inset;
    if corner == 0u32 || corner == 3u32 {
        x = -x;
    }
    if corner >= 2u32 {
        z = -z;
    }
    return vec(
        x,
        layout.inset + layer as f32 * (layout.height - 2f32 * layout.inset),
        z
    );
}
fn station_pipe_ring(router: mut PipeRouter, layout: StationPipeLayout, layer: u32) -> bool {
    var corner: u32 = 0u32;
    while corner < 4u32 {
        var point: Vec3 = station_pipe_corner(layout, corner, layer);
        if hub_lane_point(mut router, point) == PIPE_NO_EXIT {
            return false;
        }
        corner = corner + 1u32;
    }
    return true;
}
fn station_pipe_wall(
    asset: read RoomAsset,
    router: mut PipeRouter,
    layout: StationPipeLayout,
    face: u32
) -> bool {
    var port: RoomPort = asset_port(read asset.ports, face);
    // Corner order follows the four side ports.
    var corners: [u32; 4] = make [u32; 4] {
        1u32,
        0u32,
        3u32,
        2u32
    };
    var a: u32 = corners[face as usize];
    var b: u32 = corners[((face + 1u32) % 4u32) as usize];
    var slot: u32 = 0u32;
    while slot < 4u32 {
        var mouth: u32 = hub_lane_mouth(mut router, port, slot);
        var entry: Vec3 = sub(
            hub_pipe_mouth(port, slot),
            scale(port.basis.forward, layout.inset)
        );
        var target: Vec3 = entry;
        if slot == 1u32 || slot == 3u32 {
            var layer: u32 = (slot == 1u32) as u32;
            target.y = layout.inset + layer as f32 * (layout.height - 2f32 * layout.inset);
            var node: u32 = hub_lane_point(mut router, target);
            if !pipe_route_link(mut router, node, a + layer * 4u32) || !pipe_route_link(
                mut router,
                node,
                b + layer * 4u32
            ) || !pipe_route_via(mut router, mouth, node, entry) {
                return false;
            }
        } else {
            var corner: u32 = a;
            if slot == 2u32 {
                corner = b;
            }
            target = sub(
                station_pipe_corner(layout, corner, 0u32),
                scale(hub_pipe_radial(port, slot), 1.4f32)
            );
            target.y = layout.height * 0.5f32;
            var node: u32 = hub_lane_point(mut router, target);
            if !pipe_route_link(mut router, node, corner + 8u32) || !pipe_route_via(
                mut router,
                mouth,
                node,
                entry
            ) {
                return false;
            }
        }
        slot = slot + 1u32;
    }
    return true;
}
fn station_pipe_sinks(router: mut PipeRouter, layout: StationPipeLayout) -> bool {
    var i: u32 = 0u32;
    while i < 8u32 {
        var point: Vec3 = route_nodes_get(read router, i).position;
        var direction: Vec3 = unit_vector(vec(point.x, 0f32, point.z));
        var height: f32 = point.y;
        var offset: f32 = (i % 2u32) as f32 * 1.4f32;
        if i < 4u32 {
            height = height + offset;
        } else {
            height = height - offset;
        }
        var end: Vec3 = add(
            scale(direction, layout.core - 0.1f32),
            vec(0f32, height, 0f32)
        );
        var approach: Vec3 = add(
            scale(direction, layout.core + 1.4f32),
            vec(0f32, height, 0f32)
        );
        var sink: u32 = hub_lane_sink(mut router, end);
        if !pipe_route_via(mut router, i, sink, approach) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn station_service_pipes(asset: mut RoomAsset, layout: StationPipeLayout, seed: u32) -> bool {
    var router: PipeRouter = pipe_router_new();
    var graph: PipeGraph = pipe_graph_new();
    if !station_pipe_ring(mut router, layout, 0u32) || !station_pipe_ring(
        mut router,
        layout,
        1u32
    ) {
        return false;
    }
    var corner: u32 = 0u32;
    while corner < 4u32 {
        var point: Vec3 = station_pipe_corner(layout, corner, 0u32);
        point.y = layout.height * 0.5f32;
        var node: u32 = hub_lane_point(mut router, point);
        if !pipe_route_link(mut router, node, corner) || !pipe_route_link(
            mut router,
            node,
            corner + 4u32
        ) {
            return false;
        }
        corner = corner + 1u32;
    }
    var face: u32 = 0u32;
    while face < 4u32 {
        if !station_pipe_wall(read asset, mut router, layout, face) {
            return false;
        }
        face = face + 1u32;
    }
    if !station_pipe_sinks(mut router, layout) || !pipe_route_solve(
        mut router,
        mut graph,
        layout.bend,
        oct_pipe_radius(),
        seed
    ) || !pipe_graph_mesh(
        mut asset,
        read graph,
        make TubeStyle {
            radius: oct_pipe_radius(),
            sides: 8u32,
            tile_metres: 2f32,
            region: 5u32
        },
        layout.bend
    ) {
        return false;
    }
    if !station_pipe_mounts(mut asset, read graph, layout) {
        return false;
    }
    pipe_route_guides(mut router);
    pipe_router_swap(mut asset.routes, mut router);
    return true;
}
fn station_pipe_mounts(
    asset: mut RoomAsset,
    graph: read PipeGraph,
    layout: StationPipeLayout
) -> bool {
    var i: u32 = 0u32;
    while i < pipe_node_count(read graph) {
        var node: PipeNode = pipe_node(read graph, i);
        if node.degree == 1u32 && node.exit_id == PIPE_NO_EXIT {
            var normal: Vec3 = unit_vector(
                vec(node.position.x, 0f32, node.position.z)
            );
            if !cylinder_pipe_mount(
                mut asset,
                make CylinderMount {
                    centre: add(
                        scale(normal, layout.core * cosf(0.06544984695f32)),
                        vec(0f32, node.position.y, 0f32)
                    ),
                    outward: normal,
                    radius: layout.core,
                    inner: false,
                    scale: oct_pipe_radius() / 0.18f32,
                    lower: 0f32,
                    upper: layout.height,
                    flange_region: 6u32,
                    leak_region: 7u32
                }
            ) {
                return false;
            }
        }
        i = i + 1u32;
    }
    return true;
}
