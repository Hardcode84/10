const HEX_PIPE_RADIUS: f32 = 0.06f32;
const HEX_PIPE_BEND: f32 = 0.12f32;
const HEX_PIPE_OFFSET: f32 = 0.18f32;
const HEX_PIPE_EMBED: f32 = 0.06f32;
const HEX_PIPE_SPACING: f32 = 0.2f32;

record HexPipeRun {
    wall: Vec3;
    normal: Vec3;
    across: Vec3;
    length: f32;
    entry: bool;
    exit: bool;
}
fn hex_pipe_point(run: HexPipeRun, height: f32, depth: f32) -> Vec3 {
    var point: Vec3 = add(run.wall, scale(run.normal, depth));
    point.y = height;
    return point;
}
fn hex_pipe_style(run: HexPipeRun) -> TubeStyle {
    var distance: f32 = run.length;
    var extra: f32 = HEX_PIPE_EMBED + HEX_PIPE_OFFSET - 3f32 * HEX_PIPE_BEND + 1.57079632679f32 * HEX_PIPE_BEND;
    if !run.entry {
        distance = distance + extra;
    }
    if !run.exit {
        distance = distance + extra;
    }
    var tile: f32 = service_pipe_material().tile_metres;
    var repeats: u32 = (distance / tile) as u32;
    if repeats as f32 * tile < distance {
        repeats = repeats + 1u32;
    }
    return make TubeStyle {
        radius: HEX_PIPE_RADIUS,
        sides: 8u32,
        tile_metres: distance / repeats as f32,
        region: 1u32
    };
}
fn hex_pipe_run(run: HexPipeRun, asset: mut RoomAsset) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var axis: Vec3 = vec(0f32, 1f32, 0f32);
    var start: Vec3 = hex_pipe_point(run, 0f32, -HEX_PIPE_OFFSET);
    var tangent: Vec3 = axis;
    if !run.entry {
        start = hex_pipe_point(run, HEX_PIPE_BEND, HEX_PIPE_EMBED);
        tangent = scale(run.normal, -1f32);
    }
    var sweep: TubeSweep = tube_sweep_begin(
        start,
        tangent,
        run.across,
        hex_pipe_style(run)
    );
    if !run.entry && !tube_sweep_corner(
        mut asset.geometry,
        mut sweep,
        hex_pipe_point(run, HEX_PIPE_BEND, -HEX_PIPE_OFFSET),
        axis,
        HEX_PIPE_BEND
    ) {
        return false;
    }
    var end: Vec3 = hex_pipe_point(run, run.length, -HEX_PIPE_OFFSET);
    if !run.exit {
        if !tube_sweep_corner(
            mut asset.geometry,
            mut sweep,
            hex_pipe_point(run, run.length - HEX_PIPE_BEND, -HEX_PIPE_OFFSET),
            run.normal,
            HEX_PIPE_BEND
        ) {
            return false;
        }
        end = hex_pipe_point(run, run.length - HEX_PIPE_BEND, HEX_PIPE_EMBED);
    }
    if !tube_sweep_finish(mut asset.geometry, mut sweep, end) || !pipe_graph_part(
        mut asset,
        first
    ) {
        return false;
    }
    return hex_pipe_wall_collars(run, mut asset);
}
// Adds the requested solid bundles to a straight passage before room completion.
// Parameters contain a length and six triples: count, entry mode, exit mode.
fn hex_tunnel_pipes(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    var wall: u32 = 0u32;
    while wall < 6u32 {
        var base: u32 = 1u32 + wall * 3u32;
        var count: u32 = asset_value(read parameters, base) as u32;
        var frame: SurfaceFrame = hull_frame(
            read asset.hull,
            asset_face(read asset.hull, wall)
        );
        var across: Vec3 = cross(frame.normal, vec(0f32, 1f32, 0f32));
        var i: u32 = 0u32;
        while i < count {
            var offset: f32 = (i as f32 - (count - 1u32) as f32 * 0.5f32) * HEX_PIPE_SPACING;
            var run: HexPipeRun = make HexPipeRun {
                wall: add(frame.origin, scale(across, offset)),
                normal: frame.normal,
                across: across,
                length: asset_value(read parameters, 0u32),
                entry: asset_value(read parameters, base + 1u32) == 1f32,
                exit: asset_value(read parameters, base + 2u32) == 1f32
            };
            if !hex_pipe_run(run, mut asset) {
                return false;
            }
            i = i + 1u32;
        }
        if count != 0u32 && !hex_pipe_supports(
            frame,
            count,
            asset_value(read parameters, 0u32),
            mut asset
        ) {
            return false;
        }
        wall = wall + 1u32;
    }
    return true;
}

// Adds rectangular wall plates through the straight bundle at regular intervals.
fn hex_pipe_supports(frame: SurfaceFrame, count: u32, extent: f32, asset: mut RoomAsset) -> bool {
    var spacing: f32 = 2f32;
    var plates: u32 = (extent / spacing) as u32;
    if plates as f32 * spacing < extent {
        plates = plates + 1u32;
    }
    var edge: f32 = 0.03f32;
    var embed: f32 = 0.01f32;
    var depth: f32 = HEX_PIPE_OFFSET + HEX_PIPE_RADIUS + edge;
    var dimensions: Vec3 = vec(
        (count - 1u32) as f32 * HEX_PIPE_SPACING + 2f32 * (HEX_PIPE_RADIUS + edge),
        0.08f32,
        depth + embed
    );
    var basis: Basis = make Basis {
        right: cross(frame.normal, vec(0f32, 1f32, 0f32)),
        up: vec(0f32, 1f32, 0f32),
        forward: scale(frame.normal, -1f32)
    };
    var i: u32 = 0u32;
    while i < plates {
        var origin: Vec3 = sub(
            frame.origin,
            scale(frame.normal, (depth - embed) * 0.5f32)
        );
        origin.y = extent * (i as f32 + 0.5f32) / plates as f32;
        var first: u32 = mesh_triangle_count(read asset.geometry);
        if !solid_box(
            mut asset.geometry,
            dimensions,
            2u32,
            origin,
            basis,
            service_mount_material(false).tile_metres
        ) || !pipe_graph_part(mut asset, first) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}

fn hex_pipe_wall_collars(run: HexPipeRun, asset: mut RoomAsset) -> bool {
    if !run.entry && !hex_pipe_wall_collar(run, HEX_PIPE_BEND, mut asset) {
        return false;
    }
    if !run.exit && !hex_pipe_wall_collar(run, run.length - HEX_PIPE_BEND, mut asset) {
        return false;
    }
    return true;
}
fn hex_pipe_wall_collar(run: HexPipeRun, height: f32, asset: mut RoomAsset) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var thickness: f32 = 0.02f32;
    if !solid_cylinder(
        mut asset.geometry,
        8u32,
        HEX_PIPE_RADIUS * 1.6f32,
        thickness,
        2u32,
        service_mount_material(false).tile_metres
    ) {
        return false;
    }
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            name: asset_name("COLLAR"),
            first: first,
            count: mesh_triangle_count(read asset.geometry) - first,
            origin: hex_pipe_point(run, height, -thickness * 0.5f32),
            basis: make Basis {
                right: run.across,
                up: run.normal,
                forward: cross(run.across, run.normal)
            }
        }
    );
}
