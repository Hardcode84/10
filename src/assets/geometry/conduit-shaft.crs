fn conduit_shaft_wall_u(hull: read AssetHull, vertex: u32) -> f32 {
    if vertex < 96u32 {
        var index: i32 = (vertex % 48u32) as i32 + 1i32;
        if index > 24i32 {
            index = index - 48i32;
        }
        return index as f32;
    }
    var point: Vec3 = asset_vertex(read hull, vertex);
    return atan2f(point.z, point.x) * 48f32 / 6.28318530718f32 + 0.5f32;
}
fn conduit_shaft_wall_frame(hull: read AssetHull, face: HullFace, tile: f32, bay: f32) -> SurfaceFrame {
    var a: Vec3 = hull_corner(read hull, face, 0u32);
    var e: Vec3 = sub(hull_corner(read hull, face, 1u32), a);
    var f: Vec3 = sub(hull_corner(read hull, face, 2u32), a);
    var u: f32 = conduit_shaft_wall_u(read hull, asset_index(read hull, face.first));
    var du: f32 = conduit_shaft_wall_u(
        read hull,
        asset_index(read hull, face.first + 1u32)
    ) - u;
    var dv: f32 = conduit_shaft_wall_u(
        read hull,
        asset_index(read hull, face.first + 2u32)
    ) - u;
    var normal: Vec3 = cross(e, f);
    var right: Vec3 = scale(
        add(scale(cross(f, normal), du), scale(cross(normal, e), dv)),
        tile / dot(normal, normal)
    );
    var horizontal: Vec3 = vec(right.x, 0f32, right.z);
    var origin: Vec3 = sub(
        vec(a.x, 0f32, a.z),
        scale(horizontal, (u * tile - a.y * right.y) / dot(horizontal, horizontal))
    );
    return make SurfaceFrame {
        origin: origin,
        right: right,
        up: vec(0f32, tile / bay, 0f32),
        normal: unit_vector(normal)
    };
}
fn conduit_shaft_panel(asset: mut RoomAsset, centre: Vec3, half: f32, height: f32) -> bool {
    var next: AssetHull = asset_hull_new();
    var i: u32 = 0u32;
    while i < 4u32 {
        var point: Vec3 = add(
            centre,
            vec(
                0f32,
                ((i & 1u32) as f32 * 2f32 - 1f32) * half,
                ((i >> 1u32) as f32 * 2f32 - 1f32) * half
            )
        );
        if !hull_expand_point(read asset.hull, mut next, point, CONDUIT_MATERIAL_COUNT) {
            return false;
        }
        asset_hull_swap(mut asset.hull, mut next);
        i = i + 1u32;
    }
    if !hull_merge_panel(
        read asset.hull,
        mut next,
        vec(1f32, 0f32, 0f32),
        centre.x,
        CONDUIT_MATERIAL_COUNT
    ) {
        return false;
    }
    asset_hull_swap(mut asset.hull, mut next);
    i = 0u32;
    while i < asset_face_count(read asset.hull) {
        if asset_face(read asset.hull, i).region == CONDUIT_MATERIAL_COUNT {
            var frame: SurfaceFrame = conduit_shaft_wall_frame(
                read asset.hull,
                asset_face(read asset.hull, i),
                asset.tile_metres,
                height / panel_pixel_extent(height / CONDUIT_CAST_LENGTH, 1u32) as f32
            );
            asset_surface_set(mut asset.hull, i, frame);
        }
        i = i + 1u32;
    }
    return true;
}
fn conduit_shaft_opening(asset: mut RoomAsset, centre: Vec3, diameter: f32, height: f32) -> bool {
    if !conduit_shaft_panel(mut asset, centre, diameter, height) {
        return false;
    }
    var port: RoomPort = make RoomPort {
        id: asset_name("SHAFT"),
        profile: shaft_profile(diameter),
        face: asset_face_count(read asset.hull) - 1u32,
        position: centre,
        basis: make Basis {
            right: vec(0f32, 1f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(1f32, 0f32, 0f32)
        }
    };
    var next: AssetHull = asset_hull_new();
    if !hull_bordered_port(
        mut asset.hull,
        mut next,
        port,
        CONDUIT_MATERIAL_COUNT + 1u32,
        0.18f32,
        0.7f32,
        CONDUIT_MATERIAL_COUNT + 1u32
    ) {
        return false;
    }
    var i: u32 = 0u32;
    while i < 2u32 {
        var end: RoomPort = asset_port(read asset.ports, i);
        end.face = shaft_collar_end_face(read asset.hull, height * i as f32);
        asset_port_set(mut asset.ports, i, end);
        i = i + 1u32;
    }
    return asset_port_append(mut asset.ports, port);
}
fn conduit_shaft_axis() -> Basis {
    return make Basis {
        right: vec(0f32, 1f32, 0f32),
        up: vec(-1f32, 0f32, 0f32),
        forward: vec(0f32, 0f32, 1f32)
    };
}
fn conduit_shaft_spindle(asset: mut RoomAsset, centre: Vec3, radius: f32, reach: f32) -> bool {
    var hull: AssetHull = asset_hull_new();
    var profile: RegularProfile = shaft_profile(16f32).shape;
    var tip: f32 = radius * 0.2f32;
    if !loft_allocate(mut hull, profile, 3u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, 0f32, radius);
    loft_ring(mut hull, profile, 1u32, 2f32, radius);
    loft_ring(mut hull, profile, 2u32, reach, tip);
    loft_span(mut hull, profile, 0u32, CONDUIT_MATERIAL_COUNT + 1u32);
    loft_span(mut hull, profile, 1u32, CONDUIT_MATERIAL_COUNT + 2u32);
    loft_caps(
        mut hull,
        profile,
        3u32,
        CONDUIT_MATERIAL_COUNT + 1u32,
        CONDUIT_MATERIAL_COUNT + 1u32
    );
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        centre,
        conduit_shaft_axis(),
        asset.tile_metres
    ) || !asset_part_place_tail(
        mut asset,
        first,
        asset_name("shaft-spindle"),
        vec(0f32, 0f32, 0f32)
    ) {
        return false;
    }
    first = mesh_triangle_count(read asset.geometry);
    var light: Vec3 = add(centre, vec(-reach - tip, 0f32, 0f32));
    if !bevelled_body(
        mut asset.geometry,
        make BevelledBody {
            sides: 8u32,
            radius: tip * 1.5f32,
            length: tip * 2f32,
            bevel: tip * 0.25f32,
            shell: CONDUIT_MATERIAL_COUNT + 3u32,
            rear: CONDUIT_MATERIAL_COUNT + 1u32,
            front: CONDUIT_MATERIAL_COUNT + 3u32
        },
        light,
        conduit_shaft_axis()
    ) || !asset_part_place_tail(
        mut asset,
        first,
        asset_name("warning-light"),
        vec(0f32, 0f32, 0f32)
    ) {
        return false;
    }
    return fixture_light_append(
        mut asset.lights,
        make FixtureLight {
            space: 0u32,
            position: add(light, vec(-tip * 1.5f32, 0f32, 0f32)),
            colour: vec(1.3f32, 0.45f32, 0.025f32),
            radius: 4f32
        }
    );
}
