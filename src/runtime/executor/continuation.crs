const WORK_IDLE: u32 = 0u32;
const WORK_READY: u32 = 1u32;
const WORK_RUNNING: u32 = 2u32;
const WORK_WAITING: u32 = 3u32;
const WORK_DONE: u32 = 4u32;
const WORK_FAILED: u32 = 5u32;
record TaskStep {
    dependency: u32;
    success: bool;
}
fn task_done(success: bool) -> TaskStep {
    return make TaskStep {
        dependency: TASK_NONE,
        success: success
    };
}
fn task_await(dependency: u32) -> TaskStep {
    return make TaskStep {
        dependency: dependency,
        success: true
    };
}
record ScheduledWork {
    execute: fn(*u8) -> TaskStep;
    payload: *u8;
    result: TaskStep;
    state: u32;
    job: u32;
    generation: u64;
    dependency: u32;
    first_waiter: u32;
    next_waiter: u32;
    next_ready: u32;
    times: TaskRunTimes;
    suspensions: u32;
    priority: u32;
    demanded: bool;
    background: bool;
}
opaque;
record ScheduleState {
    references: i32;
    pool: TaskPool;
    work: *ScheduledWork;
    count: u32;
    first: u32;
    last: u32;
    running: u32;
    background_running: u32;
}
opaque;
resource TaskSchedule {
    state: *ScheduleState;
}
opaque drop schedule_drop;
fn schedule_new() -> TaskSchedule {
    return make TaskSchedule {
        state: null(*ScheduleState)
    };
}
fn schedule_empty(data: *u8) -> TaskStep {
    trap;
}
fn schedule_open(schedule: mut TaskSchedule, workers: u32, count: u32) -> bool {
    var pool: TaskPool = task_pool_new();
    return task_pool_open(mut pool, workers, count) && schedule_on(
        mut schedule,
        read pool,
        count
    );
}
fn schedule_on(schedule: mut TaskSchedule, pool: read TaskPool, count: u32) -> bool {
    if count == 0u32 || count as u64 * sizeof(ScheduledWork) as u64 > (~0usize) as u64 {
        return task_error("task schedule exceeds address space");
    }
    var state: *ScheduleState = task_allocate(sizeof(ScheduleState)) as *ScheduleState;
    if state == null(*ScheduleState) {
        return task_error("task schedule allocation failed");
    }
    * state = make ScheduleState {
        references: 1i32,
        pool: task_pool_clone(read pool),
        work: null(*ScheduledWork),
        count: 0u32,
        first: TASK_NONE,
        last: TASK_NONE,
        running: 0u32,
        background_running: 0u32
    };
    schedule.state = state;
    state -> work = task_allocate(count as usize * sizeof(ScheduledWork)) as *ScheduledWork;
    if state -> work == null(*ScheduledWork) {
        return task_error("task schedule nodes allocation failed");
    }
    var i: u32 = 0u32;
    while i < count {
        state -> work[i as usize] = make ScheduledWork {
            execute: schedule_empty,
            payload: null(*u8),
            result: task_done(false),
            state: WORK_IDLE,
            job: TASK_NONE,
            generation: 0u64,
            dependency: TASK_NONE,
            first_waiter: TASK_NONE,
            next_waiter: TASK_NONE,
            next_ready: TASK_NONE,
            suspensions: 0u32,
            priority: 0u32,
            demanded: false,
            background: false,
            times: make TaskRunTimes {
                start: 0u64,
                finish: 0u64
            }
        };
        i = i + 1u32;
    }
    state -> count = count;
    return true;
}
fn schedule_clone(schedule: read TaskSchedule) -> TaskSchedule {
    if schedule.state != null(*ScheduleState) {
        reference_retain(&schedule.state -> references);
    }
    return make TaskSchedule {
        state: schedule.state
    };
}
// Requires a retired node and payload storage that remains live until retirement.
fn schedule_define(
    schedule: read TaskSchedule,
    id: u32,
    execute: fn(*u8) -> TaskStep,
    payload: *u8
) -> unit {
    var item: *ScheduledWork = &schedule.state -> work[id as usize];
    if item -> state != WORK_IDLE {
        trap;
    }
    item -> execute = execute;
    item -> payload = payload;
}
fn schedule_enqueue(state: *ScheduleState, id: u32) -> unit {
    var item: *ScheduledWork = &state -> work[id as usize];
    item -> state = WORK_READY;
    item -> next_ready = TASK_NONE;
    if state -> last == TASK_NONE {
        state -> first = id;
    } else {
        state -> work[state -> last as usize].next_ready = id;
    }
    state -> last = id;
}
// Requests a cached operation. Repeated requests share its completion.
fn schedule_request(schedule: read TaskSchedule, id: u32) -> unit {
    schedule.state -> work[id as usize].demanded = true;
    schedule.state -> work[id as usize].priority = 0u32;
    if schedule.state -> work[id as usize].state == WORK_IDLE {
        schedule_enqueue(schedule.state, id);
    }
}
// Requires retirement of the node and all consumers of its previous result.
fn schedule_reset(schedule: read TaskSchedule, id: u32) -> unit {
    var item: *ScheduledWork = &schedule.state -> work[id as usize];
    if item -> state == WORK_READY || item -> state == WORK_RUNNING || item -> state == WORK_WAITING || item -> first_waiter != TASK_NONE {
        trap;
    }
    item -> state = WORK_IDLE;
    item -> dependency = TASK_NONE;
    item -> suspensions = 0u32;
    item -> times = make TaskRunTimes {
        start: 0u64,
        finish: 0u64
    };
}
fn schedule_execute(data: *u8) -> bool {
    var item: *ScheduledWork = data as *ScheduledWork;
    item -> result = item -> execute(item -> payload);
    return true;
}
fn schedule_finish(state: *ScheduleState, id: u32, success: bool) -> unit {
    var item: *ScheduledWork = &state -> work[id as usize];
    item -> state = WORK_FAILED;
    if success {
        item -> state = WORK_DONE;
    }
    var next: u32 = item -> first_waiter;
    item -> first_waiter = TASK_NONE;
    while next != TASK_NONE {
        var waiter: u32 = next;
        next = state -> work[waiter as usize].next_waiter;
        state -> work[waiter as usize].next_waiter = TASK_NONE;
        if success {
            schedule_enqueue(state, waiter);
        } else {
            schedule_finish(state, waiter, false);
        }
    }
}
fn schedule_suspend(schedule: read TaskSchedule, id: u32, dependency: u32) -> unit {
    var state: *ScheduleState = schedule.state;
    var cursor: u32 = dependency;
    while cursor != TASK_NONE {
        if cursor == id {
            trap;
        }
        var node: *ScheduledWork = &state -> work[cursor as usize];
        if node -> state != WORK_WAITING {
            break;
        }
        cursor = node -> dependency;
    }
    var item: *ScheduledWork = &state -> work[id as usize];
    var source: *ScheduledWork = &state -> work[dependency as usize];
    source -> demanded = true;
    if source -> state == WORK_IDLE || item -> priority < source -> priority {
        source -> priority = item -> priority;
    }
    if source -> state == WORK_DONE {
        schedule_enqueue(state, id);
        return;
    }
    if source -> state == WORK_FAILED {
        schedule_finish(state, id, false);
        return;
    }
    item -> suspensions = item -> suspensions + 1u32;
    item -> state = WORK_WAITING;
    item -> dependency = dependency;
    item -> next_waiter = source -> first_waiter;
    source -> first_waiter = id;
    if source -> state == WORK_IDLE {
        schedule_enqueue(state, dependency);
    }
}
fn schedule_collect(schedule: read TaskSchedule, id: u32) -> unit {
    var state: *ScheduleState = schedule.state;
    var item: *ScheduledWork = &state -> work[id as usize];
    if item -> state != WORK_RUNNING {
        return;
    }
    var status: i32 = pool_status(state -> pool.state, item -> job, item -> generation);
    if status == 0i32 {
        return;
    }
    var times: TaskRunTimes = pool_times(state -> pool.state, item -> job);
    if item -> times.start == 0u64 {
        item -> times.start = times.start;
    }
    item -> times.finish = times.finish;
    pool_release(state -> pool.state, item -> job, item -> generation);
    item -> job = TASK_NONE;
    state -> running = state -> running - 1u32;
    if item -> background {
        state -> background_running = state -> background_running - 1u32;
    }
    if status < 0i32 || !item -> result.success {
        schedule_finish(state, id, false);
    } else if item -> result.dependency == TASK_NONE {
        schedule_finish(state, id, true);
    } else {
        schedule_suspend(read schedule, id, item -> result.dependency);
    }
}
// Advances scheduled work without waiting for completion.
fn schedule_poll(schedule: read TaskSchedule) -> unit {
    var state: *ScheduleState = schedule.state;
    var i: u32 = 0u32;
    while i < state -> count {
        schedule_collect(read schedule, i);
        i = i + 1u32;
    }
    var width: u32 = pool_width(state -> pool.state);
    if width == 0u32 {
        width = 1u32;
    }
    while state -> first != TASK_NONE && state -> running < width {
        var id: u32 = schedule_take(state);
        if id == TASK_NONE {
            break;
        }
        var item: *ScheduledWork = &state -> work[id as usize];
        item -> background = item -> priority != 0u32;
        item -> state = WORK_RUNNING;
        item -> job = pool_admit(state -> pool.state, schedule_execute, item as *u8);
        if item -> job == TASK_NONE {
            schedule_finish(state, id, false);
        } else {
            state -> running = state -> running + 1u32;
            if item -> background {
                state -> background_running = state -> background_running + 1u32;
            }
            item -> generation = pool_generation(state -> pool.state, item -> job);
        }
    }
}
fn schedule_status(schedule: read TaskSchedule, id: u32) -> i32 {
    var state: u32 = schedule.state -> work[id as usize].state;
    if state == WORK_DONE {
        return 1i32;
    }
    if state == WORK_FAILED {
        return -1i32;
    }
    return 0i32;
}
fn schedule_idle(schedule: read TaskSchedule) -> unit {
    pool_pause(schedule.state -> pool.state);
}
fn schedule_busy(schedule: read TaskSchedule) -> bool {
    if schedule.state == null(*ScheduleState) {
        return false;
    }
    var i: u32 = 0u32;
    while i < schedule.state -> count {
        var state: u32 = schedule.state -> work[i as usize].state;
        if state == WORK_READY || state == WORK_RUNNING || state == WORK_WAITING {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}
fn schedule_drop(schedule: mut TaskSchedule) -> unit {
    var state: *ScheduleState = schedule.state;
    if state == null(*ScheduleState) || !reference_release(&state -> references) {
        return;
    }
    while schedule_busy(read schedule) {
        schedule_poll(read schedule);
        schedule_idle(read schedule);
    }
    drop state -> pool;
    task_release(state -> work as *u8);
    task_release(state as *u8);
}
// Publishes an externally prepared result before any consumer is scheduled.
fn schedule_seed(schedule: read TaskSchedule, id: u32) -> unit {
    if schedule.state -> work[id as usize].state != WORK_IDLE {
        trap;
    }
    schedule_finish(schedule.state, id, true);
}
fn schedule_trace(schedule: read TaskSchedule, clock: fn() -> u64) -> unit {
    task_pool_trace(mut schedule.state -> pool, clock);
}
fn schedule_times(schedule: read TaskSchedule, id: u32) -> TaskRunTimes {
    return schedule.state -> work[id as usize].times;
}
fn schedule_wait_count(schedule: read TaskSchedule, id: u32) -> u32 {
    return schedule.state -> work[id as usize].suspensions;
}
fn schedule_take(state: *ScheduleState) -> u32 {
    var current: u32 = state -> first;
    var previous: u32 = TASK_NONE;
    var selected: u32 = current;
    var before: u32 = TASK_NONE;
    while current != TASK_NONE {
        if state -> work[current as usize].priority < state -> work[selected as usize].priority {
            selected = current;
            before = previous;
        }
        previous = current;
        current = state -> work[current as usize].next_ready;
    }
    var background_limit: u32 = pool_width(state -> pool.state);
    if background_limit > 1u32 {
        background_limit = background_limit - 1u32;
    } else {
        background_limit = 1u32;
    }
    if state -> work[selected as usize].priority != 0u32 && state -> background_running >= background_limit {
        return TASK_NONE;
    }
    var next: u32 = state -> work[selected as usize].next_ready;
    if before == TASK_NONE {
        state -> first = next;
    } else {
        state -> work[before as usize].next_ready = next;
    }
    if state -> last == selected {
        state -> last = before;
    }
    return selected;
}
fn schedule_background(schedule: read TaskSchedule, id: u32) -> unit {
    if schedule.state -> work[id as usize].state == WORK_IDLE {
        schedule.state -> work[id as usize].priority = 1u32;
        schedule_enqueue(schedule.state, id);
    }
}
fn schedule_requested(schedule: read TaskSchedule, id: u32) -> bool {
    return schedule.state -> work[id as usize].state != WORK_IDLE;
}
fn schedule_demanded(schedule: read TaskSchedule, id: u32) -> bool {
    return schedule.state -> work[id as usize].demanded;
}
// Requires retirement of consumers whose demands are being replaced.
fn schedule_release_demand(schedule: read TaskSchedule, id: u32) -> unit {
    schedule.state -> work[id as usize].demanded = false;
}
