fn task_enqueue(graph: mut TaskGraph, id: u32) -> unit {
    graph.nodes[id as usize].next = TASK_NONE;
    if graph.ready_last == TASK_NONE {
        graph.ready_first = id;
    } else {
        graph.nodes[graph.ready_last as usize].next = id;
    }
    graph.ready_last = id;
    graph.nodes[id as usize].state = TASK_READY;
    task_trace_ready(mut graph, id);
}
fn task_dequeue(graph: mut TaskGraph) -> u32 {
    var id: u32 = graph.ready_first;
    if id != TASK_NONE {
        graph.ready_first = graph.nodes[id as usize].next;
        if graph.ready_first == TASK_NONE {
            graph.ready_last = TASK_NONE;
        }
    }
    return id;
}
fn task_rewind(graph: mut TaskGraph) -> unit {
    task_trace_reset(mut graph);
    graph.ready_first = TASK_NONE;
    graph.ready_last = TASK_NONE;
    var i: u32 = 0u32;
    while i < graph.count {
        var node: *TaskNode = &graph.nodes[i as usize];
        node -> remaining = node -> dependencies;
        node -> state = TASK_WAITING;
        node -> returned = false;
        node -> delivered = false;
        if node -> remaining == 0u32 {
            task_enqueue(mut graph, i);
        }
        i = i + 1u32;
    }
}
fn task_release_successors(graph: mut TaskGraph, id: u32) -> unit {
    var edge: u32 = graph.nodes[id as usize].first;
    while edge != TASK_NONE {
        var target: u32 = graph.edges[edge as usize].target;
        var node: *TaskNode = &graph.nodes[target as usize];
        node -> remaining = node -> remaining - 1u32;
        if node -> remaining == 0u32 {
            task_enqueue(mut graph, target);
        }
        edge = graph.edges[edge as usize].next;
    }
}
fn task_graph_seal(graph: mut TaskGraph) -> bool {
    if graph.sealed || graph.count == 0u32 {
        return task_error("task graph seal requires an allocated, unsealed graph");
    }
    task_rewind(mut graph);
    var visited: u32 = 0u32;
    var id: u32 = task_dequeue(mut graph);
    while id != TASK_NONE {
        visited = visited + 1u32;
        task_release_successors(mut graph, id);
        id = task_dequeue(mut graph);
    }
    if visited != graph.count {
        return task_error("task graph contains a dependency cycle");
    }
    graph.sealed = true;
    return true;
}
// Requires a sealed, drained graph. Reuses its admitted node and edge storage.
fn task_graph_start(graph: mut TaskGraph) -> unit {
    if !graph.sealed || graph.active != 0u32 {
        trap;
    }
    task_rewind(mut graph);
    graph.active = graph.count;
    graph.failed = false;
}
// Returns a ready node or TASK_NONE. The caller executes it on the serial lane.
fn task_next(graph: mut TaskGraph) -> u32 {
    var id: u32 = task_dequeue(mut graph);
    if id != TASK_NONE {
        graph.nodes[id as usize].state = TASK_RUNNING;
        task_trace_start(mut graph, id);
    }
    return id;
}
fn task_cancel(graph: mut TaskGraph) -> unit {
    graph.failed = true;
    graph.ready_first = TASK_NONE;
    graph.ready_last = TASK_NONE;
    var i: u32 = 0u32;
    while i < graph.count {
        var node: *TaskNode = &graph.nodes[i as usize];
        if node -> state == TASK_WAITING || node -> state == TASK_READY {
            node -> state = TASK_CANCELLED;
            task_trace_finish(mut graph, i);
            graph.active = graph.active - 1u32;
        }
        i = i + 1u32;
    }
}
fn task_finish(graph: mut TaskGraph, id: u32, success: bool) -> unit {
    var node: *TaskNode = &graph.nodes[id as usize];
    if node -> state != TASK_RUNNING {
        trap;
    }
    node -> state = TASK_FAILED;
    task_trace_finish(mut graph, id);
    if success {
        node -> state = TASK_SUCCEEDED;
    }
    graph.active = graph.active - 1u32;
    if !success {
        task_cancel(mut graph);
    } else {
        if !graph.failed {
            task_release_successors(mut graph, id);
        }
    }
}
fn task_complete(graph: mut TaskGraph, id: u32, success: bool) -> unit {
    if graph.nodes[id as usize].external {
        trap;
    }
    task_finish(mut graph, id, success);
}
fn task_external_publish(graph: mut TaskGraph, id: u32) -> unit {
    var node: *TaskNode = &graph.nodes[id as usize];
    if node -> returned && node -> delivered {
        task_finish(mut graph, id, node -> result);
    }
}
// Completes the submission obligation. Rejection guarantees that no callback remains.
fn task_submission_returned(graph: mut TaskGraph, id: u32, accepted: bool) -> unit {
    var node: *TaskNode = &graph.nodes[id as usize];
    if !node -> external || node -> state != TASK_RUNNING || node -> returned {
        trap;
    }
    node -> returned = true;
    task_trace_submission(mut graph, id);
    if !accepted {
        if node -> delivered {
            trap;
        }
        node -> delivered = true;
        node -> result = false;
    }
    task_external_publish(mut graph, id);
}
// Publishes one result. Delivery can precede submission return.
fn task_external_complete(graph: mut TaskGraph, id: u32, success: bool) -> unit {
    var node: *TaskNode = &graph.nodes[id as usize];
    if !node -> external || node -> state != TASK_RUNNING || node -> delivered {
        trap;
    }
    node -> delivered = true;
    node -> result = success;
    task_external_publish(mut graph, id);
}
fn task_drained(graph: read TaskGraph) -> bool {
    return graph.active == 0u32;
}
fn task_succeeded(graph: read TaskGraph) -> bool {
    return graph.active == 0u32 && !graph.failed;
}

fn task_pending(graph: read TaskGraph, id: u32) -> bool {
    return graph.nodes[id as usize].state == TASK_RUNNING;
}
fn task_has_error(graph: read TaskGraph) -> bool {
    return graph.failed;
}
