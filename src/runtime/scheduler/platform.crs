extern fn scheduler_stop_load(flag: *i32) -> i32 = "SDL_GetAtomicInt";
extern fn scheduler_stop_store(flag: *i32, value: i32) -> i32 = "SDL_SetAtomicInt";
extern fn scheduler_tls_get(id: *i32) -> *u8 = "SDL_GetTLS";
extern fn scheduler_tls_set(id: *i32, value: *u8, destroy: fn(*u8) -> unit) -> bool = "SDL_SetTLS";
extern fn scheduler_thread_id() -> u64 = "SDL_GetCurrentThreadID";
extern fn scheduler_condition_new() -> *u8 = "SDL_CreateCondition";
extern fn scheduler_condition_drop(condition: *u8) -> unit = "SDL_DestroyCondition";
extern fn scheduler_condition_wait(condition: *u8, mutex: *u8) -> unit = "SDL_WaitCondition";
extern fn scheduler_condition_wake(condition: *u8) -> unit = "SDL_BroadcastCondition";
extern fn scheduler_cpu_count() -> i32 = "SDL_GetNumLogicalCPUCores";
extern fn scheduler_abort() -> unit = "abort";
extern fn scheduler_flush(stream: *u8) -> i32 = "fflush";
fn scheduler_panic(message: *u8) -> unit {
    service_print(message);
    scheduler_flush(null(*u8));
    scheduler_abort();
    trap;
}
fn scheduler_worker_on(runtime: *SchedulerRuntime) -> *SchedulerWorker {
    return scheduler_tls_get(&runtime -> tls) as *SchedulerWorker;
}
fn scheduler_require_caller(runtime: *SchedulerRuntime) -> unit {
    if scheduler_worker_on(runtime) != null(*SchedulerWorker) {
        scheduler_panic("scheduler blocking operation on worker");
    }
}
extern fn scheduler_condition_timed(condition: *u8, mutex: *u8, ms: i32) -> bool = "SDL_WaitConditionTimeout";
fn scheduler_condition_pause(condition: *u8, mutex: *u8) -> unit {
    scheduler_condition_timed(condition, mutex, 1i32);
}

fn scheduler_thread(data: *u8) -> i32 {
    var worker: *SchedulerWorker = data as *SchedulerWorker;
    var runtime: *SchedulerRuntime = worker -> runtime;
    if !scheduler_tls_set(&runtime -> tls, data, null(fn(*u8) -> unit)) {
        scheduler_panic("scheduler TLS failed");
    }
    while true {
        var node: *SchedulerNode = scheduler_find(worker);
        if node != null(*SchedulerNode) {
            scheduler_run(node);
        } else {
            if scheduler_stop_load(&runtime -> stopping) != 0i32 {
                return 0i32;
            }
            service_wait(runtime -> wake);
        }
    }
}

fn scheduler_start(runtime: *SchedulerRuntime) -> bool {
    var i: u32 = 0u32;
    while i < runtime -> width {
        runtime -> workers[i as usize] = make SchedulerWorker {
            runtime: runtime,
            queue: scheduler_deque_new(),
            thread: null(*u8),
            index: i,
            turns: 0u32
        };
        if runtime -> workers[i as usize].queue.mutex == null(*u8) {
            return false;
        }
        i = i + 1u32;
    }
    while runtime -> started < runtime -> width {
        var worker: *SchedulerWorker = &runtime -> workers[runtime -> started as usize];
        worker -> thread = service_thread_create(scheduler_thread, "scheduler", worker as *u8);
        if worker -> thread == null(*u8) {
            return false;
        }
        runtime -> started = runtime -> started + 1u32;
    }
    return true;
}

fn scheduler_stop_workers(runtime: *SchedulerRuntime) -> unit {
    var i: u32 = 0u32;
    while i < runtime -> started {
        service_post(runtime -> wake);
        i = i + 1u32;
    }
    i = 0u32;
    while i < runtime -> started {
        service_thread_join(runtime -> workers[i as usize].thread, null(*i32));
        i = i + 1u32;
    }
    runtime -> started = 0u32;
}
fn scheduler_signal(runtime: *SchedulerRuntime) -> unit {
    service_post(runtime -> wake);
}

fn scheduler_worker_limit() -> u32 {
    return 0xffffffffu32;
}
