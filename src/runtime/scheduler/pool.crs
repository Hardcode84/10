fn scheduler_new() -> Scheduler {
    return make Scheduler {
        runtime: null(*SchedulerRuntime)
    };
}
fn scheduler_open(scheduler: mut Scheduler, workers: u32) -> bool {
    if workers == 0u32 {
        return false;
    }
    return scheduler_open_capacity(mut scheduler, workers, 4194304usize);
}
fn scheduler_open_auto(scheduler: mut Scheduler) -> bool {
    var count: i32 = scheduler_cpu_count();
    if count < 1i32 {
        count = 1i32;
    }
    var width: u32 = count as u32;
    if width > scheduler_worker_limit() {
        width = scheduler_worker_limit();
    }
    return scheduler_open(mut scheduler, width);
}
fn scheduler_open_capacity(scheduler: mut Scheduler, workers: u32, bytes: usize) -> bool {
    if scheduler.runtime != null(*SchedulerRuntime) {
        scheduler_panic("scheduler_open requires empty owner");
    }
    if workers == 0u32 || workers as u64 * sizeof(SchedulerWorker) as u64 > (~0usize) as u64 {
        return false;
    }
    service_sdl_error();
    var runtime: *SchedulerRuntime = service_allocate(1usize, sizeof(SchedulerRuntime)) as *SchedulerRuntime;
    if runtime == null(*SchedulerRuntime) {
        return false;
    }
    runtime -> references = 1i32;
    runtime -> gate = service_mutex_create();
    runtime -> memory = service_mutex_create();
    runtime -> wake = service_sem_create(0u32);
    runtime -> changed = scheduler_condition_new();
    runtime -> injection = scheduler_deque_new();
    runtime -> width = workers;
    runtime -> workers = service_allocate(workers as usize, sizeof(SchedulerWorker)) as *SchedulerWorker;
    scheduler.runtime = runtime;
    if !scheduler_storage_ready(runtime) {
        scheduler_drop(mut scheduler);
        scheduler.runtime = null(*SchedulerRuntime);
        return false;
    }
    if !scheduler_reserve(read scheduler, bytes) || !scheduler_start(runtime) {
        scheduler_drop(mut scheduler);
        scheduler.runtime = null(*SchedulerRuntime);
        return false;
    }
    return true;
}
fn scheduler_storage_ready(runtime: *SchedulerRuntime) -> bool {
    return runtime -> gate != null(*u8) && runtime -> memory != null(*u8) && runtime -> wake != null(
        *u8
    ) && runtime -> changed != null(*u8) && runtime -> injection.mutex != null(*u8) && runtime -> workers != null(
        *SchedulerWorker
    );
}
fn scheduler_drop(scheduler: mut Scheduler) -> unit {
    var runtime: *SchedulerRuntime = scheduler.runtime;
    if runtime == null(*SchedulerRuntime) {
        return;
    }
    scheduler_require_caller(runtime);
    if runtime -> scopes != 0u32 {
        scheduler_panic("scheduler dropped with live scopes");
    }
    scheduler_shutdown(mut scheduler);
    scheduler_pool_storage_drop(runtime);
    scheduler_runtime_release(runtime);
}
// Closes root admission, drains accepted work and its children, then joins workers.
// Requires a non-worker caller. External completions must still be serviced.
// Resources and completed task results remain valid until their owners drop them.
fn scheduler_shutdown(scheduler: mut Scheduler) -> unit {
    var runtime: *SchedulerRuntime = scheduler.runtime;
    if runtime == null(*SchedulerRuntime) || scheduler_stop_load(&runtime -> stopping) != 0i32 {
        return;
    }
    scheduler_require_caller(runtime);
    if runtime -> gate != null(*u8) {
        service_lock(runtime -> gate);
        runtime -> closing = true;
        scheduler_condition_wake(runtime -> changed);
        while runtime -> outstanding != 0u64 {
            scheduler_condition_wait(runtime -> changed, runtime -> gate);
        }
    }
    scheduler_stop_store(&runtime -> stopping, 1i32);
    if runtime -> gate != null(*u8) {
        service_unlock(runtime -> gate);
    }
    scheduler_stop_workers(runtime);
}
fn scheduler_pool_storage_drop(runtime: *SchedulerRuntime) -> unit {
    if runtime -> workers != null(*SchedulerWorker) {
        var i: u32 = 0u32;
        while i < runtime -> width {
            if runtime -> workers[i as usize].queue.mutex != null(*u8) {
                service_mutex_destroy(runtime -> workers[i as usize].queue.mutex);
            }
            i = i + 1u32;
        }
        service_free(runtime -> workers as *u8);
    }
    if runtime -> injection.mutex != null(*u8) {
        service_mutex_destroy(runtime -> injection.mutex);
    }
    if runtime -> wake != null(*u8) {
        service_sem_destroy(runtime -> wake);
    }
}
