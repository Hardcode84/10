extern fn service_allocate(count: usize, bytes: usize) -> *u8 = "calloc";
extern fn service_free(pointer: *u8) -> unit = "free";
extern fn service_mutex_create() -> *u8 = "SDL_CreateMutex";
extern fn service_mutex_destroy(mutex: *u8) -> unit = "SDL_DestroyMutex";
extern fn service_lock(mutex: *u8) -> unit = "SDL_LockMutex";
extern fn service_unlock(mutex: *u8) -> unit = "SDL_UnlockMutex";
extern fn service_sem_create(count: u32) -> *u8 = "SDL_CreateSemaphore";
extern fn service_sem_destroy(sem: *u8) -> unit = "SDL_DestroySemaphore";
extern fn service_post(sem: *u8) -> unit = "SDL_SignalSemaphore";
extern fn service_wait(sem: *u8) -> unit = "SDL_WaitSemaphore";
extern fn service_try_wait(sem: *u8) -> bool = "SDL_TryWaitSemaphore";
extern fn service_timed_wait(sem: *u8, timeout: i32) -> bool = "SDL_WaitSemaphoreTimeout";
extern fn service_thread_native(
    entry: fn(*u8) -> i32,
    name: *u8,
    data: *u8,
    begin: *u8,
    end: *u8
) -> *u8 = "SDL_CreateThreadRuntime";
fn service_thread_create(entry: fn(*u8) -> i32, name: *u8, data: *u8) -> *u8 {
    return service_thread_native(entry, name, data, null(*u8), null(*u8));
}
extern fn service_thread_join(thread: *u8, result: *i32) -> unit = "SDL_WaitThread";
extern fn service_sdl_error() -> *u8 = "SDL_GetError";
extern fn service_print(message: *u8) -> i32 = "puts";
