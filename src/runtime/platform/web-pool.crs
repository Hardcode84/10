const TASK_DEFAULT_WORKERS: u32 = 0u32;
record PoolEntry {
    generation: u64;
    next: u32;
    status: i32;
    times: TaskRunTimes;
}
record PoolState {
    references: i32;
    entries: *PoolEntry;
    capacity: u32;
    free: u32;
    live: u32;
    clock: fn() -> u64;
}
opaque;
fn pool_open(workers: u32, capacity: u32) -> *PoolState {
    if workers != 0u32 {
        task_error("this browser build requires --workers 0");
        return null(*PoolState);
    }
    if capacity == 0u32 || capacity == TASK_NONE || capacity as u64 * sizeof(PoolEntry) as u64 > (
        ~0usize
    ) as u64 {
        task_error("invalid task pool allocation");
        return null(*PoolState);
    }
    var pool: *PoolState = task_allocate(sizeof(PoolState)) as *PoolState;
    if pool == null(*PoolState) {
        task_error("task pool allocation failed");
        return pool;
    }
    pool -> entries = task_allocate(capacity as usize * sizeof(PoolEntry)) as *PoolEntry;
    if pool -> entries == null(*PoolEntry) {
        task_release(pool as *u8);
        task_error("task pool allocation failed");
        return null(*PoolState);
    }
    pool -> references = 1i32;
    pool -> capacity = capacity;
    pool -> free = 0u32;
    pool -> live = 0u32;
    pool -> clock = task_no_clock;
    var i: u32 = 0u32;
    while i < capacity {
        pool -> entries[i as usize] = make PoolEntry {
            generation: 0u64,
            next: i + 1u32,
            status: 0i32,
            times: make TaskRunTimes {
                start: 0u64,
                finish: 0u64
            }
        };
        i = i + 1u32;
    }
    pool -> entries[(capacity - 1u32) as usize].next = TASK_NONE;
    return pool;
}
fn pool_close(pool: *PoolState) -> unit {
    if pool == null(*PoolState) {
        return;
    }
    if !reference_release(&pool -> references) {
        return;
    }
    if pool -> live != 0u32 {
        trap;
    }
    task_release(pool -> entries as *u8);
    task_release(pool as *u8);
}
fn pool_admit(pool: *PoolState, execute: fn(*u8) -> bool, payload: *u8) -> u32 {
    var id: u32 = pool -> free;
    if id == TASK_NONE {
        task_error("task pool admission capacity exhausted");
        return id;
    }
    var entry: *PoolEntry = &pool -> entries[id as usize];
    pool -> free = entry -> next;
    pool -> live = pool -> live + 1u32;
    entry -> generation = entry -> generation + 1u64;
    if entry -> generation == 0u64 {
        trap;
    }
    entry -> status = -1i32;
    entry -> times.start = pool -> clock();
    if execute(payload) {
        entry -> status = 1i32;
    }
    entry -> times.finish = pool -> clock();
    return id;
}
fn pool_generation(pool: *PoolState, id: u32) -> u64 {
    return pool -> entries[id as usize].generation;
}
fn pool_set_clock(pool: *PoolState, clock: fn() -> u64) -> unit {
    if pool -> live != 0u32 {
        trap;
    }
    pool -> clock = clock;
}
fn pool_times(pool: *PoolState, id: u32) -> TaskRunTimes {
    return pool -> entries[id as usize].times;
}
fn pool_status(pool: *PoolState, id: u32, generation: u64) -> i32 {
    if pool -> entries[id as usize].generation != generation {
        trap;
    }
    return pool -> entries[id as usize].status;
}
fn pool_pause(pool: *PoolState) -> unit {}
fn pool_release(pool: *PoolState, id: u32, generation: u64) -> unit {
    if pool -> entries[id as usize].generation != generation {
        trap;
    }
    pool -> entries[id as usize].next = pool -> free;
    pool -> free = id;
    pool -> live = pool -> live - 1u32;
}
fn pool_width(pool: *PoolState) -> u32 {
    return 0u32;
}
