const TASK_DEFAULT_WORKERS: u32 = 0u32;
record PoolEntry {
    execute: fn(*u8) -> bool;
    payload: *u8;
    generation: u64;
    next: u32;
    status: i32;
    times: TaskRunTimes;
}
opaque;
record PoolState {
    mutex: *u8;
    wake: *u8;
    complete: *u8;
    threads: **u8;
    entries: *PoolEntry;
    workers: u32;
    capacity: u32;
    first: u32;
    last: u32;
    free: u32;
    live: u32;
    stop: bool;
    clock: fn() -> u64;
}
opaque;
fn pool_execute(pool: *PoolState, id: u32) -> unit {
    var entry: *PoolEntry = &pool -> entries[id as usize];
    entry -> times.start = pool -> clock();
    var success: bool = entry -> execute(entry -> payload);
    entry -> times.finish = pool -> clock();
    service_require(service_lock(pool -> mutex));
    entry -> status = -1i32;
    if success {
        entry -> status = 1i32;
    }
    service_require(service_post(pool -> complete));
    service_require(service_unlock(pool -> mutex));
}
fn pool_worker(data: *u8) -> i32 {
    var pool: *PoolState = data as *PoolState;
    while true {
        service_require(service_wait(pool -> wake));
        service_require(service_lock(pool -> mutex));
        var id: u32 = pool -> first;
        if id == TASK_NONE {
            var stop: bool = pool -> stop;
            service_require(service_unlock(pool -> mutex));
            if stop {
                return 0i32;
            }
            trap;
        }
        pool -> first = pool -> entries[id as usize].next;
        if pool -> first == TASK_NONE {
            pool -> last = TASK_NONE;
        }
        service_require(service_unlock(pool -> mutex));
        pool_execute(pool, id);
    }
}
fn pool_open(workers: u32, capacity: u32) -> *PoolState {
    // Initialize the SDL thread-local key before concurrent thread creation and exit.
    service_sdl_error();
    if capacity == 0u32 || capacity == TASK_NONE || capacity as u64 * sizeof(PoolEntry) as u64 > (
        ~0usize
    ) as u64 || workers as u64 * sizeof(*u8) as u64 > (~0usize) as u64 {
        task_error("invalid worker pool allocation");
        return null(*PoolState);
    }
    var pool: *PoolState = service_allocate(1usize, sizeof(PoolState)) as *PoolState;
    if pool == null(*PoolState) {
        task_error("worker pool allocation failed");
        return pool;
    }
    pool -> first = TASK_NONE;
    pool -> last = TASK_NONE;
    pool -> capacity = capacity;
    pool -> clock = task_no_clock;
    pool -> mutex = service_mutex_create();
    pool -> wake = service_sem_create(0u32);
    pool -> complete = service_sem_create(0u32);
    pool -> entries = service_allocate(capacity as usize, sizeof(PoolEntry)) as *PoolEntry;
    pool -> threads = service_allocate(workers as usize + 1usize, sizeof(*u8)) as **u8;
    if !pool_storage_ready(pool) {
        pool_close(pool);
        return null(*PoolState);
    }
    var i: u32 = 0u32;
    while i < capacity {
        pool -> entries[i as usize].next = i + 1u32;
        i = i + 1u32;
    }
    pool -> entries[(capacity - 1u32) as usize].next = TASK_NONE;
    while pool -> workers < workers {
        var thread: *u8 = service_thread_create(pool_worker, "task worker", pool as *u8);
        if thread == null(*u8) {
            task_error(service_sdl_error());
            pool_close(pool);
            return null(*PoolState);
        }
        pool -> threads[pool -> workers as usize] = thread;
        pool -> workers = pool -> workers + 1u32;
    }
    return pool;
}
fn pool_storage_ready(pool: *PoolState) -> bool {
    if pool -> mutex == null(*u8) || pool -> wake == null(*u8) || pool -> complete == null(*u8) {
        return task_error(service_sdl_error());
    }
    if pool -> entries == null(*PoolEntry) || pool -> threads == null(**u8) {
        return task_error("worker pool allocation failed");
    }
    return true;
}
fn pool_close(pool: *PoolState) -> unit {
    if pool == null(*PoolState) {
        return;
    }
    if pool -> live != 0u32 {
        trap;
    }
    if pool -> workers != 0u32 {
        service_require(service_lock(pool -> mutex));
        pool -> stop = true;
        service_require(service_unlock(pool -> mutex));
        var i: u32 = 0u32;
        while i < pool -> workers {
            service_require(service_post(pool -> wake));
            i = i + 1u32;
        }
        i = 0u32;
        while i < pool -> workers {
            service_thread_join(pool -> threads[i as usize], null(*i32));
            i = i + 1u32;
        }
    }
    if pool -> mutex != null(*u8) {
        service_mutex_destroy(pool -> mutex);
    }
    if pool -> wake != null(*u8) {
        service_sem_destroy(pool -> wake);
    }
    if pool -> complete != null(*u8) {
        service_sem_destroy(pool -> complete);
    }
    service_free(pool -> entries as *u8);
    service_free(pool -> threads as *u8);
    service_free(pool as *u8);
}
fn pool_admit(pool: *PoolState, execute: fn(*u8) -> bool, payload: *u8) -> u32 {
    service_require(service_lock(pool -> mutex));
    var id: u32 = pool -> free;
    if id == TASK_NONE {
        service_require(service_unlock(pool -> mutex));
        task_error("worker pool admission capacity exhausted");
        return TASK_NONE;
    }
    var entry: *PoolEntry = &pool -> entries[id as usize];
    pool -> free = entry -> next;
    entry -> next = TASK_NONE;
    entry -> execute = execute;
    entry -> payload = payload;
    entry -> generation = entry -> generation + 1u64;
    if entry -> generation == 0u64 {
        trap;
    }
    entry -> status = 0i32;
    pool -> live = pool -> live + 1u32;
    if pool -> workers != 0u32 {
        if pool -> last == TASK_NONE {
            pool -> first = id;
        } else {
            pool -> entries[pool -> last as usize].next = id;
        }
        pool -> last = id;
        service_require(service_post(pool -> wake));
    }
    service_require(service_unlock(pool -> mutex));
    if pool -> workers == 0u32 {
        pool_execute(pool, id);
    }
    return id;
}
fn pool_generation(pool: *PoolState, id: u32) -> u64 {
    return pool -> entries[id as usize].generation;
}
fn pool_set_clock(pool: *PoolState, clock: fn() -> u64) -> unit {
    if pool -> live != 0u32 {
        trap;
    }
    pool -> clock = clock;
}
fn pool_times(pool: *PoolState, id: u32) -> TaskRunTimes {
    return pool -> entries[id as usize].times;
}
fn pool_status(pool: *PoolState, id: u32, generation: u64) -> i32 {
    service_require(service_lock(pool -> mutex));
    if pool -> entries[id as usize].generation != generation {
        trap;
    }
    var result: i32 = pool -> entries[id as usize].status;
    service_require(service_unlock(pool -> mutex));
    return result;
}
fn pool_pause(pool: *PoolState) -> unit {
    service_require(service_timed_wait(pool -> complete, 1u32));
}
fn pool_release(pool: *PoolState, id: u32, generation: u64) -> unit {
    service_require(service_lock(pool -> mutex));
    var entry: *PoolEntry = &pool -> entries[id as usize];
    if entry -> generation != generation || entry -> status == 0i32 {
        trap;
    }
    service_require(service_try_wait(pool -> complete));
    entry -> next = pool -> free;
    pool -> free = id;
    pool -> live = pool -> live - 1u32;
    service_require(service_unlock(pool -> mutex));
}
