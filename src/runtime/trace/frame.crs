record TaskSpan {
    ready: u64;
    start: u64;
    submission: u64;
    finish: u64;
}
// Requires a sealed, drained graph. Reserves one span per node before execution.
fn task_trace_enable(graph: mut TaskGraph, clock: fn() -> u64) -> bool {
    if !graph.sealed || graph.active != 0u32 || graph.spans != null(*TaskSpan) {
        trap;
    }
    if graph.count as u64 * sizeof(TaskSpan) as u64 > (~0usize) as u64 {
        return task_error("task trace exceeds address space");
    }
    graph.spans = task_allocate(graph.count as usize * sizeof(TaskSpan)) as *TaskSpan;
    if graph.spans == null(*TaskSpan) {
        return task_error("task trace allocation failed");
    }
    graph.clock = clock;
    return true;
}
fn task_no_clock() -> u64 {
    return 0u64;
}
// Returns the last execution span. Starting the next graph replaces these spans.
fn task_span(graph: read TaskGraph, node: u32) -> TaskSpan {
    if graph.spans == null(*TaskSpan) || graph.active != 0u32 || node >= graph.count {
        trap;
    }
    return graph.spans[node as usize];
}
fn task_trace_ready(graph: mut TaskGraph, id: u32) -> unit {
    if graph.spans != null(*TaskSpan) {
        graph.spans[id as usize].ready = graph.clock();
    }
}
fn task_trace_start(graph: mut TaskGraph, id: u32) -> unit {
    if graph.spans != null(*TaskSpan) {
        graph.spans[id as usize].start = graph.clock();
    }
}
fn task_trace_submission(graph: mut TaskGraph, id: u32) -> unit {
    if graph.spans != null(*TaskSpan) {
        graph.spans[id as usize].submission = graph.clock();
    }
}
fn task_trace_finish(graph: mut TaskGraph, id: u32) -> unit {
    if graph.spans != null(*TaskSpan) {
        graph.spans[id as usize].finish = graph.clock();
    }
}
fn task_trace_reset(graph: mut TaskGraph) -> unit {
    if graph.spans == null(*TaskSpan) {
        return;
    }
    var i: u32 = 0u32;
    while i < graph.count {
        graph.spans[i as usize] = make TaskSpan {
            ready: 0u64,
            start: 0u64,
            submission: 0u64,
            finish: 0u64
        };
        i = i + 1u32;
    }
}
