host_source(run, "crust/stages/build/load.crs");
if !application_setup(run, "crust") {
    return 1i32;
};
host_source(run, "tools/build/setup.crs");
var backend: ApplicationBackend = uninit;
var stages: *StageSession = project_open(run, &backend);
if stages == null(*StageSession) {
    return 1i32;
};
if !project_render(run, stages, &backend) {
    return 1i32;
};

host_source(run, "tools/build/assets.crs");
host_source(run, "tools/build/game.crs");
host_source(run, "tools/build/demo-level.crs");
if run -> argc < 1i32 || run -> argv[0usize][0usize] == 45u8 {
    native_error(run -> context, "usage: crust demo.crs LEVEL.crs [game options]");
    return 2i32;
};
var recipe: *u8 = host_path(run, run -> argv[0usize]);
run -> argv = run -> argv + 1isize;
run -> argc = run -> argc - 1i32;
if !check_renderer(run) || !build_demo_level(run, backend.emit, recipe) || !build_render_shaders(
    run
) {
    return 1i32;
};
return launch_application(run, "build/spinward");
