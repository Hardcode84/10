// Square inter-tube utility gallery. ENTRY and EXIT mate with conduit breaches.
// Cables follow wall and corner lanes between seeded pairs of wall sockets.
// Two cables cross the interior. Rounded routes keep clearance from each other.
// powered enables blue full-bright strips on the blue cable family.
// utility-seed changes endpoint positions, pairings, cable sizes and finishes.
// The viewer waypoint overlay shows candidate lanes and selected routes.
fn room_parameter_count() -> u32 {
    return prefab_conduit_gallery_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_conduit_gallery_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_conduit_gallery_parameter_name(index);
}
fn room_material_count() -> u32 {
    return CONDUIT_MATERIAL_COUNT;
}
fn room_material(region: u32, values: read AssetValues) -> PanelMaterial {
    return prefab_conduit_gallery_material(region, read values);
}
fn room_build(values: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_conduit_gallery_build(read values, mut asset);
}
