// Convex OCT-8M corner room. ENTRY faces -Y; EAST faces +X; +Z is up.
// Four 0.7 m service pipes follow rounded 90-degree bends between the mouths.
// Their end positions and four permitted mating rolls match the straight section.
// Leg is the distance from the axis intersection to either mouth, in metres.
// Bend-radius is the centreline radius of each pipe bend. The inner pipe needs
// a positive straight lead at both mouths. Region 0 is wall, 1 pipe, 2 bracket.
fn room_parameter_count() -> u32 {
    return prefab_oct_elbow_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_oct_elbow_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_oct_elbow_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_oct_elbow_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_oct_elbow_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_oct_elbow_material(region, read parameters);
}
