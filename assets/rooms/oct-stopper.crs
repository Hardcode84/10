// OCT-8M stopper, 0.5 m deep along +Y. ENTRY has four mating rolls.
// The solid far cap has four fixed triangular plates at the pipe positions.
// Four door leaves meet at an X joint. Each leaf has four red full-bright LEDs
// near the centre. The LEDs do not emit light. The door is closed and static.
// +Z is up. This room has no player spawn; its centre pose is for inspection.
// Regions: 0 sleeve and entry closure, 1 door. Depth is in metres.
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("depth");
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 0.1f32,
        maximum: 2f32,
        initial: 0.5f32,
        step: 0.1f32
    };
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var depth: f32 = asset_value(read parameters, 0u32);
    var profile: ConnectionProfile = service_oct_profile();
    asset.spawn_enabled = false;
    if !passage_shape(depth, false, profile, mut asset) {
        return false;
    }
    var tile: f32 = room_material(1u32).tile_metres;
    asset_surface_set(
        mut asset.hull,
        profile.shape.sides + 1u32,
        make SurfaceFrame {
            origin: vec(-tile * 0.5f32, depth, -tile * 0.5f32),
            right: vec(asset.tile_metres / tile, 0f32, 0f32),
            up: vec(0f32, 0f32, asset.tile_metres / tile),
            normal: vec(0f32, 1f32, 0f32)
        }
    );
    return room_asset_finish(mut asset);
}
fn room_material_count() -> u32 {
    return 2u32;
}
fn room_material(region: u32) -> PanelMaterial {
    var material: PanelMaterial = oct_service_material(0u32);
    if region == 1u32 {
        material.finish = METAL_OCT_DOOR;
        material.tile_metres = service_oct_profile().radius * 2f32;
        material.panel_height = material.tile_metres;
        material.colour = 0x949ba4u32;
        material.emission = 0x0000ffu32;
    }
    return material;
}
