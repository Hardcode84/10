// OCT-8M stopper with 0.4 m from ENTRY to the door. ENTRY has four mating rolls.
// The 0.2 m door slab extends behind the far collision wall. Local +Y is depth.
// The solid far cap has four fixed triangular plates at the pipe positions.
// Four solid 0.7 m pipes run from ENTRY to these plates, aligned with the tunnel.
// Pipe ends project 0.05 m through the back of the plates.
// Four door leaves meet at a + joint. Each leaf has one red full-bright LED
// near the centre. The LEDs do not emit light. The door is closed and static.
// +Z is up. This room has no player spawn; its centre pose is for inspection.
// Regions: 0 sleeve and entry closure, 1 door, 2 pipes, 3 black door rim.
// Depth is the portal-to-door clearance in metres.
fn room_parameter_count() -> u32 {
    return prefab_oct_stopper_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_oct_stopper_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_oct_stopper_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_oct_stopper_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_oct_stopper_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_oct_stopper_material(region, read parameters);
}
