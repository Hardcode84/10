// Open HEX-6M stopper, 1 m deep along +Y. ENTRY and EXIT have six mating rolls.
// Two sliding leaves meet on the jagged seam and have green full-bright LEDs.
// Prediction opens them during play. The viewer shows their closed pose.
// The default leaves 0.4 m from each portal to the door seat. Local +Z is up.
// This room has no player spawn; its inspection pose is in front of the leaves.
// Regions: 0 sleeve and preview closures, 1 black seat and rims, 2 leaf faces.
// Depth is in metres.
fn room_parameter_count() -> u32 {
    return prefab_hex_stopper_open_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_hex_stopper_open_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_hex_stopper_open_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_hex_stopper_open_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_hex_stopper_open_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_hex_stopper_open_material(region, read parameters);
}
