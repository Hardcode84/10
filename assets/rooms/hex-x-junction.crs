// HEX-6M cross: ENTRY -Y, EAST +X, EXIT +Y, WEST -X. Local +Z is up.
// A convex faceted shell joins all four full-width openings. Collar separates
// adjacent mouths without changing their 6 m profile or six mating rolls.
fn room_parameter_count() -> u32 {
    return prefab_hex_x_junction_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_hex_x_junction_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_hex_x_junction_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_hex_x_junction_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_hex_x_junction_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_hex_x_junction_material(region, read parameters);
}
