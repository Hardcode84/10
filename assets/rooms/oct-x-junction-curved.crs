// OCT-8M cross with separate curved ceiling and floor pipes. Local +Z is up.
// Ceiling: south to east, north to west. Floor: east to north, west to south.
// All four mouths match the straight tunnel. Leg is centre-to-mouth distance.
// The central flight path is clear. Regions: 0 wall plates, 1 service pipes.
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 5f32,
        maximum: 12f32,
        initial: 5f32,
        step: 0.5f32
    };
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("leg");
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var leg: f32 = asset_value(read parameters, 0u32);
    var plan: JunctionPlan = junction_plan(15u32, service_oct_profile().radius, leg);
    if !oct_junction_shell(plan, mut asset) || !oct_junction_side_pipes(mut asset, plan) {
        return false;
    }
    var side: u32 = 0u32;
    while side < 4u32 {
        var height: f32 = oct_pipe_distance();
        if side % 2u32 == 1u32 {
            height = -height;
        }
        if !oct_junction_bent_pipe(
            mut asset,
            leg,
            side,
            vec(0f32, 0f32, height),
            junction_port(side, 0u32, leg).id
        ) {
            return false;
        }
        side = side + 1u32;
    }
    return room_asset_finish(mut asset);
}
fn room_material_count() -> u32 {
    return 2u32;
}
fn room_material(region: u32) -> PanelMaterial {
    return oct_service_material(region);
}
