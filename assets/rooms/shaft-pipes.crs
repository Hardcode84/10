// Fixed pipe shaft with the shared hull, spindle, BOTTOM and TOP SHAFT ports.
// Thick octagonal pipes connect the spindle to opposite walls at each station.
// Successive pairs alternate by a right angle, leaving four axial flight lanes.
// Dark collars mark the spindle and wall joints. Pipe bodies are solid metal.
// Smaller service pipes stay against the walls between the thick pipe stations.
// Height, diameter and core-diameter use the shared shaft dimensions, in metres.
// station-count sets the number of pairs. pipe-seed sets roll and service routes.
// Parameters must leave room between the stations for collars and service pipes.
// Materials: 0 wall, 1 port closures, 2 spindle, 3 thick pipes, 4 service pipes,
// 5 collars and flanges, 6 leak stains.
fn room_parameter_count() -> u32 {
    return prefab_shaft_pipes_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_shaft_pipes_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_shaft_pipes_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_shaft_pipes_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_shaft_pipes_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_shaft_pipes_material(region, read parameters);
}
