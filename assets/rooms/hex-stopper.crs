// HEX-6M stopper with 0.4 m from ENTRY to the door. ENTRY has six mating rolls.
// The 0.2 m door slab extends behind the far collision wall. Local +Y is depth.
// The far cap is a closed two-leaf metal door with two red full-bright LEDs.
// LEDs do not emit light. Local +Z is up. This room has no player spawn;
// its centre pose is for inspection. Use the exterior viewer to see the door.
// Regions: 0 sleeve and entry closure, 1 door, 2 black door rim.
// Depth is the portal-to-door clearance in metres.
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("depth");
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 0.1f32,
        maximum: 2f32,
        initial: 0.4f32,
        step: 0.1f32
    };
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var depth: f32 = asset_value(read parameters, 0u32);
    var profile: ConnectionProfile = service_hex_profile();
    asset.spawn_enabled = false;
    if !passage_shape(depth, false, profile, mut asset) {
        return false;
    }
    var tile: f32 = room_material(1u32).tile_metres;
    asset_surface_set(
        mut asset.hull,
        profile.shape.sides + 1u32,
        make SurfaceFrame {
            origin: vec(-tile * 0.5f32, depth, -tile * 0.5f32),
            right: vec(asset.tile_metres / tile, 0f32, 0f32),
            up: vec(0f32, 0f32, asset.tile_metres / tile),
            normal: vec(0f32, 1f32, 0f32)
        }
    );
    return room_asset_finish(mut asset) && stopper_door_back(mut asset, depth, profile, 2u32);
}
fn room_material_count() -> u32 {
    return 3u32;
}
fn room_material(region: u32) -> PanelMaterial {
    if region == 2u32 {
        return stopper_seat_material();
    }
    var material: PanelMaterial = hex_tunnel_material();
    if region == 1u32 {
        material.finish = METAL_DOOR;
        material.tile_metres = 6f32;
        material.panel_height = 6f32;
        material.colour = 0x949ba4u32;
        material.emission = 0x0000ffu32;
    }
    return material;
}
