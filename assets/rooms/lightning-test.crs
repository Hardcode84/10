// Repeating lightning flash. Run with --view start; change seed to select a bolt.
// --animation-tick freezes the bolt, contact sparks, and midpoint light together.
// The whole bolt appears at once, fades during half a cycle, then goes dark.
const LIGHTNING_TEST_PERIOD: u32 = 256u32;
// Lengths and width are in metres. cone-angle is the half-angle in degrees.
// Each segment aims through a new cone at the target. The final segment reaches
// the target exactly. The bolt is full-bright, has no collision, and casts no shadow.
fn room_parameter_count() -> u32 {
    return 6u32;
}
fn room_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("span");
    }
    if index == 1u32 {
        return asset_name("min-segment");
    }
    if index == 2u32 {
        return asset_name("max-segment");
    }
    if index == 3u32 {
        return asset_name("cone-angle");
    }
    if index == 4u32 {
        return asset_name("width");
    }
    return asset_name("seed");
}
fn room_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 4f32,
            maximum: 40f32,
            initial: 16f32,
            step: 1f32
        };
    }
    if index == 1u32 {
        return make AssetParameter {
            minimum: 0.1f32,
            maximum: 8f32,
            initial: 0.4f32,
            step: 0.1f32
        };
    }
    if index == 2u32 {
        return make AssetParameter {
            minimum: 0.1f32,
            maximum: 8f32,
            initial: 1.5f32,
            step: 0.1f32
        };
    }
    if index == 3u32 {
        return make AssetParameter {
            minimum: 0f32,
            maximum: 59f32,
            initial: 45f32,
            step: 1f32
        };
    }
    if index == 4u32 {
        return make AssetParameter {
            minimum: 0.01f32,
            maximum: 0.2f32,
            initial: 0.06f32,
            step: 0.01f32
        };
    }
    return make AssetParameter {
        minimum: 0f32,
        maximum: 1000000f32,
        initial: 1f32,
        step: 1f32
    };
}
fn room_build(values: read AssetValues, asset: mut RoomAsset) -> bool {
    var i: u32 = 0u32;
    while i < room_parameter_count() {
        if !asset_parameter_valid(room_parameter(i), asset_value(read values, i)) {
            return false;
        }
        i = i + 1u32;
    }
    var seed: f32 = asset_value(read values, 5u32);
    if seed != seed as u32 as f32 {
        return error("lightning seed must be an integer");
    }
    var span: f32 = asset_value(read values, 0u32);
    var profile: RegularProfile = make RegularProfile {
        sides: 4u32,
        phase: (0.25f32 * PI)
    };
    if !loft_allocate(mut asset.hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut asset.hull, profile, 0u32, -span, span * 3f32);
    loft_ring(mut asset.hull, profile, 1u32, span * 3f32, span * 3f32);
    i = 0u32;
    while i < asset_vertex_count(read asset.hull) {
        var p: Vec3 = asset_vertex(read asset.hull, i);
        p.z = p.z * 0.3f32;
        asset_vertex_set(mut asset.hull, i, p);
        i = i + 1u32;
    }
    loft_span(mut asset.hull, profile, 0u32, 0u32);
    loft_caps(mut asset.hull, profile, 2u32, 0u32, 0u32);
    asset.spawn.position = vec(0f32, span, -span * 0.4f32);
    asset.spawn.basis = identity_basis();
    asset.preview_ambient = vec(0.02f32, 0.02f32, 0.02f32);
    asset.preview_headlamp = 0f32;
    var style: LightningStyle = make LightningStyle {
        minimum: asset_value(read values, 1u32),
        maximum: asset_value(read values, 2u32),
        angle: asset_value(read values, 3u32) * 0.01745329252f32,
        radius: asset_value(read values, 4u32) * 0.5f32,
        seed: seed as u32,
        region: 1u32
    };
    var start: Vec3 = vec(-span * 0.5f32, span, span * 0.5f32);
    var end: Vec3 = vec(span * 0.5f32, span, span * 0.5f32);
    var bolt: Mesh = mesh_new();
    if !lightning_mesh(mut bolt, start, end, style) {
        return false;
    }
    // Cutout removes the bolt completely in the dark part of the flash cycle.
    i = 0u32;
    while i < mesh_triangle_count(read bolt) {
        var primitive: MeshTriangle = mesh_triangle(read bolt, i);
        primitive.flags = primitive.flags | 1u32;
        if !mesh_append(mut asset.decals, primitive) {
            return false;
        }
        i = i + 1u32;
    }
    return lightning_test_contact(mut asset, start, vec(1f32, 0f32, 0f32), seed as u32) && lightning_test_contact(
        mut asset,
        end,
        vec(-1f32, 0f32, 0f32),
        seed as u32 + 1u32
    ) && fixture_light_append(
        mut asset.lights,
        make FixtureLight {
            space: 0u32,
            period: LIGHTNING_TEST_PERIOD,
            position: scale(add(start, end), 0.5f32),
            colour: vec(0.08f32, 0.8f32, 4f32),
            radius: span
        }
    ) && room_asset_finish(mut asset);
}
fn lightning_test_contact(asset: mut RoomAsset, point: Vec3, direction: Vec3, seed: u32) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    return solid_box(
        mut asset.geometry,
        vec(0.2f32, 0.6f32, 0.6f32),
        0u32,
        sub(point, scale(direction, 0.1f32)),
        identity_basis(),
        1f32
    ) && asset_part_place_tail(
        mut asset,
        first,
        asset_name("contact"),
        vec(0f32, 0f32, 0f32)
    ) && spark_emitter_append(
        mut asset.sparks,
        make SparkEmitter {
            space: 0u32,
            position: point,
            direction: direction,
            period: LIGHTNING_TEST_PERIOD,
            seed: seed,
            count: 16u32,
            speed: 7f32,
            size: 0.1f32,
            material: 2u32
        }
    );
}

fn room_material_count() -> u32 {
    return 3u32;
}
fn room_material(region: u32, values: read AssetValues) -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0x707070u32;
    material.accent = 0x302828u32;
    material.finish = METAL_PLAIN;
    if region != 0u32 {
        material.finish = METAL_FLASH;
        material.emission_period = LIGHTNING_TEST_PERIOD;
        material.emission = 0xffe0b0u32;
        if region == 2u32 {
            material.emission = 0xff8020u32;
        }
    }
    return material;
}
