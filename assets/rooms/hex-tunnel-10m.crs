// Each wall has wall-N-pipes (0 disables, 1..3 enables a centred bundle),
// wall-N-entry and wall-N-exit (0 bends into the wall, 1 continues at the port).
// N runs from 0 to 5: wall 0 lies between the +X corner and the next corner
// towards +Z. Each subsequent wall advances by 60 degrees around local +Y.
// Continued bundles require matching wall positions and counts in the next room,
// including its portal roll. Pipes have solid collision and cast shadows.
// Straight hexagonal tunnel, ten metres long by default and 6 m across corners.
// Local +Y runs from ENTRY at zero to EXIT at length. Both use HEX-6M and
// permit six mating rolls. Local +Z is the up direction of both port frames.
// The viewer closes unused ends. Assembly opens both ends; the six wall faces
// provide a continuous collision shell. Axial metal plates span at most 1 m;
// whole plates fit the passage length, with dark seams at both ends.
fn room_parameter_count() -> u32 {
    return prefab_hex_tunnel_10m_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_hex_tunnel_10m_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_hex_tunnel_10m_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_hex_tunnel_10m_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_hex_tunnel_10m_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_hex_tunnel_10m_material(region, read parameters);
}
