// Rotor shaft: a closed 60 m cylinder, 16 m across, with a 3 m central spindle.
// The axis is +Y. Six static X rotors divide the annulus into open sectors.
// Wings reach the wall. Fly between wings to pass each rotor station.
// Each rotor has a local pivot on the shaft axis and shares one solid mesh.
// Successive stations turn 22.5 degrees. Rotation is not enabled.
// Dimensions are metres; rotor-count is an integer. There are no connections.
// Materials: 0 shell, 1 end caps, 2 spindle, 3 rotor wings.
fn room_parameter_count() -> u32 {
    return 4u32;
}
fn room_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("height");
    }
    if index == 1u32 {
        return asset_name("diameter");
    }
    if index == 2u32 {
        return asset_name("core-diameter");
    }
    return asset_name("rotor-count");
}
fn room_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 12f32,
            maximum: 200f32,
            initial: 60f32,
            step: 2f32
        };
    }
    if index == 1u32 {
        return make AssetParameter {
            minimum: 8f32,
            maximum: 40f32,
            initial: 16f32,
            step: 1f32
        };
    }
    if index == 2u32 {
        return make AssetParameter {
            minimum: 1f32,
            maximum: 12f32,
            initial: 3f32,
            step: 0.5f32
        };
    }
    return make AssetParameter {
        minimum: 1f32,
        maximum: 24f32,
        initial: 6f32,
        step: 1f32
    };
}
fn shaft_cylinder(hull: mut AssetHull, radius: f32, height: f32, side: u32, cap: u32) -> bool {
    var profile: RegularProfile = make RegularProfile {
        sides: 32u32,
        phase: 3.14159265359f32 / 32f32
    };
    if !loft_allocate(mut hull, profile, 2u32) {
        return false;
    }
    loft_ring(mut hull, profile, 0u32, 0f32, radius);
    loft_ring(mut hull, profile, 1u32, height, radius);
    loft_span(mut hull, profile, 0u32, side);
    loft_caps(mut hull, profile, 2u32, cap, cap);
    return true;
}
fn shaft_basis(angle: f32) -> Basis {
    return make Basis {
        right: vec(cosf(angle), 0f32, sinf(angle)),
        up: vec(0f32, 1f32, 0f32),
        forward: vec(-sinf(angle), 0f32, cosf(angle))
    };
}
fn shaft_core(asset: mut RoomAsset, radius: f32, height: f32) -> bool {
    var hull: AssetHull = asset_hull_new();
    if !shaft_cylinder(mut hull, radius, height, 2u32, 2u32) {
        return false;
    }
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !hull_solid_mesh(
        read hull,
        mut asset.geometry,
        vec(0f32, 0f32, 0f32),
        identity_basis(),
        asset.tile_metres
    ) {
        return false;
    }
    return asset_part_append(
        mut asset.parts,
        make AssetPart {
            name: asset_name("spindle"),
            first: first,
            count: mesh_triangle_count(read asset.geometry) - first,
            origin: vec(0f32, 0f32, 0f32),
            basis: identity_basis()
        }
    );
}
fn shaft_wings(mesh: mut Mesh, radius: f32, core: f32) -> bool {
    var rim: f32 = radius * cosf(3.14159265359f32 / 32f32);
    var width: f32 = mask_min(1.2f32, rim * 0.18f32);
    var i: u32 = 0u32;
    while i < 4u32 {
        var basis: Basis = shaft_basis(1.57079632679f32 * i as f32);
        var centre: Vec3 = scale(basis.right, (rim + core) * 0.5f32);
        if !solid_box(
            mut mesh,
            vec(rim - core, 0.6f32, width),
            3u32,
            centre,
            basis,
            2f32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn shaft_rotors(asset: mut RoomAsset, radius: f32, core: f32, height: f32, count: u32) -> bool {
    var first: u32 = mesh_triangle_count(read asset.geometry);
    if !shaft_wings(mut asset.geometry, radius, core) {
        return false;
    }
    var triangles: u32 = mesh_triangle_count(read asset.geometry) - first;
    var i: u32 = 0u32;
    while i < count {
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: asset_name("rotor"),
                first: first,
                count: triangles,
                origin: vec(0f32, height * (i + 1u32) as f32 / (count + 1u32) as f32, 0f32),
                basis: shaft_basis(0.78539816339f32 + 0.39269908169f32 * i as f32)
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var height: f32 = asset_value(read parameters, 0u32);
    var radius: f32 = asset_value(read parameters, 1u32) * 0.5f32;
    var core: f32 = asset_value(read parameters, 2u32) * 0.5f32;
    var count: f32 = asset_value(read parameters, 3u32);
    if count != count as u32 as f32 || height / (count + 1f32) < 3f32 {
        return error("rotor-count must be integral and leave at least 3 m between stations");
    }
    if radius * cosf(3.14159265359f32 / 32f32) - core < 2f32 {
        return error("shaft needs at least 2 m between the spindle and wall");
    }
    if !shaft_cylinder(mut asset.hull, radius, height, 0u32, 1u32) || !shaft_core(
        mut asset,
        core,
        height
    ) || !shaft_rotors(mut asset, radius, core, height, count as u32) {
        return false;
    }
    asset.spawn = make AssetSpawn {
        position: vec((radius + core) * 0.5f32, 1.5f32, 0f32),
        basis: make Basis {
            right: vec(1f32, 0f32, 0f32),
            up: vec(0f32, 0f32, -1f32),
            forward: vec(0f32, 1f32, 0f32)
        }
    };
    return room_asset_finish(mut asset);
}
fn room_material_count() -> u32 {
    return 4u32;
}
fn room_material(region: u32) -> PanelMaterial {
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0x807769u32;
    material.panel_height = 2f32;
    if region == 1u32 {
        return hex_bulkhead_material();
    }
    if region == 2u32 {
        material.colour = 0x9c9687u32;
        material.finish = METAL_RIBBED;
        material.pitch = 0.5f32;
    }
    if region == 3u32 {
        material.colour = 0x438ab0u32;
        material.accent = 0x3c4248u32;
        material.emission = 0x6dc6ffu32;
        material.finish = METAL_TREAD;
        material.marking = 2u32;
        material.pitch = 0.5f32;
    }
    return material;
}
