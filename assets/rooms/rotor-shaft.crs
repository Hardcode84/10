// Rotor shaft: a 60 m cylinder, 16 m across, with a 3 m central spindle.
// The axis is +Y. Six static X rotors divide the annulus into open sectors.
// Wings reach the wall. Fly between wings to pass each rotor station.
// Each rotor has a local pivot on the shaft axis and shares one solid mesh.
// Successive stations turn 22.5 degrees. Rotation is not enabled.
// Wing metal wraps around the long axis; side and cap rows share one phase.
// Dimensions are metres; rotor-count is an integer. BOTTOM-0 through BOTTOM-2
// are HEX-6M ports at Y=0, facing -Y, with six mating rotations each.
// TOP is the full round cap at +Y, with a ROTOR-SHAFT connection.
// The spindle reaches TOP; passage remains around it.
// Matching diameters connect at unit relative scale.
// Three separate service pipes occupy each gap between rotor stations.
// Runs have axial legs and circumferential arcs with rounded 90-degree elbows.
// Horizontal runs and their elbows follow the cylinder at a fixed radius.
// Attachments lie at facet centres and enter normal to the wall or spindle.
// Two return to the wall; one feeds the spindle. All stay clear of the rotors.
// pipe-seed selects pipe positions, widths, directions and spindle feeds.
// Wall and spindle tracks are 0.8 m wide, centred on the rotor stations.
// Metal rows fill each gap between tracks; the end rims have half-width tracks.
// Dark mounting flanges meet the wall and spindle. Leak stains trail toward
// TOP (+Y), where the shaft connects to the hub.
// Materials: 0 shell, 1 far cap, 2 spindle, 3 rotor wings, 4 bottom,
// 5 port closures, 6 pipes, 7 flanges, 8 leak stains.
fn room_parameter_count() -> u32 {
    return prefab_rotor_shaft_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_rotor_shaft_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_rotor_shaft_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_rotor_shaft_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_rotor_shaft_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_rotor_shaft_material(region, read parameters);
}
