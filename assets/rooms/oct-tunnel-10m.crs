// Octagonal service tunnel: 10 m long, 8 m across corners (7.39 m across flats).
// Local +Y runs from ENTRY to EXIT. Both use OCT-8M with four mating rolls.
// Four 0.7 m pipes run along the cardinal faces, with 0.08 m wall clearance.
// Pipes end flush with each port. Their positions and diameter are fixed by
// this asset set so connected sections line up. The clear central radius is 2.75 m.
// Length is editable in metres. Wall seams and pipe bands meet at each end.
// Regions: 0 wall plates, 1 pipe steel, 2 mounting brackets. Pipes are solid parts.
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("length");
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 1f32,
        maximum: 40f32,
        initial: 10f32,
        step: 1f32
    };
}
fn oct_pipe_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("RIGHT-PIPE");
    }
    if index == 1u32 {
        return asset_name("TOP-PIPE");
    }
    if index == 2u32 {
        return asset_name("LEFT-PIPE");
    }
    return asset_name("BOTTOM-PIPE");
}
fn oct_tunnel_pipes(asset: mut RoomAsset, extent: f32) -> bool {
    var radius: f32 = 0.35f32;
    var first: u32 = mesh_triangle_count(read asset.geometry);
    var material: PanelMaterial = room_material(1u32);
    var sections: u32 = (extent / material.tile_metres) as u32;
    if sections as f32 * material.tile_metres < extent {
        sections = sections + 1u32;
    }
    var period: f32 = extent / sections as f32;
    if !solid_cylinder(mut asset.geometry, 12u32, radius, extent, 1u32, period) || !oct_pipe_mounts(
        mut asset.geometry,
        extent,
        sections
    ) {
        return false;
    }
    var count: u32 = mesh_triangle_count(read asset.geometry) - first;
    var distance: f32 = service_oct_profile().radius * cosf(0.39269908169f32) - radius - 0.08f32;
    var i: u32 = 0u32;
    while i < 4u32 {
        var angle: f32 = i as f32 * 1.57079632679f32;
        if !asset_part_append(
            mut asset.parts,
            make AssetPart {
                name: oct_pipe_name(i),
                first: first,
                count: count,
                origin: vec(distance * cosf(angle), 0f32, distance * sinf(angle)),
                basis: make Basis {
                    right: vec(cosf(angle), 0f32, sinf(angle)),
                    up: vec(0f32, 1f32, 0f32),
                    forward: vec(-sinf(angle), 0f32, cosf(angle))
                }
            }
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var extent: f32 = asset_value(read parameters, 0u32);
    if !passage_shape(extent, true, service_oct_profile(), mut asset) || !oct_tunnel_pipes(
        mut asset,
        extent
    ) {
        return false;
    }
    asset.spawn.position.y = mask_min(1f32, extent * 0.5f32);
    return room_asset_finish(mut asset);
}
fn room_material_count() -> u32 {
    return 3u32;
}
fn room_material(region: u32) -> PanelMaterial {
    if region == 1u32 {
        return service_pipe_material();
    }
    var material: PanelMaterial = hex_tunnel_material();
    material.colour = 0xafa69cu32;
    if region == 2u32 {
        material.colour = 0x686e74u32;
    }
    return material;
}

fn oct_pipe_mounts(mesh: mut Mesh, extent: f32, count: u32) -> bool {
    var i: u32 = 0u32;
    while i < count {
        var height: f32 = (i as f32 + 0.5f32) * extent / count as f32;
        if !solid_box(
            mut mesh,
            vec(0.23f32, 0.18f32, 0.32f32),
            2u32,
            vec(0.315f32, height, 0f32),
            identity_basis(),
            2f32
        ) {
            return false;
        }
        i = i + 1u32;
    }
    return true;
}
