// Ending room: a hexagonal prism, 10 m across corners and 20 m along +Y.
// BOTTOM is the single centred HEX-6M connection at Y=0, facing -Y.
// The 6 m opening has a solid annular floor around it. The far end is closed.
// Local +Z is the port's up axis. The viewer starts inside, facing BOTTOM.
// Diameter and length are editable; the connection profile stays fixed.
fn room_parameter_count() -> u32 {
    return 2u32;
}
fn room_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 7f32,
            maximum: 30f32,
            initial: 10f32,
            step: 1f32
        };
    }
    return make AssetParameter {
        minimum: 1f32,
        maximum: 60f32,
        initial: 20f32,
        step: 1f32
    };
}
fn room_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("diameter");
    }
    return asset_name("length");
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    var radius: f32 = asset_value(read parameters, 0u32) * 0.5f32;
    var extent: f32 = asset_value(read parameters, 1u32);
    var profile: ConnectionProfile = service_hex_profile();
    var shell: AssetHull = asset_hull_new();
    if !loft_allocate(mut shell, profile.shape, 2u32) {
        return false;
    }
    loft_ring(mut shell, profile.shape, 0u32, 0f32, radius);
    loft_ring(mut shell, profile.shape, 1u32, extent, radius);
    loft_span(mut shell, profile.shape, 0u32, 0u32);
    loft_caps(mut shell, profile.shape, 2u32, 1u32, 1u32);
    hex_tunnel_surfaces(mut shell, profile.shape.sides, extent);
    var port: RoomPort = make RoomPort {
        id: asset_name("BOTTOM"),
        profile: profile,
        face: profile.shape.sides,
        position: vec(0f32, 0f32, 0f32),
        basis: make Basis {
            right: vec(1f32, 0f32, 0f32),
            up: vec(0f32, 0f32, 1f32),
            forward: vec(0f32, -1f32, 0f32)
        }
    };
    if !hull_polygon_partition(read shell, mut asset.hull, port, 0u32) || !asset_port_append(
        mut asset.ports,
        port
    ) {
        return false;
    }
    asset.spawn = make AssetSpawn {
        position: vec(0f32, extent * 0.5f32, 0f32),
        basis: port.basis
    };
    return room_asset_finish(mut asset);
}
fn room_material_count() -> u32 {
    return 2u32;
}
fn room_material(region: u32) -> PanelMaterial {
    if region == 1u32 {
        return hex_bulkhead_material();
    }
    return hex_tunnel_material();
}
