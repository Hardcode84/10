// Ending room: a hexagonal prism, 10 m across corners and 20 m along +Y.
// BOTTOM is the single centred HEX-6M connection at Y=0, facing -Y.
// The 6 m opening has a solid annular floor around it. The far end is closed.
// Local +Z is the port's up axis. The viewer starts inside, facing BOTTOM.
// Diameter and length are editable; the connection profile stays fixed.
fn room_parameter_count() -> u32 {
    return 2u32;
}
fn room_parameter(index: u32) -> AssetParameter {
    if index == 0u32 {
        return make AssetParameter {
            minimum: 7f32,
            maximum: 30f32,
            initial: 10f32,
            step: 1f32
        };
    }
    return make AssetParameter {
        minimum: 1f32,
        maximum: 60f32,
        initial: 20f32,
        step: 1f32
    };
}
fn room_parameter_name(index: u32) -> AssetName {
    if index == 0u32 {
        return asset_name("diameter");
    }
    return asset_name("length");
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    return hex_ending_build(
        asset_value(read parameters, 0u32),
        asset_value(read parameters, 1u32),
        mut asset
    );
}
fn room_material_count() -> u32 {
    return 2u32;
}
fn room_material(region: u32) -> PanelMaterial {
    if region == 1u32 {
        return hex_bulkhead_material();
    }
    return hex_tunnel_material();
}
