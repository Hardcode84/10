// Straight hexagonal tunnel, one metre long by default and 6 m across corners.
// Local +Y runs from ENTRY at zero to EXIT at length. Both use HEX-6M and
// permit six mating rolls. Local +Z is the up direction of both port frames.
// The viewer closes unused ends. Assembly opens both ends; the six wall faces
// provide a continuous collision shell. Axial metal plates span at most 1 m;
// whole plates fit the passage length, with dark seams at both ends.
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 0.75f32,
        maximum: 20f32,
        initial: 1f32,
        step: 0.25f32
    };
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("length");
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    return hex_tunnel_build(asset_value(read parameters, 0u32), mut asset);
}
fn room_material_count() -> u32 {
    return 1u32;
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return hex_tunnel_material();
}
