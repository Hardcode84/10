// OCT-8M cross: ENTRY -Y, EAST +X, EXIT +Y, WEST -X. Local +Z is up.
// A convex shell joins four 8 m openings, each with four mating rolls.
// Leg is the distance from the centre to each mouth, in metres.
// Upper-pipes and lower-pipes select 0 cross, 1 curve, or 2 diagonal.
// Diagonal uses two 45-degree curves with a straight section between them.
// Curved upper routes join south/east and north/west; lower routes reverse this.
fn room_parameter_count() -> u32 {
    return prefab_oct_x_junction_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_oct_x_junction_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_oct_x_junction_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_oct_x_junction_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_oct_x_junction_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_oct_x_junction_material(region, read parameters);
}
