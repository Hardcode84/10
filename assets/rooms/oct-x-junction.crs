// OCT-8M cross: ENTRY -Y, EAST +X, EXIT +Y, WEST -X. Local +Z is up.
// A convex shell joins four 8 m openings, each with four mating rolls.
// Leg is the distance from the centre to each mouth, in metres.
// Side pipes turn around the corners; ceiling and floor pipes form crosses.
const CONNECTIONS: u32 = 15u32;
fn room_parameter_count() -> u32 {
    return 1u32;
}
fn room_parameter(index: u32) -> AssetParameter {
    return make AssetParameter {
        minimum: 5f32,
        maximum: 12f32,
        initial: 5f32,
        step: 0.5f32
    };
}
fn room_parameter_name(index: u32) -> AssetName {
    return asset_name("leg");
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    if !asset_parameters_valid(read parameters) {
        return false;
    }
    return oct_junction_build(CONNECTIONS, asset_value(read parameters, 0u32), mut asset);
}
fn room_material_count() -> u32 {
    return 2u32;
}
fn room_material(region: u32) -> PanelMaterial {
    return oct_service_material(region);
}
