// Conduit tube with a direct side SHAFT connection, one third along local +Y.
// The concrete headwall surrounds a dark metal collar on the +X wall.
// Its concrete material and casting grid continue from the adjoining tube walls.
// Raised concrete tiles use tile-seed, tile-density (percent), and tile-depth
// (maximum metres). The entry headwall and both end bays stay clear.
// The connected shaft spindle continues inward as a long cone, with an amber
// full-bright warning lamp at its tip. The lamp casts a small pool of light.
// Both CONDUIT end ports and the twisted cable core remain continuous.
// Shaft and spindle diameters must match the adjoining shaft recipe.
// cone-length controls inward reach; entry-position is the axial fraction.
// The start view faces into the tube from beside the spindle at the side entry.
fn room_parameter_count() -> u32 {
    return prefab_conduit_shaft_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_conduit_shaft_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_conduit_shaft_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_conduit_shaft_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return 8u32;
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_conduit_shaft_material(region, read parameters);
}
