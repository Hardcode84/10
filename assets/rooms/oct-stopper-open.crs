// Open OCT-8M stopper, 1 m deep along +Y. ENTRY and EXIT have four mating rolls.
// Four solid triangular plates and service pipes remain around the clear opening.
// Four door leaves share the texture's + joint and slide outward on diagonals.
// Each leaf has a green full-bright LED. The viewer shows the closed pose.
// Fixed plates and door leaves are 0.2 m thick, centred in the sleeve.
// The default leaves 0.4 m on each side. A black band marks the door seat.
// Pipes end flush with both ports. Both sides have equal clearance. +Z is up.
// This room has no player spawn; its centre pose is for inspection.
// Regions: 0 sleeve, 1 door and fixed plates, 2 pipes, 3 door seat and edges.
fn room_parameter_count() -> u32 {
    return prefab_oct_stopper_open_parameter_count();
}
fn room_parameter(index: u32) -> AssetParameter {
    return prefab_oct_stopper_open_parameter(index);
}
fn room_parameter_name(index: u32) -> AssetName {
    return prefab_oct_stopper_open_parameter_name(index);
}
fn room_build(parameters: read AssetValues, asset: mut RoomAsset) -> bool {
    return prefab_oct_stopper_open_build(read parameters, mut asset);
}
fn room_material_count() -> u32 {
    return prefab_oct_stopper_open_material_count();
}
fn room_material(region: u32, parameters: read AssetValues) -> PanelMaterial {
    return prefab_oct_stopper_open_material(region, read parameters);
}
