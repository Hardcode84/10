fn shader_path(root: *CrustRun, name: *u8) -> *u8 {
    if cache_strcmp(name, "palette.crs") == 0i32 {
        return host_path(root, "tests/device/palette.crs");
    }
    return stage_path(root, "src/render/device", name);
}
extern fn build_access(path: *u8, mode: i32) -> i32 = "access";
extern fn build_getenv(name: *u8) -> *u8 = "getenv";
extern fn build_chdir(path: *u8) -> i32 = "chdir";
extern fn build_execv(path: *u8, args: **u8) -> i32 = "execv";
fn shader_source(root: *CrustRun, name: *u8, result: *CrustSource) -> bool {
    var parts: [CrustSource; 3] = uninit;
    if !cache_read(
        root -> context,
        host_path(root, "src/render/interface.crs"),
        &parts[0usize]
    ) || !cache_read(
        root -> context,
        host_path(root, "src/render/device/common.crs"),
        &parts[1usize]
    ) || !cache_read(root -> context, shader_path(root, name), &parts[2usize]) {
        return false;
    }
    var size: usize = parts[0usize].size + parts[1usize].size + parts[2usize].size + 3usize;
    var data: *u8 = crust_try_alloc(root -> context, size + 1usize, 1usize);
    if data == null(*u8) {
        return false;
    }
    var offset: usize = 0usize;
    var i: usize = 0usize;
    while i < 3usize {
        var j: usize = 0usize;
        while j < parts[i].size {
            data[offset] = parts[i].bytes[j];
            offset = offset + 1usize;
            j = j + 1usize;
        }
        data[offset] = 10u8;
        offset = offset + 1usize;
        i = i + 1usize;
    }
    data[offset] = 0u8;
    *result = make CrustSource {
        path: name,
        bytes: data,
        size: offset,
        identity: 2u64
    };
    return true;
}
fn build_shader(root: *CrustRun, name: *u8, output: *u8, llvm: *u8, validator: *u8) -> bool {
    var resources: [ShaderResource; 3] = make [ShaderResource; 3] {
        make ShaderResource {
            name: "words",
            kind: SHADER_BUFFER_U32,
            set: 0u32,
            binding: 0u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "floats",
            kind: SHADER_BUFFER_F32,
            set: 0u32,
            binding: 1u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "shared",
            kind: SHADER_WORKGROUP_F32,
            set: 0u32,
            binding: 0u32,
            length: 512u32,
            height: 0u32
        }
    };
    var resource_count: usize = 2usize;
    if cache_strcmp(name, "palette.crs") == 0i32 || cache_strcmp(name, "raster.crs") == 0i32 || cache_strcmp(
        name,
        "scan.crs"
    ) == 0i32 {
        resource_count = 3usize;
    }
    var config: ShaderConfig = make ShaderConfig {
        resources: &resources[0usize],
        entry: "compute",
        llvm_directory: llvm,
        validator: validator,
        resource_count: resource_count,
        invocations: MAX_INVOCATIONS,
        local_size: LOCAL_SIZE,
        status_set: 0u32,
        status_binding: 2u32,
        preserve_denorms: false
    };
    var source: CrustSource = uninit;
    if !shader_source(root, name, &source) {
        return false;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var good: bool = shader_build(&context, &source, &config, host_path(root, output));
    if !good {
        crust_run_diagnostic(&context);
    }
    crust_context_destroy(&context);
    return good;
}
fn render_sources(root: *CrustRun, args: **u8) -> usize {
    var sources: [*u8; 15] = make [*u8; 15] {
        "src/render/interface.crs",
        "src/render/host/vulkan.crs",
        "src/render/host/io.crs",
        "src/render/host/device.crs",
        "src/render/host/resources.crs",
        "src/render/host/geometry.crs",
        "src/render/host/assets.crs",
        "src/render/host/mesh.crs",
        "src/render/host/retained.crs",
        "src/render/host/retained-io.crs",
        "src/render/host/dispatch.crs",
        "src/render/host/timing.crs",
        "src/render/host/present.crs",
        "src/render/host/renderer.crs",
        "src/render/host/owner.crs"
    };
    var i: usize = 0usize;
    while i < 15usize {
        args[i] = host_path(root, sources[i]);
        i = i + 1usize;
    }
    return i;
}
fn check_renderer(root: *CrustRun) -> bool {
    var args: [*u8; 18] = uninit;
    args[0usize] = "crust-c";
    args[1usize] = "--check";
    args[2usize] = "--library";
    var count: usize = 3usize + render_sources(root, &args[3usize]);
    return ownership_host(root, count as i32 - 1i32, &args[1usize], true, null(*u8)) == 0i32;
}
fn build_host(root: *CrustRun) -> bool {
    var args: [*u8; 54] = uninit;
    args[0usize] = "crust-c";
    args[1usize] = "-o";
    args[2usize] = host_path(root, "build/spinward");
    var count: usize = 3usize + render_sources(root, &args[3usize]);
    var application: [*u8; 36] = make [*u8; 36] {
        host_path(root, "src/demo/main.crs"),
        host_path(root, "src/demo/config.crs"),
        host_path(root, "src/demo/playback.crs"),
        host_path(root, "src/demo/entry.crs"),
        host_path(root, "src/demo/session.crs"),
        host_path(root, "src/demo/scene.crs"),
        host_path(root, "src/demo/tour.crs"),
        host_path(root, "src/demo/tour-assets.crs"),
        host_path(root, "src/demo/window.crs"),
        host_path(root, "src/demo/timing.crs"),
        host_path(root, "src/app/capture.crs"),
        host_path(root, "src/app/shaders.crs"),
        host_path(root, "src/app/window.crs"),
        host_path(root, "src/app/clock.crs"),
        host_path(root, "src/app/geometry.crs"),
        host_path(root, "src/app/palette.crs"),
        host_path(root, "src/demo/renderer.crs"),
        host_path(root, "tests/palette.crs"),
        host_path(root, "tests/playback.crs"),
        host_path(root, "tests/portal.crs"),
        host_path(root, "tests/geometry-capacity.crs"),
        host_path(root, "tests/textures.crs"),
        host_path(root, "tests/retained.crs"),
        host_path(root, "tests/visibility.crs"),
        "--ldflag",
        host_path(root, "build/reference.o"),
        "--cflag",
        "-O2",
        "--cflag",
        "-g",
        "--ldflag",
        "-Wl,-l:libvulkan.so.1",
        "--ldflag",
        "-Wl,-l:libSDL2-2.0.so.0",
        "--ldflag",
        "-lm"
    };
    var i: usize = 0usize;
    while i < 36usize {
        args[count] = application[i];
        count = count + 1usize;
        i = i + 1usize;
    }
    return ownership_host(root, count as i32 - 1i32, &args[1usize], false, null(*u8)) == 0i32;
}

fn build_reference(root: *CrustRun) -> bool {
    var source: CrustSource = uninit;
    if !cache_read(root -> context, host_path(root, "tests/reference.crs"), &source) {
        return false;
    }
    source.identity = 1000u64;
    var args: [*u8; 9] = make [*u8; 9] {
        "--object",
        "--library",
        "--export",
        "reference_check",
        "-o",
        host_path(root, "build/reference.o"),
        host_path(root, "src/render/interface.crs"),
        "--cflag",
        "-O2"
    };
    return ownership_build(
        null(*CrustSource),
        0usize,
        9i32,
        &args[0usize],
        &source,
        1usize,
        c_backend_build
    ) == 0i32;
}

fn ownership_host(root: *CrustRun, argc: i32, argv: **u8, core: bool, expected: *u8) -> i32 {
    var providers: [*u8; 27] = make [*u8; 27] {
        "src/render/host/vulkan.crs",
        "src/render/host/io.crs",
        "src/render/host/device.crs",
        "src/render/host/resources.crs",
        "src/render/host/geometry.crs",
        "src/render/host/assets.crs",
        "src/render/host/mesh.crs",
        "src/render/host/retained.crs",
        "src/render/host/retained-io.crs",
        "src/render/host/dispatch.crs",
        "src/render/host/timing.crs",
        "src/render/host/present.crs",
        "src/render/host/renderer.crs",
        "src/render/host/owner.crs",
        "src/demo/entry.crs",
        "src/app/shaders.crs",
        "src/app/window.crs",
        "src/app/clock.crs",
        "src/app/capture.crs",
        "src/demo/renderer.crs",
        "src/demo/window.crs",
        "src/demo/timing.crs",
        "src/demo/session.crs",
        "tests/palette.crs",
        "tests/playback.crs",
        "tests/portal.crs",
        "tests/visibility.crs"
    };
    var count: usize = 27usize;
    if core {
        count = 14usize;
    }
    return ownership_sources(root, argc, argv, &providers[0usize], count, expected);
}
fn ownership_sources(
    root: *CrustRun,
    argc: i32,
    argv: **u8,
    providers: **u8,
    count: usize,
    expected: *u8
) -> i32 {
    var trusted: [CrustSource; 32] = uninit;
    var i: usize = 0usize;
    while i < count {
        if !cache_read(root -> context, host_path(root, providers[i]), &trusted[i]) {
            return 1i32;
        }
        trusted[i].identity = 100u64 + i as u64;
        i = i + 1usize;
    }
    var args: [*u8; 96] = uninit;
    var total: usize = 0usize;
    i = 0usize;
    while i < argc as usize {
        var provider: bool = false;
        var j: usize = 0usize;
        while j < count {
            if cache_strcmp(argv[i], trusted[j].path) == 0i32 {
                provider = true;
            }
            j = j + 1usize;
        }
        if !provider {
            args[total] = argv[i];
            total = total + 1usize;
        }
        i = i + 1usize;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var request: CrustBuild = make CrustBuild {
        context: &context,
        source: null(*CrustSource),
        target_begin: 0usize,
        argc: total as i32,
        argv: &args[0usize]
    };
    var result: i32 = ownership_program(
        &request,
        &trusted[0usize],
        count,
        c_backend_build
    );
    if expected != null(*u8) {
        if result != 0i32 && context.error_count != 0usize && cache_strcmp(
            &context.error[0usize],
            expected
        ) == 0i32 {
            result = 0i32;
        } else {
            if context.error_count != 0usize {
                crust_run_diagnostic(&context);
            }
            native_error(
                root -> context,
                "ownership rejection did not match the expected diagnostic"
            );
            result = 1i32;
        }
    } else if context.error_count != 0usize {
        crust_run_diagnostic(&context);
    }
    crust_context_destroy(&context);
    return result;
}
