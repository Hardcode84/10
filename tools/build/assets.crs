fn asset_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 16] = make [*u8; 16] {
        "src/assets/geometry/loft.crs",
        "src/assets/geometry/hex-tunnel.crs",
        "src/assets/geometry/hex-ending.crs",
        "src/assets/geometry/hex-junction.crs",
        "src/assets/geometry/placement.crs",
        "src/assets/materials/tunnel-metal.crs",
        "src/assets/materials/markings.crs",
        "src/assets/geometry/hex-opening.crs",
        "src/assets/geometry/polygon-opening.crs",
        "src/assets/connections/profiles.crs",
        "src/assets/geometry/surfaces.crs",
        "src/assets/room.crs",
        "src/assets/parameters.crs",
        "src/assets/materials/masks.crs",
        "src/assets/materials/hex-metal.crs",
        "src/assets/materials/metal.crs"
    };
    var i: usize = 0usize;
    while i < 16usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn asset_providers(root: *CrustRun, args: **u8) -> usize {
    args[0usize] = host_path(root, "src/assets/geometry/storage.crs");
    args[1usize] = host_path(root, "src/assets/parameter-storage.crs");
    args[2usize] = host_path(root, "src/assets/connections/storage.crs");
    return 3usize;
}
fn asset_collision_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 14] = make [*u8; 14] {
        "src/collision/primitives.crs",
        "src/collision/portals.crs",
        "src/collision/topology.crs",
        "src/collision/sweep.crs",
        "src/collision/query.crs",
        "src/collision/volume.crs",
        "src/collision/contact-query.crs",
        "src/collision/contact-solve.crs",
        "src/collision/motion.crs",
        "src/collision/kinematics.crs",
        "src/collision/kinematic-sweep.crs",
        "src/collision/kinematic-contacts.crs",
        "src/collision/kinematic-motion.crs",
        "src/app/math.crs"
    };
    var i: usize = 0usize;
    while i < 14usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn asset_collision_providers(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 5] = make [*u8; 5] {
        "src/collision/storage.crs",
        "src/collision/portal-storage.crs",
        "src/collision/index-build.crs",
        "src/collision/adjacency-build.crs",
        "src/collision/contact-storage.crs"
    };
    var i: usize = 0usize;
    while i < 5usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
