fn asset_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 43] = make [*u8; 43] {
        "src/assets/geometry/loft.crs",
        "src/assets/geometry/truncated-cube.crs",
        "src/assets/geometry/rhombicuboctahedron.crs",
        "src/assets/geometry/truncate.crs",
        "src/assets/geometry/solid-loft.crs",
        "src/assets/geometry/tube-bend.crs",
        "src/assets/geometry/tube-sweep.crs",
        "src/assets/geometry/rotor-hub-pipes.crs",
        "src/assets/geometry/rotor-hub-structure.crs",
        "src/assets/geometry/rotor-shaft-pipes.crs",
        "src/assets/geometry/cylinder-pipe-mounts.crs",
        "src/assets/geometry/rotor-hub-routing.crs",
        "src/assets/geometry/rotor-hub-lanes.crs",
        "src/assets/geometry/pipe-router.crs",
        "src/assets/geometry/pipe-route-clearance.crs",
        "src/assets/geometry/pipe-route-match.crs",
        "src/assets/geometry/pipe-graph.crs",
        "src/assets/geometry/pipe-graph-mesh.crs",
        "src/assets/geometry/oct-service.crs",
        "src/assets/geometry/oct-stopper.crs",
        "src/assets/geometry/stopper.crs",
        "src/assets/geometry/oct-elbow.crs",
        "src/assets/geometry/oct-junction.crs",
        "src/assets/geometry/oct-junction-pipes.crs",
        "src/assets/parts/assemble.crs",
        "src/assets/geometry/hex-tunnel.crs",
        "src/assets/geometry/hex-ending.crs",
        "src/assets/geometry/hex-junction.crs",
        "src/assets/geometry/placement.crs",
        "src/assets/materials/tunnel-metal.crs",
        "src/assets/materials/markings.crs",
        "src/assets/geometry/hex-opening.crs",
        "src/assets/geometry/polygon-opening.crs",
        "src/assets/geometry/convex-opening.crs",
        "src/assets/connections/profiles.crs",
        "src/assets/geometry/surfaces.crs",
        "src/assets/room.crs",
        "src/assets/parameters.crs",
        "src/assets/materials/masks.crs",
        "src/assets/materials/hex-metal.crs",
        "src/assets/materials/door.crs",
        "src/assets/materials/pipe.crs",
        "src/assets/materials/metal.crs"
    };
    var i: usize = 0usize;
    while i < 43usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn asset_providers(root: *CrustRun, args: **u8) -> usize {
    args[0usize] = host_path(root, "src/assets/geometry/storage.crs");
    args[1usize] = host_path(root, "src/assets/parameter-storage.crs");
    args[2usize] = host_path(root, "src/assets/connections/storage.crs");
    args[3usize] = host_path(root, "src/assets/parts/storage.crs");
    args[4usize] = host_path(root, "src/assets/geometry/pipe-graph-storage.crs");
    args[5usize] = host_path(root, "src/assets/geometry/pipe-router-storage.crs");
    return 6usize;
}
