fn web_provider(root: *CrustRun, path: *u8) -> *u8 {
    if cache_strcmp(path, host_path(root, "src/runtime/platform/native-pool.crs")) == 0i32 {
        return host_path(root, "src/runtime/platform/web-pool.crs");
    }
    var native: [*u8; 9] = make [*u8; 9] {
        "src/render/host/vulkan.crs",
        "src/render/host/device.crs",
        "src/render/host/resources.crs",
        "src/render/host/dispatch.crs",
        "src/render/host/timing.crs",
        "src/render/host/completion.crs",
        "src/runtime/platform/native-service.crs",
        "src/render/host/present.crs",
        "src/render/host/io.crs"
    };
    var i: usize = 0usize;
    while i < 9usize {
        if cache_strcmp(path, host_path(root, native[i])) == 0i32 {
            return null(*u8);
        }
        i = i + 1usize;
    }
    if cache_strcmp(path, host_path(root, "src/app/window-vulkan.crs")) == 0i32 {
        return host_path(root, "src/app/web/window.crs");
    }
    return path;
}
fn build_web_game(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var sources: [*u8; 256] = uninit;
    var providers: [*u8; 96] = uninit;
    var source_count: usize = game_sources(root, &sources[0usize]);
    var count: usize = render_providers(root, &providers[0usize]);
    count = count + game_providers(root, &providers[count]);
    var i: usize = 0usize;
    var selected: usize = 0usize;
    while i < count {
        var path: *u8 = web_provider(root, providers[i]);
        if path != null(*u8) {
            providers[selected] = path;
            selected = selected + 1usize;
        }
        i = i + 1usize;
    }
    providers[selected] = host_path(root, "src/render/web/backend.crs");
    providers[selected + 1usize] = host_path(root, "src/game/host/entry.crs");
    var args: **u8 = crust_try_alloc(
        root -> context,
        (source_count + 4usize) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if args == null(**u8) {
        return false;
    }
    args[0usize] = "--emit";
    args[1usize] = "-o";
    args[2usize] = host_path(root, "build/web/game.c");
    args[3usize] = host_path(root, "src/render/interface.crs");
    i = 0usize;
    while i < source_count {
        args[i + 4usize] = sources[i];
        i = i + 1usize;
    }
    return cache_directory(root -> context, host_path(root, "build/web")) && ownership_sources_target(
        root,
        emit,
        (source_count + 4usize) as i32,
        &args[0usize],
        &providers[0usize],
        selected + 2usize,
        null(*u8),
        true
    ) == 0i32;
}
fn web_copy(root: *CrustRun, source: *u8, output: *u8) -> bool {
    var data: CrustSource = uninit;
    if !cache_read(root -> context, host_path(root, source), &data) {
        return false;
    }
    if crust0_host_write_file(host_path(root, output), data.bytes, data.size) != 0i32 {
        return native_error(root -> context, "cannot write web application file");
    }
    return true;
}
const WEB_TOOLCHAIN_HASH: *u8 = "cda6801012ff3319a539111826ed02a9abd7eff135c2ef261c8941caf5a3763e";
fn web_toolchain_stamp(root: *CrustRun) -> *u8 {
    return native_join(
        root -> context,
        host_path(root, "build/toolchain/wasm/.ready-"),
        WEB_TOOLCHAIN_HASH
    );
}
fn web_toolchain(root: *CrustRun) -> bool {
    if !cache_directory(root -> context, host_path(root, "build/toolchain")) || !cache_directory(
        root -> context,
        host_path(root, "build/toolchain/wasm")
    ) {
        return false;
    }
    if build_access(web_toolchain_stamp(root), 0i32) != 0i32 {
        if !web_toolchain_fetch(root) {
            return false;
        }
    }
    return web_copy(
        root,
        "src/app/web/emscripten_config",
        "build/toolchain/wasm/emscripten_config"
    );
}
fn web_toolchain_fetch(root: *CrustRun) -> bool {
    var archive: *u8 = host_path(root, "build/toolchain/wasm.tar.xz");
    var download: [*u8; 9] = make [*u8; 9] {
        "curl",
        "--fail",
        "--location",
        "--retry",
        "2",
        "--output",
        archive,
        "https://storage.googleapis.com/webassembly/emscripten-releases-builds/linux/eb132757325583b787fe9414b09afea9442b72ad/wasm-binaries.tar.xz",
        null(*u8)
    };
    if !native_tool(root -> context, &download[0usize]) {
        return false;
    }
    var digest: *u8 = native_join(
        root -> context,
        WEB_TOOLCHAIN_HASH,
        native_join(root -> context, "  ", native_join(root -> context, archive, "\n"))
    );
    var manifest: *u8 = host_path(root, "build/toolchain/wasm.sha256");
    if crust0_host_write_file(manifest, digest, native_strlen(digest)) != 0i32 {
        return native_error(root -> context, "cannot write toolchain checksum");
    }
    var verify: [*u8; 4] = make [*u8; 4] {
        "sha256sum",
        "--check",
        manifest,
        null(*u8)
    };
    var unpack: [*u8; 8] = make [*u8; 8] {
        "tar",
        "-xf",
        archive,
        "-C",
        host_path(root, "build/toolchain/wasm"),
        "--strip-components",
        "1",
        null(*u8)
    };
    if !native_tool(root -> context, &verify[0usize]) || !native_tool(
        root -> context,
        &unpack[0usize]
    ) {
        return false;
    }
    if crust0_host_write_file(web_toolchain_stamp(root), WEB_TOOLCHAIN_HASH, 64usize) != 0i32 {
        return native_error(root -> context, "cannot mark the completed web toolchain");
    }
    return true;
}
fn web_link(root: *CrustRun) -> bool {
    var args: [*u8; 22] = make [*u8; 22] {
        "env",
        native_join(
            root -> context,
            "EM_CONFIG=",
            host_path(root, "build/toolchain/wasm/emscripten_config")
        ),
        host_path(root, "build/toolchain/wasm/emscripten/emcc"),
        host_path(root, "build/web/game.c"),
        "-O2",
        "-sMALLOC=emmalloc",
        "-sASYNCIFY",
        "-sASYNCIFY_IMPORTS=[\"web_open\",\"web_buffer\",\"web_pipeline\",\"web_wait\",\"web_idle\",\"web_present_idle\",\"web_times\",\"web_present\"]",
        "-sALLOW_MEMORY_GROWTH",
        "-sMAXIMUM_MEMORY=2147483648",
        "-sSTACK_SIZE=4194304",
        "--use-port=sdl3",
        "-sEXIT_RUNTIME=1",
        "-sEXPORTED_RUNTIME_METHODS=[\"FS\",\"HEAPU32\",\"ccall\",\"stringToNewUTF8\"]",
        "-sEXPORTED_FUNCTIONS=[\"_main\",\"_malloc\",\"_free\"]",
        "--js-library",
        host_path(root, "src/render/web/backend.js"),
        "-sMODULARIZE",
        "-sEXPORT_NAME=Spinward",
        "-o",
        host_path(root, "build/web/game.js"),
        null(*u8)
    };
    var command: [*u8; 105] = uninit;
    var i: usize = 0usize;
    while i < 21usize {
        command[i] = args[i];
        i = i + 1usize;
    }
    i = web_shader_files(root, &command[0usize], i);
    command[i] = null(*u8);
    return native_tool(root -> context, &command[0usize]);
}
fn web_shader_files(root: *CrustRun, args: **u8, first: usize) -> usize {
    var i: usize = 0usize;
    var out: usize = first;
    while i < 41usize {
        var checked: bool = i >= 20usize;
        var slot: usize = i;
        if checked {
            slot = slot - 20usize;
        }
        var name: *u8 = native_join(
            root -> context,
            render_shader_name(slot, checked),
            ".wgsl"
        );
        args[out] = "--preload-file";
        args[out + 1usize] = native_join(
            root -> context,
            render_build_shader_path(root, slot, checked, true),
            native_join(root -> context, "@/build/", name)
        );
        out = out + 2usize;
        i = i + 1usize;
    }
    return out;
}
fn build_web(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    return build_web_game(root, emit) && cache_directory(
        root -> context,
        host_path(root, "build/web/shaders")
    ) && build_render_shaders_target(root, true) && web_toolchain(root) && web_link(root) && web_copy(
        root,
        "src/app/web/index.html",
        "build/web/index.html"
    ) && web_copy(root, "src/app/web/launcher.js", "build/web/launcher.js");
}
