fn shader_source(
    root: *CrustRun,
    name: *u8,
    result: *CrustSource,
    report: bool,
    checked: bool
) -> bool {
    var paths: [*u8; 5] = make [*u8; 5] {
        "src/render/interface.crs",
        "src/render/device/common.crs",
        "src/render/device/shadows.crs",
        name,
        "src/render/device/production.crs"
    };
    var count: usize = 5usize;
    if checked {
        paths[4usize] = "src/render/device/checked.crs";
    }
    if report {
        paths[1usize] = name;
        count = 2usize;
    }
    var parts: [CrustSource; 5] = uninit;
    var size: usize = count;
    var part: usize = 0usize;
    while part < count {
        if !cache_read(root -> context, host_path(root, paths[part]), &parts[part]) {
            return false;
        }
        size = size + parts[part].size;
        part = part + 1usize;
    }
    var data: *u8 = crust_try_alloc(root -> context, size + 1usize, 1usize);
    if data == null(*u8) {
        return false;
    }
    var offset: usize = 0usize;
    var i: usize = 0usize;
    while i < count {
        var j: usize = 0usize;
        while j < parts[i].size {
            data[offset] = parts[i].bytes[j];
            offset = offset + 1usize;
            j = j + 1usize;
        }
        data[offset] = 10u8;
        offset = offset + 1usize;
        i = i + 1usize;
    }
    data[offset] = 0u8;
    *result = make CrustSource {
        path: name,
        bytes: data,
        size: offset,
        identity: 2u64
    };
    return true;
}
fn build_shader(
    root: *CrustRun,
    name: *u8,
    output: *u8,
    llvm: *u8,
    validator: *u8,
    shared_kind: u32,
    shared_length: u32,
    report: bool,
    checked: bool
) -> bool {
    var resources: [ShaderResource; 4] = make [ShaderResource; 4] {
        make ShaderResource {
            name: "words",
            kind: SHADER_BUFFER_U32,
            layout: SHADER_COUNTED,
            set: 0u32,
            binding: 0u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "floats",
            kind: SHADER_BUFFER_F32,
            layout: SHADER_COUNTED,
            set: 0u32,
            binding: 1u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "shared",
            kind: shared_kind,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 0u32,
            length: shared_length,
            height: 0u32
        },
        make ShaderResource {
            name: "status",
            kind: SHADER_BUFFER_U32,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 2u32,
            length: MAX_INVOCATIONS,
            height: 0u32
        }
    };
    var resource_count: usize = 2usize;
    if shared_length != 0u32 {
        resource_count = 3usize;
    }
    var config: ShaderConfig = make ShaderConfig {
        resources: &resources[0usize],
        entry: "compute",
        llvm_directory: llvm,
        validator: validator,
        resource_count: resource_count,
        execution: SHADER_CHECKED,
        invocations: MAX_INVOCATIONS,
        local_size: LOCAL_SIZE,
        status_set: 0u32,
        status_binding: 2u32,
        preserve_denorms: false
    };
    if !checked {
        config.execution = SHADER_RAW;
    }
    if report {
        config.execution = SHADER_RAW;
        config.resource_count = 4usize;
    }
    var source: CrustSource = uninit;
    if !shader_source(root, name, &source, report, checked) {
        return false;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var good: bool = shader_build(&context, &source, &config, host_path(root, output));
    if !good {
        crust_run_diagnostic(&context);
    }
    crust_context_destroy(&context);
    return good;
}
fn build_render_shaders(root: *CrustRun) -> bool {
    var llvm: *u8 = build_getenv("LLVM_DIRECTORY");
    var validator: *u8 = build_getenv("SPIRV_VAL");
    if llvm == null(*u8) {
        llvm = host_path(root, "build/toolchain/llvm");
    }
    if validator == null(*u8) {
        validator = host_path(root, "build/toolchain/spirv-val");
    }
    if build_access(stage_path(root, llvm, "bin/llc"), 1i32) != 0i32 || build_access(
        stage_path(root, llvm, "bin/opt"),
        1i32
    ) != 0i32 || build_access(validator, 1i32) != 0i32 {
        return native_error(
            root -> context,
            "set LLVM_DIRECTORY and SPIRV_VAL, or provide build/toolchain/llvm and build/toolchain/spirv-val"
        );
    }
    var sources: [*u8; 13] = make [*u8; 13] {
        "src/render/device/init.crs",
        "src/render/device/transform.crs",
        "src/render/device/raster.crs",
        "src/render/device/advance.crs",
        "src/render/device/compose.crs",
        "src/render/device/compact.crs",
        "src/render/device/scan.crs",
        "src/render/device/fill.crs",
        "src/render/device/instances.crs",
        "src/render/device/visibility.crs",
        "src/render/device/bin.crs",
        "src/render/device/shadow-build.crs",
        "src/render/device/status.crs"
    };
    var i: usize = 0usize;
    while i < 13usize {
        var shared_length: u32 = 0u32;
        if i == 2usize || i == 6usize {
            shared_length = 512u32;
        }
        if i == 5usize {
            shared_length = 64u32;
        }
        if i == 12usize {
            shared_length = 192u32;
        }
        if !build_shader(
            root,
            sources[i],
            render_build_shader_path(i, true),
            llvm,
            validator,
            SHADER_WORKGROUP_U32,
            shared_length,
            i == 12usize,
            true
        ) {
            return false;
        }
        if i < 12usize && !build_shader(
            root,
            sources[i],
            render_build_shader_path(i, false),
            llvm,
            validator,
            SHADER_WORKGROUP_U32,
            shared_length,
            false,
            false
        ) {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}
fn render_build_shader_path(slot: usize, checked: bool) -> *u8 {
    var paths: [*u8; 25] = make [*u8; 25] {
        "build/init.spv",
        "build/transform.spv",
        "build/raster.spv",
        "build/advance.spv",
        "build/compose.spv",
        "build/compact.spv",
        "build/scan.spv",
        "build/fill.spv",
        "build/instances.spv",
        "build/visibility.spv",
        "build/bin.spv",
        "build/shadow-build.spv",
        "build/init.debug.spv",
        "build/transform.debug.spv",
        "build/raster.debug.spv",
        "build/advance.debug.spv",
        "build/compose.debug.spv",
        "build/compact.debug.spv",
        "build/scan.debug.spv",
        "build/fill.debug.spv",
        "build/instances.debug.spv",
        "build/visibility.debug.spv",
        "build/bin.debug.spv",
        "build/shadow-build.debug.spv",
        "build/status.debug.spv"
    };
    return paths[slot + checked as usize * 12usize];
}
