fn shader_source(
    root: *CrustRun,
    name: *u8,
    result: *CrustSource,
    report: bool,
    checked: bool
) -> bool {
    var paths: [*u8; 11] = make [*u8; 11] {
        "src/render/interface.crs",
        "src/render/device/common.crs",
        "src/render/device/shadows.crs",
        name,
        "src/render/device/production.crs",
        "src/render/device/shadow-tree.crs",
        "src/render/device/scene-data.crs",
        "src/render/device/projection-math.crs",
        "src/render/device/raster-math.crs",
        "src/render/device/projection-storage.crs",
        name
    };
    var count: usize = 10usize;
    var extra: *u8 = shader_extra_source(name);
    if extra != null(*u8) {
        paths[10usize] = extra;
        count = 11usize;
    }
    if checked {
        paths[4usize] = "src/render/device/checked.crs";
    }
    if report {
        paths[1usize] = name;
        count = 2usize;
    }
    var parts: [CrustSource; 11] = uninit;
    var size: usize = count;
    var part: usize = 0usize;
    while part < count {
        if !cache_read(root -> context, host_path(root, paths[part]), &parts[part]) {
            return false;
        }
        size = size + parts[part].size;
        part = part + 1usize;
    }
    var data: *u8 = crust_try_alloc(root -> context, size + 1usize, 1usize);
    if data == null(*u8) {
        return false;
    }
    var offset: usize = 0usize;
    var i: usize = 0usize;
    while i < count {
        var j: usize = 0usize;
        while j < parts[i].size {
            data[offset] = parts[i].bytes[j];
            offset = offset + 1usize;
            j = j + 1usize;
        }
        data[offset] = 10u8;
        offset = offset + 1usize;
        i = i + 1usize;
    }
    data[offset] = 0u8;
    *result = make CrustSource {
        path: name,
        bytes: data,
        size: offset,
        identity: 2u64
    };
    return true;
}
fn build_shader(
    root: *CrustRun,
    name: *u8,
    output: *u8,
    llvm: *u8,
    validator: *u8,
    shared_kind: u32,
    shared_length: u32,
    report: bool,
    checked: bool,
    web: bool
) -> bool {
    var resources: [ShaderResource; 4] = make [ShaderResource; 4] {
        make ShaderResource {
            name: "words",
            kind: SHADER_BUFFER_U32,
            layout: SHADER_COUNTED,
            set: 0u32,
            binding: 0u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "floats",
            kind: SHADER_BUFFER_F32,
            layout: SHADER_COUNTED,
            set: 0u32,
            binding: 1u32,
            length: 0u32,
            height: 0u32
        },
        make ShaderResource {
            name: "shared",
            kind: shared_kind,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 0u32,
            length: shared_length,
            height: 0u32
        },
        make ShaderResource {
            name: "status",
            kind: SHADER_BUFFER_U32,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 2u32,
            length: MAX_INVOCATIONS,
            height: 0u32
        }

    };
    var resource_count: usize = 2usize;
    if shared_length != 0u32 {
        resource_count = 3usize;
    }
    var config: ShaderConfig = make ShaderConfig {
        interfaces: null(*ShaderInterface),
        interface_count: 0usize,
        stage: SHADER_COMPUTE,
        resources: &resources[0usize],
        entry: "compute",
        llvm_directory: llvm,
        validator: validator,
        resource_count: resource_count,
        execution: SHADER_CHECKED,
        invocations: MAX_INVOCATIONS,
        local_size: LOCAL_SIZE,
        status_set: 0u32,
        status_binding: 2u32,
        preserve_denorms: false
    };
    if !checked {
        config.execution = SHADER_RAW;
    }
    if report {
        config.execution = SHADER_RAW;
        config.resource_count = 4usize;
    }
    var source: CrustSource = uninit;
    if !shader_source(root, name, &source, report, checked) {
        return false;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var good: bool = false;
    if web {
        good = shader_build_wgsl(&context, &source, &config, host_path(root, output));
    } else {
        good = shader_build(&context, &source, &config, host_path(root, output));
    }
    if !good {
        crust_run_diagnostic(&context);
    }
    crust_context_destroy(&context);
    return good;
}
fn build_render_shaders_target(root: *CrustRun, web: bool) -> bool {
    var llvm: *u8 = build_getenv("LLVM_DIRECTORY");
    var validator: *u8 = build_getenv("SPIRV_VAL");
    if llvm == null(*u8) {
        llvm = host_path(root, "build/toolchain/llvm");
    }
    if validator == null(*u8) {
        validator = host_path(root, "build/toolchain/spirv-val");
    }
    if !web && (
        build_access(stage_path(root, llvm, "bin/llc"), 1i32) != 0i32 || build_access(
            stage_path(root, llvm, "bin/opt"),
            1i32
        ) != 0i32 || build_access(validator, 1i32) != 0i32
    ) {
        return native_error(
            root -> context,
            "set LLVM_DIRECTORY and SPIRV_VAL, or provide build/toolchain/llvm and build/toolchain/spirv-val"
        );
    }
    var sources: [*u8; 21] = make [*u8; 21] {
        "src/render/device/init.crs",
        "src/render/device/transform.crs",
        "src/render/device/advance.crs",
        "src/render/device/compose.crs",
        "src/render/device/scan.crs",
        "src/render/device/fill.crs",
        "src/render/device/instances.crs",
        "src/render/device/visibility.crs",
        "src/render/device/shadow-build.crs",
        "src/render/device/shadow-level.crs",
        "src/render/device/shade.crs",
        "src/render/device/batch-plan.crs",
        "src/render/device/tile-list.crs",
        "src/render/device/raster.crs",
        "src/render/device/shade-distance.crs",
        "src/render/device/tile-list-link.crs",
        "src/render/device/tile-list-reset.crs",
        "src/render/device/tile-list-count.crs",
        "src/render/device/tile-list-clear.crs",
        "src/render/device/tile-list-write.crs",
        "src/render/device/status.crs"
    };
    var i: usize = 0usize;
    while i < 21usize {
        var shared_length: u32 = render_shader_shared(i);
        if !build_shader(
            root,
            sources[i],
            render_build_shader_path(root, i, true, web),
            llvm,
            validator,
            SHADER_WORKGROUP_U32,
            shared_length,
            i == 20usize,
            true,
            web
        ) {
            return false;
        }
        if i < 20usize && !build_shader(
            root,
            sources[i],
            render_build_shader_path(root, i, false, web),
            llvm,
            validator,
            SHADER_WORKGROUP_U32,
            shared_length,
            false,
            false,
            web
        ) {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}
fn render_build_shader_path(root: *CrustRun, slot: usize, checked: bool, web: bool) -> *u8 {
    var directory: *u8 = "build/";
    var extension: *u8 = ".spv";
    if web {
        directory = "build/web/shaders/";
        extension = ".wgsl";
    }
    return native_join(
        root -> context,
        directory,
        native_join(root -> context, render_shader_name(slot, checked), extension)
    );
}
fn build_render_shaders(root: *CrustRun) -> bool {
    return build_render_shaders_target(root, false);
}

fn render_shader_shared(index: usize) -> u32 {
    if index == 10usize || index == 14usize || index == 4usize {
        return 512u32;
    }
    if index == 7usize || index == 11usize {
        return 256u32;
    }
    if index == 20usize {
        return 192u32;
    }
    return 0u32;
}

fn shader_is_shade(name: *u8) -> bool {
    return cache_strcmp(name, "src/render/device/shade.crs") == 0i32 || cache_strcmp(
        name,
        "src/render/device/shade-distance.crs"
    ) == 0i32;
}

fn shader_is_tile_list(name: *u8) -> bool {
    var paths: [*u8; 6] = make [*u8; 6] {
        "src/render/device/tile-list.crs",
        "src/render/device/tile-list-link.crs",
        "src/render/device/tile-list-reset.crs",
        "src/render/device/tile-list-count.crs",
        "src/render/device/tile-list-clear.crs",
        "src/render/device/tile-list-write.crs"
    };
    var i: usize = 0usize;
    while i < 6usize {
        if cache_strcmp(name, paths[i]) == 0i32 {
            return true;
        }
        i = i + 1usize;
    }
    return false;
}

fn shader_extra_source(name: *u8) -> *u8 {
    if shader_is_shade(name) {
        return "src/render/device/shade-data.crs";
    }
    if shader_is_tile_list(name) {
        return "src/render/device/tile-list-data.crs";
    }
    return null(*u8);
}
