fn run_ratio_checks(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> i32 {
    var providers: [*u8; 3] = make [*u8; 3] {
        host_path(root, "src/app/io.crs"),
        host_path(root, "src/numeric/natural.crs"),
        host_path(root, "src/numeric/rational.crs")
    };
    var args: [*u8; 5] = make [*u8; 5] {
        host_path(root, "tests/scaling/ratios.crs"),
        "-o",
        host_path(root, "build/tests-ratios"),
        "--cflag",
        "-O2"
    };
    if ownership_sources(
        root,
        emit,
        5i32,
        &args[0usize],
        &providers[0usize],
        3usize,
        null(*u8)
    ) != 0i32 {
        return 1i32;
    }
    var command: [*u8; 2] = make [*u8; 2] {
        args[2usize],
        null(*u8)
    };
    build_execv(command[0usize], &command[0usize]);
    return 1i32;
}
