fn build_reference(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var source: CrustSource = uninit;
    if !cache_read(root -> context, host_path(root, "tests/render/reference.crs"), &source) {
        return false;
    }
    source.identity = 1000u64;
    var args: [*u8; 9] = make [*u8; 9] {
        "--object",
        "--library",
        "--export",
        "reference_check",
        "-o",
        host_path(root, "build/reference.o"),
        host_path(root, "src/render/interface.crs"),
        "--cflag",
        "-O2"
    };
    return ownership_build(
        null(*CrustSource),
        0usize,
        9i32,
        &args[0usize],
        &source,
        1usize,
        emit
    ) == 0i32;
}
fn build_render_tests(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var sources: [*u8; 128] = uninit;
    var providers: [*u8; 96] = uninit;
    var source_count: usize = demo_sources(root, &sources[0usize]);
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + demo_providers(root, &providers[provider_count]);
    providers[provider_count] = host_path(root, "tests/render/transfers.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/portable-lights.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/lighting.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/image.crs");
    provider_count = provider_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/scene.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/runner.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/geometry-capacity.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/textures.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/retained.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/traversal.crs");
    source_count = source_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/entry.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/verify.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/palette.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/demo/playback.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/portal.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/visibility.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/traversal-host.crs");
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        "build/tests-render",
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        true
    );
}
