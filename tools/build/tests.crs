fn build_reference(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var source: CrustSource = uninit;
    if !cache_read(root -> context, host_path(root, "tests/render/reference.crs"), &source) {
        return false;
    }
    source.identity = 1000u64;
    var args: [*u8; 9] = make [*u8; 9] {
        "--object",
        "--library",
        "--export",
        "reference_check",
        "-o",
        host_path(root, "build/reference.o"),
        host_path(root, "src/render/interface.crs"),
        "--cflag",
        "-O2"
    };
    return ownership_generics_build(
        null(*CrustSource),
        0usize,
        9i32,
        &args[0usize],
        &source,
        1usize,
        emit
    ) == 0i32;
}
fn build_render_tests(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var sources: **u8 = build_source_storage(
        root,
        demo_sources(root, null(**u8)) + 7usize
    );
    if sources == null(**u8) {
        return false;
    }
    var providers: **u8 = crust_try_alloc(
        root -> context,
        (
            render_providers(root, null(**u8)) + game_providers(root, null(**u8)) + 16usize
        ) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = demo_sources(root, &sources[0usize]);
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + demo_providers(root, &providers[provider_count]);
    providers[provider_count] = host_path(root, "tests/render/growth.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/transfers.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/portable-lights.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/lighting.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/image.crs");
    provider_count = provider_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/large-shadow.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/scene.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/runner.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/geometry-capacity.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/textures.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/retained.crs");
    source_count = source_count + 1usize;
    sources[source_count] = host_path(root, "tests/render/traversal.crs");
    source_count = source_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/entry.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/verify.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/palette.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/app/input.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/demo/playback.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/portal.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/visibility.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/traversal-host.crs");
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        "build/tests-render",
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        true
    );
}
fn build_game_tests(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var fixtures: [*u8; 30] = make [*u8; 30] {
        "tests/collision/fixtures.crs",
        "tests/fixtures/industrial/course.crs",
        "tests/fixtures/industrial/course-route.crs",
        "tests/fixtures/industrial/course-pipes.crs",
        "tests/fixtures/industrial/prefab.crs",
        "tests/fixtures/industrial/expedition-layout.crs",
        "tests/fixtures/industrial/expedition-shell.crs",
        "tests/fixtures/industrial/expedition-world.crs",
        "tests/fixtures/industrial/room-content.crs",
        "tests/fixtures/industrial/launch-cradle.crs",
        "tests/fixtures/industrial/counterweight-riser.crs",
        "tests/fixtures/industrial/machines.crs",
        "tests/fixtures/industrial/geometry.crs",
        "tests/fixtures/industrial/collision.crs",
        "tests/fixtures/industrial/materials.crs",
        "tests/collision/motion.crs",
        "tests/collision/index.crs",
        "tests/collision/scaling.crs",
        "tests/collision/reference.crs",
        "tests/collision/checks.crs",
        "tests/game/flight-fixture.crs",
        "tests/game/prediction-admission.crs",
        "tests/game/doors.crs",
        "tests/game/checks.crs",
        "tests/game/room-frames.crs",
        "tests/game/pulses.crs",
        "tests/game/wall-anchor.crs",
        "tests/game/hook.crs",
        "tests/game/tether.crs",
        "tests/game/preview.crs"
    };
    var sources: **u8 = crust_try_alloc(
        root -> context,
        (game_sources(root, null(**u8)) + 30usize) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if sources == null(**u8) {
        return false;
    }
    var providers: **u8 = crust_try_alloc(
        root -> context,
        (
            render_providers(root, null(**u8)) + game_providers(root, null(**u8)) + 16usize
        ) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = game_sources(root, &sources[0usize]);
    var fixture: usize = 0usize;
    while fixture < 30usize {
        sources[source_count] = host_path(root, fixtures[fixture]);
        source_count = source_count + 1usize;
        fixture = fixture + 1usize;
    }
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + game_providers(root, &providers[provider_count]);
    providers[provider_count] = host_path(root, "tests/game/entry.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/collision/check-host.crs");
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        "build/tests-game",
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
fn build_viewer_tests(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var sources: **u8 = build_source_storage(
        root,
        game_sources(root, null(**u8)) + 1usize
    );
    if sources == null(**u8) {
        return false;
    }
    var providers: **u8 = crust_try_alloc(
        root -> context,
        (
            render_providers(root, null(**u8)) + game_providers(root, null(**u8)) + 16usize
        ) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = game_sources(root, &sources[0usize]);
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + game_providers(root, &providers[provider_count]);
    sources[source_count] = host_path(root, "tests/viewer/retained-scene.crs");
    source_count = source_count + 1usize;
    providers[provider_count] = host_path(root, "tests/viewer/entry.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/viewer/retained-platform.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "tests/render/visibility.crs");
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        "build/tests-viewer",
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
