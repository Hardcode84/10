fn build_collision_checks(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    sanitize: bool,
    output: *u8
) -> bool {
    if !sdl_build(root) {
        return false;
    }
    var files: [*u8; 42] = make [*u8; 42] {
        "src/app/math.crs",
        "src/app/math-constants.crs",
        "src/collision/primitives.crs",
        "src/collision/body.crs",
        "src/collision/admission.crs",
        "src/collision/caps.crs",
        "src/spatial/scale.crs",
        "src/spatial/path-transform.crs",
        "src/collision/portals.crs",
        "src/collision/anchors.crs",
        "src/collision/portal-query.crs",
        "src/collision/portal-contacts.crs",
        "src/collision/topology.crs",
        "src/collision/sweep.crs",
        "src/collision/query.crs",
        "src/collision/contact-query.crs",
        "src/collision/boundary-query.crs",
        "src/game/flight/wall-anchor.crs",
        "src/game/flight/jumper.crs",
        "src/collision/contact-solve.crs",
        "src/collision/motion.crs",
        "src/collision/volume.crs",
        "src/collision/kinematics.crs",
        "src/collision/kinematic-sweep.crs",
        "src/collision/kinematic-contacts.crs",
        "src/collision/kinematic-motion.crs",
        "tests/collision/fixtures.crs",
        "tests/collision/motion.crs",
        "tests/collision/portals.crs",
        "tests/collision/scaled-portals.crs",
        "src/game/effects/contact.crs",
        "src/game/flight/drone.crs",
        "src/game/flight/attachment.crs",
        "tests/collision/kinematic.crs",
        "src/game/flight/command.crs",
        "src/game/flight/environment.crs",
        "src/game/flight/energy.crs",
        "src/game/flight/collision.crs",
        "src/game/flight/tether.crs",
        "src/game/flight/hook.crs",
        "src/game/flight/orientation.crs",
        "src/game/flight/physics.crs"
    };
    var native: [*u8; 21] = make [*u8; 21] {
        "src/app/io.crs",
        "src/render/host/mesh.crs",
        "src/collision/storage.crs",
        "src/collision/rooms.crs",
        "src/collision/residency.crs",
        "src/collision/rebuild.crs",
        "src/collision/snapshot.crs",
        "tests/collision/residency.crs",
        "src/runtime/platform/reference-count.crs",
        "src/spatial/room-frame.crs",
        "src/collision/portal-storage.crs",
        "src/spatial/anchors.crs",
        "src/numeric/natural.crs",
        "src/numeric/rational.crs",
        "src/spatial/portal-path.crs",
        "src/collision/index-build.crs",
        "src/collision/adjacency-build.crs",
        "src/collision/contact-storage.crs",
        "tests/collision/check-host.crs",
        "tests/collision/entry.crs",
        "src/game/host/collision-errors.crs"
    };
    var args: [*u8; 64] = uninit;
    var providers: [*u8; 21] = uninit;
    var i: usize = 0usize;
    while i < 42usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    var count: usize = i;
    i = 0usize;
    while i < 21usize {
        providers[i] = host_path(root, native[i]);
        i = i + 1usize;
    }
    var optimization: *u8 = "-O2";
    if sanitize {
        optimization = "-O1";
    }
    var options: [*u8; 6] = make [*u8; 6] {
        "-o",
        host_path(root, output),
        "--cflag",
        optimization,
        "--ldflag",
        sdl_link(root)
    };
    i = 0usize;
    while i < 6usize {
        args[count] = options[i];
        count = count + 1usize;
        i = i + 1usize;
    }
    if sanitize {
        var checks: [*u8; 8] = make [*u8; 8] {
            "--cflag",
            "-g",
            "--cflag",
            "-fsanitize=address,undefined",
            "--ldflag",
            "-fsanitize=address,undefined",
            "--cflag",
            "-fno-sanitize-recover=all"
        };
        i = 0usize;
        while i < 8usize {
            args[count] = checks[i];
            count = count + 1usize;
            i = i + 1usize;
        }
    }
    return ownership_sources(
        root,
        emit,
        count as i32,
        &args[0usize],
        &providers[0usize],
        21usize,
        null(*u8)
    ) == 0i32;
}
fn run_collision_checks(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> i32 {
    if !cache_directory(root -> context, host_path(root, "build")) {
        return 1i32;
    }
    var sanitize: bool = false;
    var execute: bool = true;
    var i: usize = 1usize;
    while i < root -> argc as usize {
        if cache_strcmp(root -> argv[i], "--sanitize") == 0i32 {
            sanitize = true;
        } else if cache_strcmp(root -> argv[i], "--build-only") == 0i32 {
            execute = false;
        } else {
            native_error(root -> context, "collision checks accept --sanitize and --build-only");
            return 2i32;
        }
        i = i + 1usize;
    }
    var output: *u8 = "build/tests-collision";
    if sanitize {
        output = "build/tests-collision-asan";
    }
    if !build_collision_checks(root, emit, sanitize, output) {
        return 1i32;
    }
    if !execute {
        return 0i32;
    }
    var args: [*u8; 2] = make [*u8; 2] {
        host_path(root, output),
        null(*u8)
    };
    build_execv(args[0usize], &args[0usize]);
    native_error(root -> context, "cannot launch collision checks");
    return 1i32;
}
