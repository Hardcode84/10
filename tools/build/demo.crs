fn demo_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 8] = make [*u8; 8] {
        "src/demo/host/main.crs",
        "src/demo/host/config.crs",
        "src/demo/host/playback.crs",
        "src/demo/scene/tour.crs",
        "src/demo/scene/tour-assets.crs",
        "src/app/geometry.crs",
        "src/app/colour.crs",
        "src/app/palette.crs"
    };
    var i: usize = 0usize;
    while i < 8usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn demo_providers(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 11] = make [*u8; 11] {
        "src/app/shaders.crs",
        "src/app/window.crs",
        "src/app/input.crs",
        "src/app/window-vulkan.crs",
        "src/app/clock.crs",
        "src/app/capture.crs",
        "src/demo/host/renderer.crs",
        "src/demo/host/window.crs",
        "src/demo/host/timing.crs",
        "src/demo/host/session.crs",
        "src/demo/host/options.crs"
    };
    var i: usize = 0usize;
    while i < 11usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn build_demo(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    var sources: [*u8; 64] = uninit;
    var providers: [*u8; 48] = uninit;
    var source_count: usize = demo_sources(root, &sources[0usize]);
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + demo_providers(root, &providers[provider_count]);

    providers[provider_count] = host_path(root, "src/demo/host/entry.crs");
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        "build/spinward",
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
