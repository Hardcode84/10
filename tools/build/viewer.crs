fn build_viewer(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    recipe: *u8,
    checks: bool
) -> bool {
    var sources: [*u8; 256] = uninit;
    var capacity: usize = render_providers(root, null(**u8)) + asset_collision_providers(
        root,
        null(**u8)
    ) + asset_providers(root, null(**u8)) + 11usize;
    var providers: **u8 = crust_try_alloc(
        root -> context,
        capacity * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = asset_sources(root, &sources[0usize]);
    source_count = source_count + asset_collision_sources(root, &sources[source_count]);
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + asset_collision_providers(
        root,
        &providers[provider_count]
    );
    provider_count = provider_count + asset_providers(root, &providers[provider_count]);
    var files: [*u8; 12] = make [*u8; 12] {
        "src/viewer/asset-controls.crs",
        "src/viewer/asset-camera.crs",
        "src/viewer/asset-flight.crs",
        "src/app/camera.crs",
        "src/app/colour.crs",
        "src/app/font.crs",
        "src/viewer/asset-labels.crs",
        "src/viewer/asset-label-material.crs",
        "src/viewer/asset-scene.crs",
        "src/viewer/asset-motion.crs",
        "src/viewer/asset-waypoints.crs",
        "src/assets/materials/upload.crs"
    };
    var native: [*u8; 11] = make [*u8; 11] {
        "src/app/window.crs",
        "src/app/input.crs",
        "src/app/window-vulkan.crs",
        "src/app/clock.crs",
        "src/app/capture.crs",
        "src/app/shaders.crs",
        "src/app/render-open.crs",
        "src/viewer/entry.crs",
        "src/viewer/session.crs",
        "src/viewer/asset-platform.crs",
        "src/viewer/asset-options.crs"
    };
    var output: *u8 = "build/viewer";
    if checks {
        native[7usize] = "tests/assets/viewer-entry.crs";
        sources[source_count] = host_path(root, "tests/assets/viewer.crs");
        sources[source_count + 1usize] = host_path(root, "tests/assets/flight.crs");
        source_count = source_count + 2usize;
        output = "build/tests-assets-viewer";
    }
    var i: usize = 0usize;
    while i < 12usize {
        sources[source_count] = host_path(root, files[i]);
        source_count = source_count + 1usize;
        i = i + 1usize;
    }
    sources[source_count] = recipe;
    source_count = source_count + 1usize;
    i = 0usize;
    while i < 11usize {
        providers[provider_count] = host_path(root, native[i]);
        provider_count = provider_count + 1usize;
        i = i + 1usize;
    }
    return build_application(
        root,
        emit,
        output,
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
