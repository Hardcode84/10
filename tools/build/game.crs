fn game_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 83] = make [*u8; 83] {
        "src/assets/geometry/loft.crs",
        "src/assets/geometry/solid-loft.crs",
        "assets/objects/player-drone.crs",
        "src/game/view/drone.crs",
        "src/assets/geometry/hex-tunnel.crs",
        "src/assets/geometry/hex-ending.crs",
        "src/game/graph/generate.crs",
        "src/game/graph/routes.crs",
        "src/game/graph/styles.crs",
        "src/game/graph/assemble.crs",
        "src/game/graph/progress.crs",
        "src/game/graph/view.crs",
        "src/game/graph/lighting.crs",
        "src/assets/geometry/hex-junction.crs",
        "src/assets/geometry/placement.crs",
        "src/assets/materials/tunnel-metal.crs",
        "src/assets/materials/markings.crs",
        "src/assets/geometry/hex-opening.crs",
        "src/assets/geometry/polygon-opening.crs",
        "src/assets/connections/profiles.crs",
        "src/assets/connections/link.crs",
        "src/assets/geometry/surfaces.crs",
        "src/assets/room.crs",
        "src/assets/parameters.crs",
        "src/assets/materials/masks.crs",
        "src/assets/materials/hex-metal.crs",
        "src/assets/materials/metal.crs",
        "src/assets/materials/upload.crs",
        "assets/rooms/radial-start.crs",
        "src/demo/room/content.crs",
        "src/demo/room/tunnels.crs",
        "src/game/view/room-materials.crs",
        "src/game/view/portals.crs",
        "src/app/math.crs",
        "src/app/frame-rate.crs",
        "src/collision/primitives.crs",
        "src/collision/portals.crs",
        "src/collision/anchors.crs",
        "src/collision/portal-query.crs",
        "src/collision/portal-contacts.crs",
        "src/collision/topology.crs",
        "src/collision/sweep.crs",
        "src/collision/query.crs",
        "src/collision/contact-query.crs",
        "src/collision/contact-solve.crs",
        "src/collision/motion.crs",
        "src/collision/volume.crs",
        "src/collision/kinematics.crs",
        "src/collision/kinematic-sweep.crs",
        "src/collision/kinematic-contacts.crs",
        "src/collision/kinematic-motion.crs",
        "src/game/flight/state.crs",
        "src/game/flight/spawn.crs",
        "src/game/flight/command.crs",
        "src/game/flight/environment.crs",
        "src/game/flight/drone.crs",
        "src/game/flight/attachment.crs",
        "src/game/flight/energy.crs",
        "src/game/flight/collision.crs",
        "src/game/flight/orientation.crs",
        "src/game/flight/tether.crs",
        "src/game/flight/hook.crs",
        "src/game/view/tether-view.crs",
        "src/game/view/lighting.crs",
        "src/game/view/light-anchors.crs",
        "src/game/flight/physics.crs",
        "src/game/flight/trial.crs",
        "src/game/view/scene.crs",
        "src/game/view/geometry.crs",
        "src/game/view/static-mesh.crs",
        "src/game/host/input.crs",
        "src/game/host/loop.crs",
        "src/game/view/hud.crs",
        "src/game/view/palette.crs",
        "src/game/view/preview.crs",
        "src/game/view/preview-phase.crs",
        "src/game/view/hook-preview.crs",
        "src/game/host/replay.crs",
        "src/app/geometry.crs",
        "src/app/colour.crs",
        "src/app/camera.crs",
        "src/app/font.crs",
        "src/app/palette.crs"
    };
    var i: usize = 0usize;
    while i < 83usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn game_providers(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 25] = make [*u8; 25] {
        "src/assets/geometry/storage.crs",
        "src/assets/parameter-storage.crs",
        "src/assets/connections/storage.crs",
        "src/app/window.crs",
        "src/app/window-vulkan.crs",
        "src/app/render-open.crs",
        "src/collision/storage.crs",
        "src/collision/portal-storage.crs",
        "src/spatial/anchors.crs",
        "src/collision/contact-storage.crs",
        "src/collision/index-build.crs",
        "src/collision/adjacency-build.crs",
        "src/app/clock.crs",
        "src/app/shaders.crs",
        "src/game/host/platform.crs",
        "src/game/graph/storage.crs",
        "src/game/host/world.crs",
        "src/game/host/collision-errors.crs",
        "src/game/host/sdl-input.crs",
        "src/game/host/renderer-host.crs",
        "src/game/host/options.crs",
        "src/game/host/recording.crs",
        "src/game/host/bindings.crs",
        "src/app/capture.crs",
        "src/game/view/text.crs"
    };
    var i: usize = 0usize;
    while i < 25usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn build_game(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    return build_game_entry(root, emit, "src/game/host/entry.crs", "build/game");
}
fn build_game_entry(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    entry: *u8,
    output: *u8
) -> bool {
    return build_game_target(root, emit, entry, output, null(*u8));
}
fn build_game_target(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    entry: *u8,
    output: *u8,
    check: *u8
) -> bool {
    var sources: [*u8; 128] = uninit;
    var providers: [*u8; 96] = uninit;
    var source_count: usize = game_sources(root, &sources[0usize]);
    if check != null(*u8) {
        sources[source_count] = host_path(root, check);
        source_count = source_count + 1usize;
    }
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + game_providers(root, &providers[provider_count]);

    providers[provider_count] = host_path(root, entry);
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        output,
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
