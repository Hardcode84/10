fn game_sources(root: *CrustRun, args: **u8) -> usize {
    var count: usize = asset_sources(root, null(**u8)) + asset_collision_sources(
        root,
        null(**u8)
    );
    if args == null(**u8) {
        return count + 80usize;
    }
    count = asset_sources(root, args);
    count = count + asset_collision_sources(root, &args[count]);
    var files: [*u8; 80] = make [*u8; 80] {
        "src/app/generation/random.crs",
        "src/app/level/parts.crs",
        "src/app/level/recipe.crs",
        "src/app/streaming/polygon.crs",
        "src/app/streaming/visibility.crs",
        "src/audio/api/model.crs",
        "src/audio/mix/voice.crs",
        "src/audio/synthesis/recipe.crs",
        "src/audio/scene/model.crs",
        "src/audio/scene/obstruction.crs",
        "src/audio/scene/search.crs",
        "assets/sounds/hook.crs",
        "src/game/audio/cues.crs",
        "src/assets/effects/arc-draw.crs",
        "src/game/view/arcs.crs",
        "src/assets/effects/draw.crs",
        "src/assets/materials/flash-upload.crs",
        "assets/objects/player-drone.crs",
        "src/game/view/drone.crs",
        "src/demo/labyrinth/graph/generate.crs",
        "src/demo/labyrinth/graph/routes.crs",
        "src/demo/labyrinth/graph/styles.crs",
        "src/demo/labyrinth/graph/assemble.crs",
        "src/demo/labyrinth/graph/scaling.crs",
        "src/demo/labyrinth/graph/progress.crs",
        "src/demo/labyrinth/graph/view.crs",
        "src/demo/labyrinth/graph/lighting.crs",
        "src/assets/connections/link.crs",
        "src/app/level/motion.crs",
        "src/assets/materials/upload.crs",
        "assets/rooms/radial-start.crs",
        "src/game/view/room-materials.crs",
        "src/game/view/portals.crs",
        "src/app/frame-rate.crs",
        "src/game/effects/contact.crs",
        "src/game/effects/sparks.crs",
        "src/game/effects/view.crs",
        "src/game/flight/state.crs",
        "src/game/flight/spawn.crs",
        "src/game/flight/command.crs",
        "src/game/flight/environment.crs",
        "src/demo/course/placement.crs",
        "src/game/flight/drone.crs",
        "src/game/flight/attachment.crs",
        "src/game/flight/energy.crs",
        "src/game/flight/collision.crs",
        "src/game/flight/orientation.crs",
        "src/game/flight/tether.crs",
        "src/game/flight/hook.crs",
        "src/game/view/tether-view.crs",
        "src/game/view/cable-path.crs",
        "src/game/view/portal-admission.crs",
        "src/game/view/lighting.crs",
        "src/game/view/light-anchors.crs",
        "src/game/flight/physics.crs",
        "src/game/flight/wall-anchor.crs",
        "src/game/flight/trial.crs",
        "src/game/view/scene.crs",
        "src/game/view/geometry.crs",
        "src/game/view/static-mesh.crs",
        "src/game/host/input.crs",
        "src/game/host/loop.crs",
        "src/game/view/hud.crs",
        "src/game/view/palette.crs",
        "src/game/view/preview.crs",
        "src/game/view/burst-console.crs",
        "src/game/tasks/prediction.crs",
        "src/game/doors/state.crs",
        "src/game/doors/sensor.crs",
        "src/game/doors/draw.crs",
        "src/game/tasks/frame.crs",
        "src/game/tasks/root-frame.crs",
        "src/game/flight/preview-phase.crs",
        "src/game/view/hook-preview.crs",
        "src/game/host/replay.crs",
        "src/app/geometry.crs",
        "src/app/colour.crs",
        "src/app/camera.crs",
        "src/app/font.crs",
        "src/app/palette.crs"
    };
    var i: usize = 0usize;
    while i < 80usize {
        args[count + i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return count + i;
}
fn game_providers(root: *CrustRun, args: **u8) -> usize {
    var count: usize = asset_providers(root, null(**u8)) + asset_collision_providers(
        root,
        null(**u8)
    );
    if args == null(**u8) {
        return count + 43usize;
    }
    count = asset_providers(root, args);
    count = count + asset_collision_providers(root, &args[count]);
    var files: [*u8; 43] = make [*u8; 43] {
        "src/runtime/channel/spsc.crs",
        "src/audio/platform/bank.crs",
        "src/audio/platform/mixer.crs",
        "src/audio/platform/session.crs",
        "src/audio/platform/capture.crs",
        "src/audio/platform/search.crs",
        "src/game/audio/control.crs",
        "src/game/audio/task.crs",
        "src/game/effects/storage.crs",
        "src/app/streaming/tasks.crs",
        "src/game/tasks/runtime.crs",
        "src/game/tasks/prediction-work.crs",
        "src/app/level/recipe-storage.crs",
        "src/app/generation/words.crs",
        "src/app/streaming/storage.crs",
        "src/app/streaming/loader.crs",
        "src/app/streaming/gpu.crs",
        "src/app/streaming/start.crs",
        "src/app/streaming/selection.crs",
        "src/app/streaming/planner.crs",
        "src/app/streaming/simulation.crs",
        "src/app/streaming/dependencies.crs",
        "src/app/window.crs",
        "src/app/input.crs",
        "src/app/window-vulkan.crs",
        "src/app/render-open.crs",
        "src/collision/snapshot.crs",
        "src/app/clock.crs",
        "src/app/shaders.crs",
        "src/game/host/platform.crs",
        "src/demo/labyrinth/graph/storage.crs",
        "src/game/doors/storage.crs",
        "src/demo/labyrinth/world.crs",
        "src/game/host/collision-errors.crs",
        "src/game/host/controls.crs",
        "src/game/host/renderer-host.crs",
        "src/game/host/options.crs",
        "src/game/host/recording.crs",
        "src/game/host/latency.crs",
        "src/game/host/bindings.crs",
        "src/app/capture.crs",
        "src/game/view/text.crs",
        "src/game/tasks/timing.crs"
    };
    var i: usize = 0usize;
    while i < 43usize {
        args[count + i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return count + i;
}
fn build_game(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> bool {
    return build_game_entry(root, emit, "src/demo/labyrinth/entry.crs", "build/game");
}
fn build_game_entry(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    entry: *u8,
    output: *u8
) -> bool {
    return build_game_target(root, emit, entry, output, null(*u8));
}
fn build_game_target(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    entry: *u8,
    output: *u8,
    check: *u8
) -> bool {
    var sources: **u8 = build_source_storage(
        root,
        game_sources(root, null(**u8)) + (check != null(*u8)) as usize
    );
    if sources == null(**u8) {
        return false;
    }
    var providers: **u8 = crust_try_alloc(
        root -> context,
        (
            render_providers(root, null(**u8)) + game_providers(root, null(**u8)) + 16usize
        ) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = game_sources(root, &sources[0usize]);
    if check != null(*u8) {
        sources[source_count] = host_path(root, check);
        source_count = source_count + 1usize;
    }
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + game_providers(root, &providers[provider_count]);

    providers[provider_count] = host_path(root, entry);
    provider_count = provider_count + 1usize;
    return build_application(
        root,
        emit,
        output,
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count,
        false
    );
}
