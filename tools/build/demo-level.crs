fn build_demo_level(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    recipe: *u8
) -> bool {
    return build_demo_target(
        root,
        emit,
        recipe,
        "src/demo/room/entry.crs",
        null(*u8),
        "build/spinward"
    );
}
fn build_demo_target(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    recipe: *u8,
    entry: *u8,
    check: *u8,
    output: *u8
) -> bool {
    return build_demo_target_providers(
        root,
        emit,
        recipe,
        entry,
        check,
        output,
        null(**u8),
        0usize
    );
}
fn build_demo_target_providers(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    recipe: *u8,
    entry: *u8,
    check: *u8,
    output: *u8,
    extra: **u8,
    extra_count: usize
) -> bool {
    var sources: **u8 = build_source_storage(
        root,
        demo_level_sources(root, null(**u8), recipe) + (check != null(*u8)) as usize
    );
    if sources == null(**u8) {
        return false;
    }
    var capacity: usize = render_providers(root, null(**u8)) + game_providers(
        root,
        null(**u8)
    ) + extra_count + 4usize;
    var providers: **u8 = crust_try_alloc(
        root -> context,
        capacity * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if providers == null(**u8) {
        return false;
    }
    var source_count: usize = demo_level_sources(root, &sources[0usize], recipe);
    if check != null(*u8) {
        sources[source_count] = host_path(root, check);
        source_count = source_count + 1usize;
    }
    var provider_count: usize = render_providers(root, &providers[0usize]);
    provider_count = provider_count + game_providers(root, &providers[provider_count]);
    var i: usize = 0usize;
    while i < provider_count {
        if cache_strcmp(providers[i], host_path(root, "src/demo/labyrinth/world.crs")) == 0i32 {
            providers[i] = host_path(root, "src/demo/room/world.crs");
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < extra_count {
        providers[provider_count] = host_path(root, extra[i]);
        provider_count = provider_count + 1usize;
        i = i + 1usize;
    }
    providers[provider_count] = host_path(root, "src/app/level/pipe-storage.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, "src/app/level/shafts/storage.crs");
    provider_count = provider_count + 1usize;
    providers[provider_count] = host_path(root, entry);
    return build_application(
        root,
        emit,
        output,
        &sources[0usize],
        source_count,
        &providers[0usize],
        provider_count + 1usize,
        false
    );
}

fn demo_level_sources(root: *CrustRun, sources: **u8, recipe: *u8) -> usize {
    if sources == null(**u8) {
        return game_sources(root, null(**u8)) + 21usize;
    }
    var source_count: usize = game_sources(root, sources);
    sources[source_count] = recipe;
    sources[source_count + 1usize] = host_path(root, "src/demo/room/tunnels.crs");
    sources[source_count + 2usize] = host_path(root, "src/demo/course/catalogue.crs");
    sources[source_count + 3usize] = host_path(root, "src/demo/course/materials.crs");
    sources[source_count + 4usize] = host_path(root, "src/demo/course/assemble.crs");
    sources[source_count + 5usize] = host_path(root, "src/app/level/layout.crs");
    sources[source_count + 6usize] = host_path(root, "src/app/level/pipe-plan.crs");
    sources[source_count + 7usize] = host_path(root, "src/app/level/tunnel-details.crs");
    sources[source_count + 8usize] = host_path(root, "src/app/level/emergency.crs");
    sources[source_count + 9usize] = host_path(root, "src/assets/geometry/oblique-passage.crs");
    sources[source_count + 10usize] = host_path(root, "src/app/level/shafts/placement.crs");
    sources[source_count + 11usize] = host_path(root, "src/app/level/shafts/rooms.crs");
    sources[source_count + 12usize] = host_path(root, "src/app/level/shafts/assemble.crs");
    sources[source_count + 13usize] = host_path(root, "src/app/level/shafts/model.crs");
    sources[source_count + 14usize] = host_path(root, "src/app/level/shafts/candidates.crs");
    sources[source_count + 15usize] = host_path(root, "src/app/level/shafts/cycle.crs");
    sources[source_count + 16usize] = host_path(root, "src/app/level/shafts/path.crs");
    sources[source_count + 17usize] = host_path(root, "src/app/level/shafts/branches.crs");
    sources[source_count + 18usize] = host_path(root, "src/app/level/shafts/fans.crs");
    sources[source_count + 19usize] = host_path(root, "src/app/level/shafts/bypass.crs");
    sources[source_count + 20usize] = host_path(root, "src/app/level/shafts/grates.crs");
    source_count = source_count + 21usize;
    return source_count;
}
