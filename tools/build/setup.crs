fn project_open(root: *CrustRun, backend: *ApplicationBackend) -> *StageSession {
    if !cache_directory(root -> context, host_path(root, "build")) {
        return null(*StageSession);
    }
    var stages: *StageSession = stage_open(root, "crust", "build/stage-cache");
    if stages == null(*StageSession) || !application_backend(
        root,
        stages,
        backend,
        c_backend_build
    ) {
        return null(*StageSession);
    }
    var paths: [*u8; 5] = make [*u8; 5] {
        "crust/stages/generics/ownership/api.crs",
        "crust/stages/generics/ownership/build.crs",
        "tools/build/ownership.crs",
        "tools/build/sdl.crs",
        "tools/build/common.crs"
    };
    var i: usize = 0usize;
    while i < 5usize {
        if !host_source(root, paths[i]) {
            return null(*StageSession);
        }
        i = i + 1usize;
    }
    if !application_load(stages, backend, "stages/generics/ownership/package.crs") {
        return null(*StageSession);
    }
    return stages;
}
fn project_render(root: *CrustRun, stages: *StageSession, backend: *ApplicationBackend) -> bool {
    var paths: [*u8; 6] = make [*u8; 6] {
        "crust/stages/shader/model.crs",
        "crust/stages/shader/api.crs",
        "src/render/interface.crs",
        "tools/build/render.crs",
        "src/render/shader-names.crs",
        "tools/build/shaders.crs"
    };
    var i: usize = 0usize;
    while i < 6usize {
        if !host_source(root, paths[i]) {
            return false;
        }
        i = i + 1usize;
    }
    return application_load(stages, backend, "stages/shader/package.crs");
}
