fn ownership_sources_target(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    argc: i32,
    argv: **u8,
    providers: **u8,
    count: usize,
    expected: *u8,
    wasm: bool
) -> i32 {
    var trusted: *CrustSource = crust_try_alloc(
        root -> context,
        (count + 1usize) * sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    var args: **u8 = crust_try_alloc(
        root -> context,
        (argc as usize + 1usize) * sizeof(*u8),
        alignof(*u8)
    ) as **u8;
    if trusted == null(*CrustSource) || args == null(**u8) {
        return 1i32;
    }
    var i: usize = 0usize;
    while i < count {
        if !cache_read(root -> context, providers[i], &trusted[i]) {
            return 1i32;
        }
        trusted[i].identity = argc as u64 + 1u64 + i as u64;
        i = i + 1usize;
    }
    var total: usize = 0usize;
    i = 0usize;
    while i < argc as usize {
        var provider: bool = false;
        var j: usize = 0usize;
        while j < count {
            if cache_strcmp(argv[i], trusted[j].path) == 0i32 {
                provider = true;
            }
            j = j + 1usize;
        }
        if !provider {
            args[total] = argv[i];
            total = total + 1usize;
        }
        i = i + 1usize;
    }
    var context: CrustContext = uninit;
    if wasm {
        c_context_init_wasm32(&context, null(*CrustAllocator));
    } else {
        crust_context_init(&context, null(*CrustAllocator));
    }
    var request: CrustBuild = make CrustBuild {
        context: &context,
        source: null(*CrustSource),
        target_begin: 0usize,
        argc: total as i32,
        argv: &args[0usize]
    };
    var result: i32 = ownership_program(&request, &trusted[0usize], count, emit);
    result = ownership_result(root, &context, result, expected);
    crust_context_destroy(&context);
    return result;
}

fn ownership_sources(
    root: *CrustRun,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32,
    argc: i32,
    argv: **u8,
    providers: **u8,
    count: usize,
    expected: *u8
) -> i32 {
    return ownership_sources_target(
        root,
        emit,
        argc,
        argv,
        providers,
        count,
        expected,
        false
    );
}

fn ownership_result(root: *CrustRun, context: *CrustContext, status: i32, expected: *u8) -> i32 {
    var result: i32 = status;
    if expected != null(*u8) {
        if result != 0i32 && context -> error_count != 0usize && cache_strcmp(
            &context -> error[0usize],
            expected
        ) == 0i32 {
            result = 0i32;
        } else {
            if context -> error_count != 0usize {
                crust_run_diagnostic(context);
            }
            native_error(
                root -> context,
                "ownership rejection did not match the expected diagnostic"
            );
            result = 1i32;
        }
    } else if context -> error_count != 0usize {
        crust_run_diagnostic(context);
    }
    return result;
}
