fn game_sources(root: *CrustRun, args: **u8) -> usize {
    var files: [*u8; 55] = make [*u8; 55] {
        "src/game/math.crs",
        "src/game/state.crs",
        "src/game/prefab.crs",
        "src/game/expedition-layout.crs",
        "src/game/expedition-shell.crs",
        "src/game/expedition-world.crs",
        "src/game/room-content.crs",
        "src/game/biome-appearance.crs",
        "src/game/rooms/launch-cradle.crs",
        "src/game/rooms/counterweight-riser.crs",
        "tests/game/room-content.crs",
        "src/game/expedition-state.crs",
        "src/game/energy.crs",
        "src/game/expedition-rules.crs",
        "src/game/expedition-hash.crs",
        "src/game/expedition-view.crs",
        "src/game/expedition-lighting.crs",
        "src/game/expedition-hud.crs",
        "src/game/expedition-tour.crs",
        "src/game/course.crs",
        "src/game/course-route.crs",
        "src/game/course-tour.crs",
        "src/game/course-view.crs",
        "src/game/course-pipes.crs",
        "src/game/pipe-collision.crs",
        "src/game/pipe-view.crs",
        "src/game/course-appearance.crs",
        "src/game/collision.crs",
        "src/game/orientation.crs",
        "src/game/tether.crs",
        "src/game/hook.crs",
        "src/game/tether-view.crs",
        "src/game/physics.crs",
        "src/game/trial.crs",
        "src/game/scene.crs",
        "src/game/input.crs",
        "src/game/loop.crs",
        "src/game/hud.crs",
        "src/game/palette.crs",
        "src/game/preview.crs",
        "src/game/preview-phase.crs",
        "src/game/hook-preview.crs",
        "src/game/replay.crs",
        "src/app/geometry.crs",
        "src/app/palette.crs",
        "tests/game/checks.crs",
        "tests/game/hook.crs",
        "tests/game/tether.crs",
        "tests/game/course-flight.crs",
        "tests/game/course-spin.crs",
        "tests/game/course-geometry.crs",
        "tests/game/preview.crs",
        "tests/game/prefabs.crs",
        "tests/game/expedition.crs",
        "tests/game/expedition-render.crs"
    };
    var i: usize = 0usize;
    while i < 55usize {
        args[i] = host_path(root, files[i]);
        i = i + 1usize;
    }
    return i;
}
fn build_game(root: *CrustRun) -> bool {
    var providers: [*u8; 24] = make [*u8; 24] {
        "src/render/host/vulkan.crs",
        "src/render/host/io.crs",
        "src/render/host/device.crs",
        "src/render/host/resources.crs",
        "src/render/host/dispatch.crs",
        "src/render/host/timing.crs",
        "src/render/host/present.crs",
        "src/render/host/renderer.crs",
        "src/render/host/owner.crs",
        "src/app/window.crs",
        "src/app/clock.crs",
        "src/app/shaders.crs",
        "src/game/platform.crs",
        "src/game/progress-store.crs",
        "tests/game/progress-store.crs",
        "tests/game/render-io.crs",
        "src/game/sdl-input.crs",
        "src/game/renderer-host.crs",
        "src/game/options.crs",
        "src/game/recording.crs",
        "src/game/bindings.crs",
        "src/game/entry.crs",
        "src/app/capture.crs",
        "src/game/text.crs"
    };
    var args: [*u8; 96] = uninit;
    args[0usize] = "-o";
    args[1usize] = host_path(root, "build/game");
    var count: usize = 2usize;
    args[count] = host_path(root, "src/render/interface.crs");
    count = count + 1usize;
    count = count + game_sources(root, &args[count]);
    var flags: [*u8; 8] = make [*u8; 8] {
        "--cflag",
        "-O2",
        "--ldflag",
        "-Wl,-l:libvulkan.so.1",
        "--ldflag",
        "-Wl,-l:libSDL2-2.0.so.0",
        "--ldflag",
        "-lm"
    };
    var i: usize = 0usize;
    while i < 8usize {
        args[count] = flags[i];
        count = count + 1usize;
        i = i + 1usize;
    }
    return ownership_sources(
        root,
        count as i32,
        &args[0usize],
        &providers[0usize],
        24usize,
        null(*u8)
    ) == 0i32;
}
